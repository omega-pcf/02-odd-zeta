section W4DeW3Block

/-
W4DeW3.lean — Sprint 102. La flecha W3 ⇒ W4 del diccionario (en Weil: índice de Hodge ⇒ Castelnuovo–Severi).
Sin compilar [P*]. Solo álgebra de una forma bilineal simétrica invariante por traslación.
-/

namespace W4DeW3

/-- Para una forma bilineal simétrica `B` y `t₀ = B g g = B h h`, `t = B g h`:
`B (h - g) (h - g) = 2 (t₀ - t)` y `B (h + g) (h + g) = 2 (t₀ + t)`. -/
theorem plane_values {V : Type*} [AddCommGroup V] [Module ℝ V] (B : LinearMap.BilinForm ℝ V)
    (hB : ∀ x y, B x y = B y x) (g h : V) (hinv : B h h = B g g) :
    B (h - g) (h - g) = 2 * (B g g - B g h) ∧ B (h + g) (h + g) = 2 * (B g g + B g h) := by
  have hs := hB h g
  constructor
  · simp only [map_sub, LinearMap.sub_apply]; rw [hinv, hs]; ring
  · simp only [map_add, LinearMap.add_apply]; rw [hinv, hs]; ring

/-- W4 en un plano: si la forma es ≥ 0 en `h - g` y en `h + g`, entonces `|t| ≤ t₀`. -/
theorem W4_of_W3_on_plane (t₀ t : ℝ) (hm : 0 ≤ 2 * (t₀ - t)) (hp : 0 ≤ 2 * (t₀ + t)) : |t| ≤ t₀ := by
  rw [abs_le]; constructor <;> linarith

/-- Y al revés: `|t| ≤ t₀` da los dos valores no negativos. Las dos mitades de W4 son las dos direcciones del plano. -/
theorem W3_on_plane_of_W4 (t₀ t : ℝ) (h : |t| ≤ t₀) : 0 ≤ 2 * (t₀ - t) ∧ 0 ≤ 2 * (t₀ + t) := by
  rw [abs_le] at h; constructor <;> linarith [h.1, h.2]

end W4DeW3

end W4DeW3Block

