    s.re = (1 - s).re ↔ s.re = 1 / 2 := by
  simp only [Complex.sub_re, Complex.one_re, one_div]
  constructor
  · intro h; linarith
  · intro h; linarith

/-- **[P] LA PATA 5: LA INVOLUCIÓN ELEMENTAL.**  `x = 1 − x ⟺ x = 1/2`
