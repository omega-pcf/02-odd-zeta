-- BLOCK 18. F1_cw_equivalents.lean
-- the facts of The Crystalline Worldsheet used by the proof, proved here
-- ════════════════════════════════════════════════════════════════════════════

section Block18

/-
  F1_cw_equivalents.lean
  ────────────────────────────────────────────────────────────────────────
  The facts of The Crystalline Worldsheet that Parts I–V of the F1 paper use and that
  the corpus does not already contain under another name.  Each is proved here from
  Mathlib alone, so that the paper's proof chain does not depend on the Lean file of
  CW (`CW6_complete_v2.lean`).  The facts the corpus already contains are listed in
  `CW_EQUIVALENCIAS.md` with their corpus names and are not repeated here.

  Tier [P*]: written here, not compiled.  No `sorry`, no `axiom`.
-/


namespace F1CW

open Real

/-! ## 1.  The golden ratio, its anchor and its pentagon -/

noncomputable def phi : ℝ := (1 + Real.sqrt 5) / 2

theorem sqrt5_sq : Real.sqrt 5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)

theorem one_lt_sqrt5 : (1 : ℝ) < Real.sqrt 5 := by
  have h : Real.sqrt 1 < Real.sqrt 5 := Real.sqrt_lt_sqrt (by norm_num) (by norm_num)
  simpa using h

theorem phi_sq : phi ^ 2 = phi + 1 := by
  unfold phi; linear_combination (1/4 : ℝ) * sqrt5_sq

theorem one_lt_phi : 1 < phi := by unfold phi; linarith [one_lt_sqrt5]

theorem phi_pos : 0 < phi := lt_trans one_pos one_lt_phi

/-- λ_log = log 2 / log φ. -/
noncomputable def lambdaLog : ℝ := Real.log 2 / Real.log phi

theorem log_phi_pos : 0 < Real.log phi := Real.log_pos one_lt_phi

/-- **[P*] The anchor** φ^λ = 2 (CW `mersenne_bridge`; corpus `mersenne_bridge`). -/
theorem mersenne_bridge : phi ^ lambdaLog = 2 := by
  unfold lambdaLog
  rw [Real.rpow_def_of_pos phi_pos]
  have e : Real.log phi * (Real.log 2 / Real.log phi) = Real.log 2 := by
    field_simp [log_phi_pos.ne']
  rw [e, Real.exp_log (by norm_num)]

/-- **[P*] The reciprocal turn** φ^{−λ} = ½ (CW `facePhi_apex`). -/
theorem face_apex : phi ^ (-lambdaLog) = 1 / 2 := by
  rw [Real.rpow_neg phi_pos.le, mersenne_bridge]; norm_num

/-- **[P*]** λ_log · log φ = log 2 (CW `lambda_log_mul_regulator`). -/
theorem lambda_log_mul_regulator : lambdaLog * Real.log phi = Real.log 2 := by
  unfold lambdaLog; field_simp [log_phi_pos.ne']

/-- **[P*] The pentagon**, cos(π/5) = φ/2 (Mathlib `Real.cos_pi_div_five`). -/
theorem cos_pi_div_five_eq : Real.cos (Real.pi / 5) = phi / 2 := by
  rw [Real.cos_pi_div_five]; unfold phi; ring

/-- **[P*]** π = 5 arccos(φ/2) (CW `pi_eq_five_arccos`). -/
theorem pi_eq_five_arccos : 5 * Real.arccos (phi / 2) = Real.pi := by
  rw [← cos_pi_div_five_eq, Real.arccos_cos (by positivity)
    (by linarith [Real.pi_pos])]
  ring

theorem phi_inv : phi⁻¹ = (Real.sqrt 5 - 1) / 2 := by
  have h : (Real.sqrt 5 - 1) / 2 * phi = 1 := by
    unfold phi; linear_combination (1/4 : ℝ) * sqrt5_sq
  exact (eq_inv_of_mul_eq_one_left h).symm

/-- **[P*] The pentagonal values** |2cos(πa/5)| = φ^{χ₅(a)}, a = 1, 2, 3, 4
    (CW `norm_cosine_phi`). -/
theorem norm_cosine_phi :
    |2 * Real.cos (Real.pi / 5)| = phi ∧
    |2 * Real.cos (2 * (Real.pi / 5))| = phi⁻¹ ∧
    |2 * Real.cos (3 * (Real.pi / 5))| = phi⁻¹ ∧
    |2 * Real.cos (4 * (Real.pi / 5))| = phi := by
  have c1 : Real.cos (Real.pi / 5) = (1 + Real.sqrt 5) / 4 := Real.cos_pi_div_five
  have c2 : Real.cos (2 * (Real.pi / 5)) = (Real.sqrt 5 - 1) / 4 := by
    rw [Real.cos_two_mul, c1]; linear_combination (1/8 : ℝ) * sqrt5_sq
  have c3 : Real.cos (3 * (Real.pi / 5)) = -((Real.sqrt 5 - 1) / 4) := by
    rw [show 3 * (Real.pi / 5) = Real.pi - 2 * (Real.pi / 5) by ring, Real.cos_pi_sub, c2]
  have c4 : Real.cos (4 * (Real.pi / 5)) = -((1 + Real.sqrt 5) / 4) := by
    rw [show 4 * (Real.pi / 5) = Real.pi - Real.pi / 5 by ring, Real.cos_pi_sub, c1]
  have s1 := one_lt_sqrt5
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [c1, abs_of_pos (by linarith)]; unfold phi; ring
  · rw [c2, abs_of_pos (by linarith), phi_inv]; ring
  · rw [c3, abs_of_neg (by linarith), phi_inv]; ring
  · rw [c4, abs_of_neg (by linarith)]; unfold phi; ring

/-! ## 2.  The tower -/

/-- **[P*] Binet in any ring** α^{n+1} = F_{n+1} α + F_n when α² = α + 1
    (CW `binet_general`; corpus `F1SpectraAnchorG.fib_pow_aux`). -/
theorem binet_general {R : Type*} [CommRing R] (α : R) (h : α ^ 2 = α + 1) :
    ∀ n : ℕ, α ^ (n + 1) = (Nat.fib (n + 1) : R) * α + (Nat.fib n : R)
  | 0 => by simp
  | (n + 1) => by
      have ih := binet_general α h n
      have hf : Nat.fib (n + 1 + 1) = Nat.fib n + Nat.fib (n + 1) := Nat.fib_add_two
      rw [pow_succ, ih, hf]; push_cast
      linear_combination (Nat.fib (n + 1) : R) * h

/-- **[P*] The lift is not additive** on the ring: φ^{2p} ≠ φ^p + 1 for p ≥ 2, so
    ψ_p(φ + 1) = ψ_p(φ²) ≠ ψ_p(φ) + 1 (CW `psi_not_additive`). -/
theorem psi_not_additive (p : ℕ) (hp : 2 ≤ p) : phi ^ (2 * p) ≠ phi ^ p + 1 := by
  intro h
  have hx : (phi ^ p) ^ 2 = phi ^ p + 1 := by rw [← pow_mul, mul_comm]; exact h
  have hpos : 0 < phi ^ p := pow_pos phi_pos p
  -- the positive root of x² = x + 1 is φ
  have hroot : phi ^ p = phi := by
    have hfac : (phi ^ p - phi) * (phi ^ p + phi - 1) = 0 := by
      linear_combination hx - phi_sq
    rcases mul_eq_zero.mp hfac with h1 | h1
    · linarith
    · exfalso; linarith [one_lt_phi]
  have hlt : phi ^ 1 < phi ^ p := pow_lt_pow_right₀ one_lt_phi (by omega)
  rw [pow_one] at hlt; linarith

/-! ## 3.  The Euler product and the zeta values -/

/-- **[P*] The Dirichlet series over the integer levels is the Euler product**
    (CW `regge_tower_is_euler_product`; Mathlib). -/
theorem dirichlet_is_euler {s : ℂ} (hs : 1 < s.re) :
    ∑' n : ℕ, 1 / (n : ℂ) ^ s = ∏' p : Nat.Primes, (1 - (p : ℂ) ^ (-s))⁻¹ := by
  rw [← zeta_eq_tsum_one_div_nat_cpow hs, riemannZeta_eulerProduct_tprod hs]

/-- **[P*]** ζ(2k) = (−1)^{k+1} 2^{2k−1} π^{2k} B_{2k} / (2k)! (CW
    `even_zeta_bernoulli`; Mathlib `riemannZeta_two_mul_nat`). -/
theorem even_zeta_bernoulli {k : ℕ} (hk : k ≠ 0) :
    riemannZeta (2 * k) = (-1) ^ (k + 1) * (2 : ℂ) ^ (2 * k - 1) * (Real.pi : ℂ) ^ (2 * k)
      * bernoulli (2 * k) / ((2 * k).factorial : ℂ) :=
  riemannZeta_two_mul_nat hk

/-- **[P*]** The odd values as a ratio, from the global factorisation
    (CW `odd_zeta_ratio`; corpus `zeta_odd_pentagonal_determination`). -/
theorem odd_zeta_ratio (zK zv Lv : ℝ) (h : zK = zv * Lv) (hL : Lv ≠ 0) : zv = zK / Lv := by
  rw [h]; field_simp

/-! ## 4.  The splitting types of ℚ(√5), the ideals, and the Euler colimit

  Definitions and proofs taken verbatim from the extract of `CW6_complete_v2.lean`
  supplied by the author (`cw6_ideals_colimit_evenL.lean`), so that the names and the
  statements are those of CW §2.9 (Def. 2.48, Props. 2.49–2.50) and App. A.8. -/

/-- Splitting type of a rational prime in `O_K = ℤ[φ]`. -/
inductive SplitTypeK | split | inert | ramified
deriving DecidableEq

def numAboveK : SplitTypeK → ℕ | .split => 2 | .inert => 1 | .ramified => 1
def ramIndexK : SplitTypeK → ℕ | .split => 1 | .inert => 1 | .ramified => 2
def resDegreeK : SplitTypeK → ℕ | .split => 1 | .inert => 2 | .ramified => 1

/-- **[P]** Σ eᵢ fᵢ = [K:ℚ] = 2 in the three cases (CW `degree_formula_K`). -/
theorem degree_formula_K (t : SplitTypeK) :
    numAboveK t * (ramIndexK t * resDegreeK t) = 2 := by cases t <;> rfl

/-- Absolute norm of a prime above `p`: `N(𝔭) = p^f`. -/
noncomputable def ideal_norm_k (t : SplitTypeK) (p : ℝ) : ℝ := p ^ (resDegreeK t)

/-- **[P]** Split `N(𝔭)=p`, inert `N(𝔭)=p²`, ramified `N(𝔭)=p` (CW `ideal_norm_values_K`). -/
theorem ideal_norm_values_K (p : ℝ) :
    ideal_norm_k .split p = p ∧ ideal_norm_k .inert p = p ^ 2 ∧
    ideal_norm_k .ramified p = p := by
  refine ⟨?_, ?_, ?_⟩ <;> simp [ideal_norm_k, resDegreeK]

/-- The von Mangoldt value `log N𝔭`. -/
noncomputable def vonMangoldtK (t : SplitTypeK) (p : ℝ) : ℝ := Real.log (ideal_norm_k t p)

/-- **[P*]** The von Mangoldt values: log p and 2 log p (CW `von_mangoldt_k_values`). -/
theorem von_mangoldt_k_values (p : ℝ) (_hp : 0 < p) :
    vonMangoldtK .split p = Real.log p ∧ vonMangoldtK .inert p = 2 * Real.log p := by
  refine ⟨by simp [vonMangoldtK, ideal_norm_k, resDegreeK], ?_⟩
  simp only [vonMangoldtK, ideal_norm_k, resDegreeK]
  rw [Real.log_pow]; norm_num

/-- χ₅ on the integers (the same definiens as the corpus's `chi5N`). -/
def chi5 (n : ℕ) : ℤ := if n % 5 = 0 then 0 else if n % 5 = 1 ∨ n % 5 = 4 then 1 else -1

/-- Local factor of `ζ_K` according to the character value, with `u = p^{-s}`. -/
noncomputable def eulerFactorK (c : ℤ) (u : ℝ) : ℝ :=
  if c = 0 then (1 - u)⁻¹ else if c = 1 then (1 - u)⁻¹ * (1 - u)⁻¹ else (1 - u^2)⁻¹

noncomputable def eulerFactorZ (u : ℝ) : ℝ := (1 - u)⁻¹
noncomputable def eulerFactorL (c : ℤ) (u : ℝ) : ℝ := (1 - (c : ℝ) * u)⁻¹

/-- Product over the primes of `O_K` lying above `p`, with `u = p^{-s}`. -/
noncomputable def ideal_euler_k (t : SplitTypeK) (u : ℝ) : ℝ :=
  ((1 - u ^ (resDegreeK t))⁻¹) ^ (numAboveK t)

/-- **[P] Def. 2.48, (2.40), locally.**  The product over the prime IDEALS above `p` is
    the local factor (CW `euler_from_ideals_K`). -/
theorem euler_from_ideals_K (u : ℝ) :
    ideal_euler_k .ramified u = eulerFactorK 0 u ∧
    ideal_euler_k .split u = eulerFactorK 1 u ∧
    ideal_euler_k .inert u = eulerFactorK (-1) u := by
  refine ⟨?_, ?_, ?_⟩ <;>
    simp [ideal_euler_k, eulerFactorK, resDegreeK, numAboveK, pow_succ]

/-- **[P]** Ramified (CW `local_dedekind_ramified_K`). -/
theorem local_dedekind_ramified_K (u : ℝ) :
    eulerFactorK 0 u = eulerFactorZ u * eulerFactorL 0 u := by
  simp [eulerFactorK, eulerFactorZ, eulerFactorL]

/-- **[P]** Split (CW `local_dedekind_split_K`). -/
theorem local_dedekind_split_K (u : ℝ) :
    eulerFactorK 1 u = eulerFactorZ u * eulerFactorL 1 u := by
  simp [eulerFactorK, eulerFactorZ, eulerFactorL]

/-- **[P]** Inert; the core is `(1-u)(1+u) = 1-u²` (CW `local_dedekind_inert_K`). -/
theorem local_dedekind_inert_K (u : ℝ) (_h1 : 1 - u ≠ 0) (_h2 : 1 + u ≠ 0) :
    eulerFactorK (-1) u = eulerFactorZ u * eulerFactorL (-1) u := by
  have hkey : 1 - u^2 = (1 - u) * (1 + u) := by ring
  simp only [eulerFactorK, eulerFactorZ, eulerFactorL]
  norm_num
  rw [hkey, mul_inv]

/-- `n` is `S`-smooth: every prime dividing `n` lies in `S`. -/
def SmoothK (S : Finset ℕ) (n : ℕ) : Prop := ∀ p, p.Prime → p ∣ n → p ∈ S

/-- Euler partial product as a coefficient function. -/
noncomputable def partialEK (S : Finset ℕ) (a : ℕ → ℝ) (n : ℕ) : ℝ :=
  @ite ℝ (SmoothK S n) (Classical.propDecidable (SmoothK S n)) (a n) 0

/-- **[P] Prop. 2.50, (2.45), existence.**  Enlarging `S` never alters a coefficient
    already determined (CW `coeff_stabilises_K`). -/
theorem coeff_stabilises_K {S S' : Finset ℕ} (hSS : S ⊆ S') (a : ℕ → ℝ)
    {n : ℕ} (hn : SmoothK S n) :
    partialEK S a n = partialEK S' a n := by
  have hn' : SmoothK S' n := fun p hp hd => hSS (hn p hp hd)
  simp only [partialEK, hn, hn']

/-- **[P] Prop. 2.50, (2.45).**  For each `n` a finite `S` suffices: its own prime
    factors (CW `colimit_exists_K`). -/
theorem colimit_exists_K (a : ℕ → ℝ) {n : ℕ} (hn : n ≠ 0) :
    partialEK n.primeFactors a n = a n := by
  unfold partialEK SmoothK
  split
  · rfl
  · exfalso
    rename_i h
    have : ∀ p, p.Prime → p ∣ n → p ∈ n.primeFactors := by
      intro p hp hdvd
      exact Nat.Prime.mem_primeFactors hp hdvd hn
    exact h this

/-- **[P] App. A.8, (A.16) term by term.**  n = 5m + a rescales by 5^{−s}
    (CW `hurwitz_reindex`). -/
theorem hurwitz_reindex (m a : ℕ) (s : ℝ) :
    ((5 * m + a : ℝ)) ^ (-s) = (5:ℝ) ^ (-s) * ((m : ℝ) + a / 5) ^ (-s) := by
  have h5 : (0:ℝ) ≤ 5 := by norm_num
  have hx : (0:ℝ) ≤ (m : ℝ) + a / 5 := by positivity
  have hsplit : ((5 * m + a : ℝ)) = 5 * ((m : ℝ) + a / 5) := by ring
  rw [hsplit, Real.mul_rpow h5 hx]

/-- **[P given L] App. A.8, (A.18).**  The even values of `L(·,χ₅)` lie in √5·π^{2k}·ℚ;
    the passage through ζ(−n,x) = −B_{n+1}(x)/(n+1) and the functional equation is the
    classical input `hBernoulli` (CW `even_L_rationality`). -/
theorem even_L_rationality (k : ℕ) (Lv : ℝ) (r : ℚ)
    (hBernoulli : Lv = Real.sqrt 5 * Real.pi ^ (2*k) * (r : ℝ)) :
    ∃ q : ℚ, Lv = Real.sqrt 5 * Real.pi ^ (2*k) * (q : ℝ) := ⟨r, hBernoulli⟩

/-! ## 5.  Regulator, period, S-duality, central charge -/

noncomputable def regulatorK : ℝ := Real.log phi
noncomputable def periodK : ℝ := 2 * Real.pi * regulatorK

/-- **[P*]** T = 2π R_K (CW `period_eq_two_pi_regulator`). -/
theorem period_eq_two_pi_regulator : periodK = 2 * Real.pi * regulatorK := rfl

/-- **[P*]** L(1, χ₅) = 2R_K/√5 from the class-number formula (CW
    `L1_from_class_number_formula`; corpus `anchor_is_a_crossed_identity`). -/
theorem L1_from_class_number_formula (L1 : ℝ)
    (hCNF : L1 = (2 ^ 2 * 1 * regulatorK) / (2 * Real.sqrt 5)) :
    L1 = 2 * Real.log phi / Real.sqrt 5 := by
  rw [hCNF]; unfold regulatorK; ring

/-- S-duality τ ↦ −1/τ. -/
noncomputable def sDuality (τ : ℂ) : ℂ := -1 / τ

/-- **[P*]** τ = i is fixed by S-duality (CW `s_duality_fixes_i`). -/
theorem s_duality_fixes_i : sDuality Complex.I = Complex.I := by
  unfold sDuality
  rw [div_eq_iff Complex.I_ne_zero, Complex.I_mul_I]

/-- **[P*]** 3ℓ/(2G) = 3 at ℓ = 1 exactly when G = ½ (CW `hinge_central_charge`,
    `brown_henneaux_c_eq_three`). -/
theorem hinge_central_charge (G : ℝ) (hG : 0 < G) : 3 / (2 * G) = 3 ↔ G = 1 / 2 := by
  constructor
  · intro h
    have h2 : 2 * G ≠ 0 := by positivity
    field_simp at h
    linarith
  · intro h; rw [h]; norm_num

/-! ## 6.  The triad and the ensemble -/

/-- **[P*] The real parts of the triad** ½, −¼, −¼: trace 0, product 2⁻⁵
    (CW `triad_trace_zero`, `triad_two_products`; corpus `omega_properties`,
    `eigenvalue_half`). -/
theorem triad_real_parts :
    (1/2 : ℝ) + (-1/4) + (-1/4) = 0 ∧ (1/2 : ℝ) * (-1/4) * (-1/4) = 1 / 2 ^ 5 ∧
    (1/2 : ℝ) * (1/2) * (1/2) = 1 / 2 ^ 3 := by
  refine ⟨by norm_num, by norm_num, by norm_num⟩

/-- The GUE pair-correlation kernel. -/
noncomputable def sineKernel (u : ℝ) : ℝ := 1 - (Real.sin (Real.pi * u) / (Real.pi * u)) ^ 2

/-- **[P*]** K(n) = 1 at every non-zero integer (CW `sineKernel_at_nonzero_integer`). -/
theorem sineKernel_at_nonzero_integer (n : ℤ) : sineKernel n = 1 := by
  unfold sineKernel
  rw [mul_comm, Real.sin_int_mul_pi]; simp

/-! ## 7.  The five and the four -/

/-- **[P*]** 5 is the only prime with four units modulo itself, i.e. p − 1 = 4
    (CW `five_is_the_unique_prime_with_four_units`). -/
theorem five_is_the_unique_prime_with_four_units (p : ℕ) (_hp : p.Prime) (h : p - 1 = 4) :
    p = 5 := by omega

/-- **[P*]** The binary register has period 4 modulo 5: 2⁴ ≡ 1 and 2² ≡ −1
    (CW `binary_period_lives_in_the_five_component`). -/
theorem binary_period_mod_five : (2 : ZMod 5) ^ 4 = 1 ∧ (2 : ZMod 5) ^ 2 = -1 := by
  refine ⟨by decide, by decide⟩

/-! ## 8.  The archimedean density of the counting function -/

/-- The archimedean density per real place, u²/(u² − 1). -/
noncomputable def kappaQ (u : ℝ) : ℝ := u ^ 2 / (u ^ 2 - 1)

/-- K = ℚ(√5) has two real places. -/
noncomputable def kappaK (u : ℝ) : ℝ := 2 * kappaQ u

/-- **[P*]** κ per real place: u²/(u²−1) = 1 + 1/(u²−1) (CW `kappa_per_real_place`). -/
theorem kappa_per_real_place (u : ℝ) (hu : u ^ 2 ≠ 1) : kappaQ u = 1 + 1 / (u ^ 2 - 1) := by
  have h : u ^ 2 - 1 ≠ 0 := sub_ne_zero.mpr hu
  unfold kappaQ; field_simp <;> ring

/-- **[P*]** κ_K is the sum over the two real places (CW `kappa_k_two_real_places`). -/
theorem kappa_k_two_real_places (u : ℝ) : kappaK u = kappaQ u + kappaQ u := by
  unfold kappaK; ring

/-- **[P*]** κ_K has a simple pole at u = 1: (u − 1) κ_K(u) = 2u²/(u + 1), which tends to 1
    (CW `kappa_k_simple_pole`). -/
theorem kappa_k_simple_pole (u : ℝ) (h1 : u ≠ 1) (h2 : u ≠ -1) :
    (u - 1) * kappaK u = 2 * u ^ 2 / (u + 1) := by
  have ha : u - 1 ≠ 0 := sub_ne_zero.mpr h1
  have hb : u + 1 ≠ 0 := by intro h; apply h2; linarith
  have hc : u ^ 2 - 1 ≠ 0 := by
    have : u ^ 2 - 1 = (u - 1) * (u + 1) := by ring
    rw [this]; exact mul_ne_zero ha hb
  unfold kappaK kappaQ
  rw [show u ^ 2 - 1 = (u - 1) * (u + 1) by ring]
  field_simp <;> ring

/-! ## 9.  The tower Hamiltonian, the class number, the sine signature -/

/-- The tower Hamiltonian on the first n levels, diag(m₀ φ^i). -/
noncomputable def towerHam (m₀ : ℝ) (n : ℕ) : Matrix (Fin n) (Fin n) ℂ :=
  Matrix.diagonal (fun i => ((m₀ * phi ^ (i : ℕ) : ℝ) : ℂ))

/-- **[P*]** The tower Hamiltonian is Hermitian (CW `tower_ham_is_hermitian`). -/
theorem tower_ham_is_hermitian (m₀ : ℝ) (n : ℕ) : (towerHam m₀ n).IsHermitian := by
  unfold towerHam
  apply Matrix.isHermitian_diagonal_of_self_adjoint
  unfold IsSelfAdjoint
  funext i
  simp [Pi.star_apply, Complex.conj_ofReal]

/-- **[P*]** The Minkowski bound of ℚ(√5) is √5/2 < 2 (CW `minkowski_bound_lt_two`). -/
theorem minkowski_bound_lt_two : Real.sqrt 5 / 2 < 2 := by
  have h : Real.sqrt 5 < 4 := by
    nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 5 by norm_num), Real.sqrt_nonneg 5]
  linarith

/-- **[P*]** h_K = 1, given Minkowski's theorem as the input: an integral ideal of norm at
    most √5/2 has norm 1 (CW `class_number_one_K`; Minkowski enters as [C]). -/
theorem class_number_one_K (n : ℕ) (hn : 0 < n) (hM : (n : ℝ) ≤ Real.sqrt 5 / 2) : n = 1 := by
  have h2 : (n : ℝ) < 2 := lt_of_le_of_lt hM minkowski_bound_lt_two
  have : n < 2 := by exact_mod_cast h2
  omega

/-- **[P*]** The sine reads the same character: sin(2π/5)/sin(π/5) = 2cos(π/5) = φ
    (CW `pentagon_log_signature`). -/
theorem pentagon_log_signature :
    Real.sin (2 * (Real.pi / 5)) / Real.sin (Real.pi / 5) = phi := by
  have hs : Real.sin (Real.pi / 5) ≠ 0 := by
    apply ne_of_gt
    apply Real.sin_pos_of_pos_of_lt_pi
    · positivity
    · linarith [Real.pi_pos]
  rw [Real.sin_two_mul, cos_pi_div_five_eq]
  field_simp <;> ring

/-- **[P*]** The Bernoulli polynomials take rational values at the pentagonal points a/5
    (CW `bernoulli_eval_rational`). -/
theorem bernoulli_eval_rational (n a : ℕ) :
    ∃ r : ℚ, (Polynomial.bernoulli n).eval ((a : ℚ) / 5) = r := ⟨_, rfl⟩

