theorem the_apex_is_the_centre_not_a_member (ρ : ℂ) :
    ((ctr₉ ρ (1 - ρ)).re = (Omega_hat ⟨0, by norm_num⟩).re) ∧
    ((Omega_hat 0).re = 1/2) ∧
    (ρ.re + (1 - ρ).re = 1) := by
  refine ⟨orbit_centre_is_in_the_spectrum ρ,
          embedding_target_is_the_orbit_shadow.1, by simp⟩

theorem E_is_landing_on_the_only_positive_eigenvalue (ρ : ℂ) (hγ : ρ.im ≠ 0)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) :
    ((ctr₉ ρ (1 - ρ)).re = (Omega_hat ⟨0, by norm_num⟩).re) ∧
    ((Omega_hat 1).re < 0 ∧ (Omega_hat 2).re < 0) ∧
    ((rad₉ ρ (1 - ρ)).re = 0 ↔ ρ.re = 1/2) ∧
    ((1 - (starRingEnd ℂ) ρ = ρ) ↔ ρ.re = 1 / 2) :=
  ⟨orbit_centre_is_in_the_spectrum ρ,
   ⟨(only_one_eigenvalue_is_positive 1).2.1, (only_one_eigenvalue_is_positive 1).2.2⟩,
   orbit_radius_vanishes_iff_E ρ,
   the_orbit_collapses_iff_on_the_line ρ hγ⟩

def LandsOnSpectrum (L : ℂ → ℂ) : Prop :=
  ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 → L ρ = 0 → ∃ k : Fin 3, ρ.re = (Omega_hat k).re

theorem landing_gives_the_positive_eigenvalue (L : ℂ → ℂ) (h : LandsOnSpectrum L)
    (ρ : ℂ) (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hz : L ρ = 0) :
    ρ.re = (Omega_hat 0).re := by
  obtain ⟨k, hk⟩ := h ρ h0 h1 hz
  have hkpos : 0 < (Omega_hat k).re := hk ▸ h0
  rw [hk, operator_spectrum_positivity_forces_half k hkpos,
      embedding_target_is_the_orbit_shadow.1]

theorem landing_gives_E (L : ℂ → ℂ) (h : LandsOnSpectrum L) (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hz : L ρ = 0) :
    ρ.re = 1/2 := by
  rw [landing_gives_the_positive_eigenvalue L h ρ h0 h1 hz,
      embedding_target_is_the_orbit_shadow.1]

theorem E_gives_landing (L : ℂ → ℂ)
    (hE : ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 → L ρ = 0 → ρ.re = 1/2) :
    LandsOnSpectrum L := by
  intro ρ h0 h1 hz
  exact ⟨0, by rw [hE ρ h0 h1 hz, embedding_target_is_the_orbit_shadow.1]⟩

theorem landing_iff_E (L : ℂ → ℂ) :
    LandsOnSpectrum L ↔ (∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 → L ρ = 0 → ρ.re = 1/2) :=
  ⟨fun h ρ h0 h1 hz => landing_gives_E L h ρ h0 h1 hz, E_gives_landing L⟩

theorem the_pair_lands_on_the_only_positive_eigenvalue (L : ℂ → ℂ)
    (h : LandsOnSpectrum L) (ρ : ℂ) (hγ : ρ.im ≠ 0)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hz : L ρ = 0) :
    (ρ.re = (Omega_hat 0).re) ∧
    ((Omega_hat 1).re < 0 ∧ (Omega_hat 2).re < 0) ∧
    ((rad₉ ρ (1 - ρ)).re = 0) ∧
    (1 - (starRingEnd ℂ) ρ = ρ) := by
  have hE := landing_gives_E L h ρ h0 h1 hz
  exact ⟨landing_gives_the_positive_eigenvalue L h ρ h0 h1 hz,
         ⟨(only_one_eigenvalue_is_positive 1).2.1, (only_one_eigenvalue_is_positive 1).2.2⟩,
         (orbit_radius_vanishes_iff_E ρ).mpr hE,
         (the_orbit_collapses_iff_on_the_line ρ hγ).mpr hE⟩

theorem the_spectrum_is_constructed (k : Fin 3) :
    (Omega_hat k = ((1:ℝ)/2 : ℝ) * w_pcf ^ (k : ℕ)) ∧
    (w_pcf ^ 3 = 1) ∧
    (Omega_hat k = ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) : ℝ) * w_pcf ^ (k : ℕ)) := by
  refine ⟨rfl, ?_, spectrum_is_anchor_times_orbit k⟩
  exact the_chain_three_two_one.1.1

theorem the_zero_is_not_constructed (z : Chi5Zero) :
    (DirichletCharacter.LFunction chi5_D z.ρ = 0) ∧
    (0 < z.ρ.re ∧ z.ρ.re < 1) :=
  ⟨z.is_zero, ⟨z.in_strip_pos, z.in_strip_lt⟩⟩

theorem the_two_sides_have_different_provenance (z : Chi5Zero) (k : Fin 3) :
    (Omega_hat k = ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) : ℝ) * w_pcf ^ (k : ℕ)) ∧
    (DirichletCharacter.LFunction chi5_D z.ρ = 0) :=
  ⟨spectrum_is_anchor_times_orbit k, z.is_zero⟩

theorem what_the_structure_proves_about_the_zero_alone (z : Chi5Zero) :
    (ctr₉ z.ρ (1 - z.ρ) = 1/2) ∧
    ((rad₉ z.ρ (1 - z.ρ)).re = z.ρ.re - 1/2) ∧
    (zeroCoord (1 - z.ρ) = (zeroCoord z.ρ)⁻¹) ∧
    (DirichletCharacter.LFunction chi5_D (1 - z.ρ) = 0) :=
  ⟨the_centre_is_fixed_for_every_zero z.ρ,
   radius_re_is_re_minus_half z.ρ,
   (unconditional_involution_facts z).1,
   z.companion.is_zero⟩

theorem the_gap_is_where_the_structure_meets_what_it_does_not_define
    (z : Chi5Zero) (k : Fin 3) :
    (Omega_hat k = ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) : ℝ) * w_pcf ^ (k : ℕ)) ∧
    (DirichletCharacter.LFunction chi5_D z.ρ = 0) ∧
    (ctr₉ z.ρ (1 - z.ρ) = 1/2) ∧
    ((ctr₉ z.ρ (1 - z.ρ)).re = (Omega_hat ⟨0, by norm_num⟩).re) :=
  ⟨spectrum_is_anchor_times_orbit k,
   z.is_zero,
   the_centre_is_fixed_for_every_zero z.ρ,
   orbit_centre_is_in_the_spectrum z.ρ⟩

theorem primes_reach_the_L_function :
    (∀ p : ℕ, p.Prime → 5 < p → (p : ZMod 20) ∈ ZtwentyStar) ∧
    (ZtwentyStar.card = 8) ∧
    (∀ a b : ZMod 20, a ∈ ZtwentyStar → b ∈ ZtwentyStar → G (a * b) = G a + G b) :=
  ⟨primes_land_in_ZtwentyStar, kernel_two_and_four_fibres.1, G_hom⟩

theorem the_zero_lives_on_that_same_L (z : Chi5Zero) :
    (DirichletCharacter.LFunction chi5_D z.ρ = 0) ∧
    (DirichletCharacter.LFunction chi5_D (1 - z.ρ) = 0) ∧
    (0 < z.ρ.re ∧ z.ρ.re < 1) :=
  ⟨z.is_zero, z.companion.is_zero, ⟨z.in_strip_pos, z.in_strip_lt⟩⟩

theorem primes_and_zeros_are_faces_of_one_structure (z : Chi5Zero) (k : Fin 3) :
    (∀ p : ℕ, p.Prime → 5 < p → (p : ZMod 20) ∈ ZtwentyStar) ∧
    (DirichletCharacter.LFunction chi5_D z.ρ = 0) ∧
    (Omega_hat k = ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) : ℝ) * w_pcf ^ (k : ℕ)) ∧
    ((ctr₉ z.ρ (1 - z.ρ)).re = (Omega_hat ⟨0, by norm_num⟩).re) ∧
    ((1:ℝ) / (ZtwentyStar.card : ℝ) = 1/8) :=
  ⟨primes_land_in_ZtwentyStar,
   z.is_zero,
   spectrum_is_anchor_times_orbit k,
   orbit_centre_is_in_the_spectrum z.ρ,
   beta0_is_inverse_of_the_carriers⟩

theorem what_the_structure_does_not_fix_is_the_ordinate (z : Chi5Zero) :
    ((ctr₉ z.ρ (1 - z.ρ)).re = (Omega_hat ⟨0, by norm_num⟩).re) ∧
    ((rad₉ z.ρ (1 - z.ρ)).re = z.ρ.re - 1/2) ∧
    ((rad₉ z.ρ (1 - z.ρ)).im = z.ρ.im) := by
  refine ⟨orbit_centre_is_in_the_spectrum z.ρ, radius_re_is_re_minus_half z.ρ, ?_⟩
  rw [radius_is_rho_minus_half z.ρ]
  simp

theorem the_structure_fixes_the_symmetry_not_the_position (z : Chi5Zero) (k : Fin 3) :
    (Omega_hat k = ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) : ℝ) * w_pcf ^ (k : ℕ)) ∧
    (DirichletCharacter.LFunction chi5_D (1 - z.ρ) = 0) ∧
    ((ctr₉ z.ρ (1 - z.ρ)).re = (Omega_hat ⟨0, by norm_num⟩).re) ∧
    ((rad₉ z.ρ (1 - z.ρ)).im = z.ρ.im) := by
  refine ⟨spectrum_is_anchor_times_orbit k, z.companion.is_zero,
          orbit_centre_is_in_the_spectrum z.ρ, ?_⟩
  rw [radius_is_rho_minus_half z.ρ]; simp

noncomputable def T_star (n : ℝ) : ℝ :=
  c_spectral n * Real.pi * n / Real.log (μ_PCF * n + σ_PCF)

theorem T_star_unfolds (n : ℝ) :
    T_star n = c_spectral n * Real.pi * n / Real.log (μ_PCF * n + σ_PCF) := rfl

theorem the_ordinate_operator_is_indexed (n : ℝ) (hn : 1 ≤ n) :
    (2 < c_spectral n) ∧ (c_spectral n ≤ 2 + α₀) ∧
    (T_star n = c_spectral n * Real.pi * n / Real.log (μ_PCF * n + σ_PCF)) :=
  ⟨c_gt_two hn, c_bounded_above hn, rfl⟩

theorem the_ordinate_is_not_free (n : ℝ) (hn : 1 ≤ n) :
    (1 < bias_factor_I n) ∧
    (bias_factor_I n = c_spectral n / 2) ∧
    (σ_PCF + μ_PCF = 2) :=
  ⟨bias_factor_I_gt_one hn, rfl, sigma_plus_mu⟩

theorem two_operators_two_coordinates (k : Fin 3) (n : ℝ) (hn : 1 ≤ n) (ρ : ℂ) :
    ((Omega_hat k).re = 1/2 ∨ (Omega_hat k).re = -(1/4)) ∧
    (2 < c_spectral n) ∧
    ((ctr₉ ρ (1 - ρ)).re = (Omega_hat ⟨0, by norm_num⟩).re) ∧
    ((rad₉ ρ (1 - ρ)).im = ρ.im) := by
  refine ⟨?_, c_gt_two hn, orbit_centre_is_in_the_spectrum ρ, ?_⟩
  · fin_cases k
    · left; exact embedding_target_is_the_orbit_shadow.1
    · right; exact embedding_target_is_the_orbit_shadow.2.1
    · right; exact embedding_target_is_the_orbit_shadow.2.2
  · rw [radius_is_rho_minus_half ρ]; simp

theorem the_structure_controls_both_coordinates (k : Fin 3) (n : ℝ) (hn : 1 ≤ n)
    (ρ : ℂ) (j : Fin 3) (hw : Complex.abs w_pcf = 1) :
    ((Omega_hat k).re = 1/2 ∨ (Omega_hat k).re = -(1/4)) ∧
    (Complex.abs (Omega_hat j) = Complex.abs (Omega_hat k)) ∧
    (2 < c_spectral n ∧ c_spectral n ≤ 2 + α₀) ∧
    ((3:ℝ)/2 + 1/2 = 2) ∧
    ((ctr₉ ρ (1 - ρ)).re = (Omega_hat ⟨0, by norm_num⟩).re) :=
  ⟨(two_operators_two_coordinates k n hn ρ).1,
   the_modulus_is_uniform_in_k j k hw,
   ⟨c_gt_two hn, c_bounded_above hn⟩,
   operator_limit_is_the_apex_sum,
   orbit_centre_is_in_the_spectrum ρ⟩

theorem the_error_is_a_theorem_not_a_conjecture (n : ℝ) (hn : Real.exp 1 ≤ n) :
    (c_spectral n - 2 = α₀ / (1 + β₀ * Real.log n)) ∧
    (2 < c_spectral n) ∧
    (c_spectral n ≤ 2 + α₀) := by
  refine ⟨c_minus_two_exact n, ?_, ?_⟩
  · exact c_gt_two (le_trans (by nlinarith [Real.exp_one_gt_d9]) hn)
  · exact c_bounded_above (le_trans (by nlinarith [Real.exp_one_gt_d9]) hn)

theorem the_rate_is_one_over_log (n : ℝ) (hn : Real.exp 1 ≤ n) :
    c_spectral n - 2 = α₀ / (1 + β₀ * Real.log n) :=
  c_minus_two_exact n

theorem the_limit_is_the_apex_sum :
    ((3:ℝ)/2 + 1/2 = 2) ∧ (α₀ = 59/40) ∧ (β₀ = 1/8) :=
  ⟨sigma_plus_mu, rfl, rfl⟩

theorem the_implicit_constant :
    α₀ / (2 * β₀) + Real.log 2 = 59/10 + Real.log 2 := by
  unfold α₀ β₀
  norm_num

theorem what_is_conjectured_is_only_the_uniform_M (n : ℝ) (hn : Real.exp 1 ≤ n) :
    (c_spectral n - 2 = α₀ / (1 + β₀ * Real.log n)) ∧
    ((3:ℝ)/2 + 1/2 = 2) ∧
    (α₀ / (2 * β₀) + Real.log 2 = 59/10 + Real.log 2) :=
  ⟨c_minus_two_exact n, sigma_plus_mu, the_implicit_constant⟩

theorem T_star_is_about_the_ordinate (n : ℝ) (hn : 1 ≤ n) :
    (T_star n = c_spectral n * Real.pi * n / Real.log (μ_PCF * n + σ_PCF)) ∧
    (2 < c_spectral n) := by
  exact ⟨rfl, c_gt_two hn⟩

theorem Omega_hat_is_about_the_real_part (k : Fin 3) :
    ((Omega_hat k).re = 1/2 ∨ (Omega_hat k).re = -(1/4)) := by
  fin_cases k
  · left; exact embedding_target_is_the_orbit_shadow.1
  · right; exact embedding_target_is_the_orbit_shadow.2.1
  · right; exact embedding_target_is_the_orbit_shadow.2.2

theorem the_ordinate_side_never_mentions_the_real_part (ρ : ℂ) :
    ((rad₉ ρ (1 - ρ)).im = ρ.im) ∧
    ((rad₉ ρ (1 - ρ)).re = ρ.re - 1/2) ∧
    ((ctr₉ ρ (1 - ρ)).im = 0) := by
  refine ⟨?_, radius_re_is_re_minus_half ρ, ?_⟩
  · rw [radius_is_rho_minus_half ρ]; simp
  · rw [centre_is_half_always ρ]; simp

theorem the_two_coordinates_do_not_cross (ρ : ℂ) (n : ℝ) (hn : 1 ≤ n) (k : Fin 3) :
    (2 < c_spectral n) ∧
    ((Omega_hat k).re = 1/2 ∨ (Omega_hat k).re = -(1/4)) ∧
    ((rad₉ ρ (1 - ρ)).im = ρ.im) ∧
    ((rad₉ ρ (1 - ρ)).re = ρ.re - 1/2) := by
  refine ⟨c_gt_two hn, Omega_hat_is_about_the_real_part k, ?_,
          radius_re_is_re_minus_half ρ⟩
  rw [radius_is_rho_minus_half ρ]; simp

theorem what_would_still_be_needed (L : ℂ → ℂ) :
    (LandsOnSpectrum L ↔
      (∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 → L ρ = 0 → ρ.re = 1/2)) ∧
    (GDS L ↔ (∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 → L ρ = 0 → ρ.re = 1/2)) :=
  ⟨landing_iff_E L, GDS_iff_E L⟩

theorem the_two_coordinates_are_in_one_equation (ρ : ℂ) (hρ : ρ ≠ 0)
    (hd : ρ.re ^ 2 + ρ.im ^ 2 ≠ 0) :
    1 - 2 * ρ.re = ((zeroCoord ρ) ^ 2 - 1) * (ρ.re ^ 2 + ρ.im ^ 2) :=
  the_bound_reaches_the_other_family ρ hρ hd

theorem the_real_part_is_determined_by_the_ordinate_and_the_defect (ρ : ℂ)
    (hρ : ρ ≠ 0) (hd : ρ.re ^ 2 + ρ.im ^ 2 ≠ 0) :
    2 * ρ.re = 1 - ((zeroCoord ρ) ^ 2 - 1) * (ρ.re ^ 2 + ρ.im ^ 2) := by
  have h := the_bound_reaches_the_other_family ρ hρ hd
  linarith

theorem the_ordinate_constrains_the_real_part (ρ : ℂ) (hρ : ρ ≠ 0)
    (hd : ρ.re ^ 2 + ρ.im ^ 2 ≠ 0) (h0 : 0 < ρ.re) (h1 : ρ.re < 1)
    (hγ : 2 ≤ |ρ.im|) :
    |(zeroCoord ρ) ^ 2 - 1| ≤ 1/4 :=
  noLowZeros_forces_a_small_defect ρ hρ hd h0 h1 hγ

theorem zero_defect_forces_the_line (ρ : ℂ) (hρ : ρ ≠ 0)
    (hd : ρ.re ^ 2 + ρ.im ^ 2 ≠ 0) (hz : (zeroCoord ρ) ^ 2 - 1 = 0) :
    ρ.re = 1/2 := by
  have h := the_bound_reaches_the_other_family ρ hρ hd
  rw [hz] at h
  simp at h
  linarith

theorem the_coordinates_do_cross (ρ : ℂ) (hρ : ρ ≠ 0)
    (hd : ρ.re ^ 2 + ρ.im ^ 2 ≠ 0) (h0 : 0 < ρ.re) (h1 : ρ.re < 1)
    (hγ : 2 ≤ |ρ.im|) :
    (1 - 2 * ρ.re = ((zeroCoord ρ) ^ 2 - 1) * (ρ.re ^ 2 + ρ.im ^ 2)) ∧
    (|(zeroCoord ρ) ^ 2 - 1| ≤ 1/4) ∧
    (((zeroCoord ρ) ^ 2 - 1 = 0) → ρ.re = 1/2) :=
  ⟨the_bound_reaches_the_other_family ρ hρ hd,
   noLowZeros_forces_a_small_defect ρ hρ hd h0 h1 hγ,
   fun hz => zero_defect_forces_the_line ρ hρ hd hz⟩

theorem the_bound_gives_nothing_about_beta (ρ : ℂ) (hρ : ρ ≠ 0)
    (hd : ρ.re ^ 2 + ρ.im ^ 2 ≠ 0) (h0 : 0 < ρ.re) (h1 : ρ.re < 1)
    (hγ : 2 ≤ |ρ.im|) :
    |1 - 2 * ρ.re| ≤ (ρ.re ^ 2 + ρ.im ^ 2) / 4 := by
  have hid := the_bound_reaches_the_other_family ρ hρ hd
  have hb := noLowZeros_forces_a_small_defect ρ hρ hd h0 h1 hγ
  have hpos : (0:ℝ) ≤ ρ.re ^ 2 + ρ.im ^ 2 := by positivity
  rw [hid, abs_mul, abs_of_nonneg hpos]
  nlinarith [hb, hpos]

theorem the_bound_is_vacuous_in_the_band (ρ : ℂ) (h0 : 0 < ρ.re) (h1 : ρ.re < 1)
    (hγ : 2 ≤ |ρ.im|) :
    (|1 - 2 * ρ.re| < 1) ∧ (1 ≤ (ρ.re ^ 2 + ρ.im ^ 2) / 4) := by
  constructor
  · rw [abs_lt]; constructor <;> linarith
  · have h4 : (4:ℝ) ≤ ρ.im ^ 2 := by
      have hs : |ρ.im| ^ 2 = ρ.im ^ 2 := sq_abs ρ.im
      nlinarith [hγ, abs_nonneg ρ.im, hs]
    nlinarith [sq_nonneg ρ.re, h4]

theorem the_defect_is_the_real_part_over_the_modulus (ρ : ℂ) (hρ : ρ ≠ 0)
    (hd : ρ.re ^ 2 + ρ.im ^ 2 ≠ 0) :
    (zeroCoord ρ) ^ 2 - 1 = (1 - 2 * ρ.re) / (ρ.re ^ 2 + ρ.im ^ 2) :=
  the_bridge_between_the_two_radii ρ hρ

theorem the_defect_vanishes_iff_E (ρ : ℂ) (hρ : ρ ≠ 0)
    (hd : ρ.re ^ 2 + ρ.im ^ 2 ≠ 0) :
    ((zeroCoord ρ) ^ 2 - 1 = 0) ↔ ρ.re = 1/2 := by
  rw [the_defect_is_the_real_part_over_the_modulus ρ hρ hd, div_eq_zero_iff]
  constructor
  · rintro (h | h)
    · linarith
    · exact absurd h hd
  · intro h; left; rw [h]; ring

theorem where_the_attempt_stops (ρ : ℂ) (hρ : ρ ≠ 0)
    (hd : ρ.re ^ 2 + ρ.im ^ 2 ≠ 0) (h0 : 0 < ρ.re) (h1 : ρ.re < 1)
    (hγ : 2 ≤ |ρ.im|) :
    (|1 - 2 * ρ.re| ≤ (ρ.re ^ 2 + ρ.im ^ 2) / 4) ∧
    ((|1 - 2 * ρ.re| < 1) ∧ (1 ≤ (ρ.re ^ 2 + ρ.im ^ 2) / 4)) ∧
    (((zeroCoord ρ) ^ 2 - 1 = 0) ↔ ρ.re = 1/2) :=
  ⟨the_bound_gives_nothing_about_beta ρ hρ hd h0 h1 hγ,
   the_bound_is_vacuous_in_the_band ρ h0 h1 hγ,
   the_defect_vanishes_iff_E ρ hρ hd⟩

theorem the_full_system_admits_off_line_points :
    (0 < (0.3 : ℝ) ∧ (0.3 : ℝ) < 1) ∧
    ((0.3 : ℝ) ≠ 1/2) ∧
    (|1 - 2 * (0.3 : ℝ)| < 1) ∧
    ((2:ℝ) ≤ 6.6) ∧
    (1 ≤ ((0.3:ℝ) ^ 2 + (6.6:ℝ) ^ 2) / 4) := by
  refine ⟨⟨by norm_num, by norm_num⟩, by norm_num, ?_, by norm_num, by norm_num⟩
  rw [abs_lt]; constructor <;> norm_num

theorem the_system_is_a_conjunction_of_bounds (ρ : ℂ) (hρ : ρ ≠ 0)
    (hd : ρ.re ^ 2 + ρ.im ^ 2 ≠ 0) (h0 : 0 < ρ.re) (h1 : ρ.re < 1)
    (hγ : 2 ≤ |ρ.im|) :
    (ctr₉ ρ (1 - ρ) = 1/2) ∧
    ((rad₉ ρ (1 - ρ)).re = ρ.re - 1/2) ∧
    ((zeroCoord ρ) ^ 2 - 1 = (1 - 2 * ρ.re) / (ρ.re ^ 2 + ρ.im ^ 2)) ∧
    (|(zeroCoord ρ) ^ 2 - 1| ≤ 1/4) ∧
    (|(rad₉ ρ (1 - ρ)).re| < 1/2) :=
  ⟨the_centre_is_fixed_for_every_zero ρ,
   radius_re_is_re_minus_half ρ,
   the_defect_is_the_real_part_over_the_modulus ρ hρ hd,
   noLowZeros_forces_a_small_defect ρ hρ hd h0 h1 hγ,
   radius_re_bounded_by_the_apex ρ h0 h1⟩

theorem every_constraint_is_satisfied_off_the_line :
    ((0.3:ℝ) ≠ 1/2) ∧
    (|1 - 2 * (0.3:ℝ)| < 1) ∧
    ((0:ℝ) < 0.3 ∧ (0.3:ℝ) < 1) ∧
    ((2:ℝ) ≤ 6.6) := by
  refine ⟨by norm_num, ?_, ⟨by norm_num, by norm_num⟩, by norm_num⟩
  rw [abs_lt]; constructor <;> norm_num

theorem the_system_does_not_close (ρ : ℂ) (hρ : ρ ≠ 0)
    (hd : ρ.re ^ 2 + ρ.im ^ 2 ≠ 0) (h0 : 0 < ρ.re) (h1 : ρ.re < 1)
