  · intro h
    have hx1 : x ≤ 1 := (Real.log_nonpos_iff hx.le).mp (le_of_eq h)
    have hx2 : 1 ≤ x := (Real.log_nonneg_iff hx).mp (le_of_eq h.symm)
    linarith
  · rintro rfl; norm_num

-- SHIM REMOVAL (2026-09-12): `div_lt_iff'` eliminada — usos migrados a `div_lt_iff₀` directamente.

/-- compat: old `Real.log_eq_zero_iff` alternative -/
theorem Real.log_eq_zero_iff' {x : ℝ} (hx : 0 < x) : Real.log x = 0 ↔ x = 1 := by
  rw [Real.log_eq_zero]
  constructor
  · intro h
    rcases h with h0 | h1 | hm1
    · linarith
    · exact h1
    · linarith
  · intro h; right; left; exact h


