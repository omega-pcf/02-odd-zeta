theorem embedding_target_is_the_orbit_shadow :
    (Omega_hat 0).re = 1/2 ∧ (Omega_hat 1).re = -(1/4) ∧
    (Omega_hat 2).re = -(1/4) :=
  ⟨spectral_positions_values.1, spectral_positions_values.2.1,
   spectral_positions_values.2.2⟩

theorem embedding_is_the_third_arrow (reZero : ℂ → ℝ)
    (h : ∀ ρ : ℂ, 0 < reZero ρ → reZero ρ < 1 →
      (reZero ρ = 1/2 ∨ reZero ρ = -(1/4))) :
    ∀ ρ : ℂ, 0 < reZero ρ → reZero ρ < 1 → reZero ρ = 1/2 := by
  intro ρ h0 h1
  rcases h ρ h0 h1 with hh | hh
  · exact hh
  · exfalso; rw [hh] at h0; linarith

theorem the_chain_three_two_one :
    (w_pcf ^ 3 = 1 ∧ w_pcf ≠ 1) ∧
    (Omega_hat 0 ≠ Omega_hat 1) ∧
    ((Omega_hat 1).re = (Omega_hat 2).re) ∧
    (¬ (0 < -(1:ℝ)/4)) ∧
    ((3:ℝ) ^ 2 / 6 = 3 / 2) :=
  ⟨⟨omega_cubed, omega_order_is_exactly_three.1⟩,
   orbit_is_free_in_C.1,
   real_projection_collapses,
   band_leaves_one.2,
   by norm_num⟩

noncomputable def OmegaZ (n : ℤ) : ℂ := (1/2 : ℝ) * w_pcf ^ n

theorem omegaZ_exponent_add (m n : ℤ) :
    w_pcf ^ (m + n) = w_pcf ^ m * w_pcf ^ n :=
  zpow_add₀ (by
    intro h
    have := congrArg Complex.re h
    rw [w_pcf_re_im.1] at this
    norm_num at this) m n

theorem omegaZ_kernel_three (k : ℤ) : w_pcf ^ (3 * k) = 1 := by
  have h3 : w_pcf ^ (3:ℤ) = 1 := by simpa using omega_cubed
  rw [zpow_mul, h3, one_zpow]

theorem omegaZ_factors_mod_three (m n : ℤ) (h : ∃ k : ℤ, m - n = 3 * k) :
    OmegaZ m = OmegaZ n := by
  obtain ⟨k, hk⟩ := h
  have hm : m = n + 3 * k := by linarith
  unfold OmegaZ
  rw [hm, omegaZ_exponent_add, omegaZ_kernel_three, mul_one]

theorem realise_separates_what_omega_identifies :
    ((φ : ℝ) ^ (0 : ℤ) ≠ (φ : ℝ) ^ (3 : ℤ)) ∧ (OmegaZ 0 = OmegaZ 3) := by
  constructor
  · intro h
    have := realise_injective h
    norm_num at this
  · exact omegaZ_factors_mod_three 0 3 ⟨-1, by ring⟩

theorem degree_zero_lands_on_the_apex :
    OmegaZ 0 = ((1:ℝ)/2 : ℂ) ∧ ((φ : ℝ) ^ (0 : ℤ) = 1) := by
  constructor
  · unfold OmegaZ; simp
  · exact zpow_zero _

theorem the_two_realisations :
    (∀ k : ℤ, w_pcf ^ (3 * k) = 1) ∧
    (Function.Injective (fun n : ℤ => (φ : ℝ) ^ n)) ∧
    (OmegaZ 0 = ((1:ℝ)/2 : ℂ)) ∧
    ((φ : ℝ) ^ (0 : ℤ) = 1) :=
  ⟨omegaZ_kernel_three, realise_injective,
   degree_zero_lands_on_the_apex.1, degree_zero_lands_on_the_apex.2⟩

theorem coord_gt_one_iff_re_lt_half (ρ : ℂ) (h0 : 0 < ρ.re) (h1 : ρ.re < 1) :
    1 < zeroCoord ρ ↔ ρ.re < 1/2 := by
  have hρ : ρ ≠ 0 := by intro h; rw [h] at h0; simp at h0
  have hns : 0 < ρ.re ^ 2 + ρ.im ^ 2 := by
    rcases eq_or_ne ρ.im 0 with h | h
    · rw [h]; nlinarith
    · nlinarith [mul_self_pos.mpr h]
  have hdef := liMap_sq_defect ρ hρ
  have hpos : 0 < zeroCoord ρ := by
    unfold zeroCoord
    apply Complex.abs.pos
    intro hz
    unfold liMap at hz
    have h5 : (1:ℂ) = 1 / ρ := sub_eq_zero.mp hz
    rw [one_div, eq_comm, inv_eq_one] at h5
    rw [h5] at h1
    simp at h1
  constructor
  · intro h
    have hsq : 1 < zeroCoord ρ ^ 2 := by nlinarith [h, hpos]
    have : 0 < (1 - 2 * ρ.re) / (ρ.re ^ 2 + ρ.im ^ 2) := by
      unfold zeroCoord at hsq hdef; linarith [hdef, hsq]
    have := (div_pos_iff).mp this
    rcases this with ⟨hn, _⟩ | ⟨_, hd⟩
    · linarith
    · linarith
  · intro h
    have hnum : 0 < 1 - 2 * ρ.re := by linarith
    have : 0 < (1 - 2 * ρ.re) / (ρ.re ^ 2 + ρ.im ^ 2) := div_pos hnum hns
    have hsq : 1 < zeroCoord ρ ^ 2 := by
      unfold zeroCoord at hdef ⊢; linarith [hdef, this]
    nlinarith [hsq, hpos]

theorem coord_eq_one_iff_re_half (ρ : ℂ) (h0 : 0 < ρ.re) :
    zeroCoord ρ = 1 ↔ ρ.re = 1/2 :=
  hcoord_discharged ρ h0

theorem one_deviation_two_readings (ρ : ℂ) (h0 : 0 < ρ.re) (h1 : ρ.re < 1) :
    (1 < zeroCoord ρ ↔ ρ.re < 1/2) ∧
    (zeroCoord ρ = 1 ↔ ρ.re = 1/2) :=
  ⟨coord_gt_one_iff_re_lt_half ρ h0 h1, coord_eq_one_iff_re_half ρ h0⟩

theorem one_action_two_shadows (p : ℕ) (n : ℤ) :
    ((φ : ℝ) ^ ((p : ℤ) * n) = ((φ : ℝ) ^ n) ^ p) ∧
    (OmegaZ ((p : ℤ) * n) = (1/2 : ℝ) * w_pcf ^ ((p : ℤ) * n)) :=
  ⟨family_carries_power_action p n, rfl⟩

theorem same_domain_hence_simultaneous (n : ℤ) :
    ((φ : ℝ) ^ n = (φ : ℝ) ^ n) ∧ (OmegaZ n = (1/2 : ℝ) * w_pcf ^ n) :=
  ⟨rfl, rfl⟩

theorem the_retraction (ρ : ℂ) (h0 : 0 < ρ.re) (h1 : ρ.re < 1) :
    (1 < zeroCoord ρ ↔ ρ.re < 1/2) ∧
    (zeroCoord ρ = 1 ↔ ρ.re = 1/2) ∧
    (∀ p : ℕ, ∀ n : ℤ, (φ : ℝ) ^ ((p : ℤ) * n) = ((φ : ℝ) ^ n) ^ p) :=
  ⟨coord_gt_one_iff_re_lt_half ρ h0 h1,
   coord_eq_one_iff_re_half ρ h0,
   fun p n => family_carries_power_action p n⟩

theorem family_closed_under_psi (r : ℝ) (k : ℤ) (hk : r = (φ : ℝ) ^ k) (p : ℕ) :
    r ^ p = (φ : ℝ) ^ ((p : ℤ) * k) := by
  rw [hk, family_carries_power_action]

theorem disc_integral_after_psi (r : ℝ) (k : ℤ) (hk : r = (φ : ℝ) ^ k) (p : ℕ) :
    ∃ j : ℤ, r ^ p = (φ : ℝ) ^ j := by
  exact ⟨(p : ℤ) * k, family_closed_under_psi r k hk p⟩

theorem valPhi_conjugates_power_with_psi (r : ℝ) (_hr : 0 < r) (p : ℕ) :
    valPhi (r ^ p) = (p : ℝ) * valPhi r := by
  unfold valPhi
  rw [Real.log_pow, mul_div_assoc]

theorem the_square_commutes (n : ℤ) (p : ℕ) :
    valPhi (((φ : ℝ) ^ n) ^ p) = (p : ℝ) * (n : ℝ) := by
  rw [valPhi_conjugates_power_with_psi _ (zpow_pos φ_pos n) p, valPhi_realise]

theorem valPhi_is_the_bridge_to_psi (n : ℤ) (p : ℕ) :
    valPhi (((φ : ℝ) ^ n) ^ p) = ((((p : ℤ) * n : ℤ)) : ℝ) := by
  rw [the_square_commutes n p]; push_cast; ring

theorem types_do_not_match :
    (∀ n : ℤ, ((φ : ℝ) ^ n) = ((φ : ℝ) ^ n)) := fun _ => rfl

theorem the_monoid_implications_resolved (n : ℤ) (p : ℕ) (r : ℝ) (hr : 0 < r) :
    (∃ j : ℤ, ((φ : ℝ) ^ n) ^ p = (φ : ℝ) ^ j) ∧
    (valPhi (r ^ p) = (p : ℝ) * valPhi r) ∧
    (valPhi (((φ : ℝ) ^ n) ^ p) = ((((p : ℤ) * n : ℤ)) : ℝ)) :=
  ⟨disc_integral_after_psi _ n rfl p,
   valPhi_conjugates_power_with_psi r hr p,
   valPhi_is_the_bridge_to_psi n p⟩

theorem closure_presupposes_membership (r : ℝ) (p : ℕ)
    (hmem : ∃ k : ℤ, r = (φ : ℝ) ^ k) :
    ∃ j : ℤ, r ^ p = (φ : ℝ) ^ j := by
  obtain ⟨k, hk⟩ := hmem
  exact ⟨(p : ℤ) * k, family_closed_under_psi r k hk p⟩

theorem closure_without_membership_is_empty :
    ((φ : ℝ) < 2) ∧ ((2:ℝ) < (φ : ℝ) ^ 2) := by
  have h5 : (2.23 : ℝ) < Real.sqrt 5 := by
    nlinarith [Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 5), Real.sqrt_nonneg 5]
  have h5' : Real.sqrt 5 < 2.24 := by
    nlinarith [Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 5), Real.sqrt_nonneg 5]
  constructor
  · unfold φ; linarith
  · have := phi_sq; unfold φ at *; linarith

theorem equivariance_is_blind_to_membership (p : ℕ) :
    valPhi ((2:ℝ) ^ p) = (p : ℝ) * valPhi 2 :=
  valPhi_conjugates_power_with_psi 2 (by norm_num) p

theorem integrality_of_valuation_is_E (r : ℝ) (hr : 0 < r)
    (hle : discP r ≤ 1/12) (k : ℤ) (hk : valPhi r = (k : ℝ)) :
    r = 1 := by
  have hmem : ∃ j : ℤ, r = (φ : ℝ) ^ j :=
    (monomial_iff_valPhi_int r hr).mpr ⟨k, hk⟩
  exact (monomial_iff_one_under_confinement r hr hle).mp hmem

theorem what_I1_and_I2_do_not_give (r : ℝ) (hr : 0 < r) (p : ℕ) :
    ((∃ k : ℤ, r = (φ : ℝ) ^ k) → ∃ j : ℤ, r ^ p = (φ : ℝ) ^ j) ∧
    (valPhi (r ^ p) = (p : ℝ) * valPhi r) ∧
    ((φ : ℝ) < 2 ∧ (2:ℝ) < (φ : ℝ) ^ 2) :=
  ⟨fun h => closure_presupposes_membership r p h,
   valPhi_conjugates_power_with_psi r hr p,
   closure_without_membership_is_empty⟩

theorem confinement_is_the_strip (β : ℝ) :
    (0 < β ∧ β < 1) ↔ |1 - 2 * β| < 1 := by
  constructor
  · rintro ⟨h0, h1⟩; rw [abs_lt]; constructor <;> linarith
  · intro h; rw [abs_lt] at h; exact ⟨by linarith [h.2], by linarith [h.1]⟩

theorem E_coordinate_exponent_is_zero (ρ : ℂ) (h0 : 0 < ρ.re)
    (hE : ρ.re = 1/2) : valPhi (zeroCoord ρ) = 0 := by
  rw [(hcoord_discharged ρ h0).mpr hE]
  unfold valPhi; simp

theorem E_real_part_exponent_is_neg_lambda (ρ : ℂ) (hE : ρ.re = 1/2) :
    valPhi ρ.re = -(Real.log 2 / Real.log (φ : ℝ)) := by
  rw [hE]
  unfold valPhi
  rw [show (1:ℝ)/2 = 2⁻¹ by norm_num, Real.log_inv]
  ring

/-- (2026-09-06, Ola 4) `2` no es potencia de `φ`: n≤0 da φⁿ≤1, n=1 da φ<2,
    n=2 da φ²=φ+1>2, n≥3 es monótono por encima. Sustituye el identificador
    fantasma `two_not_in_golden_lattice`. Prueba verificada en
    /tmp/probe_wave4_lattice8.lean. -/
theorem two_not_in_golden_lattice : ¬ ∃ n : ℤ, (φ : ℝ) ^ n = 2 := by
  rintro ⟨n, hn⟩
  have hφpos : (0:ℝ) < φ := φ_pos
  have h1 : (1:ℝ) < φ := one_lt_phi
  have hlt2 : (φ : ℝ) < 2 := by
    have hsq := phi_sq
    have hsq0 : (φ : ℝ) ^ 2 ≥ 0 := sq_nonneg _
    nlinarith [h1]
  have hone : (1:ℝ) ≤ φ := le_of_lt h1
  rcases lt_or_ge n 1 with hn1 | hn1
  · have hn0 : n ≤ 0 := by omega
    have hc : (φ : ℝ) ^ n ≤ (φ : ℝ) ^ (0:ℤ) := zpow_le_zpow_right₀ hone hn0
    rw [zpow_zero] at hc
    exact absurd hn (by linarith)
  · rcases lt_or_ge n 2 with hn2 | hn2
    · have hn11 : (n:ℤ) = 1 := by omega
      rw [hn11, zpow_one] at hn
      linarith
    · if hn22 : (n:ℤ) = 2 then
        rw [hn22, zpow_ofNat] at hn
        rw [phi_sq] at hn
        linarith
      else
        have hge2 : (2:ℤ) ≤ n := by omega
        have hc : (φ : ℝ) ^ 2 ≤ (φ : ℝ) ^ n := zpow_le_zpow_right₀ hone hge2
        rw [phi_sq] at hc
        linarith

theorem lambda_is_not_an_integer :
    ¬ ∃ n : ℤ, (φ : ℝ) ^ n = 2 :=
  two_not_in_golden_lattice

theorem E_has_two_phi_adic_exponents (ρ : ℂ) (h0 : 0 < ρ.re) (hE : ρ.re = 1/2) :
    (valPhi (zeroCoord ρ) = 0) ∧
    (valPhi ρ.re = -(Real.log 2 / Real.log (φ : ℝ))) ∧
    (¬ ∃ n : ℤ, (φ : ℝ) ^ n = 2) :=
  ⟨E_coordinate_exponent_is_zero ρ h0 hE,
   E_real_part_exponent_is_neg_lambda ρ hE,
   lambda_is_not_an_integer⟩

theorem everything_determined_but_existence (r : ℝ) (hr : 0 < r) (p : ℕ)
    (hle : discP r ≤ 1/12) :
    (valPhi (r ^ p) = (p : ℝ) * valPhi r) ∧
    ((∃ k : ℤ, r = (φ : ℝ) ^ k) → ∃ j : ℤ, r ^ p = (φ : ℝ) ^ j) ∧
    ((∃ k : ℤ, r = (φ : ℝ) ^ k) → r = 1) :=
  ⟨valPhi_conjugates_power_with_psi r hr p,
   fun h => closure_presupposes_membership r p h,
   fun h => (monomial_iff_one_under_confinement r hr hle).mp h⟩

theorem log_phi_via_pi_and_MPCF :
    Real.log (φ : ℝ) = 6 * Real.sqrt 3 * Real.pi / M_PCF := by
  unfold M_PCF
  have h3 : (0:ℝ) < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
  have hlog : Real.log (φ : ℝ) ≠ 0 := ne_of_gt (Real.log_pos one_lt_phi)
  field_simp

theorem eps0_relates_log_and_geometry :
    Real.log (φ : ℝ) = 6 * Real.sqrt 3 * epsilon_0 := by
  unfold epsilon_0
  have h3 : (0:ℝ) < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
  field_simp

theorem tower_level_is_valPhi (x : ℝ) (hx : 0 < x) (σ : ℝ) :
    epsilon_0 * (φ : ℝ) ^ σ = epsilon_0 * x ↔ (φ : ℝ) ^ σ = x := by
  have he : epsilon_0 ≠ 0 := by
    unfold epsilon_0
    have h3 : (0:ℝ) < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
    exact div_ne_zero (ne_of_gt (Real.log_pos one_lt_phi)) (by positivity)
  constructor
  · intro h; exact mul_left_cancel₀ he h
  · intro h; rw [h]

theorem integer_levels_are_the_family (r : ℝ) (hr : 0 < r) :
