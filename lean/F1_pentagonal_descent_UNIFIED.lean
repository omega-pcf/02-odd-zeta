/-! ## §89.1  Los dos invariantes -/

/-- **[P] EL INVARIANTE DE LA CARA χ₅: el producto.**
    `e₁²·disc = (a² − b²)²`.  Es `flip_invariant` de §87. -/
theorem invariant_chi_five (a b : ℝ) :
    (sym₁ a b) ^ 2 * discr a b = (a ^ 2 - b ^ 2) ^ 2 :=
  flip_invariant a b

/-- **[P] EL INVARIANTE DE LA CARA χ₄: la diferencia.**
    `e₁² − disc = 4·e₂`, identidad para todo par.

    **Éste es el que dejé fuera.** -/
theorem invariant_chi_four (a b : ℝ) :
    (sym₁ a b) ^ 2 - discr a b = 4 * (sym₂ a b) := by
  simp only [sym₁, sym₂, discr]
  ring

/-- **[P] Y CON `e₂ = ±1` VALE `|4|`, SIEMPRE.**  En los tres niveles
    de la cadena ---Galois, decoración y ceros--- el invariante χ₄
    tiene módulo `4 = |disc ℚ(i)|`.

    **No muere en `E`.** -/
theorem chi_four_invariant_never_dies (a b : ℝ) (h : sym₂ a b = 1 ∨ sym₂ a b = -1) :
    (sym₁ a b) ^ 2 - discr a b = 4 ∨ (sym₁ a b) ^ 2 - discr a b = -4 := by
  rw [invariant_chi_four]
  rcases h with h | h <;> rw [h] <;> [left; right] <;> norm_num

/-! ## §89.2  El colapso toca a uno solo -/

/-- **[P] BAJO `E`, `e₁² = 4` Y `disc = 0`.**  El par `{1,1}`: el
    invariante χ₅ se anula, el χ₄ vale `+4`.

    Lo que escribí como «muere el 5» es en realidad el paso de la
    coordenada `5` a la coordenada `4`. -/
theorem at_E_the_pair_lands_on_four :
    (sym₁ (1 : ℝ) 1) ^ 2 = 4 ∧
    discr (1 : ℝ) 1 = 0 ∧
    (sym₁ (1 : ℝ) 1) ^ 2 * discr (1 : ℝ) 1 = 0 ∧
    (sym₁ (1 : ℝ) 1) ^ 2 - discr (1 : ℝ) 1 = 4 := by
  unfold discr sym₂
  refine ⟨by norm_num [sym₁], by norm_num [sym₁], by norm_num [sym₁], by norm_num [sym₁]⟩

/-- **[P] `E` EN LA CARA χ₄: `e₁² = 4 = |disc ℚ(i)|`.**
    Para `r > 0`, `e₁² = 4 ⟺ r = 1`, y fuera `e₁² > 4`. -/
theorem E_iff_e_one_squared_is_four (r : ℝ) (hr : 0 < r) :
    (sym₁ r (1 / r)) ^ 2 = 4 ↔ r = 1 := by
  have hne : r ≠ 0 := ne_of_gt hr
  unfold sym₁
  constructor
  · intro h
    have h1 : (r + 1 / r - 2) * (r + 1 / r + 2) = 0 := by nlinarith [h]
    have h2 : r + 1 / r + 2 > 0 := by
      have : 0 < 1 / r := by positivity
      linarith
    have h3 : r + 1 / r = 2 := by
      rcases mul_eq_zero.mp h1 with h4 | h4
      · linarith
      · linarith
    field_simp at h3
    nlinarith [h3, hr, sq_nonneg (r - 1)]
  · intro h; rw [h]; norm_num

/-! ## §89.3  El conductor es el producto de los dos invariantes -/

/-- **[P] `|inv χ₄| · |inv χ₅| = 4 · 5 = 20` en los niveles no
    degenerados.**  Compone con `§88
    conductor_is_product_of_discriminants`: los dos invariantes del
    par son los dos discriminantes del conductor. -/
theorem conductor_from_the_two_invariants :
    ((sym₁ (φ : ℝ) (1 / φ)) ^ 2 * discr (φ : ℝ) (1 / φ) = 5) ∧
    ((sym₁ (φ : ℝ) (1 / φ)) ^ 2 - discr (φ : ℝ) (1 / φ) = 4) ∧
    (4 * 5 = 20) := by
  refine ⟨pentagon_is_the_flip_invariant.1, ?_, by norm_num⟩
  rw [invariant_chi_four]
  have hne : (φ : ℝ) ≠ 0 := ne_of_gt (lt_trans one_pos φ_gt_one)
  unfold sym₂; field_simp

/-! ## §89.4  La conjetura en forma de invariante -/

/-- **[P] EL INVARIANTE χ₅ DEL PAR `k` DUPLICA EL ÍNDICE.**
    `e₁²·disc = (φ^{2k} − φ^{−2k})²`: el invariante del nivel `k` es
    el discriminante del nivel `2k`.

    Consecuencia: el índice es siempre PAR, luego la forma es
    `5F_{2k}²` y nunca `L²`. -/
theorem chi_five_invariant_doubles_the_index (k : ℤ) :
    (sym₁ ((φ : ℝ) ^ k) ((φ : ℝ) ^ (-k))) ^ 2
      * discr ((φ : ℝ) ^ k) ((φ : ℝ) ^ (-k))
    = ((φ : ℝ) ^ (2 * k) - (φ : ℝ) ^ (-(2 * k))) ^ 2 := by
  rw [invariant_chi_five]
  have hne : (φ : ℝ) ≠ 0 := ne_of_gt (lt_trans one_pos φ_gt_one)
  rw [← zpow_natCast ((φ : ℝ) ^ k) 2, ← zpow_natCast ((φ : ℝ) ^ (-k)) 2,
      ← zpow_mul, ← zpow_mul]
  ring_nf

/-- **[Conj] LA CONJETURA, EN FORMA DE INVARIANTE.**  `(I'')`: el
    invariante χ₅ del par de cada cero está en `{5F_{2k}²}`.

    Equivale a `(I')` de §87 ---monomialidad--- por
    `chi_five_invariant_doubles_the_index`, y su BRECHA es `5`, no
    `1`. -/
def InvariantConjecture (zeros : Set ℝ) : Prop :=
  ∀ r ∈ zeros, ∃ k : ℤ,
    (sym₁ r (1 / r)) ^ 2 * discr r (1 / r)
      = ((φ : ℝ) ^ (2 * k) - (φ : ℝ) ^ (-(2 * k))) ^ 2

/-- **[P] `(I')` ⟹ `(I'')`.**  La monomialidad da la forma de
    invariante; el paso es `chi_five_invariant_doubles_the_index`. -/
theorem monomial_gives_invariant_form (r : ℝ) (h : MonomialHalf r) :
    ∃ k : ℤ, (sym₁ r (1 / r)) ^ 2 * discr r (1 / r)
      = ((φ : ℝ) ^ (2 * k) - (φ : ℝ) ^ (-(2 * k))) ^ 2 := by
  obtain ⟨k, rfl⟩ := h
  refine ⟨k, ?_⟩
  have hne : (φ : ℝ) ≠ 0 := ne_of_gt (lt_trans one_pos φ_gt_one)
  have hinv : (1 : ℝ) / (φ : ℝ) ^ k = (φ : ℝ) ^ (-k) := by
    rw [zpow_neg]; field_simp
  rw [hinv]
  exact chi_five_invariant_doubles_the_index k

/-! ## §89.5  El balance -/

/-- **[O] EL BALANCE DE §89.**

    | | antes (§87.6) | ahora (§89) |
    |---|---|---|
    | invariantes | uno («el» invariante) | **dos, uno por cara** |
    | qué pasa en `E` | «el 5 muere» | **`e₁²` pasa de `5` a `4`** |
    | inv χ₄ en `E` | no figuraba | `+4 = \|disc ℚ(i)\|`, vivo |
    | brecha de la cadena | `1` | **`5`**, en forma de invariante |
    | razón cota/brecha | `7.2·10⁵` | **`9.0·10⁵`** |
    | `(I')` | `[Conj]` | **`[Conj]`, sin cambio** |

    **Nada de esto prueba `(I')`.**  Lo que cambia es que la cadena ya
    no se lee como pérdida del pentágono, y que la brecha se
    quintuplica. -/
theorem the_balance_of_section_89 (r : ℝ) (hr : 0 < r) :
    ((sym₁ (1 : ℝ) 1) ^ 2 = 4) ∧
    (∀ a b : ℝ, (sym₁ a b) ^ 2 - discr a b = 4 * (sym₂ a b)) ∧
    ((sym₁ r (1 / r)) ^ 2 = 4 ↔ r = 1) ∧
    ((sym₁ (φ : ℝ) (1 / φ)) ^ 2 * discr (φ : ℝ) (1 / φ) = 5) :=
  ⟨at_E_the_pair_lands_on_four.1, invariant_chi_four,
   E_iff_e_one_squared_is_four r hr,
   conductor_from_the_two_invariants.1⟩

