namespace PeriodicasSol

/-! ## §1  Lefschetz -/

/-- Matrices enteras 2×2 como cuádruplas (a, b; c, d). -/
structure M2 where
  a : ℤ
  b : ℤ
  c : ℤ
  d : ℤ
  deriving DecidableEq

def M2.mul (X Y : M2) : M2 :=
  ⟨X.a * Y.a + X.b * Y.c, X.a * Y.b + X.b * Y.d, X.c * Y.a + X.d * Y.c, X.c * Y.b + X.d * Y.d⟩

def M2.one : M2 := ⟨1, 0, 0, 1⟩
def M : M2 := ⟨0, 1, 1, 1⟩

def M2.pow (X : M2) : ℕ → M2
  | 0 => M2.one
  | n + 1 => M2.mul (M2.pow X n) X

def M2.tr (X : M2) : ℤ := X.a + X.d
def M2.det (X : M2) : ℤ := X.a * X.d - X.b * X.c

/-- Puntos fijos de Mⁿ en el toro: |det(Mⁿ − I)|. -/
def fixedPoints (n : ℕ) : ℕ :=
  let X := M2.pow M n
  ((X.a - 1) * (X.d - 1) - X.b * X.c).natAbs

def lucasL : ℕ → ℕ
  | 0 => 2
  | 1 => 1
  | n + 2 => lucasL (n + 1) + lucasL n

/-- **[P*] Las trazas son los Lucas:** tr Mⁿ = Lₙ, n < 20. -/
theorem traces_are_lucas :
    (List.range 20).map (fun n => (M2.pow M n).tr) = (List.range 20).map (fun n => (lucasL n : ℤ)) := by
  decide

/-- **[P*] Lefschetz:** los puntos fijos de Mⁿ son Lₙ − 1 − (−1)ⁿ: 1, 1, 4, 5, 11, 16, 29,
    45, 76, 121, 199, 320 (n = 1 … 12). -/
theorem lefschetz_counts :
    (List.range 12).map (fun n => fixedPoints (n + 1)) = [1, 1, 4, 5, 11, 16, 29, 45, 76, 121, 199, 320]
    ∧ ∀ n ∈ List.range 20, (fixedPoints (n + 1) : ℤ) = lucasL (n + 1) - 1 - (-1) ^ (n + 1) := by
  decide

/-- **[P*] det M = −1 y det Mⁿ = (−1)ⁿ:** la orientación se invierte en cada vuelta. -/
theorem det_pow : ∀ n ∈ List.range 20, (M2.pow M n).det = (-1) ^ n := by decide

/-! ## §3  La 3-variedad módulo p -/

/-- El paso de M sobre (ℤ/m)²: (x, y) ↦ (y, x + y), la multiplicación por φ. -/
def step {m : ℕ} (v : ZMod m × ZMod m) : ZMod m × ZMod m := (v.2, v.1 + v.2)

/-- **[P*] Recta propia ⇔ raíz de X² − X − 1:** M(1, a) = a·(1, a) ⇔ a² = a + 1, en todo
    anillo conmutativo.  En ℤ/p: los ideales (p, φ − a) de grado uno. -/
theorem eigenline {R : Type*} [CommRing R] (a : R) :
    ((a, 1 + a) = (a * 1, a * a)) ↔ a ^ 2 = a + 1 := by
  constructor
  · intro h
    have h2 : 1 + a = a * a := (Prod.ext_iff.mp h).2
    linear_combination -h2
  · intro h
    refine Prod.ext (by simp) ?_
    show 1 + a = a * a
    linear_combination -h

/-- Puntos de (ℤ/m)² fijos por Mᵏ. -/
def fixCount (m : ℕ) [NeZero m] (k : ℕ) : ℕ :=
  (Finset.univ.filter (fun v : ZMod m × ZMod m => (step^[k]) v = v)).card

/-- **[P*] p = 5 (ramificado):** M⁴ fija una recta (5 puntos: la órbita de longitud 4, el
    ángulo φ ≡ 3), M²⁰ fija todo. -/
theorem ramified_five : fixCount 5 4 = 5 ∧ fixCount 5 20 = 25 := by decide

/-- **[P*] p = 11 (escindido):** M⁵ fija una recta propia (eigenvalor de orden 5), M¹⁰ fija
    todo: π(11) = 10 | 11 − 1. -/
theorem split_eleven : fixCount 11 5 = 11 ∧ fixCount 11 10 = 121 := by decide

/-- **[P*] p = 3 (inerte):** ninguna recta propia; nada se fija antes de M⁸, y π(3) = 8 |
    2·(3 + 1), 8 ∤ 3 + 1. -/
theorem inert_three :
    (∀ k ∈ Finset.Ico 1 8, fixCount 3 k = 1) ∧ fixCount 3 8 = 9 := by decide

/-- (F_k, F_{k+1}) módulo n. -/
def fibPair (n k : ℕ) : ZMod n × ZMod n := step^[k] (0, 1)

/-- El reloj de φ módulo n (período de Pisano) vale P. -/
def PisanoIs (n P : ℕ) : Prop :=
  fibPair n P = (0, 1) ∧ ∀ k ∈ Finset.Ico 1 P, fibPair n k ≠ (0, 1)

instance (n P : ℕ) : Decidable (PisanoIs n P) :=
  inferInstanceAs (Decidable (fibPair n P = (0, 1) ∧ ∀ k ∈ Finset.Ico 1 P, fibPair n k ≠ (0, 1)))

/-- **[P*] La ley de Wall en muestras:** escindidos 11, 19, 29, 31, 41 (π | p − 1); inertes 3,
    7, 13, 17, 23 (π | 2(p + 1), π ∤ p + 1); ramificado 5 (π = 20); y π(2) = 3. -/
theorem wall_samples :
    (PisanoIs 11 10 ∧ PisanoIs 19 18 ∧ PisanoIs 29 14 ∧ PisanoIs 31 30 ∧ PisanoIs 41 40)
    ∧ (PisanoIs 3 8 ∧ PisanoIs 7 16 ∧ PisanoIs 13 28 ∧ PisanoIs 17 36 ∧ PisanoIs 23 48)
    ∧ PisanoIs 5 20 ∧ PisanoIs 2 3 := by
  decide

theorem wall_divisibility :
    (10 ∣ 11 - 1 ∧ 18 ∣ 19 - 1 ∧ 14 ∣ 29 - 1 ∧ 30 ∣ 31 - 1 ∧ 40 ∣ 41 - 1)
    ∧ (8 ∣ 2 * 4 ∧ ¬ 8 ∣ 4) ∧ (16 ∣ 2 * 8 ∧ ¬ 16 ∣ 8) ∧ (28 ∣ 2 * 14 ∧ ¬ 28 ∣ 14)
    ∧ (36 ∣ 2 * 18 ∧ ¬ 36 ∣ 18) ∧ (48 ∣ 2 * 24 ∧ ¬ 48 ∣ 24) := by
  decide

/-- **[C] La ley de Wall (1960):** la longitud de las órbitas de la p-torsión es el Frobenius
    de p en ℤ[φ].  [N] en todos los primos 2 < p < 20000, p ≠ 5. -/
def WallLaw : Prop :=
  ∀ p P : ℕ, p.Prime → p ≠ 2 → p ≠ 5 → PisanoIs p P →
    ((p % 5 = 1 ∨ p % 5 = 4) → P ∣ p - 1)
    ∧ ((p % 5 = 2 ∨ p % 5 = 3) → (P ∣ 2 * (p + 1) ∧ ¬ P ∣ p + 1))

/-! ## §4  La torre 5-ádica -/

/-- **[P*] La torre:** π(5) = 20, π(25) = 100: cada piso multiplica la longitud por 5.
    (En todo piso: `pisano_five_pow` del corpus.) -/
theorem five_tower : PisanoIs 5 20 ∧ PisanoIs 25 100 := by decide

end PeriodicasSol

end PeriodicasSolBlock

