/- ═══════════════════════════════════════════════════════════════════════════
   §0  COPIAS DE M12 (mismo cuerpo que en M12Cat)
   ═══════════════════════════════════════════════════════════════════════════ -/

structure Cat where
  Obj : Type u
  Hom : Obj → Obj → Type v
  id : (X : Obj) → Hom X X
  comp : {X Y Z : Obj} → Hom X Y → Hom Y Z → Hom X Z
  id_comp : ∀ {X Y : Obj} (f : Hom X Y), comp (id X) f = f
  comp_id : ∀ {X Y : Obj} (f : Hom X Y), comp f (id Y) = f
  assoc : ∀ {W X Y Z : Obj} (f : Hom W X) (g : Hom X Y) (h : Hom Y Z),
    comp (comp f g) h = comp f (comp g h)

def IsPushout (C : Cat) {A B P Q : C.Obj}
    (f : C.Hom A B) (g : C.Hom A P) (i : C.Hom B Q) (j : C.Hom P Q) : Prop :=
  C.comp f i = C.comp g j ∧
  ∀ (Q' : C.Obj) (i' : C.Hom B Q') (j' : C.Hom P Q'),
    C.comp f i' = C.comp g j' →
    ∃! u : C.Hom Q Q', C.comp i u = i' ∧ C.comp j u = j'

def IsPullback (C : Cat) {A B P Q : C.Obj}
    (f : C.Hom A B) (g : C.Hom A P) (i : C.Hom B Q) (j : C.Hom P Q) : Prop :=
  C.comp f i = C.comp g j ∧
  ∀ (A' : C.Obj) (f' : C.Hom A' B) (g' : C.Hom A' P),
    C.comp f' i = C.comp g' j →
    ∃! u : C.Hom A' A, C.comp u f = f' ∧ C.comp u g = g'

@[reducible]
def DivCat : Cat where
  Obj := Nat
  Hom m n := PLift (m ∣ n)
  id := fun n => ⟨Nat.dvd_refl n⟩
  comp := fun {_ _ _} f g => ⟨Nat.dvd_trans f.down g.down⟩
  id_comp := by intro _ _ f; cases f; rfl
  comp_id := by intro _ _ f; cases f; rfl
  assoc := by intro _ _ _ _ f g h; rfl

/-- La frontera a resolución `n`: las `n` direcciones `k/n` de vuelta. -/
def Bnd (n : ℕ) : Finset ℚ :=
  (Finset.range n).image (fun (k : ℕ) => (k : ℚ) / (n : ℚ))

/-- La dirección de la clase `k` de `ℤ/n`. -/
def bndOf (n : ℕ) [NeZero n] (k : ZMod n) : ℚ := ((k.val : ℕ) : ℚ) / n

/-- Distancia en pasos: el menor de los dos arcos. -/
def dIdx {n : ℕ} [NeZero n] (j k : ZMod n) : ℕ := min (j - k).val (k - j).val

def C3frac : Finset ℚ := {0, 1/3, 2/3}
def C4frac : Finset ℚ := {0, 1/4, 1/2, 3/4}
def C6frac : Finset ℚ := {0, 1/6, 1/3, 1/2, 2/3, 5/6}

/-- Copia de M12: la reflexión es isometría. -/
theorem dIdx_reflect_isometry {n : ℕ} [NeZero n] (j k : ZMod n) :
    dIdx (-j) (-k) = dIdx j k := by
  unfold dIdx
  rw [min_comm]
  congr 2 <;> ring_nf

/-- Copia de M12: los cuartos y los sextos se encuentran en el par de ejes. -/
theorem C4_meet_C6 : C4frac ∩ C6frac = {0, 1/2} := by
  ext θ
  simp only [C4frac, C6frac, Finset.mem_inter, Finset.mem_insert, Finset.mem_singleton]
  constructor
  · rintro ⟨h4, h6⟩
    rcases h4 with rfl | rfl | rfl | rfl
    · exact Or.inl rfl
    · rcases h6 with h | h | h | h | h | h
      · exact absurd h (by norm_num : (1:ℚ)/4 ≠ 0)
      · exact absurd h (by norm_num : (1:ℚ)/4 ≠ 1/6)
      · exact absurd h (by norm_num : (1:ℚ)/4 ≠ 1/3)
      · exact absurd h (by norm_num : (1:ℚ)/4 ≠ 1/2)
      · exact absurd h (by norm_num : (1:ℚ)/4 ≠ 2/3)
      · exact absurd h (by norm_num : (1:ℚ)/4 ≠ 5/6)
    · exact Or.inr rfl
    · rcases h6 with h | h | h | h | h | h
      · exact absurd h (by norm_num : (3:ℚ)/4 ≠ 0)
      · exact absurd h (by norm_num : (3:ℚ)/4 ≠ 1/6)
      · exact absurd h (by norm_num : (3:ℚ)/4 ≠ 1/3)
      · exact absurd h (by norm_num : (3:ℚ)/4 ≠ 1/2)
      · exact absurd h (by norm_num : (3:ℚ)/4 ≠ 2/3)
      · exact absurd h (by norm_num : (3:ℚ)/4 ≠ 5/6)
  · rintro (rfl | rfl)
    · exact ⟨Or.inl rfl, Or.inl rfl⟩
    · exact ⟨Or.inr (Or.inr (Or.inl rfl)),
        Or.inr (Or.inr (Or.inr (Or.inl rfl)))⟩

/- ═══════════════════════════════════════════════════════════════════════════
   §1  φ, λ, EL BINARIO Y LA IDENTIDAD UNIVERSAL DE CR
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- La razón áurea. -/
def phi : ℝ := (1 + Real.sqrt 5) / 2

theorem phi_sq : phi ^ 2 = phi + 1 := by
  unfold phi
  have h5 := Real.sq_sqrt (show (0:ℝ) ≤ 5 by norm_num)
  linear_combination h5 / 4

theorem phi_pos : 0 < phi := by
  unfold phi; positivity

theorem one_lt_phi : 1 < phi := by
  unfold phi
  have h : (1:ℝ) < Real.sqrt 5 := by
    rw [show (1:ℝ) = Real.sqrt 1 by simp]
    exact Real.sqrt_lt_sqrt (by norm_num) (by norm_num)
  linarith

/-- 1/φ = φ − 1. -/
theorem phi_inv : 1 / phi = phi - 1 := by
  rw [div_eq_iff phi_pos.ne']
  linear_combination (-1 : ℝ) * phi_sq

theorem log_phi_ne_zero : Real.log phi ≠ 0 :=
  ne_of_gt (Real.log_pos one_lt_phi)

/-- λ = log_φ 2, la posición del 2 en la torre. -/
def lam : ℝ := Real.log 2 / Real.log phi

/-- **El paso binario de CR:** φ^λ = 2. -/
theorem phi_rpow_lam : phi ^ lam = 2 := by
  unfold lam
  rw [Real.rpow_def_of_pos phi_pos]
  have hmul : Real.log phi * (Real.log 2 / Real.log phi) = Real.log 2 := by
    (field_simp [log_phi_ne_zero]; try exact div_self log_phi_ne_zero)
  rw [hmul, Real.exp_log (by norm_num)]

/-- **La vuelta recíproca de CR:** φ^{−λ} = ½. -/
theorem phi_rpow_neg_lam : phi ^ (-lam) = 1 / 2 := by
  rw [Real.rpow_neg phi_pos.le, phi_rpow_lam]; norm_num

/-- Multiplicar por 2 es trasladar la coordenada σ por λ. -/
theorem two_mul_is_shift (σ : ℝ) : 2 * phi ^ σ = phi ^ (σ + lam) := by
  rw [Real.rpow_add phi_pos, phi_rpow_lam, mul_comm]

/-- 2^p = φ^{pλ}: el bit en la posición p, en la recta. -/
theorem two_pow_is_phi_pow (p : ℕ) : phi ^ ((p : ℝ) * lam) = 2 ^ p := by
  rw [mul_comm, Real.rpow_mul phi_pos.le, phi_rpow_lam, Real.rpow_natCast]

/-- El giro ternario: φ^{log_φ 3} = 3. -/
theorem phi_rpow_log3 : phi ^ (Real.log 3 / Real.log phi) = 3 := by
  rw [Real.rpow_def_of_pos phi_pos]
  have hmul : Real.log phi * (Real.log 3 / Real.log phi) = Real.log 3 := by
    (field_simp [log_phi_ne_zero]; try exact div_self log_phi_ne_zero)
  rw [hmul, Real.exp_log (by norm_num)]

/-- El índice áureo de CR. -/
def sigmaIdx (p : ℝ) : ℝ := p * lam - Real.log 3 / Real.log phi

/-- **La identidad universal de CR:** 3·φ^{σ(p)} = 2^p. -/
theorem universal_identity (p : ℝ) : 3 * phi ^ (sigmaIdx p) = (2 : ℝ) ^ p := by
  unfold sigmaIdx
  rw [Real.rpow_sub phi_pos, phi_rpow_log3, mul_comm p lam,
    Real.rpow_mul phi_pos.le, phi_rpow_lam]
  ring

/- ═══════════════════════════════════════════════════════════════════════════
   §2  60 = 12·5 EN LA RETÍCULA DE DIVISIBILIDAD                        (D1 §2.1)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- El círculo de tono (12) y el de las clases (20) se encuentran en los ejes
    oponentes (4) y se unen en 60; con el decágono, en el par de ejes (2). -/
theorem sixty_meet_join :
    Nat.gcd 12 20 = 4 ∧ Nat.lcm 12 20 = 60
    ∧ Nat.gcd 12 10 = 2 ∧ Nat.lcm 12 10 = 60 := by decide

theorem incl_4_12 : (4 : Nat) ∣ 12 := by decide
theorem incl_4_20 : (4 : Nat) ∣ 20 := by decide
theorem incl_12_60 : (12 : Nat) ∣ 60 := by decide
theorem incl_20_60 : (20 : Nat) ∣ 60 := by decide

theorem pushout_universal_60 (Q : ℕ) (h12 : 12 ∣ Q) (h20 : 20 ∣ Q) : 60 ∣ Q := by
  omega

theorem pullback_universal_4 (Q : ℕ) (h12 : Q ∣ 12) (h20 : Q ∣ 20) : Q ∣ 4 := by
  have h := Nat.dvd_gcd h12 h20
  simpa using h

/-- **B₆₀ es el pushout de B₁₂ y B₂₀ sobre B₄** (mismo patrón que
    `twelve_is_pushout` de M12). -/
theorem sixty_is_pushout :
    IsPushout DivCat (A := 4) (B := 12) (P := 20) (Q := 60)
      ⟨incl_4_12⟩ ⟨incl_4_20⟩ ⟨incl_12_60⟩ ⟨incl_20_60⟩ := by
  refine ⟨rfl, ?_⟩
  intro Q' i' j' _
  refine ⟨⟨pushout_universal_60 Q' i'.down j'.down⟩, ⟨rfl, rfl⟩, ?_⟩
  intro u _; cases u; rfl

/-- **Y B₄ es su pullback:** el cuadrado 4–12–20–60 es bicartesiano. -/
theorem four_is_pullback_of_twelve_twenty :
    IsPullback DivCat (A := 4) (B := 12) (P := 20) (Q := 60)
      ⟨incl_4_12⟩ ⟨incl_4_20⟩ ⟨incl_12_60⟩ ⟨incl_20_60⟩ := by
  refine ⟨rfl, ?_⟩
  intro A' f' g' _
  refine ⟨⟨pullback_universal_4 A' f'.down g'.down⟩, ⟨rfl, rfl⟩, ?_⟩
  intro u _; cases u; rfl

theorem sixty_square_bicartesian :
    IsPushout DivCat (A := 4) (B := 12) (P := 20) (Q := 60)
      ⟨incl_4_12⟩ ⟨incl_4_20⟩ ⟨incl_12_60⟩ ⟨incl_20_60⟩
    ∧ IsPullback DivCat (A := 4) (B := 12) (P := 20) (Q := 60)
      ⟨incl_4_12⟩ ⟨incl_4_20⟩ ⟨incl_12_60⟩ ⟨incl_20_60⟩ :=
  ⟨sixty_is_pushout, four_is_pullback_of_twelve_twenty⟩

/-- El pentágono. -/
def C5frac : Finset ℚ := {0, 1/5, 2/5, 3/5, 4/5}

/-- **60 es el menor modo admisible con pentágono.** -/
theorem sixty_least_mode_with_pentagon :
    IsLeast {n : ℕ | 0 < n ∧ 12 ∣ n ∧ 5 ∣ n} 60 := by
  refine ⟨⟨by norm_num, by norm_num, by norm_num⟩, ?_⟩
  rintro n ⟨hn, h12, h5⟩
  exact Nat.le_of_dvd hn (by omega)

/-- **Y el menor con decágono.** -/
theorem sixty_least_mode_with_decagon :
    IsLeast {n : ℕ | 0 < n ∧ 12 ∣ n ∧ 10 ∣ n} 60 := by
  refine ⟨⟨by norm_num, by norm_num, by norm_num⟩, ?_⟩
  rintro n ⟨hn, h12, h10⟩
  exact Nat.le_of_dvd hn (by omega)

/-- Con 5 ∣ n el pentágono está en la frontera (patrón de `C3_in_Bnd`). -/
theorem C5_in_Bnd (n : ℕ) (hn : 0 < n) (h5 : 5 ∣ n) : C5frac ⊆ Bnd n := by
  obtain ⟨q, rfl⟩ := h5
  have hq : ((5 * q : ℕ) : ℚ) ≠ 0 := by exact_mod_cast (by omega : 5 * q ≠ 0)
  intro θ hθ
  simp only [C5frac, Finset.mem_insert, Finset.mem_singleton] at hθ
  simp only [Bnd, Finset.mem_image, Finset.mem_range]
  rcases hθ with rfl | rfl | rfl | rfl | rfl
  · exact ⟨0, by omega, by simp⟩
  · exact ⟨q, by omega, by rw [div_eq_iff hq]; push_cast; ring⟩
  · exact ⟨2 * q, by omega, by rw [div_eq_iff hq]; push_cast; ring⟩
  · exact ⟨3 * q, by omega, by rw [div_eq_iff hq]; push_cast; ring⟩
  · exact ⟨4 * q, by omega, by rw [div_eq_iff hq]; push_cast; ring⟩

theorem pentagon_in_B60 : C5frac ⊆ Bnd 60 :=
  C5_in_Bnd 60 (by norm_num) (by norm_num)

/- ═══════════════════════════════════════════════════════════════════════════
   §3  EL 360                                                           (D1 §2.2)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- **Los ocho modos enteros son 12 por los divisores de 30 = 2·3·5.** -/
theorem integer_modes_are_twelve_times_divisors_of_thirty :
    (Nat.divisors 360).filter (fun n => 12 ∣ n)
      = (Nat.divisors 30).image (fun d => 12 * d) := by decide

theorem resolution_of_mode_twelve : 360 / 12 = 30 := by norm_num

/-- **El 360 contiene el 5 aditivamente:** el pentágono está en B₃₆₀. -/
theorem pentagon_in_B360 : C5frac ⊆ Bnd 360 :=
  C5_in_Bnd 360 (by norm_num) (by norm_num)

/-- **…pero no multiplicativamente:** ninguna clase distinta de 1 módulo 360
    tiene quinta potencia 1 (equivale a `no_fifth_roots_mod_360` del bloque,
    sin pasar por las unidades). -/
theorem no_fifth_root_mod_360 : ∀ a : ZMod 360, a ^ 5 = 1 → a = 1 := by decide

/- ═══════════════════════════════════════════════════════════════════════════
   §4  DUPLICAR EN EL CÍRCULO; MERSENNE MÓDULO 60 Y 360                 (D1 §2.3)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- En ℤ/12, duplicar dos veces cae en los tercios {0, 4, 8}. -/
theorem double_twice_lands_on_thirds_12 :
    ∀ k : ZMod 12, 4 * k ∈ ({0, 4, 8} : Finset (ZMod 12)) := by decide

/-- En ℤ/12, sobre los tercios, duplicar es la permutación de orden 2. -/
theorem double_on_thirds_order_two :
    ∀ k : ZMod 12, 2 * (2 * (4 * k)) = 4 * k
    ∧ (2 : ZMod 12) * 4 ≠ 4 := by decide

/-- En ℤ/60, la imagen estable de duplicar son los múltiplos de 4 (15 puntos),
    y allí duplicar tiene periodo 4. -/
theorem double_stable_60 :
    (Finset.univ.image (fun k : ZMod 60 => 4 * k)).card = 15
    ∧ (∀ k : ZMod 60, (2 : ZMod 60) ^ 4 * (4 * k) = 4 * k)
    ∧ (∃ k : ZMod 60, (2 : ZMod 60) ^ 2 * (4 * k) ≠ 4 * k) := by decide

/-- En ℤ/360, la imagen estable son los múltiplos de 8 (45 puntos), y allí
    duplicar tiene periodo 12. -/
theorem double_stable_360 :
    (Finset.univ.image (fun k : ZMod 360 => 8 * k)).card = 45
    ∧ (∀ k : ZMod 360, (2 : ZMod 360) ^ 12 * (8 * k) = 8 * k)
    ∧ (∃ k : ZMod 360, (2 : ZMod 360) ^ 6 * (8 * k) ≠ 8 * k)
    ∧ (∃ k : ZMod 360, (2 : ZMod 360) ^ 4 * (8 * k) ≠ 8 * k) := by decide

/-- Orden de 2 en las partes impares 3, 15, 45. -/
theorem order_two_odd_parts :
    ((2 : ZMod 3) ^ 2 = 1 ∧ (2 : ZMod 3) ≠ 1)
    ∧ ((2 : ZMod 15) ^ 4 = 1 ∧ (2 : ZMod 15) ^ 2 ≠ 1)
    ∧ ((2 : ZMod 45) ^ 12 = 1 ∧ (2 : ZMod 45) ^ 6 ≠ 1
        ∧ (2 : ZMod 45) ^ 4 ≠ 1) := by decide

/-- **Periodo 4 de 2^p módulo 60** (p ≥ 2). -/
theorem two_pow_period_60 (p : ℕ) (hp : 2 ≤ p) :
    2 ^ (p + 4) % 60 = 2 ^ p % 60 := by
  obtain ⟨q, rfl⟩ : ∃ q, p = q + 2 := ⟨p - 2, by omega⟩
  have h1 : 2 ^ (q + 2 + 4) = 2 ^ q * 64 := by ring
  have h2 : 2 ^ (q + 2) = 2 ^ q * 4 := by ring
  calc 2 ^ (q + 2 + 4) % 60 = (2 ^ q % 60) * (64 % 60) % 60 := by
        rw [h1, Nat.mul_mod (2 ^ q) 64 60]
    _ = (2 ^ q % 60) * (4 % 60) % 60 := by norm_num
    _ = 2 ^ (q + 2) % 60 := by rw [h2, Nat.mul_mod (2 ^ q) 4 60]

/-- **Periodo 12 de 2^p módulo 360** (p ≥ 3). -/
theorem two_pow_period_360 (p : ℕ) (hp : 3 ≤ p) :
    2 ^ (p + 12) % 360 = 2 ^ p % 360 := by
  obtain ⟨q, rfl⟩ : ∃ q, p = q + 3 := ⟨p - 3, by omega⟩
  have h1 : 2 ^ (q + 3 + 12) = 2 ^ q * 32768 := by ring
  have h2 : 2 ^ (q + 3) = 2 ^ q * 8 := by ring
  calc 2 ^ (q + 3 + 12) % 360 = (2 ^ q % 360) * (32768 % 360) % 360 := by
        rw [h1, Nat.mul_mod (2 ^ q) 32768 360]
    _ = (2 ^ q % 360) * (8 % 360) % 360 := by norm_num
    _ = 2 ^ (q + 3) % 360 := by rw [h2, Nat.mul_mod (2 ^ q) 8 360]

theorem two_pow_mod_60_reduce (r k : ℕ) (hr : 2 ≤ r) :
    2 ^ (r + 4 * k) % 60 = 2 ^ r % 60 := by
  induction k with
  | zero => simp
  | succ k ih =>
    have : r + 4 * (k + 1) = (r + 4 * k) + 4 := by ring
    rw [this, two_pow_period_60 _ (by omega), ih]

theorem two_pow_mod_360_reduce (r k : ℕ) (hr : 3 ≤ r) :
    2 ^ (r + 12 * k) % 360 = 2 ^ r % 360 := by
  induction k with
  | zero => simp
  | succ k ih =>
    have : r + 12 * (k + 1) = (r + 12 * k) + 12 := by ring
    rw [this, two_pow_period_360 _ (by omega), ih]

/-- **M_p + 1 = 2^p módulo 60 por p módulo 4:** 32 (p ≡ 1) y 8 (p ≡ 3),
    es decir M_p ≡ 31 y 7. -/
theorem mersenne_mod_60_table (k : ℕ) :
    2 ^ (5 + 4 * k) % 60 = 32 ∧ 2 ^ (3 + 4 * k) % 60 = 8 := by
  refine ⟨?_, ?_⟩
  · rw [two_pow_mod_60_reduce 5 k (by norm_num)]; norm_num
  · rw [two_pow_mod_60_reduce 3 k (by norm_num)]; norm_num

/-- **M_p + 1 = 2^p módulo 360 por p módulo 12:** 272, 32, 128, 248 para
    p ≡ 1, 5, 7, 11, es decir M_p ≡ 271, 31, 127, 247 (bloque N60-E3). -/
theorem mersenne_mod_360_table (k : ℕ) :
    2 ^ (13 + 12 * k) % 360 = 272 ∧ 2 ^ (5 + 12 * k) % 360 = 32
    ∧ 2 ^ (7 + 12 * k) % 360 = 128 ∧ 2 ^ (11 + 12 * k) % 360 = 248 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [two_pow_mod_360_reduce 13 k (by norm_num)]; norm_num
  · rw [two_pow_mod_360_reduce 5 k (by norm_num)]; norm_num
  · rw [two_pow_mod_360_reduce 7 k (by norm_num)]; norm_num
  · rw [two_pow_mod_360_reduce 11 k (by norm_num)]; norm_num

/-- El periodo de duplicar coincide con el exponente de las unidades
    (equivalente a: toda unidad u cumple u^e = 1), en 12 y 60. -/
theorem unit_exponent_12_60 :
    (∀ a : ZMod 12, (∃ b, a * b = 1) → a ^ 2 = 1)
    ∧ (∀ a : ZMod 60, (∃ b, a * b = 1) → a ^ 4 = 1)
    ∧ (∃ a : ZMod 60, (∃ b, a * b = 1) ∧ a ^ 2 ≠ 1) := by decide

/- ═══════════════════════════════════════════════════════════════════════════
   §5  LOS RELOJES SOBRE LA TORRE 12·5ⁿ                                 (D1 §2.4)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- Paso de Fibonacci sobre pares de ℤ/n. -/
def fibStep {n : ℕ} (x : ZMod n × ZMod n) : ZMod n × ZMod n := (x.2, x.1 + x.2)

/-- (F_k, F_{k+1}) módulo n. -/
def fibPair (n k : ℕ) : ZMod n × ZMod n := fibStep^[k] (0, 1)

/-- El reloj de φ módulo n (periodo de Pisano) vale P. -/
def PisanoIs (n P : ℕ) : Prop :=
  fibPair n P = (0, 1) ∧ ∀ k ∈ Finset.Ico 1 P, fibPair n k ≠ (0, 1)

instance (n P : ℕ) : Decidable (PisanoIs n P) :=
  inferInstanceAs (Decidable (fibPair n P = (0, 1) ∧ ∀ k ∈ Finset.Ico 1 P, fibPair n k ≠ (0, 1)))

/-- π(12) = 24, π(60) = 120, π(300) = 600: el reloj de φ en la torre 12·5ⁿ
    es 24·5ⁿ (n = 0, 1, 2), el doble de la teselación.  [decide pesado] -/
theorem pisano_tower :
    PisanoIs 12 24 ∧ PisanoIs 60 120 ∧ PisanoIs 300 600 := by decide

/-- π(360) = 120 = π(60): pasar de 60 a 360 no cambia el reloj de φ. -/
theorem pisano_360 : PisanoIs 360 120 := by decide

/-- Orden de 2 en 3·5ⁿ: 4·5^{n−1} (n = 1, 2, 3).  El binario va un nivel
    por detrás del reloj de φ. -/
theorem order_two_on_five_tower :
    ((2 : ZMod 15) ^ 4 = 1 ∧ (2 : ZMod 15) ^ 2 ≠ 1)
    ∧ ((2 : ZMod 75) ^ 20 = 1 ∧ (2 : ZMod 75) ^ 10 ≠ 1 ∧ (2 : ZMod 75) ^ 4 ≠ 1)
    ∧ ((2 : ZMod 375) ^ 100 = 1 ∧ (2 : ZMod 375) ^ 50 ≠ 1
        ∧ (2 : ZMod 375) ^ 20 ≠ 1) := by decide

/-- La valoración 5-ádica de 2⁴ − 1 es 1 (15 = 5·3, 25 ∤ 15); la de φ⁴ − 1
    es ½ (bloque Z18, `phi_clock_exact`).  El 5 que los separa es el ½. -/
theorem two_four_minus_one : 2 ^ 4 - 1 = 5 * 3 ∧ ¬ (25 ∣ 2 ^ 4 - 1) := by decide

/- ═══════════════════════════════════════════════════════════════════════════
   §6  EULER: EL MAPA DEL CÍRCULO ADITIVO A LAS RAÍCES                  (D2 §4)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- La dirección k/N llevada por Euler a e^{2πik/N}. -/
def eulerMap (N : ℕ) (k : ℤ) : ℂ :=
  Complex.exp (2 * (Real.pi : ℂ) * Complex.I * (k : ℂ) / (N : ℂ))

/-- La rotación de M12 pasa a ser multiplicar por una raíz. -/
theorem eulerMap_add (N : ℕ) (j k : ℤ) :
    eulerMap N (j + k) = eulerMap N j * eulerMap N k := by
  unfold eulerMap
  rw [← Complex.exp_add]
  congr 1
  push_cast
  ring

/-- El Frobenius ψ_p (multiplicar por p) pasa a ser z ↦ z^p. -/
theorem eulerMap_psi (N p : ℕ) (k : ℤ) :
    eulerMap N ((p : ℤ) * k) = eulerMap N k ^ p := by
  unfold eulerMap
  rw [← Complex.exp_nat_mul]
  congr 1
  push_cast
  ring

/-- Está bien definido en ℤ/N: sumar N no cambia la raíz. -/
theorem eulerMap_period (N : ℕ) (hN : N ≠ 0) (k : ℤ) :
    eulerMap N (k + N) = eulerMap N k := by
  unfold eulerMap
  have hNc : (N : ℂ) ≠ 0 := by exact_mod_cast hN
  have h : 2 * (Real.pi : ℂ) * Complex.I * (((k + N : ℤ)) : ℂ) / (N : ℂ)
      = 2 * (Real.pi : ℂ) * Complex.I * (k : ℂ) / (N : ℂ)
        + 2 * (Real.pi : ℂ) * Complex.I := by
    push_cast
    first | (field_simp; ring) | field_simp
  rw [h, Complex.exp_add, Complex.exp_two_pi_mul_I, mul_one]

/-- **La media vuelta es e^{iπ} = −1.** -/
theorem eulerMap_half_turn (M : ℕ) (hM : M ≠ 0) :
    eulerMap (2 * M) M = -1 := by
  unfold eulerMap
  have hMc : (M : ℂ) ≠ 0 := by exact_mod_cast hM
  have h : 2 * (Real.pi : ℂ) * Complex.I * ((M : ℤ) : ℂ) / ((2 * M : ℕ) : ℂ)
      = (Real.pi : ℂ) * Complex.I := by
    push_cast
    first | (field_simp; ring) | field_simp
  rw [h, Complex.exp_pi_mul_I]

/- ═══════════════════════════════════════════════════════════════════════════
   §7  EL FROBENIUS EN EL CÍRCULO: SUMA DE M12, PRODUCTO DEL F1          (D2 §3)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- El Frobenius descendido del F1 (`psi_mod` de `F1_spectra_anchor_G`). -/
def psi_mod (N p : ℕ) (a : ZMod N) : ZMod N := (p : ZMod N) * a

/-- **El Frobenius de los exponentes de φ, descendido, cae en el círculo de
    M12:** la dirección de ψ_p(n) es la de multiplicar por p su clase. -/
theorem psi_lands_on_circle (N p : ℕ) [NeZero N] (n : ℤ) :
    bndOf N ((((p : ℤ) * n : ℤ)) : ZMod N)
      = bndOf N (psi_mod N p (n : ZMod N)) := by
  simp [psi_mod]

/-- La suma de exponentes va a la rotación de M12. -/
theorem exponent_sum_is_rotation (N : ℕ) (m n : ℤ) :
    (((m + n : ℤ)) : ZMod N) = (m : ZMod N) + (n : ZMod N) := Int.cast_add m n

/-- **ψ_p respeta el parqueteado:** lleva rotaciones a rotaciones. -/
theorem psi_respects_rotation (N p : ℕ) (k c : ZMod N) :
    psi_mod N p (k + c) = psi_mod N p k + psi_mod N p c := by
  unfold psi_mod; ring

/-- La composición de Frobenius es la de los factores (Borger B1). -/
theorem psi_comp_mod (N p q : ℕ) (k : ZMod N) :
    psi_mod N p (psi_mod N q k) = psi_mod N (p * q) k := by
  unfold psi_mod; push_cast; ring

/- ═══════════════════════════════════════════════════════════════════════════
   §8  FROBENIUS FRENTE A ISOMETRÍAS: SOLO ±1                         (D2 §3, D4 §2.1)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- **Las unidades isométricas son ±1** (N ≥ 3).  Las simetrías aditivas
    (M12) y las multiplicativas (F1) del círculo se cortan en la identidad y
    la reflexión. -/
theorem units_isometric_iff (N : ℕ) [NeZero N] (hN : 3 ≤ N) (u : ZMod N) :
    (∀ j k : ZMod N, dIdx (u * j) (u * k) = dIdx j k) ↔ (u = 1 ∨ u = -1) := by
  haveI : Fact (1 < N) := ⟨by omega⟩
  constructor
  · intro h
    have h1 := h 1 0
    simp only [dIdx, mul_one, mul_zero, sub_zero, zero_sub] at h1
    have hone : (1 : ZMod N).val = 1 := ZMod.val_one N
    have hneg : 1 ≤ (-1 : ZMod N).val :=
      -- riesgo: ZMod.val_pos
      ZMod.val_pos.mpr (neg_ne_zero.mpr one_ne_zero)
    rw [hone, min_eq_left hneg] at h1
    rcases min_choice u.val (-u).val with hm | hm
    · left
      have hu : u.val = 1 := hm ▸ h1
      exact ZMod.val_injective N (by rw [hu, hone])
    · right
      have hu : (-u).val = 1 := hm ▸ h1
      have h' : -u = 1 := ZMod.val_injective N (by rw [hu, hone])
      rw [← neg_neg u, h']
  · rintro (rfl | rfl) <;> intro j k
    · simp
    · simpa [neg_one_mul] using dIdx_reflect_isometry j k

/-- La misma afirmación en el círculo de tono, por `decide`. -/
theorem units_isometric_twelve (u : ZMod 12) :
    (∀ j k : ZMod 12, dIdx (u * j) (u * k) = dIdx j k) ↔ (u = 1 ∨ u = -1) := by
  revert u; decide

/-- Las unidades de ℤ/12 son {1, 5, 7, 11} y todas tienen cuadrado 1
    (el grupo de Klein de M12, `units_zmod12_klein`). -/
theorem units_twelve :
    (∀ a : ZMod 12, (∃ b, a * b = 1) ↔ a ∈ ({1, 5, 7, 11} : Finset (ZMod 12)))
    ∧ (∀ a ∈ ({1, 5, 7, 11} : Finset (ZMod 12)), a * a = 1) := by decide

/- ═══════════════════════════════════════════════════════════════════════════
   §9  EL FROBENIUS BAJA LA RESOLUCIÓN; PELAR EL ESQUELETO       (D2 §5, D4 §2.2)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- **El Frobenius en m lleva B_N sobre B_{N/mcd(N,m)}.**  La refinación de
    M12 sube; el Frobenius baja.  Prueba por Bézout. -/
theorem frobenius_lowers_resolution (N m : ℕ) [NeZero N] :
    Finset.univ.image (fun k : ZMod N => bndOf N ((m : ZMod N) * k))
      = Bnd (N / Nat.gcd N m) := by
  have hN : 0 < N := NeZero.pos N
  set d := Nat.gcd N m with hd
  have hdpos : 0 < d := Nat.gcd_pos_of_pos_left m hN
  obtain ⟨N', hN'⟩ : d ∣ N := Nat.gcd_dvd_left N m
  have hdN : d ∣ N := ⟨N', hN'⟩
  have hdm : d ∣ m := Nat.gcd_dvd_right N m
  have hNd : N / d = N' := by rw [hN', Nat.mul_div_cancel_left N' hdpos]
  have hNQ : (N : ℚ) = (d : ℚ) * N' := by exact_mod_cast hN'
  have hdQ : (d : ℚ) ≠ 0 := by exact_mod_cast hdpos.ne'
  have hN'pos : 0 < N' := by
    rcases Nat.eq_zero_or_pos N' with h0 | h0
    · rw [h0, mul_zero] at hN'; omega
    · exact h0
  have hN'Q : (N' : ℚ) ≠ 0 := by exact_mod_cast hN'pos.ne'
  rw [hNd]
  ext x
  simp only [Finset.mem_image, Finset.mem_univ, true_and, Bnd, Finset.mem_range]
  constructor
  · rintro ⟨k, rfl⟩
    have hv : ((m : ZMod N) * k).val = (m % N * k.val) % N := by
      -- riesgo: ZMod.val_mul, ZMod.val_natCast
      rw [ZMod.val_mul, ZMod.val_natCast]
    have hdv : d ∣ ((m : ZMod N) * k).val := by
      rw [hv]
      have h1 : d ∣ m % N * k.val :=
        Dvd.dvd.mul_right ((Nat.dvd_mod_iff hdN).mpr hdm) _
      exact (Nat.dvd_mod_iff hdN).mpr h1
    obtain ⟨t, ht⟩ := hdv
    have hlt : ((m : ZMod N) * k).val < N := ZMod.val_lt _
    refine ⟨t, ?_, ?_⟩
    · rw [ht] at hlt
      rw [hN'] at hlt
      exact Nat.lt_of_mul_lt_mul_left hlt
    · unfold bndOf
      rw [ht]
      push_cast
      rw [hNQ, mul_div_mul_left _ _ hdQ]
  · rintro ⟨t, ht, rfl⟩
    refine ⟨(Nat.gcdB N m : ZMod N) * (t : ZMod N), ?_⟩
    have hbez : ((d : ℤ) : ZMod N) = (m : ZMod N) * (Nat.gcdB N m : ZMod N) := by
      rw [hd, Nat.gcd_eq_gcd_ab N m]
      push_cast
      rw [ZMod.natCast_self]
      ring
    have hprod : (m : ZMod N) * ((Nat.gcdB N m : ZMod N) * (t : ZMod N))
        = ((d * t : ℕ) : ZMod N) := by
      rw [← mul_assoc, ← hbez]
      simp [Nat.cast_mul]
    unfold bndOf
    rw [hprod, ZMod.val_natCast, Nat.mod_eq_of_lt]
    · push_cast
      rw [hNQ, mul_div_mul_left _ _ hdQ]
    · rw [hN']
      exact Nat.mul_lt_mul_of_pos_left ht hdpos

/-- **El Frobenius en 2 pela el esqueleto de M12:** el doce va a los sextos
    (las primarias) y, otra vez, a los tercios (el eje de la celda). -/
theorem psi_two_peels_twelve :
    ∀ k : ZMod 12,
      2 * k ∈ ({0, 2, 4, 6, 8, 10} : Finset (ZMod 12))
      ∧ 4 * k ∈ ({0, 4, 8} : Finset (ZMod 12)) := by decide

/-- **El Frobenius en 3 lleva el doce sobre los ejes oponentes.** -/
theorem psi_three_to_opponent :
    ∀ k : ZMod 12, 3 * k ∈ ({0, 3, 6, 9} : Finset (ZMod 12)) := by decide

/-- La cadena binaria 48 → 24 → 12, dos a uno. -/
theorem binary_chain_descends :
    (Finset.univ.image (fun k : ZMod 48 => (2 : ZMod 48) * k)).card = 24
    ∧ (Finset.univ.image (fun k : ZMod 24 => (2 : ZMod 24) * k)).card = 12
    ∧ (Finset.univ.image (fun k : ZMod 12 => (2 : ZMod 12) * k)).card = 6 := by
  decide

/-- **ψ₂ conserva la admisibilidad solo mientras 24 ∣ N.** -/
theorem psi_two_admissible (t : ℕ) : 12 ∣ t ↔ 24 ∣ 2 * t := by omega

/-- **La media vuelta:** la fijan los Frobenius en primos impares; la borra
    el de 2.  General: en ℤ/2M, (2t+1)·M = M y 2·M = 0. -/
theorem frobenius_half_turn (M t : ℕ) :
    ((2 * t + 1 : ℕ) : ZMod (2 * M)) * (M : ZMod (2 * M)) = (M : ZMod (2 * M))
    ∧ (2 : ZMod (2 * M)) * (M : ZMod (2 * M)) = 0 := by
  have h : ((2 * M : ℕ) : ZMod (2 * M)) = 0 := ZMod.natCast_self _
  constructor
  · calc ((2 * t + 1 : ℕ) : ZMod (2 * M)) * (M : ZMod (2 * M))
        = (t : ZMod (2 * M)) * ((2 * M : ℕ) : ZMod (2 * M)) + (M : ZMod (2 * M)) := by
          push_cast; ring
      _ = (M : ZMod (2 * M)) := by rw [h]; ring
  · calc (2 : ZMod (2 * M)) * (M : ZMod (2 * M)) = ((2 * M : ℕ) : ZMod (2 * M)) := by
          push_cast; ring
      _ = 0 := h

theorem frobenius_half_turn_twelve :
    (2 : ZMod 12) * 6 = 0
    ∧ (3 : ZMod 12) * 6 = 6 ∧ (5 : ZMod 12) * 6 = 6
    ∧ (7 : ZMod 12) * 6 = 6 ∧ (11 : ZMod 12) * 6 = 6 := by decide

/- ═══════════════════════════════════════════════════════════════════════════
   §10  60 = 12·5 BAJO EL FROBENIUS                                      (D2 §6)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- ψ₅ lleva B₆₀ sobre B₁₂ (tono); ψ₃ sobre B₂₀ (clases); ψ₁₂ sobre B₅
    (pentágono); ψ₆ sobre B₁₀ (decágono).  Como conjuntos de clases: los
    múltiplos de 5, 3, 12, 6. -/
theorem sixty_projections :
    Finset.univ.image (fun k : ZMod 60 => (5 : ZMod 60) * k)
        = Finset.univ.filter (fun x : ZMod 60 => x.val % 5 = 0)
    ∧ Finset.univ.image (fun k : ZMod 60 => (3 : ZMod 60) * k)
        = Finset.univ.filter (fun x : ZMod 60 => x.val % 3 = 0)
    ∧ Finset.univ.image (fun k : ZMod 60 => (12 : ZMod 60) * k)
        = Finset.univ.filter (fun x : ZMod 60 => x.val % 12 = 0)
    ∧ Finset.univ.image (fun k : ZMod 60 => (6 : ZMod 60) * k)
        = Finset.univ.filter (fun x : ZMod 60 => x.val % 6 = 0) := by decide

theorem sixty_projection_sizes :
    (Finset.univ.image (fun k : ZMod 60 => (5 : ZMod 60) * k)).card = 12
    ∧ (Finset.univ.image (fun k : ZMod 60 => (3 : ZMod 60) * k)).card = 20
    ∧ (Finset.univ.image (fun k : ZMod 60 => (12 : ZMod 60) * k)).card = 5
    ∧ (Finset.univ.image (fun k : ZMod 60 => (6 : ZMod 60) * k)).card = 10 := by
  decide

/-- En el tono, ψ₅ es una involución que fija los ejes oponentes punto a punto
    y refleja el hexágono de las primarias. -/
theorem psi_five_on_hue :
    (∀ k : ZMod 12, (5 : ZMod 12) * (5 * k) = k)
    ∧ (∀ k : ZMod 12, (5 : ZMod 12) * (3 * k) = 3 * k)
    ∧ (∀ k : ZMod 12, (5 : ZMod 12) * (2 * k) = -(2 * k)) := by decide

/- ═══════════════════════════════════════════════════════════════════════════
   §11  COORDENADA RADIAL Y ANGULAR EN ℂ^×                                (D2 §7)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- En la recta, ψ_p multiplica σ por p (`thm:tower-compat` del F1). -/
theorem frobenius_radial (σ : ℝ) (p : ℕ) :
    (phi ^ σ) ^ (p : ℝ) = phi ^ ((p : ℝ) * σ) := by
  rw [← Real.rpow_mul phi_pos.le, mul_comm]

/-- **El Frobenius multiplica por p las dos coordenadas a la vez;
    multiplicar por 2 solo traslada la radial.** -/
theorem frobenius_both_coordinates (N p : ℕ) (σ : ℝ) (k : ℤ) :
    (phi ^ σ) ^ (p : ℝ) = phi ^ ((p : ℝ) * σ)
    ∧ eulerMap N ((p : ℤ) * k) = eulerMap N k ^ p
    ∧ 2 * phi ^ σ = phi ^ (σ + lam) :=
  ⟨frobenius_radial σ p, eulerMap_psi N p k, two_mul_is_shift σ⟩

/- ═══════════════════════════════════════════════════════════════════════════
   §12  MERSENNE INERTES: LA MEDIA VUELTA EN UN BIT                    (D1 §2.5, D2 §7)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- M₃ = 7 y M₇ = 127: el reloj de φ es 2^{p+1} (16, 256), y en el bit 2^p
    el par de Fibonacci es (0, −1): la media vuelta.  [decide pesado en 127] -/
theorem mersenne_inert_half_turn :
    PisanoIs 7 16 ∧ fibPair 7 8 = (0, -1)
    ∧ PisanoIs 127 256 ∧ fibPair 127 128 = (0, -1) := by decide

/-- Los inertes caen en 7 módulo 60 (p ≡ 3 mód 4): 2^p ≡ 8. -/
theorem inert_mersenne_class (k : ℕ) : 2 ^ (3 + 4 * k) % 60 = 8 :=
  (mersenne_mod_60_table k).2

/- ═══════════════════════════════════════════════════════════════════════════
   §13  B₂ EN EL CÍRCULO: ζ(−1), ζ(2), LA MEDIA VUELTA                    (D3 §1–2)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- El segundo polinomio de Bernoulli. -/
def B2 (x : ℚ) : ℚ := x ^ 2 - x + 1 / 6

/-- Su versión real, para las series. -/
def B2r (x : ℝ) : ℝ := x ^ 2 - x + 1 / 6

theorem B2_zero : B2 0 = 1 / 6 := by norm_num [B2]

/-- **En la media vuelta, B₂ vale ζ(−1).** -/
theorem B2_half_turn : B2 (1 / 2) = -1 / 12 := by norm_num [B2]

/-- **Lo fuerza la fibra binaria {0, ½} del origen.** -/
theorem B2_binary_fiber : B2 0 + B2 (1 / 2) = (1 / 2) * B2 0 := by norm_num [B2]

theorem B2_half_is_minus_half_B2 : B2 (1 / 2) = -(B2 0) / 2 := by norm_num [B2]

/-- Entrada clásica: la serie de cosenos de peso 2 es π²·B₂(x) en [0, 1]. -/
def FourierB2Input : Prop :=
  ∀ x : ℝ, 0 ≤ x → x ≤ 1 →
    HasSum (fun n : ℕ => Real.cos (2 * Real.pi * ((n : ℝ) + 1) * x) / ((n : ℝ) + 1) ^ 2)
      (Real.pi ^ 2 * B2r x)

/-- Basel. -/
def BaselInput : Prop :=
  HasSum (fun n : ℕ => 1 / ((n : ℝ) + 1) ^ 2) (Real.pi ^ 2 / 6)

/-- **ζ(2) = π²/6 es la serie de cosenos en el origen.** -/
theorem basel_from_fourier (h : FourierB2Input) : BaselInput := by
  have h0 := h 0 le_rfl zero_le_one
  unfold BaselInput
  have hf : (fun n : ℕ => Real.cos (2 * Real.pi * ((n : ℝ) + 1) * 0) / ((n : ℝ) + 1) ^ 2)
      = (fun n : ℕ => 1 / ((n : ℝ) + 1) ^ 2) := by
    funext n; simp
  rw [hf] at h0
  convert h0 using 1
  unfold B2r; ring

/-- **En la media vuelta: la serie alternada vale −π²/12.** -/
theorem alternating_from_fourier (h : FourierB2Input) :
    HasSum (fun n : ℕ =>
        Real.cos (2 * Real.pi * ((n : ℝ) + 1) * (1 / 2)) / ((n : ℝ) + 1) ^ 2)
      (-(Real.pi ^ 2) / 12) := by
  convert h (1 / 2) (by norm_num) (by norm_num) using 1
  unfold B2r; ring

/-- Entrada clásica: ζ(−1) = −1/12. -/
def ZetaNegOneInput : Prop := riemannZeta (-1) = -1 / 12

/-- **ζ(−1) es B₂ en la media vuelta, y es −B₂/2.** -/
theorem zeta_neg_one_on_circle (h : ZetaNegOneInput) :
    riemannZeta (-1) = ((B2 (1 / 2) : ℚ) : ℂ)
    ∧ riemannZeta (-1) = ((-(B2 0) / 2 : ℚ) : ℂ) := by
  unfold ZetaNegOneInput at h
  constructor <;> rw [h] <;> norm_num [B2]

/-- ζ(2)/(2π)² = 1/24 = −ζ(−1)/2 (bloque NUM4). -/
theorem basel_over_turn_squared :
    (Real.pi ^ 2 / 6) / (2 * Real.pi) ^ 2 = 1 / 24 := by
  rw [div_eq_iff (by positivity)]
  ring

/- ═══════════════════════════════════════════════════════════════════════════
   §14  LA DISTRIBUCIÓN DE BERNOULLI ES LA REFINACIÓN DE M12              (D3 §3)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- Relación de distribución, m = 2, 3, 5, 12: la suma sobre la fibra del
    Frobenius en m es m⁻¹·B₂. -/
theorem B2_distribution (x : ℚ) :
    B2 (x / 2) + B2 ((x + 1) / 2) = B2 x / 2
    ∧ B2 (x / 3) + B2 ((x + 1) / 3) + B2 ((x + 2) / 3) = B2 x / 3
    ∧ (∑ j ∈ Finset.range 5, B2 ((x + j) / 5)) = B2 x / 5
    ∧ (∑ j ∈ Finset.range 12, B2 ((x + j) / 12)) = B2 x / 12 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · unfold B2; ring
  · unfold B2; ring
  · simp only [Finset.sum_range_succ, Finset.sum_range_zero, B2,
      Nat.cast_zero, Nat.cast_one, Nat.cast_ofNat]
    ring
  · simp only [Finset.sum_range_succ, Finset.sum_range_zero, B2,
      Nat.cast_zero, Nat.cast_one, Nat.cast_ofNat]
    ring

/-- **Masa total de B₂ en B_N: B₂/N** (N = 1, 2, 3, 4, 6, 12, 60). -/
theorem B2_mass :
    (∑ k ∈ Finset.range 1, B2 ((k : ℚ) / 1)) = 1 / 6
    ∧ (∑ k ∈ Finset.range 2, B2 ((k : ℚ) / 2)) = 1 / 12
    ∧ (∑ k ∈ Finset.range 3, B2 ((k : ℚ) / 3)) = 1 / 18
    ∧ (∑ k ∈ Finset.range 4, B2 ((k : ℚ) / 4)) = 1 / 24
    ∧ (∑ k ∈ Finset.range 6, B2 ((k : ℚ) / 6)) = 1 / 36
    ∧ (∑ k ∈ Finset.range 12, B2 ((k : ℚ) / 12)) = 1 / 72 := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> norm_num [Finset.sum_range_succ, B2]

theorem B2_mass_sixty :
    (∑ k ∈ Finset.range 60, B2 ((k : ℚ) / 60)) = 1 / 360 := by
  norm_num [Finset.sum_range_succ, B2]

/-- **La serie de cosenos sumada sobre las doce direcciones vale π²/72**
    (= ζ(2)/12), a partir de la entrada de Fourier. -/
theorem fourier_mass_twelve (h : FourierB2Input) :
    HasSum (fun n : ℕ => ∑ k ∈ Finset.range 12,
        Real.cos (2 * Real.pi * ((n : ℝ) + 1) * ((k : ℝ) / 12)) / ((n : ℝ) + 1) ^ 2)
      (Real.pi ^ 2 / 72) := by
  have hs := hasSum_sum (s := Finset.range 12) (fun k hk =>
    h ((k : ℝ) / 12) (by positivity)
      (by rw [div_le_one (by norm_num)]
          exact_mod_cast (Finset.mem_range.mp hk).le))
  convert hs using 1
  rw [← Finset.mul_sum]
  norm_num [Finset.sum_range_succ, B2r] <;> ring

/- ═══════════════════════════════════════════════════════════════════════════
   §15  −1/12 ES LA CARACTERÍSTICA DE EULER DEL CUADRADO DE M12           (D3 §4)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- Característica de Euler orbifold del cuadrado (a, b sobre d). -/
def orbiChar (a b d : ℚ) : ℚ := 1 / a + 1 / b - 1 / d

/-- **χ(ℤ/4 ∗_{ℤ/2} ℤ/6) = −1/12 = ζ(−1) = B₂(½).** (SL₂(ℤ) es esa
    amalgama: [C]; Harder: χ(SL₂(ℤ)) = ζ(−1).) -/
theorem orbiChar_M12_square :
    orbiChar 4 6 2 = -1 / 12 ∧ orbiChar 4 6 2 = B2 (1 / 2)
    ∧ orbiChar 2 3 1 = -1 / 6 := by
  refine ⟨?_, ?_, ?_⟩ <;> norm_num [orbiChar, B2]

/-- **El abelianizado de la amalgama es ℤ/12:** el pushout de ℤ/2 → ℤ/4
    (1 ↦ 2) y ℤ/2 → ℤ/6 (1 ↦ 3) en grupos abelianos.  El mapa
    (a, b) ↦ 3a + 2b es aditivo, suprayectivo, identifica 2 ∈ ℤ/4 con
    3 ∈ ℤ/6, y su núcleo es exactamente lo que esa identificación genera. -/
def amalgamAb (x : ZMod 4 × ZMod 6) : ZMod 12 :=
  3 * ((x.1.val : ℕ) : ZMod 12) + 2 * ((x.2.val : ℕ) : ZMod 12)

theorem abelianization_is_Z12 :
    (∀ x y : ZMod 4 × ZMod 6, amalgamAb (x + y) = amalgamAb x + amalgamAb y)
    ∧ (∀ z : ZMod 12, ∃ x : ZMod 4 × ZMod 6, amalgamAb x = z)
    ∧ amalgamAb (2, 0) = amalgamAb (0, 3)
    ∧ (∀ x : ZMod 4 × ZMod 6, amalgamAb x = 0 ↔ (x = (0, 0) ∨ x = (2, 3))) := by
  decide

/-- **Lema: con d = mcd(a, b), 1/a + 1/b − 1/d = −1/mcm(a, b) solo para (a, b) = (2d, 3d).**
    Con a = dx, b = dy, la igualdad es x + y − xy = −1, i.e. (x−1)(y−1) = 2. -/
theorem euler_char_pairs (x y : ℤ) (hx : 2 ≤ x) (hxy : x ≤ y) :
    x + y - x * y = -1 ↔ (x = 2 ∧ y = 3) := by
  constructor
  · intro h
    have h2 : (x - 1) * (y - 1) = 2 := by linear_combination (-1 : ℤ) * h
    have hy3 : 2 ≤ y := le_trans hx hxy
    have hx2 : x = 2 := by
      by_contra hne
      have hx3 : 3 ≤ x := by omega
      have hy3' : 3 ≤ y := le_trans hx3 hxy
      nlinarith
    subst hx2
    norm_num at h2
    exact ⟨rfl, by omega⟩
  · rintro ⟨rfl, rfl⟩; norm_num

/-- **Inclusión–exclusión de B₂ sobre el cuadrado de M12.** -/
theorem B2_sum_C4 : ∑ x ∈ C4frac, B2 x = 1 / 24 := by
  have h1 : (0:ℚ) ∉ ({1/4, 1/2, 3/4} : Finset ℚ) := by simp <;> norm_num
  have h2 : (1/4:ℚ) ∉ ({1/2, 3/4} : Finset ℚ) := by simp <;> norm_num
  have h3 : (1/2:ℚ) ∉ ({3/4} : Finset ℚ) := by simp <;> norm_num
  simp only [C4frac]
  rw [Finset.sum_insert h1, Finset.sum_insert h2, Finset.sum_insert h3,
    Finset.sum_singleton]
  norm_num [B2]

theorem B2_sum_C6 : ∑ x ∈ C6frac, B2 x = 1 / 36 := by
  have h1 : (0:ℚ) ∉ ({1/6, 1/3, 1/2, 2/3, 5/6} : Finset ℚ) := by simp <;> norm_num
  have h2 : (1/6:ℚ) ∉ ({1/3, 1/2, 2/3, 5/6} : Finset ℚ) := by simp <;> norm_num
  have h3 : (1/3:ℚ) ∉ ({1/2, 2/3, 5/6} : Finset ℚ) := by simp <;> norm_num
  have h4 : (1/2:ℚ) ∉ ({2/3, 5/6} : Finset ℚ) := by simp <;> norm_num
  have h5 : (2/3:ℚ) ∉ ({5/6} : Finset ℚ) := by simp <;> norm_num
  simp only [C6frac]
  rw [Finset.sum_insert h1, Finset.sum_insert h2, Finset.sum_insert h3,
    Finset.sum_insert h4, Finset.sum_insert h5, Finset.sum_singleton]
  norm_num [B2]

theorem B2_sum_C2 : ∑ x ∈ ({0, 1 / 2} : Finset ℚ), B2 x = 1 / 12 := by
  have h1 : (0:ℚ) ∉ ({1/2} : Finset ℚ) := by simp <;> norm_num
  rw [Finset.sum_insert h1, Finset.sum_singleton]
  norm_num [B2]

/-- **Sobre la unión (las ocho direcciones que no son el pushout):
    B₂·(1/4 + 1/6 − 1/2) = B₂·ζ(−1) = −1/72.** -/
theorem B2_sum_union :
    ∑ x ∈ C4frac ∪ C6frac, B2 x = B2 0 * orbiChar 4 6 2 := by
  have h := Finset.sum_union_inter (s₁ := C4frac) (s₂ := C6frac) (f := B2)
  rw [C4_meet_C6, B2_sum_C4, B2_sum_C6, B2_sum_C2] at h
  norm_num [B2, orbiChar] at h ⊢
  linarith

/-- **Sobre el pushout (las doce): +1/72; la diferencia son las cuatro
    direcciones primitivas, 1/36.** -/
theorem B2_pushout_vs_union :
    (∑ k ∈ Finset.range 12, B2 ((k : ℚ) / 12)) = -(B2 0 * orbiChar 4 6 2)
    ∧ B2 (1/12) + B2 (5/12) + B2 (7/12) + B2 (11/12) = 1 / 36 := by
  refine ⟨?_, ?_⟩
  · norm_num [Finset.sum_range_succ, B2, orbiChar]
  · norm_num [B2]

/-- La coincidencia es del peso 2: en peso s la inclusión–exclusión da
    4^{1−s} + 6^{1−s} − 2^{1−s}; en s = 3, −23/144. -/
theorem weight_two_only :
    (1 / 4 + 1 / 6 - 1 / 2 : ℚ) = -1 / 12
    ∧ (1 / 4 ^ 2 + 1 / 6 ^ 2 - 1 / 2 ^ 2 : ℚ) = -23 / 144 := by
  constructor <;> norm_num

/-- **El área del grupo modular une los dos valores:** π/3 = 4π·(1/12) =
    2ζ(2)/π. -/
theorem modular_area_two_readings :
    4 * Real.pi * (1 / 12) = Real.pi / 3
    ∧ 2 * (Real.pi ^ 2 / 6) / Real.pi = Real.pi / 3 := by
  constructor
  · ring
  · rw [div_eq_iff Real.pi_ne_zero]; ring

/- ═══════════════════════════════════════════════════════════════════════════
   §16  PARES E IMPARES: LA REFLEXIÓN DE M12                               (D3 §5)
   ═══════════════════════════════════════════════════════════════════════════ -/

def B1 (x : ℚ) : ℚ := x - 1 / 2
def B3 (x : ℚ) : ℚ := x ^ 3 - 3 / 2 * x ^ 2 + 1 / 2 * x
def B4 (x : ℚ) : ℚ := x ^ 4 - 2 * x ^ 3 + x ^ 2 - 1 / 30

/-- **B_k(1 − x) = (−1)^k B_k(x):** bajo la reflexión de M12 los pares son
    simétricos y los impares antisimétricos. -/
theorem bernoulli_reflection (x : ℚ) :
    B1 (1 - x) = -B1 x ∧ B2 (1 - x) = B2 x
    ∧ B3 (1 - x) = -B3 x ∧ B4 (1 - x) = B4 x := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> (simp only [B1, B2, B3, B4]; ring)

/-- Los impares se anulan en el origen y en la media vuelta (por eso ζ(2k+1),
    la parte de cosenos en 0, no cae en la parte de Bernoulli). -/
theorem odd_bernoulli_vanish :
    B3 0 = 0 ∧ B3 (1 / 2) = 0 ∧ B1 (1 / 2) = 0 := by
  refine ⟨?_, ?_, ?_⟩ <;> norm_num [B1, B3]

/- ═══════════════════════════════════════════════════════════════════════════
   §17  π ES ARCO, φ ES CUERDA                                             (D3 §6)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- Entrada: cos(π/5) = φ/2 (la usada por `phi_is_the_pentagon_chord`). -/
def CosPiFifth : Prop := Real.cos (Real.pi / 5) = phi / 2

theorem cos_two_pi_fifth (h : CosPiFifth) :
    Real.cos (2 * Real.pi / 5) = (phi - 1) / 2 := by
  unfold CosPiFifth at h
  rw [show 2 * Real.pi / 5 = 2 * (Real.pi / 5) by ring, Real.cos_two_mul, h]
  linear_combination (1 / 2 : ℝ) * phi_sq

theorem cos_four_pi_fifth (h : CosPiFifth) :
    Real.cos (2 * Real.pi * 2 / 5) = -(phi / 2) := by
  unfold CosPiFifth at h
  rw [show 2 * Real.pi * 2 / 5 = Real.pi - Real.pi / 5 by ring, Real.cos_pi_sub, h]

/-- **Cuerda del decágono en 1/10: 1/φ.** -/
theorem chord_tenth (h : CosPiFifth) : 2 * Real.sin (Real.pi / 10) = 1 / phi := by
  have h1 : Real.sin (Real.pi / 10) = Real.cos (2 * Real.pi / 5) := by
    rw [← Real.cos_pi_div_two_sub]; congr 1; ring
  rw [h1, cos_two_pi_fifth h, phi_inv]
  ring

/-- **Cuerda del decágono en 3/10: φ.** -/
theorem chord_three_tenths (h : CosPiFifth) : 2 * Real.sin (3 * Real.pi / 10) = phi := by
  unfold CosPiFifth at h
  have h1 : Real.sin (3 * Real.pi / 10) = Real.cos (Real.pi / 5) := by
    rw [← Real.cos_pi_div_two_sub]; congr 1; ring
  rw [h1, h]; ring

/-- **−log de la cuerda en 1/10 es log φ** (la parte de cosenos en s = 1). -/
theorem minus_log_chord (h : CosPiFifth) :
    -Real.log (2 * Real.sin (Real.pi / 10)) = Real.log phi := by
  rw [chord_tenth h, one_div, Real.log_inv, neg_neg]

/-- **L(1, χ₅) = T/(π√5) = 2 log φ/√5,** con T = 2π log φ el área del toro
    (rmk:pi-origin de las zetas impares). -/
theorem torus_area_identity :
    (2 * Real.pi * Real.log phi) / (Real.pi * Real.sqrt 5)
      = 2 * Real.log phi / Real.sqrt 5 := by
  have h5 : 0 < Real.sqrt 5 := Real.sqrt_pos.mpr (by norm_num)
  rw [div_eq_div_iff (by positivity) (by positivity)]
  ring

/- ═══════════════════════════════════════════════════════════════════════════
   §18  60 = 12·5 EN ζ_K(−1) = 1/30; EL PAR (−1, 2)                      (D3 §7–8)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- **El 5: B₂ en el pentágono con los signos de χ₅ da B_{2,χ₅} = 4/5.** -/
theorem B2_chi5_pentagon :
    5 * (B2 (1 / 5) - B2 (2 / 5) - B2 (3 / 5) + B2 (4 / 5)) = 4 / 5 := by
  norm_num [B2]

/-- **ζ_K(−1) = ζ(−1)·L(−1, χ₅) = (−1/12)·(−2/5) = 1/30 = 2/60.** -/
theorem zetaK_neg_one :
    B2 (1 / 2) * (-(5 * (B2 (1 / 5) - B2 (2 / 5) - B2 (3 / 5) + B2 (4 / 5))) / 2)
      = 1 / 30
    ∧ (1 / 30 : ℚ) = 2 / 60 := by
  constructor <;> norm_num [B2]

/-- Radio de Apolonio. -/
def rA (s : ℝ) : ℝ := |s - 1| / |s|

/-- **El par (−1, 2) tiene radios 2 y ½ = φ^{λ} y φ^{−λ}.** -/
theorem bernoulli_pair_radii_binary :
    rA (-1) = 2 ∧ rA 2 = 1 / 2
    ∧ rA (-1) = phi ^ lam ∧ rA 2 = phi ^ (-lam) := by
  have h1 : rA (-1) = 2 := by norm_num [rA]
  have h2 : rA 2 = 1 / 2 := by norm_num [rA]
  exact ⟨h1, h2, by rw [h1, phi_rpow_lam], by rw [h2, phi_rpow_neg_lam]⟩

/- ═══════════════════════════════════════════════════════════════════════════
   §19  LA ESTRUCTURA DE ARTIN DE ℤ[φ] EN EL CÍRCULO                        (D4 §1)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- Menos dos veces el coseno de la dirección a/5: la traza del par
    {a/5, −a/5} con signo.  φ = tr5 2 y σ(φ) = tr5 1. -/
def tr5 (a : ZMod 5) : ℝ := -2 * Real.cos (2 * Real.pi * (a.val : ℝ) / 5)

theorem tr5_zero : tr5 0 = -2 := by
  simp [tr5]

theorem tr5_one (h : CosPiFifth) : tr5 1 = 1 - phi := by
  have hv : (1 : ZMod 5).val = 1 := rfl
  unfold tr5
  rw [hv, Nat.cast_one, mul_one, cos_two_pi_fifth h]
  ring

theorem tr5_two (h : CosPiFifth) : tr5 2 = phi := by
  have hv : (2 : ZMod 5).val = 2 := rfl
  unfold tr5
  rw [hv, Nat.cast_ofNat, cos_four_pi_fifth h]
  ring

theorem tr5_three (h : CosPiFifth) : tr5 3 = phi := by
  have hv : (3 : ZMod 5).val = 3 := rfl
  unfold CosPiFifth at h
  unfold tr5
  rw [hv, Nat.cast_ofNat,
    show 2 * Real.pi * 3 / 5 = Real.pi / 5 + Real.pi by ring,
    Real.cos_add_pi, h]
  ring

theorem tr5_four (h : CosPiFifth) : tr5 4 = 1 - phi := by
  have hv : (4 : ZMod 5).val = 4 := rfl
  unfold tr5
  rw [hv, Nat.cast_ofNat,
    show 2 * Real.pi * 4 / 5 = -(2 * Real.pi / 5) + 2 * Real.pi by ring,
    -- riesgo: Real.cos_add_two_pi
    Real.cos_add_two_pi, Real.cos_neg, cos_two_pi_fifth h]
  ring

/-- **El Frobenius de Artin es el Frobenius del círculo.**  Para a = p mód 5,
    ψ_p lleva la dirección 2/5 a 2a/5: da φ si p ≡ ±1 (χ₅ = +1), σ(φ) = 1 − φ
    si p ≡ ±2 (χ₅ = −1), exacto también en p = 2; y −2 en p = 5. -/
theorem artin_is_circle_frobenius (h : CosPiFifth) :
    tr5 (1 * 2) = phi ∧ tr5 (4 * 2) = phi
    ∧ tr5 (2 * 2) = 1 - phi ∧ tr5 (3 * 2) = 1 - phi
    ∧ tr5 (0 * 2) = -2 := by
  have e1 : (1 : ZMod 5) * 2 = 2 := by decide
  have e4 : (4 : ZMod 5) * 2 = 3 := by decide
  have e2 : (2 : ZMod 5) * 2 = 4 := by decide
  have e3 : (3 : ZMod 5) * 2 = 1 := by decide
  have e0 : (0 : ZMod 5) * 2 = 0 := by decide
  rw [e1, e4, e2, e3, e0]
  exact ⟨tr5_two h, tr5_three h, tr5_four h, tr5_one h, tr5_zero⟩

/-- La misma afirmación en los pares de la reflexión (combinatoria pura). -/
def pairOf (a : ZMod 5) : Finset (ZMod 5) := {a, -a}

theorem artin_on_pentagon_pairs :
    ∀ p : ZMod 5, p ≠ 0 →
      (pairOf (p * 2) = pairOf 2 ↔ (p = 1 ∨ p = 4))
      ∧ (pairOf (p * 2) = pairOf 1 ↔ (p = 2 ∨ p = 3)) := by decide

/-- φ y σ(φ) son las trazas con signo de los dos pares del pentágono, y el
    par de φ lo fija la reflexión (χ₅ par). -/
theorem phi_is_pair_trace (h : CosPiFifth) :
    tr5 2 = phi ∧ tr5 (-2) = phi ∧ tr5 1 = 1 - phi ∧ tr5 (-1) = 1 - phi := by
  have en2 : (-2 : ZMod 5) = 3 := by decide
  have en1 : (-1 : ZMod 5) = 4 := by decide
  rw [en2, en1]
  exact ⟨tr5_two h, tr5_three h, tr5_one h, tr5_four h⟩

/-- **En el anillo de grupo del círculo, x ↦ x^m preserva el ideal (x^N − 1)
    para todo m.**  (Que ℤ[x]/(x^N − 1) sea un Λ-anillo con ψ_m(x) = x^m es [C];
    aquí solo la divisibilidad.) -/
theorem group_ring_frobenius_descends (N m : ℕ) :
    ((Polynomial.X : Polynomial ℤ) ^ N - 1)
      ∣ Polynomial.expand ℤ m ((Polynomial.X : Polynomial ℤ) ^ N - 1) := by
  rw [map_sub, map_pow, Polynomial.expand_X, map_one, ← pow_mul]
  have h : ((Polynomial.X : Polynomial ℤ) ^ N - 1)
      ∣ ((Polynomial.X : Polynomial ℤ) ^ N) ^ m - 1 ^ m := sub_dvd_pow_sub_pow _ _ _
  rwa [one_pow, ← pow_mul, mul_comm N m] at h

/- ═══════════════════════════════════════════════════════════════════════════
   §20  LA OBSTRUCCIÓN EN 5 ES Φ₅(1) = 5                                    (D4 §1.4)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- φ⁵ = 5φ + 3. -/
theorem phi_pow_five : phi ^ 5 = 5 * phi + 3 := by
  linear_combination (phi ^ 3 + phi ^ 2 + 2 * phi + 3) * phi_sq

/-- **ψ₅ da −2, que es φ⁵ módulo 5:** φ⁵ − (−2) = 5(φ + 1). -/
theorem psi_five_value_mod_five : phi ^ 5 - (-2) = 5 * (phi + 1) := by
  linear_combination (phi ^ 3 + phi ^ 2 + 2 * phi + 3) * phi_sq

/-- **Pero −2 no es conjugado de φ:** no es raíz de x² − x − 1; el defecto
    es 5. -/
theorem minus_two_not_root : ((-2 : ℤ) ^ 2 - (-2) - 1) = 5 := by norm_num

/-- **Φ₅(1) = 5:** ψ₅ manda el polinomio ciclotómico a 5, que no está en el
    ideal; módulo 5 sí (la fibra 𝔽₅[ε] del F1). -/
theorem cyclotomic_five_at_one :
    (1 + Polynomial.X + Polynomial.X ^ 2 + Polynomial.X ^ 3
      + Polynomial.X ^ 4 : Polynomial ℤ).eval 1 = 5 := by
  norm_num

/- ═══════════════════════════════════════════════════════════════════════════
   §21  LOS TRES OCHOS                                                      (D4 §3)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- **Tres grupos de orden 8, no isomorfos:** exponentes 2, 8 y 4.
    (ℤ/2)³ de los canales; ℤ/8 del 2³ de 360; (ℤ/20)^× ≅ ℤ/2 × ℤ/4. -/
theorem three_eights_distinct :
    (Fintype.card (Fin 3 → ZMod 2) = 8 ∧ ∀ v : Fin 3 → ZMod 2, v + v = 0)
    ∧ (Fintype.card (ZMod 8) = 8 ∧ ∃ x : ZMod 8, x + x + x + x ≠ 0)
    ∧ (Fintype.card (ZMod 20)ˣ = 8
        ∧ (∀ u : (ZMod 20)ˣ, u ^ 4 = 1) ∧ (∃ u : (ZMod 20)ˣ, u ^ 2 ≠ 1)) := by
  refine ⟨⟨by decide, by decide⟩, ⟨by decide, ⟨1, by decide⟩⟩,
    ⟨by decide, by decide, by decide⟩⟩

/-- Los tres bits de x (bit i = canal i), como vector de ℤ/2. -/
def bits (x : ℕ) : Fin 3 → ZMod 2 := fun i => (((x / 2 ^ (i : ℕ)) % 2 : ℕ) : ZMod 2)

/-- **(a) Los vértices del cubo son las cadenas de 3 bits; la
    complementariedad de M12 es restar del Mersenne M₃ = 7 = 111, que es
    sumar 1 en cada bit (sin acarreo); invertir el bit alto es sumar 4 con
    acarreo, la media vuelta de ℤ/8.**  (Con `bits` en lugar de `Nat.xor`:
    `Nat.xor` es recursión bien fundada y no reduce en `decide`.) -/
theorem iota_is_minus_from_M3 :
    (∀ x : Fin 8, bits (7 - x.val) = fun i => bits x.val i + 1)
    ∧ (∀ x : Fin 8, bits ((x.val + 4) % 8)
        = fun i : Fin 3 => if (i : ℕ) = 2 then bits x.val i + 1 else bits x.val i)
    ∧ (∀ x y : Fin 8, bits x.val = bits y.val → x = y)
    ∧ 2 ^ 3 - 1 = 7 ∧ 7 + 1 = 2 ^ 3 := by decide

/-- **(b) Las unidades módulo 60 sobre los cuadrados son (ℤ/2)³:** 16
    unidades, cuadrados {1, 49}, exponente 2 en el cociente. -/
theorem units_sixty_mod_squares :
    (Finset.univ.filter (fun a : ZMod 60 => ∃ b, a * b = 1)).card = 16
    ∧ (∀ a : ZMod 60, (∃ b, a * b = 1) → (a ^ 2 = 1 ∨ a ^ 2 = 49))
    ∧ (7 : ZMod 60) ^ 2 = 49 := by decide

/-- Módulo 20 el cociente es (ℤ/2)², el grupo de G: 8 unidades, cuadrados
    {1, 9}. -/
theorem units_twenty_mod_squares :
    (Finset.univ.filter (fun a : ZMod 20 => ∃ b, a * b = 1)).card = 8
    ∧ (∀ a : ZMod 20, (∃ b, a * b = 1) → (a ^ 2 = 1 ∨ a ^ 2 = 9)) := by decide

/- ═══════════════════════════════════════════════════════════════════════════
   §22  TEOREMA DE SÍNTESIS
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- **Síntesis de la sesión.**  Con las entradas clásicas como hipótesis:

    (a) 60 es el pushout bicartesiano del tono (12) y las clases (20) sobre
        los ejes oponentes (4), y el menor modo con pentágono;
    (b) los Mersenne recorren el círculo duplicando: periodo 4 módulo 60 y
        12 módulo 360;
    (c) Euler traduce rotación en producto y Frobenius en potencia, y lleva
        la media vuelta a −1;
    (d) el Frobenius respeta la suma de M12, y solo ±1 son isometrías;
    (e) el Frobenius baja la resolución por mcd;
    (f) ζ(−1) es B₂ en la media vuelta, forzado por la fibra binaria, y
        ζ(2) es la serie de cosenos en el origen;
    (g) −1/12 es la característica de Euler del cuadrado de M12 y la
        inclusión–exclusión de B₂ sobre él;
    (h) la estructura de Artin de ℤ[φ] es el Frobenius del círculo sobre los
        pares del pentágono, y en 5 falla por Φ₅(1) = 5;
    (i) los tres ochos son distintos; la complementariedad es restar de M₃. -/
theorem session_synthesis (hF : FourierB2Input) (hZ : ZetaNegOneInput)
    (hC : CosPiFifth) :
    -- (a)
    (IsPushout DivCat (A := 4) (B := 12) (P := 20) (Q := 60)
        ⟨incl_4_12⟩ ⟨incl_4_20⟩ ⟨incl_12_60⟩ ⟨incl_20_60⟩
      ∧ IsLeast {n : ℕ | 0 < n ∧ 12 ∣ n ∧ 5 ∣ n} 60)
    -- (b)
    ∧ (∀ p, 2 ≤ p → 2 ^ (p + 4) % 60 = 2 ^ p % 60)
    ∧ (∀ p, 3 ≤ p → 2 ^ (p + 12) % 360 = 2 ^ p % 360)
    -- (c)
    ∧ (∀ (N : ℕ) (j k : ℤ), eulerMap N (j + k) = eulerMap N j * eulerMap N k)
    ∧ (∀ (N p : ℕ) (k : ℤ), eulerMap N ((p : ℤ) * k) = eulerMap N k ^ p)
    ∧ (∀ M : ℕ, M ≠ 0 → eulerMap (2 * M) M = -1)
    -- (d)
    ∧ (∀ (N p : ℕ) (k c : ZMod N), psi_mod N p (k + c) = psi_mod N p k + psi_mod N p c)
    ∧ (∀ (N : ℕ) [NeZero N], 3 ≤ N → ∀ u : ZMod N,
        (∀ j k : ZMod N, dIdx (u * j) (u * k) = dIdx j k) ↔ (u = 1 ∨ u = -1))
    -- (e)
    ∧ (∀ (N m : ℕ) [NeZero N],
        Finset.univ.image (fun k : ZMod N => bndOf N ((m : ZMod N) * k))
          = Bnd (N / Nat.gcd N m))
    -- (f)
    ∧ (B2 0 + B2 (1 / 2) = (1 / 2) * B2 0 ∧ riemannZeta (-1) = ((B2 (1 / 2) : ℚ) : ℂ)
        ∧ BaselInput)
    -- (g)
    ∧ (orbiChar 4 6 2 = -1 / 12 ∧ ∑ x ∈ C4frac ∪ C6frac, B2 x = B2 0 * orbiChar 4 6 2)
    -- (h)
    ∧ (tr5 (1 * 2) = phi ∧ tr5 (2 * 2) = 1 - phi ∧ phi ^ 5 - (-2) = 5 * (phi + 1))
    -- (i)
    ∧ (∀ x : Fin 8, bits (7 - x.val) = fun i => bits x.val i + 1) :=
  ⟨⟨sixty_is_pushout, sixty_least_mode_with_pentagon⟩,
   two_pow_period_60, two_pow_period_360,
   eulerMap_add, eulerMap_psi, eulerMap_half_turn,
   psi_respects_rotation,
   units_isometric_iff,
   frobenius_lowers_resolution,
   ⟨B2_binary_fiber, (zeta_neg_one_on_circle hZ).1, basel_from_fourier hF⟩,
   ⟨orbiChar_M12_square.1, B2_sum_union⟩,
   ⟨(artin_is_circle_frobenius hC).1, (artin_is_circle_frobenius hC).2.2.1,
     psi_five_value_mod_five⟩,
   iota_is_minus_from_M3.1⟩


/- ═══════════════════════════════════════════════════════════════════════════
   §23  CRECIMIENTO SIN DESFASE                                              (D5)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- **El Frobenius conjuga la rotación:** ψ_m ∘ R_c = R_{mc} ∘ ψ_m. -/
theorem frobenius_conjugates_rotation (N m : ℕ) (c k : ZMod N) :
    psi_mod N m (k + c) = psi_mod N m k + (m : ZMod N) * c := by
  unfold psi_mod; ring

/-- **…sin sacarla del hexágono:** en ℤ/12 el sexto de vuelta es la clase 2,
    y m·2 está en el hexágono para todo m. -/
theorem frobenius_keeps_hexagon :
    ∀ m : ZMod 12, m * 2 ∈ ({0, 2, 4, 6, 8, 10} : Finset (ZMod 12)) := by decide

/-- **Los primos coprimos con 6 conservan la admisibilidad en todo nivel.** -/
theorem psi_preserves_admissible (n m : ℕ) (h12 : 12 ∣ n) (hm : Nat.Coprime m 6) :
    12 ∣ n / Nat.gcd n m := by
  have h6 : Nat.Coprime (Nat.gcd n m) 6 :=
    Nat.Coprime.coprime_dvd_left (Nat.gcd_dvd_right n m) hm
  have hg : Nat.Coprime (Nat.gcd n m) 12 :=
    Nat.Coprime.coprime_dvd_right (show 12 ∣ 6 ^ 2 by norm_num)
      (Nat.Coprime.pow_right 2 h6)
  have hmul : Nat.gcd n m * 12 ∣ n :=
    Nat.Coprime.mul_dvd_of_dvd_of_dvd hg (Nat.gcd_dvd_left n m) h12
  exact Nat.dvd_div_of_mul_dvd hmul

/-- El 3 la conserva solo con 36 ∣ n (el 2, con 24 ∣ n: `psi_two_admissible`). -/
theorem psi_three_admissible (t : ℕ) : 12 ∣ t ↔ 36 ∣ 3 * t := by omega

theorem psi_five_on_sixty_admissible : 12 ∣ 60 / Nat.gcd 60 5 := by decide

/-- **La media vuelta está en toda frontera par** (y allí B₂ = ζ(−1),
    `B2_half_turn`): ζ(−1) no deriva al refinar. -/
theorem half_turn_in_even_levels (t : ℕ) (ht : 0 < t) :
    (1 / 2 : ℚ) ∈ Bnd (2 * t) := by
  simp only [Bnd, Finset.mem_image, Finset.mem_range]
  refine ⟨t, by omega, ?_⟩
  have h : ((2 * t : ℕ) : ℚ) ≠ 0 := by exact_mod_cast (by omega : 2 * t ≠ 0)
  rw [div_eq_iff h]
  push_cast
  ring

/-- **El binario se refina sin contradecir el nivel anterior:** la clase
    módulo 300 determina la de módulo 60, y los periodos se dividen. -/
theorem mersenne_levels_compatible (k : ℕ) :
    (2 ^ k % 300) % 60 = 2 ^ k % 60 ∧ (4 ∣ 20 ∧ 20 ∣ 100) := by
  exact ⟨Nat.mod_mod_of_dvd _ (by norm_num), by decide, by decide⟩

/-- **En el toro, la escala por φ (σ ↦ σ + 1) no mueve la coordenada radial.** -/
theorem phi_scaling_preserves_fract (σ : ℝ) : Int.fract (σ + 1) = Int.fract σ :=
  Int.fract_add_one σ

/-- **El Frobenius está bien definido en el círculo radial:** depende solo de
    la parte fraccionaria. -/
theorem frobenius_on_fract (p : ℕ) (σ : ℝ) :
    Int.fract ((p : ℝ) * (σ + 1)) = Int.fract ((p : ℝ) * σ) := by
  rw [mul_add, mul_one, Int.fract_add_natCast]

/-- **La inversión de la torre es la complementariedad:**
    fract(−σ) = 1 − fract(σ) (la identidad 1 − x = −x del círculo). -/
theorem inversion_is_complement (σ : ℝ) (h : Int.fract σ ≠ 0) :
    Int.fract (-σ) = 1 - Int.fract σ :=
  Int.fract_neg h

/-- **El ½ radial es punto fijo de la inversión:** 2-torsión. -/
theorem radial_half_fixed : Int.fract (-(1 / 2 : ℝ)) = Int.fract (1 / 2) := by
  have h : Int.fract (1 / 2 : ℝ) = 1 / 2 :=
    Int.fract_eq_self.mpr ⟨by norm_num, by norm_num⟩
  rw [Int.fract_neg (by rw [h]; norm_num), h]
  norm_num

/-- Entrada: λ es irracional (es trascendente por Gelfond–Schneider; F1, CR). -/
def LambdaIrrational : Prop := Irrational lam

/-- **El ½ binario no es torsión del toro:** su coordenada radial −λ no es
    k/N para ningún nivel N. -/
theorem binary_half_not_torsion (h : LambdaIrrational) (N : ℕ) (k : ℤ) :
    -lam ≠ (k : ℝ) / N := by
  intro heq
  apply h
  refine ⟨(-k : ℚ) / N, ?_⟩
  push_cast
  rw [neg_div]
  linarith

/-- **Dónde entra Mersenne en la tríada:** el Frobenius en p lleva el radio ½
    a (½)^p = 1/(M_p + 1). -/
theorem triad_frobenius_radius (ζ : ℂ) (hζ : ‖ζ‖ = 1) (p : ℕ) :
    ‖((1 / 2 : ℂ) * ζ) ^ p‖ = (1 / 2 : ℝ) ^ p := by
  -- riesgo: la norma del literal ½ en ℂ
  rw [norm_pow, norm_mul, hζ, mul_one]
  norm_num

theorem half_pow_is_mersenne (p : ℕ) :
    (1 / 2 : ℝ) ^ p = 1 / (((2 ^ p - 1 : ℕ) : ℝ) + 1) := by
  rw [Nat.cast_sub Nat.one_le_two_pow]
  push_cast
  rw [sub_add_cancel, one_div_pow]

/-- …y el ángulo de la tríada lo mueve la clase de p módulo 3 (χ₋₃):
    fijo si p ≡ 1, conjugado si p ≡ 2. -/
theorem triad_frobenius_angle :
    ∀ k : ZMod 3, (1 : ZMod 3) * k = k ∧ (2 : ZMod 3) * k = -k := by decide

/-- Candidata de §7 de D5: la luminosidad de un Mersenne. -/
def mersenneLightness (p : ℝ) : ℝ := Int.fract (sigmaIdx p)

/-- **Síntesis de D5.** -/
theorem growth_without_drift (hL : LambdaIrrational) :
    (∀ (N m : ℕ) (c k : ZMod N),
        psi_mod N m (k + c) = psi_mod N m k + (m : ZMod N) * c)
    ∧ (∀ m : ZMod 12, m * 2 ∈ ({0, 2, 4, 6, 8, 10} : Finset (ZMod 12)))
    ∧ (∀ n m : ℕ, 12 ∣ n → Nat.Coprime m 6 → 12 ∣ n / Nat.gcd n m)
    ∧ (∀ t : ℕ, 0 < t → (1 / 2 : ℚ) ∈ Bnd (2 * t))
    ∧ B2 (1 / 2) = -1 / 12
    ∧ (∀ (N p : ℕ) (σ : ℝ) (k : ℤ),
        (phi ^ σ) ^ (p : ℝ) = phi ^ ((p : ℝ) * σ)
        ∧ eulerMap N ((p : ℤ) * k) = eulerMap N k ^ p
        ∧ 2 * phi ^ σ = phi ^ (σ + lam))
    ∧ (∀ σ : ℝ, Int.fract (σ + 1) = Int.fract σ)
    ∧ (∀ (N : ℕ) (k : ℤ), -lam ≠ (k : ℝ) / N)
    ∧ (∀ p : ℕ, (1 / 2 : ℝ) ^ p = 1 / (((2 ^ p - 1 : ℕ) : ℝ) + 1)) :=
  ⟨frobenius_conjugates_rotation, frobenius_keeps_hexagon, psi_preserves_admissible,
   half_turn_in_even_levels, B2_half_turn,
   (fun N p σ k => frobenius_both_coordinates N p σ k),
   phi_scaling_preserves_fract, binary_half_not_torsion hL, half_pow_is_mersenne⟩


/- ═══════════════════════════════════════════════════════════════════════════
   §24  DE M12 AL F1: Ω̂ COMO ROTACIÓN DE LA CELDA; ANCLAJES                  (D6)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- Coordenada del plano de la celda (modo 1 de Fourier sobre ℤ/3):
    z(v₀, v₁, v₂) = v₀ + ω v₁ + ω² v₂.  Se usa con ω³ = 1, 1 + ω + ω² = 0. -/
def zc (ω : ℂ) (a b c : ℝ) : ℂ := (a : ℂ) + ω * (b : ℂ) + ω ^ 2 * (c : ℂ)

/-- Coordenada del eje (modo 0). -/
def axisCoord (a b c : ℝ) : ℝ := (a + b + c) / 3

/-- **La rotación de la celda (a, b, c) ↦ (c, a, b), `rot_120` de M12, es
    multiplicar z por ω.** -/
theorem zc_rotation (ω : ℂ) (h3 : ω ^ 3 = 1) (a b c : ℝ) :
    zc ω c a b = ω * zc ω a b c := by
  unfold zc
  linear_combination (-(c : ℂ)) * h3

/-- La rotación no mueve el eje. -/
theorem axis_rotation (a b c : ℝ) : axisCoord c a b = axisCoord a b c := by
  unfold axisCoord; ring

/-- **El eje es el núcleo de z.** -/
theorem zc_axis_kernel (ω : ℂ) (h1 : 1 + ω + ω ^ 2 = 0) (t : ℝ) : zc ω t t t = 0 := by
  unfold zc
  linear_combination (t : ℂ) * h1

/-- **La complementariedad v ↦ (1,1,1) − v es la media vuelta en el plano y
    la complementariedad en el eje** (cf. `iota_decomposition` de M12). -/
theorem zc_complement (ω : ℂ) (h1 : 1 + ω + ω ^ 2 = 0) (a b c : ℝ) :
    zc ω (1 - a) (1 - b) (1 - c) = -zc ω a b c
    ∧ axisCoord (1 - a) (1 - b) (1 - c) = 1 - axisCoord a b c := by
  constructor
  · unfold zc
    push_cast
    linear_combination h1
  · unfold axisCoord; ring

/-- **El espejo que intercambia la segunda y la tercera dirección (`sigma_v2`
    de M12) es conjugar z.** -/
theorem zc_mirror (ω : ℂ) (h3 : ω ^ 3 = 1) (hc : (starRingEnd ℂ) ω = ω ^ 2)
    (a b c : ℝ) :
    zc ω a c b = (starRingEnd ℂ) (zc ω a b c) := by
  unfold zc
  simp only [map_add, map_mul, map_pow, Complex.conj_ofReal, hc]
  linear_combination (-(c : ℂ) * ω) * h3

/-- **La tríada de la celda está en el círculo unidad:** las tres direcciones
    tienen z = 1, ω, ω². -/
theorem triad_on_unit_circle (ω : ℂ) (hn : ‖ω‖ = 1) :
    zc ω 1 0 0 = 1 ∧ zc ω 0 1 0 = ω ∧ zc ω 0 0 1 = ω ^ 2
    ∧ ‖zc ω 1 0 0‖ = 1 ∧ ‖zc ω 0 1 0‖ = 1 ∧ ‖zc ω 0 0 1‖ = 1 := by
  refine ⟨by simp [zc], by simp [zc], by simp [zc], by simp [zc], ?_, ?_⟩
  · simp [zc, hn]
  · simp [zc, norm_pow, hn]

/-- **El puente en el ángulo es ×½:** lleva la tríada {1, ω, ω²} a la del F1,
    {½ζ₃^k}, y conmuta con la rotación y con el espejo (equivariante por S₃). -/
theorem bridge_half_equivariant (ω z : ℂ) :
    (1 / 2 : ℂ) * (ω * z) = ω * ((1 / 2 : ℂ) * z)
    ∧ (1 / 2 : ℂ) * (starRingEnd ℂ) z = (starRingEnd ℂ) ((1 / 2 : ℂ) * z)
    ∧ (1 / 2 : ℂ) * (-z) = -((1 / 2 : ℂ) * z) := by
  refine ⟨by ring, ?_, by ring⟩
  simp [map_mul, map_div₀, map_one, map_ofNat]

/-- **El Frobenius sobre la tríada:** fija si p ≡ 1 (mód 3), y si p ≡ 2 da
    ω², que es el conjugado de ω: el espejo de la celda (χ₋₃(p) = −1). -/
theorem frobenius_on_triad (ω : ℂ) (h3 : ω ^ 3 = 1) (k : ℕ) :
    ω ^ (3 * k + 1) = ω ∧ ω ^ (3 * k + 2) = ω ^ 2 := by
  constructor <;> simp [pow_add, pow_mul, h3]

/-- **Las potencias de Ω̂ = ½·diag(1, ω, ω²):** en el eje (½)^p = 1/(M_p + 1);
    en el plano (½)^p por la rotación de p tercios. -/
theorem omega_hat_powers (ω : ℂ) (p : ℕ) :
    ((1 / 2 : ℂ) * ω ^ 0) ^ p = (1 / 2 : ℂ) ^ p
    ∧ ((1 / 2 : ℂ) * ω) ^ p = (1 / 2 : ℂ) ^ p * ω ^ p
    ∧ ((1 / 2 : ℂ) * ω ^ 2) ^ p = (1 / 2 : ℂ) ^ p * (ω ^ 2) ^ p := by
  refine ⟨by simp, mul_pow _ _ _, mul_pow _ _ _⟩

/-- **Anclaje binario, lado aditivo:** 2^p nunca es un nivel admisible. -/
theorem two_pow_not_admissible (p : ℕ) : ¬ 12 ∣ 2 ^ p := by
  intro h
  have h3 : 3 ∣ 2 ^ p := dvd_trans (by norm_num) h
  have := Nat.Prime.dvd_of_dvd_pow Nat.prime_three h3
  norm_num at this

/-- …ni es unidad módulo 20 (es par, p ≥ 1). -/
theorem two_pow_even (p : ℕ) (hp : 1 ≤ p) : 2 ∣ 2 ^ p :=
  dvd_pow_self 2 (by omega)

/-- **Anclaje binario, lado multiplicativo:** M_p = 2^p − 1 cae en 31 o 7
    módulo 60, que son unidades. -/
theorem mersenne_lands_in_units (k : ℕ) :
    (2 ^ (5 + 4 * k) - 1) % 60 = 31 ∧ (2 ^ (3 + 4 * k) - 1) % 60 = 7
    ∧ (31 : ZMod 60) * 31 = 1 ∧ (7 : ZMod 60) * 43 = 1 := by
  have h1 := (mersenne_mod_60_table k).1
  have h2 := (mersenne_mod_60_table k).2
  refine ⟨?_, ?_, by decide, by decide⟩
  · generalize 2 ^ (5 + 4 * k) = X at h1 ⊢
    omega
  · generalize 2 ^ (3 + 4 * k) = X at h2 ⊢
    omega

/-- **Síntesis de D6.** -/
theorem m12_to_f1_bridge (ω : ℂ) (h3 : ω ^ 3 = 1) (h1 : 1 + ω + ω ^ 2 = 0)
    (hc : (starRingEnd ℂ) ω = ω ^ 2) :
    (∀ a b c : ℝ, zc ω c a b = ω * zc ω a b c)
    ∧ (∀ t : ℝ, zc ω t t t = 0)
    ∧ (∀ a b c : ℝ, zc ω (1 - a) (1 - b) (1 - c) = -zc ω a b c)
    ∧ (∀ a b c : ℝ, zc ω a c b = (starRingEnd ℂ) (zc ω a b c))
    ∧ (∀ k : ℕ, ω ^ (3 * k + 1) = ω ∧ ω ^ (3 * k + 2) = ω ^ 2)
    ∧ (∀ p : ℕ, ¬ 12 ∣ 2 ^ p)
    ∧ (∀ k : ℕ, (2 ^ (5 + 4 * k) - 1) % 60 = 31 ∧ (2 ^ (3 + 4 * k) - 1) % 60 = 7) :=
  ⟨zc_rotation ω h3, zc_axis_kernel ω h1, fun a b c => (zc_complement ω h1 a b c).1,
   zc_mirror ω h3 hc, frobenius_on_triad ω h3, two_pow_not_admissible,
   fun k => ⟨(mersenne_lands_in_units k).1, (mersenne_lands_in_units k).2.1⟩⟩


/- ═══════════════════════════════════════════════════════════════════════════
   §25  LA TORRE DE CELDAS, EL ACOPLAMIENTO ÁUREO, LOS DOS C₂                 (D7)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- El E³ del F1: los puntos (x, y, φy). -/
def inE3 (v : ℝ × ℝ × ℝ) : Prop := v.2.2 = phi * v.2.1

/-- La rotación de la celda, (a, b, c) ↦ (c, a, b). -/
def cellRot (v : ℝ × ℝ × ℝ) : ℝ × ℝ × ℝ := (v.2.2, v.1, v.2.1)

/-- **La realización (x, y, φy) de E³ no es estable si se permutan sus
    coordenadas:** e₁ está y su imagen e₂ no.
    LECTURA CORREGIDA.  Esto NO es una ruptura de S₃.  En esta realización el
    F1 hace actuar las razones φ^k (`fold_back_is_cell_recursion`), no las
    permutaciones de coordenadas; el S₃ del F1 actúa sobre las tres
    direcciones propias de Ω̂, que es otra realización de la misma clase de
    dimensión 3.  Cómo se relacionan φ y S₃ de verdad está en la §26:
    conmutan en la cara global y en la arquimediana, y coinciden en el lugar
    binario. -/
theorem E3_not_rotation_invariant :
    inE3 (1, 0, 0) ∧ ¬ inE3 (cellRot (1, 0, 0)) := by
  refine ⟨by simp [inE3], ?_⟩
  simp only [inE3, cellRot]
  intro h
  have : phi * 1 = 0 := by linarith
  linarith [phi_pos]

/-- **E³ no contiene el eje:** solo el 0. -/
theorem E3_meets_axis_only_at_zero (t : ℝ) (h : inE3 (t, t, t)) : t = 0 := by
  simp only [inE3] at h
  have h1 : (phi - 1) * t = 0 := by linarith
  rcases mul_eq_zero.mp h1 with h2 | h2
  · linarith [one_lt_phi]
  · exact h2

/-- **E³ no es perpendicular al eje:** su normal (0, −φ, 1) da 1 − φ ≠ 0. -/
theorem E3_normal_not_axial : (0 : ℝ) + (-phi) + 1 ≠ 0 := by
  linarith [one_lt_phi]

/-- **El pliegue es la recursión entre tres celdas:** φ(φy) = φy + y. -/
theorem fold_back_is_cell_recursion (y : ℝ) : phi * (phi * y) = phi * y + y := by
  linear_combination y * phi_sq

/-- Complementariedad de la celda a escala σ. -/
def iotaScaled (σ : ℝ) (v : ℝ × ℝ × ℝ) : ℝ × ℝ × ℝ :=
  (phi ^ σ - v.1, phi ^ σ - v.2.1, phi ^ σ - v.2.2)

/-- Dilatación por φ (el paso de la torre). -/
def dilate (v : ℝ × ℝ × ℝ) : ℝ × ℝ × ℝ := (phi * v.1, phi * v.2.1, phi * v.2.2)

/-- **La dilatación conmuta con la rotación de la celda.** -/
theorem dilate_comm_rot (v : ℝ × ℝ × ℝ) : dilate (cellRot v) = cellRot (dilate v) := by
  rfl

/-- **La dilatación entrelaza las complementariedades:**
    δ ∘ ι_σ = ι_{σ+1} ∘ δ. -/
theorem dilate_intertwines_iota (σ : ℝ) (v : ℝ × ℝ × ℝ) :
    dilate (iotaScaled σ v) = iotaScaled (σ + 1) (dilate v) := by
  have h : phi ^ (σ + 1) = phi * phi ^ σ := by
    rw [Real.rpow_add phi_pos, Real.rpow_one, mul_comm]
  simp only [dilate, iotaScaled, h, Prod.mk.injEq]
  refine ⟨by ring, by ring, by ring⟩

/-- **La dilatación respeta la descomposición en eje y plano:** escala las dos
    coordenadas de Fourier por φ. -/
theorem dilate_respects_fourier (ω : ℂ) (a b c : ℝ) :
    zc ω (phi * a) (phi * b) (phi * c) = (phi : ℂ) * zc ω a b c
    ∧ axisCoord (phi * a) (phi * b) (phi * c) = phi * axisCoord a b c := by
  constructor
  · unfold zc; push_cast; ring
  · unfold axisCoord; ring

/-- **E³ es la gráfica del paso:** (x, y, φy) es (x, y, (δ v).y) con v = (x, y, 0)… 
    dicho sin vectores: la coordenada acoplada es la coordenada dilatada. -/
theorem E3_is_graph_of_step (x y : ℝ) :
    inE3 (x, y, (dilate (0, y, 0)).2.1) := by
  simp [inE3, dilate]

/-- **Los tres C₂ de las unidades módulo 20**, y cuál refleja qué:
    9 refleja solo el pentágono (≡ 1 mód 4, ≡ −1 mód 5), 11 solo el cuadrado,
    19 = −1 las dos partes; 9·11 = 19; ker G = cuadrados = {1, 9}. -/
theorem three_C2_mod_20 :
    (∀ a : ZMod 20, (a * a = 1) ↔ a ∈ ({1, 9, 11, 19} : Finset (ZMod 20)))
    ∧ ((9 : ZMod 4) = 1 ∧ (9 : ZMod 5) = -1)
    ∧ ((11 : ZMod 4) = -1 ∧ (11 : ZMod 5) = 1)
    ∧ ((19 : ZMod 4) = -1 ∧ (19 : ZMod 5) = -1)
    ∧ (9 : ZMod 20) * 11 = 19
    ∧ (∀ a : ZMod 20, (∃ b, a * b = 1) → (a ^ 2 = 1 ∨ a ^ 2 = 9)) := by
  decide

/-- **ker G fija φ:** la reflexión del pentágono (multiplicar por 9 ≡ −1 en
    ℤ/5) deja fijos los dos pares de la reflexión. -/
theorem kerG_fixes_pentagon_pairs :
    ∀ a : ZMod 5, pairOf ((9 : ZMod 5) * a) = pairOf a := by decide

/-- **Síntesis de D7.** -/
theorem cell_tower_and_two_C2 :
    (inE3 (1, 0, 0) ∧ ¬ inE3 (cellRot (1, 0, 0)))
    ∧ (∀ t : ℝ, inE3 (t, t, t) → t = 0)
    ∧ (∀ y : ℝ, phi * (phi * y) = phi * y + y)
    ∧ (∀ (σ : ℝ) (v : ℝ × ℝ × ℝ), dilate (iotaScaled σ v) = iotaScaled (σ + 1) (dilate v))
    ∧ (∀ v : ℝ × ℝ × ℝ, dilate (cellRot v) = cellRot (dilate v))
    ∧ (9 : ZMod 20) * 11 = 19
    ∧ (∀ a : ZMod 5, pairOf ((9 : ZMod 5) * a) = pairOf a) :=
  ⟨E3_not_rotation_invariant, E3_meets_axis_only_at_zero, fold_back_is_cell_recursion,
   dilate_intertwines_iota, dilate_comm_rot, three_C2_mod_20.2.2.2.2.1,
   kerG_fixes_pentagon_pairs⟩


/- ═══════════════════════════════════════════════════════════════════════════
   §26  UN SOLO MARCO: φ Y LA CELDA EN SUS TRES CARAS              (D7 corregido)

   La relación entre el número áureo y la simetría S₃ de la celda de M12 no
   es una sola; depende del lugar donde se lea:
     (A) cara global, nivel 60: ℚ(√−3) y ℚ(√5) son independientes; el espejo
         de la tríada puede fijar φ (testigo 41); ninguna involución mueve φ;
     (B) cara arquimediana (el operador): φ entra como escalar, el módulo
         φ^{−λ} = ½ de Ω̂, y un escalar real conmuta con todo S₃ y con −1;
     (C) cara binaria, el lugar 2: x² − x − 1 ≡ x² + x + 1 (mód 2), así que
         ℤ[φ]/2 = ℤ[ω]/2 = 𝔽₄, y los vértices de la celda, {0,1}³ = 𝔽₂³, son
         𝔽₂ × ℤ[φ]/2: el eje es el bit de paridad (qué tetraedro), la rotación
         de la celda es multiplicar por φ, el espejo es el Frobenius (= la
         conjugación φ ↦ φ̄) y la complementariedad cambia solo el bit del eje.
   En (C) el paso de la torre y la rotación de la celda son el mismo
   generador; en (B) son distintos y conmutan; en (A) son independientes.
   ═══════════════════════════════════════════════════════════════════════════ -/

/-! ### (C) La cara binaria -/

/-- ℤ[φ]/2 y ℤ[ω]/2 como pares (a, b) = a + b·x sobre 𝔽₂. -/
abbrev G2 := ZMod 2 × ZMod 2

/-- Producto en ℤ[φ]/2, con φ² = φ + 1. -/
def gmul (x y : G2) : G2 := (x.1 * y.1 + x.2 * y.2, x.1 * y.2 + x.2 * y.1 + x.2 * y.2)

/-- Producto en ℤ[ω]/2, con ω² = −1 − ω. -/
def emul (x y : G2) : G2 := (x.1 * y.1 - x.2 * y.2, x.1 * y.2 + x.2 * y.1 - x.2 * y.2)

/-- La unidad (1, 0).  (No se usa `1 : G2`, que en un producto es (1, 1).) -/
def one2 : G2 := (1, 0)

/-- φ módulo 2. -/
def phi2 : G2 := (0, 1)

/-- La conjugación de Galois módulo 2: a + bφ ↦ a + b(1 − φ) = (a + b) − bφ. -/
def gconj (x : G2) : G2 := (x.1 + x.2, -x.2)

/-- **El polinomio áureo y el ciclotómico Φ₃ difieren en 2(x + 1).** -/
theorem golden_poly_eq_cyclotomic_three_mod_two (x : ℤ) :
    x ^ 2 - x - 1 = (x ^ 2 + x + 1) - 2 * (x + 1) := by ring

/-- **Por eso ℤ[φ]/2 y ℤ[ω]/2 tienen la misma tabla de multiplicar.** -/
theorem golden_eq_eisenstein_mod_two : ∀ x y : G2, gmul x y = emul x y := by decide

/-- **Los discriminantes 5 y −3 son congruentes módulo 8**, y −15 ≡ 1
    (mód 16): el 2 es inerte en los dos cuerpos y sus completados en 2
    coinciden, ℚ₂(√5) = ℚ₂(√−3) (en el F1: `minus_fifteen_is_a_two_adic_square`,
    `polar_at_two`, [P*] del corpus; aquí solo la congruencia). -/
theorem discriminants_mod_eight : (5 : ZMod 8) = -3 ∧ (-15 : ZMod 16) = 1 := by decide

/-- **φ módulo 2 tiene orden 3 y cumple la relación de la tríada**
    1 + φ + φ² = 0, la misma que 1 + ω + ω² = 0 (`zc_axis_kernel`). -/
theorem phi2_is_a_cube_root :
    gmul phi2 phi2 = phi2 + one2
    ∧ gmul (gmul phi2 phi2) phi2 = one2
    ∧ phi2 ≠ one2 ∧ gmul phi2 phi2 ≠ one2
    ∧ one2 + phi2 + gmul phi2 phi2 = 0 := by decide

/-- **El Frobenius de 2 (elevar al cuadrado) es aditivo y es la conjugación
    de Galois.** -/
theorem frobenius_two_is_conjugation :
    (∀ x : G2, gmul x x = gconj x)
    ∧ (∀ x y : G2, gmul (x + y) (x + y) = gmul x x + gmul y y) := by decide

/-- Los vértices de la celda de M12 como 𝔽₂³. -/
abbrev Cell2 := ZMod 2 × ZMod 2 × ZMod 2

/-- Fourier módulo 2: (paridad, v₀ + v₁φ + v₂φ²).  Es la versión binaria de
    (`axisCoord`, `zc`) de la §24. -/
def four2 (v : Cell2) : ZMod 2 × G2 :=
  (v.1 + v.2.1 + v.2.2,
   (v.1, 0) + gmul (v.2.1, 0) phi2 + gmul (v.2.2, 0) (gmul phi2 phi2))

/-- Rotación, espejo y complementariedad de la celda sobre 𝔽₂³ (las mismas
    fórmulas que `cellRot`, `sigma_v2` y v ↦ (1,1,1) − v). -/
def rot2 (v : Cell2) : Cell2 := (v.2.2, v.1, v.2.1)
def mir2 (v : Cell2) : Cell2 := (v.1, v.2.2, v.2.1)
def comp2 (v : Cell2) : Cell2 := (v.1 + 1, v.2.1 + 1, v.2.2 + 1)

/-- **Los vértices de la celda son 𝔽₂ × ℤ[φ]/2:** `four2` es biyectiva. -/
theorem four2_injective : ∀ v w : Cell2, four2 v = four2 w → v = w := by decide

theorem four2_surjective : ∀ y : ZMod 2 × G2, ∃ v : Cell2, four2 v = y := by decide

theorem four2_bijective : Function.Bijective four2 :=
  ⟨fun v w h => four2_injective v w h, four2_surjective⟩

/-- **En esas coordenadas:** la rotación de la celda es multiplicar por φ; el
    espejo es el Frobenius de 2 (la conjugación); la complementariedad solo
    cambia el bit del eje; el eje (1,1,1) es (1, 0); y las tres direcciones
    son 1, φ, φ². -/
theorem cell_is_golden_ring_mod_two :
    (∀ v : Cell2, four2 (rot2 v) = ((four2 v).1, gmul phi2 (four2 v).2))
    ∧ (∀ v : Cell2, four2 (mir2 v) = ((four2 v).1, gconj (four2 v).2))
    ∧ (∀ v : Cell2, four2 (comp2 v) = ((four2 v).1 + 1, (four2 v).2))
    ∧ four2 ((1, 1, 1) : Cell2) = (1, 0)
    ∧ four2 ((1, 0, 0) : Cell2) = (1, one2)
    ∧ four2 ((0, 1, 0) : Cell2) = (1, phi2)
    ∧ four2 ((0, 0, 1) : Cell2) = (1, gmul phi2 phi2) := by decide

/-- Los vértices de peso par: un tetraedro de la estrella de M12. -/
def T1 : Finset Cell2 := Finset.univ.filter (fun v : Cell2 => v.1 + v.2.1 + v.2.2 = 0)

/-- **El tetraedro par es un grupo de Klein, el otro tetraedro es su
    complemento, y `four2` los separa por el bit del eje.**  Dos vértices
    distintos de T1 difieren en un vector de peso 2 (suma cero y no nulo):
    son las aristas del tetraedro inscrito.  Los tres vértices no nulos de T1
    van a 1, φ, φ²; φ los recorre en ciclo y la conjugación fija 1 e
    intercambia φ y φ²: el S₃ de la celda es ⟨×φ, Frobenius de 2⟩. -/
theorem tetrahedra_are_klein_and_coset :
    T1.card = 4
    ∧ (∀ v ∈ T1, ∀ w ∈ T1, v + w ∈ T1)
    ∧ (∀ v : Cell2, v + v = 0)
    ∧ (∀ v ∈ T1, ∀ w ∈ T1, v ≠ w → v + w ≠ 0)
    ∧ (∀ v : Cell2, v ∉ T1 ↔ comp2 v ∈ T1)
    ∧ (∀ v : Cell2, v ∈ T1 ↔ (four2 v).1 = 0)
    ∧ four2 ((0, 1, 1) : Cell2) = (0, one2)
    ∧ four2 ((1, 0, 1) : Cell2) = (0, phi2)
    ∧ four2 ((1, 1, 0) : Cell2) = (0, gmul phi2 phi2)
    ∧ (gmul phi2 one2 = phi2 ∧ gmul phi2 phi2 = phi2 + one2
        ∧ gmul phi2 (gmul phi2 phi2) = one2)
    ∧ (gconj one2 = one2 ∧ gconj phi2 = gmul phi2 phi2
        ∧ gconj (gmul phi2 phi2) = phi2) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> decide

/-! ### (A) La cara global: nivel 60 -/

/-- Los tres caracteres de las tres retículas, leídos en ℤ/60.  Son los primitivos de
    conductor 4, 3 y 5: valen 0 solo donde el residuo no es unidad módulo su conductor
    (no fuera de las unidades módulo 60), y por eso χ₋₃(2) = χ₅(2) = −1. -/
def chiGauss (a : ZMod 60) : ℤ :=
  if a.val % 4 = 1 then 1 else if a.val % 4 = 3 then -1 else 0
def chiEis (a : ZMod 60) : ℤ :=
  if a.val % 3 = 1 then 1 else if a.val % 3 = 2 then -1 else 0
def chiGold (a : ZMod 60) : ℤ :=
  if a.val % 5 = 1 ∨ a.val % 5 = 4 then 1
  else if a.val % 5 = 2 ∨ a.val % 5 = 3 then -1 else 0

/-- **Las ocho combinaciones de signos (χ₋₄, χ₋₃, χ₅) aparecen**, cada una con
    un testigo que es unidad módulo 60: los tres caracteres son
    independientes.  En particular 41 da (+, −, +). -/
theorem eight_sign_patterns :
    ((1 : ZMod 60) * 1 = 1 ∧ chiGauss 1 = 1 ∧ chiEis 1 = 1 ∧ chiGold 1 = 1)
    ∧ ((13 : ZMod 60) * 37 = 1 ∧ chiGauss 13 = 1 ∧ chiEis 13 = 1 ∧ chiGold 13 = -1)
    ∧ ((41 : ZMod 60) * 41 = 1 ∧ chiGauss 41 = 1 ∧ chiEis 41 = -1 ∧ chiGold 41 = 1)
    ∧ ((17 : ZMod 60) * 53 = 1 ∧ chiGauss 17 = 1 ∧ chiEis 17 = -1 ∧ chiGold 17 = -1)
    ∧ ((19 : ZMod 60) * 19 = 1 ∧ chiGauss 19 = -1 ∧ chiEis 19 = 1 ∧ chiGold 19 = 1)
    ∧ ((7 : ZMod 60) * 43 = 1 ∧ chiGauss 7 = -1 ∧ chiEis 7 = 1 ∧ chiGold 7 = -1)
    ∧ ((11 : ZMod 60) * 11 = 1 ∧ chiGauss 11 = -1 ∧ chiEis 11 = -1 ∧ chiGold 11 = 1)
    ∧ ((23 : ZMod 60) * 47 = 1 ∧ chiGauss 23 = -1 ∧ chiEis 23 = -1 ∧ chiGold 23 = -1) := by
  decide

/-- **41 es el espejo puro de la tríada en el círculo de 60:** es una
    involución, fija el cuarto de vuelta (exponente 15, el i de Gauss) y el
    generador del pentágono (exponente 12, así que fija φ), e intercambia los
    dos exponentes de la tríada, 20 y 40. -/
theorem forty_one_is_the_pure_triad_mirror :
    (41 : ZMod 60) * 41 = 1
    ∧ (41 : ZMod 60) * 15 = 15 ∧ (41 : ZMod 60) * 12 = 12
    ∧ (41 : ZMod 60) * 20 = 40 ∧ (41 : ZMod 60) * 40 = 20 := by decide

/-- **Ninguna involución del círculo de 60 mueve φ:** si a² = 1 entonces
    χ₅(a) = +1.  Conjugar φ exige a ≡ ±2 (mód 5), de orden 4 en el
    pentágono. -/
theorem involutions_fix_phi : ∀ a : ZMod 60, a * a = 1 → chiGold a = 1 := by decide

/-- **En el primo 2 las dos caras se encuentran:** χ₋₃(2) = χ₅(2) = −1 (el 2
    es inerte en los dos, con el mismo cuerpo residual 𝔽₄) y χ₋₄ se anula (el
    2 ramifica en Gauss: es el vértice 4 = mcd(12, 20) del pushout). -/
theorem at_two_the_faces_meet :
    chiEis 2 = -1 ∧ chiGold 2 = -1 ∧ chiGauss 2 = 0 := by decide

/-! ### (B) La cara arquimediana -/

/-- **Un escalar real conmuta con toda la simetría de la tríada:** con la
    rotación (×ω), con el espejo (conjugar) y con la media vuelta (−1).  Con
    r = φ^{−λ} = ½ es el puente de la §24; con r = φ^σ es la torre de la §25. -/
theorem real_scalar_commutes_with_cell (r : ℝ) (ω z : ℂ) :
    (r : ℂ) * (ω * z) = ω * ((r : ℂ) * z)
    ∧ (r : ℂ) * (starRingEnd ℂ) z = (starRingEnd ℂ) ((r : ℂ) * z)
    ∧ (r : ℂ) * (-z) = -((r : ℂ) * z) := by
  refine ⟨by ring, ?_, by ring⟩
  simp [map_mul, Complex.conj_ofReal]

/-! ### Síntesis -/

/-- **Un solo marco.**  φ y el S₃ de la celda:
    (A) son independientes en el nivel 60, y el espejo puro de la tríada (41)
        fija φ, como toda involución;
    (B) conmutan en la cara arquimediana, donde φ es escalar (la torre) y el
        módulo de Ω̂;
    (C) coinciden en el lugar 2: la celda es 𝔽₂ × ℤ[φ]/2, la rotación es ×φ,
        el espejo es la conjugación de φ, la complementariedad es el bit del
        eje, y el pliegue φ² = φ + 1 es la relación de la tríada
        1 + φ + φ² = 0. -/
theorem one_framework_three_faces (ω : ℂ) (h3 : ω ^ 3 = 1) (h1 : 1 + ω + ω ^ 2 = 0) :
    -- (A)
    ((41 : ZMod 60) * 41 = 1 ∧ chiGauss 41 = 1 ∧ chiEis 41 = -1 ∧ chiGold 41 = 1)
    ∧ (∀ a : ZMod 60, a * a = 1 → chiGold a = 1)
    -- (B)
    ∧ (∀ a b c : ℝ, zc ω (phi * a) (phi * b) (phi * c) = (phi : ℂ) * zc ω a b c)
    ∧ (∀ v : ℝ × ℝ × ℝ, dilate (cellRot v) = cellRot (dilate v))
    ∧ (∀ (r : ℝ) (z : ℂ), (r : ℂ) * (ω * z) = ω * ((r : ℂ) * z))
    ∧ (∀ a b c : ℝ, zc ω c a b = ω * zc ω a b c)
    ∧ (∀ t : ℝ, zc ω t t t = 0)
    -- (C)
    ∧ (∀ x y : G2, gmul x y = emul x y)
    ∧ Function.Bijective four2
    ∧ (∀ v : Cell2, four2 (rot2 v) = ((four2 v).1, gmul phi2 (four2 v).2))
    ∧ (∀ v : Cell2, four2 (mir2 v) = ((four2 v).1, gconj (four2 v).2))
    ∧ (∀ v : Cell2, four2 (comp2 v) = ((four2 v).1 + 1, (four2 v).2))
    ∧ one2 + phi2 + gmul phi2 phi2 = 0
    ∧ (∀ y : ℝ, phi * (phi * y) = phi * y + y) :=
  ⟨eight_sign_patterns.2.2.1,
   involutions_fix_phi,
   fun a b c => (dilate_respects_fourier ω a b c).1,
   dilate_comm_rot,
   fun r z => (real_scalar_commutes_with_cell r ω z).1,
   zc_rotation ω h3,
   zc_axis_kernel ω h1,
   golden_eq_eisenstein_mod_two,
   four2_bijective,
   cell_is_golden_ring_mod_two.1,
   cell_is_golden_ring_mod_two.2.1,
   cell_is_golden_ring_mod_two.2.2.1,
   phi2_is_a_cube_root.2.2.2.2,
   fold_back_is_cell_recursion⟩

/- ═══════════════════════════════════════════════════════════════════════════
   §27  ENTRADAS DESCARGADAS (integración en F1Paper)
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- `CosPiFifth`: cos(π/5) = φ/2, desde `Real.cos_pi_div_five` de Mathlib. -/
theorem cosPiFifth_holds : CosPiFifth := by
  unfold CosPiFifth phi
  rw [Real.cos_pi_div_five]
  ring

/-- `ZetaNegOneInput`: ζ(−1) = −1/12, desde `riemannZeta_neg_nat_eq_bernoulli`. -/
theorem zetaNegOne_holds : ZetaNegOneInput := by
  unfold ZetaNegOneInput
  have h := riemannZeta_neg_nat_eq_bernoulli 1
  have hb : bernoulli 2 = 1 / 6 := by
    rw [bernoulli_eq_bernoulli'_of_ne_one (by norm_num), bernoulli'_two]
  simp only [Nat.cast_one] at h
  rw [h]
  norm_num [hb]

/-- ζ(−1) en el círculo, sin hipótesis. -/
theorem zeta_neg_one_on_circle' :
    riemannZeta (-1) = ((B2 (1 / 2) : ℚ) : ℂ)
    ∧ riemannZeta (-1) = ((-(B2 0) / 2 : ℚ) : ℂ) :=
  zeta_neg_one_on_circle zetaNegOne_holds

/-- φ^{n+1} = F_{n+1}·φ + F_n (Binet en forma entera). -/
theorem phi_pow_fib (n : ℕ) :
    phi ^ (n + 1) = (Nat.fib (n + 1) : ℝ) * phi + (Nat.fib n : ℝ) := by
  induction n with
  | zero => simp
  | succ k ih =>
    have hf : (Nat.fib (k + 2) : ℝ) = (Nat.fib k : ℝ) + (Nat.fib (k + 1) : ℝ) := by
      first | (rw [Nat.fib_add_two]; push_cast; ring) | (rw [Nat.fib_add_two]; push_cast)
    calc phi ^ (k + 1 + 1) = phi ^ (k + 1) * phi := pow_succ _ _
      _ = ((Nat.fib (k + 1) : ℝ) * phi + (Nat.fib k : ℝ)) * phi := by rw [ih]
      _ = (Nat.fib (k + 2) : ℝ) * phi + (Nat.fib (k + 1) : ℝ) := by
          rw [hf]; linear_combination (Nat.fib (k + 1) : ℝ) * phi_sq

/-- φ es irracional. -/
theorem phi_irrational : Irrational phi := by
  first
    | exact gold_irrational
    | exact Real.gold_irrational
    | (unfold phi; exact Real.goldenRatio_irrational)
    | exact Real.goldenRatio_irrational
    | (have h5 := Nat.Prime.irrational_sqrt (p := 5) (by norm_num)
       have h := (h5.rat_add 1).div_rat (q := 2) (by norm_num)
       unfold phi
       simpa using h)

/-- **λ = log_φ 2 es irracional, sin Gelfond–Schneider:** si λ = a/b, entonces
    φ^a = 2^b; pero φ^a = F_a·φ + F_{a−1} con F_a ≠ 0, que es irracional.
    Descarga la entrada `LambdaIrrational` (la trascendencia sigue siendo [C]). -/
theorem lambda_irrational : LambdaIrrational := by
  unfold LambdaIrrational
  rintro ⟨q, hq⟩
  have hpos : 0 < lam := div_pos (Real.log_pos (by norm_num)) (Real.log_pos one_lt_phi)
  have hq0' : (0 : ℝ) < q := by rw [hq]; exact hpos
  have hq0 : 0 < q := by exact_mod_cast hq0'
  have hqa : (q : ℝ) * (q.den : ℝ) = (q.num : ℝ) := by
    first
      | exact_mod_cast Rat.mul_den_eq_num q
      | (have h := congrArg (fun r : ℚ => (r : ℝ)) (Rat.mul_den_eq_num q)
         push_cast at h
         exact h)
  have key : phi ^ ((q.num : ℤ) : ℝ) = (2 : ℝ) ^ ((q.den : ℕ) : ℝ) := by
    rw [← hqa, Real.rpow_mul phi_pos.le, hq, phi_rpow_lam]
  have ha : 0 < q.num := Rat.num_pos.mpr hq0
  obtain ⟨n, hn⟩ : ∃ n : ℕ, q.num = (n : ℤ) + 1 := ⟨(q.num - 1).toNat, by omega⟩
  have key2 : phi ^ (n + 1) = (2 : ℝ) ^ q.den := by
    have hcast : ((q.num : ℤ) : ℝ) = ((n + 1 : ℕ) : ℝ) := by
      first | (rw [hn]; push_cast; ring) | (rw [hn]; push_cast) | (rw [hn]; norm_num)
    rw [hcast, Real.rpow_natCast, Real.rpow_natCast] at key
    exact key
  rw [phi_pow_fib n] at key2
  have hF : (Nat.fib (n + 1) : ℝ) ≠ 0 := by
    exact_mod_cast (Nat.fib_pos.mpr (Nat.succ_pos n)).ne'
  exact phi_irrational ⟨((2 : ℚ) ^ q.den - (Nat.fib n : ℚ)) / (Nat.fib (n + 1) : ℚ), by
    push_cast
    rw [div_eq_iff hF]
    first | linarith [key2] | linear_combination -key2 | linear_combination key2⟩

/-- El crecimiento sin desfase (§23), sin hipótesis. -/
theorem growth_without_drift' :
    (∀ (N m : ℕ) (c k : ZMod N),
        psi_mod N m (k + c) = psi_mod N m k + (m : ZMod N) * c)
    ∧ (∀ m : ZMod 12, m * 2 ∈ ({0, 2, 4, 6, 8, 10} : Finset (ZMod 12)))
    ∧ (∀ n m : ℕ, 12 ∣ n → Nat.Coprime m 6 → 12 ∣ n / Nat.gcd n m)
    ∧ (∀ t : ℕ, 0 < t → (1 / 2 : ℚ) ∈ Bnd (2 * t))
    ∧ B2 (1 / 2) = -1 / 12
    ∧ (∀ (N p : ℕ) (σ : ℝ) (k : ℤ),
        (phi ^ σ) ^ (p : ℝ) = phi ^ ((p : ℝ) * σ)
        ∧ eulerMap N ((p : ℤ) * k) = eulerMap N k ^ p
        ∧ 2 * phi ^ σ = phi ^ (σ + lam))
    ∧ (∀ σ : ℝ, Int.fract (σ + 1) = Int.fract σ)
    ∧ (∀ (N : ℕ) (k : ℤ), -lam ≠ (k : ℝ) / N)
    ∧ (∀ p : ℕ, (1 / 2 : ℝ) ^ p = 1 / (((2 ^ p - 1 : ℕ) : ℝ) + 1)) :=
  growth_without_drift lambda_irrational

/-- El ½ binario no es torsión, sin hipótesis. -/
theorem binary_half_not_torsion' (N : ℕ) (k : ℤ) : -lam ≠ (k : ℝ) / N :=
  binary_half_not_torsion lambda_irrational N k

/-- La estructura de Artin en el círculo, sin hipótesis. -/
theorem artin_is_circle_frobenius' :
    tr5 (1 * 2) = phi ∧ tr5 (4 * 2) = phi
    ∧ tr5 (2 * 2) = 1 - phi ∧ tr5 (3 * 2) = 1 - phi
    ∧ tr5 (0 * 2) = -2 :=
  artin_is_circle_frobenius cosPiFifth_holds


/- ═══════════════════════════════════════════════════════════════════════════
   §28  ISOMETRÍAS DEL FROBENIUS Y CIERRES DEL EMPALME
   (integración del 16 de octubre: TM1–TM3 y EM5 de la ontología).  [P*]
   · ψ_p conserva el círculo; una raíz de la unidad tiene norma 1 en todo
     cuerpo normado (ℂ y ℚ_p a la vez).
   · ψ_p con p coprimo con N es biyectivo y conserva Σ|f|² (reindexar una
     suma por una biyección).
   · M7 lleva la distancia cromática a la del círculo de quintas, y la de
     cuartas coincide con la de quintas.  La transposición x ↦ x + c y la
     inversión x ↦ −x son isometrías; entre las multiplicaciones, solo ±1
     (`units_isometric_twelve`).  ψ₇ es una involución (7² = 1 en ℤ/12).
   · En ℤ/5, multiplicar por u es isometría ⇔ fija el par de φ.
   · En ℤ/60, entre las unidades, fijar φ ⇔ ser involución.
   · φ^{n+1} nunca es racional; log_φ r es irracional para todo racional
     positivo r ≠ 1 (generaliza `lambda_irrational`); multiplicar por una
     magnitud x es trasladar log_φ por log_φ x.
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- **El mapa de Euler cae en el círculo.** -/
theorem eulerMap_norm (N : ℕ) (k : ℤ) : ‖eulerMap N k‖ = 1 := by
  unfold eulerMap
  rw [show 2 * (Real.pi : ℂ) * Complex.I * (k : ℂ) / (N : ℂ)
      = ((2 * Real.pi * k / N : ℝ) : ℂ) * Complex.I by push_cast; ring]
  exact Complex.norm_exp_ofReal_mul_I _

/-- **ψ_p conserva el círculo**, en sus dos lecturas (×p en el exponente y
    potencia p-ésima de la raíz). -/
theorem psi_preserves_circle (N p : ℕ) (k : ℤ) :
    ‖eulerMap N ((p : ℤ) * k)‖ = 1 ∧ ‖eulerMap N k ^ p‖ = 1 :=
  ⟨eulerMap_norm N _, by rw [norm_pow, eulerMap_norm, one_pow]⟩

/-- **Una raíz de la unidad tiene norma 1 en todo cuerpo normado:** en ℂ y en
    ℚ_p a la vez (el «en todos los primos» del texto). -/
theorem root_of_unity_norm_one {K : Type*} [NormedDivisionRing K]
    (μ : K) (N : ℕ) (hN : 0 < N) (h : μ ^ N = 1) : ‖μ‖ = 1 := by
  have h1 : ‖μ‖ ^ N = 1 := by rw [← norm_pow, h, norm_one]
  exact (pow_eq_one_iff_of_nonneg (norm_nonneg μ) hN.ne').mp h1

/-- **ψ_p con p coprimo con N es una biyección de ℤ/N.** -/
theorem psi_mod_bijective (N p : ℕ) (hp : Nat.Coprime p N) :
    Function.Bijective (psi_mod N p) := by
  have h : psi_mod N p = ⇑(Units.mulLeft (ZMod.unitOfCoprime p hp)) := by
    funext a
    simp [psi_mod, Units.mulLeft_apply, ZMod.coe_unitOfCoprime]
  rw [h]
  exact (Units.mulLeft _).bijective

/-- **ψ_p conserva la energía de una función de clase:** Σ|f∘ψ_p|² = Σ|f|².
    Es reindexar la suma por una biyección; no es el Parseval de las tablas
    de caracteres. -/
theorem psi_preserves_energy (N p : ℕ) [NeZero N] (hp : Nat.Coprime p N)
    (f : ZMod N → ℂ) :
    ∑ a, ‖f (psi_mod N p a)‖ ^ 2 = ∑ a, ‖f a‖ ^ 2 :=
  (psi_mod_bijective N p hp).sum_comp (fun a => ‖f a‖ ^ 2)

/-- La distancia en el círculo de quintas: la posición de x en ese círculo es
    7⁻¹·x = 7·x (7² = 1 en ℤ/12). -/
def dFifths (j k : ZMod 12) : ℕ := dIdx (7 * j) (7 * k)

/-- **M7 lleva la distancia cromática a la del círculo de quintas.** -/
theorem M7_chromatic_to_fifths (j k : ZMod 12) :
    dFifths (psi_mod 12 7 j) (psi_mod 12 7 k) = dIdx j k := by
  revert j k; decide

/-- **La distancia de cuartas es la de quintas** (5 = −7 en ℤ/12). -/
theorem fourths_eq_fifths (j k : ZMod 12) :
    dIdx (5 * j) (5 * k) = dFifths j k := by
  revert j k; decide

/-- **ψ₇ es una involución:** apilar quintas es k ↦ k + 7n, no iterar ψ₇. -/
theorem psi_seven_involution : ((7 : ZMod 12) * 7 = 1) := by decide

/-- **En el pentágono, la isometría es φ:** multiplicar por u ≠ 0 en ℤ/5
    conserva la distancia del círculo si y solo si fija el par de φ. -/
theorem pentagon_isometry_iff_fixes_phi :
    ∀ u : ZMod 5, u ≠ 0 →
      ((∀ j k : ZMod 5, dIdx (u * j) (u * k) = dIdx j k)
        ↔ pairOf (u * 2) = pairOf 2) := by
  decide

/-- **En el nivel 60, fijar φ es ser involución:** entre las unidades de ℤ/60,
    χ₅(a) = 1 si y solo si a² = 1.  Una dirección es `involutions_fix_phi`. -/
theorem fix_phi_iff_involution :
    ∀ a : ZMod 60, (∃ b, a * b = 1) →
      (chiGold a = 1 ↔ a * a = 1) := by
  decide

/-- **φ^{n+1} nunca es racional.** -/
theorem phi_pow_ne_rat (n : ℕ) (r : ℚ) : phi ^ (n + 1) ≠ (r : ℝ) := by
  intro h
  rw [phi_pow_fib n] at h
  have hF : (Nat.fib (n + 1) : ℝ) ≠ 0 := by
    exact_mod_cast (Nat.fib_pos.mpr (Nat.succ_pos n)).ne'
  exact phi_irrational
    ⟨(r - Nat.fib n) / Nat.fib (n + 1), by
      push_cast
      rw [div_eq_iff hF]
      linarith [h]⟩

/-- **log_φ r es irracional para todo racional positivo r ≠ 1.**  Generaliza
    `lambda_irrational` (r = 2) y da la irracionalidad «para todo p» que
    `prop:two-coords` marca [T]. -/
theorem logphi_rat_irrational (r : ℚ) (hr : 0 < r) (h1 : r ≠ 1) :
    Irrational (Real.log r / Real.log phi) := by
  rintro ⟨q, hq⟩
  have hrR : (0 : ℝ) < r := by exact_mod_cast hr
  have hcancel : Real.log phi * (Real.log r / Real.log phi) = Real.log r := by
    first
      | (rw [mul_comm]; exact div_mul_cancel₀ _ log_phi_ne_zero)
      | (field_simp [log_phi_ne_zero])
  have hpow : phi ^ (q : ℝ) = r := by
    rw [hq, Real.rpow_def_of_pos phi_pos, hcancel]
    exact Real.exp_log hrR
  have hqa : (q : ℝ) * (q.den : ℝ) = (q.num : ℝ) := by
    first
      | exact_mod_cast Rat.mul_den_eq_num q
      | (have h := congrArg (fun x : ℚ => (x : ℝ)) (Rat.mul_den_eq_num q)
         push_cast at h
         exact h)
  have key : phi ^ ((q.num : ℤ) : ℝ) = ((r ^ q.den : ℚ) : ℝ) := by
    rw [← hqa, Real.rpow_mul phi_pos.le, hpow, Real.rpow_natCast]
    first | (push_cast; ring) | push_cast | simp
  rcases lt_trichotomy q.num 0 with hneg | hzero | hpos
  · obtain ⟨n, hn⟩ : ∃ n : ℕ, q.num = -((n : ℤ) + 1) :=
      ⟨(-q.num - 1).toNat, by omega⟩
    have e : ((q.num : ℤ) : ℝ) = -((n + 1 : ℕ) : ℝ) := by
      rw [hn]; first | (push_cast; ring) | push_cast
    rw [e, Real.rpow_neg phi_pos.le, Real.rpow_natCast] at key
    apply phi_pow_ne_rat n ((r ^ q.den)⁻¹)
    rw [Rat.cast_inv, ← key, inv_inv]
  · have hq0 : q = 0 := by
      first
        | exact Rat.zero_iff_num_zero.mpr hzero
        | exact Rat.num_eq_zero.mp hzero
    apply h1
    have : (r : ℝ) = 1 := by rw [← hpow, hq0]; simp
    exact_mod_cast this
  · obtain ⟨n, hn⟩ : ∃ n : ℕ, q.num = (n : ℤ) + 1 :=
      ⟨(q.num - 1).toNat, by omega⟩
    have e : ((q.num : ℤ) : ℝ) = ((n + 1 : ℕ) : ℝ) := by
      rw [hn]; first | (push_cast; ring) | push_cast
    rw [e, Real.rpow_natCast] at key
    exact phi_pow_ne_rat n _ key

/-- **Multiplicar por una magnitud es trasladar en log_φ:** x·φ^σ =
    φ^{σ + log_φ x}.  Generaliza `two_mul_is_shift`. -/
theorem mul_is_shift (x : ℝ) (hx : 0 < x) (σ : ℝ) :
    x * phi ^ σ = phi ^ (σ + Real.log x / Real.log phi) := by
  have hcancel : Real.log phi * (Real.log x / Real.log phi) = Real.log x := by
    first
      | (rw [mul_comm]; exact div_mul_cancel₀ _ log_phi_ne_zero)
      | (field_simp [log_phi_ne_zero])
  rw [Real.rpow_add phi_pos, mul_comm]
  congr 1
  rw [Real.rpow_def_of_pos phi_pos, hcancel]
  exact (Real.exp_log hx).symm

end

