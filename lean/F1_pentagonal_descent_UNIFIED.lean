/-! ## §102.1  La torre vale para cualquier base -/

/-- **[P] `b^{−log_b 2} = 1/2` PARA TODA `b > 1`.**  El `1/2` de la
    ruta de la torre es una propiedad del logaritmo; `φ` no
    interviene.

    (Se enuncia en la forma equivalente sin `rpow`:
    `log b · λ_b = log 2`, que es la definición de `λ_b`.) -/
theorem tower_route_works_for_any_base (b : ℝ) (hb : 1 < b) :
    Real.log b * (Real.log 2 / Real.log b) = Real.log 2 := by
  have hlog : Real.log b ≠ 0 := by
    have : 0 < Real.log b := Real.log_pos hb
    exact ne_of_gt this
  field_simp

/-- **[P] Y NO SELECCIONA NINGUNA BASE.**  Dos bases cualesquiera
    `> 1` dan lo mismo: la ruta no distingue `φ` de `2`, `3`, `π`
    o `e`. -/
theorem tower_route_does_not_select (b c : ℝ) (hb : 1 < b) (hc : 1 < c) :
    Real.log b * (Real.log 2 / Real.log b)
      = Real.log c * (Real.log 2 / Real.log c) := by
  rw [tower_route_works_for_any_base b hb, tower_route_works_for_any_base c hc]

/-! ## §102.2  El radio caracteriza a `φ` -/

/-- **[P] `(b − 1/b)/2 = 1/2 ⟺ b² − b − 1 = 0`.**  Para `b > 0`. -/
theorem radius_route_iff_golden_polynomial (b : ℝ) (hb : 0 < b) :
    (b - 1 / b) / 2 = 1 / 2 ↔ b ^ 2 - b - 1 = 0 := by
  have hne : b ≠ 0 := ne_of_gt hb
  constructor
  · intro h
    have h1 : b - 1 / b = 1 := by linarith
    field_simp at h1
    nlinarith [h1]
  · intro h
    have h1 : b - 1 / b = 1 := by
      field_simp
      nlinarith [h]
    rw [h1]

/-- **[P] Y SU ÚNICA RAÍZ POSITIVA ES `φ`.**  Si `b > 0` cumple
    `b² − b − 1 = 0`, entonces `b = φ`.

    **Luego la ruta 7 selecciona `φ` unívocamente.** -/
theorem radius_route_characterises_phi (b : ℝ) (hb : 0 < b)
    (h : b ^ 2 - b - 1 = 0) : b = φ := by
  have hphi : (φ : ℝ) ^ 2 - φ - 1 = 0 := by
    have := phi_sq; linarith
  have hpos : (0 : ℝ) < φ := lt_trans one_pos φ_gt_one
  have hfac : (b - φ) * (b + φ - 1) = 0 := by nlinarith [h, hphi]
  rcases mul_eq_zero.mp hfac with h1 | h1
  · linarith
  · exfalso
    have h2 : (1 : ℝ) < φ := φ_gt_one
    linarith

/-- **[P] LA CARACTERIZACIÓN, EN UNA LÍNEA.**  Para `b > 0`:
    la ruta del radio da `1/2` si y sólo si `b = φ`. -/
theorem radius_route_iff_phi (b : ℝ) (hb : 0 < b) :
    (b - 1 / b) / 2 = 1 / 2 ↔ b = φ := by
  constructor
  · intro h
    exact radius_route_characterises_phi b hb
      ((radius_route_iff_golden_polynomial b hb).mp h)
  · intro h
    subst h
    exact seventh_route

/-! ## §102.3  La independencia, enunciada correctamente -/

/-- **[O] LA INDEPENDENCIA REAL.**

    | ruta | vale para | qué selecciona |
    |---|---|---|
    | 1 torre | TODA `b > 1` | nada --- es del `log` |
    | 7 radio | SÓLO `b = φ` | `φ`, unívocamente |

    **No es que compartan pocos ingredientes: la 1 no usa `φ` y la 7
    lo caracteriza.**  Es más fuerte que el criterio de
    `half_on_both_faces`, y demostrable. -/
theorem the_independence_demonstrated (b c : ℝ) (hb : 1 < b) (hc : 1 < c) :
    (Real.log b * (Real.log 2 / Real.log b)
       = Real.log c * (Real.log 2 / Real.log c)) ∧
    ((b - 1 / b) / 2 = 1 / 2 ↔ b = φ) :=
  ⟨tower_route_does_not_select b c hb hc,
   radius_route_iff_phi b (lt_trans one_pos hb)⟩

/-- **[O] EL BALANCE DE §102.**

    | | §101 | §102 |
    |---|---|---|
    | independencia | `ck(True)` --- no verificaba | **`[P]`, y más fuerte** |
    | ruta 1 | «usa `log` y el `2`» | **no usa `φ` en absoluto** |
    | ruta 7 | «usa sólo `φ²=φ+1`» | **caracteriza `φ`** |

    **Nada de esto prueba `E`.**  Lo que hace es que la séptima ruta
    cuente como ruta, con demostración y no con una afirmación. -/
theorem the_balance_of_section_102 (b : ℝ) (hb : 0 < b) :
    ((b - 1 / b) / 2 = 1 / 2 ↔ b = φ) ∧
    (((φ : ℝ) - 1 / φ) / 2 = 1 / 2) :=
  ⟨radius_route_iff_phi b hb, seventh_route⟩

