    (α₀ = 59 / 40) ∧ (β₀ = 1 / 8) ∧
    (σ_PCF + μ_PCF = 2) :=
  ⟨c_gt_two hn, rfl, rfl, rfl, rfl, sigma_plus_mu⟩

