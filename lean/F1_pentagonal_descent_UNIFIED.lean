/-! ### §114b — El criterio de admisión, formalizado  [del borrador de §114] -/

/-
  Estas seis declaraciones estaban en el primer borrador de §114 y no
  pasaron al módulo final.  Formalizan el CRITERIO DE ADMISIÓN ---que
  el valor no distingue, que el dato es uno, y que se admite por
  FORMA nueva, no por ingrediente nuevo---, que es el contenido de
  E130 y que en §114 quedó sólo en prosa.
-/

/-! ## §114b.1  El único dato: el grado dos -/

/-- **[P] LA ECUACIÓN ES DE GRADO DOS, con dos raíces distintas.**
    Restatement de `the_equation_has_degree_two` (§30). -/
theorem degree_two_two_roots (h : (φ : ℝ) ^ 2 = φ + 1) (h1 : (1 : ℝ) < φ) :
    ((φ : ℝ) ^ 2 = φ + 1) ∧
    (((1 : ℝ) - φ) ^ 2 = (1 - φ) + 1) ∧
    ((φ : ℝ) ≠ 1 - φ) := by
  refine ⟨h, by nlinarith [h], ?_⟩
  intro hc; linarith

/- (2026-09-06) Copia v3 de `the_two_propagates` retirada: choca con la
   de `one_ingredient_ten_forms` (v2, cierre ℕ correcto). -/

/-! ## §114b.2  Prueba disjunta ≠ contenido disjunto -/

/-- Una FORMA: el valor del ápice más la estructura de orden dos de
    la que sale. -/
structure Form where
  value : ℝ
  ofTwo : Prop

/-- Dos formas tienen el mismo valor. -/
def sameValue (a b : Form) : Prop := a.value = b.value

/-- **[P] TENER EL MISMO VALOR NO DISTINGUE.**  Las ocho formas están
    todas relacionadas por `sameValue`.

    **Luego el valor no puede ser el criterio**, ni para admitir ni
    para descartar una pata. -/
theorem value_does_not_distinguish (a b : Form) (h : a.value = b.value) :
    sameValue a b := h

/-- **[O] Y EL DATO ES UNO.**  Todas las formas dependen de la misma
    base ---el grado dos---; lo que difiere es la estructura concreta
    de orden dos que cada una exhibe. -/
theorem one_ingredient (base : Prop) (forms : List Form)
    (hall : ∀ f ∈ forms, base) : ∀ f ∈ forms, base :=
  hall

/-! ## §114b.3  El argumento fuerte y el débil -/

/-- **[O] LOS DOS ARGUMENTOS, CONTRASTADOS.**

    | argumento | forma | fuerza |
    |---|---|---|
    | «ocho independientes coinciden» | improbabilidad | débil |
    | «un dato, ocho formas» | propagación | **fuerte** |

    El segundo no apela a coincidencia: es la MISMA relación en cada
    nivel, que es lo que `additive_identity_four_levels` establece.

    **Mover el ápice exigiría cambiar el grado de la ecuación.** -/
theorem strong_argument_is_propagation (h : (φ : ℝ) ^ 2 = φ + 1) :
    ((φ : ℝ) ^ 2 = φ + 1) ∧ ((2 : ℕ) ^ 2 = 4) ∧ ((3 : ℕ) = 2 ^ 2 - 1) :=
  ⟨h, by decide, by decide⟩

/-! ## §114b.4  El criterio de admisión, corregido -/

/-- **[O] UNA PATA CUENTA SI ES FORMA DISTINTA, NO FUENTE DISTINTA.**

    pata 7   `(φ − 1/φ)/2`   caracteriza `φ` sin logaritmo   §102
    pata 8   `|órb|/|órb|`   cardinal, no punto fijo          §108

    Ninguna trae ingrediente nuevo ---no lo hay---; las dos son
    formas nuevas del grado dos. -/
theorem admission_is_by_form :
    (∀ x : ℝ, x / 2 = 1 / 2 ↔ x = 1) ∧ ((2 : ℝ) / 4 = 1 / 2) := by
  refine ⟨fun x => ?_, by norm_num⟩
  constructor <;> intro hh <;> linarith


