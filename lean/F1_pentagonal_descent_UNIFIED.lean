/-! ## 1.  La forma, en el argumento de la irracionalidad -/

/-- `N(a, −b) = a² − a·b − b²`. -/
theorem normFormMul_neg_snd (a b : Int) :
    normFormMul a (-b) = a * a - a * b - b * b := by
  unfold normFormMul
  have h1 : a * -b = -(a * b) := Int.mul_neg a b
  have h2 : (-b) * (-b) = b * b := Int.neg_mul_neg b b
  rw [h1, h2]
  omega

/-- **[P] LA IRRACIONALIDAD DE φ ES UN VALOR DE LA FORMA.**  «Ningún `m/f`
    resuelve `x² = x + 1`» es exactamente «`N(m, −f) ≠ 0` para `f > 0`».
    No es una analogía: es la misma expresión. -/
theorem irrationality_is_the_form_at_neg (m f : Nat) (hf : 0 < f) :
    normFormMul (m : Int) (-(f : Int)) ≠ 0 := by
  intro h
  rcases normFormMul_eq_zero h with ⟨_, h2⟩
  omega

/-- **[P] Y SE RECUPERA EL ENUNCIADO EN ℕ DESDE LA FORMA.**  La ida y la
    vuelta entre las dos escrituras, sin pasar por el descenso otra vez.

    (Presentación, no prueba independiente: `normFormMul_eq_zero` usa
    `no_golden_rational` por dentro.  El hecho único sigue siendo el descenso
    en ℕ; lo demás es transporte.) -/
theorem golden_from_the_form (m f : Nat) (hf : 0 < f) :
    m * m ≠ m * f + f * f := by
  intro h
  apply irrationality_is_the_form_at_neg m f hf
  rw [normFormMul_neg_snd]
  have hc : ((m * m : Nat) : Int) = ((m * f + f * f : Nat) : Int) := by
    exact congrArg (fun k : Nat => (k : Int)) h
  push_cast at hc
  omega

/-! ## 2.  La forma, en el argumento de la aperiodicidad -/

/-- **[P] EL DETERMINANTE QUE DECIDE LA PERIODICIDAD ES LA MISMA FORMA.**
    `det(Mⁿ − I) = N(qₙ − 1, pₙ)`.  (Es `det_npow_sub_one`; se reexpone aquí
    porque es la segunda evaluación.) -/
theorem aperiodicity_is_the_form_at_coef (n : Nat) :
    Mat2.det (Mat2.sub (Mat2.npow M n) Mat2.one)
      = normFormMul ((coef n).2 - 1) (coef n).1 :=
  det_npow_sub_one n

/-- **[P] LA VUELTA, CON CONTENIDO.**  Si alguna frecuencia no nula fuera
    periódica, la forma tendría un cero no trivial.

    Esto es lo que faltaba para que el nombre `blindness_is_irrationality`
    diga algo: no la implicación entre dos teoremas —que es vacía— sino la
    construcción bajo hipótesis. -/
theorem a_periodic_frequency_would_zero_the_form
    (n : Nat) (hn : 0 < n) (v : Zphi) (hv : v ≠ (0, 0))
    (h : act (Mat2.npow M n) v = v) :
    normFormMul ((coef n).2 - 1) (coef n).1 = 0 ∧ 1 ≤ (coef n).1 := by
  have hz : act (Mat2.sub (Mat2.npow M n) Mat2.one) v = (0, 0) := by
    obtain ⟨x, y⟩ := v
    simp [act, Mat2.sub, Mat2.one, Int.sub_mul, Prod.mk.injEq] at h ⊢
    refine ⟨?_, ?_⟩ <;> omega
  obtain ⟨c1, c2⟩ := det_smul_of_act_zero _ v hz
  have hdet : Mat2.det (Mat2.sub (Mat2.npow M n) Mat2.one) = 0 := by
    obtain ⟨x, y⟩ := v
    simp [Prod.mk.injEq] at hv c1 c2
    rcases c1 with h1 | h1
    · exact h1
    · rcases c2 with h2 | h2
      · exact h2
      · exact absurd h2 (hv h1)
  refine ⟨?_, (coef_pos n hn).1⟩
  rw [← aperiodicity_is_the_form_at_coef n]
  exact hdet

/-! ## 3.  El hecho único -/

/-- **[P⊕] UN SOLO HECHO, DOS EVALUACIONES.**

    (a) `N(m, −f) = m² − m·f − f²`: la forma en el argumento racional;
    (b) `N(m, −f) ≠ 0` para `f > 0`: eso ES la irracionalidad de φ, y de ella
        se recupera el enunciado en ℕ;
    (c) `det(Mⁿ − I) = N(qₙ − 1, pₙ)`: la forma en el argumento dinámico;
    (d) si alguna frecuencia no nula fuera periódica, ese valor sería `0` con
        `pₙ ≥ 1`, luego un cero no trivial de `N`;
    (e) y `N` sólo representa `0` trivialmente.

    Luego la aperiodicidad de toda frecuencia y la irracionalidad de φ no son
    dos hechos que coincidan: son **`N` evaluada en dos sitios**, y la única
    imposibilidad de fondo es que `N` no representa `0` fuera del origen.

    ALCANCE, y es estrecho.  Esto vale para la ceguera en el sentido de
    `no_periodic_frequency` —ninguna frecuencia es periódica—.  **No** vale
    para `thm:blind`, la ceguera de cubierta: ésa sale del torsor `ℤ/6` y de
    `Hom(μ₆, ℤ) = 0` (`PCF_not_absorbable.lean`), que es torsión contra libre
    de torsión y no usa φ para nada.  Son dos cegueras con causas distintas,
    en dos lugares distintos del mismo anillo. -/
theorem the_one_form_two_places :
    (∀ a b : Int, normFormMul a (-b) = a * a - a * b - b * b) ∧
    (∀ m f : Nat, 0 < f → normFormMul (m : Int) (-(f : Int)) ≠ 0) ∧
    (∀ m f : Nat, 0 < f → m * m ≠ m * f + f * f) ∧
    (∀ n : Nat, Mat2.det (Mat2.sub (Mat2.npow M n) Mat2.one)
        = normFormMul ((coef n).2 - 1) (coef n).1) ∧
    (∀ n : Nat, 0 < n → ∀ v : Zphi, v ≠ (0, 0) →
        act (Mat2.npow M n) v = v →
        normFormMul ((coef n).2 - 1) (coef n).1 = 0 ∧ 1 ≤ (coef n).1) ∧
    (∀ a b : Int, normFormMul a b = 0 → a = 0 ∧ b = 0) :=
  ⟨normFormMul_neg_snd, irrationality_is_the_form_at_neg, golden_from_the_form,
   aperiodicity_is_the_form_at_coef, a_periodic_frequency_would_zero_the_form,
   fun _ _ h => normFormMul_eq_zero h⟩



