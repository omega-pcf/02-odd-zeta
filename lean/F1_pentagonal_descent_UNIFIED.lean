-- BLOCK 23. F1PaperHyp
-- the forms of the open statement, connected to the corpus
-- ════════════════════════════════════════════════════════════════════════════

section Block23
/-
  F1Paper/Hypotheses.lean — las formas del enunciado abierto, conectadas al corpus (la conjetura de cierre está en Closure.lean)
  ════════════════════════════════════════════════════════════════════════

  Borrador SIN COMPILAR.  Importa el corpus y usa SUS definiciones: no
  redefine lo que el corpus ya tiene.  Tres partes:

    §1  La acción de potencias (hipótesis A).  El corpus ya tiene la forma
        existencial (`ZeroCoordsCarryPowerAction`) y ya prueba que, con la
        altura mínima de los ceros, equivale a la línea.  Lo nuevo aquí es la
        forma con índice —el Frobenius sobre el índice del operador— y el
        puente que la lleva a la forma del corpus.
    §2  La fluctuación.  El corpus define la ley de conteo `N = env + S`.
        Lo nuevo es la identidad exacta `t n = Einv (n − S n)`, la partición
        del error de un operador en fluctuación + parametrización, y que la
        fluctuación no la lleva ningún operador que dependa solo del índice.
    §3  Lo abierto, como proposiciones con nombre, sin prueba.
-/

noncomputable section
open Real

namespace F1PaperHyp

open F1PCFUnified

/-! ## §1  La acción de potencias: forma con índice y puente al corpus -/

/-- Una enumeración de los ceros por índice (en la construcción, por altura
    creciente).  Se pide sobreyectiva: todo cero tiene un índice. -/
structure ZeroEnumeration where
  z : ℕ → Chi5Zero
  surj : Function.Surjective z

/-- **Hipótesis A, forma con índice.**  El Frobenius sobre el índice del
    operador (`n ↦ p·n`, la acción `U_p : e_n ↦ e_{pn}` del espacio de los
    primones) eleva la coordenada a la potencia `p`. -/
def HypAIndex (E : ZeroEnumeration) : Prop :=
  ∀ p n : ℕ, p.Prime → zeroCoord (E.z (p * n)).ρ = (zeroCoord (E.z n).ρ) ^ p

/-- **[P*] Puente:** la forma con índice da la forma existencial del corpus. -/
theorem hypAIndex_gives_corpus_action (E : ZeroEnumeration) (hA : HypAIndex E) :
    ZeroCoordsCarryPowerAction := by
  intro p hp z
  obtain ⟨n, hn⟩ := E.surj z
  exact ⟨E.z (p * n), by rw [hA p n hp, hn]⟩

/-- **[P*] Hipótesis A (forma con índice) ⟹ la línea**, con la única entrada
    clásica de la altura mínima de los ceros.  El paso de la acción a la
    línea es del corpus. -/
theorem hypAIndex_gives_line (E : ZeroEnumeration) (hA : HypAIndex E)
    (h : NoLowZeros) (z : Chi5Zero) : z.ρ.re = 1 / 2 :=
  B_gives_E_one_hypothesis h (hypAIndex_gives_corpus_action E hA) z

/-- **[P*] Por qué la acción tiene que ser de orden infinito** (del corpus):
    una operación de orden finito `n ≥ 2` sobre una coordenada `r ≠ 1` no
    puede devolverla (`rⁿ = r` fuerza `n = 1`).  La inversión, de orden dos,
    que sí está probada sobre los ceros, no basta para cerrar. -/
theorem finite_order_cannot_close (r : ℝ) (hr : 0 < r) (n : ℕ) (hn : 2 ≤ n)
    (hne : r ≠ 1) : r ^ n ≠ r := by
  intro h
  have := finite_orbit_does_not_escape r hr n (by omega) h hne
  omega

/-! ## §2  La fluctuación, sobre la ley de conteo del corpus -/

/-- Una envolvente con inversa exacta. -/
structure EnvelopeInv where
  env : ℝ → ℝ
  Einv : ℝ → ℝ
  right_inv : ∀ T, Einv (env T) = T

/-- **[P*] La altura de un cero es la envolvente invertida en `n − S(tₙ)`.**
    Hipótesis: la ley de conteo del corpus `N = env + S`, y que el conteo
    exacto en la altura `tₙ` del cero número `n` es `n`. -/
theorem height_from_envelope (N S : ℝ → ℝ) (E : EnvelopeInv)
    (hlaw : CountingLaw N E.env S) (t : ℕ → ℝ) (ht : ∀ n, 0 < t n)
    (hcount : ∀ n, N (t n) = n) (n : ℕ) :
    t n = E.Einv ((n : ℝ) - S (t n)) := by
  have h := hlaw (t n) (ht n)
  rw [hcount n] at h
  have : (n : ℝ) - S (t n) = E.env (t n) := by linarith
  rw [this, E.right_inv]

/-- **[P*] Partición exacta del error de cualquier operador `T`:**
    `tₙ − T n = [Einv(n − S) − Einv n] + [Einv n − T n]`. -/
theorem error_decomposition (N S : ℝ → ℝ) (E : EnvelopeInv)
    (hlaw : CountingLaw N E.env S) (t : ℕ → ℝ) (ht : ∀ n, 0 < t n)
    (hcount : ∀ n, N (t n) = n) (T : ℕ → ℝ) (n : ℕ) :
    t n - T n
      = (E.Einv ((n : ℝ) - S (t n)) - E.Einv n) + (E.Einv n - T n) := by
  rw [← height_from_envelope N S E hlaw t ht hcount n]; ring

/-- **[P*] Lo removible:** con `T = Einv` el error es solo la fluctuación. -/
theorem parametrisation_removable (N S : ℝ → ℝ) (E : EnvelopeInv)
    (hlaw : CountingLaw N E.env S) (t : ℕ → ℝ) (ht : ∀ n, 0 < t n)
    (hcount : ∀ n, N (t n) = n) (n : ℕ) :
    t n - E.Einv n = E.Einv ((n : ℝ) - S (t n)) - E.Einv n := by
  rw [← height_from_envelope N S E hlaw t ht hcount n]

/-- **[P*] Lo no removible:** dos sucesiones de alturas distintas en `n` no
    pueden ser acertadas a la vez por ninguna función del índice.  (Con la
    misma envolvente, distintas alturas son distintas fluctuaciones.) -/
theorem no_index_operator_fits_both (t t' : ℕ → ℝ) (n : ℕ) (hne : t n ≠ t' n)
    (T : ℕ → ℝ) (hT : T n = t n) : T n ≠ t' n := by
  intro h; exact hne (hT ▸ h)

/-! ## §3  Lo abierto, con nombre (sin prueba) -/

/-- **[O] La fluctuación es información de la fibra.**  Dada una codificación
    de cada cero `n` en un punto del recubrimiento de grado seis —nivel
    `lev n` y punto de la fibra `fib n`—, la fluctuación es función del par
    (nivel, fibra) y **no** del nivel solo.  El corpus prueba el lado de la
    fibra (las funciones invariantes por el deck son funciones del nivel; el
    carácter trivial es ciego; los otros cinco separan la fibra).  Lo que no
    existe es la codificación `lev, fib` de los ceros. -/
def FluctuationIsFibreData (lev : ℕ → ℕ) (fib : ℕ → Fin 6) (S : ℕ → ℝ) : Prop :=
  (∃ F : ℕ → Fin 6 → ℝ, ∀ n, S n = F (lev n) (fib n))
  ∧ ¬ (∃ G : ℕ → ℝ, ∀ n, S n = G (lev n))

/-- **[O] Separación (hipótesis B-(iii)), para los ceros de χ₅.**  La parte
    real de cada cero es función de datos estructurales `σ` (clases, nivel)
    y no depende de la fluctuación.  El corpus no define ninguna familia de
    sistemas comparables en la que esto pueda enunciarse; por eso queda
    parametrizado por los datos `σ`. -/
def RealPartIsStructural {α : Type*} (σ : ℕ → α) (E : ZeroEnumeration) : Prop :=
  ∃ F : α → ℝ, ∀ n, (E.z n).ρ.re = F (σ n)

end F1PaperHyp

end
end Block23

