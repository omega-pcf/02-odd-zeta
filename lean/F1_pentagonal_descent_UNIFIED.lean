/-! ## §1.1 The golden ratio φ -/

/-- The golden ratio φ = (1 + √5)/2. -/
def φ : ℝ := (1 + Real.sqrt 5) / 2

/-- φ is positive. -/
theorem φ_pos : 0 < φ := by
  unfold φ
  have h5 : 0 ≤ Real.sqrt 5 := Real.sqrt_nonneg 5
  linarith

theorem φ_ne_zero : φ ≠ 0 := ne_of_gt φ_pos

/-- φ > 1.  Since √5 > 2, φ = (1 + √5)/2 > (1 + 2)/2 = 3/2 > 1. -/
theorem φ_gt_one : 1 < φ := by
  unfold φ
  have h5 : 2 < Real.sqrt 5 := by
    have h_sq : (2:ℝ)^2 < 5 := by norm_num
    have := Real.sqrt_lt_sqrt (by norm_num : (0:ℝ) ≤ 4)
              (by norm_num : (4:ℝ) < 5)
    rw [show (4:ℝ) = 2^2 from by norm_num,
        Real.sqrt_sq (by norm_num : (0:ℝ) ≤ 2)] at this
    exact this
  linarith

/-- THEOREM (formerly axiom `phi_sq`): φ² = φ + 1.

    Proved from the definition φ = (1 + √5)/2 by direct calculation:
    expand the square, use Real.sq_sqrt (√5)² = 5, and finish with
    nlinarith.  This is no longer an axiom. -/
theorem phi_sq : φ ^ 2 = φ + 1 := by
  unfold φ
  have h5 : Real.sqrt 5 ^ 2 = 5 :=
    Real.sq_sqrt (by norm_num : (5:ℝ) ≥ 0)
  nlinarith [h5]

/-- Equivalent form: φ² - φ - 1 = 0. -/
theorem phi_quadratic : φ ^ 2 - φ - 1 = 0 := by
  rw [phi_sq]; ring

/-! ## §1.2 The reciprocal identity 1/φ = φ - 1
    (paper: lem:phi-cf, continued-fraction self-reference.) -/

/-- The reciprocal identity: 1/φ = φ - 1. -/
theorem phi_reciprocal : (1 : ℝ) / φ = φ - 1 := by
  rw [div_eq_iff φ_ne_zero]
  have := phi_sq
  linarith

/-- Paper lem:phi-cf (continued-fraction self-reference): φ = 1 + 1/φ. -/
theorem φ_self_ref : φ = 1 + 1 / φ := by
  rw [phi_reciprocal]; ring

/-! ## §1.3 The nested-radical identity (paper: lem:phi-nr) -/

/-- Paper lem:phi-nr (nested-radical self-reference): φ = √(1+φ). -/
theorem φ_nested_ref : φ = Real.sqrt (1 + φ) := by
  have h_phi_sq : φ ^ 2 = 1 + φ := by linarith [phi_sq]
  rw [← h_phi_sq, Real.sqrt_sq (le_of_lt φ_pos)]

/-! ## §1.4 Uniqueness of the positive fixed point (paper: prop:golden-unique) -/

/-- Paper prop:golden-unique (golden fixed-point uniqueness): for x > 0,
    x² = x + 1 implies x = φ. -/
theorem golden_fixed_point_unique (x : ℝ) (hx : 0 < x) (heq : x ^ 2 = x + 1) :
    x = φ := by
  have h1 : (x - φ) * (x + φ - 1) = 0 := by nlinarith [phi_sq]
  rcases mul_eq_zero.mp h1 with h | h
  · linarith
  · linarith [φ_gt_one]

/-! ## §1.5 The Fibonacci sequence (paper: def:fib-PCF-labels) -/

def fib : ℕ → ℕ
  | 0 => 0
  | 1 => 1
  | n + 2 => fib (n + 1) + fib n

/-- Fibonacci values for the small primes appearing in the splitting table. -/
theorem fib_values :
    fib 3 = 2 ∧ fib 7 = 13 ∧ fib 11 = 89 ∧
    fib 13 = 233 ∧ fib 17 = 1597 ∧ fib 19 = 4181 := by decide


