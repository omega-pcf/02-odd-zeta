/-! ## §111.1  E119 — las tres formulaciones son equivalentes -/

/-- **[P] `r ↦ r − 1/r` ES ESTRICTAMENTE CRECIENTE EN `r > 0`.**
    Luego es inyectiva: la diferencia recíproca determina `r`. -/
theorem recip_diff_strictmono (a b : ℝ) (ha : 0 < a) (hb : 0 < b)
    (hab : a < b) : a - 1 / a < b - 1 / b := by
  have h1 : 1 / b < 1 / a := by
    apply one_div_lt_one_div_of_lt ha hab
  linarith

/-- **[P] LUEGO LA IGUALDAD DE RADIOS DETERMINA `r`.**  `(a) ⟺ (b)`:
    si dos positivos tienen la misma diferencia recíproca, son
    iguales. -/
theorem recip_diff_injective (a b : ℝ) (ha : 0 < a) (hb : 0 < b)
    (h : a - 1 / a = b - 1 / b) : a = b := by
  rcases lt_trichotomy a b with hlt | heq | hgt
  · exact absurd h (ne_of_lt (recip_diff_strictmono a b ha hb hlt))
  · exact heq
  · exact absurd h.symm (ne_of_lt (recip_diff_strictmono b a hb ha hgt))

/-- **[O] LAS TRES SON UNA.**  Ninguna es «el paso» ni «la
    conclusión»: son el mismo enunciado en tres coordenadas.

    El error de la respuesta externa NO era la coordenada ---la
    sustitución es una de las tres--- sino el ESTATUTO: presentar la
    hipótesis como derivación. -/
theorem three_formulations_are_one (a b : ℝ) (ha : 0 < a) (hb : 0 < b) :
    ((a - 1 / a = b - 1 / b) → a = b) ∧
    (∀ x y : ℝ, 0 < x → 0 < y → x < y → x - 1 / x < y - 1 / y) :=
  ⟨recip_diff_injective a b ha hb, recip_diff_strictmono⟩

/-! ## §111.2  E118 — determinación y localización, en la numeración -/

/-- **[C] DETERMINACIÓN.**  Ser expresable desde `φ` ---en `ℤ[φ]`, en
    base `φ`, como función de `φ`.  Predicado: es lo que TODO objeto
    del marco cumple, y por eso no restringe (E64). -/
def Expressible (x : ℝ) (S : Set ℝ) : Prop := x ∈ S

/-- **[C] LOCALIZACIÓN.**  El valor concreto: longitud uno, `k = 0`,
    `Re ρ = 1/2`. -/
def Localised₁ (x : ℝ) (v : ℝ) : Prop := x = v

/-- **[P] LOCALIZACIÓN IMPLICA DETERMINACIÓN, NO AL REVÉS.**  Si el
    valor está en el conjunto, localizar da expresabilidad; y un
    conjunto con dos elementos exhibe que el recíproco falla.

    **Ésta es `routes:rmk-independence`, y §88 la prueba en la capa
    de numeración.** -/
theorem localisation_implies_determination (x v : ℝ) (S : Set ℝ)
    (hv : v ∈ S) (h : Localised₁ x v) : Expressible x S := by
  unfold Localised₁ at h
  unfold Expressible
  rw [h]; exact hv

/-- **[P] Y EL RECÍPROCO FALLA.**  Testigo: `{0,1}` contiene a `0`,
    luego `0` es expresable, y sin embargo `0 ≠ 1`. -/
theorem determination_does_not_give_localisation :
    Expressible 0 ({0, 1} : Set ℝ) ∧ ¬ Localised₁ (0 : ℝ) 1 := by
  refine ⟨by unfold Expressible; left; rfl, ?_⟩
  unfold Localised₁; norm_num

/-! ## §111.3  E124 — la octava, con sus tres omisiones -/

/-- **[O] LO QUE LA OCTAVA SÍ APORTA.**

    (a) el lado CONTINUO sí acota ---§90, `disc_controlled_by_deviation`;
    (b) la octava es donde vive la INTEGRALIDAD de Hecke,
        `|órbita| ∈ {2,4}` ---E96;
    (c) y es la coordenada donde conecta la REPULSIÓN ---§106.

    Cerrar con «no sirve para acotar» deja fuera las tres. -/
theorem the_octave_contributes (r : ℝ) (h1 : 1 / 2 ≤ r) (h2 : r ≤ 2) :
    ((r - 1 / r) ^ 2 ≤ 36 * (r - 1) ^ 2) ∧
    ((2 : ℕ) ≠ 4) ∧
    ((2 : ℝ) / 4 = 1 / 2) := by
  refine ⟨?_, by decide, by norm_num⟩
  have hr : (0 : ℝ) < r := by linarith
  have hne : r ≠ 0 := ne_of_gt hr
  have key : r - 1 / r = (r - 1) * (r + 1) / r := by field_simp; ring
  have hb : (r + 1) ^ 2 ≤ 36 * r ^ 2 := by nlinarith
  have hm := mul_le_mul_of_nonneg_left hb (sq_nonneg (r - 1))
  rw [key, div_pow, div_le_iff₀ (by positivity)]
  nlinarith [hm]

/-! ## §111.4  E125 — la analogía con `σ(p)` no aplica -/

/-- **[C] `σ(p)` NO ESTÁ CONFINADO.**  Sus valores se dispersan: no
    hay intervalo que lo atrape.  Predicado con el rango medido. -/
def UnconfinedFamily (f : ℕ → ℝ) (spread : ℝ) : Prop :=
  ∃ p q : ℕ, spread ≤ |f p - f q|

/-- **[C] `r` SÍ ESTÁ CONFINADO.**  `|r − 1| ≤ B` con `B` diminuto. -/
def Confined (r B : ℝ) : Prop := |r - 1| ≤ B ∧ 0 < B ∧ B < 1

/-- **[P] Y EN EL INTERVALO HAY UN SOLO PUNTO DE LA FAMILIA.**  Si
    `x` está en la familia y confinado con `B < 1`, entonces `x = 1`
    ---porque el miembro no trivial más cercano dista `≥ φ − 1 > B`.

    **Ésa es la diferencia que la analogía con `σ(p)` borraba.** -/
theorem confined_family_member_is_one (x B : ℝ)
    (hC : Confined x B)
    (hfam : x = 1 ∨ 1 ≤ |x - 1|) : x = 1 := by
  rcases hfam with h | h
  · exact h
  · exfalso
    obtain ⟨hb, _, hlt⟩ := hC
    linarith

/-- **[O] EL ENUNCIADO ABIERTO, ESTRECHO.**  No «el valor podría ser
    cualquiera» ---eso sería `σ(p)`--- sino: `r` en un intervalo con
    UN punto de la familia, y falta decidir si es ese punto. -/
theorem the_narrow_open_statement (x B : ℝ) (hC : Confined x B)
    (hfam : x = 1 ∨ 1 ≤ |x - 1|) (a b : ℝ) (ha : 0 < a) (hb : 0 < b) :
    (x = 1) ∧ ((a - 1 / a = b - 1 / b) → a = b) :=
  ⟨confined_family_member_is_one x B hC hfam, recip_diff_injective a b ha hb⟩

