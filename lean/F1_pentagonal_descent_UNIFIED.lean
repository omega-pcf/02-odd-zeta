namespace TodoEnLean
open scoped LSeries.notation
open Filter Topology

/-! ### The cover of the mapping torus: the deck step, algebraically -/

/-- `M`, the matrix of multiplication by `φ`, and its integer inverse. -/
def Mz : Matrix (Fin 2) (Fin 2) ℤ := !![0, 1; 1, 1]
def Mzinv : Matrix (Fin 2) (Fin 2) ℤ := !![-1, 1; 1, 0]

theorem Mz_inv : Mzinv * Mz = 1 ∧ Mz * Mzinv = 1 := by
  constructor <;> ext i j <;> fin_cases i <;> fin_cases j <;> rfl

/-- The deck step `D(x,t) = (M⁻¹x, t+1)`, the generator `γ(x,t) = (Mx, t−1)` of the
    identification `(x, t+1) ∼ (Mx, t)` of `X`, and `γ₆(x,t) = (M⁶x, t−6)` of `X₆`. -/
def Dstep (p : (Fin 2 → ℤ) × ℤ) : (Fin 2 → ℤ) × ℤ := (Mzinv.mulVec p.1, p.2 + 1)
def gam (p : (Fin 2 → ℤ) × ℤ) : (Fin 2 → ℤ) × ℤ := (Mz.mulVec p.1, p.2 - 1)
def gam6 (p : (Fin 2 → ℤ) × ℤ) : (Fin 2 → ℤ) × ℤ := ((Mz ^ 6).mulVec p.1, p.2 - 6)

/-- **`D` covers the identity of `X`:** `γ ∘ D = id`. -/
theorem gam_Dstep (p : (Fin 2 → ℤ) × ℤ) : gam (Dstep p) = p := by
  obtain ⟨x, t⟩ := p
  simp only [gam, Dstep, Matrix.mulVec_mulVec, Mz_inv.2, Matrix.one_mulVec]
  ext <;> simp

/-- **`D⁶` is an identification of `X₆`:** `γ₆ ∘ D⁶ = id`. -/
theorem gam6_Dstep6 (p : (Fin 2 → ℤ) × ℤ) : gam6 (Dstep^[6] p) = p := by
  obtain ⟨x, t⟩ := p
  have hcomm : Commute Mz Mzinv := by
    show Mz * Mzinv = Mzinv * Mz; rw [Mz_inv.1, Mz_inv.2]
  have hM : Mz ^ 6 * Mzinv ^ 6 = 1 := by
    rw [← hcomm.mul_pow, Mz_inv.2, one_pow]
  simp only [Function.iterate_succ, Function.iterate_zero, Function.comp_apply, id, Dstep, gam6,
    Matrix.mulVec_mulVec]
  refine Prod.ext ?_ ?_
  · show ((Mz ^ 6) * (Mzinv * (Mzinv * (Mzinv * (Mzinv * (Mzinv * Mzinv)))))).mulVec x = x
    have : Mzinv * (Mzinv * (Mzinv * (Mzinv * (Mzinv * Mzinv)))) = Mzinv ^ 6 := by
      simp only [pow_succ, pow_zero, one_mul, mul_assoc]
    rw [this, hM, Matrix.one_mulVec]
  · simp; ring

/-- **`D` commutes with `γ₆`,** so it descends to `X₆`. -/
theorem Dstep_gam6 (p : (Fin 2 → ℤ) × ℤ) : Dstep (gam6 p) = gam6 (Dstep p) := by
  obtain ⟨x, t⟩ := p
  have hc : Mzinv * Mz ^ 6 = Mz ^ 6 * Mzinv := by
    have h1 : Commute Mzinv Mz := by
      show Mzinv * Mz = Mz * Mzinv; rw [Mz_inv.1, Mz_inv.2]
    exact (h1.pow_right 6).eq
  simp only [Dstep, gam6, Matrix.mulVec_mulVec, hc]
  refine Prod.ext rfl ?_
  simp; ring

/-- **`Dᵏ` shifts the base by `k`;** the identifications of `X₆` shift it by multiples of
    six, so `Dᵏ` is not an identification for `0 < k < 6`. -/
theorem Dstep_iter_shift (k : ℕ) (p : (Fin 2 → ℤ) × ℤ) : (Dstep^[k] p).2 = p.2 + k := by
  induction k generalizing p with
  | zero => simp
  | succ k ih =>
    rw [Function.iterate_succ_apply', Dstep]
    simp only [ih]; push_cast; ring

/-! ### Dirichlet series: morphisms are unique (the category is a preorder) -/

/-- **A Dirichlet series with first coefficient 1 is invertible,** so `G = F·H` determines `H`. -/
theorem dirser_morphism_unique (F H₁ H₂ : ArithmeticFunction ℂ) (hF : F 1 = 1)
    (h : F * H₁ = F * H₂) : H₁ = H₂ := by
  have hu : IsUnit F := ArithmeticFunction.isUnit_iff_isUnit_apply_one.mpr (by rw [hF]; exact isUnit_one)
  exact hu.mul_left_cancel h

/-! ### The Dedekind factorisation for every quadratic character, as Euler products -/

/-- The local factor of the Dedekind zeta function of the quadratic field of a real character. -/
noncomputable def fDed {N : ℕ} (χ : DirichletCharacter ℂ N) (p : ℕ) (s : ℂ) : ℂ :=
  (1 - (p : ℂ) ^ (-s))⁻¹ * (1 - χ p * (p : ℂ) ^ (-s))⁻¹

/-- **Its three shapes**: split, inert, ramified. -/
theorem fDed_shapes {N : ℕ} (χ : DirichletCharacter ℂ N) (p : ℕ) (hp : p.Prime) (s : ℂ) :
    (χ p = 1 → fDed χ p s = ((1 - (p : ℂ) ^ (-s)) ^ 2)⁻¹) ∧
    (χ p = -1 → fDed χ p s = (1 - (p : ℂ) ^ (-(2 * s)))⁻¹) ∧
    (χ p = 0 → fDed χ p s = (1 - (p : ℂ) ^ (-s))⁻¹) := by
  refine ⟨fun h => ?_, fun h => ?_, fun h => ?_⟩
  · simp only [fDed, h, one_mul, sq, mul_inv]
  · have key : (1 - (p : ℂ) ^ (-s)) * (1 + (p : ℂ) ^ (-s)) = 1 - (p : ℂ) ^ (-(2 * s)) := by
      rw [show (-(2 * s) : ℂ) = (-s) + (-s) by ring,
        Complex.cpow_add _ _ (by exact_mod_cast hp.pos.ne')]
      ring
    simp only [fDed, h, neg_one_mul, sub_neg_eq_add]
    rw [← mul_inv, key]
  · simp [fDed, h]

/-- **Dedekind factorisation, for every Dirichlet character:**
    `∏ₚ fDed χ p s = ζ(s) · L(s, χ)` for `Re s > 1`. -/
theorem dedekind_factorisation_any {N : ℕ} (χ : DirichletCharacter ℂ N) {s : ℂ} (hs : 1 < s.re) :
    ∏' p : Nat.Primes, fDed χ p s = riemannZeta s * L ↗χ s :=
  ((riemannZeta_eulerProduct_hasProd hs).mul
    (DirichletCharacter.LSeries_eulerProduct_hasProd χ hs)).tprod_eq

/-! ### The counting function fixes ζ_K up to a constant -/

/-- **Same logarithmic derivative, proportional functions** (on an open preconnected set). -/
theorem same_logDeriv_proportional {f g : ℂ → ℂ} {U : Set ℂ} (hU : IsOpen U)
    (hUc : IsPreconnected U) (hf : DifferentiableOn ℂ f U) (hg : DifferentiableOn ℂ g U)
    (hf0 : ∀ z ∈ U, f z ≠ 0) (hg0 : ∀ z ∈ U, g z ≠ 0)
    (h : Set.EqOn (logDeriv f) (logDeriv g) U) : ∃ c : ℂ, c ≠ 0 ∧ Set.EqOn f (c • g) U :=
  (logDeriv_eqOn_iff hf hg hU hUc hg0 hf0).mp h

/-- **The normalisation fixes the constant.**  If `f = c·g` along the real axis and both
    tend to `1` as `σ → +∞`, then `c = 1`. -/
theorem constant_is_one {f g : ℝ → ℂ} (c : ℂ) (h : ∀ x : ℝ, 1 < x → f x = c * g x)
    (hf : Tendsto f atTop (𝓝 1)) (hg : Tendsto g atTop (𝓝 1)) : c = 1 := by
  have h2 : Tendsto (fun x => c * g x) atTop (𝓝 (c * 1)) := hg.const_mul c
  have h3 : Tendsto f atTop (𝓝 (c * 1)) :=
    h2.congr' (by filter_upwards [eventually_gt_atTop (1 : ℝ)] with x hx using (h x hx).symm)
  rw [mul_one] at h3
  exact tendsto_nhds_unique h3 hf

/-! ### The class 9 fixes φ -/

/-- With `ζ⁵ = 1`, the class `9` sends `ζ` to `ζ⁹ = ζ⁻¹`, and `1 + ζ + ζ⁻¹` is fixed. -/
theorem class_nine_fixes_phi (ζ : ℂ) (h5 : ζ ^ 5 = 1) :
    ζ ^ 9 = ζ⁻¹ ∧ 1 + ζ ^ 9 + (ζ ^ 9)⁻¹ = 1 + ζ + ζ⁻¹ := by
  have hz : ζ ≠ 0 := by intro h; rw [h] at h5; norm_num at h5
  have h9 : ζ ^ 9 = ζ⁻¹ := by
    apply eq_inv_of_mul_eq_one_left
    calc ζ ^ 9 * ζ = (ζ ^ 5) ^ 2 := by ring
      _ = 1 := by rw [h5]; norm_num
  refine ⟨h9, ?_⟩
  rw [h9, inv_inv]; ring

/-! ### The class does not decide the factor 3 of the clock: two witnesses -/

/-- `47` is inert (`≡ 2 mod 5`) and `≡ 2 mod 3`, so `3 ∣ 2·48 = N₄₇`; yet `φ³² ≡ 1`,
    i.e. `F₃₂ ≡ 0`, `F₃₁ ≡ 1 (mod 47)`, and `32` is prime to `3`. -/
theorem witness_47 : 47 % 5 = 2 ∧ 47 % 3 = 2 ∧ Nat.fib 32 % 47 = 0 ∧ Nat.fib 31 % 47 = 1 := by
  decide

/-- `139` splits (`≡ 4 mod 5`) and `≡ 1 mod 3`; yet `φ⁴⁶ ≡ 1 (mod 139)` with `46` prime to `3`. -/
theorem witness_139 : 139 % 5 = 4 ∧ 139 % 3 = 1 ∧ Nat.fib 46 % 139 = 0 ∧ Nat.fib 45 % 139 = 1 := by
  decide

