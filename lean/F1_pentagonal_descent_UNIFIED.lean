theorem repulsion_forbids_nonzero_radius (S : Set ℂ) (hc : ClosedUnderMate S)
    (ρ : ℂ) (hρ : ρ ∈ S) (hrad : (rad₉ ρ (1 - ρ)).re ≠ 0) :
