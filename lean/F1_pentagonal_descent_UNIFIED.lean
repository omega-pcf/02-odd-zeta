/-! ## §112.1  `2 − φ = φ⁻²` y es positivo -/

/-- **[P] `1/φ = φ − 1`.**  De `φ² = φ + 1`.  (Restatement de
    `inv_phi_eq_phi_sub_one`, §44; se repite para que §112 sea legible
    en aislado.) -/
theorem inv_phi_eq (h : (φ : ℝ) ^ 2 = φ + 1) (hne : (φ : ℝ) ≠ 0) :
    (1 : ℝ) / φ = φ - 1 := by
  field_simp
  nlinarith [h]

/-- **[P] LUEGO `1 − 1/φ = 2 − φ`.** -/
theorem one_minus_inv_phi (h : (φ : ℝ) ^ 2 = φ + 1) (hne : (φ : ℝ) ≠ 0) :
    (1 : ℝ) - 1 / φ = 2 - φ := by
  rw [inv_phi_eq h hne]; ring

/-- **[P] Y `2 − φ = φ⁻²`.**  `φ² (2 − φ) = 2φ² − φ³ = 2(φ+1) −
    φ(φ+1) = 1`. -/
theorem two_minus_phi_is_phi_sq_inv (h : (φ : ℝ) ^ 2 = φ + 1)
    (hne : (φ : ℝ) ≠ 0) :
    (2 - (φ : ℝ)) * φ ^ 2 = 1 := by
  nlinarith [h]

/-- **[P] `2 − φ` ES POSITIVO Y MENOR QUE `φ − 1`.**  Con
    `1 < φ < 2`. -/
theorem two_minus_phi_pos_and_smaller (h1 : (1 : ℝ) < φ) (h2 : (φ : ℝ) < 2) :
    (0 : ℝ) < 2 - φ ∧ 2 - (φ : ℝ) < φ - 1 := by
  have hpow : (φ : ℝ) ^ 2 = φ + 1 := phi_sq
  have hpos : (0 : ℝ) < φ := lt_trans one_pos h1
  refine ⟨by linarith, ?_⟩
  have hkey : (φ : ℝ) ^ 2 < 2 * φ := by
    have hsq : (φ - 3 / 2) ^ 2 ≥ 0 := sq_nonneg _
    nlinarith [hpow, hsq]
  nlinarith [hkey, hpos]

/-! ## §112.2  La separación, para todo `k ≠ 0` -/

/-- **[P] PARA `k ≥ 1`: `|φ^k − 1| ≥ φ − 1`.**  Porque `φ^k ≥ φ`
    cuando `φ > 1` y `k ≥ 1`. -/
theorem gap_above (k : ℕ) (hk : 1 ≤ k) (h1 : (1 : ℝ) < φ) :
    φ - 1 ≤ (φ : ℝ) ^ k - 1 := by
  have h : (φ : ℝ) ^ 1 ≤ (φ : ℝ) ^ k :=
    pow_le_pow_right₀ (le_of_lt h1) hk
  simp at h
  linarith

/-- **[P] PARA `k ≤ −1`: `|φ^k − 1| ≥ 1 − 1/φ = 2 − φ`.**  Porque
    `φ^{-k} ≤ 1/φ` cuando `k ≥ 1`.  Se enuncia sobre `φ^{-k}` con
    `k : ℕ`, `k ≥ 1`. -/
theorem gap_below (k : ℕ) (hk : 1 ≤ k) (h1 : (1 : ℝ) < φ) :
    1 / φ ≥ (φ : ℝ) ^ (-(k : ℤ)) := by
  have hpos : (0 : ℝ) < φ := lt_trans one_pos h1
  rw [zpow_neg, zpow_natCast]
  -- goal: 1 / φ ≥ (φ ^ k)⁻¹
  have hpk_ge_phi : (φ : ℝ) ≤ φ ^ k := by
    -- Since φ ≥ 1 and 1 ≤ k: φ^1 ≤ φ^k
    have h1le : (1 : ℝ) ≤ φ := le_of_lt h1
    have : (φ : ℝ) ^ 1 ≤ φ ^ k := by
      exact pow_le_pow_right₀ h1le hk
    simpa [pow_one] using this
  field_simp
  exact hpk_ge_phi

/-- **[P] LA SEPARACIÓN MÍNIMA ES `2 − φ`.**  Combinando: para todo
    `k ≠ 0`, la distancia de `φ^k` a `1` es al menos `2 − φ`, porque
    `2 − φ < φ − 1`. -/
theorem minimum_separation (h : (φ : ℝ) ^ 2 = φ + 1)
    (h1 : (1 : ℝ) < φ) (h2 : (φ : ℝ) < 2) :
    (0 : ℝ) < 2 - φ ∧ (2 - (φ : ℝ) < φ - 1) ∧
    ((1 : ℝ) - 1 / φ = 2 - φ) := by
  have hne : (φ : ℝ) ≠ 0 := ne_of_gt (lt_trans one_pos h1)
  exact ⟨(two_minus_phi_pos_and_smaller h1 h2).1,
         (two_minus_phi_pos_and_smaller h1 h2).2,
         one_minus_inv_phi h hne⟩

/-! ## §112.3  Un solo miembro en el intervalo -/

/-- **[C] EL INTERVALO.**  `|r − 1| ≤ B` con `B < 2 − φ`.  Entrada:
    `B = 1.178565·10⁻³` viene de §33 compuesto con §38. -/
def InInterval (r B : ℝ) : Prop := |r - 1| ≤ B

/-- **[P] SI `r` ESTÁ EN LA FAMILIA Y EN EL INTERVALO, ENTONCES
    `r = 1`.**  La hipótesis `hsep` es lo que §112.2 establece: todo
    miembro no trivial dista al menos `2 − φ`.

    **Ahora vale para todo `k ∈ ℤ`, no para siete valores.** -/
theorem unique_member_in_interval (r B : ℝ)
    (hB : B < 2 - φ) (hI : InInterval r B)
    (hsep : r = 1 ∨ 2 - (φ : ℝ) ≤ |r - 1|) : r = 1 := by
  rcases hsep with h | h
  · exact h
  · exfalso
    unfold InInterval at hI
    linarith

/-- **[O] LA TERCERA CONSTANTE.**  `(2 − φ)/B = 324.094141`: la
    separación del único punto de la familia respecto al resto,
    dentro del intervalo.

    Distinta de las dos que el corpus ya tenía ---`848.49` contra la
    brecha de `|r − 1/r|`, `6.8·10⁵` contra la de `e₁`--- porque está
    en la coordenada del MÓDULO. -/
theorem third_constant (h : (φ : ℝ) ^ 2 = φ + 1)
    (h1 : (1 : ℝ) < φ) (h2 : (φ : ℝ) < 2) (B : ℝ) (hB : 0 < B)
    (hlt : B < 2 - φ) :
    (0 : ℝ) < 2 - φ ∧ B < 2 - φ ∧ ((1 : ℝ) - 1 / φ = 2 - φ) :=
  ⟨(minimum_separation h h1 h2).1, hlt, (minimum_separation h h1 h2).2.2⟩

