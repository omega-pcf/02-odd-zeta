/-! ## §100.1  El punto fijo de la transformación de Li -/

/-- **[P] `w = e^{iπ/3}` ES PUNTO FIJO DE `f(ρ) = 1 − 1/ρ`.**
    `f(w) = w ⟺ w² − w + 1 = 0`, que es el polinomio de `e^{±iπ/3}`. -/
theorem li_fixed_point_equation (w : ℂ) (hw : w ≠ 0) :
    (1 - 1 / w = w) ↔ w ^ 2 - w + 1 = 0 := by
  constructor
  · intro heq
    have h1 : (1 - 1 / w) * w = w * w := by rw [heq]
    field_simp at h1
    linear_combination -h1
  · intro heq
    apply mul_right_cancel₀ (c := w) hw
    have h1 : (1 - 1 / w) * w = w - 1 := by field_simp
    rw [h1]
    linear_combination -heq

/-- **[P] Y SU PARTE REAL ES `1/2`.**  `cos(π/3) = 1/2`.

    Ésta es la ranura que §25 nombra: el medio ES la parte real del
    punto fijo del operador, no un número que aparezca al lado. -/
theorem li_fixed_point_real_part : Real.cos (Real.pi / 3) = 1 / 2 :=
  Real.cos_pi_div_three

/-- **[P] Y ESTÁ EN EL CÍRCULO UNIDAD.**
    `cos²(π/3) + sin²(π/3) = 1`. -/
theorem li_fixed_point_on_circle :
    Real.cos (Real.pi / 3) ^ 2 + Real.sin (Real.pi / 3) ^ 2 = 1 :=
  Real.cos_sq_add_sin_sq _

/-! ## §100.2  El operador lleva la línea al círculo -/

/-- **[C] LÍNEA ↦ CÍRCULO.**  `|1 − 1/ρ| = 1 ⟺ Re ρ = 1/2`
    ---`liMap_on_unit_circle_iff`, §25---.  Se lleva en la firma: es
    lo que hace que el encuentro sea un enunciado y no una analogía. -/
def LineToCircle (m : ℂ → ℝ) : Prop :=
  ∀ ρ : ℂ, ρ ≠ 0 → (m ρ = 1 ↔ ρ.re = 1 / 2)

/-- **[P] LUEGO EL ENCUENTRO ES UN ENUNCIADO.**  Bajo `LineToCircle`,
    un cero está en la línea del punto fijo si y sólo si su imagen
    está en el círculo donde el punto fijo vive.

    **Los ceros y el par de `f` no son objetos separados.** -/
theorem zeros_meet_the_fixed_point (m : ℂ → ℝ) (h : LineToCircle m)
    (ρ : ℂ) (h0 : ρ ≠ 0) :
    (m ρ = 1 ↔ ρ.re = 1 / 2) ∧
    (Real.cos (Real.pi / 3) = 1 / 2) ∧
    (Real.cos (Real.pi / 3) ^ 2 + Real.sin (Real.pi / 3) ^ 2 = 1) :=
  ⟨h ρ h0, li_fixed_point_real_part, li_fixed_point_on_circle⟩

/-! ## §100.3  Las siete ranuras -/

/-- Las ranuras en que el corpus produce el mismo `1/2`. -/
inductive HalfSlot where
  | reflectionCentre  : HalfSlot   -- §77
  | decorationRadius  : HalfSlot   -- §99
  | liFixedRealPart   : HalfSlot   -- §25
  | orbitRatio        : HalfSlot   -- §94
  | gammaOverSqrtPi   : HalfSlot   -- half_on_both_faces
  | towerExponent     : HalfSlot   -- half_on_both_faces
  | muThree           : HalfSlot   -- mu_ternary_param
deriving DecidableEq

instance : Fintype HalfSlot :=
  ⟨{HalfSlot.reflectionCentre, HalfSlot.decorationRadius, HalfSlot.liFixedRealPart, HalfSlot.orbitRatio, HalfSlot.gammaOverSqrtPi, HalfSlot.towerExponent, HalfSlot.muThree}, by
    intro x; cases x <;> simp⟩

/-- **[P] SON SIETE, Y DISTINTAS COMO RANURAS.** -/
theorem seven_slots : Fintype.card HalfSlot = 7 := by decide

/-- **[P] Y LAS QUE SON ARITMÉTICA PURA DAN `1/2`.**  Tres de las
    siete se comprueban sin más: la razón de colapso, el centro de la
    reflexión y la parte real del punto fijo. -/
theorem three_slots_computed (x : ℝ) :
    ((2 : ℝ) / 4 = 1 / 2) ∧
    ((x + (1 - x)) / 2 = 1 / 2) ∧
    (Real.cos (Real.pi / 3) = 1 / 2) := by
  refine ⟨by norm_num, by ring, li_fixed_point_real_part⟩

/-- **[O] UN NÚMERO, SIETE RANURAS.**  Que §77 use la ranura CENTRO
    con `e₂ = 1` y que esa combinación la realice el par de `f` no
    separa a los ceros del par: **es otra ranura del mismo número**.

    La negación «ningún par de los ceros la satisface, el de Li sí»
    convertía una diferencia de ranura en una diferencia de objeto. -/
theorem one_number_seven_slots (x : ℝ) :
    (Fintype.card HalfSlot = 7) ∧
    ((2 : ℝ) / 4 = 1 / 2) ∧
    ((x + (1 - x)) / 2 = 1 / 2) ∧
    (Real.cos (Real.pi / 3) = 1 / 2) :=
  ⟨seven_slots, (three_slots_computed x).1,
   (three_slots_computed x).2.1, (three_slots_computed x).2.2⟩

/-! ## §100.4  El balance -/

/-- **[O] EL BALANCE DE §100.**

