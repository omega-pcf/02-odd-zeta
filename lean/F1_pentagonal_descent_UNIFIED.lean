          Real.sq_sqrt (by norm_num), by norm_num⟩

theorem the_disc_ladder_of_the_family :
    (5 * (Nat.fib 0 : ℝ) ^ 2 = 0) ∧
    ((lucasN 1 : ℝ) ^ 2 = 1) ∧
    (5 * (Nat.fib 2 : ℝ) ^ 2 = 5) ∧
    ((lucasN 3 : ℝ) ^ 2 = 16) ∧
    ((1:ℝ) > 1/12) := by
  change (5 * (Nat.fib 0 : ℝ) ^ 2 = 0) ∧
    (((lucasN (0 + 1) : ℕ) : ℝ) ^ 2 = 1) ∧
    (5 * (Nat.fib 2 : ℝ) ^ 2 = 5) ∧
    (((lucasN (1 + 2) : ℕ) : ℝ) ^ 2 = 16) ∧
