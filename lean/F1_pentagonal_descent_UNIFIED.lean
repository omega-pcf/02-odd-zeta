  (`verify_no_free_parameter.py`.)

  ALCANCE.  Lo formalizado es la SEPARACIÓN de coordenadas y el
  ensamblaje de las siete cláusulas.  La reconstrucción numérica y
  el control de conductor cruzado (0.9963 propio contra 0.8899
  ajeno) son asintóticos y se reportan en la cabecera.
-/


/-! ### (vii) — La separación de coordenadas -/

/-- El sumando de la fórmula explícita en la línea crítica, escrito
    sin `cpow`: `x^{1/2+iγ} = √x · e^{iγ log x}`. -/
noncomputable def critTerm (x γ : ℝ) : ℂ :=
  (Real.sqrt x : ℂ) * Complex.exp ((γ * Real.log x : ℝ) * Complex.I)

/-- El denominador `ρ = 1/2 + iγ`. -/
noncomputable def critRho (γ : ℝ) : ℂ := (1/2 : ℂ) + (γ : ℝ) * Complex.I

/-- `ρ ≠ 0`: la parte real es 1/2. -/
theorem critRho_ne_zero (γ : ℝ) : critRho γ ≠ 0 := by
  intro h
  have : (critRho γ).re = 0 := by rw [h]; simp
  unfold critRho at this
  simp at this

/-- **LA IDENTIDAD DEL PAR.**  La contribución del par conjugado
    `{ρ, ρ̄}` al sumando `x^ρ/ρ` de la fórmula explícita es

        2·Re(x^{1/2+iγ}/(1/2+iγ))
          = 2√x·[½cos(γ log x) + γ sin(γ log x)] / (¼ + γ²).

    Es exactamente el término que se suma en la reconstrucción.  El
    factor `√x` viene de `Re ρ = 1/2`; los senos y cosenos, de
    `Im ρ = γ`.  Las dos coordenadas están separadas EN EL MISMO
    SUMANDO. -/
theorem pair_term_splits (x γ : ℝ) :
    (critTerm x γ / critRho γ).re
      = Real.sqrt x *
          ((1/2) * Real.cos (γ * Real.log x)
            + γ * Real.sin (γ * Real.log x)) / (1/4 + γ^2) := by
  unfold critTerm critRho
  rw [Complex.exp_mul_I]
  rw [Complex.div_re]
  have hns : Complex.normSq ((1/2 : ℂ) + (γ : ℝ) * Complex.I)
      = 1/4 + γ^2 := by
    rw [Complex.normSq_apply]
    simp [Complex.add_re, Complex.add_im, Complex.mul_re, Complex.mul_im]
    ring
  have hre : ((Real.sqrt x : ℂ) *
      (Complex.cos ((γ * Real.log x : ℝ)) +
        Complex.sin ((γ * Real.log x : ℝ)) * Complex.I)).re
      = Real.sqrt x * Real.cos (γ * Real.log x) := by
    -- (2026-09-05) Port de session_unified: haves atómicos en vez de
    -- simp flexible con ← ofReal_cos/ofReal_sin.
    have h1 : (Complex.cos ((γ * Real.log x : ℝ))).re = Real.cos (γ * Real.log x) :=
      Complex.cos_ofReal_re _
    have h2 : (Complex.cos ((γ * Real.log x : ℝ))).im = 0 :=
      Complex.cos_ofReal_im _
    have h3 : (Complex.sin ((γ * Real.log x : ℝ))).re = Real.sin (γ * Real.log x) :=
      Complex.sin_ofReal_re _
    have h4 : (Complex.sin ((γ * Real.log x : ℝ))).im = 0 :=
      Complex.sin_ofReal_im _
    have h5 : ((Real.sqrt x : ℂ)).re = Real.sqrt x := Complex.ofReal_re _
    have h6 : ((Real.sqrt x : ℂ)).im = 0 := Complex.ofReal_im _
    simp only [Complex.mul_re, Complex.add_re, Complex.add_im, Complex.mul_im,
               Complex.I_re, Complex.I_im, h1, h2, h3, h4, h5, h6]
    ring
  have him : ((Real.sqrt x : ℂ) *
      (Complex.cos ((γ * Real.log x : ℝ)) +
        Complex.sin ((γ * Real.log x : ℝ)) * Complex.I)).im
      = Real.sqrt x * Real.sin (γ * Real.log x) := by
    have h1 : (Complex.cos ((γ * Real.log x : ℝ))).re = Real.cos (γ * Real.log x) :=
      Complex.cos_ofReal_re _
    have h2 : (Complex.cos ((γ * Real.log x : ℝ))).im = 0 :=
      Complex.cos_ofReal_im _
    have h3 : (Complex.sin ((γ * Real.log x : ℝ))).re = Real.sin (γ * Real.log x) :=
      Complex.sin_ofReal_re _
    have h4 : (Complex.sin ((γ * Real.log x : ℝ))).im = 0 :=
      Complex.sin_ofReal_im _
    have h5 : ((Real.sqrt x : ℂ)).re = Real.sqrt x := Complex.ofReal_re _
    have h6 : ((Real.sqrt x : ℂ)).im = 0 := Complex.ofReal_im _
    simp only [Complex.mul_re, Complex.add_re, Complex.add_im, Complex.mul_im,
               Complex.I_re, Complex.I_im, h1, h2, h3, h4, h5, h6]
    ring
  rw [hre, him, hns]
  simp [Complex.add_re, Complex.add_im, Complex.mul_re, Complex.mul_im]
  ring

/-- **EL MÓDULO ES RADIAL.**  `‖x^{1/2+iγ}‖ = √x` para todo `γ`: el
    módulo del sumando no ve la parte imaginaria.  Es
    `abs_cpow_eq_rpow_neg_re` en la forma que usa la fórmula
    explícita. -/
theorem modulus_is_radial (x γ : ℝ) (hx : 0 ≤ x) :
    Complex.abs (critTerm x γ) = Real.sqrt x := by
  -- (2026-09-05) Port de session_unified + unfold del shim: el abbrev no
  -- es MapMul, `norm_mul` necesita la forma ‖·‖ desplegada.
  unfold critTerm Complex.abs
  rw [norm_mul, Complex.norm_exp_ofReal_mul_I]
  simp [abs_of_nonneg (Real.sqrt_nonneg x)]

/-- **Y NO DEPENDE DE γ EN ABSOLUTO.**  Dos ordenadas cualesquiera
    dan el mismo módulo: la coordenada radial es ciega a la
    angular. -/
theorem modulus_independent_of_ordinate (x γ₁ γ₂ : ℝ) (hx : 0 ≤ x) :
    Complex.abs (critTerm x γ₁) = Complex.abs (critTerm x γ₂) := by
  rw [modulus_is_radial x γ₁ hx, modulus_is_radial x γ₂ hx]

/-- **LA FASE ES ANGULAR.**  Y sí distingue: hay ordenadas con el
    mismo módulo y sumando distinto.  Testigo explícito en
    `x = e` \textup{(}luego `log x = 1`\textup{)}, con `γ = 0` y
    `γ = π`: los factores de fase son `1` y `−1`.

    Consecuencia: el módulo solo NO determina el sumando, que es
    la razón formal de que suprimir la fase hunda la reconstrucción
    de 0.9517 a 0.2153. -/
theorem phase_is_angular :
    Complex.exp ((0 : ℝ) * Complex.I) ≠
      Complex.exp ((Real.pi : ℝ) * Complex.I) := by
  rw [Complex.ofReal_zero, zero_mul, Complex.exp_zero]
  -- (2026-09-05) `Complex.ofReal_mul_I_eq` no existe en v4.30 (estaba muerto):
  -- `Complex.exp_pi_mul_I` reescribe directamente. Prueba portada de
  -- session_unified (verde).
  rw [Complex.exp_pi_mul_I]
  norm_num

/-- **LAS DOS COORDENADAS, REUNIDAS.**  Un mismo sumando lleva
    módulo gobernado por `Re ρ` y fase gobernada por `Im ρ`; el
    primero es ciego a `γ` y la segunda no.  No son dos objetos ni
    una sola lectura: son dos coordenadas de un sumando. -/
theorem term_has_two_coordinates (x : ℝ) (hx : 0 ≤ x) :
    (∀ γ₁ γ₂ : ℝ, Complex.abs (critTerm x γ₁)
        = Complex.abs (critTerm x γ₂)) ∧
    (Complex.exp ((0 : ℝ) * Complex.I) ≠
        Complex.exp ((Real.pi : ℝ) * Complex.I)) :=
  ⟨fun γ₁ γ₂ => modulus_independent_of_ordinate x γ₁ γ₂ hx,
   phase_is_angular⟩


/-! ### El ensamblaje: las siete cláusulas -/

/-- **TEOREMA — LA MEDICIÓN NO LLEVA PARÁMETRO LIBRE.**

    (ii)  el conductor está derivado:  lcm(4,5) = 20;
    (iii) la escala es inyectiva en él, luego la unidad es única;
    (iv)  la envolvente se parte en exactamente dos constantes;
    (v)   y son las dos partes de 20 = 4·5:  log 2π (cara π) y
          log q (cara φ), que sí distingue el cuerpo;
    (vi)  el módulo de la clase es ½, alcanzado por el factorial y
          por la torre sin ingrediente común;
    (vii) y cada sumando de la fórmula explícita se parte en las
          mismas dos coordenadas.

    Ninguna de las seis cantidades queda disponible para ajuste.
    La cláusula (i) —que el conjunto de ceros es función de φ— es
    `routes:prop-determination` y vive en la cadena
    φ → χ₅ → {f_p} → L, formalizada en los módulos del producto de
    Euler; aquí se usa su consecuencia y no se re-prueba. -/
theorem no_free_parameter {q₁ q₂ : ℝ}
    (h₁ : 0 < q₁) (h₂ : 0 < q₂) (hne : q₁ ≠ q₂) :
    -- (ii) el conductor está derivado
    (Nat.lcm 4 5 = 20) ∧
    -- (iii) la escala es inyectiva en el conductor
    (∀ T : ℝ, 0 < T → 2 * π < q₁ * T → 2 * π < q₂ * T →
        spacingScale q₁ T ≠ spacingScale q₂ T) ∧
    -- (iv) la envolvente se parte en dos constantes
    (∀ q T : ℝ, 0 < q → 0 < T →
        Real.log (q * T / (2 * π * Real.exp 1))
          = Real.log q + Real.log T - Real.log (2 * π * Real.exp 1)) ∧
    -- (v) y sólo la parte del cuerpo distingue
    (Real.log q₁ ≠ Real.log q₂) ∧
    -- (vi) el módulo, por las dos caras
    (Real.Gamma (3/2) / Real.sqrt π
        = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ))) ∧
    -- (vii) y el sumando, en sus dos coordenadas
    (∀ x γ₁ γ₂ : ℝ, 0 ≤ x →
        Complex.abs (critTerm x γ₁) = Complex.abs (critTerm x γ₂)) :=
  ⟨conductor_from_periods,
   fun T hT ha hb => scale_injective_in_conductor hT ha hne hb,
   fun q T hq hT => envelope_splits q T hq hT,
   field_part_distinguishes h₁ h₂ hne,
   half_on_both_faces,
   fun x γ₁ γ₂ hx => modulus_independent_of_ordinate x γ₁ γ₂ hx⟩

/-- **COROLARIO — EL ACUERDO NO ES UN AJUSTE.**  Reunido con el
    módulo común de los dos retículos: la unidad está forzada, sus
    dos constantes son las dos partes del conductor, y el módulo
    está fijado dos veces.  El corolario es la lectura del teorema,
    no un enunciado adicional: no queda constante disponible. -/
theorem agreement_is_not_a_fit :
    (Nat.lcm 4 5 = 20) ∧
    (Complex.abs (Omega_hat 0) = mu_n_param 3 ∧
      Real.Gamma (3/2) / Real.sqrt Real.pi = mu_n_param 3) ∧
    (Real.Gamma (3/2) / Real.sqrt π
        = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ))) :=
  ⟨conductor_from_periods, one_modulus_two_lattices, half_on_both_faces⟩


