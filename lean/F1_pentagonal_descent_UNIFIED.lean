namespace NivelesYOrientacion

/-! ## 1. Inerte ⇒ nivel par -/

/-- **[P*] (1) Inerte ⇒ nivel par.**  En un monoide, si x^q = y con y² = 1 e
    y ≠ 1 (y = −1), y x^n = 1, entonces n es par. -/
theorem level_even_of_half_turn {M : Type*} [Monoid M] (x y : M) (q n : ℕ)
    (hq : x ^ q = y) (hy2 : y ^ 2 = 1) (hy1 : y ≠ 1) (hn : x ^ n = 1) : Even n := by
  -- el orden de x divide a 2q y no divide a q
  have h2q : x ^ (2 * q) = 1 := by
    rw [mul_comm, pow_mul, hq, hy2]
  have hd2q : orderOf x ∣ 2 * q := orderOf_dvd_of_pow_eq_one h2q
  have hndq : ¬ orderOf x ∣ q := by
    intro h
    exact hy1 (by rw [← hq]; exact orderOf_dvd_iff_pow_eq_one.mp h)
  -- si el orden fuera impar, sería coprimo con 2 y dividiría a q
  have hodd_false : ¬ Odd (orderOf x) := by
    intro hodd
    have hnd : ¬ 2 ∣ orderOf x := by
      rintro ⟨k, hk⟩
      rcases hodd with ⟨j, hj⟩
      omega
    have hc : Nat.Coprime (orderOf x) 2 := (Nat.prime_two.coprime_iff_not_dvd.mpr hnd).symm
    apply hndq
    first
    | exact hc.dvd_of_dvd_mul_left hd2q
    | exact hc.dvd_of_dvd_mul_right (by rwa [mul_comm] at hd2q)
  have hev : Even (orderOf x) := by
    rcases Nat.even_or_odd (orderOf x) with h | h
    · exact h
    · exact absurd h hodd_false
  have hdn : orderOf x ∣ n := orderOf_dvd_of_pow_eq_one hn
  exact even_iff_two_dvd.mpr (hev.two_dvd.trans hdn)

/-! ## 2. Nivel impar ⇒ un solo ideal -/

/-- **[P*] (2) Nivel impar ⇒ un solo ideal.**  En un anillo conmutativo con
    −1 ≠ 1, si r·s = −1, r^n = 1 y n es impar, entonces s^n = −1, luego s^n ≠ 1. -/
theorem conjugate_does_not_close_at_odd_level {R : Type*} [CommRing R]
    (r s : R) (n : ℕ) (hrs : r * s = -1) (hr : r ^ n = 1) (hodd : Odd n)
    (hne : (-1 : R) ≠ 1) : s ^ n = -1 ∧ s ^ n ≠ 1 := by
  have h : (r * s) ^ n = -1 := by rw [hrs, Odd.neg_one_pow hodd]
  rw [mul_pow, hr, one_mul] at h
  exact ⟨h, by rw [h]; exact hne⟩

/-! ## 3. Las dos raíces -/

/-- **[P*] (3) Las raíces de x² − x − 1 son r y 1 − r, con producto −1.** -/
theorem roots_and_product {R : Type*} [CommRing R] (r : R) (hr : r ^ 2 = r + 1) :
    (1 - r) ^ 2 = (1 - r) + 1 ∧ r * (1 - r) = -1 := by
  constructor
  · linear_combination hr
  · linear_combination -hr

/-- **[P*] (2)+(3) Para un primo que se escinde:** si una raíz cierra en un nivel
    impar n, la otra no cierra ahí. -/
theorem split_prime_one_ideal_at_odd_level {R : Type*} [CommRing R]
    (r : R) (hr : r ^ 2 = r + 1) (n : ℕ) (hn : r ^ n = 1) (hodd : Odd n)
    (hne : (-1 : R) ≠ 1) : (1 - r) ^ n ≠ 1 :=
  (conjugate_does_not_close_at_odd_level r (1 - r) n (roots_and_product r hr).2 hn hodd hne).2

/-- **[P*] (2') El eco en el nivel doble.**  En las mismas hipótesis, el conjugado
    cierra en 2n: s^{2n} = 1.  Por eso un primo escindido de un nivel impar n
    reaparece, por su otro ideal, en el nivel 2n (sprint 60: 23 y 46, 29 y 58, …). -/
theorem conjugate_closes_at_double_level {R : Type*} [CommRing R]
    (r : R) (hr : r ^ 2 = r + 1) (n : ℕ) (hn : r ^ n = 1) (hodd : Odd n) :
    (1 - r) ^ (2 * n) = 1 := by
  have h : (r * (1 - r)) ^ n = -1 := by
    rw [(roots_and_product r hr).2, Odd.neg_one_pow hodd]
  rw [mul_pow, hn, one_mul] at h
  rw [mul_comm, pow_mul, h]
  norm_num

/-! ## 4. Instancias -/

/-- Producto en ℤ[φ]/m sobre representantes en ℕ: (a + bφ)(c + dφ). -/
def mulm (m : ℕ) (x y : ℕ × ℕ) : ℕ × ℕ :=
  ((x.1 * y.1 + x.2 * y.2) % m, (x.1 * y.2 + x.2 * y.1 + x.2 * y.2) % m)

/-- φ^k en ℤ[φ]/m (recursión estructural, apta para `decide`). -/
def powm (m : ℕ) : ℕ → ℕ × ℕ
  | 0 => (1 % m, 0)
  | k + 1 => mulm m (powm m k) (0, 1)

/-- **[P*] (4) φ^{p+1} = −1 en ℤ[φ]/p para los inertes p = 3, 7, 13, 17, 23.** -/
theorem half_turn_at_inert_primes :
    powm 3 4 = (2, 0) ∧ powm 7 8 = (6, 0) ∧ powm 13 14 = (12, 0)
    ∧ powm 17 18 = (16, 0) ∧ powm 23 24 = (22, 0) := by decide

/-- **[P*] (4) La excepción: el orden de φ en ℤ[φ]/2 es 3 (nivel impar).** -/
theorem two_closes_at_level_three :
    powm 2 3 = (1, 0) ∧ powm 2 1 ≠ (1, 0) := by decide

/-- **[P*] (4) En 11, que se escinde, las raíces son 4 y 8 = 1 − 4 (mód 11),
    con 4·8 = −1; 4 cierra en el nivel 5 y 8 en el 10, no en el 5.** -/
theorem eleven_one_ideal_at_level_five :
    (4 * 4 : ZMod 11) = 4 + 1 ∧ (1 - 4 : ZMod 11) = 8 ∧ (4 * 8 : ZMod 11) = -1
    ∧ (4 : ZMod 11) ^ 5 = 1 ∧ (8 : ZMod 11) ^ 5 = -1 ∧ (8 : ZMod 11) ^ 10 = 1 := by decide

end NivelesYOrientacion

end NivelesYOrientacionBlock

