theorem the_balance_of_section_97 (r : ℝ) (hr : 0 < r) :
    ((r * (1 / r) = 1) ↔ (Real.log r + Real.log (1 / r) = 0)) ∧
    (∀ s : ℝ, 0 < s → Real.log s + Real.log (1 / s) = 0) ∧
