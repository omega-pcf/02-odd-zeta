theorem the_exact_trade (ρ : ℂ) (h₀ : ρ ≠ 0) (h₁ : ρ ≠ 1) (hγ : ρ.im ≠ 0) :
    ((1 - (starRingEnd ℂ) ρ).im = ρ.im) ∧
    (zeroCoord (1 - ρ) = (zeroCoord ρ)⁻¹) ∧
    ((1 - ρ).im ≠ ρ.im) ∧
    (∀ r C : ℝ, 1 < r → 0 < C → (∀ p : ℕ, r ^ p ≤ C) → False) :=
  ⟨kmate_preserves_ordinate ρ,
   coordinate_is_equivariant ρ h₀ h₁,
   (conjugation_is_what_makes_the_pair_horizontal ρ hγ).2,
   fun r C h1 h2 h3 => power_orbit_forces_one r C h1 h2 h3⟩

theorem kmate_inverts_the_coordinate (ρ : ℂ) (h₀ : ρ ≠ 0) (h₁ : ρ ≠ 1) :
    zeroCoord (1 - (starRingEnd ℂ) ρ) = (zeroCoord ρ)⁻¹ := by
  have hc0 : (starRingEnd ℂ) ρ ≠ 0 := by
    intro h; exact h₀ (by simpa using congrArg (starRingEnd ℂ) h)
  have hc1 : (starRingEnd ℂ) ρ ≠ 1 := by
    intro h; exact h₁ (by simpa using congrArg (starRingEnd ℂ) h)
  have hstep := coordinate_is_equivariant ((starRingEnd ℂ) ρ) hc0 hc1
  unfold zeroCoord at *
  have habs : Complex.abs (liMap ((starRingEnd ℂ) ρ)) = Complex.abs (liMap ρ) := by
    unfold liMap
    rw [show (1 : ℂ) - 1 / (starRingEnd ℂ) ρ = (starRingEnd ℂ) (1 - 1 / ρ) by
          simp [map_sub, map_one]]
    exact Complex.abs_conj _
  rw [hstep, habs]

theorem both_invert_only_one_is_horizontal (ρ : ℂ) (hγ : ρ.im ≠ 0) :
    (1 - (starRingEnd ℂ) ρ).im = ρ.im ∧ (1 - ρ).im ≠ ρ.im :=
  conjugation_is_what_makes_the_pair_horizontal ρ hγ

theorem sign_orbit_trivial_iff_one (r : ℝ) (hr : 0 < r) :
    r = r⁻¹ ↔ r = 1 := by
  constructor
  · intro h
    have h1 : r * r = 1 := by
      field_simp at h; nlinarith [h, hr]
    nlinarith [h1, hr]
  · intro h; rw [h]; norm_num

theorem no_sharing_means_sign_orbit_is_trivial (Z : Set ℂ)
    (hc : ∀ ρ ∈ Z, (1 - (starRingEnd ℂ) ρ) ∈ Z)
    (h : ¬ ∃ ρ ∈ Z, ∃ τ ∈ Z, ρ ≠ τ ∧ ρ.im = τ.im)
    (ρ : ℂ) (hρ : ρ ∈ Z) :
    (1 - (starRingEnd ℂ) ρ) = ρ := by
  by_contra hne
  exact h ⟨ρ, hρ, 1 - (starRingEnd ℂ) ρ, hc ρ hρ, Ne.symm hne,
           (kmate_preserves_ordinate ρ).symm⟩

theorem sign_orbit_has_no_slack (r : ℝ) (hr : 0 < r) :
    ({r, r⁻¹} : Set ℝ).Subsingleton ↔ r = 1 := by
  constructor
  · intro h
    exact (sign_orbit_trivial_iff_one r hr).mp
      (h (Set.mem_insert _ _) (Set.mem_insert_of_mem _ rfl))
  · intro h a ha b hb
    rw [h] at ha hb
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, inv_one, or_self] at ha hb
    rw [ha, hb]

theorem power_orbit_has_slack (r : ℝ) (hr : 1 < r) (C : ℝ) :
    ∃ p : ℕ, C < r ^ p := by
  rcases le_or_gt C 0 with hC | hC
  · exact ⟨1, by rw [pow_one]; linarith⟩
  · exact powers_escape_any_bound r C hr hC

theorem the_weak_form_in_orbit_terms (ρ : ℂ) (h₀ : ρ ≠ 0) (h₁ : ρ ≠ 1)
    (hγ : ρ.im ≠ 0) :
    (zeroCoord (1 - (starRingEnd ℂ) ρ) = (zeroCoord ρ)⁻¹) ∧
    ((1 - (starRingEnd ℂ) ρ).im = ρ.im) ∧
    ((1 - ρ).im ≠ ρ.im) ∧
    (∀ r : ℝ, 0 < r → (r = r⁻¹ ↔ r = 1)) ∧
    (∀ r C : ℝ, 1 < r → ∃ p : ℕ, C < r ^ p) :=
  ⟨kmate_inverts_the_coordinate ρ h₀ h₁,
   kmate_preserves_ordinate ρ,
   (both_invert_only_one_is_horizontal ρ hγ).2,
   fun r hr => sign_orbit_trivial_iff_one r hr,
   fun r C hr => power_orbit_has_slack r hr C⟩

theorem disc_invariant_under_kmate (ρ : ℂ) (h₀ : ρ ≠ 0) (h₁ : ρ ≠ 1) :
    discP (zeroCoord (1 - (starRingEnd ℂ) ρ)) = discP (zeroCoord ρ) := by
  rw [kmate_inverts_the_coordinate ρ h₀ h₁]
  unfold discP e1P
  have hz : zeroCoord ρ ≠ 0 := by
    unfold zeroCoord
    intro h
    have hl : liMap ρ = 0 := Complex.abs.eq_zero (show Complex.abs _ = 0 from h)
    unfold liMap at hl
    field_simp at hl
    rw [mul_zero] at hl
    exact h₁ (sub_eq_zero.mp hl)
  field_simp
  ring

theorem disc_le_confines (r : ℝ) (hr : 0 < r) (h : discP r ≤ 1/12) :
    Real.sqrt 3 / 2 ≤ r ∧ r ≤ 2 / Real.sqrt 3 := by
  have hpos : (0:ℝ) < r + 1 / r := by linarith [trace_ge_two r hr]
  have hd : (r - 1/r) ^ 2 ≤ 1/12 := by
    unfold discP e1P at h
    have h4 : (r + 1/r) ^ 2 - 4 = (r - 1/r) ^ 2 := by field_simp; ring
    have hsq' : (r - 1/r) ^ 2 = (r + 1/r) ^ 2 - 4 := h4.symm
    linarith [hsq', h]
  have h12r : 12 * (r^2 - 1)^2 ≤ r^2 := by
    have h1c : (r - 1/r)^2 * r^2 ≤ (1/12) * r^2 :=
      mul_le_mul_of_nonneg_right hd (sq_nonneg r)
    have hkey : (r^2 - 1)^2 = (r - 1/r)^2 * r^2 := by
      have hstep : (r - 1/r) * r = r^2 - 1 := by field_simp
      calc (r^2 - 1)^2 = ((r - 1/r) * r)^2 := by rw [hstep]
        _ = (r - 1/r)^2 * r^2 := by ring
    rw [hkey]
    linarith [h1c]
  have hsq3 : √3 * √3 = 3 := Real.mul_self_sqrt (by norm_num : (0:ℝ) ≤ 3)
  constructor
  · by_contra hc
    have hc' : r < √3 / 2 := by linarith
    have h1m : r * r < 3 / 4 := by nlinarith [hc']
    have hu : (1:ℝ) - r^2 > 1/4 := by linarith
    have hp1 : (0:ℝ) < 4*(1-r^2) - 1 := by linarith
    have hp2 : (0:ℝ) < 3*(1-r^2) + 1 := by linarith
    have hprod2 : (0:ℝ) < (4*(1-r^2) - 1) * (3*(1-r^2) + 1) := mul_pos hp1 hp2
    have hexpand : (4*(1-r^2) - 1) * (3*(1-r^2) + 1)
        = 12*(1-r^2)^2 + (1-r^2) - 1 := by ring
    have hru : r^2 = 1 - (1-r^2) := by ring
    have heq2 : (1-r^2)^2 = (r^2-1)^2 := by ring
    linarith [hprod2, hexpand, h12r, hru, heq2]
  · by_contra hc
    have hc' : 2 / √3 < r := by linarith
    have hsqc : 2 / √3 * (2 / √3) = 4 / 3 := by
      have h6 : 2 / √3 * (2 / √3) = 2 * 2 / (√3 * √3) := by ring
      rw [h6, hsq3]; norm_num
    have hstep1 : (2/√3) * r < r * r := by nlinarith
    have hstep2 : (2/√3) * (2/√3) < (2/√3) * r :=
      mul_lt_mul_of_pos_left hc' (by positivity)
    rw [hsqc] at hstep2
    have h1m : 4/3 < r^2 := by linarith
    have hu : r^2 - 1 > 1/3 := by linarith
    have hp1 : (0:ℝ) < 4*(r^2-1) + 1 := by linarith
    have hp2 : (0:ℝ) < 3*(r^2-1) - 1 := by linarith
    have hprod2 : (0:ℝ) < (4*(r^2-1) + 1) * (3*(r^2-1) - 1) := mul_pos hp1 hp2
    have hexpand : (4*(r^2-1) + 1) * (3*(r^2-1) - 1)
        = 12*(r^2-1)^2 - (r^2-1) - 1 := by ring
    have hru : r^2 = (r^2-1) + 1 := by ring
    linarith [hprod2, hexpand, h12r, hru]

theorem confinement_is_inversion_symmetric :
    (Real.sqrt 3 / 2) * (2 / Real.sqrt 3) = 1 := by
  have h3 : (0:ℝ) < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
  field_simp

theorem phi_outside_confinement : 2 / Real.sqrt 3 < (φ : ℝ) := by
  have h3 : (0:ℝ) < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
  have hsq : Real.sqrt 3 ^ 2 = 3 := Real.sq_sqrt (by norm_num)
  have hlt : Real.sqrt 3 < 2 := by nlinarith [hsq, h3]
  have hphi : (1.6 : ℝ) < φ := by
    have h5 : (2.23 : ℝ) < Real.sqrt 5 := by
      nlinarith [Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 5), Real.sqrt_nonneg 5]
    unfold φ; linarith
  have : 2 / Real.sqrt 3 < 1.6 := by
    rw [div_lt_iff₀ h3]; nlinarith [hsq, h3]
  linarith

theorem monomial_alone_gives_E (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|)
    (hmon : ∃ k : ℤ, zeroCoord ρ = (φ : ℝ) ^ k) :
    ρ.re = 1/2 := by
  obtain ⟨k, hk⟩ := hmon
  have hle : discP (zeroCoord ρ) ≤ 1/12 := discBound_of_high_gamma ρ h0 h1 hγ
  have hz : discP (zeroCoord ρ) = 0 := by
    by_cases h : k = 0
    · rw [hk, h, zpow_zero]; unfold discP e1P; norm_num
    · exfalso
      have hge : (1:ℝ) ≤ discP ((φ : ℝ) ^ k) := family_disc_ge_one_of_ne_zero k h
      rw [← hk] at hge
      linarith
  exact (disc_zero_iff_half ρ h0 h1).mp hz

theorem the_new_connections :
    ((Real.sqrt 3 / 2) * (2 / Real.sqrt 3) = 1) ∧
    (2 / Real.sqrt 3 < (φ : ℝ)) ∧
    (∀ r : ℝ, 0 < r → discP r ≤ 1/12 →
       Real.sqrt 3 / 2 ≤ r ∧ r ≤ 2 / Real.sqrt 3) :=
  ⟨confinement_is_inversion_symmetric, phi_outside_confinement,
   fun r hr h => disc_le_confines r hr h⟩

theorem monomial_gives_E_bare (r : ℝ) (k : ℤ)
    (hk : r = (φ : ℝ) ^ k) (hle : discP r ≤ 1/12) : k = 0 := by
  by_contra h
  have hge : (1:ℝ) ≤ discP r := by rw [hk]; exact family_disc_ge_one_of_ne_zero k h
  linarith

theorem disc_decays_with_height (ρ : ℂ) (h0 : 0 < ρ.re) (h1 : ρ.re < 1) :
    discP (zeroCoord ρ) ≤ (1 - 2*ρ.re)^2 / ρ.im^4 ∨ ρ.im = 0 := by
  by_cases hγ : ρ.im = 0
  · exact Or.inr hγ
  · left
    have hρ : ρ ≠ 0 := by intro h; rw [h] at h0; simp at h0
    have hρ1 : ρ - 1 ≠ 0 := by
      intro h; have : ρ = 1 := by linear_combination h
      rw [this] at h1; simp at h1
    have hg2 : 0 < ρ.im^2 := by positivity
    have ha : Complex.abs ρ ^ 2 = ρ.re^2 + ρ.im^2 := by
      rw [Complex.sq_abs]; unfold Complex.normSq; simp; ring
    have hb : Complex.abs (ρ - 1) ^ 2 = (ρ.re - 1)^2 + ρ.im^2 := by
      rw [Complex.sq_abs]; unfold Complex.normSq
      simp [Complex.sub_re, Complex.sub_im, Complex.one_re, Complex.one_im]; ring
    rw [disc_closed_form ρ h0 h1, ha, hb]
    have hden : ρ.im^4 ≤ (ρ.re^2 + ρ.im^2) * ((ρ.re - 1)^2 + ρ.im^2) := by
      nlinarith [sq_nonneg ρ.re, sq_nonneg (ρ.re - 1), hg2, sq_nonneg (ρ.im^2)]
    have hnum : (0:ℝ) ≤ (1 - 2*ρ.re)^2 := sq_nonneg _
    have hpos : 0 < (ρ.re^2 + ρ.im^2) * ((ρ.re - 1)^2 + ρ.im^2) := by positivity
    have hg4 : 0 < ρ.im^4 := by positivity
    rw [div_le_div_iff₀ hpos hg4]
    nlinarith [hden, hnum]

theorem disc_strictly_increases_in_p (r : ℝ) (hr : 1 < r) (p q : ℕ) (hpq : p < q) :
    discP (r ^ p) < discP (r ^ q) := by
  have hp0 : (0:ℝ) < r ^ p := by positivity
  have hq0 : (0:ℝ) < r ^ q := by positivity
  have hlt : r ^ p < r ^ q := pow_lt_pow_right₀ hr hpq
  have h1p : (1:ℝ) ≤ r ^ p := one_le_pow₀ (le_of_lt hr)
  have hkey : ∀ x y : ℝ, 1 ≤ x → x < y → discP x < discP y := by
    intro x y hx hxy
    have hx0 : (0:ℝ) < x := lt_of_lt_of_le one_pos hx
    have hy0 : (0:ℝ) < y := lt_trans hx0 hxy
    unfold discP e1P
    have hdx : x - 1/x < y - 1/y := by
      have : 1/y < 1/x := by
        apply one_div_lt_one_div_of_lt hx0 hxy
      linarith
    have hnn : 0 ≤ x - 1/x := by
      rw [sub_nonneg, div_le_iff₀ hx0]; nlinarith [hx]
    have hxx : (x + 1/x)^2 - 4 = (x - 1/x)^2 := by field_simp; ring
    have hyy : (y + 1/y)^2 - 4 = (y - 1/y)^2 := by field_simp; ring
    rw [hxx, hyy]
    nlinarith [hdx, hnn]
  exact hkey (r ^ p) (r ^ q) h1p hlt

theorem what_the_bound_gives_the_action :
    (∀ r : ℝ, ∀ k : ℤ, r = (φ : ℝ) ^ k → discP r ≤ 1/12 → k = 0) ∧
    (∀ r : ℝ, 1 < r → ∀ p q : ℕ, p < q → discP (r ^ p) < discP (r ^ q)) :=
  ⟨fun r k hk hle => monomial_gives_E_bare r k hk hle,
   fun r hr p q hpq => disc_strictly_increases_in_p r hr p q hpq⟩

theorem uniform_ceiling_suffices (r : ℝ) (hr : 1 < r)
    (hconf : ∀ p : ℕ, r ^ p ≤ 2 / Real.sqrt 3) : False := by
  have h3 : (0:ℝ) < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
  have hC : (0:ℝ) < 2 / Real.sqrt 3 := by positivity
  obtain ⟨p, hp⟩ := powers_escape_any_bound r (2 / Real.sqrt 3) hr hC
  exact absurd (hconf p) (not_le.mpr hp)

theorem confinement_kills_r_gt_one (r : ℝ) (hr : 1 < r)
    (hdisc : ∀ p : ℕ, discP (r ^ p) ≤ 1/12) : False := by
  refine uniform_ceiling_suffices r hr (fun p => ?_)
  have hp0 : (0:ℝ) < r ^ p := by positivity
  exact (disc_le_confines (r ^ p) hp0 (hdisc p)).2

theorem confinement_forces_one (r : ℝ) (hr : 0 < r)
    (hdisc : ∀ p : ℕ, discP (r ^ p) ≤ 1/12 ∧ discP ((r⁻¹) ^ p) ≤ 1/12) :
    r = 1 := by
  rcases lt_trichotomy r 1 with h | h | h
  · exfalso
    have hinv : 1 < r⁻¹ := by
      rw [lt_inv_comm₀ (by norm_num : (0:ℝ) < 1) hr]
      simp only [inv_one] at *
      exact h
    exact confinement_kills_r_gt_one r⁻¹ hinv (fun p => (hdisc p).2)
  · exact h
  · exact absurd h (fun hc => confinement_kills_r_gt_one r (lt_of_le_of_lt (le_refl 1) h)
      (fun p => (hdisc p).1))

theorem monomial_gives_E_via_confinement (r : ℝ) (hr : 0 < r) (k : ℤ)
    (hk : r = (φ : ℝ) ^ k) (hle : discP r ≤ 1/12) : k = 0 := by
  obtain ⟨hlo, hhi⟩ := disc_le_confines r hr hle
  by_contra hk0
  have h1 : (1:ℝ) < φ := one_lt_phi
  have hhi3 : 2 / Real.sqrt 3 < (φ : ℝ) := phi_outside_confinement
  rcases lt_trichotomy k 0 with hneg | hzero | hpos
  · -- k ≤ −1  ⟹  r ≤ φ⁻¹ = φ − 1 < √3/2
    have h5' : Real.sqrt 5 < 2.24 := by
      nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 5 by norm_num), Real.sqrt_nonneg 5]
    have hphiU : φ < 1.62 := by unfold φ; linarith
    have h124 : (1.24:ℝ) ≤ Real.sqrt 3 := by
      rw [Real.le_sqrt (by norm_num : (0:ℝ) ≤ 1.24) (by norm_num : (0:ℝ) ≤ 3)]
      norm_num
    have h2 : (φ:ℝ)^k ≤ (φ:ℝ)^(-1:ℤ) := zpow_le_zpow_right₀ (le_of_lt h1) (by omega)
    rw [zpow_neg, zpow_one, phi_inv_eq] at h2
    have h3' : r ≤ φ - 1 := by rw [hk]; exact h2
    have hgoal : φ - 1 < √3 / 2 := by nlinarith
    linarith
  · exact hk0 hzero
  · -- k ≥ 1  ⟹  r ≥ φ > 2/√3
    have : (φ : ℝ) ^ (1 : ℤ) ≤ r := by
      rw [hk]; exact zpow_le_zpow_right₀ (le_of_lt h1) (by omega)
    rw [zpow_one] at this
    linarith

theorem both_arguments_hold (r : ℝ) (hr : 1 < r) :
    ((∀ p : ℕ, discP (r ^ p) ≤ 1/12) → False) ∧
    (∀ p q : ℕ, p < q → discP (r ^ p) < discP (r ^ q)) :=
  ⟨fun h => confinement_kills_r_gt_one r hr h,
   fun p q hpq => disc_strictly_increases_in_p r hr p q hpq⟩

theorem uniform_and_refined_coexist (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|) :
    discP (zeroCoord ρ) ≤ 1/12 :=
  discBound_of_high_gamma ρ h0 h1 hγ

theorem the_audit_of_false_dichotomies (r : ℝ) (hr : 1 < r) :
    ((∀ p : ℕ, discP (r ^ p) ≤ 1/12) → False) ∧
    (∀ p q : ℕ, p < q → discP (r ^ p) < discP (r ^ q)) ∧
    (∀ x : ℝ, 0 < x → discP x ≤ 1/12 →
       Real.sqrt 3 / 2 ≤ x ∧ x ≤ 2 / Real.sqrt 3) :=
  ⟨(both_arguments_hold r hr).1,
   (both_arguments_hold r hr).2,
   fun x hx h => disc_le_confines x hx h⟩

theorem exponent_forced_to_zero (r : ℝ) (hr : 0 < r) (k : ℤ)
    (hk : r = (φ : ℝ) ^ k) (hle : discP r ≤ 1/12) : k = 0 :=
  monomial_gives_E_via_confinement r hr k hk hle

theorem monomial_iff_one_under_confinement (r : ℝ) (hr : 0 < r)
    (hle : discP r ≤ 1/12) :
    (∃ k : ℤ, r = (φ : ℝ) ^ k) ↔ r = 1 := by
  constructor
  · rintro ⟨k, hk⟩
    rw [hk, exponent_forced_to_zero r hr k hk hle, zpow_zero]
  · intro h; exact ⟨0, by rw [h, zpow_zero]⟩

theorem old_window_had_slack :
    ((φ : ℝ)⁻¹ < 1.3 ∧ (1.3 : ℝ) < φ) ∧ (2 / Real.sqrt 3 < 1.3) := by
  have h3 : (0:ℝ) < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
  have hsq : Real.sqrt 3 ^ 2 = 3 := Real.sq_sqrt (by norm_num)
  have h5 : (2.23 : ℝ) < Real.sqrt 5 := by
    nlinarith [Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 5), Real.sqrt_nonneg 5]
  have h5' : Real.sqrt 5 < 2.24 := by
    nlinarith [Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 5), Real.sqrt_nonneg 5]
  have hφ : (1.61 : ℝ) < φ := by unfold φ; linarith
  have hφ2 : (φ : ℝ) < 1.62 := by unfold φ; linarith
  refine ⟨⟨?_, by linarith⟩, ?_⟩
  · rw [inv_lt_iff_one_lt_mul₀ φ_pos]; nlinarith [hφ]
  · rw [div_lt_iff₀ h3]; nlinarith [hsq, h3]

theorem finite_orbit_does_not_escape (r : ℝ) (hr : 0 < r) (n : ℕ) (hn : 0 < n)
    (hfin : r ^ n = r) (hne : r ≠ 1) : n = 1 := by
  by_contra hn1
  have hn2 : 2 ≤ n := by omega
  rcases lt_trichotomy r 1 with h | h | h
  · have : r ^ n < r := by
      calc r ^ n ≤ r ^ 2 := pow_le_pow_of_le_one (le_of_lt hr) (le_of_lt h) hn2
        _ < r := by nlinarith [hr, h]
    linarith [hfin ▸ this]
  · exact hne h
  · have : r < r ^ n := by
      calc r = r ^ 1 := (pow_one r).symm
        _ < r ^ n := pow_lt_pow_right₀ h (by omega)
    linarith [hfin ▸ this]

theorem what_is_missing (r : ℝ) (hr : 0 < r) (hle : discP r ≤ 1/12) :
    ((∃ k : ℤ, r = (φ : ℝ) ^ k) ↔ r = 1) ∧
    ((φ : ℝ)⁻¹ < 1.3 ∧ (1.3 : ℝ) < φ) ∧ (2 / Real.sqrt 3 < 1.3) :=
  ⟨monomial_iff_one_under_confinement r hr hle,
   old_window_had_slack.1, old_window_had_slack.2⟩

theorem realise_strictMono : StrictMono (fun n : ℤ => (φ : ℝ) ^ n) :=
  fun _ _ h => zpow_lt_zpow_right₀ one_lt_phi h

theorem realise_injective : Function.Injective (fun n : ℤ => (φ : ℝ) ^ n) :=
  realise_strictMono.injective

noncomputable def valPhi (r : ℝ) : ℝ := Real.log r / Real.log (φ : ℝ)

theorem valPhi_realise (n : ℤ) : valPhi ((φ : ℝ) ^ n) = (n : ℝ) := by
  unfold valPhi
  have hlog : Real.log ((φ : ℝ) ^ n) = (n : ℝ) * Real.log (φ : ℝ) :=
    Real.log_zpow (φ : ℝ) n
  have hne : Real.log (φ : ℝ) ≠ 0 := ne_of_gt (Real.log_pos one_lt_phi)
  rw [hlog, mul_div_assoc, div_self hne, mul_one]

theorem valPhi_mul (r s : ℝ) (hr : 0 < r) (hs : 0 < s) :
    valPhi (r * s) = valPhi r + valPhi s := by
  unfold valPhi
  rw [Real.log_mul (ne_of_gt hr) (ne_of_gt hs), add_div]

theorem monomial_iff_valPhi_int (r : ℝ) (hr : 0 < r) :
    (∃ k : ℤ, r = (φ : ℝ) ^ k) ↔ ∃ k : ℤ, valPhi r = (k : ℝ) := by
  constructor
  · rintro ⟨k, hk⟩; exact ⟨k, by rw [hk, valPhi_realise]⟩
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_⟩
    have hne : Real.log (φ : ℝ) ≠ 0 := ne_of_gt (Real.log_pos one_lt_phi)
    have hlog : Real.log r = (k : ℝ) * Real.log (φ : ℝ) := by
      unfold valPhi at hk
      field_simp at hk; linarith [hk]
    have : Real.log r = Real.log ((φ : ℝ) ^ k) := by
      rw [Real.log_zpow (φ : ℝ) k]; exact hlog
    exact Real.log_injOn_pos (Set.mem_Ioi.mpr hr)
      (Set.mem_Ioi.mpr (zpow_pos φ_pos k)) this

theorem valPhi_small_under_confinement (r : ℝ) (hr : 0 < r)
    (hlo : Real.sqrt 3 / 2 ≤ r) (hhi : r ≤ 2 / Real.sqrt 3) :
    |valPhi r| ≤ Real.log (2 / Real.sqrt 3) / Real.log (φ : ℝ) := by
  have hlogφ : 0 < Real.log (φ : ℝ) := Real.log_pos one_lt_phi
  have h3 : (0:ℝ) < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
  have hprod : (Real.sqrt 3 / 2) * (2 / Real.sqrt 3) = 1 :=
    confinement_is_inversion_symmetric
  have hup : Real.log r ≤ Real.log (2 / Real.sqrt 3) :=
    Real.log_le_log hr hhi
  have hdn : Real.log (Real.sqrt 3 / 2) ≤ Real.log r :=
    Real.log_le_log (by positivity) hlo
  have hsym : Real.log (Real.sqrt 3 / 2) = - Real.log (2 / Real.sqrt 3) := by
    have := congrArg Real.log hprod
    rw [Real.log_mul (by positivity) (by positivity), Real.log_one] at this
    linarith
  unfold valPhi
  rw [_root_.abs_div]
  rw [abs_of_pos hlogφ]
  rw [div_le_div_iff₀ hlogφ hlogφ]
  rw [mul_le_mul_iff_left₀ hlogφ, abs_le]
  constructor
  · nlinarith [hup, hdn, hsym, hlogφ]
  · nlinarith [hup, hdn, hsym, hlogφ]

def HasDegree : Prop :=
  ∃ deg : Chi5Zero → ℤ, ∀ z : Chi5Zero, (φ : ℝ) ^ (deg z) = zeroCoord z.ρ

theorem hasDegree_gives_monomial (h : HasDegree) (z : Chi5Zero) :
    ∃ k : ℤ, zeroCoord z.ρ = (φ : ℝ) ^ k := by
  obtain ⟨deg, hdeg⟩ := h
  exact ⟨deg z, (hdeg z).symm⟩

theorem the_gap_as_an_object (r : ℝ) (hr : 0 < r) :
    (Function.Injective (fun n : ℤ => (φ : ℝ) ^ n)) ∧
    (∀ n : ℤ, valPhi ((φ : ℝ) ^ n) = (n : ℝ)) ∧
    ((∃ k : ℤ, r = (φ : ℝ) ^ k) ↔ ∃ k : ℤ, valPhi r = (k : ℝ)) :=
  ⟨realise_injective, valPhi_realise, monomial_iff_valPhi_int r hr⟩

theorem hasDegree_gives_indexing (h : HasDegree) :
    ∃ deg : Chi5Zero → ℤ, ∀ z : Chi5Zero, zeroCoord z.ρ = (φ : ℝ) ^ (deg z) := by
  obtain ⟨deg, hdeg⟩ := h
  exact ⟨deg, fun z => (hdeg z).symm⟩

theorem hasDegree_gives_chain_injective (h : HasDegree) (z w : Chi5Zero)
    (heq : zeroCoord z.ρ = zeroCoord w.ρ) :
    ∀ deg : Chi5Zero → ℤ, (∀ u : Chi5Zero, (φ : ℝ) ^ (deg u) = zeroCoord u.ρ) →
      deg z = deg w := by
  intro deg hdeg
  apply realise_injective
  simp only []
  rw [hdeg z, hdeg w, heq]

theorem E_gives_spectral_embedding (reZero : ℂ → ℝ)
    (hE : ∀ ρ : ℂ, 0 < reZero ρ → reZero ρ < 1 → reZero ρ = 1/2) :
    ∀ ρ : ℂ, 0 < reZero ρ → reZero ρ < 1 →
      (reZero ρ = 1/2 ∨ reZero ρ = -(1/4)) :=
  fun ρ h0 h1 => Or.inl (hE ρ h0 h1)

theorem euler_deg_is_bounded (χ₅ deg : ℕ → ℤ) (h : ∀ p : ℕ, p.Prime → p ≠ 5 →
      (χ₅ p = 1 → deg p = 2) ∧ (χ₅ p = -1 → deg p = 1))
    (p : ℕ) (hp : p.Prime) (hp5 : p ≠ 5) (hval : χ₅ p = 1) :
    deg p = 2 := (h p hp hp5).1 hval

theorem the_five_aliases (h : HasDegree) (reZero : ℂ → ℝ)
    (hE : ∀ ρ : ℂ, 0 < reZero ρ → reZero ρ < 1 → reZero ρ = 1/2) :
    (∃ deg : Chi5Zero → ℤ, ∀ z : Chi5Zero, zeroCoord z.ρ = (φ : ℝ) ^ (deg z)) ∧
    (∀ ρ : ℂ, 0 < reZero ρ → reZero ρ < 1 →
       (reZero ρ = 1/2 ∨ reZero ρ = -(1/4))) :=
  ⟨hasDegree_gives_indexing h, E_gives_spectral_embedding reZero hE⟩

theorem fibres_have_two_each :
    (({1, 9} : Finset ℕ).card = 2) ∧ (({13, 17} : Finset ℕ).card = 2) ∧
    (({11, 19} : Finset ℕ).card = 2) ∧ (({3, 7} : Finset ℕ).card = 2) := by
