-- ║   PART 7 — F₁-DESCENT: MONOIDAL CORE (BORGER AXIOMS)                 ║
-- ║                                                                      ║
-- ╚══════════════════════════════════════════════════════════════════════╝

def realise (n : ℤ) : ℝ := φ ^ n

theorem realise_pos (n : ℤ) : 0 < realise n := by
  unfold realise; exact zpow_pos φ_pos _

theorem realise_ne_zero (n : ℤ) : realise n ≠ 0 := ne_of_gt (realise_pos n)

theorem realise_zero : realise 0 = 1 := by
  unfold realise; exact zpow_zero φ

theorem realise_add (m n : ℤ) : realise (m + n) = realise m * realise n := by
  unfold realise
  exact zpow_add₀ φ_ne_zero m n

/-- The Frobenius lift ψ_p, defined on the exponent monoid (ℤ, +). -/
def psi (p : ℕ) : ℤ → ℤ := fun n => (p : ℤ) * n

/-- ψ_p preserves the additive identity. -/
theorem psi_zero (p : ℕ) : psi p 0 = 0 := by unfold psi; ring

/-- ψ_p preserves addition. -/
theorem psi_add (p : ℕ) (m n : ℤ) : psi p (m + n) = psi p m + psi p n := by
  unfold psi; ring

/-- Borger axiom (B1): composition law ψ_p ∘ ψ_q = ψ_{pq}. -/
theorem psi_comp (p q : ℕ) (n : ℤ) :
    psi p (psi q n) = psi (p * q) n := by
  unfold psi; push_cast; ring

theorem psi_commute (p q : ℕ) (n : ℤ) :
    psi p (psi q n) = psi q (psi p n) := by
  rw [psi_comp p q, psi_comp q p, mul_comm p q]

theorem psi_one_eq_id (n : ℤ) : psi 1 n = n := by unfold psi; ring

/-- Borger axiom (B3): realise(ψ_p(n)) = realise(n)^p. -/
theorem psi_realise_pow (p : ℕ) (n : ℤ) :
    realise (psi p n) = realise n ^ p := by
  unfold realise psi
  rw [show (p : ℤ) * n = n * (p : ℤ) from mul_comm _ _]
  rw [zpow_mul φ n (p : ℤ)]
  exact zpow_natCast (φ ^ n) p

/-- Uniqueness: the seed ψ_p(1) = p, plus additivity, determines ψ_p. -/
theorem psi_unique (p : ℕ) (f : ℤ → ℤ)
    (h_add : ∀ m n : ℤ, f (m + n) = f m + f n)
    (h_seed : f 1 = (p : ℤ)) :
    ∀ n : ℤ, f n = psi p n := by
  intro n
  unfold psi
  have h_zero : f 0 = 0 := by
    have h := h_add 0 0
    simp only [add_zero] at h
    linarith
  have h_neg : ∀ k : ℤ, f (-k) = -f k := by
    intro k
    have hsum : f (k + (-k)) = f k + f (-k) := h_add k (-k)
    have hcancel : k + (-k) = 0 := by ring
    rw [hcancel, h_zero] at hsum
    linarith
  have h_nat : ∀ k : ℕ, f (k : ℤ) = (k : ℤ) * f 1 := by
    intro k
    induction k with
    | zero => simp [h_zero]
    | succ j ih =>
      have hcast : ((j + 1 : ℕ) : ℤ) = (j : ℤ) + 1 := by push_cast; ring
      rw [hcast, h_add, ih]
      ring
  by_cases hn : 0 ≤ n
  · have hnat : n = (n.toNat : ℤ) := (Int.toNat_of_nonneg hn).symm
    rw [hnat, h_nat, h_seed]
    ring
  · push Not at hn
    have h_neg_pos : (0 : ℤ) ≤ -n := by linarith
    have hnat : -n = ((-n).toNat : ℤ) := (Int.toNat_of_nonneg h_neg_pos).symm
    have hn_eq : n = -((-n).toNat : ℤ) := by linarith
    rw [hn_eq, h_neg, h_nat, h_seed]
    ring

/-- ψ_2 acts uniformly on ℤ; no special case at p = 2. -/
theorem psi_two_uniform (n : ℤ) : psi 2 n = 2 * n := by
  unfold psi; push_cast; ring

theorem psi_two_realise (n : ℤ) :
    realise (psi 2 n) = realise n ^ 2 :=
  psi_realise_pow 2 n

/-- The reduction of ψ_p modulo 20. -/
def psi_mod20 (p : ℕ) : ZMod 20 → ZMod 20 := fun a => (p : ZMod 20) * a

theorem psi_descent_mod20 (p : ℕ) (n : ℤ) :
    ((psi p n : ℤ) : ZMod 20) = psi_mod20 p ((n : ZMod 20)) := by
  unfold psi psi_mod20
  push_cast; ring

/-- Collected monoidal F₁-descent data. -/
theorem F1_monoidal_descent_data :
    (∀ p q : ℕ, ∀ n : ℤ, psi p (psi q n) = psi (p * q) n) ∧
    (∀ p : ℕ, psi p 0 = 0) ∧
    (∀ p : ℕ, ∀ m n : ℤ, psi p (m + n) = psi p m + psi p n) ∧
    (∀ p : ℕ, ∀ n : ℤ, realise (psi p n) = realise n ^ p) ∧
    (∀ p : ℕ, ∀ f : ℤ → ℤ,
       (∀ m n : ℤ, f (m + n) = f m + f n) →
       f 1 = (p : ℤ) →
       ∀ n : ℤ, f n = psi p n) ∧
    (∀ p : ℕ, ∀ n : ℤ,
       ((psi p n : ℤ) : ZMod 20) = psi_mod20 p ((n : ZMod 20))) :=
⟨psi_comp, psi_zero, psi_add, psi_realise_pow, psi_unique, psi_descent_mod20⟩

/-! ## §7.X Frobenius composition on the unit monoid -/

/-- Frobenius composition: φ^(pq) = (φ^p)^q.
    This is the Λ-ring axiom that makes R_PCF F₁-descent data (Borger). -/
theorem frobenius_composition (p q : ℕ) : φ ^ (p * q) = (φ ^ p) ^ q := by
  rw [← pow_mul]

/-- The three Borger criteria for F₁-descent on R_PCF:
    (1) φ² = φ + 1: generator of all Frobenius lifts;
    (2) functoriality: φ^(pq) = (φ^p)^q;
    (3) additive destruction: a + b ∉ Z₂₀* for a, b ∈ Z₂₀*. -/
theorem F1_descent_data :
    φ ^ 2 = φ + 1 ∧
    (∀ p q : ℕ, φ ^ (p * q) = (φ ^ p) ^ q) ∧
    (∀ a ∈ ZtwentyStar, ∀ b ∈ ZtwentyStar, (a + b) ∉ ZtwentyStar) :=
  ⟨phi_sq, frobenius_composition, add_destroyed⟩


