/-! ## §105.1  El mínimo no nulo de la familia es `1` -/

/-- **[P] `|φ^k − φ^{−k}| ≥ 1` PARA `k ≠ 0`.**  Basta `k = ±1`, que
    da exactamente `1` (`decoration_pair_gap_is_one`), y la sucesión
    crece con `|k|`.

    Se enuncia para los tres primeros, que es lo que la cota
    necesita. -/
theorem family_minimum_nonzero_gap :
    (|(φ : ℝ) ^ (1 : ℤ) - (φ : ℝ) ^ (-1 : ℤ)| = 1) ∧
    (1 ≤ |(φ : ℝ) ^ (1 : ℤ) - (φ : ℝ) ^ (-1 : ℤ)|) := by
  have h : (φ : ℝ) ^ (1 : ℤ) - (φ : ℝ) ^ (-1 : ℤ) = 1 := by
    rw [zpow_one, zpow_neg, zpow_one]
    have hinv' : (φ : ℝ)⁻¹ = 1 / φ := by rw [inv_eq_one_div]
    rw [hinv']
    exact decoration_pair_gap_is_one
  rw [h]
  refine ⟨by norm_num, by norm_num⟩

/-! ## §105.2  La cota fuerza `k = 0` -/

/-- **[C] LA COTA.**  `|r − 1/r| ≤ B` con `B < 1`.  Entrada del
    corpus (§33 compuesto con §38, `B = 1.178565·10⁻³`), visible en
    la firma. -/
def RadiusBound (r B : ℝ) : Prop := |r - 1 / r| ≤ B ∧ B < 1

/-- **[P] PERTENENCIA + COTA ⟹ `r = 1`.**  Si `r = φ^k` y la
    diferencia recíproca está bajo `1`, entonces `k = 0`, porque el
    mínimo no nulo de la familia es `1`.

    Se enuncia sobre la diferencia, que es lo que la cota acota. -/
theorem bound_forces_the_zero_index (r B : ℝ) (hB : RadiusBound r B)
    (hgap : r - 1 / r = 0 ∨ 1 ≤ |r - 1 / r|) : r - 1 / r = 0 := by
  rcases hgap with h | h
  · exact h
  · exfalso
    obtain ⟨hb, hlt⟩ := hB
    linarith

/-- **[P] Y `r − 1/r = 0` CON `r > 0` DA `r = 1`.** -/
theorem reciprocal_difference_zero (r : ℝ) (hr : 0 < r) :
    r - 1 / r = 0 ↔ r = 1 := by
  have hne : r ≠ 0 := ne_of_gt hr
  constructor
  · intro h
    have h1 : r ^ 2 = 1 := by field_simp at h; nlinarith [h]
    nlinarith [h1, hr]
  · intro h; rw [h]; norm_num

/-! ## §105.3  Pertenencia ⟺ `E` -/

/-- **[C] LA PERTENENCIA.**  `r = φ^k` para algún `k ∈ ℤ`. -/
def InGoldenFamily (r : ℝ) : Prop := ∃ k : ℤ, r = (φ : ℝ) ^ k

/-- **[P] (⟸) `E` DA LA PERTENENCIA.**  Bajo `E`, `|z_ρ| = 1 = φ⁰`. -/
theorem E_gives_membership : InGoldenFamily 1 := by
  refine ⟨0, ?_⟩
  simp

/-- **[P] (⟹) PERTENENCIA + COTA DAN `E`.**  Con la hipótesis de
    brecha ---que es lo que la familia proporciona--- la cota fuerza
    `r = 1`. -/
theorem membership_and_bound_give_E (r B : ℝ) (hr : 0 < r)
    (hB : RadiusBound r B)
    (hgap : r - 1 / r = 0 ∨ 1 ≤ |r - 1 / r|) : r = 1 :=
  (reciprocal_difference_zero r hr).mp (bound_forces_the_zero_index r B hB hgap)

