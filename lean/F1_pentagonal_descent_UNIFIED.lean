/-! ## §108.3  La octava: la razón de cardinales -/

/-- **[P] LOS CARDINALES POSIBLES.**  Bajo un grupo de orden `4`, toda
    órbita tiene cardinal `1`, `2` o `4`. -/
theorem orbit_cardinals (n : ℕ) (h : n ∣ 4) : n = 1 ∨ n = 2 ∨ n = 4 := by
  have h4 : n ≤ 4 := Nat.le_of_dvd (by norm_num) h
  interval_cases n <;> simp_all

/-- **[P] EL `1` QUEDA EXCLUIDO PARA UN CERO.**  `|órbita| = 1`
    exigiría `ρ = ρ̄`, es decir `Im ρ = 0`. -/
theorem cardinal_one_excluded (ρ : ℂ) (him : ρ.im ≠ 0) :
    (starRingEnd ℂ) ρ ≠ ρ := by
  intro h
  apply him
  have := congrArg Complex.im h
  simp [Complex.conj_im] at this
  linarith

/-- **[P] LA OCTAVA PATA.**  Con `1` excluido quedan `2` y `4`, y la
    razón es `2/4 = 1/2`.

    **Es un objeto CARDINAL, no un punto fijo**: otro tipo, aunque el
    disparo sea la pata 6. -/
theorem leg_eight_cardinal_ratio : (2 : ℝ) / 4 = 1 / 2 := by norm_num

/-- **[P] LOS PASOS PROPIOS DE LA OCTAVA.**  De los seis, sólo el (5)
    es la pata 6; los demás son suyos. -/
theorem leg_eight_has_its_own_steps (ρ : ℂ) (him : ρ.im ≠ 0) (n : ℕ)
    (h : n ∣ 4) :
    (n = 1 ∨ n = 2 ∨ n = 4) ∧
    ((starRingEnd ℂ) ρ ≠ ρ) ∧
    ((2 : ℝ) / 4 = 1 / 2) :=
  ⟨orbit_cardinals n h, cardinal_one_excluded ρ him, leg_eight_cardinal_ratio⟩

/-! ## §108.4  Las ocho, y la asimetría de tipo -/

