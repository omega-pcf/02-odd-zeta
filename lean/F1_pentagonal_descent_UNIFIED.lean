/-- **[P] Y EL MÁS ÚTIL: el margen no es el obstáculo.**  Mejorar la
    cota no acerca; lo que falta es integralidad, no precisión. -/
theorem margin_is_not_it (ε : ℝ) (hε : 0 < ε) : ∃ γ : ℝ, 0 < γ ∧ 1/2 < ε * γ ^ 2 := by
  refine ⟨Real.sqrt (1 / ε) + 1, by positivity, ?_⟩
  have h1 : Real.sqrt (1/ε) ^ 2 = 1/ε := Real.sq_sqrt (by positivity)
  have h2 : 0 ≤ Real.sqrt (1/ε) := Real.sqrt_nonneg _
  -- ε * (√(1/ε) + 1)² ≥ ε * (√(1/ε))² = ε * (1/ε) = 1 > 1/2
  have h3 : 1 ≤ (Real.sqrt (1/ε) + 1) ^ 2 := by
    rw [add_sq, h1]
    nlinarith [sq_nonneg (Real.sqrt (1/ε) + 1)]
  have h4 : 1 ≤ ε * (Real.sqrt (1/ε) + 1) ^ 2 := by
    nlinarith [show (1:ℝ) = ε * (1/ε) from by field_simp]
  linarith [show (1/2:ℝ) < 1 from by norm_num]

