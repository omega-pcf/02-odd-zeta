section MateSinGBlock

/-
MateSinG.lean — Sprint 101. El gemelo (mate) no usa la realidad del carácter.
Sin compilar [P*]. Entrada clásica [C]: la ecuación funcional de L(s, χ), que relaciona χ con χ̄.
-/

namespace MateSinG
open Complex

/-- Si la ecuación funcional lleva los ceros de `f` a los de `g` por `s ↦ 1 - s`, y `f (conj s) = conj (g s)`
(para `f = L(·, χ)`, `g = L(·, χ̄)`), el conjunto de ceros de `f` es cerrado bajo el gemelo `ρ ↦ 1 - conj ρ`.
No se pide que `f` tenga coeficientes reales. -/
theorem closed_under_mate_of_fe_dual (f g : ℂ → ℂ)
    (hfe : ∀ s, f s = 0 → g (1 - s) = 0)
    (hconj : ∀ s, f ((starRingEnd ℂ) s) = (starRingEnd ℂ) (g s)) :
    ∀ ρ, f ρ = 0 → f (1 - (starRingEnd ℂ) ρ) = 0 := by
  intro ρ h
  have h2 := hconj (1 - ρ)
  rw [hfe ρ h, map_zero] at h2
  simpa [map_sub] using h2

/-- El caso real es el caso `g = f`: es `closed_under_mate_of_fe_rc` del corpus. -/
theorem real_case (f : ℂ → ℂ) (hfe : ∀ s, f s = 0 → f (1 - s) = 0)
    (hconj : ∀ s, f ((starRingEnd ℂ) s) = (starRingEnd ℂ) (f s)) :
    ∀ ρ, f ρ = 0 → f (1 - (starRingEnd ℂ) ρ) = 0 :=
  closed_under_mate_of_fe_dual f f hfe hconj

/-- El gemelo conserva la ordenada y fija `ρ` exactamente si `Re ρ = 1/2` (ya en el corpus: `kmate_fixed_iff`). -/
theorem mate_fixed_iff (ρ : ℂ) : 1 - (starRingEnd ℂ) ρ = ρ ↔ ρ.re = 1 / 2 := by
  constructor
  · intro h
    have := congrArg Complex.re h
    simp at this
    linarith
  · intro h
    apply Complex.ext <;> simp [h]
    norm_num
end MateSinG

end MateSinGBlock

