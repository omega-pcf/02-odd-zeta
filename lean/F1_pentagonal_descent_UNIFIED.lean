/-! ## §117.1  El conjunto de índices, finito -/

/-- Las tres posiciones espectrales ---restatement de `specPos`, §79. -/
def spec₇ : Fin 3 → ℝ
  | 0 => 1 / 2
  | 1 => -(1 / 4)
  | 2 => -(1 / 4)

/-- **[P] EL CONJUNTO DE ÍNDICES TIENE CARDINAL TRES.**  Finito, no
    `ℤ`: es más fino que la familia `{φ^k}` que yo usaba. -/
theorem index_set_card : Fintype.card (Fin 3) = 3 := by decide

/-- **[P] SÓLO `k = 0` ES POSITIVA.** -/
theorem only_zero_positive :
    (0 < spec₇ 0) ∧ (spec₇ 1 < 0) ∧ (spec₇ 2 < 0) := by
  refine ⟨by norm_num [spec₇], by norm_num [spec₇], by norm_num [spec₇]⟩

/-- **[P] UNA POSICIÓN POSITIVA VALE `1/2`.**  Por casos sobre los
    tres índices: el trabajo lo hace la finitud del conjunto. -/
theorem positive_index_gives_half (k : Fin 3) (h : 0 < spec₇ k) :
    spec₇ k = 1 / 2 := by
  fin_cases k
  · rfl
  · exfalso; norm_num [spec₇] at h
  · exfalso; norm_num [spec₇] at h

/-! ## §117.2  La pertenencia, y qué devuelve -/

/-- **[C] LA PERTENENCIA CON ÍNDICE.**  «Existe un índice `k` con
    `spec₇ k = x`».  Es `GDS` restringido a un punto; entrada `[C]`. -/
def HasIndex (x : ℝ) : Prop := ∃ k : Fin 3, x = spec₇ k

/-- **[P] PERTENENCIA MÁS BANDA DAN EL VALOR.**  Éste es el
    rendimiento `position` que yo daba por ausente: la pertenencia
    con índice, más `0 < x`, devuelve `x = 1/2`.

    **Sin cota, sin `√5`, sin brecha.** -/
theorem index_and_strip_give_the_value (x : ℝ) (hx : 0 < x)
    (h : HasIndex x) : x = 1 / 2 := by
  obtain ⟨k, hk⟩ := h
  have hkpos : 0 < spec₇ k := hk ▸ hx
  rw [hk, positive_index_gives_half k hkpos]

/-- **[P] Y LA BANDA EXCLUYE `−1/4` SOLA.**  No hace falta el
    `3.47·10⁻⁷`. -/
theorem strip_alone_excludes (x : ℝ) (h : 0 < x) : x ≠ -(1 / 4) := by
  intro hx; rw [hx] at h; norm_num at h

/-! ## §117.3  La más débil de las tres basta -/

/-- Las tres formas de pertenencia (§79.3). -/
def MemExact₇ (x : ℝ) : Prop := x = 1 / 2
def MemTwoValues₇ (x : ℝ) : Prop := x = 1 / 2 ∨ x = -(1 / 4)

/-- **[P] LA ESPECTRAL IMPLICA LA DE DOS VALORES.**  Ser posición
    espectral es estar en `{1/2, −1/4}`. -/
theorem spectral_implies_two_values (x : ℝ) (h : HasIndex x) :
    MemTwoValues₇ x := by
  obtain ⟨k, hk⟩ := h
  fin_cases k
  · left; rw [hk]; rfl
  · right; rw [hk]; rfl
  · right; rw [hk]; rfl

/-- **[P] Y CON LA BANDA, LA DE DOS VALORES DA LA EXACTA.**  La
    cadena `MemSpectral ⟹ MemTwoValues ⟹ MemExact` bajo `0 < x`.

    **Basta la más débil.** -/
theorem the_weakest_suffices (x : ℝ) (hx : 0 < x) (h : HasIndex x) :
    MemExact₇ x := by
  rcases spectral_implies_two_values x h with hh | hh
  · exact hh
  · exfalso; rw [hh] at hx; norm_num at hx

/-! ## §117.4  El balance -/

/-- **[O] EL BALANCE DE §117.**

    | | §116 dijo | §117 corrige |
    |---|---|---|
    | rendimiento `position` | «falta el enunciado» | **está en L14241, `GDS`** |
    | conjunto de índices | `{φ^k : k ∈ ℤ}`, infinito | **`Fin 3`, finito** |
    | qué hace falta | formular | **probar lo ya formulado** |
    | qué basta | la pertenencia exacta | **la más débil de las tres** |

    **Nada de esto prueba `E`.**  `HasIndex` sigue siendo `[C]`, que
    es `GDS`, cuyo estatuto el corpus marca ABIERTO.  Lo que se
    corrige es mi diagnóstico: no falta escribir el enunciado. -/
theorem the_balance_of_section_117 (x : ℝ) (hx : 0 < x) (h : HasIndex x) :
    (Fintype.card (Fin 3) = 3) ∧
    (x = 1 / 2) ∧
    (MemTwoValues₇ x) ∧
    (∀ y : ℝ, 0 < y → y ≠ -(1 / 4)) :=
  ⟨index_set_card, index_and_strip_give_the_value x hx h,
   spectral_implies_two_values x h, fun y hy => strip_alone_excludes y hy⟩

