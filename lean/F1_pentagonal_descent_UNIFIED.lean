theorem isMonomial_one : IsMonomial (1 : ℝ) :=
  ⟨0, by simp⟩

theorem isMonomial_mul {x y : ℝ} (hx : IsMonomial x) (hy : IsMonomial y) :
    IsMonomial (x * y) := by
  obtain ⟨j, rfl⟩ := hx
  obtain ⟨k, rfl⟩ := hy
  exact ⟨j + k, (zpow_add₀ (ne_of_gt φ_pos) j k).symm⟩

theorem isMonomial_inv {x : ℝ} (hx : IsMonomial x) : IsMonomial x⁻¹ := by
  obtain ⟨k, rfl⟩ := hx
  exact ⟨-k, by rw [zpow_neg]⟩

theorem isMonomial_pos {x : ℝ} (hx : IsMonomial x) : 0 < x := by
  obtain ⟨k, rfl⟩ := hx
  exact zpow_pos φ_pos k

theorem phi_zpow_injective : Function.Injective (fun k : ℤ => (φ : ℝ) ^ k) := by
  intro j k h
  have hne : Real.log (φ : ℝ) ≠ 0 := ne_of_gt (Real.log_pos one_lt_phi)
  have hjk : (j : ℝ) * Real.log (φ : ℝ) = (k : ℝ) * Real.log (φ : ℝ) := by
    calc (j : ℝ) * Real.log φ = Real.log ((φ : ℝ) ^ j) := (Real.log_zpow (φ : ℝ) j).symm
      _ = Real.log ((φ : ℝ) ^ k) := congr_arg Real.log h
      _ = (k : ℝ) * Real.log φ := Real.log_zpow (φ : ℝ) k
  exact_mod_cast mul_right_cancel₀ hne hjk


theorem valPhi_leftInverse (k : ℤ) : valPhi ((φ : ℝ) ^ k) = (k : ℝ) :=
  valPhi_realise k

theorem phi_family_is_a_group :
    IsMonomial (1 : ℝ) ∧
    (∀ x y : ℝ, IsMonomial x → IsMonomial y → IsMonomial (x * y)) ∧
    (∀ x : ℝ, IsMonomial x → IsMonomial x⁻¹) ∧
    Function.Injective (fun k : ℤ => (φ : ℝ) ^ k) :=
  ⟨isMonomial_one, fun _ _ hx hy => isMonomial_mul hx hy,
   fun _ hx => isMonomial_inv hx, phi_zpow_injective⟩

theorem psi_multiplicative_on_the_monoid (p : ℕ) (m n : ℤ) :
    (φ : ℝ) ^ ((p : ℤ) * (m + n)) = (φ : ℝ) ^ ((p : ℤ) * m) * (φ : ℝ) ^ ((p : ℤ) * n) := by
  -- (2026-09-06, Ola 4) STATEMENT-FIX notación: exponente expuesto (probe xpcf8-10)
  rw [mul_add, zpow_add₀ (ne_of_gt φ_pos)]

theorem psi_is_exact_power (p : ℕ) (n : ℤ) :
    (φ : ℝ) ^ ((p : ℤ) * n) = ((φ : ℝ) ^ n) ^ p := by
  -- (2026-09-06, Ola 4) STATEMENT-FIX notación (probe xpcf2)
  rw [mul_comm, zpow_mul, zpow_natCast]

theorem ring_extension_obstruction (p : ℕ) (hp : 2 ≤ p) :
    (φ : ℝ) ^ (2 * p) ≠ (φ : ℝ) ^ p + 1 := by
  have h1 : (1.61 : ℝ) < (φ : ℝ) := by
    have h5 : (2.23 : ℝ) < Real.sqrt 5 := by
      nlinarith [Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 5), Real.sqrt_nonneg 5]
    unfold φ; linarith
  have hp2 : (φ : ℝ) ^ 2 ≤ (φ : ℝ) ^ p := by
    exact pow_le_pow_right₀ (by linarith) hp
  have h2p : (φ : ℝ) ^ (2 * p) = ((φ : ℝ) ^ p) ^ 2 := by
    rw [pow_mul']
  intro hcon
  rw [h2p] at hcon
  have hphisq : (φ:ℝ)^2 = φ + 1 := phi_sq
  have hkey : ((φ:ℝ)^p)^2 - (φ:ℝ)^p - 1 = 0 := by linarith
  have hsq : ((φ:ℝ)^p - φ) * ((φ:ℝ)^p + φ - 1)
      = ((φ:ℝ)^p)^2 - (φ:ℝ)^p - (φ^2 - φ) := by ring
  have hphi2 : φ^2 - φ = 1 := by linear_combination hphisq
  rw [hphi2, hkey] at hsq
  rcases mul_eq_zero.mp hsq with h | h
  · have hpp : (φ:ℝ)^p = φ := by linarith
    rw [hpp] at hp2
    rw [hphisq] at hp2
    linarith
  · have hpp : (φ:ℝ)^p = 1 - φ := by linarith
    rw [hpp] at hp2
    rw [hphisq] at hp2
    linarith

theorem X_PCF_satisfies_Borger (p q : ℕ) (m n : ℤ) :
    ((X_PCF.psi p (X_PCF.psi q n) : ℤ) = (p * q : ℤ) * n) ∧
    ((φ : ℝ) ^ ((p : ℤ) * n) = ((φ : ℝ) ^ n) ^ p) ∧
    ((φ : ℝ) ^ ((p : ℤ) * (m + n))
      = (φ : ℝ) ^ ((p : ℤ) * m) * (φ : ℝ) ^ ((p : ℤ) * n)) := by
  -- (2026-09-06, Ola 4) STATEMENT-FIX notación: exponentes expuestos
  refine ⟨psi_comp p q n, psi_is_exact_power p n,
    psi_multiplicative_on_the_monoid p m n⟩

theorem abstract_squeeze {P : ℝ → Prop} {μ : ℝ}
    (hup : ∀ t : ℝ, P t → t ≤ μ)
    (hself : ∀ t : ℝ, P t → P (1 - t))
    (hhalf : μ = 1 - μ) :
    ∀ t : ℝ, P t → t = 1 - μ := by
  intro t ht
  have h1 : t ≤ μ := hup t ht
  have h2 : 1 - t ≤ μ := hup (1 - t) (hself t ht)
  linarith

theorem abstract_squeeze_half {P : ℝ → Prop}
    (hup : ∀ t : ℝ, P t → t ≤ 1/2)
    (hself : ∀ t : ℝ, P t → P (1 - t)) :
    ∀ t : ℝ, P t → t = 1/2 := by
  intro t ht
  have := abstract_squeeze hup hself (by norm_num) t ht
  linarith [this]

theorem premiseA_gives_upper_bound (reZero : ℂ → ℝ)
    (hemb : SpectralEmbedding reZero) (ρ : ℂ)
    (h0 : 0 < reZero ρ) (h1 : reZero ρ < 1) :
    reZero ρ ≤ 1/2 := by
  rcases hemb ρ h0 h1 with h | h
  · exact h.le
  · linarith

theorem premiseA_is_the_positivity_slot (reZero : ℂ → ℝ)
    (hemb : SpectralEmbedding reZero)
    (hself : ∀ t : ℝ, (∃ ρ : ℂ, 0 < reZero ρ ∧ reZero ρ < 1 ∧ reZero ρ = t) →
              (∃ σ : ℂ, 0 < reZero σ ∧ reZero σ < 1 ∧ reZero σ = 1 - t)) :
    ∀ t : ℝ, (∃ ρ : ℂ, 0 < reZero ρ ∧ reZero ρ < 1 ∧ reZero ρ = t) → t = 1/2 := by
  refine abstract_squeeze_half ?_ hself
  rintro t ⟨ρ, h0, h1, rfl⟩
  exact premiseA_gives_upper_bound reZero hemb ρ h0 h1

