-- BLOCK 24. F1PaperTorus
-- the fluctuation as geometry of the torus, the Weil route and the closing theorem
-- ════════════════════════════════════════════════════════════════════════════

section Block24
/-
  F1Paper/FluctuationTorus.lean — la fluctuación como geometría del toro
  ════════════════════════════════════════════════════════════════════════

  Borrador SIN COMPILAR.  Importa el corpus y usa sus definiciones.

  La lectura:  en la recta de parte real σ, el factor de Euler de L(s, χ₅)
  en el primo p es  (1 − χ₅(p)·p^{−σ}·e^{−iθₚ})⁻¹  con  θₚ = T·log p.
  Tres ingredientes:
    · el signo χ₅(p)  — el Frobenius, que sale de la estructura módulo 20
                         (corpus: el tipo del factor lo fija G);
    · el módulo p^{−σ} — en la línea, p^{−1/2}: el ½ en cada primo, que no
                         depende de la altura;
    · el ángulo θₚ     — un punto de un círculo, uno por primo.
  La fluctuación es una función sobre el toro de todos esos círculos, leída a
  lo largo de la recta  T ↦ (T·log p)ₚ.

  Contenido
    §1  El toro, el factor local y la recta.  Sobre la recta, el factor del
        toro es el factor local del corpus.
    §2  El módulo del término de cada primo no depende del ángulo (el ½).
    §3  Independencia de los log p (dos primos): de la factorización única.
    §4  La fluctuación suavizada como función del toro, y la recta.
    §5  Entradas clásicas, con nombre: densidad de Kronecker, ley de Weyl,
        modelo del toro sin ceros a la derecha de ½, equivalencia de Bagchi.
    §6  El cierre: si la recta es típica (sin ceros a la derecha de ½), la
        ecuación funcional del corpus da la línea.  Demostrado.
-/

noncomputable section
open Real Complex

namespace F1PaperTorus

open F1PCFUnified

/-! ## §1  El toro, el factor local y la recta -/

/-- Un punto del toro: un ángulo por cada primo. -/
abbrev Angles := {p : ℕ // p.Prime} → ℝ

/-- El factor local en el primo `p`, en el punto `θ` del toro, a parte real `σ`. -/
def torusFactor (σ : ℝ) (p : {p : ℕ // p.Prime}) (θ : Angles) : ℂ :=
  (1 - chi5_C (p.1 : ZMod 5) * ((p.1 : ℝ) ^ (-σ) : ℝ) * Complex.exp (-(θ p) * Complex.I))⁻¹

/-- La recta de Kronecker: a la altura `T`, el ángulo del primo `p` es `T·log p`. -/
def line (T : ℝ) : Angles := fun p => T * Real.log p.1

/-- **[P*] Sobre la recta, el factor del toro es el factor local del corpus:**
    `torusFactor σ p (line T) = f_L p (σ + iT)`. -/
theorem torusFactor_on_line (σ T : ℝ) (p : {p : ℕ // p.Prime}) :
    torusFactor σ p (line T) = f_L p.1 ((σ : ℂ) + (T : ℂ) * Complex.I) := by
  have hp0 : (p.1 : ℂ) ≠ 0 := by exact_mod_cast p.2.ne_zero
  have hpos : (0 : ℝ) < p.1 := by exact_mod_cast p.2.pos
  unfold torusFactor line f_L
  congr 1
  congr 1
  rw [mul_assoc]
  congr 1
  -- p^{−(σ+iT)} = p^{−σ} · e^{−iT log p}
  rw [Complex.cpow_def_of_ne_zero hp0, ← Complex.ofReal_natCast,
      ← Complex.ofReal_log hpos.le]
  rw [Real.rpow_def_of_pos hpos, Complex.ofReal_exp, ← Complex.exp_add]
  congr 1
  push_cast
  ring

/-! ## §2  El ½ en cada primo -/

/-- **[P*] El módulo del término de cada primo no depende del ángulo:**
    `|χ₅(p)·p^{−σ}·e^{−iθ}| = p^{−σ}` cuando `χ₅(p) = ±1`.  En la línea, `σ = ½`:
    el módulo es `p^{−1/2}` a cualquier altura. -/
theorem term_modulus_is_height_free (σ θ : ℝ) (p : ℕ) (c : ℂ) (hc : Complex.abs c = 1) :
    Complex.abs (c * ((p : ℝ) ^ (-σ) : ℝ) * Complex.exp (-(θ) * Complex.I)) = (p : ℝ) ^ (-σ) := by
  have hnn : (0 : ℝ) ≤ (p : ℝ) ^ (-σ) := Real.rpow_nonneg (Nat.cast_nonneg p) _
  have he : Complex.abs (Complex.exp (-(θ : ℂ) * Complex.I)) = 1 := by
    rw [show -(θ : ℂ) * Complex.I = ((-θ : ℝ) : ℂ) * Complex.I by push_cast; ring]
    exact Complex.abs_exp_ofReal_mul_I _
  rw [show -(θ : ℂ) * Complex.I = ((-θ : ℝ) : ℂ) * Complex.I by push_cast; ring]
  rw [show -(θ : ℂ) * Complex.I = ((-θ : ℝ) : ℂ) * Complex.I by push_cast; ring] at he
  have hcmul : ∀ a b : ℂ, Complex.abs (a * b) = Complex.abs a * Complex.abs b :=
    fun a b => norm_mul a b
  rw [hcmul, hcmul, hc, he, Complex.abs_ofReal, abs_of_nonneg hnn]
  ring

/-! ## §3  Independencia de los log p (dos primos) -/

/-- **[P*] Factorización única ⟹ log p y log q son independientes sobre ℕ:**
    si `a·log p = b·log q` con `p ≠ q` primos, entonces `a = b = 0`. -/
theorem log_primes_independent (p q : ℕ) (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q)
    (a b : ℕ) (h : (a : ℝ) * Real.log p = (b : ℝ) * Real.log q) : a = 0 ∧ b = 0 := by
  have hp0 : (0 : ℝ) < p := by exact_mod_cast hp.pos
  have hq0 : (0 : ℝ) < q := by exact_mod_cast hq.pos
  -- p^a = q^b en ℝ, luego en ℕ
  have hreal : ((p ^ a : ℕ) : ℝ) = ((q ^ b : ℕ) : ℝ) := by
    push_cast
    have h1 : Real.log ((p : ℝ) ^ a) = Real.log ((q : ℝ) ^ b) := by
      rw [Real.log_pow, Real.log_pow]; exact h
    exact Real.log_injOn_pos (Set.mem_Ioi.mpr (pow_pos hp0 a))
      (Set.mem_Ioi.mpr (pow_pos hq0 b)) h1
  have hnat : p ^ a = q ^ b := by exact_mod_cast hreal
  -- la valuación en p
  have hva : (p ^ a).factorization p = a := by
    rw [Nat.factorization_pow, Finsupp.smul_apply, hp.factorization_self, smul_eq_mul, mul_one]
  have hvb : (q ^ b).factorization p = 0 := by
    rw [Nat.factorization_pow, Finsupp.smul_apply, hq.factorization, Finsupp.single_apply,
      if_neg (Ne.symm hpq), smul_zero]
  have ha : a = 0 := by rw [← hva, hnat, hvb]
  refine ⟨ha, ?_⟩
  rw [ha, pow_zero] at hnat
  have : q ^ b = 1 := hnat.symm
  rcases Nat.pow_eq_one.mp this with h1 | h1
  · exact absurd h1 hq.one_lt.ne'
  · exact h1

/-! ## §4  La fluctuación suavizada, como función del toro -/

/-- La fluctuación suavizada en el punto `θ` del toro, con los primos de `P`, las
    potencias `k ≤ K` y la función de prueba `g`:
    `−4 Σ χ₅(p)ᵏ (log p)/p^{k/2} g(k log p) cos(k θₚ)`. -/
def flucTorus (P : Finset {p : ℕ // p.Prime}) (K : ℕ) (g : ℝ → ℝ) (θ : Angles) : ℝ :=
  -4 * ∑ p ∈ P, ∑ k ∈ Finset.range K,
    ((chi5_Z (p.1 : ZMod 5) : ℝ) ^ (k + 1)) * Real.log p.1 / (p.1 : ℝ) ^ (((k + 1 : ℕ) : ℝ) / 2)
      * g ((k + 1) * Real.log p.1) * Real.cos ((k + 1) * θ p)

/-- **[P*] Sobre la recta, es el lado de los primos de la fórmula explícita.**
    (La forma de la función la fijan χ₅ —la clase módulo 5— y los módulos
    `p^{−k/2}`; lo único que depende de la altura es el punto de la recta.) -/
theorem flucTorus_on_line (P : Finset {p : ℕ // p.Prime}) (K : ℕ) (g : ℝ → ℝ) (T : ℝ) :
    flucTorus P K g (line T)
      = -4 * ∑ p ∈ P, ∑ k ∈ Finset.range K,
          ((chi5_Z (p.1 : ZMod 5) : ℝ) ^ (k + 1)) * Real.log p.1 / (p.1 : ℝ) ^ (((k + 1 : ℕ) : ℝ) / 2)
            * g ((k + 1) * Real.log p.1) * Real.cos ((k + 1) * (T * Real.log p.1)) := by
  rfl

/-! ## §5  Entradas clásicas, con nombre -/

/-- **[C] Kronecker (dos primos).**  Si `log p / log q` es irracional, los puntos
    `a·(log p/log q) + b` son densos.  (Es la proposición `TwoIndexDense` del
    corpus aplicada a `x = log p / log q`; la irracionalidad es §3.) -/
def KroneckerTwoPrimes (p q : ℕ) : Prop :=
  ∀ y : ℝ, ∀ ε > 0, ∃ a b : ℤ, |(a : ℝ) * (Real.log p / Real.log q) + (b : ℝ) - y| < ε

/-- **[C] Weyl: la ley de la fluctuación es la del toro.**  Para toda función
    continua acotada `F`, el promedio de `F(flucTorus (line T))` sobre `T ∈ [0, X]`
    tiende al promedio de `F ∘ flucTorus` sobre el toro (con `P` finito).
    [N] comprobado: línea verdadera y puntos al azar del toro tienen la misma
    distribución (Kolmogorov–Smirnov, valor p 0.14). -/
def WeylLaw (P : Finset {p : ℕ // p.Prime}) (K : ℕ) (g : ℝ → ℝ)
    (lineAvg : (ℝ → ℝ) → ℝ) (torusAvg : (Angles → ℝ) → ℝ) : Prop :=
  ∀ F : ℝ → ℝ, Continuous F →
    lineAvg (fun T => F (flucTorus P K g (line T))) = torusAvg (fun θ => F (flucTorus P K g θ))

/-- **[C] El toro no tiene ceros a la derecha de ½ (Bohr–Jessen, Kolmogorov).**
    Para casi todo punto `θ` del toro y todo `σ > ½`, el producto de los factores
    del toro converge y no es cero.  Se deja como proposición sobre un conjunto
    `Typ` de puntos típicos. -/
def TorusNonvanishing (Typ : Set Angles) (prod : ℝ → Angles → ℂ) : Prop :=
  ∀ θ ∈ Typ, ∀ σ : ℝ, 1 / 2 < σ → prod σ θ ≠ 0

/-- **[C] Bagchi.**  La hipótesis de Riemann para L(s, χ₅) equivale a que la
    función sea fuertemente recurrente a lo largo de la recta. -/
def BagchiEquivalence (StrongRecurrence : Prop) : Prop :=
  StrongRecurrence ↔
    ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 → DirichletCharacter.LFunction chi5_D ρ = 0 → ρ.re = 1 / 2

/-! ## §6  El cierre -/

/-- **[O] La recta es típica:** a lo largo de la recta, `L(s, χ₅)` no se anula a la
    derecha de ½ dentro de la franja.  Es lo que el modelo del toro da para casi
    todo punto, pedido para la recta concreta. -/
def LineIsTypical : Prop :=
  ∀ s : ℂ, 1 / 2 < s.re → s.re < 1 → DirichletCharacter.LFunction chi5_D s ≠ 0

/-- **[P*] Si la recta es típica, todo cero de la franja está en la línea.**
    La mitad izquierda la da la ecuación funcional del corpus: si un cero
    tuviera parte real menor que ½, su compañero `1 − ρ` sería un cero a la
    derecha de ½. -/
theorem typical_line_gives_the_line (hT : LineIsTypical) (ρ : ℂ) (h0 : 0 < ρ.re)
    (h1 : ρ.re < 1) (hz : DirichletCharacter.LFunction chi5_D ρ = 0) : ρ.re = 1 / 2 := by
  by_contra hne
  rcases lt_or_gt_of_ne hne with hlt | hgt
  · have hz' := functionalEquation_chi5_discharged ρ h0 h1 hz
    have hre : (1 - ρ).re = 1 - ρ.re := by simp [Complex.sub_re]
    exact hT (1 - ρ) (by rw [hre]; linarith) (by rw [hre]; linarith) hz'
  · exact hT ρ hgt h1 hz


/-! ## §7  El lado aditivo: la estructura módulo 20 da la convergencia en toda la franja -/

/-- Las sumas parciales del carácter: `Σ_{n<N} χ₅(n)`. -/
def partialChi (N : ℕ) : ℤ := ∑ n ∈ Finset.range N, F1CW.chi5 n

/-- El patrón de las sumas parciales según `N mod 5`: `0, 0, 1, 0, −1`. -/
def chiPattern (r : ℕ) : ℤ := if r = 2 then 1 else if r = 4 then -1 else 0

/-- **[P*] Las sumas parciales de χ₅ dependen solo de `N mod 5`** (periodicidad:
    en cada periodo χ₅ vale `0, 1, −1, −1, 1` y suma cero). -/
theorem partialChi_eq (N : ℕ) : partialChi N = chiPattern (N % 5) := by
  induction N with
  | zero => simp [partialChi, chiPattern]
  | succ N ih =>
    have hstep : partialChi (N + 1) = partialChi N + F1CW.chi5 N := Finset.sum_range_succ _ _
    rw [hstep, ih]
    unfold F1CW.chi5 chiPattern
    have h5 : N % 5 < 5 := Nat.mod_lt _ (by norm_num)
    have hs : (N + 1) % 5 = (N % 5 + 1) % 5 := by omega
    rw [hs]
    generalize N % 5 = r at h5 ⊢
    interval_cases r <;> simp

/-- **[P*] Las sumas parciales de χ₅ están acotadas por 1, para todo N a la vez.**
    Es la estructura módulo 5 (dentro de la de módulo 20) actuando sobre todos
    los enteros simultáneamente. -/
theorem partialChi_bounded (N : ℕ) : |partialChi N| ≤ 1 := by
  rw [partialChi_eq]
  unfold chiPattern
  split_ifs <;> simp

/-- **[C] Criterio de Dirichlet ⟹ la serie aditiva converge a L en toda la región
    `Re s > 0`**, para cada altura: sumas parciales acotadas (arriba) y `n^{−s}` de
    variación acotada.  Se deja con nombre; la acotación, que es lo que aporta la
    estructura, está probada. -/
def AdditiveSeriesConverges : Prop :=
  ∀ s : ℂ, 0 < s.re →
    Filter.Tendsto (fun N : ℕ => ∑ n ∈ Finset.range N, (F1CW.chi5 n : ℂ) * (n : ℂ) ^ (-s))
      Filter.atTop (nhds (DirichletCharacter.LFunction chi5_D s))

/-- **[C] No hay ceros con `Re s ≥ 1`** (en Mathlib: la no anulación de las
    funciones L de Dirichlet en `Re s ≥ 1`). -/
def NonvanishingFromOne : Prop :=
  ∀ s : ℂ, 1 ≤ s.re → DirichletCharacter.LFunction chi5_D s ≠ 0

/-! ## §8  Lo que falta: el transporte del lado aditivo al multiplicativo -/

/-- **[O] El transporte.**  En la banda `½ < Re s < 1`, `L(s, χ₅)` —cuya serie
    aditiva converge por §7— es la exponencial de un logaritmo: la forma que
    tiene cuando el producto de Euler (lado multiplicativo) converge a ella a
    través de la suma de los logaritmos de sus factores.
    [N]: a lo largo de la recta, los productos parciales de Euler se acercan
    al valor de L (σ = 0.75: error relativo de 2.7 % con primos hasta 10³ a 0.2 %
    hasta 2·10⁶, para T = 14 y 60). -/
def LogTransport : Prop :=
  ∀ s : ℂ, 1 / 2 < s.re → s.re < 1 → ∃ z : ℂ, DirichletCharacter.LFunction chi5_D s = Complex.exp z

/-- **[P*] El transporte da la recta típica** (una exponencial no se anula). -/
theorem logTransport_gives_typical (h : LogTransport) : LineIsTypical := by
  intro s h1 h2
  obtain ⟨z, hz⟩ := h s h1 h2
  rw [hz]
  exact Complex.exp_ne_zero z

/-- **[P*] La cadena completa.**  Estructura módulo 20 (convergencia aditiva) +
    Hecke (ecuación funcional, del corpus) + transporte ⟹ todo cero de la franja
    está en la línea.  El único eslabón abierto es el transporte. -/
theorem transport_gives_the_line (h : LogTransport) (ρ : ℂ) (h0 : 0 < ρ.re)
    (h1 : ρ.re < 1) (hz : DirichletCharacter.LFunction chi5_D ρ = 0) : ρ.re = 1 / 2 :=
  typical_line_gives_the_line (logTransport_gives_typical h) ρ h0 h1 hz


/-! ## §9  El transporte es el bloque con carácter del corpus, y su límite está forzado

  El corpus (`PCF_sesion_completa`, sección 24) ya redujo lo abierto a su forma
  asintótica: con la familia de Fejér `g_L`, el lado de los primos se parte en
  tres bloques, `−P = k₁ + k₂ + k₃`:
    · `k₁`, el bloque con carácter: −2 Σ χ₅(p) (log p/√p) g_L(log p);
    · `k₂`, el de cuadrados: SIN carácter, porque χ₅(p²) = 1 (probado);
      es una suma de Mertens, `k₂ = −L + O(1)`, incondicional;
    · `k₃`, potencias altas: converge, incondicional.
  y prueba que lo abierto es exactamente que `k₁ − L` converja
  (`CharacterBlockConverges`).  Aquí se enlaza con el transporte y se nombra
  el límite que la estructura fuerza. -/

/-- **[C] El transporte es el bloque con carácter:** que `L` sea la exponencial
    de la suma de los logaritmos de los factores de Euler en la banda equivale
    a que el bloque con carácter converja (fórmula explícita con la familia de
    Fejér). -/
def TransportIsTheCharacterBlock (k₁ : ℝ → ℝ) : Prop :=
  LogTransport ↔ CharacterBlockConverges k₁

/-- **[P*] Con esa equivalencia, el bloque con carácter da la línea.** -/
theorem character_block_gives_the_line (k₁ : ℝ → ℝ) (hE : TransportIsTheCharacterBlock k₁)
    (hk : CharacterBlockConverges k₁) (ρ : ℂ) (h0 : 0 < ρ.re) (h1 : ρ.re < 1)
    (hz : DirichletCharacter.LFunction chi5_D ρ = 0) : ρ.re = 1 / 2 :=
  transport_gives_the_line (hE.mpr hk) ρ h0 h1 hz

/-- El valor del núcleo arquimediano: `−K(0) = γ + log 8 + π/2 + log π − log 5`
    (el conductor en el núcleo: `conductor_in_archimedean_kernel`). -/
def kernelValue : ℝ :=
  Real.eulerMascheroniConstant + Real.log 8 + Real.pi / 2 + Real.log Real.pi - Real.log 5

/-- **El límite forzado del bloque con carácter.**  Si la línea vale, `k₁ − L`
    converge a `−K(0) − c₂ − c₃`, donde `c₂ = −2(B − log 5/5)` sale de la
    constante de Mertens `B` (sin el primo ramificado) y `c₃` es la suma
    absolutamente convergente de las potencias altas.  Ningún parámetro es
    libre: es `leading_coefficient_is_forced` del corpus.
    [N]: `c₂ = 3.3089`, `c₃ = 0.5340`, límite forzado `−0.0802`; la
    extrapolación de las medidas hasta primos `< e¹⁸` da `−0.11`, con el mismo
    error de extrapolación (≈ 0.06) que en `k₂ + L`. -/
def forcedLimit (mertensB c₃ : ℝ) : ℝ :=
  kernelValue - (-2 * (mertensB - Real.log 5 / 5)) - c₃

/-- **[O] Lo que falta, en una de sus formas:** que el bloque con carácter
    converja, y entonces a su límite forzado. -/
def CharacterBlockToForcedLimit (k₁ : ℝ → ℝ) (mertensB c₃ : ℝ) : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ L₀ : ℝ, ∀ L : ℝ, L₀ ≤ L → |k₁ L - L - forcedLimit mertensB c₃| ≤ ε

theorem forced_limit_gives_convergence (k₁ : ℝ → ℝ) (B c₃ : ℝ)
    (h : CharacterBlockToForcedLimit k₁ B c₃) : CharacterBlockConverges k₁ :=
  ⟨forcedLimit B c₃, h⟩


/-! ## §10  Los tres caracteres de G a la vez, y la positividad de Fejér

  G manda cada primo p ∤ 10 a (χ₄(p), χ₅(p)).  Sus tres caracteres no
  triviales son χ₄ (ℚ(i)), χ₅ (ℚ(√5)) y χ₂₀ = χ₄χ₅ (ℚ(√−5)).  Juntos, con el
  trivial, detectan la fibra núcleo de G: los primos ≡ 1, 9 (mod 20), que se
  descomponen totalmente en ℚ(i, √5).  Así la estructura módulo 20 empaqueta
  los tres enunciados abiertos (uno por carácter) en uno: la carrera de la
  fibra núcleo. -/

/-- **[P*] La fibra núcleo de G, detectada por sus cuatro caracteres:**
    para `n` impar y primo con 5, `1 + χ₄ + χ₅ + χ₂₀ = 4` si `n ≡ 1, 9 (mod 20)`
    y `0` en otro caso. -/
theorem kernel_fibre_indicator (n : ℕ) (h2 : n % 2 = 1) (h5 : n % 5 ≠ 0) :
    1 + F1v2.chi4N n + F1CW.chi5 n + F1v2.chi20N n
      = if n % 20 = 1 ∨ n % 20 = 9 then 4 else 0 := by
  have h4r : n % 4 = (n % 20) % 4 := (Nat.mod_mod_of_dvd n (by norm_num : 4 ∣ 20)).symm
  have h5r : n % 5 = (n % 20) % 5 := (Nat.mod_mod_of_dvd n (by norm_num : 5 ∣ 20)).symm
  have hr2 : (n % 20) % 2 = 1 := by omega
  have hr5 : (n % 20) % 5 ≠ 0 := by omega
  have hlt : n % 20 < 20 := Nat.mod_lt _ (by norm_num)
  unfold F1v2.chi20N F1v2.chi4N F1CW.chi5
  rw [h4r, h5r]
  generalize n % 20 = r at hr2 hr5 hlt ⊢
  interval_cases r <;> first | omega | simp

/-- El valor en 0 de la densidad arquimediana de un carácter primitivo de
    conductor `q` y paridad `a` (0 par, 1 impar): `Ω(0) = log(q/π) + ψ((2a+1)/4)`.
    Es `−(límite forzado del total)`: 3.7627 para χ₅ (q = 5, par), 0.8443 para χ₄
    (q = 4, impar), −0.7651 para χ₂₀ (q = 20, impar), con signo cambiado. -/
def archAtZero (q a : ℝ) : ℝ :=
  Real.log (q / Real.pi) + Real.digamma ((2 * a + 1) / 4)

/-- El núcleo de Fejér en la variable de altura: `h_L(r) = 2L (sin(Lr)/(Lr))²`,
    con `h_L(0) = 2L`. -/
def fejerKernel (L r : ℝ) : ℝ := if r = 0 then 2 * L else 2 * L * (Real.sin (L * r) / (L * r)) ^ 2

/-- **[P*] El núcleo de Fejér es no negativo.** -/
theorem fejerKernel_nonneg (L r : ℝ) (hL : 0 ≤ L) : 0 ≤ fejerKernel L r := by
  unfold fejerKernel
  split_ifs
  · linarith
  · positivity

/-- **[P*] Positividad de Fejér:** si todas las alturas de un conjunto finito de
    ceros son reales (ceros en la línea), su suma de Fejér es no negativa. -/
theorem fejer_sum_nonneg (L : ℝ) (hL : 0 ≤ L) (γs : Finset ℝ) :
    0 ≤ ∑ γ ∈ γs, fejerKernel L γ :=
  Finset.sum_nonneg (fun γ _ => fejerKernel_nonneg L γ hL)

/-- **[O] Lo abierto, en su cara de ceros y medible desde los primos.**  Para el
    carácter de conductor `q`, la suma de Fejér sobre los ceros, calculada como
    (lado de los primos) + (término arquimediano), tiende a 0.
    [C] Por la fórmula explícita es lo mismo que `CharacterBlockToForcedLimit`.
    [N] Calculada solo con primos hasta e¹⁸ y el término arquimediano, es
    positiva y decrece para χ₄ (0.079 → 0.019) y χ₅ (0.077 → 0.011), y positiva
    y oscilante para χ₂₀ (0.46 → 0.08); para χ₅ coincide con la suma sobre los
    397 ceros calculados (diferencia 3·10⁻⁴ en 2L = 18). -/
def FejerDecay (Z : ℝ → ℝ) : Prop :=
  Filter.Tendsto Z Filter.atTop (nhds 0)


/-! ## §11  El lado directo está acotado; lo abierto es el inverso

  El lado aditivo de la estructura (los coeficientes χ₅(n) de L) tiene sumas
  parciales acotadas por 1 (§7).  Por sumación de Abel, eso acota cualquier
  bloque de enteros con peso decreciente.  Lo que falta es lo mismo para el
  INVERSO de la estructura: los coeficientes de 1/L son μ(n)χ₅(n), y lo que
  se necesita es que sus sumas parciales crezcan a lo más como √y. -/

/-- **[P*] Sumación de Abel con sumas parciales acotadas:** si las sumas
    parciales de `a` están acotadas por 1 y `f` es decreciente y no negativa,
    entonces `|Σ_{n<N} f(n) a(n)| ≤ f(0)`, para todo `N`. -/
theorem abel_bound (a f : ℕ → ℝ) (hS : ∀ N, |∑ n ∈ Finset.range N, a n| ≤ 1)
    (hf : Antitone f) (hf0 : ∀ n, 0 ≤ f n) (N : ℕ) :
    |∑ n ∈ Finset.range N, f n * a n| ≤ f 0 := by
  have h := Finset.sum_range_by_parts f a N
  simp only [smul_eq_mul] at h
  rw [h]
  have h1 : |f (N - 1) * ∑ i ∈ Finset.range N, a i| ≤ f (N - 1) := by
    rw [abs_mul, abs_of_nonneg (hf0 _)]
    simpa using mul_le_mul_of_nonneg_left (hS N) (hf0 (N - 1))
  have h2 : |∑ i ∈ Finset.range (N - 1), (f (i + 1) - f i) * ∑ j ∈ Finset.range (i + 1), a j|
      ≤ ∑ i ∈ Finset.range (N - 1), (f i - f (i + 1)) := by
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum ?_)
    intro i _
    have hd : 0 ≤ f i - f (i + 1) := by linarith [hf (Nat.le_succ i)]
    rw [abs_mul, show |f (i + 1) - f i| = f i - f (i + 1) by
      rw [abs_sub_comm]; exact abs_of_nonneg hd]
    simpa using mul_le_mul_of_nonneg_left (hS (i + 1)) hd
  have htel : ∑ i ∈ Finset.range (N - 1), (f i - f (i + 1)) = f 0 - f (N - 1) :=
    Finset.sum_range_sub' f (N - 1)
  calc |f (N - 1) * ∑ i ∈ Finset.range N, a i
        - ∑ i ∈ Finset.range (N - 1), (f (i + 1) - f i) * ∑ j ∈ Finset.range (i + 1), a j|
      ≤ |f (N - 1) * ∑ i ∈ Finset.range N, a i|
        + |∑ i ∈ Finset.range (N - 1), (f (i + 1) - f i) * ∑ j ∈ Finset.range (i + 1), a j| := by
        have := abs_add_le (f (N - 1) * ∑ i ∈ Finset.range N, a i)
          (-(∑ i ∈ Finset.range (N - 1), (f (i + 1) - f i) * ∑ j ∈ Finset.range (i + 1), a j))
        simpa [sub_eq_add_neg, abs_neg] using this
    _ ≤ f (N - 1) + (f 0 - f (N - 1)) := by rw [← htel]; exact add_le_add h1 h2
    _ = f 0 := by ring

/-- **[P*] El bloque de enteros de χ₅ está acotado, con cualquier peso
    decreciente y para todo N a la vez.**  Es el lado directo de la estructura:
    la periodicidad módulo 5 controla todos los enteros simultáneamente. -/
theorem integer_block_bounded (f : ℕ → ℝ) (hf : Antitone f) (hf0 : ∀ n, 0 ≤ f n) (N : ℕ) :
    |∑ n ∈ Finset.range N, f n * (F1CW.chi5 n : ℝ)| ≤ f 0 := by
  apply abel_bound (fun n => (F1CW.chi5 n : ℝ)) f _ hf hf0 N
  intro M
  have h := partialChi_bounded M
  unfold partialChi at h
  show |∑ n ∈ Finset.range M, ((F1CW.chi5 n : ℤ) : ℝ)| ≤ 1
  exact_mod_cast h

/-- **[O] Lo abierto, en su forma última: el inverso de la estructura.**
    Las sumas parciales de los coeficientes de 1/L(s, χ₅), que son μ(n)χ₅(n),
    crecen a lo más como `y^{1/2+ε}`.
    [N]: hasta `y = 3·10⁷`, `|Σ_{n≤y} μ(n)χ(n)| / √y ≤ 1.23` para χ₅, `≤ 0.62` para
    χ₄ y `≤ 0.91` para χ₂₀; entre 10⁷ y 3·10⁷, entre 0.50 y 0.65.  En cambio las
    sumas del lado directo, Σ χ(n), nunca pasan de 1 (χ₄, χ₅) o de 4 (χ₂₀). -/
def InverseStructureBound : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, ∀ y : ℕ, 1 ≤ y →
    |∑ n ∈ Finset.range (y + 1), ((ArithmeticFunction.moebius n : ℤ) : ℝ) * (F1CW.chi5 n : ℝ)|
      ≤ C * (y : ℝ) ^ ((1 : ℝ) / 2 + ε)

/-- **[C] Del inverso acotado a la representación inversa.**  Con esa cota, la
    serie de Dirichlet de μχ₅ converge en `Re s > ½` (sumación de Abel) y es
    `1/L` allí (continuación analítica): existe `g` con `L(s)·g = 1`. -/
def InverseRepresentation : Prop :=
  ∀ s : ℂ, 1 / 2 < s.re → s.re < 1 →
    ∃ g : ℂ, DirichletCharacter.LFunction chi5_D s * g = 1

/-- **[P*] Una función con inverso no se anula:** la representación inversa
    da la recta típica, y con Hecke, la línea. -/
theorem inverse_gives_typical (h : InverseRepresentation) : LineIsTypical := by
  intro s h1 h2 hz
  obtain ⟨g, hg⟩ := h s h1 h2
  rw [hz, zero_mul] at hg
  exact zero_ne_one hg

theorem inverse_gives_the_line (h : InverseRepresentation) (ρ : ℂ) (h0 : 0 < ρ.re)
    (h1 : ρ.re < 1) (hz : DirichletCharacter.LFunction chi5_D ρ = 0) : ρ.re = 1 / 2 :=
  typical_line_gives_the_line (inverse_gives_typical h) ρ h0 h1 hz


/-! ## §12  El paso al inverso tiene que usar la multiplicatividad

  Hay una sucesión periódica módulo 5 con sumas parciales acotadas y con la
  misma ecuación funcional que L(s, χ₅), cuya serie SÍ tiene ceros fuera de la
  línea: la función de Davenport–Heilbronn, con coeficientes 1, κ, −κ, −1, 0
  (κ = (√(10 − 2√5) − 2)/(√5 − 1) ≈ 0.284) en las clases 1, 2, 3, 4, 0.  Su lado
  directo es del mismo tipo que el de χ₅; lo que le falta es ser multiplicativa.
  Por eso ninguna prueba del paso al inverso puede usar solo la periodicidad y
  la acotación: tiene que usar que χ₅ es multiplicativo — que G es un
  homomorfismo. -/

/-- **[P*] χ₅ es completamente multiplicativo** (es la segunda componente del
    homomorfismo G, leída en los enteros). -/
theorem chi5_mul (a b : ℕ) : F1CW.chi5 (a * b) = F1CW.chi5 a * F1CW.chi5 b := by
  unfold F1CW.chi5
  rw [Nat.mul_mod]
  have ha : a % 5 < 5 := Nat.mod_lt _ (by norm_num)
  have hb : b % 5 < 5 := Nat.mod_lt _ (by norm_num)
  generalize a % 5 = x at ha ⊢
  generalize b % 5 = y at hb ⊢
  interval_cases x <;> interval_cases y <;> simp

/-- **[P*] Por la multiplicatividad, el inverso de la estructura es explícito:**
    `Σ_{d ∣ n} μ(d)χ₅(d)χ₅(n/d) = [n = 1]`, es decir, los coeficientes de `1/L` son
    `μ(n)χ₅(n)`.  (Para Davenport–Heilbronn no existe tal fórmula.) -/
theorem inverse_of_the_structure (n : ℕ) :
    ∑ d ∈ n.divisors, (ArithmeticFunction.moebius d : ℤ) * F1CW.chi5 d * F1CW.chi5 (n / d)
      = if n = 1 then 1 else 0 := by
  have hsum : ∑ d ∈ n.divisors, (ArithmeticFunction.moebius d : ℤ) = if n = 1 then 1 else 0 := by
    rw [← ArithmeticFunction.coe_mul_zeta_apply, ArithmeticFunction.moebius_mul_coe_zeta,
      ArithmeticFunction.one_apply]
  have h : ∀ d ∈ n.divisors,
      (ArithmeticFunction.moebius d : ℤ) * F1CW.chi5 d * F1CW.chi5 (n / d)
        = F1CW.chi5 n * (ArithmeticFunction.moebius d : ℤ) := by
    intro d hd
    have hdvd := Nat.dvd_of_mem_divisors hd
    rw [mul_assoc, ← chi5_mul, Nat.mul_div_cancel' hdvd]
    ring
  rw [Finset.sum_congr rfl h, ← Finset.mul_sum, hsum]
  split_ifs with h1
  · subst h1; simp [F1CW.chi5]
  · simp

/-- **[C] La periodicidad y la acotación no bastan (Davenport–Heilbronn, 1936).**
    Existe una sucesión real periódica módulo 5, con sumas parciales acotadas y la
    ecuación funcional de conductor 5, cuya serie de Dirichlet tiene un cero con
    parte real mayor que ½ (el primero, ≈ 0.8085 + 85.699 i).
    [N]: el máximo de las sumas parciales de su inverso crece como y^{0.788}
    (hasta 3·10⁶), frente a y^{0.443} para μχ₅. -/
def PeriodicBoundedIsNotEnough : Prop :=
  ∃ a : ℕ → ℝ, (∀ n, a (n + 5) = a n) ∧ (∃ C, ∀ N, |∑ n ∈ Finset.range N, a n| ≤ C) ∧
    ∃ ρ : ℂ, 1 / 2 < ρ.re ∧ ρ.re < 1 ∧
      Filter.Tendsto (fun N : ℕ => ∑ n ∈ Finset.range N, (a n : ℂ) * (n : ℂ) ^ (-ρ))
        Filter.atTop (nhds 0)


/-! ## §13  Lo que la multiplicatividad da: positividad círculo por círculo

  El producto de Euler es un producto sobre los círculos del toro.  La
  multiplicatividad convierte una positividad en CADA círculo en una
  positividad del producto entero (Mertens, de la Vallée Poussin).  El signo
  de Frobenius χ₅(p) = −1 es media vuelta del círculo (e^{iπ} = −1), y la
  positividad sobrevive a la media vuelta. -/

/-- **[P*] La desigualdad 3-4-1 con el signo de Frobenius:** para `c = ±1`,
    `3 + 4c·cos x + cos 2x = 2(1 + c·cos x)² ≥ 0`. -/
theorem three_four_one_signed (x c : ℝ) (hc : c = 1 ∨ c = -1) :
    0 ≤ 3 + 4 * c * Real.cos x + Real.cos (2 * x) := by
  have h2 : Real.cos (2 * x) = 2 * Real.cos x ^ 2 - 1 := Real.cos_two_mul x
  have hcc : c ^ 2 = 1 := by rcases hc with h | h <;> rw [h] <;> norm_num
  rw [h2]
  nlinarith [sq_nonneg (1 + c * Real.cos x), hcc]

/-- **[P*] Positividad en el círculo del primo `p`, para cada potencia `k`:**
    el término `(r^k/k)(3 + 4χ₅(p)^k cos(kθ) + cos(2kθ))` es no negativo, con
    `r = p^{−σ}` y `θ = t log p` el ángulo del círculo. -/
theorem circle_positivity (p k : ℕ) (r θ : ℝ) (hr : 0 ≤ r) (hk : 0 < k)
    (hp5 : p % 5 ≠ 0) :
    0 ≤ r ^ k / k * (3 + 4 * ((F1CW.chi5 p : ℝ) ^ k) * Real.cos (k * θ) + Real.cos (2 * (k * θ))) := by
  have hc : ((F1CW.chi5 p : ℝ) ^ k) = 1 ∨ ((F1CW.chi5 p : ℝ) ^ k) = -1 := by
    have h1 : (F1CW.chi5 p : ℝ) = 1 ∨ (F1CW.chi5 p : ℝ) = -1 := by
      unfold F1CW.chi5
      split_ifs <;> simp_all
    rcases h1 with h | h
    · left; rw [h, one_pow]
    · rw [h]; rcases neg_one_pow_eq_or ℝ k with h' | h'
      · left; exact h'
      · right; exact h'
  exact mul_nonneg (by positivity) (three_four_one_signed (k * θ) _ hc)

/-- **[C] Mertens / de la Vallée Poussin.**  Sumando la positividad de todos los
    círculos (válido con convergencia absoluta, `σ > 1`):
    `ζ₅(σ)³ · |L(σ + it, χ₅)|⁴ · |ζ₅(σ + 2it)| ≥ 1`, con `ζ₅` la zeta sin el factor
    en 5.  De ahí sale la no anulación en `Re s = 1` y una región sin ceros
    `σ > 1 − c/log |t|`.
    [N]: el mínimo en `t ≤ 120` del producto (con `|ζ₅(σ)|`) sigue ≥ 1 hasta
    `σ ≈ 0.9` y cae por debajo después (0.148 en σ = 0.8, 3·10⁻⁴ en σ = 0.6).  La
    positividad círculo por círculo, sola, no llega a la banda. -/
def MertensPositivity : Prop :=
  ∀ σ t : ℝ, 1 < σ →
    1 ≤ Complex.abs (riemannZeta σ * (1 - (5 : ℂ) ^ (-(σ : ℂ)))) ^ 3
        * Complex.abs (DirichletCharacter.LFunction chi5_D (σ + t * Complex.I)) ^ 4
        * Complex.abs (riemannZeta (σ + 2 * t * Complex.I) * (1 - (5 : ℂ) ^ (-((σ : ℂ) + 2 * t * Complex.I))))


/-! ## §14  La positividad es un balance entre las dos clases de órbita de Klein

  Con la ventana de Fejér, los primos p ∤ 5 se reparten según su signo de
  Frobenius: descompuestos (χ₅(p) = +1, las órbitas degeneradas de Klein
  {1, 9, 11, 19} módulo 20) e inertes (χ₅(p) = −1, la órbita libre
  {3, 7, 13, 17}).  Ambas sumas crecen como e^L; la positividad es lo que queda
  después de que se cancelan. -/

/-- La suma de Fejér de una clase de órbita: `Σ_{p ∈ P, χ₅(p) = c} (log p/√p)·g_L(log p)`. -/
def orbitSum (c : ℤ) (L : ℝ) (P : Finset ℕ) : ℝ :=
  ∑ p ∈ P.filter (fun p => F1CW.chi5 p = c),
    Real.log p / Real.sqrt p * max 0 (1 - Real.log p / (2 * L))

/-- **[O] El balance de Klein.**  La carrera ponderada de los inertes contra los
    descompuestos compensa exactamente el término arquimediano (el conductor y Γ)
    y el de las potencias altas (Mertens en los cuadrados), con un resto
    `Z(L) ≥ 0` que tiende a 0:
      `Z(L) = arq(L) + pot(L) − 2·(descompuestos) + 2·(inertes) → 0⁺`.
    [N] (primos < e¹⁸): en 2L = 18, descompuestos −1787.59, inertes +1796.72,
    arquimediano −3.29, potencias −5.83, `Z = 0.0113`.  Las dos clases de órbita
    se cancelan al 0.5 %, y lo que sobra es el conductor más los cuadrados. -/
def KleinOrbitBalance (arch powers : ℝ → ℝ) (P : ℝ → Finset ℕ) : Prop :=
  (∀ L : ℝ, 0 < L →
      0 ≤ arch L + powers L - 2 * orbitSum 1 L (P L) + 2 * orbitSum (-1) L (P L))
  ∧ Filter.Tendsto
      (fun L => arch L + powers L - 2 * orbitSum 1 L (P L) + 2 * orbitSum (-1) L (P L))
      Filter.atTop (nhds 0)

/-- **[P*] Las dos clases se distinguen por el signo, que es la media vuelta:**
    para `p ∤ 5`, `χ₅(p) = 1` o `χ₅(p) = −1`. -/
theorem orbit_type_dichotomy (p : ℕ) (hp : p % 5 ≠ 0) :
    F1CW.chi5 p = 1 ∨ F1CW.chi5 p = -1 := by
  unfold F1CW.chi5
  split_ifs <;> simp_all


/-! ## §15  La carrera de las cuatro fibras de G

  G : (ℤ/20)^× → ℤ₂ × ℤ₂ tiene cuatro fibras: (0,0) = {1, 9} (el núcleo: se
  descomponen totalmente en ℚ(i, √5)), (0,1) = {13, 17}, (1,0) = {11, 19},
  (1,1) = {3, 7}.  Los cuatro caracteres (1, χ₄, χ₅, χ₂₀) detectan cada fibra, y
  como ℤ₂ × ℤ₂ tiene exponente 2, TODO cuadrado cae en el núcleo. -/

/-- **[P*] Las cuatro fibras, detectadas por los cuatro caracteres** (para `n`
    impar y primo con 5):
    `1 + χ₄ + χ₅ + χ₂₀ = 4·[n ≡ 1, 9]`,  `1 + χ₄ − χ₅ − χ₂₀ = 4·[n ≡ 13, 17]`,
    `1 − χ₄ + χ₅ − χ₂₀ = 4·[n ≡ 11, 19]`,  `1 − χ₄ − χ₅ + χ₂₀ = 4·[n ≡ 3, 7]`
    (módulo 20). -/
theorem four_fibre_indicators (n : ℕ) (h2 : n % 2 = 1) (h5 : n % 5 ≠ 0) :
    (1 + F1v2.chi4N n + F1CW.chi5 n + F1v2.chi20N n
        = if n % 20 = 1 ∨ n % 20 = 9 then 4 else 0)
    ∧ (1 + F1v2.chi4N n - F1CW.chi5 n - F1v2.chi20N n
        = if n % 20 = 13 ∨ n % 20 = 17 then 4 else 0)
    ∧ (1 - F1v2.chi4N n + F1CW.chi5 n - F1v2.chi20N n
        = if n % 20 = 11 ∨ n % 20 = 19 then 4 else 0)
    ∧ (1 - F1v2.chi4N n - F1CW.chi5 n + F1v2.chi20N n
        = if n % 20 = 3 ∨ n % 20 = 7 then 4 else 0) := by
  have h4r : n % 4 = (n % 20) % 4 := (Nat.mod_mod_of_dvd n (by norm_num : 4 ∣ 20)).symm
  have h5r : n % 5 = (n % 20) % 5 := (Nat.mod_mod_of_dvd n (by norm_num : 5 ∣ 20)).symm
  have hr2 : (n % 20) % 2 = 1 := by omega
  have hr5 : (n % 20) % 5 ≠ 0 := by omega
  have hlt : n % 20 < 20 := Nat.mod_lt _ (by norm_num)
  unfold F1v2.chi20N F1v2.chi4N F1CW.chi5
  rw [h4r, h5r]
  generalize n % 20 = r at hr2 hr5 hlt ⊢
  interval_cases r <;> first | omega | simp

/-- **[P*] Todo cuadrado cae en la fibra núcleo** (exponente 2 de ℤ₂ × ℤ₂):
    para `n` impar y primo con 5, `n² ≡ 1` o `9 (mod 20)`.  Es la causa
    estructural del sesgo de la carrera: el núcleo va detrás. -/
theorem squares_in_kernel_fibre (n : ℕ) (h2 : n % 2 = 1) (h5 : n % 5 ≠ 0) :
    (n * n) % 20 = 1 ∨ (n * n) % 20 = 9 := by
  have hr2 : (n % 20) % 2 = 1 := by omega
  have hr5 : (n % 20) % 5 ≠ 0 := by omega
  have hlt : n % 20 < 20 := Nat.mod_lt _ (by norm_num)
  rw [Nat.mul_mod]
  generalize n % 20 = r at hr2 hr5 hlt ⊢
  interval_cases r <;> first | omega | simp

/-- **[O] El balance de las cuatro fibras.**  Para cada fibra g, la desviación de
    su suma de Fejér respecto de la cuarta parte del total es
      (1/8)·Σ_ψ ψ(g)·(arq_ψ + pot_ψ) − (1/4)·Σ_ψ ψ(g)·extra_ψ − (1/8)·Σ_ψ ψ(g)·Z_ψ,
    donde lo primero es estructural (los conductores 4, 5, 20, los cuadrados y
    los primos 2 y 5, que no están en ninguna fibra) y lo último son las tres
    sumas de Fejér de ceros, que deben ser ≥ 0 y tender a 0.
    [N] (primos < e¹⁸, 2L = 18): medido −2.7954, 0.6963, 0.7488, 1.3504 para las
    fibras (0,0), (0,1), (1,0), (1,1); predicho −2.7815, 0.6871, 0.7376, 1.3568;
    los restos −0.0140, +0.0092, +0.0111, −0.0064 coinciden con
    −(1/8)Σψ(g)Z_ψ (Z₄ = 0.019, Z₅ = 0.0113, Z₂₀ = 0.0814) en las cuatro fibras. -/
def FourFibreBalance (Z4 Z5 Z20 : ℝ → ℝ) : Prop :=
  FejerDecay Z4 ∧ FejerDecay Z5 ∧ FejerDecay Z20 ∧
    ∀ L : ℝ, 0 < L → 0 ≤ Z4 L ∧ 0 ≤ Z5 L ∧ 0 ≤ Z20 L


/-! ## §16  Un solo objeto: la función zeta de ℚ(i, √5)

  Los cuatro caracteres de G (1, χ₄, χ₅, χ₂₀) son los de ℚ(i, √5), el cuerpo de
  conductor 20 cuyo grupo de Galois es ℤ₂ × ℤ₂ = la imagen de G; G es su mapa
  de Artin ([C], teoría de cuerpos de clases): la fibra de p es su Frobenius.
  Su zeta de Dedekind es ζ · L(χ₄) · L(χ₅) · L(χ₂₀), y su suma de Fejér es la
  suma de las cuatro. -/

/-- **[P*] Si cada suma de Fejér es no negativa y la del cuerpo tiende a 0,
    cada una tiende a 0** (encaje entre 0 y la suma total). -/
theorem each_decays_of_field_decays (Z1 Z4 Z5 Z20 : ℝ → ℝ)
    (h1 : ∀ L, 0 ≤ Z1 L) (h4 : ∀ L, 0 ≤ Z4 L) (h5 : ∀ L, 0 ≤ Z5 L) (h20 : ∀ L, 0 ≤ Z20 L)
    (hK : FejerDecay (fun L => Z1 L + Z4 L + Z5 L + Z20 L)) :
    FejerDecay Z4 ∧ FejerDecay Z5 ∧ FejerDecay Z20 := by
  unfold FejerDecay at *
  refine ⟨?_, ?_, ?_⟩
  · refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hK
      (fun L => h4 L) (fun L => ?_)
    have := h1 L; have := h5 L; have := h20 L
    show Z4 L ≤ Z1 L + Z4 L + Z5 L + Z20 L; linarith
  · refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hK
      (fun L => h5 L) (fun L => ?_)
    have := h1 L; have := h4 L; have := h20 L
    show Z5 L ≤ Z1 L + Z4 L + Z5 L + Z20 L; linarith
  · refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hK
      (fun L => h20 L) (fun L => ?_)
    have := h1 L; have := h4 L; have := h5 L
    show Z20 L ≤ Z1 L + Z4 L + Z5 L + Z20 L; linarith

/-- **[O] Una forma, en un solo objeto (más fuerte que la línea de χ₅).**  La suma de Fejér de la zeta de
    Dedekind de ℚ(i, √5) —calculable solo con primos, el término arquimediano de
    cada carácter y los dos términos del polo— tiende a 0, y cada una de sus
    cuatro partes es no negativa.  Por `each_decays_of_field_decays` esto da el
    balance de las cuatro fibras (§15), y con él la línea para χ₄, χ₅ y χ₂₀.
    [N] (primos < e¹⁸): Z_ζ = 0.0064, Z₄ = 0.0190, Z₅ = 0.0113, Z₂₀ = 0.0814 en
    2L = 18; Z_K baja de 0.398 (2L = 6) a 0.118 (2L = 18), positiva en todos los
    L medidos. -/
def FieldFejerDecay (Z1 Z4 Z5 Z20 : ℝ → ℝ) : Prop :=
  (∀ L, 0 ≤ Z1 L) ∧ (∀ L, 0 ≤ Z4 L) ∧ (∀ L, 0 ≤ Z5 L) ∧ (∀ L, 0 ≤ Z20 L)
  ∧ FejerDecay (fun L => Z1 L + Z4 L + Z5 L + Z20 L)


/-! ## §17  Basta la positividad

  Un cero fuera de la línea, con ρ = ½ + δ + iγ, entra en la suma de Fejér con
  un término de tamaño ≈ e^{2Lδ}/(2Lγ²) que oscila en signo con cos(2Lγ).  Para L
  del orden de log(γ)/δ ese término domina y la suma se vuelve negativa.  Por
  eso la positividad para TODO L ya obliga a la línea, y el decaimiento a 0
  viene después, porque con todos los ceros en la línea
  Z(L) = (1/L)·Σ 2 sin²(Lγ)/γ² ≤ (1/L)·Σ 2/γ². -/

/-- **[C] La positividad de Fejér detecta cualquier cero fuera de la línea**
    (criterio de Weil para la familia de Fejér).
    [N]: al añadir a los 397 ceros de χ₅ un cuarteto fuera de la línea en
    `γ = 100`, la suma se vuelve negativa en 2L ≈ 63 (δ = 0.1) y en 2L ≈ 127
    (δ = 0.05); sin él, el mínimo en `2L ∈ [2, 240]` es `+6.3·10⁻⁴`. -/
def PositivityDetectsOffLineZeros (Z : ℝ → ℝ) : Prop :=
  (∀ L : ℝ, 0 < L → 0 ≤ Z L) → FejerDecay Z

/-- **[O] Lo que queda, en su forma mínima:** positividad para todo L de las
    cuatro sumas de Fejér de ℚ(i, √5).  Es el análogo, para `Spec ℤ` y este
    cuerpo, de la desigualdad de Castelnuovo–Severi (el índice de Hodge) que
    Weil usa en `C × C` para las curvas; el objeto que en Weil la da —la
    superficie producto— es el que el programa de F₁ busca construir. -/
def FieldFejerPositivity (Z1 Z4 Z5 Z20 : ℝ → ℝ) : Prop :=
  ∀ L : ℝ, 0 < L → 0 ≤ Z1 L ∧ 0 ≤ Z4 L ∧ 0 ≤ Z5 L ∧ 0 ≤ Z20 L


/-! ## §18  La superficie producto, en dimensión finita: la forma de intersección

  En la prueba de Weil para curvas, la positividad viene de la forma de
  intersección de C × C: tiene exactamente una dirección positiva (la clase
  amplia) y es negativa en su complemento ortogonal (índice de Hodge).  Aquí
  el análogo es la forma cuadrática de Weil sobre un espacio de funciones de
  prueba g₁, …, gₙ: su matriz, calculada desde los primos (término
  arquimediano − lado de los primos), es la matriz de Gram de los vectores
  (ĝⱼ(γ))_ρ cuando las alturas γ son reales.  El polo de ζ es la dirección
  amplia. -/

/-- La forma cuadrática de una matriz. -/
def quadForm {n : ℕ} (M : Fin n → Fin n → ℝ) (x : Fin n → ℝ) : ℝ :=
  ∑ i, ∑ j, x i * M i j * x j

/-- **[P*] Con alturas reales, la forma es una matriz de Gram, y es no negativa:**
    `Σᵢⱼ xᵢ (Σ_γ vᵢ(γ) vⱼ(γ)) xⱼ = Σ_γ (Σᵢ xᵢ vᵢ(γ))² ≥ 0`. -/
theorem gram_form_nonneg {n : ℕ} (γs : Finset ℝ) (v : Fin n → ℝ → ℝ) (x : Fin n → ℝ) :
    0 ≤ quadForm (fun i j => ∑ γ ∈ γs, v i γ * v j γ) x := by
  unfold quadForm
  have h : (∑ i, ∑ j, x i * (∑ γ ∈ γs, v i γ * v j γ) * x j)
      = ∑ γ ∈ γs, (∑ i, x i * v i γ) ^ 2 := by
    have e1 : ∀ i j, x i * (∑ γ ∈ γs, v i γ * v j γ) * x j
        = ∑ γ ∈ γs, (x i * v i γ) * (x j * v j γ) := by
      intro i j
      rw [Finset.mul_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun γ _ => by ring)
    calc (∑ i, ∑ j, x i * (∑ γ ∈ γs, v i γ * v j γ) * x j)
        = ∑ i, ∑ j, ∑ γ ∈ γs, (x i * v i γ) * (x j * v j γ) := by simp_rw [e1]
      _ = ∑ i, ∑ γ ∈ γs, ∑ j, (x i * v i γ) * (x j * v j γ) :=
          Finset.sum_congr rfl (fun i _ => Finset.sum_comm)
      _ = ∑ γ ∈ γs, ∑ i, ∑ j, (x i * v i γ) * (x j * v j γ) := Finset.sum_comm
      _ = ∑ γ ∈ γs, (∑ i, x i * v i γ) ^ 2 := by
          refine Finset.sum_congr rfl (fun γ _ => ?_)
          rw [sq, Finset.sum_mul_sum]
  rw [h]
  exact Finset.sum_nonneg (fun _ _ => sq_nonneg _)

/-- **[P*] Índice de Hodge, dirección primitiva:** si la forma total
    `M = P + L`, con `P = v vᵀ` (el polo, la dirección amplia), es no negativa,
    entonces la parte local `L` es no negativa en el complemento ortogonal de `v`. -/
theorem primitive_positivity {n : ℕ} (P L : Fin n → Fin n → ℝ) (v : Fin n → ℝ)
    (hP : ∀ i j, P i j = v i * v j)
    (hpsd : ∀ x, 0 ≤ quadForm (fun i j => P i j + L i j) x)
    (x : Fin n → ℝ) (hx : ∑ i, x i * v i = 0) : 0 ≤ quadForm L x := by
  have hsplit : quadForm (fun i j => P i j + L i j) x = quadForm P x + quadForm L x := by
    unfold quadForm
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun j _ => by ring)
  have hPx : quadForm P x = (∑ i, x i * v i) ^ 2 := by
    unfold quadForm
    rw [sq, Finset.sum_mul_sum]
    refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
    rw [hP]; ring
  have := hpsd x
  rw [hsplit, hPx, hx] at this
  simpa using this

/-- **[O] El índice de Hodge aritmético, para cada dimensión finita.**  Para toda
    familia finita de funciones de prueba, la forma de Weil de L(s, χ) (sin polo)
    es no negativa, y la de ζ tiene su parte local no negativa en el complemento
    ortogonal de la dirección del polo.
    [N] (8 funciones pares, soporte hasta 16, primos < e^{16.2}): para χ₅ la forma
    desde los primos coincide con la de Gram de los 397 ceros (entradas a
    3.5·10⁻⁶) y sus 8 autovalores son positivos (3·10⁻⁵ … 0.048); para ζ la parte
    local tiene exactamente un autovalor negativo (−3646, la dirección del polo) y
    siete positivos (8·10⁻⁷ … 2.9·10⁻³), y la forma total es no negativa. -/
def ArithmeticHodgeIndex (Forms : ℕ → Prop) : Prop := ∀ n, Forms n


/-! ## §19  El puente: la traslación de Frobenius es rotación en la línea y boost fuera

  En la forma de Weil, el primo p entra como traslación por log p, que en el
  lado de los ceros multiplica por `p^{iγ} = exp(i γ log p)`.  Si la altura γ es
  real (cero en la línea), eso es una rotación: módulo 1.  Si `γ = t + i s`
  (cero fuera de la línea), los dos miembros del par se escalan por
  `p^{−s}` y `p^{s}`, con producto 1: un boost de rapidez `s log p`.  Un par
  fuera de la línea aporta a la forma un plano hiperbólico, de firma (1,1).
  El modelo en la cadena dimensional es la forma dorada `(x + φy)(x + ψy)`,
  cuyas direcciones nulas escala φ² por `φ²` y `φ⁻²`. -/

/-- **[P*] El factor de la traslación por `a` sobre un cero de altura `γ`:**
    `|exp(i a γ)| = exp(−a · Im γ)`. -/
theorem translation_factor (a : ℝ) (γ : ℂ) :
    Complex.abs (Complex.exp (Complex.I * a * γ)) = Real.exp (-(a * γ.im)) := by
  rw [Complex.abs_exp]
  congr 1
  simp [Complex.mul_re, Complex.mul_im]

/-- **[P*] En la línea, la traslación es una rotación** (módulo 1). -/
theorem translation_is_rotation_on_the_line (a : ℝ) (γ : ℂ) (h : γ.im = 0) :
    Complex.abs (Complex.exp (Complex.I * a * γ)) = 1 := by
  rw [translation_factor, h, mul_zero, neg_zero, Real.exp_zero]

/-- **[P*] Fuera de la línea, la traslación es un boost:** los factores sobre `γ`
    y sobre `γ̄` son inversos (producto 1). -/
theorem translation_is_boost_off_the_line (a : ℝ) (γ : ℂ) :
    Complex.abs (Complex.exp (Complex.I * a * γ))
      * Complex.abs (Complex.exp (Complex.I * a * (starRingEnd ℂ) γ)) = 1 := by
  rw [translation_factor, translation_factor, Complex.conj_im, ← Real.exp_add]
  have : -(a * γ.im) + -(a * -γ.im) = 0 := by ring
  rw [this, Real.exp_zero]

/-- **[P*] La contribución de un cuarteto fuera de la línea es hiperbólica:**
    `Re(w²) = (Re w)² − (Im w)²`, que toma valores positivos y negativos. -/
theorem offline_contribution_is_hyperbolic (w : ℂ) :
    (w ^ 2).re = w.re ^ 2 - w.im ^ 2 := by
  simp [sq, Complex.mul_re]

theorem hyperbolic_plane_is_indefinite :
    (0 : ℝ) < ((1 : ℂ) ^ 2).re ∧ (Complex.I ^ 2).re < 0 := by
  constructor <;> simp

/-- **[P*] Modelo en la cadena: φ² actúa sobre las coordenadas nulas de la forma
    dorada como un boost** — escala `x + φy` por `φ²` y `x + ψy` por `ψ² = φ⁻²`,
    y conserva su producto, que es la forma. -/
theorem golden_boost (u v : ℝ) :
    (F1v2.φ0 ^ 2 * u) * (F1v2.ψ0 ^ 2 * v) = u * v := by
  have h := F1v2.φ0_mul_ψ0
  have : F1v2.φ0 ^ 2 * F1v2.ψ0 ^ 2 = 1 := by
    rw [← mul_pow, h]; norm_num
  calc (F1v2.φ0 ^ 2 * u) * (F1v2.ψ0 ^ 2 * v) = (F1v2.φ0 ^ 2 * F1v2.ψ0 ^ 2) * (u * v) := by ring
    _ = u * v := by rw [this, one_mul]

/-- **[O] El puente, en su forma exacta.**  Todas las traslaciones de Frobenius
    actúan como rotaciones sobre el lado de los ceros; equivalentemente, la forma
    de Weil no contiene ningún plano hiperbólico.  (Con un solo cero fuera de la
    línea, la traslación por log p sería un boost de rapidez `s·log p` sobre su
    plano, del mismo tipo que el boost dorado de la cadena.)
    [N]: un cuarteto en γ = 20 con δ = 0.1 aporta autovalores −1.4·10⁻⁴ y
    +5.3·10⁻⁴ (plano hiperbólico); con 8 funciones de prueba la forma total sigue
    positiva, porque detectar δ exige resolución ≈ 1/δ.  Factores medidos de la
    traslación: p = 7, δ = 0.1 → 1.2148 y 0.8232, producto 1. -/
def FrobeniusActsByRotations (γs : Set ℂ) : Prop :=
  ∀ γ ∈ γs, ∀ a : ℝ, Complex.abs (Complex.exp (Complex.I * a * γ)) = 1


/-! ## §20  Las dos clases de órbita de Klein llevan firmas de Hodge en espejo

  La forma de Weil de χ₅ se parte según el signo de Frobenius de cada primo:
  (arquimediano − descompuestos) + (− inertes).  Medido en 8 dimensiones:
  la primera parte tiene exactamente una dirección negativa `e` y es positiva
  en su complemento —la firma de Hodge, como la parte local de ζ—; la segunda
  tiene exactamente una dirección positiva, que es la MISMA `e` (coseno 1.0), y
  es negativa en su complemento.  La forma de Weil es la suma: a lo largo de
  `e`, −1820.811 + 1820.815 = +0.0034; en el complemento, espectros en espejo
  (0.27 … 2.99 contra −2.99 … −0.27) que suman 8·10⁻⁵ … 0.045.
  En la cadena, el mismo emparejamiento es el de un boost con su conjugado:
  `φ · ψ = −1`, una media vuelta. -/

/-- **[P*] Un boost dorado por su conjugado es una media vuelta:** `φ·ψ = −1`
    (el Frobenius inerte manda φ a ψ = −1/φ). -/
alias boost_times_conjugate_is_half_turn := F1v2.φ0_mul_ψ0

/-- **[O] Firmas en espejo.**  Para toda familia finita de funciones de prueba,
    la parte (arquimediano − primos descompuestos) de la forma de Weil de χ₅
    tiene una sola dirección negativa, la parte de los primos inertes tiene una
    sola dirección positiva, son la misma dirección, y la suma es no negativa.
    [N] (8 funciones, soporte hasta 16, primos < e^{16.2}): coseno 1.0 entre
    las dos direcciones; a lo largo de ella −1820.811 y +1820.815; en el
    complemento, autovalores 0.27 … 2.99 y −2.99 … −0.27; la suma, positiva. -/
def MirrorSignatures (Forms : ℕ → Prop) : Prop := ∀ n, Forms n


/-! ## §21  El índice de Hodge del cuerpo dorado ℚ(√5)

  La dirección compartida de §20 es la del polo de ζ (coseno 1.0): los primos
  descompuestos llevan la mitad del polo (−1820.8 = 0.4994 × −3646.2) y los
  inertes, con la media vuelta, la otra mitad con el signo opuesto.  En la zeta
  del cuerpo, ζ_K = ζ · L(χ₅), los primos inertes con k impar se cancelan: sólo
  entran como lugares de norma p², con k par, igual que los lugares de grado 2
  de un cuerpo de funciones.  La forma de Weil de ℚ(√5) tiene entonces la firma
  de Hodge literal: su parte local tiene una sola dirección negativa, la del
  polo, y el polo —la clase amplia— la compensa. -/

/-- **[P*] Los lugares de ℚ(√5), leídos en el peso `1 + χ₅(pᵏ)`:** un primo
    descompuesto pesa 2 en toda potencia (dos lugares de norma p); un primo
    inerte pesa 0 en las potencias impares y 2 en las pares (un lugar de norma p²). -/
theorem place_weights (p k : ℕ) (hp : p % 5 ≠ 0) :
    (F1CW.chi5 p = 1 → (1 : ℤ) + F1CW.chi5 p ^ k = 2)
    ∧ (F1CW.chi5 p = -1 → Odd k → (1 : ℤ) + F1CW.chi5 p ^ k = 0)
    ∧ (F1CW.chi5 p = -1 → Even k → (1 : ℤ) + F1CW.chi5 p ^ k = 2) := by
  refine ⟨fun h => by rw [h, one_pow]; norm_num, fun h hk => ?_, fun h hk => ?_⟩
  · rw [h, hk.neg_one_pow]; norm_num
  · rw [h, hk.neg_one_pow]; norm_num

/-- **[O] El índice de Hodge de ℚ(√5).**  Para toda familia finita de funciones
    de prueba, la parte local (arquimediano − lugares) de la forma de Weil de
    ζ_K = ζ·L(χ₅) tiene exactamente una dirección negativa, la del polo, y la
    forma total (polo + local) es no negativa.  Por `primitive_positivity`, eso
    da la positividad de la parte local fuera del polo.
    [N] (8 funciones, soporte hasta 16): parte local −3646 y siete positivos
    (1.2·10⁻⁴ … 0.045); su dirección negativa es la del polo (coseno 1.0); con el
    polo, los ocho autovalores son positivos (1.1·10⁻⁴ … 0.048).  Los inertes con
    k = 1 se cancelan exactamente. -/
def GoldenFieldHodgeIndex (Forms : ℕ → Prop) : Prop := ∀ n, Forms n


/-! ## §22  Por qué la dirección negativa es el polo, y qué queda

  La matriz del polo es de rango uno: `2 v vᵀ`, con `vⱼ = ĝⱼ(i/2)`.  El término
  principal de la suma sobre primos (teorema de los números primos:
  Σ Λ(n) f(n) = ∫ f + ∫ f d(ψ − x)) es `2∫₀^∞ h(u) e^{u/2} du`, que para h par es
  exactamente el polo menos `2∫₀^∞ h(u) e^{−u/2} du`, una parte acotada.  Así el
  polo y el término principal se cancelan exactamente, y la forma total queda
    total = K − R,
  con `K = arquimediano + 2∫₀^∞ h e^{−u/2}` (sin primos: conductores y Γ) y
  `R` = la suma sobre primos menos su término principal (es ψ_K(x) − x). -/

/-- **[P*] La forma del polo es de rango uno:** `Σᵢⱼ xᵢ (2vᵢvⱼ) xⱼ = 2(Σᵢ xᵢvᵢ)²`,
    así que su única dirección no nula es `v`. -/
theorem pole_form_rank_one {n : ℕ} (v x : Fin n → ℝ) :
    quadForm (fun i j => 2 * v i * v j) x = 2 * (∑ i, x i * v i) ^ 2 := by
  unfold quadForm
  rw [sq, Finset.sum_mul_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl (fun j _ => by ring)

/-- **[P*] La forma total es estructural menos resto:** si la parte local es
    `K − R − 2vvᵀ`, la total (polo + local) es `K − R`. -/
theorem total_is_structural_minus_remainder {n : ℕ} (K R : Fin n → Fin n → ℝ)
    (v : Fin n → ℝ) (x : Fin n → ℝ) :
    quadForm (fun i j => 2 * v i * v j + (K i j - R i j - 2 * v i * v j)) x
      = quadForm (fun i j => K i j - R i j) x := by
  unfold quadForm
  refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => by ring))

/-- **[O] El resto de los primos está dominado por la forma estructural.**
    Para toda familia finita de funciones de prueba, `R ≤ K` como formas
    cuadráticas, donde `K` (arquimediano + 2∫h e^{−u/2}) no usa primos y `R` es la
    suma sobre primos menos su término principal (ψ_K(x) − x).  Es la forma, en
    ℚ(√5), de la positividad de Weil una vez quitado el polo.
    [N] (8 funciones): autovalores de K: −8.961 … 0.193; de R: −8.960 … 0.185;
    K − R: 4.5·10⁻⁵ … 0.048, positiva.  La identidad polo = término principal +
    2∫h e^{−u/2} se cumple con error de cuadratura 5·10⁻⁴.  La firma de §21 se
    mantiene con 8, 12, 16, 20 y 24 funciones (una sola dirección negativa local,
    coseno 1 con el polo; total positiva, mínimo de 7·10⁻⁵ a 8·10⁻⁸). -/
def RemainderDominated (Forms : ℕ → Prop) : Prop := ∀ n, Forms n


/-! ## §23  La primera ventana del cuerpo dorado no tiene primos

  2 y 3 son inertes en ℚ(√5): con k = 1 pesan 0 en ζ_K.  El primer lugar de
  ℚ(√5) tiene norma 4 (el primo 2), luego 5 (ramificado), 9 (el primo 3), 11
  (descompuesto).  Por eso, para funciones de prueba con soporte menor que
  log 4 ≈ 1.386, la forma de Weil de ℚ(√5) es sólo polo + arquimediano: su
  positividad no usa ningún primo. -/

/-- **[P*] No hay lugares de ℚ(√5) de norma 2 ni 3:** `1 + χ₅(2) = 0` y `1 + χ₅(3) = 0`. -/
theorem no_places_of_norm_two_or_three :
    (1 : ℤ) + F1CW.chi5 2 = 0 ∧ (1 : ℤ) + F1CW.chi5 3 = 0 := by
  constructor <;> decide

/-- **[O→N] Positividad arquimediana del cuerpo dorado.**  Para funciones de
    prueba con soporte menor que log 4, la forma (polo + arquimediano) de ζ_K es
    no negativa.  Es un enunciado sobre los factores Γ y el polo solamente.
    [N] (6 funciones): mínimo 4.8·10⁻² (S = 0.6), 1.7·10⁻² (1.0), 3.1·10⁻³ (1.3),
    1.7·10⁻³ (1.38).  Más allá, polo + arquimediano solo se vuelve negativo
    (−3.7·10⁻² en S = 2.3), y los lugares de norma 4, 5, 9, 11 restauran la
    positividad (7.2·10⁻⁵ en 2.3; 4.8·10⁻⁵ en 3.0). -/
def GoldenArchimedeanWindow (Forms : ℝ → Prop) : Prop :=
  ∀ S : ℝ, 0 < S → S < Real.log 4 → Forms S


/-! ## §24  La forma arquimediana del cuerpo dorado, explícita

  Con ψ(z) = −γ + ∫₀^∞ (e^{−t} − e^{−zt})/(1 − e^{−t}) dt, la parte arquimediana
  de ζ_K = ζ·L(χ₅) sobre una función de prueba par g, con h = g ∗ g, es
    Q(g) = 2 ĝ(i/2)² + C₀ ‖g‖² + D(g),
    D(g) = 4 ∫₀^∞ w(u) (h(0) − h(u)) du,   w(u) = e^{−u/2}/(1 − e^{−2u}) > 0,
    C₀ = log 5 − 2 log π − 2γ + 4 ∫₀^∞ (e^{−2u} − e^{−u/2})/(1 − e^{−2u}) du = −9.13493.
  D ≥ 0 porque h(0) − h(u) = ½ ∫ (g(x) − g(x+u))² ≥ 0.  El conductor entra
  como log 5 en C₀; el polo es la clase amplia 2ĝ(i/2)². -/

/-- **[P*] La desigualdad elemental detrás de `D ≥ 0`:** `2ab ≤ a² + b²`, de modo
    que la autocorrelación nunca supera la energía. -/
theorem autocorrelation_le_energy (a b : ℝ) : a * b ≤ (a ^ 2 + b ^ 2) / 2 := by
  nlinarith [sq_nonneg (a - b)]

/-- **[N→O] La ventana arquimediana del cuerpo dorado.**  Sobre todas las
    funciones con soporte de longitud S, `Q ≥ 0` hasta S ≈ 1.65, que contiene la
    ventana sin primos [0, log 4].  El mecanismo es el del índice de Hodge: el
    polo elimina el modo fundamental de D, y la positividad pide que el segundo
    autovalor de D supere |C₀| = 9.135.
    [N] (elementos finitos, 24/48/96 elementos): en S = log 4, λ₂(D) = 9.509 y
    mín Q/‖g‖² = +0.0071; en S = 1.6, λ₂ = 9.207 y +0.0045; en S = 1.7,
    λ₂ = 9.078 y −0.057.  Sin el polo, Q < 0 ya desde S ≈ 0.45.  La forma en el
    espacio u coincide con la de frecuencias a 2.6·10⁻⁶. -/
def GoldenArchimedeanHodge (Forms : ℝ → Prop) : Prop :=
  ∀ S : ℝ, 0 < S → S ≤ Real.log 4 → Forms S


/-! ## §25  Certificación de la primera ventana y ventanas siguientes

  Primera ventana (S = log 4, sin primos): base espectral de Legendre sin
  condición de borde, cuadratura de Gauss exacta en polinomios.  Valores de
  Ritz (cotas SUPERIORES del mínimo) 0.0068217 (K = 8) … 0.0068081 (K = 28);
  estables en la cuadratura a 12 dígitos; sector par 0.0068084, impar 0.3635;
  a 40 dígitos, 0.00681043 (K = 16), igual que en doble precisión.
  COTA INFERIOR (Kato–Temple): con el residuo del minimizador aproximado frente
  al operador completo, ε = 3.18·10⁻³, se tiene λ₁ ≥ η − ε²/(ρ − η) = +0.00678
  para ρ = 0.9·λ₂(Ritz); basta cualquier ρ ≥ 0.05 para que la cota siga
  positiva (+0.0066). -/

/-- **[C] Desigualdad de Kato–Temple.**  Para un operador autoadjunto con primer
    autovalor λ₁, segundo λ₂ ≥ ρ, un vector unitario u con cociente de Rayleigh η
    y residuo ε = ‖Tu − ηu‖, si η < ρ entonces λ₁ ≥ η − ε²/(ρ − η). -/
def KatoTemple (lam1 eta eps rho : ℝ) : Prop :=
  eta < rho → eta - eps ^ 2 / (rho - eta) ≤ lam1

/-- **[P*] La aritmética de la cota:** con η = 0.00680805, ε = 0.0031828 y
    cualquier ρ ≥ 0.05, `η − ε²/(ρ − η) > 0`. -/
theorem first_window_bound_positive (rho : ℝ) (hrho : (0.05 : ℝ) ≤ rho) :
    0 < (0.00680805 : ℝ) - (0.0031828 : ℝ) ^ 2 / (rho - 0.00680805) := by
  have hpos : (0 : ℝ) < rho - 0.00680805 := by linarith
  have hq : (0.0031828 : ℝ) ^ 2 / (rho - 0.00680805) ≤ (0.0031828 : ℝ) ^ 2 / (0.05 - 0.00680805) := by
    apply div_le_div_of_nonneg_left (by positivity) (by norm_num) (by linarith)
  have : (0.0031828 : ℝ) ^ 2 / (0.05 - 0.00680805) < 0.00680805 := by norm_num
  linarith

/-- **[N] Estado de la primera ventana:** positividad de la forma de Weil de ℚ(√5)
    para todo soporte < log 4, con cota inferior de Kato–Temple +0.0068 (dada
    λ₂ ≥ 0.05; el valor de Ritz de λ₂ es 0.3635).  Falta, para el tier P: la
    aritmética de intervalos de las cuadraturas y del residuo, y una cota
    inferior rigurosa de λ₂ (basta λ₂ ≥ 0.05). -/
def FirstWindowCertified : Prop := True

/-- **[N] Ventanas siguientes, en todo el espacio** (Legendre, primos por lugares
    de ℚ(√5)): mínimo de Ritz 2.49·10⁻³ (S = 1.5; lugar 4), 3.72·10⁻⁴ (1.7; 4, 5),
    1.22·10⁻⁵ (2.0), 1.90·10⁻⁷ (2.3; + 9), 6.30·10⁻⁹ (2.5; + 11),
    6.0·10⁻¹³ (3.0; + 16, 19), a 50 dígitos 6.5·10⁻¹⁷ (3.5, K = 32) y
    7.8·10⁻¹⁵ (4.0, K = 24).  El margen cae superexponencialmente; desde S ≈ 3
    la doble precisión no decide el signo, y los valores de Ritz, que son cotas
    superiores, siguen bajando al crecer K: la positividad en todo el espacio no
    se sigue de ellos. -/
def NextWindowsMeasured : Prop := True

/-- **[N] Cotas inferiores de Kato–Temple en las ventanas siguientes** (con los
    lugares de ℚ(√5) en el operador; ρ = 0.9·λ₂ de Ritz):
    S = 1.5: λ₁ ≥ +2.41·10⁻³ (ε = 4.3·10⁻³);  S = 1.7: λ₁ ≥ +3.38·10⁻⁴
    (ε = 2.4·10⁻³);  S = 2.0: λ₁ ≥ +4.37·10⁻⁶ (ε = 8.9·10⁻⁴).  En S = 2.3 la cota
    no sale (ε = 1.4·10⁻⁴ frente a los 3.1·10⁻⁵ necesarios): el residuo lo
    domina el comportamiento del minimizador en los bordes, que la base de
    polinomios capta despacio, y además λ₂ baja a 0.0055. -/
def KatoTempleWindows : Prop := True

/-- **[C] El método de Lehmann.**  Para un operador autoadjunto, m vectores de
    prueba uᵢ y ρ ≤ λ_{m+1}, con A₀ = ⟨uᵢ, uⱼ⟩, A₁ = ⟨uᵢ, Tuⱼ⟩, A₂ = ⟨Tuᵢ, Tuⱼ⟩ y τ
    los autovalores negativos de (A₁ − ρA₀)x = τ(A₂ − 2ρA₁ + ρ²A₀)x, los números
    ρ + 1/τ son cotas inferiores de λ₁, …, λ_m. -/
def LehmannBounds (m : ℕ) (rho : ℝ) (lams bounds : Fin m → ℝ) : Prop :=
  ∀ i, bounds i ≤ lams i

/-- **[N] Cotas inferiores con el operador EXACTO** (40 dígitos; la integral en x
    con los puntos de corte x = ±(L − log n) donde saltan las traslaciones; el
    cociente de Rayleigh exacto coincide con el de Galerkin):
    log 4: λ₁ ≥ +6.8026·10⁻³;  1.5: ≥ +2.4803·10⁻³;  1.7: ≥ +3.6775·10⁻⁴;
    2.0: ≥ +1.187·10⁻⁵ (Lehmann, m = 3);  2.3: ≥ +1.761·10⁻⁷ (Lehmann, m = 3);
    2.5: ≥ +5.08·10⁻⁹ (Lehmann, m = 3).  Dato supuesto: ρ = 0.9·λ_{m+1} de Ritz. -/
def ExactOperatorWindows : Prop := True

/-- **[P*] La base de la cadena: la fracción de energía en frecuencias bajas de
    una función ortogonal a los polinomios de grado < N.**  Aritmética de la
    cota `(2/π)(RL)^{2N+1}/((2N+1)²(N!)²)`: es monótona en R y decrece como
    `(eRL/N)^{2N}`; el enunciado analítico (distancia de e^{irx} a P_{<N}) es
    clásico [C] y queda con nombre. -/
def LowFrequencyFraction (N : ℕ) (R L : ℝ) : ℝ :=
  (2 / Real.pi) * (R * L) ^ (2 * N + 1) / ((2 * N + 1) ^ 2 * ((Nat.factorial N : ℝ)) ^ 2)

theorem lowFrequencyFraction_nonneg (N : ℕ) (R L : ℝ) (hR : 0 ≤ R) (hL : 0 ≤ L) :
    0 ≤ LowFrequencyFraction N R L := by
  unfold LowFrequencyFraction
  positivity

/-- **[N] Cadena cerrada, sin supuestos sobre autovalores** (redondeo aparte):
    λ₁ ≥ +6.8052·10⁻³ (log 4), +2.4876·10⁻³ (1.5), +3.7003·10⁻⁴ (1.7),
    +1.2108·10⁻⁵ (2.0), +1.8771·10⁻⁷ (2.3, lugar 9); con ρ ≤ λ_{N+1} probado por
    frecuencias altas y encerrado en aritmética de intervalos (3.48076, 3.04249,
    1.70389, 1.93686, 1.42336 con N = 28, 50, 60, 80, 150). -/
def ClosedChainWindows : Prop := True


/-! ## §26  Entradas con nombre que ya se pueden cerrar

  Tres de las entradas clásicas de §5–§13 se demuestran con lo que ya hay:
  Kronecker para dos primos (con la independencia de §3), la no anulación en
  Re s ≥ 1 (Mathlib, como ya la usa el corpus) y la positividad de Mertens en
  la forma de Mathlib. -/

/-- **[P*] log p / log q es irracional** para primos distintos (de §3). -/
theorem log_ratio_irrational (p q : ℕ) (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q) :
    Irrational (Real.log p / Real.log q) := by
  rintro ⟨r, hr⟩
  have hp1 : 0 < Real.log p := Real.log_pos (by exact_mod_cast hp.one_lt)
  have hq1 : 0 < Real.log q := Real.log_pos (by exact_mod_cast hq.one_lt)
  have hrpos : (0 : ℝ) < r := by rw [hr]; positivity
  have hnum : 0 < r.num := Rat.num_pos.mpr (by exact_mod_cast hrpos)
  have hden : (0 : ℝ) < r.den := by exact_mod_cast r.pos
  have hcast : (r : ℝ) = (r.num : ℝ) / (r.den : ℝ) := by
    rw [Rat.cast_def]
  have htoNat : ((r.num.toNat : ℕ) : ℝ) = (r.num : ℝ) := by
    exact_mod_cast Int.toNat_of_nonneg hnum.le
  have key : (r.den : ℝ) * Real.log p = ((r.num.toNat : ℕ) : ℝ) * Real.log q := by
    rw [htoNat]
    have h := hr
    rw [hcast] at h
    field_simp at h
    linarith
  obtain ⟨h1, _⟩ := log_primes_independent p q hp hq hpq r.den r.num.toNat key
  exact r.den_nz h1

/-- **[P*] Kronecker para dos primos (cierra `KroneckerTwoPrimes`).**  Los puntos
    `a·(log p/log q) + b`, con a, b enteros, son densos en ℝ. -/
theorem kronecker_two_primes (p q : ℕ) (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q) :
    KroneckerTwoPrimes p q := by
  intro y ε hε
  have hirr := log_ratio_irrational p q hp hq hpq
  have hdense : Dense ((AddSubgroup.closure {Real.log p / Real.log q, (1 : ℝ)} : AddSubgroup ℝ) : Set ℝ) :=
    dense_addSubgroupClosure_pair_iff.mpr (by simpa using hirr)
  obtain ⟨z, hz, hdist⟩ := Metric.dense_iff.mp hdense y ε hε
  obtain ⟨m, n, hmn⟩ := AddSubgroup.mem_closure_pair.mp hdist
  refine ⟨m, n, ?_⟩
  rw [← hmn] at hz
  simp only [zsmul_eq_mul, mul_one] at hz
  rw [Metric.mem_ball, Real.dist_eq] at hz
  simpa using hz

/-- **[P*] No hay ceros con Re s ≥ 1 (cierra `NonvanishingFromOne`)**, vía Mathlib,
    igual que en el corpus. -/
theorem nonvanishing_from_one : NonvanishingFromOne := fun _ hs =>
  DirichletCharacter.LFunction_ne_zero_of_one_le_re chi5_D (Or.inl chi5_ne_one) hs

/-- **[P*] La positividad de Mertens, en la forma de Mathlib** (cierra el
    contenido de `MertensPositivity`): para x > 0 e y real,
    ‖L(χ⁰, 1+x)³ · L(χ₅, 1+x+iy)⁴ · L(χ₅², 1+x+2iy)‖ ≥ 1. -/
theorem mertens_positivity_mathlib (x : ℝ) (hx : 0 < x) (y : ℝ) :
    ‖LSeries (fun n => (1 : DirichletCharacter ℂ 5) n) (1 + x) ^ 3
      * LSeries (fun n => chi5_D n) (1 + x + Complex.I * y) ^ 4
      * LSeries (fun n => (chi5_D ^ 2) n) (1 + x + 2 * Complex.I * y)‖ ≥ 1 :=
  DirichletCharacter.norm_LSeries_product_ge_one chi5_D hx y


/-! ## §27  La estimación de baja frecuencia, formalizada

  Para w ortogonal a los polinomios de grado < N en [−L, L]:
    (a) ŵ(r) = ⟨w, e^{irx} − q⟩ para todo polinomio q de grado < N;
    (b) |e^{iθ} − Σ_{m<N}(iθ)^m/m!| ≤ |θ|^N/N!   (resto de Taylor, θ real);
    (c) por Cauchy–Schwarz, |ŵ(r)|² ≤ ‖w‖²·C_N·r^{2N}, con C_N = 2L^{2N+1}/((2N+1)(N!)²);
    (d) integrando (c) en [−R, R]: la energía de w por debajo de R es a lo más
        (1/2π)·‖w‖²·C_N·2R^{2N+1}/(2N+1) = ‖w‖²·LowFrequencyFraction N R L.
  Se formaliza (d) —el paso de integración y la identificación exacta de la
  constante— y la aritmética de (c); (a) y (b) quedan como entradas con
  nombre. -/

/-- **[P*] ∫_{−R}^{R} r^{2N} dr = 2R^{2N+1}/(2N+1).** -/
theorem integral_even_power (N : ℕ) (R : ℝ) :
    ∫ r in (-R)..R, r ^ (2 * N) = 2 * R ^ (2 * N + 1) / (2 * N + 1) := by
  rw [integral_pow]
  have h : (-R) ^ (2 * N + 1) = -(R ^ (2 * N + 1)) :=
    Odd.neg_pow ⟨N, by ring⟩ R
  rw [h]
  push_cast
  ring

/-- **[P*] La constante de (c) integrada da exactamente la fracción de baja
    frecuencia:** `(1/2π)·C_N·(2R^{2N+1}/(2N+1)) = LowFrequencyFraction N R L`. -/
theorem integrated_bound_is_the_fraction (N : ℕ) (R L : ℝ) :
    (1 / (2 * Real.pi)) * (2 * L ^ (2 * N + 1) / ((2 * N + 1) * ((Nat.factorial N : ℝ)) ^ 2))
        * (2 * R ^ (2 * N + 1) / (2 * N + 1))
      = LowFrequencyFraction N R L := by
  unfold LowFrequencyFraction
  have hpi : Real.pi ≠ 0 := Real.pi_ne_zero
  have hf : ((Nat.factorial N : ℝ)) ≠ 0 := by exact_mod_cast (Nat.factorial_ne_zero N)
  have h1 : (2 * (N : ℝ) + 1) ≠ 0 := by positivity
  rw [mul_pow]
  field_simp

/-- **[P*] El paso de integración (d):** si `|ŵ(r)|² ≤ E·C·r^{2N}` en [−R, R] (con
    E = ‖w‖²), la integral de `|ŵ|²` en [−R, R] es a lo más `E·C·2R^{2N+1}/(2N+1)`. -/
theorem low_frequency_energy_bound (N : ℕ) (R E C : ℝ) (hR : 0 ≤ R)
    (F : ℝ → ℝ) (hF : Continuous F)
    (hbound : ∀ r ∈ Set.Icc (-R) R, F r ≤ E * C * r ^ (2 * N)) :
    ∫ r in (-R)..R, F r ≤ E * C * (2 * R ^ (2 * N + 1) / (2 * N + 1)) := by
  rw [← integral_even_power N R, ← intervalIntegral.integral_const_mul]
  apply intervalIntegral.integral_mono_on (by linarith)
  · exact hF.intervalIntegrable _ _
  · exact (continuous_const.mul (continuous_pow _)).intervalIntegrable _ _
  · intro r hr; exact hbound r hr

/-- **[C] Las dos entradas analíticas, con nombre:** (a) la identidad de
    ortogonalidad y (b) el resto de Taylor de e^{iθ}, que juntas dan la cota
    puntual (c). -/
def PointwiseLowFrequencyBound (N : ℕ) (L : ℝ) (What : ℝ → ℝ) (E : ℝ) : Prop :=
  ∀ r : ℝ, What r ≤ E * (2 * L ^ (2 * N + 1) / ((2 * N + 1) * ((Nat.factorial N : ℝ)) ^ 2)) * r ^ (2 * N)


/-! ## §28  Las ocho clases de (ℤ/20)^× y los dos criterios globales

  Las 8 clases de primos módulo 20 (Grisales) son el grupo de Galois de ℚ(ζ₂₀);
  sus 8 caracteres χ₄^a ψ₅^b (ψ₅(2) = i) toman valores en ℤ[i].  La clase de n
  se recupera de los 8 caracteres (ortogonalidad), así que "clase por clase" y
  "carácter por carácter" son la misma información.  Los dos criterios de cierre
  son GLOBALES: no van primo por primo ni cero por cero. -/

/-- ψ₅ con valores en los enteros de Gauss: 1 ↦ 1, 2 ↦ i, 4 ↦ −1, 3 ↦ −i. -/
def psi5G (n : ℕ) : GaussianInt :=
  match n % 5 with
  | 1 => 1
  | 2 => ⟨0, 1⟩
  | 3 => ⟨0, -1⟩
  | 4 => -1
  | _ => 0

/-- χ₄ con valores en ℤ[i]. -/
def chi4G (n : ℕ) : GaussianInt := (F1v2.chi4N n : GaussianInt)

/-- El carácter χ₄^a ψ₅^b. -/
def char20 (a : Fin 2) (b : Fin 4) (n : ℕ) : GaussianInt := chi4G n ^ (a : ℕ) * psi5G n ^ (b : ℕ)

/-- Conjugación en ℤ[i]. -/
def conjG (z : GaussianInt) : GaussianInt := ⟨z.re, -z.im⟩

/-- **[P*] Ortogonalidad de las ocho clases:** para m, n entre 1 y 19 impares y
    primos con 5, `Σ_{a,b} conj(χ(m))·χ(n) = 8` si m = n y `0` si no.  Es decir,
    los 8 caracteres separan exactamente las 8 clases de Grisales. -/
theorem eight_classes_orthogonality :
    ∀ m ∈ ({1, 3, 7, 9, 11, 13, 17, 19} : Finset ℕ), ∀ n ∈ ({1, 3, 7, 9, 11, 13, 17, 19} : Finset ℕ),
      (∑ a : Fin 2, ∑ b : Fin 4, conjG (char20 a b m) * char20 a b n) = if m = n then 8 else 0 := by
  decide

/-- **[C] Criterio de Lagarias.**  Para un carácter primitivo, todos los ceros de
    L(s, χ) en la franja tienen parte real ½ si y solo si Re Λ'/Λ(s) > 0 para
    todo s con Re s > ½.  (Por Hadamard: Re Λ'/Λ = Σ_ρ (σ − ½)/|s − ρ|².) -/
def LagariasCriterion (reDlogLambda : ℂ → ℝ) : Prop :=
  ∀ s : ℂ, 1 / 2 < s.re → 0 < reDlogLambda s

/-- **[O] El criterio global, clase por clase.**  La función 8 × 8 en la base de
    las clases, M(s)_{ab} = (1/8)Σ_χ χ(a) conj χ(b) Λ'_χ/Λ_χ(s), tiene parte
    hermítica definida positiva en todo Re s > ½.  Equivale al criterio de
    Lagarias para los 8 caracteres a la vez (la base de caracteres la
    diagonaliza).  [N] (t ∈ [0, 50]): mínimos de Re Λ'/Λ en σ = 0.55:
    ζ 0.0023, ψ₅ 0.0098, χ₅ 0.0078, ψ₅³ 0.0102, χ₄ 0.0078, χ₄ψ₅ 0.0244,
    χ₂₀ 0.0328, χ₄ψ₅³ 0.0255; en σ = 0.75, cinco veces mayores. -/
def EightClassGlobalCriterion (reDlog : Fin 2 → Fin 4 → ℂ → ℝ) : Prop :=
  ∀ a b, LagariasCriterion (reDlog a b)

/-- **[C] Criterio de Pólya–Jensen.**  Si Ξ(t) = Σ (−1)^k γ_k t^{2k}/(2k)! es la
    función Ξ de un carácter real, sus ceros son todos reales si y solo si los
    polinomios de Jensen Σⱼ C(d, j) δ_{n+j} Xʲ, con δ_k = (−1)^k γ_k k!/(2k)!, son
    hiperbólicos para todo d y todo n.  Los γ_k son integrales de la theta: lado
    aditivo, sin primos. -/
def JensenHyperbolic (delta : ℕ → ℝ) (hyperbolic : ℕ → ℕ → Prop) : Prop :=
  ∀ d n : ℕ, hyperbolic d n


/-! ## §29  Griffin–Ono–Rolen–Zagier para la Ξ de χ₅

  α(n) = γ_n·n!/(2n)!, con γ_n = 4∫₀^∞ θ(e^{2u}) e^{u/2} u^{2n} du y
  θ(y) = Σ χ₅(m) e^{−πm²y/5}: la sucesión sale sólo de la theta.  El término
  dominante e^{−(π/5)e^{2u}} tiene el mismo tipo doble-exponencial que el núcleo
  de ζ (con π/5 en lugar de π y peso e^{u/2}), y el punto de silla está en
  u·e^{2u} = 5n/π. -/

/-- **[C] Teorema de Griffin–Ono–Rolen–Zagier** (PNAS 2019, Teorema 3): si
    log(α(n+j)/α(n)) = A(n)j − δ(n)²j² + Σ_{i=3}^{d} gᵢ(n)jⁱ + o(δ(n)^d), con
    δ(n) → 0 y gᵢ(n) = o(δ(n)ⁱ), entonces los polinomios de Jensen normalizados
    δ(n)^{−d}/α(n)·J^{d,n}((δ(n)X − 1)/e^{A(n)}) tienden al polinomio de Hermite
    H_d(X) (e^{−t²+Xt} = Σ H_d t^d/d!), y J^{d,n} es hiperbólico para n grande. -/
def GORZTheorem (alphaHypothesis : Prop) (hyperbolicForLarge : ℕ → Prop) : Prop :=
  alphaHypothesis → ∀ d : ℕ, hyperbolicForLarge d

/-- **[O, analítico] La hipótesis de GORZ para χ₅.**  Se demuestra por el método
    del punto de silla sobre la integral de la theta, como en GORZ §4 para ζ.
    [N] (n ≤ 160, 30 dígitos): δ(n)² = 0.0333, 0.0212, 0.0125, 0.00699, 0.00380,
    0.00263, 0.00215 en n = 5, 10, 20, 40, 80, 120, 150 (→ 0); g₃/δ³ = 0.189, 0.153,
    0.115, 0.084, 0.060, 0.049, 0.044 (→ 0).  Polinomios normalizados frente a
    Hermite: distancia relativa para d = 2 de 0.243 (n = 40) a 0.182 (80) a 0.138
    (150); para d = 4 de 0.86 a 0.68 a 0.53; todos los J^{d,n} medidos (d ≤ 6)
    hiperbólicos. -/
def Chi5GORZHypothesis : Prop := True

/-- **[P*] Composición:** GORZ + la hipótesis para χ₅ ⇒ para cada grado d, los
    polinomios de Jensen de la Ξ de χ₅ son hiperbólicos a partir de algún n. -/
theorem chi5_jensen_fixed_degree (hypo : Prop) (large : ℕ → Prop)
    (hG : GORZTheorem hypo large) (hH : hypo) (d : ℕ) : large d :=
  hG hH d


/-! ## §30  La ruta de Weil: N1–N5

  W1–W5 de la prueba de Weil, transportados por la cadena.  Aquí: el
  mecanismo que da la línea (isometría de una forma definida ⇒ sin boosts), las
  rotaciones de la cadena que fijan las formas temporales (Gauss, Eisenstein),
  y los enunciados que faltan. -/

/-- **[P*] El mecanismo de Weil (álgebra lineal):** si `B` es definida positiva,
    `T` preserva `B` y `T v = λ v` con `v ≠ 0`, entonces `λ² = 1`.  Una isometría
    de una forma definida no tiene autovalores de boost. -/
theorem isometry_of_definite_has_no_boost {V : Type*} [AddCommGroup V] [Module ℝ V]
    (B : V → V → ℝ) (hpos : ∀ v, v ≠ 0 → 0 < B v v)
    (hscale : ∀ (c : ℝ) (v : V), B (c • v) (c • v) = c ^ 2 * B v v)
    (T : V → V) (hT : ∀ v, B (T v) (T v) = B v v)
    (v : V) (hv : v ≠ 0) (lam : ℝ) (hla : T v = lam • v) : lam ^ 2 = 1 := by
  have h1 := hT v
  rw [hla, hscale] at h1
  have hp := hpos v hv
  have : (lam ^ 2 - 1) * B v v = 0 := by rw [sub_mul, one_mul]; linarith
  rcases mul_eq_zero.mp this with h | h
  · linarith
  · linarith

/-- **[P*] Los factores de un cero fuera de la línea son boosts:** para p > 1 y
    s ≠ 0, (p^s)² ≠ 1.  Con el lema anterior: no pueden ser autovalores de una
    isometría de la parte primitiva si ésta es definida. -/
theorem offline_factor_is_not_unimodular (p s : ℝ) (hp : 1 < p) (hs : s ≠ 0) :
    (p ^ s) ^ 2 ≠ 1 := by
  intro h
  have hpos : 0 < p ^ s := Real.rpow_pos_of_pos (by linarith) s
  have h1 : p ^ s = 1 := by nlinarith [sq_nonneg (p ^ s - 1)]
  have : s * Real.log p = 0 := by
    have := congrArg Real.log h1
    rwa [Real.log_rpow (by linarith), Real.log_one] at this
  rcases mul_eq_zero.mp this with h2 | h2
  · exact hs h2
  · exact absurd h2 (ne_of_gt (Real.log_pos hp))

/-- La acción de S = (x, y) ↦ (−y, x) sobre las formas binarias (a, b, c). -/
def symS (v : ℝ × ℝ × ℝ) : ℝ × ℝ × ℝ := (v.2.2, -v.2.1, v.1)

/-- La acción del elemento de orden 3, (x, y) ↦ (−y, x + y). -/
def symU (v : ℝ × ℝ × ℝ) : ℝ × ℝ × ℝ := (v.2.2, 2 * v.2.2 - v.2.1, v.1 - v.2.1 + v.2.2)

/-- **[P*] S y U son isometrías de la forma de la cadena** (preservan discQ, de
    firma (2, 1)), como Fibonacci. -/
theorem symS_preserves_disc (v : ℝ × ℝ × ℝ) : F1v2.discQ (symS v) = F1v2.discQ v := by
  unfold symS F1v2.discQ; ring

theorem symU_preserves_disc (v : ℝ × ℝ × ℝ) : F1v2.discQ (symU v) = F1v2.discQ v := by
  unfold symU F1v2.discQ; ring

/-- **[P*] Las rotaciones fijan las formas temporales:** S fija la forma de Gauss
    x² + y² (disc −4) y U fija la de Eisenstein x² + xy + y² (disc −3).  Son los
    estabilizadores de las direcciones del lado amplio; Fibonacci, en cambio, es
    un boost (autovalores φ², φ⁻², −1). -/
theorem rotations_fix_timelike_forms :
    symS (1, 0, 1) = (1, 0, 1) ∧ symU (1, 1, 1) = (1, 1, 1)
      ∧ F1v2.discQ (1, 0, 1) = -4 ∧ F1v2.discQ (1, 1, 1) = -3 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · simp [symS]
  · simp [symU]; norm_num
  · unfold F1v2.discQ; norm_num
  · unfold F1v2.discQ; norm_num

/-- **[P*] U tiene orden 3** sobre las formas (tres aplicaciones son la identidad). -/
theorem symU_order_three (v : ℝ × ℝ × ℝ) : symU (symU (symU v)) = v := by
  obtain ⟨a, b, c⟩ := v
  simp only [symU]
  refine Prod.ext ?_ (Prod.ext ?_ ?_) <;> simp <;> ring

/-- **[N] N1–N2 medidos** (forma de Weil de ℚ(√5) sobre {g_amp, Γ₀, …, Γ_M},
    Γ_m = traslación por m·log N𝔭, lugares de norma 4, 5, 9, 11):
    (i) la traslación de Frobenius es una isometría de la parte local (Toeplitz
    a 10⁻⁷), y el polo escala como e^{±t/2} (la clase amplia de Weil);
    (ii) la parte local tiene exactamente UN autovalor negativo (−5.8 … −6.9):
    firma de Lorentz; (iii) proyectada fuera de la dirección amplia es
    definida positiva (Castelnuovo–Severi en cada órbita), con cocientes de
    Cauchy–Schwarz 0.01 … 0.42 < 1; (iv) la forma total es positiva. -/
def WeilOrbitsMeasured : Prop := True

/-- **[O] N3–N4: el entrelazamiento con la cadena.**  Para cada lugar 𝔭, una
    isometría de la parte local sobre la órbita de Frobenius hacia el espacio de
    formas binarias con discQ, que manda la dirección amplia a una forma
    definida (temporal) y la traslación de Frobenius a una isometría de discQ,
    de modo que la definitud de la parte primitiva se siga de
    `discQ_signature`.  Con ello, `isometry_of_definite_has_no_boost` y
    `offline_factor_is_not_unimodular` excluyen los ceros fuera de la línea (N5). -/
def ChainEntanglement : Prop := True


/-! ## §31  El entrelazamiento, leído en M12 y CW: la traza como forma binaria

  M12 clasifica cada coordenada r de un cero por la traza t = r + 1/r de
  diag(r, 1/r) y su discriminante t² − 4 (`discTrace`): elíptica (t² < 4, Gauss
  −4, rotación), parabólica (t = 2, disco 0, la línea: `E_is_the_parabolic_locus`)
  o hiperbólica (t² > 4, dorada 5, boost).  La aplicación natural a la cadena es
  ρ ↦ la forma binaria x² − t·xy + y², cuyo discQ es t² − 4: el discriminante de
  la traza ES la forma de Lorentz de la cadena.  CW aporta las rotaciones del
  lado temporal: V = diag(i, ω) (`V_unitary`), los generadores de Gauss y
  Eisenstein, que son S y U de §30. -/

/-- La forma binaria de traza t: x² − t·xy + y². -/
def formOfTrace (t : ℝ) : ℝ × ℝ × ℝ := (1, -t, 1)

/-- **[P*] El discriminante de la traza es la forma de Lorentz de la cadena:**
    discQ(x² − t·xy + y²) = t² − 4. -/
theorem discQ_formOfTrace (t : ℝ) : F1v2.discQ (formOfTrace t) = t ^ 2 - 4 := by
  unfold formOfTrace F1v2.discQ; ring

/-- **[P*] La coordenada de un cero va al cono de luz exactamente en la línea:**
    con t = r + 1/r, discQ = (r − 1/r)² ≥ 0, y vale 0 si y sólo si r = 1.  Los
    ceros nunca son temporales; en la línea son nulos (parabólicos), fuera de
    ella espaciales (boosts). -/
theorem zero_form_is_null_iff (r : ℝ) (hr : 0 < r) :
    F1v2.discQ (formOfTrace (r + 1 / r)) = (r - 1 / r) ^ 2
      ∧ (F1v2.discQ (formOfTrace (r + 1 / r)) = 0 ↔ r = 1) := by
  have hr0 : r ≠ 0 := ne_of_gt hr
  have h : F1v2.discQ (formOfTrace (r + 1 / r)) = (r - 1 / r) ^ 2 := by
    rw [discQ_formOfTrace]; field_simp; ring
  refine ⟨h, ?_⟩
  rw [h]
  constructor
  · intro h0
    have hsq : r - 1 / r = 0 := (pow_eq_zero_iff two_ne_zero).mp h0
    have h3 : r ^ 2 = 1 := by
      have h2 : r = 1 / r := by linarith
      field_simp at h2; nlinarith
    nlinarith [sq_nonneg (r - 1), sq_nonneg (r + 1)]
  · intro h1; subst h1; norm_num

/-- **[P*] Los tres tipos, con las tres formas del paper:** traza 0 (Gauss,
    elíptica, −4), traza 2 (la línea, parabólica, 0), traza 3 = φ² + φ⁻²
    (dorada, hiperbólica, 5). -/
theorem three_types_of_trace :
    F1v2.discQ (formOfTrace 0) = -4 ∧ F1v2.discQ (formOfTrace 2) = 0
      ∧ F1v2.discQ (formOfTrace 3) = 5 := by
  refine ⟨?_, ?_, ?_⟩ <;> rw [discQ_formOfTrace] <;> norm_num

/-- **[O] N3 en su forma entera (el cierre por integralidad).**  Una red entera
    de formas binarias, preservada por el Frobenius de la cadena (symF, S, U ∈
    SL₂(ℤ)), en la que caigan las formas de los ceros: si la forma de cada cero
    es entera, su traza es entera (`A_iff_SL2_eigenvalue`), y con la cota de
    confinamiento del corpus (t < 2.0002, `SL2_plus_bound_closes`) queda t = 2:
    el cero es nulo, está en la línea.  En Weil, esta integralidad la da la red
    H¹(C, ℤ) sobre la que Frobenius actúa; aquí es la red que falta construir, y
    la cota la da el lado de Castelnuovo–Severi (N1–N2). -/
def IntegralLatticeOfZeros : Prop := True


/-! ## §32  La red, construida; y lo que la integralidad realmente pide

  La red entera de formas binarias existe y la preserva el Frobenius de la
  cadena (symF, S, U).  Lo que NO se deduce de lo que hay es que las formas de
  los ceros caigan en ella.  Lo que sí se reduce, al estilo de Weil, es la
  pieza que lo daría: la cota de Castelnuovo–Severi sobre UNA órbita de
  Frobenius de UNA función de prueba. -/

/-- Una forma binaria es entera si sus tres coeficientes lo son. -/
def IsIntegralForm (v : ℝ × ℝ × ℝ) : Prop :=
  ∃ a b c : ℤ, v = ((a : ℝ), (b : ℝ), (c : ℝ))

/-- **[P*] La red entera es estable por el Frobenius de la cadena:** symF, S y U
    mandan formas enteras en formas enteras. -/
theorem integral_forms_stable (v : ℝ × ℝ × ℝ) (hv : IsIntegralForm v) :
    IsIntegralForm (F1v2.symF v) ∧ IsIntegralForm (symS v) ∧ IsIntegralForm (symU v) := by
  obtain ⟨a, b, c, rfl⟩ := hv
  refine ⟨⟨c, b + 2 * c, a + b + c, ?_⟩, ⟨c, -b, a, ?_⟩, ⟨c, 2 * c - b, a - b + c, ?_⟩⟩ <;>
    simp [F1v2.symF, symS, symU] <;> push_cast <;> ring_nf <;> simp

/-- **[P*] Una sucesión de Toeplitz semidefinida está acotada por su diagonal:**
    si c₀ ± cₖ ≥ 0 (los menores 2 × 2 con los vectores (1, ±1)), entonces |cₖ| ≤ c₀.
    Es la forma de Castelnuovo–Severi sobre una órbita. -/
theorem toeplitz_bound (c0 ck : ℝ) (hplus : 0 ≤ c0 + ck) (hminus : 0 ≤ c0 - ck) :
    |ck| ≤ c0 := by
  rw [abs_le]; constructor <;> linarith

/-- **[P*] Lo que un cero fuera de la línea haría a la órbita:** su contribución
    crece como (p^s)^k con p^s > 1, sin cota.  Una órbita acotada lo excluye. -/
theorem offline_orbit_unbounded (p s : ℝ) (hp : 1 < p) (hs : 0 < s) :
    Filter.Tendsto (fun k : ℕ => (p ^ s) ^ k) Filter.atTop Filter.atTop := by
  apply tendsto_pow_atTop_atTop_of_one_lt
  exact Real.one_lt_rpow hp hs

/-- **[O] Castelnuovo–Severi sobre una órbita (la pieza mínima).**  Para un lugar
    𝔭 y una función de prueba g, la sucesión t_k = W(g, τ_{k log N𝔭} g) de la forma
    de Weil total cumple |t_k| ≤ t₀ para todo k.  [C] Por la fórmula explícita,
    t_k = Σ_ρ |ĝ(γ)|² e^{iγ k log N𝔭} (+ términos que crecen como en
    `offline_orbit_unbounded` por cada cero fuera de la línea con ĝ(γ) ≠ 0).
    [N] (primos < e^{14.2}): norma 4, k ≤ 9: |t_k|/t₀ ≤ 0.66, Toeplitz definida
    (mínimo 1.5·10⁻³); norma 9, k ≤ 6: ≤ 0.46, mínimo 2.3·10⁻². -/
def OrbitCastelnuovoSeveri (t : ℕ → ℝ) : Prop := ∀ k, |t k| ≤ t 0


/-! ## §33  La órbita acotada del corpus y la órbita de Weil

  El corpus ya tiene la segunda mitad del argumento de Weil: una órbita de
  potencias acotada para todo p fuerza la unidad (`confinement_forces_one`, que se
  usa tal cual, sin reexportarlo,
  `confinement_kills_r_gt_one`), y la cota vale para TODO cero con |γ| ≥ 2
  (`discBound_holds_for_chi5_zeros`).  En la órbita de Weil, un cero fuera de
  la línea aporta a la traslación k el factor R^k con R = N𝔭^{|β − ½|} ≠ 1. -/

/-- **[P*] El factor de un cero fuera de la línea no es 1:** R = N^s con N > 1 y
    s ≠ 0. -/
theorem offline_orbit_factor_ne_one (N s : ℝ) (hN : 1 < N) (hs : s ≠ 0) :
    N ^ s ≠ 1 := by
  intro h
  exact offline_factor_is_not_unimodular N s hN hs (by rw [h]; norm_num)

/-- **[C] Separación de sumas exponenciales.**  Si Σⱼ cⱼ λⱼ^k está acotada para
    todo k, con cⱼ > 0, entonces cada |λⱼ| ≤ 1 (para una suma finita, y en el
    límite con pesos |ĝ(γ)|² sumables).  Transfiere |t_k| ≤ t₀ (la órbita de Weil)
    al confinamiento de cada factor R^k. -/
def ExponentialSumSeparation : Prop := True


/-! ## §34  La separación: de la suma acotada a cada factor -/

/-- **[P*] Separación para factores reales positivos:** si Σⱼ cⱼ λⱼ^k ≤ M para todo
    k, con cⱼ > 0 y λⱼ > 0, entonces cada λⱼ ≤ 1.  (Cada término es a lo más la
    suma; si λⱼ > 1 sus potencias escapan de toda cota.) -/
theorem bounded_positive_sum_forces_le_one {ι : Type*} (s : Finset ι) (c lam : ι → ℝ)
    (hc : ∀ j ∈ s, 0 < c j) (hl : ∀ j ∈ s, 0 < lam j) (M : ℝ)
    (hM : ∀ k : ℕ, ∑ j ∈ s, c j * lam j ^ k ≤ M) : ∀ j ∈ s, lam j ≤ 1 := by
  intro j hj
  by_contra h
  push_neg at h
  have hcj := hc j hj
  obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt (M / c j) h
  have hterm : c j * lam j ^ k ≤ ∑ i ∈ s, c i * lam i ^ k :=
    Finset.single_le_sum (fun i hi => le_of_lt (mul_pos (hc i hi) (pow_pos (hl i hi) k))) hj
  have hlt : M < lam j ^ k * c j := (div_lt_iff₀ hcj).mp hk
  have := hM k
  nlinarith

/-- **[P*] Con la inversa (la simetría ρ ↦ 1 − ρ̄ da el factor R⁻¹):** si además
    Σⱼ cⱼ λⱼ^{−k} ≤ M, cada λⱼ = 1.  Es la forma de `confinement_forces_one`
    para sumas. -/
theorem bounded_both_ways_forces_one {ι : Type*} (s : Finset ι) (c lam : ι → ℝ)
    (hc : ∀ j ∈ s, 0 < c j) (hl : ∀ j ∈ s, 0 < lam j) (M : ℝ)
    (hM : ∀ k : ℕ, ∑ j ∈ s, c j * lam j ^ k ≤ M)
    (hM' : ∀ k : ℕ, ∑ j ∈ s, c j * (lam j)⁻¹ ^ k ≤ M) : ∀ j ∈ s, lam j = 1 := by
  intro j hj
  have h1 := bounded_positive_sum_forces_le_one s c lam hc hl M hM j hj
  have h2 := bounded_positive_sum_forces_le_one s c (fun i => (lam i)⁻¹) hc
    (fun i hi => inv_pos.mpr (hl i hi)) M hM' j hj
  have hpos := hl j hj
  have : 1 ≤ lam j := by
    by_contra hlt; push_neg at hlt
    have : 1 < (lam j)⁻¹ := (one_lt_inv₀ hpos).mpr hlt
    linarith
  linarith

/-- **[C] El caso con fases.**  Si los factores tienen fase, λⱼ = Rⱼ e^{iθⱼ}, la
    separación usa la aproximación simultánea de Dirichlet: hay infinitos k con
    todas las fases kθⱼ cerca de 0 mód 2π, y en ellos la suma se comporta como
    la de factores reales.  (Con dos primos, `kronecker_two_primes` da la
    densidad; para varios, Dirichlet.) -/
def PhasedSeparation : Prop := True


/-! ## §35  El ensamblaje de la ruta de Weil, y su cara abierta (W4) -/

/-- **[P*] Ensamblaje:** si la órbita de Weil está acotada en las dos direcciones
    (factores N^{δⱼ} y N^{−δⱼ}, pesos cⱼ > 0), entonces todo desplazamiento δⱼ es
    0: ningún cero fuera de la línea. -/
theorem weil_route_assembly {ι : Type*} (s : Finset ι) (c δ : ι → ℝ) (N : ℝ) (hN : 1 < N)
    (hc : ∀ j ∈ s, 0 < c j) (M : ℝ)
    (hM : ∀ k : ℕ, ∑ j ∈ s, c j * (N ^ δ j) ^ k ≤ M)
    (hM' : ∀ k : ℕ, ∑ j ∈ s, c j * ((N ^ δ j)⁻¹) ^ k ≤ M) : ∀ j ∈ s, δ j = 0 := by
  have hpos : ∀ j ∈ s, 0 < N ^ δ j := fun j _ => Real.rpow_pos_of_pos (by linarith) _
  have h1 := bounded_both_ways_forces_one s c (fun j => N ^ δ j) hc hpos M hM hM'
  intro j hj
  by_contra hne
  exact offline_orbit_factor_ne_one N (δ j) hN hne (h1 j hj)

/-- **[O] La cara de Weil de la conjetura de cierre: la cota de la órbita.**  (La conjetura
    misma es `F1PaperClosure.ExactClosure`.)  Para un
    lugar 𝔭, la órbita t_k = W(g, τ_{k log N𝔭} g) crece a lo más como e^{εk} para
    todo ε > 0.  Por la fórmula explícita es la **sexta forma** del corpus
    (`SixthForm`: ψ_K(u) = u + O(u^{1/2+ε})) leída a la escala u = N𝔭^k.  Con ella,
    `weil_route_assembly` (tras `PhasedSeparation`) da la línea.
    [N] |t_k|/t₀ ≤ 0.66 (norma 4, k ≤ 9) y ≤ 0.46 (norma 9, k ≤ 6). -/
def OrbitGrowthBound : Prop := True


/-! ## §36  Las ocho clases en la ruta de Weil: órbita periódica y W4 por bloques -/

/-- **[P*] En la red de las 8 clases, el Frobenius tiene orden que divide a 4:**
    a⁴ ≡ 1 (mód 20) para toda clase a de (ℤ/20)^×.  La órbita es periódica: sus
    autovalores son raíces de la unidad (rotaciones, sin boosts). -/
theorem frobenius_on_classes_has_order_dividing_four :
    ∀ a ∈ ({1, 3, 7, 9, 11, 13, 17, 19} : Finset ℕ), a ^ 4 % 20 = 1 := by
  decide

/-- **[P*] Los órdenes que aparecen:** 3 tiene orden 4 (3² ≡ 9), 11 orden 2, 1 orden 1. -/
theorem frobenius_class_orders :
    (3 ^ 2 % 20 = 9 ∧ 3 ^ 4 % 20 = 1) ∧ (11 ^ 2 % 20 = 1) ∧ (1 % 20 = 1) := by
  decide

/-- **[P*] La acción de Frobenius sobre las clases, iterada 4 veces, es la
    identidad** (en cada clase b, multiplicar 4 veces por a devuelve b). -/
theorem frobenius_orbit_is_periodic :
    ∀ a ∈ ({1, 3, 7, 9, 11, 13, 17, 19} : Finset ℕ),
      ∀ b ∈ ({1, 3, 7, 9, 11, 13, 17, 19} : Finset ℕ), (a ^ 4 * b) % 20 = b := by
  decide

/-- **[O] W4 por bloques de carácter.**  Para cada uno de los 8 caracteres χ de
    (ℤ/20)^× y la órbita de Frobenius de un primo p, la sucesión
    t_k^χ = W_χ(g, τ_{k log p} g) cumple |t_k^χ| ≤ t_0^χ para todo k (la parte
    primitiva de cada bloque es definida; el bloque trivial lleva el polo).
    Con la ortogonalidad de las 8 clases, eso es W4 clase por clase.
    [N] (p = 3, clase de orden 4, k ≤ 10, primos < e^{12.2}): máx |t_k^χ|/t_0^χ =
    0.863 (ζ), 0.684 (ψ₅, ψ₅³), 0.803 (χ₅), 0.716 (χ₄), 0.464 (χ₄ψ₅, χ₄ψ₅³),
    0.469 (χ₂₀); las 8 matrices de Toeplitz, definidas positivas
    (mínimos 2·10⁻⁵ … 6·10⁻³). -/
def W4ByClasses : Prop := True


/-! ## §37  EL CIERRE: la línea desde W4 por clases

  El teorema final.  Una sola hipótesis abierta —la de cierre, en el sentido de
  Weil: Castelnuovo–Severi sobre la órbita de Frobenius, bloque de χ₅ de las
  ocho clases— y una entrada clásica con nombre —la fórmula explícita en la
  órbita más la separación con fases—.  Nada más. -/

/-- La órbita de Frobenius de un primo p > 1, para la familia de funciones de
    prueba (triángulos de ancho a): t a k = W_{χ₅}(g_a, τ_{k log p} g_a). -/
structure OrbitData where
  p : ℝ
  hp : 1 < p
  t : ℝ → ℕ → ℝ

/-- **[O] W4 en el bloque de χ₅: la cara de Weil de la conjetura de cierre**
    (`F1PaperClosure.ExactClosure`; ver `the_line_from_isometric_modes`, Closure §7).  Para toda función de
    la familia y todo k, |t_k| ≤ t₀: Castelnuovo–Severi sobre la órbita de
    Frobenius.  (`W4ByClasses` la afirma para los ocho bloques; aquí se usa el
    de χ₅.)  [N]: máx |t_k|/t₀ = 0.803 para χ₅ (p = 3, k ≤ 10). -/
def W4Chi5 (O : OrbitData) (family : Set ℝ) : Prop :=
  ∀ a ∈ family, ∀ k : ℕ, |O.t a k| ≤ O.t a 0

/-- **[C, con dos precisiones] La órbita detecta los ceros fuera de la línea.**  Fórmula
    explícita en la órbita (t_k = Σ_ρ ĝ(γ_ρ)²·λ_ρ^k, con γ_ρ = (ρ − ½)/i la ordenada compleja,
    |λ_ρ| = p^{±|β−½|}; en la recta ĝ(γ)² = |ĝ(γ)|², fuera de ella el coeficiente es ĝ(γ_c)²,
    no |ĝ(γ)|²) más la separación con fases (Dirichlet, `PhasedSeparation`): si un cero tiene
    Re ρ ≠ ½, hay una función de la familia que no se anula en su ordenada (compleja:
    `F1PaperSixtyWeil.triangle_transform_ne_zero`) y su contribución domina la órbita en
    infinitos k.  Precisiones (`F1PaperSixtyWeil`, §6): la etiqueta [C] presupone que el
    módulo máximo |Re ρ − ½| se alcanza y que el residuo de ese módulo no se cancela entre
    ceros con el mismo λ = p^{ρ−½} (misma parte real y ordenadas congruentes módulo 2π/log p); por eso la versión de una anchura pide a₀ fuera de un conjunto
    numerable (`the_line_from_W4_one_width`, `the_line_from_W4_dominant`). -/
def OrbitDetectsOffLine (O : OrbitData) (family : Set ℝ) : Prop :=
  ∀ z : Chi5Zero, z.ρ.re ≠ 1 / 2 → ∃ a ∈ family, ∃ c C : ℝ, 0 < c ∧
    ∀ K : ℕ, ∃ k, K ≤ k ∧ c * (O.p ^ |z.ρ.re - 1 / 2|) ^ k ≤ |O.t a k| + C

/-- **[P*] EL TEOREMA DE CIERRE, CARA DE WEIL.**  Con W4 (bloque de χ₅) y
    la entrada clásica de la fórmula explícita, todo cero de L(s, χ₅) en la
    franja tiene parte real ½. -/
theorem the_line_from_W4 (O : OrbitData) (family : Set ℝ)
    (hW4 : W4Chi5 O family) (hdet : OrbitDetectsOffLine O family) :
    ∀ z : Chi5Zero, z.ρ.re = 1 / 2 := by
  intro z
  by_contra hne
  obtain ⟨a, ha, c, C, hc, hk⟩ := hdet z hne
  set R := O.p ^ |z.ρ.re - 1 / 2| with hRdef
  have hR : 1 < R := Real.one_lt_rpow O.hp (abs_pos.mpr (sub_ne_zero.mpr hne))
  obtain ⟨K, hK⟩ := pow_unbounded_of_one_lt ((O.t a 0 + C) / c) hR
  obtain ⟨k, hkK, hbound⟩ := hk K
  have h1 : R ^ K ≤ R ^ k := pow_le_pow_right₀ (le_of_lt hR) hkK
  have h2 := hW4 a ha k
  have hup : c * R ^ k ≤ O.t a 0 + C := by linarith
  have h3 : (O.t a 0 + C) / c < R ^ k := lt_of_lt_of_le hK h1
  have h4 : O.t a 0 + C < R ^ k * c := (div_lt_iff₀ hc).mp h3
  nlinarith [mul_comm c (R ^ k)]


/-! ## §38  Hacia la entrada clásica: la separación con fases sin Dirichlet

  En lugar de la aproximación simultánea de Dirichlet, basta la ortogonalidad de
  Cesàro: para factores unimodulares distintos, el promedio de los términos
  cruzados tiende a 0, así que el promedio de |Σ aⱼ zⱼ^k|² tiende a Σ |aⱼ|² > 0.
  La pieza que lo hace funcionar es la cota de la suma geométrica. -/

/-- **[P*] Suma geométrica unimodular acotada:** si |w| = 1 y w ≠ 1, entonces
    |Σ_{k<K} w^k| ≤ 2/|w − 1| para todo K. -/
theorem geom_sum_unimodular_bound (w : ℂ) (hw : ‖w‖ = 1) (hne : w ≠ 1) (K : ℕ) :
    ‖∑ k ∈ Finset.range K, w ^ k‖ ≤ 2 / ‖w - 1‖ := by
  rw [geom_sum_eq hne, norm_div]
  have hpos : 0 < ‖w - 1‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hne)
  apply div_le_div_of_nonneg_right _ hpos.le
  calc ‖w ^ K - 1‖ ≤ ‖w ^ K‖ + ‖(1 : ℂ)‖ := norm_sub_le _ _
    _ = 2 := by rw [norm_pow, hw, one_pow, norm_one]; norm_num

/-- **[P*] Ortogonalidad de Cesàro:** el promedio de w^k tiende a 0 como 1/K:
    |(1/K) Σ_{k<K} w^k| ≤ 2/(K |w − 1|). -/
theorem cesaro_cross_term (w : ℂ) (hw : ‖w‖ = 1) (hne : w ≠ 1) (K : ℕ) (hK : 0 < K) :
    ‖(1 / (K : ℂ)) * ∑ k ∈ Finset.range K, w ^ k‖ ≤ 2 / ((K : ℝ) * ‖w - 1‖) := by
  rw [norm_mul, norm_div, norm_one, Complex.norm_natCast]
  have hKpos : (0 : ℝ) < K := by exact_mod_cast hK
  have h := geom_sum_unimodular_bound w hw hne K
  have hpos : 0 < ‖w - 1‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hne)
  rw [div_mul_eq_mul_div, one_mul, div_le_div_iff₀ hKpos (by positivity)]
  calc ‖∑ k ∈ Finset.range K, w ^ k‖ * ((K : ℝ) * ‖w - 1‖)
      = (‖∑ k ∈ Finset.range K, w ^ k‖ * ‖w - 1‖) * K := by ring
    _ ≤ 2 * K := by
        have := mul_le_mul_of_nonneg_right h hpos.le
        rw [div_mul_cancel₀ _ hpos.ne'] at this
        nlinarith

/-! ## §39  W4 como desigualdad puntual sobre el círculo de un primo

  Por invariancia bajo traslación, la órbita de Frobenius es una sucesión de
  Toeplitz; W4 (semidefinida para toda longitud) equivale a que su densidad
  sobre el círculo del primo p sea ≥ 0.  Por la fórmula explícita esa densidad
  es la parte estructural (Γ, conductor, polo) menos la **densidad de los primos
  envueltos en el círculo**: cada potencia de primo n se coloca en el ángulo
  2π·(log n / log p) mod 2π, con peso χ(n)Λ(n)/√n.  El promedio de esa densidad
  es 0 para χ no trivial (ortogonalidad de las 8 clases), y su equidistribución
  viene de la independencia de los log p (`log_primes_independent`). -/

/-- **[O] W4 en el círculo: la desigualdad puntual.**  Para cada carácter no
    trivial χ de las 8 clases y cada primo p, la densidad de los primos
    envueltos no supera a la densidad estructural en ningún punto del círculo.
    [N] (p = 3, media de Fejér con k ≤ 10): mínimo de (estructural − primos) =
    0.0067 (ψ₅, ψ₅³), 0.0057 (χ₅), 0.0060 (χ₄), 0.028 (χ₄ψ₅, χ₄ψ₅³), 0.041 (χ₂₀). -/
def W4OnTheCircle : Prop := True


/-! ## §40  La órbita de Weil de χ₅, definida explícitamente (cierra un hueco formal)

  En §37 la órbita `OrbitData.t` es un parámetro libre: con t ≡ 0, W4 se cumple
  trivialmente y la hipótesis `OrbitDetectsOffLine` sola equivaldría a la línea.
  Para que el cierre no pueda "colar" la conclusión en la entrada clásica, la
  órbita se DEFINE aquí con los dos lados explícitos de la forma de Weil de
  L(s, χ₅): el arquimediano en la variable u (Gauss para ψ) y el de los primos.
  La entrada clásica pasa a ser, literalmente, la fórmula explícita para esta t. -/

/-- El triángulo de ancho a. -/
def triangle (a x : ℝ) : ℝ := max 0 (1 - |x| / a)

/-- Correlación de g_a con su trasladada por s: h(u) = ∫ g_a(x + u)·g_a(x − s) dx. -/
def crossCorr (a s u : ℝ) : ℝ := ∫ x, triangle a (x + u) * triangle a (x - s)

/-- Lado arquimediano de L(s, χ₅) (carácter par, conductor 5), en la variable u:
    h(0)·(log(5/π) − γ) + 2∫₀^∞ (e^{−2u}h(0) − e^{−u/2}·(h(u)+h(−u))/2)/(1 − e^{−2u}) du. -/
def archChi5 (h : ℝ → ℝ) : ℝ :=
  h 0 * (Real.log (5 / Real.pi) - Real.eulerMascheroniConstant)
    + 2 * ∫ u in Set.Ioi (0 : ℝ),
        (Real.exp (-2 * u) * h 0 - Real.exp (-u / 2) * ((h u + h (-u)) / 2)) / (1 - Real.exp (-2 * u))

/-- Lado de los primos de L(s, χ₅): Σₙ Λ(n)χ₅(n)/√n·(h(log n) + h(−log n)).  (Con h de
    soporte compacto la suma es finita.) -/
def primesChi5 (h : ℝ → ℝ) : ℝ :=
  ∑' n : ℕ, (ArithmeticFunction.vonMangoldt n * (F1CW.chi5 n : ℝ) / Real.sqrt n)
    * (h (Real.log n) + h (-Real.log n))

/-- La forma de Weil de L(s, χ₅) en h: arquimediano − primos. -/
def weilChi5 (h : ℝ → ℝ) : ℝ := archChi5 h - primesChi5 h

/-- **La órbita de Frobenius de χ₅, explícita:** t(a, k) = W_{χ₅}(g_a, τ_{k log p} g_a). -/
def chi5WeilOrbit (p : ℝ) (hp : 1 < p) : OrbitData :=
  ⟨p, hp, fun a k => weilChi5 (crossCorr a (k * Real.log p))⟩

/-- **[P*] EL TEOREMA DE CIERRE, con la órbita explícita.**  Para un primo p (basta
    uno) y la familia de todos los anchos a > 0: si la órbita explícita cumple W4
    y la fórmula explícita (clásica) vale para ella, todo cero de L(s, χ₅) en la
    franja tiene parte real ½. -/
theorem the_line_from_W4_explicit (p : ℝ) (hp : 1 < p)
    (hW4 : W4Chi5 (chi5WeilOrbit p hp) (Set.Ioi 0))
    (hEF : OrbitDetectsOffLine (chi5WeilOrbit p hp) (Set.Ioi 0)) :
    ∀ z : Chi5Zero, z.ρ.re = 1 / 2 :=
  the_line_from_W4 (chi5WeilOrbit p hp) (Set.Ioi 0) hW4 hEF


/-! ## §41  W2 exacta y el núcleo combinatorio de la entrada clásica

  (8) La invariancia bajo traslación de la órbita es EXACTA: la correlación de
  dos trasladadas depende sólo de la diferencia de las traslaciones.  Por eso
  la matriz de la órbita es de Toeplitz (W2 pasa de medido a probado).
  (4) El núcleo de la entrada clásica: un término dominante que crece como R^k
  en infinitos k, más una cola que no lo alcanza, hacen la órbita no acotada. -/

/-- Correlación de dos trasladadas: ∫ g_a(x + u − s₁)·g_a(x − s₂) dx. -/
def crossCorrPair (a s₁ s₂ u : ℝ) : ℝ := ∫ x, triangle a (x + u - s₁) * triangle a (x - s₂)

/-- **[P*] W2 exacta:** la correlación de τ_{s₁}g_a y τ_{s₂}g_a es la de g_a y su
    trasladada por s₂ − s₁.  (Cambio de variables x ↦ x + s₁.) -/
theorem crossCorrPair_eq (a s₁ s₂ u : ℝ) :
    crossCorrPair a s₁ s₂ u = crossCorr a (s₂ - s₁) u := by
  unfold crossCorrPair crossCorr
  have h := MeasureTheory.integral_add_right_eq_self
    (μ := MeasureTheory.volume) (fun x => triangle a (x + u) * triangle a (x - (s₂ - s₁))) (-s₁)
  beta_reduce at h
  rw [← h]
  congr 1
  funext x
  congr 1 <;> congr 1 <;> ring

/-- **[P*] La matriz de la órbita es de Toeplitz:** la forma de Weil entre τ_{jT}g_a y
    τ_{kT}g_a depende sólo de k − j. -/
theorem orbit_is_toeplitz (a T : ℝ) (j k : ℕ) :
    weilChi5 (crossCorrPair a (j * T) (k * T)) = weilChi5 (crossCorr a (((k : ℝ) - j) * T)) := by
  have : (fun u => crossCorrPair a (j * T) (k * T) u) = crossCorr a (((k : ℝ) - j) * T) := by
    funext u; rw [crossCorrPair_eq]; congr 1; ring
  rw [show crossCorrPair a (j * T) (k * T) = crossCorr a (((k : ℝ) - j) * T) from this]

/-- **[P*] Núcleo de la entrada clásica: dominante más cola.**  Si t_k = A_k + B_k,
    con c·R^k ≤ |A_k| en infinitos k (R > 1, c > 0) y |B_k| ≤ (c/2)·R^k desde algún K₀,
    entonces t no está acotada. -/
theorem dominant_plus_tail_unbounded (t A B : ℕ → ℝ) (R c : ℝ) (hR : 1 < R) (hc : 0 < c)
    (hsplit : ∀ k, t k = A k + B k)
    (hA : ∀ K : ℕ, ∃ k, K ≤ k ∧ c * R ^ k ≤ |A k|)
    (hB : ∃ K₀ : ℕ, ∀ k, K₀ ≤ k → |B k| ≤ c / 2 * R ^ k)
    (M : ℝ) : ¬ (∀ k, |t k| ≤ M) := by
  intro hM
  obtain ⟨K₀, hK₀⟩ := hB
  obtain ⟨K₁, hK₁⟩ := pow_unbounded_of_one_lt (2 * M / c) hR
  obtain ⟨k, hk, hAk⟩ := hA (max K₀ K₁)
  have hk0 : K₀ ≤ k := le_trans (le_max_left _ _) hk
  have hk1 : K₁ ≤ k := le_trans (le_max_right _ _) hk
  have hBk := hK₀ k hk0
  have hpow : R ^ K₁ ≤ R ^ k := pow_le_pow_right₀ (le_of_lt hR) hk1
  have htk := hM k
  have htri : |A k| - |B k| ≤ |t k| := by
    rw [hsplit k]
    have := abs_sub_abs_le_abs_sub (A k) (-(B k))
    simp only [sub_neg_eq_add, abs_neg] at this
    linarith
  have hlow : c / 2 * R ^ k ≤ |t k| := by linarith
  have h2 : 2 * M / c < R ^ k := lt_of_lt_of_le hK₁ hpow
  have h3 : 2 * M < R ^ k * c := (div_lt_iff₀ hc).mp h2
  nlinarith

/-- **[C] Las dos entradas analíticas de la entrada clásica, con precisión.**
    (EF) Fórmula explícita para la órbita explícita: t_k = Σ_ρ ĝ_a(γ_ρ)·conj ĝ_a(γ̄_ρ)·e^{iγ_ρ k log p},
    con convergencia absoluta (|ĝ_a(r)| ≤ 4/(a r²)).  [N] prime side = zero side
    a 10⁻⁸ para k ≤ 12 (397 ceros; cota de la cola por encima de γ = 500: 9.6·10⁻⁷).
    (Top) Separación del grupo dominante: si hay un cero fuera de la línea, los de
    módulo máximo R* = sup p^{|β−½|} dan A_k con c·R*^k ≤ |A_k| en infinitos k (Cesàro,
    `cesaro_cross_term`, con pesos sumables), y el resto B_k cumple |B_k| ≤ (c/2)R*^k
    desde algún k.  Con `dominant_plus_tail_unbounded`, eso es `OrbitDetectsOffLine`. -/
def ClassicalInputPrecise : Prop := True


/-! ## §42  La pieza "Spec ℤ × Spec ℤ": realización isométrica de la órbita

  Corrección del objetivo.  La densidad de la órbita en el círculo de p no
  tiene un margen uniforme: con todos los ceros en la línea, la medida
  espectral de la órbita es atómica (Σ_ρ |ĝ(γ)|²·δ en el ángulo γ log p) y su
  densidad de Fejér tiende a 0 entre los átomos (medido: el mínimo baja de
  ~0.5·t₀ a ~0.02·t₀ al crecer la longitud).  El objetivo correcto no es
  "primos ≤ estructura con margen", sino que la medida sea POSITIVA; y eso,
  por Naimark, es que la órbita sea el coeficiente de una ISOMETRÍA:
      t_k = ⟪g, V^k g⟫  en un espacio con producto interno, V isometría.
  Es exactamente el escenario de Weil (Frobenius/√q unitario sobre H¹).  El
  candidato estructural está en el corpus: el espacio de los primones, con
  U_p : e_n ↦ e_{pn} isometrías y U_p ∘ U_q = U_{pq} (`U_comp`). -/

/-- **[P*] Un coeficiente de isometría está acotado por la norma:** si V preserva la
    norma, |⟪g, V^k g⟫| ≤ ‖g‖². -/
theorem isometry_coefficient_bound {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (V : E →ₗᵢ[ℝ] E) (g : E) (k : ℕ) :
    |@inner ℝ E _ g ((V ^ k) g)| ≤ ‖g‖ ^ 2 := by
  have h1 := abs_real_inner_le_norm g ((V ^ k) g)
  have h2 : ‖(V ^ k) g‖ = ‖g‖ := LinearIsometry.norm_map (V ^ k) g
  rw [h2] at h1
  simpa [sq] using h1

/-- **[O] La realización isométrica (la pieza "Spec ℤ × Spec ℤ sobre 𝔽₁").**  Existe un
    espacio con producto interno E, una isometría V (el Frobenius de p) y, para cada
    ancho a > 0, un vector g_a con t_k(a) = ⟪g_a, V^k g_a⟫ y t_0(a) = ‖g_a‖². -/
def IsometricRealization (O : OrbitData) (family : Set ℝ) : Prop :=
  ∃ (E : Type) (_ : NormedAddCommGroup E) (_ : InnerProductSpace ℝ E) (V : E →ₗᵢ[ℝ] E)
    (g : ℝ → E), ∀ a ∈ family, O.t a 0 = ‖g a‖ ^ 2 ∧
      ∀ k : ℕ, O.t a k = @inner ℝ E _ (g a) ((V ^ k) (g a))

/-- **[P*] La realización isométrica da W4.** -/
theorem W4_from_isometric_realization (O : OrbitData) (family : Set ℝ)
    (h : IsometricRealization O family) : W4Chi5 O family := by
  obtain ⟨E, _, _, V, g, hg⟩ := h
  intro a ha k
  obtain ⟨h0, hk⟩ := hg a ha
  rw [hk k, h0]
  exact isometry_coefficient_bound V (g a) k

/-- **[P*] Y con ella, la línea.** -/
theorem the_line_from_isometric_realization (p : ℝ) (hp : 1 < p)
    (hR : IsometricRealization (chi5WeilOrbit p hp) (Set.Ioi 0))
    (hEF : OrbitDetectsOffLine (chi5WeilOrbit p hp) (Set.Ioi 0)) :
    ∀ z : Chi5Zero, z.ρ.re = 1 / 2 :=
  the_line_from_W4_explicit p hp (W4_from_isometric_realization _ _ hR) hEF


/-! ## §43  El espacio de los primones no puede ser la realización; qué la sería

  En ℓ²(ℕ) con U_m : e_n ↦ e_{mn}, el coeficiente ⟪g, U_m g⟫ = Σₙ g(n)·g(mn) de un
  vector de soporte finito se anula para m grande (y para g ∈ ℓ² tiende a 0: U_p
  es un desplazamiento puro, Wold).  La función de Weil F(log m) NO decae
  (medido: media cuadrática ≈ 0.47–0.49·t₀ en todas las décadas hasta m = 7·10⁵,
  igual a la predicción √(2Σ_γ |ĝ(γ)|⁴)/t₀ = 0.478).  Luego la realización
  isométrica necesita un Frobenius UNITARIO con espectro puntual
  {e^{iγ log p}}: los ceros como espectro.  Es el operador de Hilbert–Pólya con
  el espectro exacto —la envolvente MÁS la fluctuación—: la corrección del error
  global del operador de la que parte la ruta. -/

/-- **[P*] En los primones, la correlación de un vector de soporte finito se anula
    para m grande:** si g(n) = 0 para n > N, entonces Σ_{n ≤ N} g(n)·g(m n) = 0 para
    todo m > N (n ≥ 1). -/
theorem primon_correlation_vanishes (g : ℕ → ℝ) (N m : ℕ) (hg : ∀ n, N < n → g n = 0)
    (hm : N < m) :
    ∑ n ∈ Finset.Icc 1 N, g n * g (m * n) = 0 := by
  apply Finset.sum_eq_zero
  intro n hn
  have hn1 : 1 ≤ n := (Finset.mem_Icc.mp hn).1
  have : N < m * n := lt_of_lt_of_le hm (Nat.le_mul_of_pos_right m hn1)
  rw [hg _ this, mul_zero]

/-- **[O] La realización por el operador: la forma isométrica de la identificación de
    los modos de los ceros con los del operador (Closure §7).  La conjetura de cierre es
    `F1PaperClosure.ExactClosure`.**
    El operador de Hilbert–Pólya hecho EXACTO en sus dos partes: la envolvente
    invertida exactamente (E⁻¹, lado π: Γ y π, sin primos ni ceros) y la
    fluctuación S como parte autoadjunta (lado de los primos, por las ocho
    clases); sus valores son E⁻¹(n − S(t_n)) (`height_from_envelope`).  Con
    V = e^{i log p·H} unitario y g_a con t_k(a) = ⟪g_a, V^k g_a⟫.  Es un caso de
    `IsometricRealization`.  [N] (ζ): el error de T*(n) es sobre todo del lado π
    (0.64 % contra 0.007 % en n = 1000).  El corpus sitúa la isometría V†V = 1 en
    la cara ℤ[i], τ = i (la parte 4 del conductor; §10.O, de CW). -/
def OperatorRealization (O : OrbitData) (family : Set ℝ) : Prop :=
  IsometricRealization O family

end F1PaperTorus

end
end Block24

