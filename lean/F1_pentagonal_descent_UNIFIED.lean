/-- Suma del par. Corpus §87. -/
noncomputable def sym₁ (a b : ℝ) : ℝ := a + b

/-- Producto del par. Corpus §87. -/
noncomputable def sym₂ (a b : ℝ) : ℝ := a * b

/-- Discriminante del par. Corpus §87. -/
