/-! ## §87.1  Las funciones simétricas, y el volteo de signo -/

/-- Suma del par. -/
def sym₁ (a b : ℝ) : ℝ := a + b

/-- Producto del par. -/
def sym₂ (a b : ℝ) : ℝ := a * b

/-- Discriminante del par. -/
def discr (a b : ℝ) : ℝ := (sym₁ a b) ^ 2 - 4 * (sym₂ a b)

/-- **[P] EL PAR DE GALOIS ES EL VOLTEO DEL DE LA DECORACIÓN.**
    `1 − φ = −1/φ`.  No son dos objetos: son `{φ, ±φ⁻¹}`. -/
theorem galois_pair_is_the_sign_flip : (1 : ℝ) - φ = -(1 / φ) := by
  have h := inv_phi_eq_phi_sub_one
  rw [h]; ring

/-- **[P] EL VOLTEO INTERCAMBIA `e₁²` Y `disc`.**  Para TODO par:
    `e₁(a,−b)² = disc(a,b)` y `disc(a,−b) = e₁(a,b)²`.

    No es propiedad de `φ`; es identidad de polinomios. -/
theorem sign_flip_swaps (a b : ℝ) :
    (sym₁ a (-b)) ^ 2 = discr a b ∧
    discr a (-b) = (sym₁ a b) ^ 2 := by
  simp only [sym₁, sym₂, discr]
  constructor <;> ring

/-- **[P] Y EL PRODUCTO `e₁²·disc` ES INVARIANTE BAJO EL VOLTEO.**
    Porque vale `(a²−b²)²`, que es par en `b`. -/
theorem flip_invariant (a b : ℝ) :
    (sym₁ a b) ^ 2 * discr a b = (a ^ 2 - b ^ 2) ^ 2 := by
  simp only [sym₁, sym₂, discr]
  ring

/-- **[P] EXPLÍCITAMENTE: EL INVARIANTE NO VE EL SIGNO.** -/
theorem flip_invariant_is_even (a b : ℝ) :
    (sym₁ a b) ^ 2 * discr a b = (sym₁ a (-b)) ^ 2 * discr a (-b) := by
  rw [flip_invariant, flip_invariant]; ring

/-! ## §87.2  El `5` es el invariante, no una coordenada -/

/-- **[P] LA BRECHA ES EL FACTOR QUE LLEVA `k=1` A `k=2`.**
    `φ² − φ⁻² = (φ − φ⁻¹)(φ + φ⁻¹)`, y el primer factor es `1`. -/
theorem unit_gap_is_the_factor :
    (φ : ℝ) ^ 2 - (1 / φ) ^ 2 = ((φ : ℝ) - 1 / φ) * ((φ : ℝ) + 1 / φ) := by
  ring

/-- **[P] Y ENTONCES VALE `√5`.**  Con `φ − φ⁻¹ = 1`
    (`decoration_pair_gap_is_one`) y `φ + φ⁻¹ = √5`
    (`decoration_pair_symmetric`). -/
theorem unit_gap_times_pentagon :
    (φ : ℝ) ^ 2 - (1 / φ) ^ 2 = 1 * Real.sqrt 5 := by
  rw [unit_gap_is_the_factor, decoration_pair_gap_is_one,
      decoration_pair_symmetric.2.1]

/-- **[P] EL PENTÁGONO ES EL INVARIANTE DEL VOLTEO.**
    `e₁²·disc = (φ² − φ⁻²)² = 5` para el par `{φ, φ⁻¹}`, y el mismo
    valor para `{φ, −φ⁻¹}`.

    **Éste es el enunciado que la frase de §44 hacía invisible**: el
    `5` no se pierde al desplazar `e₂`; es lo que el desplazamiento
    conserva. -/
theorem pentagon_is_the_flip_invariant :
    (sym₁ (φ : ℝ) (1 / φ)) ^ 2 * discr (φ : ℝ) (1 / φ) = 5 ∧
    (sym₁ (φ : ℝ) (1 / φ)) ^ 2 * discr (φ : ℝ) (1 / φ)
      = (sym₁ (φ : ℝ) (-(1 / φ))) ^ 2 * discr (φ : ℝ) (-(1 / φ)) := by
  refine ⟨?_, flip_invariant_is_even _ _⟩
  rw [flip_invariant, unit_gap_times_pentagon, one_mul]
  exact Real.sq_sqrt (by norm_num)

/-! ## §87.3  Las dos lecturas valen a la vez -/

/-- **[P] LA DECORACIÓN ES INSTANCIA DE `φ² = φ + 1`.**  En dos pasos,
    los dos en Lean: `1/φ = φ − 1` sale de `phi_sq`, y de ahí
    `e₁ = φ + 1/φ = 2φ − 1 = √5`.

    **`e₁` de la decoración ES el pentágono, y llega ahí por la
    identidad.**  Negar la instancia corta exactamente aquí. -/
theorem decoration_is_an_instance :
    ((φ : ℝ) ^ 2 = φ + 1) ∧
    ((1 : ℝ) / φ = φ - 1) ∧
    ((φ : ℝ) + 1 / φ = 2 * φ - 1) ∧
    ((φ : ℝ) + 1 / φ = Real.sqrt 5) := by
  refine ⟨phi_sq, inv_phi_eq_phi_sub_one, ?_, decoration_pair_symmetric.2.1⟩
  rw [inv_phi_eq_phi_sub_one]; ring

/-- **[P] Y TAMBIÉN ES EL DESPLAZAMIENTO DE `e₂`.**  Las dos lecturas
    son compatibles: la segunda especifica a la primera.

    (i)  instancia de `φ²=φ+1`   ← transporta el `5`
    (ii) `e₂` de `−1` a `+1`     ← el signo, cara `χ₄`

    **No son mutuamente excluyentes.**  El «NO… sino» de §44 L6114
    debe sustituirse por «Y ADEMÁS». -/
theorem both_readings_hold :
    ((φ : ℝ) ^ 2 = φ + 1) ∧
    ((1 : ℝ) - φ = -(1 / φ)) ∧
    (sym₂ (φ : ℝ) (-(1 / φ)) = -1) ∧
    (sym₂ (φ : ℝ) (1 / φ) = 1) := by
  have hne : (φ : ℝ) ≠ 0 := ne_of_gt (lt_trans one_pos φ_gt_one)
  refine ⟨phi_sq, galois_pair_is_the_sign_flip, ?_, ?_⟩ <;>
    unfold sym₂ <;> field_simp

/-! ## §87.4  La conjetura, corregida -/

/-- **[P] LA MITAD `χ₄` DEL SALTO ESTÁ CERRADA.**  El par de los ceros
    es `{r, +1/r}`: el signo vale `+1`, no `−1`.  Es `e₂ = 1`, la
    ecuación funcional. -/
def SignHalf (r : ℝ) : Prop := sym₂ r (1 / r) = 1

theorem sign_half_is_closed (r : ℝ) (hr : r ≠ 0) : SignHalf r := by
  unfold SignHalf sym₂; field_simp

/-- **[Conj] LA MITAD `χ₅`, QUE ES LO QUE QUEDA.**  Que el módulo sea
    un MONOMIO en la torre: `r = φ^k` con `k ∈ ℤ`.

    En la capa de numeración: que la expansión de `r` en base `φ`
    tenga UN SOLO dígito.

    CAUTELA (E64).  Toda real tiene expansión en base `φ`
    (Bergman/Zeckendorf), igual que `ℤ[φ]` es denso: TENERLA no
    restringe.  Lo restrictivo es la MONOMIALIDAD. -/
def MonomialHalf (r : ℝ) : Prop := ∃ k : ℤ, r = (φ : ℝ) ^ k

/-- **[Conj] LA CONJETURA CORREGIDA `(I')`.**  Sustituye a `(I)` de
    §85: se conjetura SÓLO la mitad `χ₅`, porque la `χ₄` está probada. -/
def IntegralityConjecture' (zeros : Set ℝ) : Prop :=
  ∀ r ∈ zeros, MonomialHalf r

/-- **[P] `(I')` SIGUE DANDO `E`.**  Con `r = φ^k`, el discriminante es
    `(φ^k − φ^{−k})²`, que está en la cadena de §84; con la cota bajo
    la brecha, `k = 0` y `r = 1`. -/
theorem corrected_conjecture_gives_disc_in_chain (r : ℝ)
    (h : MonomialHalf r) :
    ∃ k : ℤ, discr r (1 / r) = ((φ : ℝ) ^ k - (φ : ℝ) ^ (-k)) ^ 2 := by
  obtain ⟨k, rfl⟩ := h
  refine ⟨k, ?_⟩
  have hne : ((φ : ℝ)) ≠ 0 := ne_of_gt (lt_trans one_pos φ_gt_one)
  have hk : ((φ : ℝ) ^ k) ≠ 0 := zpow_ne_zero k hne
  have hinv : (1 : ℝ) / (φ : ℝ) ^ k = (φ : ℝ) ^ (-k) := by
    rw [zpow_neg]; field_simp
  have this : ((φ : ℝ) ^ k) * ((φ : ℝ) ^ (-k)) = 1 := by
    rw [← zpow_add₀ hne]; simp
  rw [hinv]
  change ((φ : ℝ) ^ k + (φ : ℝ) ^ (-k)) ^ 2 - 4 * ((φ : ℝ) ^ k * (φ : ℝ) ^ (-k))
      = ((φ : ℝ) ^ k - (φ : ℝ) ^ (-k)) ^ 2
  ring

/-! ## §87.5  Lo que la conjetura de §85 ignoraba -/

/-- **[O] EL BALANCE DE §87.**

    | lo ignorado en §85 | dónde está |
    |---|---|
    | el ancla da TRES cosas, no una | §86 `anchor_gives_three` |
    | cuatro igualdades sobre el conjunto | §86 `four_equalities_on_the_set` |
    | el par de Galois, `e₂ = −1`, `disc = 5` | §44 `galois_pair_discriminant` |
    | el desplazamiento ES un signo (`χ₄`) | §87 `galois_pair_is_the_sign_flip` |
    | el `5` es el INVARIANTE del volteo | §87 `pentagon_is_the_flip_invariant` |
    | la brecha es el factor `k=1 → k=2` | §87 `unit_gap_is_the_factor` |
    | la mitad `χ₄` del salto ya cerrada | §87 `sign_half_is_closed` |
    | `20 = \|disc ℚ(i)\|·\|disc ℚ(√5)\|` | §51 |

    Y lo que sigue `[Conj]`: la monomialidad, `MonomialHalf`. -/
theorem the_balance_of_section_87 (r : ℝ) (hr : r ≠ 0) :
    ((φ : ℝ) ^ 2 = φ + 1) ∧
    ((1 : ℝ) - φ = -(1 / φ)) ∧
    ((sym₁ (φ : ℝ) (1 / φ)) ^ 2 * discr (φ : ℝ) (1 / φ) = 5) ∧
    ((φ : ℝ) ^ 2 - (1 / φ) ^ 2 = 1 * Real.sqrt 5) ∧
    (SignHalf r) :=
  ⟨phi_sq, galois_pair_is_the_sign_flip,
   pentagon_is_the_flip_invariant.1, unit_gap_times_pentagon,
   sign_half_is_closed r hr⟩

