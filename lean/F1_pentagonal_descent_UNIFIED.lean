    (zeroCoord z.ρ = 1 ↔ z.ρ.re = 1/2) := by
  have h0 : z.ρ ≠ 0 := by
    intro h; have := z.in_strip_pos; rw [h] at this; simp at this
  have h1 : z.ρ ≠ 1 := by
    intro h; have := z.in_strip_lt; rw [h] at this; simp at this
  exact ⟨coordinate_is_equivariant z.ρ h0 h1,
         coord_gt_one_iff_re_lt_half z.ρ z.in_strip_pos z.in_strip_lt,
         coord_eq_one_iff_re_half z.ρ z.in_strip_pos⟩

theorem unconditional_valPhi_bound (z : Chi5Zero) (hγ : 2 ≤ |z.ρ.im|) :
    |valPhi (zeroCoord z.ρ)| ≤ Real.log (2 / Real.sqrt 3) / Real.log (φ : ℝ) := by
  have hpos : 0 < zeroCoord z.ρ := zeroCoord_pos_on_zeros z.ρ ⟨z, rfl⟩
  obtain ⟨hlo, hhi⟩ := (unconditional_facts_about_a_zero z hγ).2.2.1
  exact valPhi_small_under_confinement (zeroCoord z.ρ) hpos hlo hhi

theorem the_tenth_property_is_E (z : Chi5Zero) (hγ : 2 ≤ |z.ρ.im|)
    (k : ℤ) (hk : valPhi (zeroCoord z.ρ) = (k : ℝ)) :
    z.ρ.re = 1/2 := by
  have hpos : 0 < zeroCoord z.ρ := zeroCoord_pos_on_zeros z.ρ ⟨z, rfl⟩
  have hle : discP (zeroCoord z.ρ) ≤ 1/12 :=
    discBound_of_high_gamma z.ρ z.in_strip_pos z.in_strip_lt hγ
  have h1 : zeroCoord z.ρ = 1 :=
    integrality_of_valuation_is_E (zeroCoord z.ρ) hpos hle k hk
  exact (coord_eq_one_iff_re_half z.ρ z.in_strip_pos).mp h1

theorem nine_proved_one_missing (z : Chi5Zero) (hγ : 2 ≤ |z.ρ.im|) :
