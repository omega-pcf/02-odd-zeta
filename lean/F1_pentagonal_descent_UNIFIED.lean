theorem zeros_carry_the_sign_action (z : Chi5Zero) :
    zeroCoord (1 - z.ρ) = (zeroCoord z.ρ)⁻¹ ∧
    DirichletCharacter.LFunction chi5_D (1 - z.ρ) = 0 := by
  refine ⟨?_, hecke_chi5_derived z.in_strip_pos z.in_strip_lt z.is_zero⟩
  apply coordinate_is_equivariant
  · intro h; have := z.in_strip_pos; rw [h] at this; simp at this
  · intro h; have := z.in_strip_lt; rw [h] at this; simp at this

def ZeroCoordsCarryPowerAction : Prop :=
  ∀ (p : ℕ), p.Prime → ∀ z : Chi5Zero, ∃ w : Chi5Zero,
    zeroCoord w.ρ = (zeroCoord z.ρ) ^ p

theorem powers_escape_any_bound (r C : ℝ) (hr : 1 < r) (hC : 0 < C) :
    ∃ p : ℕ, C < r ^ p := by
  obtain ⟨p, hp⟩ := pow_unbounded_of_one_lt C hr
  exact ⟨p, hp⟩

theorem the_action_would_close_it (r C : ℝ) (hr1 : 1 < r) (hC : 0 < C)
    (hbound : ∀ p : ℕ, r ^ p ≤ C) : False := by
  obtain ⟨p, hp⟩ := powers_escape_any_bound r C hr1 hC
  exact absurd (hbound p) (not_le.mpr hp)

theorem the_gap_has_a_shape :
    (∀ (r : ℝ) (p : ℕ), (∃ k : ℤ, r = (φ : ℝ) ^ k) → ∃ k : ℤ, r ^ p = (φ : ℝ) ^ k) ∧
    (∀ z : Chi5Zero, zeroCoord (1 - z.ρ) = (zeroCoord z.ρ)⁻¹) ∧
    (∀ (r C : ℝ), 1 < r → 0 < C → ∃ p : ℕ, C < r ^ p) :=
  ⟨fun r p h => image_stable_under_power r p h,
   fun z => (zeros_carry_the_sign_action z).1,
   fun r C h1 h2 => powers_escape_any_bound r C h1 h2⟩

theorem kmate_preserves_ordinate (ρ : ℂ) : (1 - (starRingEnd ℂ) ρ).im = ρ.im := by
