    functionalEquation_chi5⟩,
   the_strip_alone_excludes_the_other_root reZero hemb ρ h0 h1⟩

theorem premise_A_steps_one_to_five (a b : ZMod 20)
    (ha : a ∈ ZtwentyStar) (hb : b ∈ ZtwentyStar) (k : Fin 3)
    (hw : Complex.abs w_pcf = 1)
    (σ μ : ℝ) (hsum : σ + μ = 2) (hprod : σ * μ = 3/4) (hlt : μ < 1)
    (hs : 0 < σ) (hm : 0 < μ) :
    -- (1) los primos fuerzan Z₂₀
    ((∀ r : ℕ, r.Prime → 5 < r → (r : ZMod 20) ∈ ZtwentyStar) ∧
     (ZtwentyStar.card = 8)) ∧
    -- (2) Z₂₀* es puramente multiplicativo
    ((a * b ∈ ZtwentyStar)) ∧
    -- (3) el módulo del fragmento: μ₃ = 1/2
    ((Real.cos (Real.pi / 3) = mu_n_param 3) ∧ ((2:ℝ) - 3/2 = 1/2)) ∧
    -- (4) unicidad espectral
    (σ = 3/2 ∧ μ = 1/2) ∧
    -- (5) No-Diagonal: ‖Ω‖ = 1/2 < 1
    (((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = 1/2) ∧
     (Complex.abs (Omega_hat k) = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ))) ∧
     ((1:ℝ)/2 < 1)) := by
  refine ⟨⟨primes_land_in_ZtwentyStar, kernel_two_and_four_fibres.1⟩,
          mul_closed a ha b hb,
          ⟨cos_pi_third_eq_mu3, by norm_num⟩,
          spectral_uniqueness σ μ hsum hprod hlt hm,
          ⟨anchor_is_the_spectral_scale, spectrum_modulus_is_the_anchor k hw,
           by norm_num⟩⟩

theorem premise_A_is_an_upper_bound_not_E (reZero : ℂ → ℝ)
