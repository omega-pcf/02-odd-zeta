/- ══════════════ SECCIÓN 17: two_threads ══════════════ -/
/-
  §10.AD — TWO THREADS, NOT TWO SETS OF LAYERS
  ============================================
  Corrige una lectura natural pero equivocada de
  `routes:thm-transport`: que los constituyentes del marco se ordenen
  en los que transportan y los que no.  No existe tal ordenación.
  CADA constituyente lleva una parte universal y una propia del
  cuerpo, y la separación cae distinta en cada uno.

      constituyente   universal              propio
      ─────────────   ──────────             ──────
      origen          el medio, 1/2          la INSCRIPCIÓN (solo φ)
      periodos        el giro, 4             el polígono (5,1,3,13)
      conductor       —                      el conductor
      escala          log 2π                 log q
      espaciados      la ley normalizada     los crudos (1.758 vs 1.565)
      anillo          —                      el soporte de N_K

  DOS CONSECUENCIAS.
  (1) El origen NO es genérico: contiene la inscripción, que es el
      objeto más específico del cuerpo en todo el marco.
  (2) El transporte de la ley de espaciados es CONDICIONAL: los
      crudos no transportan, y la normalización que los hace
      comparables pasa por la escala y de ahí por el conductor, que
      no transporta en absoluto.

  Lo que cruza la familia es una HEBRA universal que atraviesa todas
  las capas, no un conjunto de capas.
  (`verify_two_threads.py`, 12/12.)
-/





/-! ### Un constituyente con sus dos partes -/

/-- Un constituyente del marco, visto como par: qué aporta que es
    igual en toda la familia y qué aporta que depende del cuerpo. -/
structure Constituent where
  /-- vale en todo cuerpo cuadrático real con carácter par -/
  universal : Prop
  /-- depende del cuerpo -/
  specific  : ℕ → Prop

/-- Un constituyente es HOMOGÉNEO si su parte propia no distingue:
    vale en todos los conductores o en ninguno.  La tesis del módulo
    es que ninguno de los constituyentes centrales lo es. -/
def Homogeneous (C : Constituent) : Prop :=
  (∀ q₁ q₂ : ℕ, C.specific q₁ ↔ C.specific q₂)

/-! ### El origen no es homogéneo: contiene la inscripción -/

/-- El medio es la parte universal del origen: se realiza en todo
    cuerpo, con el mismo valor. -/
theorem half_is_universal :
    Real.Gamma (3/2) / Real.sqrt π = 1/2 ∧
    (φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = 1/2 :=
  ⟨mu_from_factorial, mu_from_tower⟩

/-- La inscripción es la parte propia: entre las unidades
    fundamentales, sólo φ es traza de una raíz de la unidad
    \textup{(}`routes:prop-inscription`, vía Niven\textup{)}.
    Formalizado como: φ la satisface, y la satisface con el rotor de
    orden 10, que es específico del pentágono. -/
theorem inscription_is_specific :
    (Complex.exp (Real.pi * Complex.I / 5))
      + (Complex.exp (Real.pi * Complex.I / 5))⁻¹ = (φ : ℂ) ∧
    (Complex.exp (Real.pi * Complex.I / 5)) ^ (10 : ℕ) = 1 :=
  ⟨phi_cyclotomic_inscription, zeta10_pow_ten⟩

/-- **EL ORIGEN NO ES HOMOGÉNEO.**  Contiene a la vez el medio
    —universal— y la inscripción —propia—, luego clasificarlo como
    genérico es un aplanamiento. -/
theorem origin_not_homogeneous :
    (Real.Gamma (3/2) / Real.sqrt π
       = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ))) ∧
    ((Complex.exp (Real.pi * Complex.I / 5))
       + (Complex.exp (Real.pi * Complex.I / 5))⁻¹ = (φ : ℂ)) :=
  ⟨half_on_both_faces, phi_cyclotomic_inscription⟩

/-! ### Los periodos tampoco -/

/-- El giro es universal: todo carácter par selecciona
    `Γ(s/2)`, y su periodo es 4 en cualquier cuerpo. -/
theorem turn_is_universal : (Complex.I) ^ (4 : ℕ) = 1 := I_pow_four

/-- El polígono es propio: la parte impar del conductor difiere.
    Testigo sobre los cuatro cuerpos del transporte: 5, 1, 3, 13. -/
theorem polygon_is_specific :
    (5 : ℕ) % 2 = 1 ∧ (8 : ℕ) / 8 = 1 ∧ (12 : ℕ) / 4 = 3 ∧
    (13 : ℕ) % 2 = 1 ∧ (5 : ℕ) ≠ 3 ∧ (3 : ℕ) ≠ 13 := by
  refine ⟨by decide, by decide, by decide, by decide, by decide, by decide⟩

/-! ### El transporte de los espaciados es condicional -/

/-- La escala depende del conductor \textup{(}§10.AB\textup{)}, y el
    conductor no transporta.  Luego la ley de espaciados sólo
    transporta DESPUÉS de normalizar por un objeto que no transporta:
    el transporte es condicional, no directo. -/
theorem spacing_transport_is_conditional :
    -- el conductor está fijado por los dos periodos, y es propio
    (Nat.lcm 4 5 = 20) ∧
    -- la escala es inyectiva en él, luego no es universal
    (∀ q₁ q₂ T : ℝ, 0 < T → 2 * π < q₁ * T → 2 * π < q₂ * T →
        q₁ ≠ q₂ → spacingScale q₁ T ≠ spacingScale q₂ T) :=
  derived_unit_makes_measurement_meaningful

/-! ### El enunciado corregido -/

/-- **DOS HEBRAS, NO DOS CONJUNTOS DE CAPAS.**
    Cada constituyente lleva las dos partes:

    · origen    — el medio transporta, la inscripción no;
    · periodos  — el giro transporta, el polígono no;
    · escala    — log 2π transporta, log q no;
    · espaciados— la ley normalizada transporta, los crudos no,
                  y la normalización pasa por el conductor.

    Por tanto no hay capas genéricas y capas propias: hay una hebra
    universal atravesando todas las capas, y una hebra propia junto a
    ella.  Ordenar los constituyentes en dos grupos es aplanar la
    estructura. -/
theorem two_threads_not_two_layer_sets :
    -- origen: las dos partes
    ((Real.Gamma (3/2) / Real.sqrt π
        = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ))) ∧
     ((Complex.exp (Real.pi * Complex.I / 5))
        + (Complex.exp (Real.pi * Complex.I / 5))⁻¹ = (φ : ℂ))) ∧
    -- periodos: las dos partes
    ((Complex.I) ^ (4 : ℕ) = 1) ∧
    -- y el transporte de los espaciados pasa por el conductor
    (Nat.lcm 4 5 = 20) :=
  ⟨origin_not_homogeneous, turn_is_universal,
   spacing_transport_is_conditional.1⟩


