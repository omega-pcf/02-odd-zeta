-- BLOCK S19. UnOperador  (sprint 118): the one operator 𝒪 = H·Y on ℓ²(𝒥)
-- its spectrum m₀φ^σ·ζ₃^k·(−1)^ε is simple; its modulus is the tower form H,
-- its phase is Y; Y³ = W and Y⁴ = 2Ω̂ (FibraYReloj.yDiag_pow_three, yDiag_pow_four).
-- ════════════════════════════════════════════════════════════════════════════

section UnOperadorBlock

namespace UnOperador
open FibraYReloj

theorem norm_one_C : ‖(1 : ℂ)‖ = 1 := by
  have h := Complex.norm_real 1
  rw [Complex.ofReal_one] at h
  rw [h, Real.norm_eq_abs, abs_one]

/-- Una raíz cúbica de la unidad tiene módulo 1. -/
theorem norm_of_cube (ζ : ℂ) (hζ : ζ ^ 3 = 1) : ‖ζ‖ = 1 := by
  have h : ‖ζ‖ ^ 3 = 1 := by rw [← Complex.norm_pow, hζ, norm_one_C]
  have h0 : 0 ≤ ‖ζ‖ := norm_nonneg _
  by_contra hne
  rcases lt_or_gt_of_ne hne with hlt | hgt
  · have : ‖ζ‖ ^ 3 < 1 := pow_lt_one₀ h0 hlt (by norm_num)
    linarith
  · have : 1 < ‖ζ‖ ^ 3 := one_lt_pow₀ hgt (by norm_num)
    linarith

/-- La fase `Y` es unitaria: cada entrada de su diagonal tiene módulo 1. -/
theorem norm_yDiag (ζ : ℂ) (hζ : ζ ^ 3 = 1) (x : Fin 3 × Fin 2) : ‖yDiag ζ x‖ = 1 := by
  have hn := norm_of_cube ζ hζ
  obtain ⟨k, e⟩ := x
  fin_cases k <;> fin_cases e <;> simp [yDiag, colour, sign, Complex.norm_pow, hn, norm_one_C]

/-- El espectro del operador `𝒪 = H·Y` en `ℓ²(𝒥)`, `𝒥 = ℕ × ℤ/3 × ℤ/2`:
    en el punto (σ, k, ε), el valor `m₀ φ^σ · ζ^k · (−1)^ε`. -/
noncomputable def spec (m₀ φ : ℝ) (ζ : ℂ) (p : ℕ × (Fin 3 × Fin 2)) : ℂ :=
  ((m₀ * φ ^ p.1 : ℝ) : ℂ) * yDiag ζ p.2

/-- **El módulo es la forma de torre.**  `|𝒪| = H = diag(m₀ φ^σ)`. -/
theorem norm_spec (m₀ φ : ℝ) (hm : 0 < m₀) (hφ : 0 < φ) (ζ : ℂ) (hζ : ζ ^ 3 = 1)
    (p : ℕ × (Fin 3 × Fin 2)) : ‖spec m₀ φ ζ p‖ = m₀ * φ ^ p.1 := by
  have hpos : 0 ≤ m₀ * φ ^ p.1 := by positivity
  rw [spec, Complex.norm_mul, Complex.norm_real, norm_yDiag ζ hζ, mul_one, Real.norm_of_nonneg hpos]

/-- **Descomposición polar.**  `𝒪 = |𝒪| · Y`. -/
theorem spec_polar (m₀ φ : ℝ) (hm : 0 < m₀) (hφ : 0 < φ) (ζ : ℂ) (hζ : ζ ^ 3 = 1)
    (p : ℕ × (Fin 3 × Fin 2)) :
    spec m₀ φ ζ p = ((‖spec m₀ φ ζ p‖ : ℝ) : ℂ) * yDiag ζ p.2 := by
  rw [norm_spec m₀ φ hm hφ ζ hζ]; rfl

/-- **Espectro simple.**  Con `m₀ > 0`, `φ > 1` y `ζ` raíz cúbica primitiva, los valores
    `m₀ φ^σ ζ^k (−1)^ε` son distintos dos a dos: el operador `𝒪` separa todo `𝒥`. -/
theorem spec_injective (m₀ φ : ℝ) (hm : 0 < m₀) (hφ : 1 < φ) (ζ : ℂ) (hζ : ζ ^ 3 = 1)
    (h1 : ζ ≠ 1) : Function.Injective (spec m₀ φ ζ) := by
  have hφ0 : 0 < φ := by linarith
  intro p q h
  have hn := congrArg norm h
  rw [norm_spec m₀ φ hm hφ0 ζ hζ, norm_spec m₀ φ hm hφ0 ζ hζ] at hn
  have hpow : φ ^ p.1 = φ ^ q.1 := mul_left_cancel₀ hm.ne' hn
  have hσ : p.1 = q.1 := pow_right_injective₀ hφ0 hφ.ne' hpow
  have hne : ((m₀ * φ ^ q.1 : ℝ) : ℂ) ≠ 0 := by
    have : (m₀ * φ ^ q.1 : ℝ) ≠ 0 := by positivity
    exact_mod_cast this
  have hy : yDiag ζ p.2 = yDiag ζ q.2 := by
    unfold spec at h
    rw [hσ] at h
    exact mul_left_cancel₀ hne h
  exact Prod.ext hσ (yDiag_injective ζ hζ h1 hy)

/-- **Las formas son funciones del operador.**  Del valor propio `λ = m₀φ^σ·y` se leen:
    el nivel por el módulo, la orientación por `y³` y el color por `y⁴`. -/
theorem forms_from_spec (m₀ φ : ℝ) (hm : 0 < m₀) (hφ : 0 < φ) (ζ : ℂ) (hζ : ζ ^ 3 = 1)
    (p : ℕ × (Fin 3 × Fin 2)) :
    ‖spec m₀ φ ζ p‖ = m₀ * φ ^ p.1 ∧
    yDiag ζ p.2 ^ 3 = sign p.2.2 ∧
    yDiag ζ p.2 ^ 4 = colour ζ p.2.1 :=
  ⟨norm_spec m₀ φ hm hφ ζ hζ p, yDiag_pow_three ζ hζ p.2, yDiag_pow_four ζ hζ p.2⟩

end UnOperador

end UnOperadorBlock

-- ════════════════════════════════════════════════════════════════════════════
-- BLOCK S20. RelojTres  (sprint 119): when the clock has a factor 3,
-- and the class 9 of ker G on μ₅.
-- ════════════════════════════════════════════════════════════════════════════

section RelojTresBlock

namespace RelojTres

/-- **The 3-part of an order.**  If `x ^ (3^k * m) = 1` with `3 ∤ m`, then the order
    of `x` is prime to `3` exactly when `x ^ m = 1`. -/
theorem three_not_dvd_order_iff {G : Type*} [Monoid G] (x : G) (k m : ℕ)
    (hN : x ^ (3 ^ k * m) = 1) (hm : ¬ 3 ∣ m) :
    ¬ 3 ∣ orderOf x ↔ x ^ m = 1 := by
  constructor
  · intro h3
    have hd : orderOf x ∣ 3 ^ k * m := orderOf_dvd_of_pow_eq_one hN
    have hc3 : Nat.Coprime 3 (orderOf x) :=
      (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mpr h3
    have hc : Nat.Coprime (orderOf x) (3 ^ k) := (Nat.Coprime.pow_left k hc3).symm
    exact orderOf_dvd_iff_pow_eq_one.mp (hc.dvd_of_dvd_mul_left hd)
  · intro h h3
    exact hm (dvd_trans h3 (orderOf_dvd_of_pow_eq_one h))

/-- **A necessary condition.**  If the order divides `N` and `3` divides the order,
    then `3 ∣ N`. -/
theorem three_dvd_of_three_dvd_order {G : Type*} [Monoid G] (x : G) (N : ℕ)
    (hN : x ^ N = 1) (h3 : 3 ∣ orderOf x) : 3 ∣ N :=
  dvd_trans h3 (orderOf_dvd_of_pow_eq_one hN)

/-- **The class 9.**  It is `−1` modulo `5` and `1` modulo `4`, and it is an involution of
    `(ℤ/20)ˣ`: on `μ₅` it acts by `z ↦ z⁻¹` and it fixes `i`. -/
theorem class_nine :
    (9 : ZMod 5) = -1 ∧ (9 : ZMod 4) = 1 ∧ (9 : ZMod 20) * 9 = 1 ∧ (9 : ZMod 20) ≠ 1 := by
  decide

/-- The classes `±2 mod 5`, where `χ₅ = −1`, send `ζ₅` to `ζ₅^{±2}`: the class `13`
    acts on `μ₅` by `z ↦ z³` and the class `17` by `z ↦ z²`. -/
theorem classes_that_conjugate :
    (13 : ZMod 5) = 3 ∧ (17 : ZMod 5) = 2 ∧ (3 : ZMod 5) = 3 ∧ (7 : ZMod 5) = 2 := by
  decide

end RelojTres

end RelojTresBlock

