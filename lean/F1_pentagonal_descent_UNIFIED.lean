inductive ArithFragment where
  | binary  : ArithFragment
  | ternary : ArithFragment

def fragment_mu : ArithFragment → ℝ
  | ArithFragment.binary  => mu_n_param 2
  | ArithFragment.ternary => mu_n_param 3

def Z20star_fragment : ArithFragment := ArithFragment.ternary

theorem fragment_mu_ternary : fragment_mu ArithFragment.ternary = 1/2 := by
  simp [fragment_mu, mu_ternary_param]

/-! ## §10.H  Hecke symmetry for χ₅ — DERIVED (axiom discharged)

    The former `axiom hecke_1920` quantified over arbitrary reals in
    the strip and was refutable (witness ρ_re = 1/3, the same witness
    recorded below in `bound_alone_insufficient`).  The repaired
    statement carries the hypothesis the paper always intended —
    "ρ is a zero of L(s,χ₅)" — and with that hypothesis it is no
    longer an axiom: it is a corollary of the functional equation of
    Λ(s,χ₅), itself derived from the χ₅-twisted theta inversion
    (paper: sec:analytic-inputs; verified 23/23 at 40 digits in
    verify_chi5_theta.py).

    Formalisation route: Mathlib's Dirichlet continuation machinery
    (primitivity of χ₅, the reflected functional equation, and the
    completed-versus-plain equivalence on the strip).

    Source of the classical statement: Hecke, E. (1920). "Eine neue
    Art von Zetafunktionen und ihre Beziehungen zur Verteilung der
    Primzahlen". Math. Zeitschrift 1(1): 357–376. -/

/-- χ₅ squares to the trivial character (it is real, order 2).
    Both sides kill the nonunit 0, and on units the values ±1 square
    to 1. -/
theorem chi5_D_sq : chi5_D * chi5_D = 1 := by
  -- Decidable core over ℤ (no Units enumeration, no ℂ in the kernel):
  have key : ∀ x : ZMod 5, x ≠ 0 → chi5_Z x * chi5_Z x = 1 := by decide
  ext a
  -- After MulChar.ext, `a : (ZMod 5)ˣ`; its carrier is nonzero.
  have : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  have hne : (a : ZMod 5) ≠ 0 := a.ne_zero
  have h := key (a : ZMod 5) hne
  -- Reduce both sides to the ℤ core and cast:
  --   LHS: (χ·χ)(a) = chi5_C a * chi5_C a = ↑(chi5_Z a) * ↑(chi5_Z a)
  --   RHS: (1 : DirichletCharacter ℂ 5) applied to a unit = 1.
  simp only [MulChar.mul_apply, chi5_D_apply, chi5_C,
             MulChar.one_apply_coe]
  exact_mod_cast h


/-- χ₅ is self-inverse: χ₅⁻¹ = χ₅. -/
theorem chi5_D_inv : chi5_D⁻¹ = chi5_D :=
  inv_eq_of_mul_eq_one_right chi5_D_sq

/-- χ₅ is primitive mod 5.  The level 5 is prime, so the conductor
    divides 5 and is therefore 1 or 5; conductor 1 would force χ₅ = 1,
    refuted by χ₅(2) = -1. -/
theorem chi5_primitive : chi5_D.IsPrimitive := by
  rw [DirichletCharacter.isPrimitive_def]
  have hdvd : DirichletCharacter.conductor chi5_D ∣ 5 :=
    DirichletCharacter.conductor_dvd_level chi5_D
  have h5 : Nat.Prime 5 := by norm_num
  rcases h5.eq_one_or_self_of_dvd _ hdvd with h1 | h5'
  · -- conductor = 1 would make χ₅ trivial, refuted by χ₅(2) = -1
    exfalso
    have htriv : chi5_D = 1 := by
      rw [DirichletCharacter.eq_one_iff_conductor_eq_one]; exact h1
    have h2 : chi5_D (2 : ZMod 5) = -1 := by simp [chi5_D_apply, chi5_C, chi5_Z]
    have h3 : (1 : DirichletCharacter ℂ 5) (2 : ZMod 5) = 1 :=
      MulChar.one_apply_coe ⟨2, 3, by decide, by decide⟩
    rw [htriv] at h2
    exact absurd (by rw [h3] at h2; exact h2) (by norm_num : (1:ℂ) ≠ -1)
  · exact h5'

/-- Factorisation of the completed L-function of χ₅ (even character),
    valid on the whole half-plane re s > 0 — NOT only on the strip. -/
theorem chi5_completed_eq_mul {s : ℂ} (h_pos : 0 < s.re) :
    DirichletCharacter.completedLFunction chi5_D s
      = DirichletCharacter.LFunction chi5_D s * Complex.Gammaℝ s := by
  have heven : Function.Even (chi5_D : ZMod 5 → ℂ) := by
    intro j; fin_cases j <;> simp only [chi5_D_apply, chi5_C] <;> rfl
  have hs : s ≠ 0 ∨ (chi5_D : ZMod 5 → ℂ) 0 = 0 := by
    right; simp [chi5_D_apply, chi5_C, chi5_Z]
  have h := ZMod.LFunction_eq_completed_div_gammaFactor_even heven s hs
  rw [eq_comm, div_eq_iff (Complex.Gammaℝ_ne_zero_of_re_pos h_pos)] at h
  exact h

/-- Λ(χ₅, 2) ≠ 0, since L(2,χ₅) ≠ 0 for re s > 1 and Γℝ(2) ≠ 0. -/
private theorem chi5_completed_two_ne_zero :
    DirichletCharacter.completedLFunction chi5_D 2 ≠ 0 := by
  have h_pos : (0 : ℝ) < (2 : ℂ).re := by norm_num
  rw [chi5_completed_eq_mul h_pos]
  apply mul_ne_zero
  · apply DirichletCharacter.LFunction_ne_zero_of_one_le_re
    · have hne : chi5_D ≠ 1 := by
        intro h
        have h2 : chi5_D (2 : ZMod 5) = -1 := by
          rw [chi5_D_apply, chi5_C]; exact_mod_cast (by decide : chi5_Z 2 = -1)
        have h3 : (1 : DirichletCharacter ℂ 5) (2 : ZMod 5) = 1 :=
          MulChar.one_apply_coe ⟨2, 3, by decide, by decide⟩
        rw [h] at h2
        -- the same value is both 1 and -1
        have : (1 : ℂ) = -1 := by
          have := h2
          rw [h3] at this
          exact this
        norm_num at this
      exact Or.inl hne
    · norm_num
  · exact Complex.Gammaℝ_ne_zero_of_re_pos h_pos

/-- The completed L-function of χ₅ satisfies the reflected functional
    equation with a NONZERO factor.  Only nonvanishing of the factor is
    needed to transport zeros; the exact constant (the root number,
    = +1 for χ₅) is not required.  Nonvanishing is obtained by
    collapse: W = 0 would force Λ(1-s,χ₅) ≡ 0, contradicting
    Λ(2,χ₅) ≠ 0. -/
theorem chi5_completed_one_sub (s : ℂ) :
    ∃ c : ℂ, c ≠ 0 ∧
      DirichletCharacter.completedLFunction chi5_D (1 - s)
        = c * DirichletCharacter.completedLFunction chi5_D s := by
  -- Functional equation for primitive characters
  -- (Mathlib: IsPrimitive.completedLFunction_one_sub):
  --   completedLFunction χ (1-s) = 5^(s-1/2) · W(χ) · completedLFunction χ⁻¹ s
  have h := chi5_primitive.completedLFunction_one_sub (s := s)
  rw [chi5_D_inv] at h
  refine ⟨_, mul_ne_zero ?_ ?_, h⟩
  · -- 5^(s-1/2) ≠ 0 : base nonzero
    simp [Complex.cpow_eq_zero_iff]
  · -- W = 0 would give Λ(1-s) = 0 for all s, hence Λ(2) = 0.
    intro hW
    have := chi5_primitive.completedLFunction_one_sub (s := (-1 : ℂ))
    rw [chi5_D_inv] at this
    simp only [hW] at this
    -- this : completedLFunction chi5_D 2 = 0
    norm_num at this
    exact chi5_completed_two_ne_zero this

/-- Completed L vanishes iff L vanishes in the open strip.  Both
    Archimedean factors are nonzero there, so the factorisation
    transports vanishing in both directions. -/
theorem chi5_completed_zero_iff {s : ℂ}
    (h_pos : 0 < s.re) (_h_lt : s.re < 1) :
    DirichletCharacter.completedLFunction chi5_D s = 0
      ↔ DirichletCharacter.LFunction chi5_D s = 0 := by
  -- χ₅ is even: χ₅(-j) = χ₅(j) for all j
  have heven : Function.Even (chi5_D : ZMod 5 → ℂ) := by
    intro j; fin_cases j <;> simp only [chi5_D_apply, chi5_C] <;> rfl
  have hGamma_ne : Complex.Gammaℝ s ≠ 0 :=
    Complex.Gammaℝ_ne_zero_of_re_pos h_pos
  have hs : s ≠ 0 ∨ (chi5_D : ZMod 5 → ℂ) 0 = 0 := by
    right; simp [chi5_D_apply, chi5_C, chi5_Z]
  -- Factorisation: LFunction = completedLFunction / Gammaℝ
  have hrel := ZMod.LFunction_eq_completed_div_gammaFactor_even heven s hs
  -- Invert: completedLFunction = LFunction * Gammaℝ (Gammaℝ ≠ 0)
  have hmul : DirichletCharacter.completedLFunction chi5_D s =
      DirichletCharacter.LFunction chi5_D s * Complex.Gammaℝ s := by
    have h := hrel
    rw [eq_comm, div_eq_iff hGamma_ne] at h
    exact h
  constructor
  · -- completedLFunction = 0 ⟹ LFunction = 0
    intro h; rw [hmul] at h
    exact mul_eq_zero.mp h |>.resolve_right hGamma_ne
  · -- LFunction = 0 ⟹ completedLFunction = 0
    intro h; rw [hmul, h, zero_mul]

/-- THE REPAIRED HECKE STATEMENT — a theorem, not an axiom.
    If ρ is a zero of L(s,χ₅) in the open strip, so is 1-ρ. -/
theorem hecke_chi5_derived {ρ : ℂ}
    (h_pos : 0 < ρ.re) (h_lt : ρ.re < 1)
    (h_zero : DirichletCharacter.LFunction chi5_D ρ = 0) :
    DirichletCharacter.LFunction chi5_D (1 - ρ) = 0 := by
  have h_pos' : 0 < (1 - ρ).re := by simp [Complex.sub_re]; linarith
  have h_lt'  : (1 - ρ).re < 1 := by simp [Complex.sub_re]; linarith
  -- zero of L at ρ ⇒ zero of completed at ρ:
  have hcρ : DirichletCharacter.completedLFunction chi5_D ρ = 0 :=
    (chi5_completed_zero_iff h_pos h_lt).mpr h_zero
  -- functional equation transports it to 1-ρ:
  obtain ⟨c, hc, hfe⟩ := chi5_completed_one_sub ρ
  have hc1ρ : DirichletCharacter.completedLFunction chi5_D (1 - ρ) = 0 := by
    rw [hfe, hcρ, mul_zero]
  -- zero of completed at 1-ρ ⇒ zero of L at 1-ρ:
  exact (chi5_completed_zero_iff h_pos' h_lt').mp hc1ρ

/-- A χ₅ L-zero: the object the paper's Premises quantify over.
    This replaces the real-parameter surrogate: the zero predicate is
    part of the data. -/
structure Chi5Zero where
  ρ : ℂ
  in_strip_pos : 0 < ρ.re
  in_strip_lt  : ρ.re < 1
  is_zero      : DirichletCharacter.LFunction chi5_D ρ = 0

/-- The companion zero 1-ρ, DERIVED — no axiom. -/
def Chi5Zero.companion (z : Chi5Zero) : Chi5Zero where
  ρ := 1 - z.ρ
  in_strip_pos := by
    have := z.in_strip_lt; simp [Complex.sub_re]; linarith
  in_strip_lt := by
    have := z.in_strip_pos; simp [Complex.sub_re]; linarith
  is_zero := hecke_chi5_derived z.in_strip_pos z.in_strip_lt z.is_zero

@[simp] theorem Chi5Zero.companion_re (z : Chi5Zero) :
    z.companion.ρ.re = 1 - z.ρ.re := by
  simp [Chi5Zero.companion, Complex.sub_re]

/-- A ternary L-zero. -/
structure TernaryLZero where
  ρ_re : ℝ
  in_strip_pos : 0 < ρ_re
  in_strip_lt : ρ_re < 1
  bounded_by_mu : ρ_re ≤ mu_n_param 3
  companion_bounded : 1 - ρ_re ≤ mu_n_param 3

/-- CONSTRUCTION of TernaryLZero from a genuine χ₅ zero, given
    Premise A (the structural bound of the paper, prop:premiseA) as
    hypothesis over zeros.  Premise B is no longer assumed: it is
    computed by applying Premise A to the DERIVED companion.
    This is the repaired replacement of the former `mk_from_hecke`. -/
def TernaryLZero.ofChi5Zero
    (hA : ∀ w : Chi5Zero, w.ρ.re ≤ mu_n_param 3)
    (z : Chi5Zero) : TernaryLZero where
  ρ_re := z.ρ.re
  in_strip_pos := z.in_strip_pos
  in_strip_lt := z.in_strip_lt
  bounded_by_mu := hA z
  companion_bounded := by
    have h := hA z.companion
    rw [Chi5Zero.companion_re] at h
    exact h

/-- Paper prop:squeeze (the squeeze): for any ternary
    L-zero z, z.ρ_re = 1/2. -/
theorem rh_squeeze (z : TernaryLZero) : z.ρ_re = 1/2 := by
  have h_upper : z.ρ_re ≤ 1/2 := by
    have := z.bounded_by_mu; rw [mu_ternary_param] at this; exact this
  have h_lower : 1/2 ≤ z.ρ_re := by
    have := z.companion_bounded; rw [mu_ternary_param] at this; linarith
  linarith

/-- RH for χ₅ zeros under Premise A — Premise B is DERIVED.
    Replaces the former `rh_squeeze_via_hecke`, which consumed the
    refutable axiom. -/
theorem rh_squeeze_derived
    (hA : ∀ w : Chi5Zero, w.ρ.re ≤ mu_n_param 3)
    (z : Chi5Zero) : z.ρ.re = 1/2 :=
  rh_squeeze (TernaryLZero.ofChi5Zero hA z)

/-- **Premise A is equivalent to GRH for χ₅** — locating the exact
    weight of the remaining hypothesis.  Given the DERIVED functional
    equation (via `Chi5Zero.companion`), the upper bound
    Re(ρ) ≤ μ₃ = 1/2 over all χ₅-zeros is not a mild structural input:
    it is equivalent to the full Riemann Hypothesis for L(s,χ₅).

    (→): if some zero had Re(ρ) < 1/2, its derived companion 1-ρ is a
    zero with Re > 1/2, contradicting the bound.  (←): trivial.

    Consequence for the programme: deriving Premise A IS proving
    GRH(χ₅); the framework has localised the entire analytic
    difficulty into this single inequality, with the companion half
    discharged. -/
theorem premise_A_iff_GRH_chi5 :
    (∀ z : Chi5Zero, z.ρ.re ≤ mu_n_param 3)
      ↔ (∀ z : Chi5Zero, z.ρ.re = 1/2) := by
  rw [mu_ternary_param]
  constructor
  · intro hA z
    have h_up : z.ρ.re ≤ 1/2 := hA z
    have h_comp : z.companion.ρ.re ≤ 1/2 := hA z.companion
    rw [Chi5Zero.companion_re] at h_comp
    linarith
  · intro hRH z
    exact le_of_eq (hRH z)

/-- **SPECTRAL PARAMETER RIGIDITY** (thm IV of the three-faces map).

    The three-face machinery admits EXACTLY ONE spectral parameter
    pair, and it is (σ, μ) = (3/2, 1/2).  The theorem composes the
    already-proved uniqueness results into a single statement:

      (1) generator uniqueness  — φ is the unique positive root of
          x² = x + 1                        (golden_fixed_point_unique);
      (2) index uniqueness      — the spectral system σ+μ = 2,
          σμ = 3/4 with the strip constraint 0 < μ < 1 has the
          unique solution (3/2, 1/2)        (spectral_uniqueness);
      (3) the diagram apex agrees — mu_n_param 3 = 1/2 and
          sigma_n 3 = 3/2                   (mu_ternary_param,
                                             sigma_ternary);
      (4) self-reference at the apex is blocked — for 0 < t ≤ μ₃
          the relation t ≤ t² is impossible  (diagonal_blocked).

    CONSEQUENCE: membership in the machinery's equivalence class is
    a yes/no property with NO tunable freedom: there is no variant
    of the class with a different μ.  The structure forces the sign
    on its class; the sole remaining question (whether the analytic
    zeros belong to the class) is binary, and by
    premise_A_iff_GRH_chi5 it is equivalent to GRH(χ₅). -/
theorem spectral_parameter_rigidity :
    -- (1) unique generator
    (∀ x : ℝ, 0 < x → x ^ 2 = x + 1 → x = φ) ∧
    -- (2) unique admissible parameter pair
    (∀ σ μv : ℝ, σ + μv = 2 → σ * μv = 3/4 → μv < 1 → 0 < μv →
        σ = 3/2 ∧ μv = 1/2) ∧
    -- (3) the diagram apex realises exactly that pair
    (sigma_n 3 = 3/2 ∧ mu_n_param 3 = 1/2) ∧
    -- (4) no self-reference can shift it
    (∀ t : ℝ, 0 < t → t ≤ mu3 → ¬(t ≤ t ^ 2)) :=
  ⟨golden_fixed_point_unique,
   spectral_uniqueness,
   ⟨sigma_ternary, mu_ternary_param⟩,
   diagonal_blocked⟩

/-- Rigidity + membership force the sign — the composed statement.
    Given rigidity (proved above) the ONLY hypothesis left is
    membership (hA), and with it every zero sits at 1/2. -/
theorem rigidity_forces_sign
    (hA : ∀ w : Chi5Zero, w.ρ.re ≤ mu_n_param 3) :
    ∀ z : Chi5Zero, z.ρ.re = 1/2 :=
  fun z => rh_squeeze_derived hA z

/-! ## §10.I  THE BRIDGE, ASSEMBLED (F4-inverso form)

    HPPS delegates to this paper the construction that discharges its
    `bridge_axiom`: "ψ_p(φ)=φ^p determines χ₅(p)≡F_p (mod p), which
    determines every local factor f_p(s), which assembles ζ_K(s) as a
    categorical colimit, which yields ζ = ζ_K/L(s,χ₅) — all organised
    by the same G that produces spec(Ω̂)."  Every link in that chain
    is a THEOREM of this file; the assembly below records the
    conjunction, and the bridge theorem states the conclusion with its
    two classical inputs (Gelfand 1941; Dunford–Schwartz) carried as a
    typed hypothesis — the same F4-inverso protocol used for Hecke in
    §10.H.  The former axiom becomes a theorem whose classical
    dependence is visible in its signature. -/

/-- The five constructed links of the bridge, as one conjunction.
    Nothing here is hypothesised: each component is a proved theorem
    of this file, cited by name. -/
theorem bridge_components :
    -- (i) Frobenius lifts realise multiplicatively (Borger descent)
    (∀ (p : ℕ) (n : ℤ), realise (psi p n) = realise n ^ p) ∧
    -- (ii) each local Euler factor splits through χ₅
    (∀ (p : ℕ), p.Prime → ∀ {s : ℂ}, 1 < s.re →
        f_zeta p s * f_L p s = f_K p s) ∧
    -- (iii) the factors assemble the Dedekind factorisation
    (∀ {s : ℂ}, 1 < s.re →
        zeta_K s = riemannZeta s * L ↗chi5_D s) ∧
    -- (iv) the analytic character IS the second component of G
    (∀ a : ZMod 20, a ∈ ZtwentyStar →
        ((G a).2 = 0 ↔ a = 1 ∨ a = 9 ∨ a = 11 ∨ a = 19)) ∧
    -- (v) every spectral value with positive real part equals 1/2
    (∀ k : Fin 3, 0 < PCF_spectral k → PCF_spectral k = 1/2) :=
  ⟨psi_realise_pow,
   fun p hp {_s} hs => local_factor_identity p hp hs,
   fun {_s} hs => dedekind_factorisation hs,
   G_pi2_is_chi5,
   positive_spectral_half⟩

/-- THE BRIDGE THEOREM (replaces `bridge_axiom`).
    Classical input, carried as a typed hypothesis per F4-inverso:
    (GDS) every non-trivial zero of L(s,χ₅) is represented in the
    spectral data of Ω̂ — the Gelfand/Dunford–Schwartz representation
    acting on the span organised by G (the two sides of which are
    `bridge_components` (i)–(iv) and (v) respectively).
    Conclusion: every such zero has real part 1/2. -/
theorem bridge_assembled
    (hGDS : ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 →
        DirichletCharacter.LFunction chi5_D ρ = 0 →
        ∃ k : Fin 3, ρ.re = PCF_spectral k) :
    ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 →
        DirichletCharacter.LFunction chi5_D ρ = 0 → ρ.re = 1/2 := by
  intro ρ hpos hlt hzero
  obtain ⟨k, hk⟩ := hGDS ρ hpos hlt hzero
  have hkpos : 0 < PCF_spectral k := hk ▸ hpos
  calc ρ.re = PCF_spectral k := hk
    _ = 1/2 := positive_spectral_half k hkpos

/-- Premise A follows from the bridge: (GDS) discharges hA.
    The hypothesis of the squeeze is thereby traced to its exact
    classical source, visible in the type. -/
theorem premise_A_of_GDS
    (hGDS : ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 →
        DirichletCharacter.LFunction chi5_D ρ = 0 →
        ∃ k : Fin 3, ρ.re = PCF_spectral k) :
    ∀ w : Chi5Zero, w.ρ.re ≤ mu_n_param 3 := by
  intro w
  rw [mu_ternary_param]
  exact le_of_eq
    (bridge_assembled hGDS w.ρ w.in_strip_pos w.in_strip_lt w.is_zero)

/-- End-to-end: (GDS) alone forces Re(ρ) = 1/2 for every χ₅-zero —
    the full squeeze with both premises discharged: B derived
    (§10.H), A reduced to the typed classical representation. -/
theorem rh_squeeze_via_GDS
    (hGDS : ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 →
        DirichletCharacter.LFunction chi5_D ρ = 0 →
        ∃ k : Fin 3, ρ.re = PCF_spectral k) :
    ∀ z : Chi5Zero, z.ρ.re = 1/2 :=
  rigidity_forces_sign (premise_A_of_GDS hGDS)

/-! ## §10.J  THE SELECTION LEMMA

    Objection a referee will raise (and which the author of this file
    raised): the Galois functor G determines many quantities — the
    conductor 20, the character χ₄, the genus 0 — and none of them
    equals μ₃ = 1/2.  Why should Re(ρ) be the G-determined quantity
    that matches the spectral parameter?

    Answer, assembled from results already proved above.  The DERIVED
    functional equation (§10.H) supplies an involution s ↦ 1 - s on
    the Dirichlet plane; the χ₅-zero set is closed under it
    (Chi5Zero.companion); and μ₃ is exactly the unique fixed point of
    that involution.  Real parts of zeros LIVE on the plane the
    involution acts on; conductors, characters and genera do not —
    they are not candidates at all.  So the selection is forced, not
    chosen: Re(ρ) and μ₃ are the two objects sitting on the same
    plane under the same involution, one being the fixed point of the
    other.

    What the lemma does NOT give (and the file's own witness
    `bound_alone_insufficient` shows why): closure of the zero set
    under the involution does not pin each zero individually.  The
    pair {1/3, 2/3} is involution-invariant with neither element at
    1/2.  Individual fixation needs both bounds — Premise A together
    with the derived Premise B — which is exactly `rh_squeeze`. -/

/-- μ₃ = 1/2 is the unique fixed point of the reflection s ↦ 1 - s. -/
theorem mu3_unique_involution_fixed_point (x : ℝ) :
    x = 1 - x ↔ x = mu_n_param 3 := by
  rw [mu_ternary_param]; constructor <;> intro h <;> linarith

/-- SELECTION LEMMA.  Among the G-determined data, the real part of a
    χ₅-zero is the quantity on which the derived functional equation
    acts, and μ₃ is the fixed point of that action:

      (i) the zero set is closed under the involution
          ρ ↦ 1 - ρ  (DERIVED, not assumed);
     (ii) the induced map on real parts is r ↦ 1 - r;
    (iii) its unique fixed point is μ₃ = 1/2.

    Hence Re(ρ) and μ₃ are commensurable — same plane, same
    involution — while the remaining G-determined quantities are not
    acted on by it. -/
theorem selection_of_the_matched_quantity :
    (∀ z : Chi5Zero, ∃ w : Chi5Zero, w.ρ.re = 1 - z.ρ.re) ∧
    (∀ x : ℝ, x = 1 - x ↔ x = mu_n_param 3) :=
  ⟨fun z => ⟨z.companion, by simp [Chi5Zero.companion_re]⟩,
   mu3_unique_involution_fixed_point⟩

/-- Sharpness of the selection lemma: closure under the involution
    does NOT fix each zero.  Witness {1/3, 2/3}: the pair is
    invariant, both lie in the strip, and neither equals 1/2.
    Individual fixation therefore requires Premise A as well —
    the selection lemma identifies the right quantity, the squeeze
    fixes its value. -/
theorem selection_alone_insufficient :
    (1 : ℝ)/3 = 1 - 2/3 ∧ (0:ℝ) < 1/3 ∧ (1:ℝ)/3 < 1 ∧ (1:ℝ)/3 ≠ 1/2 := by
  norm_num

/-! ## §10.M  THE EXTENDED POSITIVITY WINDOW (arithmetic core)

    The Weil functional of conductor 5 is
      Q(g) = W∞(g) − P(g),
      P(g) = 2 Σ_{n = p^k} Λ(n)·χ₅(n)·n^(−1/2)·g(log n).
    For the Fejér family g_L the prime sum runs over n < e^(2L).  If
    2L < log 4 the only such prime powers are n = 2 and n = 3, and
    BOTH are non-residues mod 5:

        χ₅(2) = χ₅(3) = −1 .

    Every surviving term therefore carries a negative character
    value, so P(g_L) ≤ 0 and −P(g_L) ≥ 0: the prime side is
    FAVOURABLE throughout a window strictly larger than the
    vacuity window 2L < log 2 of the short-support theorem.

    This section formalises the arithmetic core of that statement —
    the part that is a theorem about ℤ and needs no computation.
    The accompanying margin (Q ≥ 0.178 across log 2 ≤ 2L < log 4)
    involves the one-dimensional Archimedean integral and is
    certified by validated numerics, not here; see the paper,
    thm:third-window and its certificates. -/

/-- The two smallest primes are non-residues mod 5. -/
theorem chi5_two_three_nonresidue :
    chi5_Z (2 : ZMod 5) = -1 ∧ chi5_Z (3 : ZMod 5) = -1 := by
  constructor <;> decide

/-- The first adverse prime power: χ₅(4) = +1, so n = 4 = 2²
    ends the favourable window exactly at 2L = log 4. -/
theorem chi5_four_residue : chi5_Z (4 : ZMod 5) = 1 := by decide

/-- The prime powers strictly below 4 are exactly 2 and 3. -/
theorem prime_powers_below_four (n p k : ℕ)
    (hp : p.Prime) (hk : 1 ≤ k) (hn : n = p ^ k) (hlt : n < 4) :
    n = 2 ∨ n = 3 := by
  have hp2 : 2 ≤ p := hp.two_le
  have hpk : p ≤ n := by
    calc p = p ^ 1 := (pow_one p).symm
      _ ≤ p ^ k := Nat.pow_le_pow_right (le_trans (by norm_num) hp2) hk
      _ = n := hn.symm
  have hp3 : p ≤ 3 := by omega
  interval_cases p
  · -- p = 2 : n = 2^k < 4 forces k = 1
    rcases k with _ | _ | k'
    · omega
    · left; simpa using hn
    · exfalso; rw [hn] at hlt
      have : 2 ^ (k' + 2) ≥ 4 := by
        calc 2 ^ (k' + 2) ≥ 2 ^ 2 := Nat.pow_le_pow_right (by omega) (by omega)
          _ = 4 := by norm_num
      omega
  · -- p = 3 : n = 3^k < 4 forces k = 1
    rcases k with _ | _ | k'
    · omega
    · right; simpa using hn
    · exfalso; rw [hn] at hlt
      have : 3 ^ (k' + 2) ≥ 9 := by
        calc 3 ^ (k' + 2) ≥ 3 ^ 2 := Nat.pow_le_pow_right (by omega) (by omega)
          _ = 9 := by norm_num
      omega

/-- **FAVOURABLE SIGN OF THE PRIME SIDE.**
    Every prime power n < 4 has χ₅(n) = −1.  Hence in the window
    2L < log 4 every term of the prime sum is ≤ 0 (the weights
    Λ(n), n^(−1/2) and g_L(log n) being non-negative), so the prime
    side enters with a favourable sign.  This is the arithmetic
    content of the extended-region theorem. -/
theorem prime_side_favourable (n p k : ℕ)
    (hp : p.Prime) (hk : 1 ≤ k) (hn : n = p ^ k) (hlt : n < 4) :
    chi5_Z ((n : ZMod 5)) = -1 := by
  rcases prime_powers_below_four n p k hp hk hn hlt with h | h
  · subst h; decide
  · subst h; decide

/-- The window is strictly larger than the vacuity window:
    the short-support theorem vacates the prime sum for n < 2,
    the present one keeps it favourable for n < 4. -/
theorem window_strictly_larger : (2 : ℕ) < 4 := by norm_num

/-! ## §10.L  POLAR READING: the two faces are the polar coordinates

    ℂ factors as modulus × argument.  The modulus lives on the
    multiplicative line ⟨φ⟩ (the one-dimensional φ-face); the argument
    lives on the circle (the π-face).  The framework's conductor
    20 = 4·5 is literally the product of the two: the 4-part is the
    quarter turn i, the 5-part is the pentagon that produces φ.

    In the Dirichlet plane this gives the reading that organises the
    whole paper:
        n^(-s) = n^(-Re s) · e^(-i·Im s·log n)
    so Re(s) is the RADIAL coordinate (φ-face) and Im(s) the ANGULAR
    one (π-face).  Re(ρ) is therefore not a loose number: it is the
    zero's φ-face reading.  This is why the counting function N(T),
    an angular statement, is unconditional (prop:envelope-exact),
    while the real part is the open item. -/

/-- The quarter turn: ζ₂₀^5 = i, the 4-part of the conductor. -/
theorem zeta20_pow_five_eq_I :
    (Complex.exp (2 * Real.pi * Complex.I / 20)) ^ (5 : ℕ) = Complex.I := by
  rw [← Complex.exp_nat_mul]
  push_cast
  have h : (5 : ℂ) * (2 * Real.pi * Complex.I / 20)
       = Real.pi * Complex.I / 2 := by ring
  rw [h]
  have h2 : ↑π * Complex.I / 2 = (↑π / 2 : ℂ) * Complex.I := by ring
  rw [h2, Complex.exp_mul_I]
  norm_num

/-- The pentagon: ζ₂₀^4 = ζ₅, the 5-part of the conductor. -/
theorem zeta20_pow_four_eq_zeta5 :
    (Complex.exp (2 * Real.pi * Complex.I / 20)) ^ (4 : ℕ)
      = Complex.exp (2 * Real.pi * Complex.I / 5) := by
  rw [← Complex.exp_nat_mul]
  congr 1; push_cast; ring

/-- i has order four: the quarter turn closes after four steps. -/
theorem I_pow_four : (Complex.I) ^ (4 : ℕ) = 1 := by
  simp [pow_succ, Complex.I_mul_I]

/-- **RADIAL READING.**  |n^(-s)| = n^(-Re s):
    the modulus of a Dirichlet term is governed by the REAL part
    alone.  Hence Re(ρ) is the radial (φ-face) coordinate of a zero,
    and Im(ρ) contributes only the phase. -/
theorem abs_cpow_eq_rpow_neg_re {n : ℕ} (hn : 0 < n) (s : ℂ) :
    ‖(n : ℂ) ^ (-s)‖ = (n : ℝ) ^ (-s.re) := by
  have hpos : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
  simpa using norm_cpow_eq_rpow_re_of_pos hpos (-s)

/-- **SELF-DUAL SPLIT.**  |n^(-s)| · |n^(-(1-s))| = 1/n for EVERY s:
    the involution s ↦ 1-s divides the fixed weight 1/n between the
    two arguments.  Re(s) = 1/2 is the symmetric split, where each
    factor contributes exactly n^(-1/2).  This is the radial reading
    of the critical line, and the same μ₃ = 1/2 as the six-route
    cocone. -/
theorem self_dual_split {n : ℕ} (hn : 0 < n) (s : ℂ) :
    ‖(n : ℂ) ^ (-s)‖ * ‖(n : ℂ) ^ (-(1 - s))‖
      = ((n : ℝ))⁻¹ := by
  have hpos : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
  rw [abs_cpow_eq_rpow_neg_re hn, abs_cpow_eq_rpow_neg_re hn,
      ← Real.rpow_add hpos]
  have : -s.re + -(1 - s).re = -1 := by
    simp [Complex.sub_re, Complex.one_re]; ring
  rw [this, Real.rpow_neg_one]

/-- At the symmetric split the two factors are equal, each n^(-1/2). -/
theorem symmetric_split_at_half {n : ℕ} (hn : 0 < n) (s : ℂ)
    (h : s.re = 1/2) :
    ‖(n : ℂ) ^ (-s)‖ = ‖(n : ℂ) ^ (-(1 - s))‖ := by
  rw [abs_cpow_eq_rpow_neg_re hn, abs_cpow_eq_rpow_neg_re hn]
  congr 1
  simp [Complex.sub_re, Complex.one_re, h]
  ring

/-! ### §10.L.2  The polar reading meets the rigidity

    The six-route cocone lands on μ₃ = 1/2 as the apex of the class.
    The polar reading (§10.L) says Re(s) is the radial coordinate of
    a Dirichlet term.  Putting them together identifies WHAT the apex
    is in radial terms: 1/2 is the symmetric split of the fixed
    weight 1/n between s and 1-s (self_dual_split,
    symmetric_split_at_half).  So the apex of the rigid class and the
    balanced radial split are the same number, arrived at from two
    unrelated directions.

    This is the strongest form of the connection the framework
    supports, and it is worth stating exactly what it does and does
    not deliver, since the distinction is the whole remaining
    question:

      • PROVED: the class has one apex and no free parameter
        (spectral_parameter_rigidity); there is no intermediate
        position (spectral_positions_discrete); the apex coincides
        with the balanced radial split (below); the zero set is
        generated by φ (paper: ssec:stage6); an
        infinite family of constraints on the zeros is fixed by the
        φ-face (paper: prop:three-regimes).

      • OPEN: that the radial coordinate of each non-trivial zero
        IS the balanced split.  Equivalently Re(ρ) = 1/2, which by
        premise_A_iff_GRH_chi5 is GRH(χ₅).

    The trivial zeros mark the boundary of the analogy: they are
    generated by the framework too — they are the poles of the
    Archimedean factor, hence π-face objects — and their radial
    coordinates are 0, -2, -4, …, none of them the balanced split.
    Generation by the structure therefore does not by itself place a
    zero at the apex; what the paper adds is that the non-trivial
    zeros are φ-face objects (zeros of Λ, determined by χ₅), which
    is why the question is open rather than settled either way. -/

/-- The apex of the rigid class IS the balanced radial split.
    Two independent characterisations of the same number:
    (i) the unique admissible spectral parameter of the class;
    (ii) the exponent at which s and 1-s carry equal modulus. -/
theorem apex_is_balanced_split :
    mu_n_param 3 = 1/2 ∧
    (∀ (n : ℕ), 0 < n → ∀ s : ℂ, s.re = mu_n_param 3 →
        ‖(n : ℂ) ^ (-s)‖
          = ‖(n : ℂ) ^ (-(1 - s))‖) := by
  refine ⟨mu_ternary_param, ?_⟩
  intro n hn s hs
  exact symmetric_split_at_half hn s (by rwa [mu_ternary_param] at hs)

/-- The chain, assembled: rigidity fixes the apex, the polar reading
    identifies it as the balanced split, and membership — the single
    open hypothesis — converts it into the statement about zeros. -/
theorem polar_rigidity_chain
    (hA : ∀ w : Chi5Zero, w.ρ.re ≤ mu_n_param 3) :
    ∀ z : Chi5Zero,
      z.ρ.re = 1/2 ∧
      ∀ (n : ℕ), 0 < n →
        ‖(n : ℂ) ^ (-z.ρ)‖
          = ‖(n : ℂ) ^ (-(1 - z.ρ))‖ := by
  intro z
  have h : z.ρ.re = 1/2 := rigidity_forces_sign hA z
  exact ⟨h, fun n hn => symmetric_split_at_half hn z.ρ h⟩

/-! ## §10.K  THE SIXTH ROUTE: the modulus diagram completed

    The companion worldsheet paper states the modulus diagram as a
    COCONE with six legs meeting at μ = 1/2 — "the argument is
    convergence, not a chain".  Part 12 of this file carries five of
    those legs.  The sixth, fix(s = 1 - s), was unavailable here as
    long as the functional equation was an external axiom; §10.H
    derived it, so the leg is now internal to this paper and the
    cocone closes on F₁ ground.

    The six legs, from six distinct domains:
      (1) Γ(3/2)/Γ(1/2)          — Archimedean / Gamma
      (2) ‖P‖·‖C‖·‖F‖             — norm product of the triad
      (3) cos(π/3)                — trigonometry of the ternary angle
      (4) φ^(−λ)                  — golden/binary Mersenne bridge
      (5) fix(x = 1 − x)          — the elementary involution
      (6) fix(s = 1 − s)          — the DERIVED functional equation

    That six independent routes land on the same value is what makes
    the parameter rigid (spectral_parameter_rigidity); it is a
    statement about the apex, not about the zeros.

    Leg (6) is stated here; the full six-leg cocone is assembled in
    Part 12 (`modulus_cocone_six_routes`), after the four private
    route lemmas it consumes. -/

/- Leg (6): the fixed line of the derived functional equation.
    For the completed Λ(s,χ₅) of §10.H the reflection is s ↦ 1 - s,
    whose fixed set is exactly Re(s) = 1/2 = μ₃. -/
/-- **DISCRETENESS OF THE SPECTRAL POSITIONS.**
    The real parts of the spectrum of Ω̂ form a TWO-POINT set:
    three equispaced points on the circle of radius 1/2 have real
    parts 1/2, -1/4, -1/4.  There is no interval, hence no bound to
    slide along and no intermediate value to occupy: rigidity does
    not admit degrees.

    Consequence for the shape of the open question.  The alternative
    to Re(ρ) = 1/2 is NOT some other value like 0.4 — no such
    position exists in the structure.  The alternative is that
    Re(ρ) is not a spectral position at all.  The question is
    therefore binary in the strongest sense: in the structure, or
    outside it. -/
theorem spectral_positions_discrete :
    (∀ k : Fin 3, PCF_spectral k = 1/2 ∨ PCF_spectral k = -(1/4)) ∧
    (∀ k : Fin 3, ¬ (-(1/4) < PCF_spectral k ∧ PCF_spectral k < 1/2)) := by
  have ⟨hre, him⟩ := w_pcf_re_im_priv
  constructor
  · intro k
    obtain ⟨kv, kp⟩ := k
    match kv with
    | 0 => left;  unfold PCF_spectral Omega_hat; norm_num
    | 1 =>
      right; unfold PCF_spectral Omega_hat
      simp only [pow_one, Complex.mul_re, Complex.ofReal_re,
        Complex.ofReal_im, zero_mul, sub_zero, hre]; norm_num
    | 2 =>
      right; unfold PCF_spectral Omega_hat
      simp only [pow_two, Complex.mul_re, Complex.ofReal_re,
        Complex.ofReal_im, zero_mul, sub_zero]
      rw [hre, him]
      nlinarith [Real.mul_self_sqrt (show (0:ℝ) ≤ 3 by norm_num)]
  · intro k ⟨h1, h2⟩
    obtain ⟨kv, kp⟩ := k
    match kv with
    | 0 => unfold PCF_spectral Omega_hat at h2; norm_num at h2
    | 1 =>
      unfold PCF_spectral Omega_hat at h1
      simp only [pow_one, Complex.mul_re, Complex.ofReal_re,
        Complex.ofReal_im, zero_mul, sub_zero, hre] at h1
      norm_num at h1
    | 2 =>
      unfold PCF_spectral Omega_hat at h1
      simp only [pow_two, Complex.mul_re, Complex.ofReal_re,
        Complex.ofReal_im, zero_mul, sub_zero] at h1
      rw [hre, him] at h1
      nlinarith [Real.mul_self_sqrt (show (0:ℝ) ≤ 3 by norm_num)]

/-- No gradual failure: if Re(ρ) is a spectral position and lies in
    the critical strip, it IS 1/2.  Not "at most 1/2" — equal.
    The strip excludes -1/4 outright, and the set has no third
    element.  This is the spectral form of the result, logically
    STRONGER than the squeeze: it uses no functional-equation input
    and admits no intermediate case. -/
theorem no_intermediate_position (k : Fin 3)
    (h_strip : 0 < PCF_spectral k ∧ PCF_spectral k < 1) :
    PCF_spectral k = 1/2 :=
  positive_spectral_half k h_strip.1

theorem functional_equation_fixed_line (s : ℂ) :
    s.re = (1 - s).re ↔ s.re = mu_n_param 3 := by
  rw [mu_ternary_param, Complex.sub_re, Complex.one_re]
  constructor <;> intro h <;> linarith



/-- Witness ρ_re = 1/3: upper bound holds but companion fails. -/
theorem bound_alone_insufficient :
    ∃ t : ℝ, 0 < t ∧ t < 1 ∧ t ≤ mu_n_param 3 ∧ t ≠ 1/2 :=
  ⟨1/3, by norm_num, by norm_num,
   by rw [mu_ternary_param]; norm_num, by norm_num⟩

/-- Witness ρ_re = 2/3: companion holds but upper bound fails. -/
theorem companion_alone_insufficient :
    ∃ t : ℝ, 0 < t ∧ t < 1 ∧ 1 - t ≤ mu_n_param 3 ∧ t ≠ 1/2 :=
  ⟨2/3, by norm_num, by norm_num,
   by rw [mu_ternary_param]; norm_num, by norm_num⟩

/-- The canonical zero ρ_re = 1/2. -/
def canonical_zero : TernaryLZero where
  ρ_re := 1/2
  in_strip_pos := by norm_num
  in_strip_lt := by norm_num
  bounded_by_mu := by norm_num [mu_ternary_param]
  companion_bounded := by norm_num [mu_ternary_param]

theorem canonical_zero_works : canonical_zero.ρ_re = 1/2 :=
  rh_squeeze canonical_zero

/-! ## §10.X The Weil analogy collected -/

/-- The Weil analogy structure: exponent-2 self-duality, unique positive
    eigenvalue μ₃ = 1/2, and kernel of size 2.  These are the F₁-side
    counterparts to: Frobenius eigenvalues |α_i| = q^(1/2), the diagonal
    self-intersection ⟨Δ,Δ⟩ = 2 - 2g, and the genus-zero invariant. -/
theorem weil_analogy :
    -- Exponent 2 (self-duality of all characters)
    (∀ g : ZMod 2 × ZMod 2, g + g = 0) ∧
    -- Unique positive eigenvalue = μ₃
    (∀ k : Fin 3, 0 < PCF_spectral k → PCF_spectral k = 1/2) ∧
    -- |ker G| = 2 (contraction from binary to ternary level)
    (∀ a, a ∈ ZtwentyStar → (G a = (0, 0) ↔ a = 1 ∨ a = 9)) :=
  ⟨golden_group_exponent_two, positive_spectral_half, G_kernel⟩


