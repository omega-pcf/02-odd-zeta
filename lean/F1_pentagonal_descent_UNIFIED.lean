theorem the_two_radii_are_different (ρ : ℂ) (h₀ : ρ ≠ 0) (h₁ : ρ ≠ 1) :
    ((rad₉ ρ (1 - ρ)).re = ρ.re - 1/2) ∧
    (discP (zeroCoord ρ) = (zeroCoord ρ - (zeroCoord ρ)⁻¹) ^ 2) :=
  ⟨radius_re_is_re_minus_half ρ, by
    have hz : zeroCoord ρ ≠ 0 := by
      unfold zeroCoord
      intro hzero
      have hl : liMap ρ = 0 := Complex.abs.eq_zero (show Complex.abs _ = 0 from hzero)
      unfold liMap at hl
      field_simp at hl
      rw [mul_zero] at hl
      exact h₁ (sub_eq_zero.mp hl)
    have hcancel : zeroCoord ρ * (zeroCoord ρ)⁻¹ = 1 :=
      mul_inv_cancel₀ hz
    have hexpand : (zeroCoord ρ + (zeroCoord ρ)⁻¹) ^ 2
        - (zeroCoord ρ - (zeroCoord ρ)⁻¹) ^ 2 = 4 := by
      have he : ∀ x y : ℝ, (x + y) ^ 2 - (x - y) ^ 2 = 4 * x * y :=
        fun x y => by ring
      rw [he, mul_assoc, hcancel]
      ring
    unfold discP e1P
    simp only [inv_eq_one_div] at hexpand ⊢
    linarith [hexpand]⟩

theorem disc_is_four_times_the_coordinate_radius (r : ℝ) (hr : r ≠ 0) :
