theorem spectrum_modulus_is_the_anchor (k : Fin 3) (hw : Complex.abs w_pcf = 1) :
    Complex.abs (Omega_hat k) = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) := by
  have hsp := spectrum_is_anchor_times_orbit k
  have hwpow : Complex.abs (w_pcf ^ (k : ℕ)) = 1 := by
    have h1 : Complex.abs w_pcf = 1 := hw
    unfold Complex.abs at h1 ⊢
    rw [norm_pow, h1, one_pow]
  have hanchor : 0 ≤ (φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) := by
    rw [anchor_is_the_spectral_scale]; norm_num
  have hmul : Complex.abs (((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) : ℝ)
        * w_pcf ^ (k : ℕ))
      = Complex.abs (((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) : ℝ))
          * Complex.abs (w_pcf ^ (k : ℕ)) := by
    unfold Complex.abs
    exact norm_mul _ _
  rw [hsp, hmul, hwpow, mul_one, Complex.abs_ofReal]
  rw [abs_of_nonneg hanchor]

