/-! ## 1.  Mⁿ = pₙ·M + qₙ·I -/

/-- `coef n = (pₙ, qₙ)` with `M^n = pₙ M + qₙ I`.
    `p₀ = 0, q₀ = 1`; `p_{n+1} = pₙ + qₙ`, `q_{n+1} = pₙ`.
    These are the Fibonacci numbers: `(0,1), (1,0), (1,1), (2,1), (3,2), …` -/
def coef : Nat → Int × Int
  | 0 => (0, 1)
  | n + 1 => ((coef n).1 + (coef n).2, (coef n).1)

/-- `p·M + q·I`, written out. -/
def lin (p q : Int) : Mat2 := ⟨q, p, p, p + q⟩

theorem lin_eq (p q : Int) :
    lin p q = Mat2.add (Mat2.smul p M) (Mat2.smul q Mat2.one) := by
  simp [lin, Mat2.add, Mat2.smul, Mat2.one, M]

/-- **`Mⁿ` is a ℤ-linear combination of `M` and `I`.** -/
theorem npow_eq_lin : ∀ n : Nat, Mat2.npow M n = lin (coef n).1 (coef n).2
  | 0 => by simp [Mat2.npow, coef, lin, Mat2.one]
  | n + 1 => by
      have ih := npow_eq_lin n
      have hstep : Mat2.npow M (n + 1) = Mat2.mul (Mat2.npow M n) M := rfl
      rw [hstep, ih]
      show Mat2.mul (lin (coef n).1 (coef n).2) M
         = lin ((coef n).1 + (coef n).2) (coef n).1
      unfold lin Mat2.mul M
      simp only [Mat2.mk.injEq]
      refine ⟨?_, ?_, ?_, ?_⟩ <;> omega

/-- Consistency with the kernel: `M³ = 2M + I`, `M⁶ = 8M + 5I`. -/
theorem coef_three : coef 3 = (2, 1) := by decide
theorem coef_six : coef 6 = (8, 5) := by decide

/-- For `n ≥ 1`: `pₙ ≥ 1` and `qₙ ≥ 0`.  (So `(pₙ, qₙ) ≠ (0,1)` for `n ≥ 1`.) -/
theorem coef_pos_succ : ∀ n : Nat, 1 ≤ (coef (n + 1)).1 ∧ 0 ≤ (coef (n + 1)).2
  | 0 => by decide
  | n + 1 => by
      have ih := coef_pos_succ n
      show 1 ≤ (coef (n + 1)).1 + (coef (n + 1)).2 ∧ 0 ≤ (coef (n + 1)).1
      refine ⟨?_, ?_⟩ <;> omega

theorem coef_pos (n : Nat) (hn : 0 < n) : 1 ≤ (coef n).1 ∧ 0 ≤ (coef n).2 := by
  obtain ⟨k, hk⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  subst hk
  exact coef_pos_succ k

/-! ## 2.  The determinant of `Mⁿ − I` is a value of the norm form -/

/-- `det(p·M + q·I) = N(q, p) = q² + qp − p²`.  The characteristic polynomial
    of `M` and the norm form of `ℤ[φ]` are the same polynomial. -/
theorem det_lin (p q : Int) : Mat2.det (lin p q) = normFormMul q p := by
  simp [Mat2.det, lin, normFormMul, Int.mul_add]
  omega

/-! ## 3.  The norm form has only the trivial zero

  This is `no_golden_rational` transported from ℕ to ℤ.  Equivalently:
  `x² + x − 1` has no rational root, i.e. φ is irrational. -/

theorem normFormMul_eq_zero {a b : Int} (h : normFormMul a b = 0) :
    a = 0 ∧ b = 0 := by
  have haa : ((a.natAbs * a.natAbs : Nat) : Int) = a * a := Int.natAbs_mul_self
  have hbb : ((b.natAbs * b.natAbs : Nat) : Int) = b * b := Int.natAbs_mul_self
  have hnm : (a * b).natAbs = a.natAbs * b.natAbs := Int.natAbs_mul a b
  have hab : a * b = ((a.natAbs * b.natAbs : Nat) : Int)
           ∨ a * b = -((a.natAbs * b.natAbs : Nat) : Int) := by
    rcases Int.natAbs_eq (a * b) with h1 | h1
    · exact Or.inl (by rw [h1, hnm])
    · exact Or.inr (by rw [h1, hnm])
  unfold normFormMul at h
  -- abstract the three products so that `omega` sees pure linear arithmetic
  have key : (a.natAbs = 0) ∨ (b.natAbs = 0) := by
    rcases hab with hp | hm
    · -- a·b = +|a||b| :  f² + fm = m²  — impossible for f > 0
      left
      rcases Nat.eq_zero_or_pos a.natAbs with h0 | hf0
      · exact h0
      · have hc : b.natAbs * b.natAbs
                = b.natAbs * a.natAbs + a.natAbs * a.natAbs := by
          have hz : ((b.natAbs * b.natAbs : Nat) : Int)
                  = ((b.natAbs * a.natAbs : Nat) : Int)
                  + ((a.natAbs * a.natAbs : Nat) : Int) := by
            rw [Nat.mul_comm b.natAbs a.natAbs]
            push_cast at haa hbb hp ⊢
            rw [haa, hbb, ← hp]; omega
          exact_mod_cast hz
        exact absurd hc (no_golden_rational a.natAbs b.natAbs hf0)
    · -- a·b = −|a||b| :  f² = fm + m²  — impossible for m > 0
      right
      rcases Nat.eq_zero_or_pos b.natAbs with h0 | hb0
      · exact h0
      · have hc : a.natAbs * a.natAbs
                = a.natAbs * b.natAbs + b.natAbs * b.natAbs := by
          have hz : ((a.natAbs * a.natAbs : Nat) : Int)
                  = ((a.natAbs * b.natAbs : Nat) : Int)
                  + ((b.natAbs * b.natAbs : Nat) : Int) := by
            push_cast at haa hbb hm ⊢
            rw [haa, hbb]; omega
          exact_mod_cast hz
        exact absurd hc (no_golden_rational b.natAbs a.natAbs hb0)
  rcases key with h0 | h0
  · have ha : a = 0 := Int.natAbs_eq_zero.mp h0
    rw [ha] at h
    simp at h
    exact ⟨ha, h⟩
  · have hb : b = 0 := Int.natAbs_eq_zero.mp h0
    rw [hb] at h
    simp at h
    exact ⟨h, hb⟩

/-! ## 4.  No nonzero frequency is periodic -/

/-- Cramer, written out for `2×2` over ℤ: if `X·v = 0` then `det X · v = 0`. -/
theorem det_smul_of_act_zero (X : Mat2) (v : Zphi) (h : act X v = (0, 0)) :
    Mat2.det X * v.1 = 0 ∧ Mat2.det X * v.2 = 0 := by
  obtain ⟨x, y⟩ := v
  simp [act, Prod.mk.injEq] at h
  obtain ⟨h1, h2⟩ := h
  constructor
  · have e1 : X.d * (X.a * x + X.b * y) = 0 := by rw [h1]; exact Int.mul_zero _
    have e2 : X.b * (X.c * x + X.d * y) = 0 := by rw [h2]; exact Int.mul_zero _
    simp [Mat2.det, Int.mul_add, Int.sub_mul] at *
    have q1 : X.d * (X.a * x) = X.a * X.d * x := by
      rw [← Int.mul_assoc, Int.mul_comm X.d X.a]
    have q2 : X.b * (X.c * x) = X.b * X.c * x := by rw [← Int.mul_assoc]
    have q3 : X.d * (X.b * y) = X.b * (X.d * y) := by
      rw [← Int.mul_assoc, ← Int.mul_assoc, Int.mul_comm X.d X.b]
    omega
  · have e1 : X.c * (X.a * x + X.b * y) = 0 := by rw [h1]; exact Int.mul_zero _
    have e2 : X.a * (X.c * x + X.d * y) = 0 := by rw [h2]; exact Int.mul_zero _
    simp [Mat2.det, Int.mul_add, Int.sub_mul] at *
    have q1 : X.c * (X.a * x) = X.a * (X.c * x) := by
      rw [← Int.mul_assoc, ← Int.mul_assoc, Int.mul_comm X.c X.a]
    have q2 : X.c * (X.b * y) = X.b * X.c * y := by
      rw [← Int.mul_assoc, Int.mul_comm X.c X.b]
    have q3 : X.a * (X.d * y) = X.a * X.d * y := by rw [← Int.mul_assoc]
    omega

/-- `Mⁿ − I = lin pₙ (qₙ − 1)`, so its determinant is `N(qₙ−1, pₙ)`. -/
theorem det_npow_sub_one (n : Nat) :
    Mat2.det (Mat2.sub (Mat2.npow M n) Mat2.one)
      = normFormMul ((coef n).2 - 1) (coef n).1 := by
  rw [npow_eq_lin n]
  have key : ∀ p q : Int,
      Mat2.det (Mat2.sub (lin p q) Mat2.one) = normFormMul (q - 1) p := by
    intro p q
    show (q - 1) * (p + q - 1) - (p - 0) * (p - 0)
       = (q - 1) * (q - 1) + (q - 1) * p - p * p
    have h1 : p - 0 = p := Int.sub_zero p
    have h2 : p + q - 1 = p + (q - 1) := by omega
    rw [h1, h2, Int.mul_add]
    omega
  exact key _ _

/-- The determinant of `Mⁿ − I` is nonzero for every `n ≥ 1`. -/
theorem det_npow_sub_one_ne_zero (n : Nat) (hn : 0 < n) :
    Mat2.det (Mat2.sub (Mat2.npow M n) Mat2.one) ≠ 0 := by
  rw [det_npow_sub_one n]
  intro h
  obtain ⟨h1, h2⟩ := normFormMul_eq_zero h
  have := coef_pos n hn
  omega

/-- **THE THEOREM.  No nonzero frequency is periodic under `M`.**

    For every `n ≥ 1`, the only `v ∈ ℤ²` with `Mⁿv = v` is `v = 0`.

    Read on the character basis of `L²(T²)` (`e_k(x) = e^{2πi⟨k,x⟩}`,
    `e_k ∘ M = e_{Mᵀk}`, and `M` is symmetric so `Mᵀ = M`): every orbit of the
    Koopman operator on `{e_k : k ≠ 0}` is INFINITE.  Hence `L²₀(T²)` is a
    countable direct sum of copies of `ℓ²(ℤ)` and the Koopman spectrum is
    countable Lebesgue — the spectral invariant of a Bernoulli shift.
    Fourier cannot distinguish this deterministic integer matrix from noise. -/
theorem no_periodic_frequency (n : Nat) (hn : 0 < n) (v : Zphi)
    (h : act (Mat2.npow M n) v = v) : v = (0, 0) := by
  have hz : act (Mat2.sub (Mat2.npow M n) Mat2.one) v = (0, 0) := by
    obtain ⟨x, y⟩ := v
    simp [act, Mat2.sub, Mat2.one, Int.sub_mul, Prod.mk.injEq] at h ⊢
    refine ⟨?_, ?_⟩ <;> omega
  obtain ⟨c1, c2⟩ := det_smul_of_act_zero _ v hz
  have hd := det_npow_sub_one_ne_zero n hn
  obtain ⟨x, y⟩ := v
  simp at c1 c2 ⊢
  constructor
  · rcases c1 with h1 | h1
    · exact absurd h1 hd
    · exact h1
  · rcases c2 with h1 | h1
    · exact absurd h1 hd
    · exact h1

/-! ## 5.  The two halves, side by side -/

/-- **Fourier blindness IS the irrationality of φ.**  The hypothesis discharged
    in `det_npow_sub_one_ne_zero` is exactly `no_golden_rational`: if some
    `m/f` satisfied `x² = x + 1`, some nonzero frequency would be periodic.
    The aperiodicity of every frequency and the irrationality of φ are one
    statement in two languages. -/
theorem blindness_is_irrationality :
    (∀ f m : Nat, 0 < f → m * m ≠ m * f + f * f) ∧
    (∀ n : Nat, 0 < n → ∀ v : Zphi, act (Mat2.npow M n) v = v → v = (0, 0)) :=
  ⟨no_golden_rational, no_periodic_frequency⟩

/-- **THE CONJUNCTION.**  The same matrix, at the same time:

    · on the lattice of frequencies — no period, ever (Fourier reads Lebesgue
      spectrum, i.e. noise);
    · on its two finite quotients — period exactly 6, and 6 is minimal.

    There is no tension.  The orbit of a frequency is infinite; its image in
    `GL₂(𝔽₂) × {±1}` cycles with period 6.  Granularity is the second datum,
    and it is invisible to the first. -/
theorem chaotic_to_fourier_periodic_in_arithmetic :
    (∀ n : Nat, 0 < n → ∀ v : Zphi, act (Mat2.npow M n) v = v → v = (0, 0)) ∧
    ((Mat2.npow M 6).rmod 2 = Mat2.one ∧ Mat2.det (Mat2.npow M 6) = 1) ∧
    ¬((Mat2.npow M 3).rmod 2 = Mat2.one ∧ Mat2.det (Mat2.npow M 3) = 1) ∧
    ¬((Mat2.npow M 2).rmod 2 = Mat2.one ∧ Mat2.det (Mat2.npow M 2) = 1) :=
  ⟨no_periodic_frequency, cover_degree_six.1,
   cover_degree_six.2.2.2.1, cover_degree_six.2.2.1⟩



/- =====================================================================
   BLOQUE 3 de 16 - PCF_phi_exponent
   el exponente y sus dos coordenadas
   ===================================================================== -/


/-! ## 1.  La obstrucción: ℤ/3 no entra en un grupo de exponente 2 -/

/-- `(ℤ/2)²`, concreto. -/
abbrev V := Bool × Bool

def vzero : V := (false, false)
def vadd (x y : V) : V := (xor x.1 y.1, xor x.2 y.2)

theorem vadd_zero_left (x : V) : vadd vzero x = x := by
  cases x with | mk a b => cases a <;> cases b <;> decide

/-- **Exponente 2.**  Todo elemento de `(ℤ/2)²` es su propio inverso. -/
theorem vadd_self (x : V) : vadd x x = vzero := by
  cases x with | mk a b => cases a <;> cases b <;> decide

/-- **[P] NINGÚN MORFISMO NO TRIVIAL DESDE `ℤ/3`.**

    `f : ℕ → (ℤ/2)²` aditiva y de periodo 3 —es decir, un homomorfismo
    `ℤ/3 → (ℤ/2)²`— manda el generador a cero.

    Prueba: `3·f(1) = f(3) = f(0) = 0` por periodicidad, y `2·f(1) = 0` por
    exponente 2; restando, `f(1) = 0`.  Aquí «restar» es aplicar
    `vadd_self` y `vadd_zero_left`.

    **Consecuencia: no hay morfismo que lleve el factor `ℤ/3` de la fibra a
    ningún sitio dentro de `(ℤ/2)²`.**  mcd(3,2)=1 y eso es todo. -/
theorem no_hom_from_Z3 (f : Nat → V)
    (hadd : ∀ m n : Nat, f (m + n) = vadd (f m) (f n))
    (hper : ∀ n : Nat, f (n + 3) = f n) :
    f 1 = vzero := by
  have h0 : f 0 = vzero := by
    have := hadd 0 0
    simp at this
    calc f 0 = vadd (f 0) (f 0) := this
      _ = vzero := vadd_self (f 0)
  have h3 : f 3 = vadd (vadd (f 1) (f 1)) (f 1) := by
    have e1 : f (1 + 1) = vadd (f 1) (f 1) := hadd 1 1
    have e2 : f (1 + 1 + 1) = vadd (f (1 + 1)) (f 1) := hadd (1 + 1) 1
    have e3 : (3 : Nat) = 1 + 1 + 1 := rfl
    rw [e3, e2, e1]
  have h3' : f 3 = f 0 := hper 0
  rw [vadd_self (f 1), vadd_zero_left] at h3
  rw [h3', h0] at h3
  exact h3.symm

/-- **[P] Y EN LA DIRECCIÓN CONTRARIA TAMPOCO.**  Un morfismo
    `(ℤ/2)² → ℤ/3` es trivial por el mismo argumento con los papeles
    cambiados; aquí basta el caso que se usa: la fibra tiene un elemento de
    orden 3 y `(ℤ/2)²` no tiene ninguno. -/
theorem no_element_of_order_three (x : V) :
    vadd (vadd x x) x = x := by
  cases x with | mk a b => cases a <;> cases b <;> decide

/-! ## 2.  Lo que las potencias de φ SÍ dan: la fibra, exacta -/

/-- La firma del exponente: `φⁿ` leído en sus dos cocientes finitos.
    `Mat2.npow M n` **es** la multiplicación por `φⁿ` en `ℤ[φ]`. -/
def phiSig (n : Nat) : Mat2 × Int :=
  ((Mat2.npow M n).rmod 2, Mat2.det (Mat2.npow M n))

/-- **[P] PERIODO 6.**  La firma se repite con periodo 6 —comprobado sobre
    dos vueltas completas— y `cover_degree_six` (kernel) da que 6 es
    mínimo.  La razón estructural está también en el kernel:
    `M_six_sub_one` dice `M⁶ − I = 4·M³`, luego `M⁶ ≡ I (mod 4)` y a
    fortiori mod 2; y `det M⁶ = (det M)⁶ = 1`. -/
theorem phiSig_period_six :
    phiSig 6 = phiSig 0 ∧ phiSig 7 = phiSig 1 ∧ phiSig 8 = phiSig 2 ∧
    phiSig 9 = phiSig 3 ∧ phiSig 10 = phiSig 4 ∧ phiSig 11 = phiSig 5 ∧
    phiSig 12 = phiSig 6 ∧ phiSig 13 = phiSig 7 := by
  decide

/-- **[P] Y NO ANTES.**  Las seis firmas de una vuelta son distintas dos a
    dos: el exponente mod 6 es una coordenada exacta, sin degeneración. -/
theorem phiSig_six_are_distinct :
    phiSig 0 ≠ phiSig 1 ∧ phiSig 0 ≠ phiSig 2 ∧ phiSig 0 ≠ phiSig 3 ∧
    phiSig 0 ≠ phiSig 4 ∧ phiSig 0 ≠ phiSig 5 ∧
    phiSig 1 ≠ phiSig 2 ∧ phiSig 1 ≠ phiSig 3 ∧ phiSig 1 ≠ phiSig 4 ∧
    phiSig 1 ≠ phiSig 5 ∧ phiSig 2 ≠ phiSig 3 ∧ phiSig 2 ≠ phiSig 4 ∧
    phiSig 2 ≠ phiSig 5 ∧ phiSig 3 ≠ phiSig 4 ∧ phiSig 3 ≠ phiSig 5 ∧
    phiSig 4 ≠ phiSig 5 := by
  decide

/-- **[P] EL ORDEN 3 ESTÁ EN EL FACTOR DE COLOR.**  `M³ ≡ I (mod 2)` y
    `M¹, M²` no: el primo inerte 2 aporta exactamente un `ℤ/3`.
    Éste es el factor que ningún morfismo lleva a `(ℤ/2)²`
    (`no_hom_from_Z3`). -/
theorem colour_factor_has_order_three :
    (Mat2.npow M 3).rmod 2 = Mat2.one ∧
    (Mat2.npow M 1).rmod 2 ≠ Mat2.one ∧
    (Mat2.npow M 2).rmod 2 ≠ Mat2.one := by
  decide

/-- **[P] Y EL ORDEN 2 EN EL FACTOR DE ORIENTACIÓN.**  `det M = −1`,
    `det M² = 1`. -/
theorem orientation_factor_has_order_two :
    Mat2.det M = -1 ∧ Mat2.det (Mat2.npow M 2) = 1 := by
  decide

/-! ## 3.  La conjunción -/

/-- **[P⊕] EL MORFISMO, Y SU LÍMITE.**

    (a) Las potencias de `φ` dan la fibra: el exponente `n`, leído en los
        dos cocientes finitos de `ℤ[φ]`, tiene periodo exactamente 6 y las
        seis firmas son distintas.  **Ése es el morfismo, y está en las
        potencias de φ.**

    (b) El factor `ℤ/3` no llega a ningún `(ℤ/2)²`: todo homomorfismo
        desde `ℤ/3` a un grupo de exponente 2 es trivial.

    De modo que la advertencia sobre los dos grupos no era una laguna a
    llenar: es una obstrucción.  Lo que las potencias de `φ` conectan es el
    exponente con la fibra, y eso ya está. -/
theorem phi_powers_give_the_fibre_and_nothing_else
    (f : Nat → V)
    (hadd : ∀ m n : Nat, f (m + n) = vadd (f m) (f n))
    (hper : ∀ n : Nat, f (n + 3) = f n) :
    -- (a) el morfismo que sí existe
    (phiSig 6 = phiSig 0) ∧
    (phiSig 0 ≠ phiSig 1 ∧ phiSig 0 ≠ phiSig 2 ∧ phiSig 0 ≠ phiSig 3) ∧
    ((Mat2.npow M 3).rmod 2 = Mat2.one ∧ Mat2.det M = -1) ∧
    -- (b) el que no puede existir
    (f 1 = vzero) :=
  ⟨phiSig_period_six.1,
   ⟨phiSig_six_are_distinct.1, phiSig_six_are_distinct.2.1,
    phiSig_six_are_distinct.2.2.1⟩,
   ⟨colour_factor_has_order_three.1, orientation_factor_has_order_two.1⟩,
   no_hom_from_Z3 f hadd hper⟩



/- =====================================================================
   BLOQUE 4 de 16 - PCF_eisenstein_units
   el grupo de cubierta es Z[w]^x
   ===================================================================== -/


/-! ## 1.  μ₆ concreto, y el grupo de cubierta -/

/-- `μ₆` como `ℤ/6`: el exponente `k` de `ζ₆ᵏ` con `ζ₆ = e^{iπ/3} = −ω²`. -/
abbrev Mu6 := Nat

def mu6add (a b : Mu6) : Mu6 := (a + b) % 6
def mu6zero : Mu6 := 0
def mu6gen  : Mu6 := 1

/-- El grupo de cubierta del paper: color × orientación. -/
abbrev Deck := Colour × Orient

def colourIdx : Colour → Nat | .c0 => 0 | .c1 => 1 | .c2 => 2
def orientIdx : Orient → Nat | .pos => 0 | .neg => 1

/-- **EL MORFISMO.**  Teorema chino del resto sobre `6 = 3·2`: el único
    `k < 6` con `k ≡ color (mod 3)` y `k ≡ orientación (mod 2)`.

    En términos de raíces de la unidad: `μ₃ × μ₂ → μ₆`,
    `(ω^c, (−1)^o) ↦ ζ₆^k`.  Es la multiplicación de `ℂˣ`. -/
def toMu6 (d : Deck) : Mu6 :=
  let c := colourIdx d.1
  let o := orientIdx d.2
  (4 * c + 3 * o) % 6

def ofMu6 (k : Mu6) : Deck :=
  (match k % 3 with | 0 => .c0 | 1 => .c1 | _ => .c2,
   match k % 2 with | 0 => .pos | _ => .neg)

/-! ## 2.  Que es un isomorfismo, y canónico -/

/-- **[P] BIYECTIVO.**  Las seis clases se recorren una vez cada una. -/
theorem toMu6_bijective :
    (∀ d : Deck, ofMu6 (toMu6 d) = d) ∧
    (∀ k : Nat, k < 6 → toMu6 (ofMu6 k) = k) := by
  constructor
  · intro d
    obtain ⟨c, o⟩ := d
    cases c <;> cases o <;> decide
  · intro k hk
    match k, hk with
    | 0, _ => rfl
    | 1, _ => rfl
    | 2, _ => rfl
    | 3, _ => rfl
    | 4, _ => rfl
    | 5, _ => rfl
    | n + 6, h => exact absurd h (by omega)

/-- La ley de grupo de arriba, intrínseca: multiplicación en `𝔽₄ˣ` en el
    primer factor —que es `Colour.shift`, o sea multiplicar por `φ̄`— y
    producto de signos en el segundo. -/
def colourAdd : Colour → Colour → Colour
  | .c0, y => y
  | .c1, .c0 => .c1 | .c1, .c1 => .c2 | .c1, .c2 => .c0
  | .c2, .c0 => .c2 | .c2, .c1 => .c0 | .c2, .c2 => .c1

def orientAdd : Orient → Orient → Orient
  | .pos, y => y
  | .neg, .pos => .neg | .neg, .neg => .pos

def deckAdd (x y : Deck) : Deck := (colourAdd x.1 y.1, orientAdd x.2 y.2)

/-- **[P] ADITIVO.**  `toMu6` es un homomorfismo: la ley de grupo de
    `Colour × Orient` va a la suma de `μ₆`. -/
theorem toMu6_additive (x y : Deck) :
    toMu6 (deckAdd x y) = mu6add (toMu6 x) (toMu6 y) := by
  obtain ⟨cx, ox⟩ := x
  obtain ⟨cy, oy⟩ := y
  cases cx <;> cases ox <;> cases cy <;> cases oy <;> decide

/-- **[P] CANÓNICO, NO TRANSPORTADO.**  El generador distinguido de arriba
    —color `φ̄`, orientación negativa: el paso de cubierta— va al generador
    distinguido de abajo, `ζ₆`.

    Ésta es la diferencia con una biyección cualquiera: las dos estructuras
    traen su generador, y el mapa los identifica. -/
theorem generator_to_generator : toMu6 (.c1, .neg) = mu6gen := by decide

/-- **[P] Y LA UNIDAD A LA UNIDAD.** -/
theorem unit_to_unit : toMu6 (.c0, .pos) = mu6zero := by decide

/-- **[P] EL PASO DE CUBIERTA TIENE ORDEN 6 EN `μ₆`.**  Iterar el
    generador seis veces vuelve al origen, y no antes. -/
def g1 : Mu6 := mu6gen
def g2 : Mu6 := mu6add g1 mu6gen
def g3 : Mu6 := mu6add g2 mu6gen
def g4 : Mu6 := mu6add g3 mu6gen
def g5 : Mu6 := mu6add g4 mu6gen
def g6 : Mu6 := mu6add g5 mu6gen

theorem mu6gen_order_six :
    g6 = mu6zero ∧
    g1 ≠ mu6zero ∧ g2 ≠ mu6zero ∧ g3 ≠ mu6zero ∧
    g4 ≠ mu6zero ∧ g5 ≠ mu6zero := by
  decide

/-! ## 3.  Por qué la obstrucción anterior no aplica aquí -/

/-- **[P] `μ₆` NO TIENE EXPONENTE 2.**  El generador no es su propio
    inverso: `ζ₆ + ζ₆ = ζ₆² ≠ 1`.

    Ésa es toda la diferencia con `(ℤ/2)²`.  El argumento
    `Hom(ℤ/3, G) = 0 si G tiene exponente 2` descarta el grupo de
    caracteres reales módulo 20 y **no descarta `μ₆`**: aquí el `ℤ/3` entra
    como `μ₃ ⊂ μ₆`, que es la inclusión obvia. -/
theorem mu6_is_not_exponent_two : mu6add mu6gen mu6gen ≠ mu6zero := by decide

/-- **[P] Y EL `ℤ/3` SÍ ENTRA: `μ₃ ⊂ μ₆` ES NO TRIVIAL.**  `ζ₆² = ω` tiene
    orden exactamente 3. -/
theorem mu3_embeds_nontrivially :
    mu6add (mu6add 2 2) 2 = mu6zero ∧ (2 : Mu6) ≠ mu6zero ∧
    mu6add 2 2 ≠ mu6zero := by
  decide

/-- **[P] LA PARTE COMÚN CON GAUSS ES LA ORIENTACIÓN.**  `μ₄` tiene orden
    4, `μ₆` orden 6, `gcd(6,4) = 2`: la intersección es `μ₂ = {±1}`, que en
    el paper es exactamente el factor de orientación `det M = N(φ) = −1`.

    El color `ℤ/3` es puramente de Eisenstein; no vive en Gauss. -/
theorem gauss_meets_eisenstein_in_the_orientation :
    Nat.gcd 6 4 = 2 ∧ Nat.gcd 3 4 = 1 ∧ Mat2.det M = -1 := by
  refine ⟨by decide, by decide, by decide⟩

/-! ## 4.  La conjunción -/

/-- **[P⊕] EL MORFISMO, EXHIBIDO.**

    El grupo de cubierta de la fibra —`𝔽₄ˣ × {±1}`, que el kernel construye
    desde el primo inerte 2 y desde `N(φ) = −1`— es canónicamente `μ₆`, el
    grupo de unidades del retículo de Eisenstein `ℤ[ω]`:

    · biyectivo en las dos direcciones;
    · aditivo;
    · **generador distinguido a generador distinguido**, que es lo que lo
      separa de una biyección de cardinal;
    · con `μ₃ ⊂ μ₆` no trivial, de modo que la obstrucción de exponente 2
      no aplica;
    · y `μ₆ ∩ μ₄ = μ₂` es el factor de orientación.

    **Lo que faltaba no era el morfismo: era el blanco.** -/
theorem the_deck_group_is_the_eisenstein_unit_group :
    (∀ d : Deck, ofMu6 (toMu6 d) = d) ∧
    (∀ x y : Deck, toMu6 (deckAdd x y) = mu6add (toMu6 x) (toMu6 y)) ∧
    (toMu6 (.c1, .neg) = mu6gen) ∧
    (toMu6 (.c0, .pos) = mu6zero) ∧
    (g6 = mu6zero ∧ g3 ≠ mu6zero ∧ g2 ≠ mu6zero) ∧
    (mu6add mu6gen mu6gen ≠ mu6zero) ∧
    (Nat.gcd 6 4 = 2) :=
  ⟨toMu6_bijective.1, toMu6_additive, generator_to_generator, unit_to_unit,
   ⟨mu6gen_order_six.1, mu6gen_order_six.2.2.2.1, mu6gen_order_six.2.2.1⟩,
   mu6_is_not_exponent_two, by decide⟩



