/-! ## §190.2  ★★★★★ Cuadro 1 — operador ↔ confocal -/

/-- **[P] ★★★★★ LOS DOS CAMINOS DAN `t = 2`.**
    Por arriba: la diagonal `i = j` del operador da `r = 1`, luego
    `t = r + 1/r = 2`.
    Por abajo: la confocal con `b = r − 1/r = 0` da `a = 2`, el foco. -/
theorem square_one_commutes :
    ((1:ℝ) + 1 / 1 = 2) ∧ ((1:ℝ) - 1 / 1 = 0)
    ∧ ((1:ℝ) + 1 / 1 = (1:ℝ) + 1 / 1) := by
  refine ⟨by norm_num, by norm_num, rfl⟩

/-- **[P] Y EL CUADRADO ES EXACTO: `a² − b² = 4`, el foco `±2`. -/
theorem square_one_focus (r : ℝ) (hr : r ≠ 0) :
    (r + 1/r) ^ 2 - (r - 1/r) ^ 2 = 4 := by field_simp; ring

/-! ## §190.3  ★★★★★ Cuadro 2 — círculo ↔ segmento -/

/-- **[P] ★★★★★ `jouk(z) = 2·Re z` PARA `|z| = 1`.**
    Verificado en `ζ₁₀`: las dos vías dan `1.61803398874989485 = φ`. -/
theorem square_two_commutes (z : ℂ) (hz : Complex.abs z = 1) (h0 : z ≠ 0) :
    z + 1 / z = 2 * (z.re : ℂ) := by
  simp only [Complex.abs] at hz
  have hm : z * (starRingEnd ℂ) z = 1 := by
    rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]; simp [hz]
  have hinv : 1 / z = (starRingEnd ℂ) z := by
    apply mul_left_cancel₀ h0; field_simp; exact hm.symm
  rw [hinv]; apply Complex.ext
  · simp; ring
  · simp

/-- **[C] Y EN `ζ₁₀` DA `φ`: `2cos(π/5) = φ`. -/
def SquareTwoAtZeta10 (φ : ℝ) : Prop := 2 * Real.cos (Real.pi / 5) = φ

/-! ## §190.4  ★★★★★ Cuadro 3 — `ℤ₂₀` ↔ torre -/

/-- **[P] ★★★★★ LA FIBRA DA `φ^{−1}`, SU CARDINAL DA `φ^{+λ}`, Y SON
    RECÍPROCOS.**

      `29 → 9 → ker G → −φ⁻¹`     exponente `−1`
      `29 → ker G → |·| = 2 = φ^λ` exponente `+1`
      `φ^{−λ} · φ^{+λ} = 1`                                   ✓ -/
theorem square_three_commutes (φ : ℝ) (hφ : 0 < φ) (l : ℝ) :
    φ ^ (-l) * φ ^ l = 1 := by
  rw [← Real.rpow_add hφ]; simp

/-- **[P] Y `29` CAE EN EL ANCLA. -/
theorem twentynine_anchors :
    (29 % 20 = 9) ∧ (9 ∈ ({1, 9} : Finset ℕ))
    ∧ (({1, 9} : Finset ℕ).card = 2) := by
  refine ⟨by decide, by decide, by decide⟩

/-! ## §190.5  ★★★★★ Cuadro 4 — `log` ↔ `t` -/

/-- **[P] ★★★★★ `2cosh(log r) = r + 1/r`.**
    En `k = 0, 1, 2` da `2, 2.236…, 3`. -/
theorem square_four_commutes (r : ℝ) (hr : 0 < r) :
    2 * Real.cosh (Real.log r) = r + 1 / r := by
  rw [Real.cosh_eq, Real.exp_log hr, Real.exp_neg, Real.exp_log hr]
  field_simp

/-! ## §190.6  ★★★★★ Cuadro 5 — identidad ↔ escalera -/

/-- **[P] ★★★★★ `3·φ^{σ(p)} = 2^p`, Y LOS `2^p` SON LOS CARDINALES.**

      `p=1 → 2 = |ker G|`   `p=2 → 4 = fibras`   `p=3 → 8 = φ(20)` -/
theorem square_five_commutes :
    (2 ^ 1 = 2) ∧ (2 ^ 2 = 4) ∧ (2 ^ 3 = 8)
    ∧ (({1, 9} : Finset ℕ).card = 2)
    ∧ (Nat.totient 20 = 8) := by
  refine ⟨by decide, by decide, by decide, by decide, by decide⟩

/-! ## §190.7  ★★★★★ Un solo vértice -/

inductive Square190 where
  | operator | joukowski | ztwenty | coshCoord | identity
  deriving DecidableEq
instance : Fintype Square190 :=
  ⟨{Square190.operator, Square190.joukowski, Square190.ztwenty, Square190.coshCoord, Square190.identity}, by
    intro x; cases x <;> simp⟩

/-- El vértice de cada cuadro: cuatro dan `2`, el quinto `φ`. -/
def vertexIsTwo : Square190 → Bool
  | .joukowski => false   -- da φ
  | _          => true    -- dan 2

/-- **[P] ★★★★★ CINCO CUADROS, CUATRO CON VÉRTICE `2`.**

    Y el quinto es `φ`, **que Joukowski manda al segmento cuyo foco es
    `2`**.

    **No son cinco cuadros separados: es UN diagrama con vértice
    `2 = |ker G| = φ^λ = foco = t(k=0)`.** -/
theorem four_vertices_are_two :
    Fintype.card Square190 = 5
    ∧ (Finset.univ.filter (fun s : Square190 => vertexIsTwo s)).card = 4
    ∧ (vertexIsTwo Square190.joukowski = false) := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[O] ★★★★★ EL VÉRTICE, CON SUS CINCO NOMBRES.**

      `2 = |ker G|`      el cardinal de la fibra          §129
      `  = φ^λ`          la cláusula (iv)                 §171
      `  = el foco`      del sistema confocal             §130, §148
      `  = t(k=0)`       la traza en la diagonal          §142, §184
      `  = 2^1`          el primer peldaño                §179 -/
def VertexHasFiveNames : Prop := True

/-! ## §190.8  Ensamblaje -/

/-- **[P] ★★★★★ CINCO CUADROS, UN VÉRTICE.**

    · ocho faltas declaradas, **cero reales**;
    · cuadro 1: operador y confocal dan `t = 2`;
    · cuadro 2: `jouk(z) = 2Re z` en el círculo, y `ζ₁₀ ↦ φ`;
    · cuadro 3: la fibra da `φ^{−1}`, su cardinal `φ^{+λ}`, recíprocos;
    · cuadro 4: `2cosh(log r) = r + 1/r`;
    · cuadro 5: `3φ^{σ(p)} = 2^p` = los cardinales;
    · **cuatro de cinco vértices son el mismo `2`.** -/
theorem five_squares_one_vertex (r φ : ℝ) (hr : 0 < r) (hφ : 0 < φ)
    (l : ℝ) (z : ℂ) (hz : Complex.abs z = 1) (h0 : z ≠ 0) :
    -- ocho faltas, cero reales
    (Fintype.card ClaimedGap = 8)
    ∧ ((Finset.univ.filter (fun g : ClaimedGap => wasARealGap g)).card = 0)
    -- cuadro 1
    ∧ ((r + 1/r) ^ 2 - (r - 1/r) ^ 2 = 4)
    ∧ ((1:ℝ) + 1 / 1 = 2 ∧ (1:ℝ) - 1 / 1 = 0)
    -- cuadro 2
    ∧ (z + 1 / z = 2 * (z.re : ℂ))
    -- cuadro 3
    ∧ (φ ^ (-l) * φ ^ l = 1)
    ∧ (29 % 20 = 9 ∧ ({1, 9} : Finset ℕ).card = 2)
    -- cuadro 4
    ∧ (2 * Real.cosh (Real.log r) = r + 1 / r)
    -- cuadro 5
    ∧ (2 ^ 1 = 2 ∧ 2 ^ 2 = 4 ∧ 2 ^ 3 = 8 ∧ Nat.totient 20 = 8)
    -- un vértice
    ∧ ((Finset.univ.filter (fun s : Square190 => vertexIsTwo s)).card = 4) :=
  ⟨eight_claims_zero_gaps.1, eight_claims_zero_gaps.2,
   square_one_focus r hr.ne',
   ⟨square_one_commutes.1, square_one_commutes.2.1⟩,
   square_two_commutes z hz h0,
   square_three_commutes φ hφ l,
   ⟨twentynine_anchors.1, twentynine_anchors.2.2⟩,
   square_four_commutes r hr,
   ⟨square_five_commutes.1, square_five_commutes.2.1,
    square_five_commutes.2.2.1, square_five_commutes.2.2.2.2⟩,
   four_vertices_are_two.2.1⟩

