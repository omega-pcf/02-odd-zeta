    basta para el contraste y evita evaluar `ψ(1/4)`. -/
theorem digamma_half_is_negative :
    Real.digamma (1 / 2) = -Real.eulerMascheroniConstant - 2 * Real.log 2 := by
  unfold Real.digamma
  push_cast
  rw [Complex.digamma_one_half]
  have h1 : (-2 * Complex.log 2).re = -2 * Real.log 2 := by
    simp [Complex.mul_re, Complex.log_re]
  rw [Complex.sub_re, h1, Complex.ofReal_re]
  ring

/-- **[P] Y ENTONCES `ψ(1/2) ≠ γ_E`.**  `γ_E > 0` y `ψ(1/2) < 0`. -/
theorem digamma_half_ne_euler :
    Real.digamma (1 / 2) ≠ Real.eulerMascheroniConstant := by
  rw [digamma_half_is_negative]
  intro h
  have hpos : 0 < Real.eulerMascheroniConstant := by
    have := Real.one_half_lt_eulerMascheroniConstant
    linarith
  have hlog : 0 < Real.log 2 := Real.log_pos (by norm_num)
  linarith

/-! ## §109.2  La forma correcta de `λ₁` -/

/-- **[C] LA DEFINICIÓN.**  `λ₁ = Λ'/Λ(1)`, la derivada logarítmica
    de la función completada en el punto de simetría.  Entrada
    clásica, visible en la firma. -/
def LiOneIsLogDerivative (lam LambdaPrimeOverLambda : ℝ) : Prop :=
  lam = LambdaPrimeOverLambda

/-- **[C] Y SU DESARROLLO.**  Con
    `Λ(s) = (q/π)^{s/2} Γ(s/2) L(s,χ)`:

        `Λ'/Λ(1) = ½log(q/π) + ½ψ(½) + L'/L(1,χ)`

    **Tres términos**, y el tercero NO es arquimediano: es el dato de
    la función `L`.  §86 lo omitía. -/
def LambdaLogDerivativeAtOne (v q psiHalf LprimeOverL : ℝ) : Prop :=
  v = Real.log (q / Real.pi) / 2 + psiHalf / 2 + LprimeOverL

/-- **[P] LA FORMA CORREGIDA TIENE TRES TÉRMINOS, NO DOS.**  Bajo las
    dos entradas, `λ₁` queda expresado con el término de `L`
    explícito ---que es lo que `§86` sustituía por `1 − γ_E/2`. -/
theorem li_one_has_three_terms (lam v q psiHalf LprimeOverL : ℝ)
    (h₁ : LiOneIsLogDerivative lam v)
    (h₂ : LambdaLogDerivativeAtOne v q psiHalf LprimeOverL) :
    lam = Real.log (q / Real.pi) / 2 + psiHalf / 2 + LprimeOverL := by
  unfold LiOneIsLogDerivative at h₁
  unfold LambdaLogDerivativeAtOne at h₂
  rw [h₁, h₂]

/-- **[P] Y EL CONDUCTOR SIGUE DENTRO.**  `log(q/π) = log q − log π`:
    el `log q` es la cara `φ`.  Esto de §86 SE CONSERVA ---es lo único
    que su `li_one_carries_the_conductor` establecía. -/
theorem conductor_survives_the_correction (q : ℝ) (hq : 0 < q) :
    Real.log (q / Real.pi) = Real.log q - Real.log Real.pi :=
  Real.log_div (ne_of_gt hq) (ne_of_gt Real.pi_pos)

