/-! ## §91.1  La anti-invarianza `τ` ES el producto -/

/-- **[P] EL PUENTE, EN FORMA ABSTRACTA.**  Para `a, b > 0`:

        log b = −log a    ⟺    a · b = 1

    Es `log` convirtiendo producto en suma (§32), y es lo único que
    hace falta para identificar las dos coordenadas. -/
theorem log_antisymmetry_iff_product_one (a b : ℝ) (ha : 0 < a) (hb : 0 < b) :
    Real.log b = - Real.log a ↔ a * b = 1 := by
  constructor
  · intro h
    have hz : Real.log (a * b) = 0 := by
      rw [Real.log_mul (ne_of_gt ha) (ne_of_gt hb), h]; ring
    rcases Real.log_eq_zero.mp hz with h1 | h1 | h1
    · nlinarith
    · exact h1
    · nlinarith
  · intro h
    have hz : Real.log a + Real.log b = 0 := by
      rw [← Real.log_mul (ne_of_gt ha) (ne_of_gt hb), h, Real.log_one]
    linarith

/-- **[P] LUEGO `e₂ = 1` ES LA MITAD `τ` DEL TIPO.**  Aplicado a los
    módulos de Li: la anti-invarianza de `u` bajo `τ` y
    `moduli_product_is_one` son el mismo enunciado.

    **No son dos cosas: son una, en dos coordenadas.** -/
theorem tau_half_is_the_moduli_product (ρ : ℂ)
    (hp : 0 < Complex.abs (liMap ρ))
    (hq : 0 < Complex.abs (liMap (1 - ρ))) :
    (Real.log (Complex.abs (liMap (1 - ρ)))
       = - Real.log (Complex.abs (liMap ρ)))
    ↔ (Complex.abs (liMap ρ) * Complex.abs (liMap (1 - ρ)) = 1) :=
  log_antisymmetry_iff_product_one _ _ hp hq

/-- **[P] Y ESA MITAD ESTÁ PROBADA.**  Por `moduli_product_is_one`
    (§28), la anti-invarianza `τ` de `u` se sigue sin hipótesis
    adicional. -/
theorem tau_half_holds (ρ : ℂ) (h₀ : ρ ≠ 0) (h₁ : ρ ≠ 1)
    (hp : 0 < Complex.abs (liMap ρ))
    (hq : 0 < Complex.abs (liMap (1 - ρ))) :
    Real.log (Complex.abs (liMap (1 - ρ)))
      = - Real.log (Complex.abs (liMap ρ)) :=
  (tau_half_is_the_moduli_product ρ hp hq).mpr (moduli_product_is_one ρ h₀ h₁)

/-! ## §91.2  El tipo no fuerza el valor -/

/-- **[P] EL VALOR ES CERO SYSS EL MÓDULO ES UNO.**  `E` en la
    coordenada logarítmica. -/
theorem value_zero_iff_modulus_one (a : ℝ) (ha : 0 < a) :
    Real.log a = 0 ↔ a = 1 := by
  constructor
  · intro h
    rcases Real.log_eq_zero.mp h with h1 | h1 | h1
    · nlinarith
    · exact h1
    · nlinarith
  · intro h; rw [h]; exact Real.log_one

/-- **[P] TESTIGO: EL TIPO SE CUMPLE SIN QUE EL VALOR SE ANULE.**
    Con `a = 2`, `b = 1/2`: la anti-invarianza vale ---el producto es
    uno--- y sin embargo `log a ≠ 0`.

    **Luego tener el tipo no implica valer cero**, y ésa es la razón
    de que el tipo no acote. -/
theorem type_does_not_force_vanishing :
    ∃ a b : ℝ, 0 < a ∧ 0 < b ∧ a * b = 1 ∧
      Real.log b = - Real.log a ∧ Real.log a ≠ 0 := by
  refine ⟨2, 1 / 2, by norm_num, by norm_num, by norm_num, ?_, ?_⟩
  · exact (log_antisymmetry_iff_product_one 2 (1 / 2) (by norm_num)
      (by norm_num)).mpr (by norm_num)
  · intro h
    have := (value_zero_iff_modulus_one 2 (by norm_num)).mp h
    norm_num at this

/-! ## §91.3  Tipo y valor, no dos mitades -/

/-- **[O] EL ENUNCIADO SIN DIVISIÓN.**

    (i)   el tipo de `u` es `χ₄`: `σ`-invariante y
          `τ`-anti-invariante                                  `[P]`
    (ii)  la mitad `τ` de ese tipo ES `e₂ = 1`                  `[P]`
    (iii) el tipo NO fuerza el valor ---hay testigo---          `[P]`
    (iv)  `E` es que el valor se anule                          `[Conj]`

    **No hay «mitad cerrada» y «mitad abierta» del salto.**  Lo
    cerrado es el TIPO; lo abierto es el VALOR del mismo objeto. -/
theorem type_and_value_not_halves (ρ : ℂ) (h₀ : ρ ≠ 0) (h₁ : ρ ≠ 1)
    (hp : 0 < Complex.abs (liMap ρ))
    (hq : 0 < Complex.abs (liMap (1 - ρ))) :
    (Real.log (Complex.abs (liMap (1 - ρ)))
       = - Real.log (Complex.abs (liMap ρ))) ∧
    (Complex.abs (liMap ρ) * Complex.abs (liMap (1 - ρ)) = 1) ∧
    (∃ a b : ℝ, 0 < a ∧ 0 < b ∧ a * b = 1 ∧
       Real.log b = - Real.log a ∧ Real.log a ≠ 0) ∧
    (Real.log (Complex.abs (liMap ρ)) = 0
       ↔ Complex.abs (liMap ρ) = 1) :=
  ⟨tau_half_holds ρ h₀ h₁ hp hq,
   moduli_product_is_one ρ h₀ h₁,
   type_does_not_force_vanishing,
   value_zero_iff_modulus_one _ hp⟩

/-- **[O] LA DIVISIÓN, LOCALIZADA.**  La partición «multiplicativa
    cerrada / aditiva abierta» es correcta en §28--§31, donde los dos
    objetos son `e₂` y `e₁`.  Transportarla a §41, donde el objeto es
    `u = log|z|` ---que ya ES la flecha entre lo multiplicativo y lo
    aditivo (§32)---, es lo que la vuelve falsa.

    §41 no habla de mitades: habla de tipo. -/
theorem the_partition_belongs_to_its_level (a b : ℝ) (ha : 0 < a) (hb : 0 < b) :
    (Real.log b = - Real.log a ↔ a * b = 1) ∧
    (Real.log a = 0 ↔ a = 1) :=
  ⟨log_antisymmetry_iff_product_one a b ha hb,
   value_zero_iff_modulus_one a ha⟩

