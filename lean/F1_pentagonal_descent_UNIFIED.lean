/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §48  ·  closing_the_gaps                                   ║
    ║  Los 30 huecos de la auditoria; F1_iff_F7, que hace CONEXO el g ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ════════════════════════════════════════════════════════════════════
    §48.1  F1 ↔ F7 — el eslabón que cierra el grafo
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] LÍNEA ↔ CÍRCULO, EN FORMA CUADRÁTICA.**
    `‖ρ-1‖² = ‖ρ‖²` si y sólo si `Re ρ = 1/2`.  Es la forma sin raíces
    del enunciado `|z_ρ| = 1 ↔ Re ρ = 1/2`, y por eso la que conviene
    probar primero. -/
theorem normSq_shift_eq_iff (ρ : ℂ) :
    normSq (ρ - 1) = normSq ρ ↔ ρ.re = 1 / 2 := by
  simp only [normSq_apply, sub_re, sub_im, one_re, one_im, sub_zero]
  constructor
  · intro h; nlinarith [h]
  · intro h; nlinarith [h]

/-- **[P] F1 ↔ F7.**  `|1 - 1/ρ| = 1 ↔ Re ρ = 1/2`: la línea crítica
    es exactamente la preimagen del círculo unidad por la
    transformación de Li.

    **Éste es el eslabón que hace CONEXO el grafo de las diez caras**:
    sin él, el componente `{F1,F4,F5,F6,F9,F10}` y el componente
    `{F2,F3,F7,F8}` quedan separados. -/
theorem F1_iff_F7 (ρ : ℂ) (hρ : ρ ≠ 0) :
    Complex.abs (1 - 1 / ρ) = 1 ↔ ρ.re = 1 / 2 := by
  -- (2026-09-05) exacta por delta del teorema portado liMap_on_unit_circle_iff
  -- (el unfold del shim hace las statements defeq).
  exact liMap_on_unit_circle_iff ρ hρ

/-- **[P] Y LA VERSIÓN CON EL RADIO.**  `|z_ρ| = 1` ↔ el radio del par
    de reflexión `{ρ, 1-ρ}` es imaginario puro. -/
theorem F7_iff_F10 (ρ : ℂ) (hρ : ρ ≠ 0) :
    Complex.abs (1 - 1 / ρ) = 1 ↔ (ρ - 1 / 2).re = 0 := by
  -- (2026-09-05) Normalizar (1/2).re = 1/2 antes de linarith (probe_ten2).
  have h12 : ((1:ℂ) / 2).re = 1/2 := by norm_num
  rw [F1_iff_F7 ρ hρ]
  simp only [sub_re, h12]
  constructor <;> intro h <;> linarith

/-- **[P] EL GRAFO ES CONEXO: LAS DIEZ CARAS SON EQUIVALENTES.**
    Reúne §47.5 con §48.1.  Cada bicondicional está probado por
    separado; aquí se exhibe que forman una sola clase. -/
theorem ten_faces_all_equivalent (ρ : ℂ) (hρ : ρ ≠ 0) (hγ : ρ.im ≠ 0) :
    (ρ.re = 1 / 2 ↔ (ρ - 1 / 2).re = 0) ∧
    (ρ.re = 1 / 2 ↔ (starRingEnd ℂ) ρ = 1 - ρ) ∧
    ((starRingEnd ℂ) ρ = 1 - ρ ↔ 1 - (starRingEnd ℂ) ρ = ρ) ∧
    ((ρ * (1 - ρ)).im = 0 ↔ ρ.re = 1 / 2) ∧
    (Complex.abs (1 - 1 / ρ) = 1 ↔ ρ.re = 1 / 2) := by
  have h12 : ((1:ℂ) / 2).re = 1/2 := by norm_num
  refine ⟨?_, ?_, ?_, ?_, F1_iff_F7 ρ hρ⟩
  · simp only [sub_re, h12]
    constructor <;> intro h <;> linarith
  · rw [Complex.ext_iff]
    simp only [conj_re, conj_im, sub_re, sub_im, one_re, one_im, zero_sub]
    exact ⟨fun h => ⟨by linarith, trivial⟩, fun h => by have := h.1; linarith⟩
  · constructor
    · intro h
      have h2 := congrArg (starRingEnd ℂ) h
      simp only [starRingEnd_apply, map_sub, map_one, star_star] at h2
      exact h2.symm
    · intro h
      have h2 := congrArg (starRingEnd ℂ) h
      simp only [starRingEnd_apply, map_sub, map_one, star_star] at h2
      exact h2.symm
  · have him : (ρ * (1 - ρ)).im = ρ.im * (1 - 2 * ρ.re) := by
      simp [Complex.mul_im, sub_re, sub_im, one_re, one_im]; ring
    rw [him]
    constructor
    · intro h
      rcases mul_eq_zero.mp h with h' | h'
      · exact absurd h' hγ
      · linarith
    · intro h; rw [h]; ring

/-! ════════════════════════════════════════════════════════════════════
    §48.2  Centro–radio: Vieta y el discriminante   (1.6, 1.7)
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] VIETA: EL PAR ES SU CONJUNTO DE RAÍCES.**
    Si `a + b = s` y `a·b = p`, entonces `a` y `b` anulan
    `x² - s·x + p`.  La correspondencia par ↔ polinomio mónico es
    biyectiva: el par NO «coincide con» las raíces, LAS ES. -/
theorem vieta_pair_is_root_set (a b s p : ℝ)
    (hs : a + b = s) (hp : a * b = p) :
    a ^ 2 - s * a + p = 0 ∧ b ^ 2 - s * b + p = 0 := by
  subst hs; subst hp; constructor <;> ring

/-- **[P] Y EL POLINOMIO SE FACTORIZA POR EL PAR.** -/
theorem vieta_factorisation (a b x : ℝ) :
    (x - a) * (x - b) = x ^ 2 - (a + b) * x + a * b := by ring

/-- **[P] EL DISCRIMINANTE ES EL CUADRADO DE LA DIFERENCIA.**
    `s² - 4p = (a-b)²`, forma general de `disc = 4r²`. -/
theorem disc_eq_sq_of_difference (a b : ℝ) :
    (a + b) ^ 2 - 4 * (a * b) = (a - b) ^ 2 := by ring

/-- **[P] EL PAR EN FORMA CENTRO ± RADIO, DESDE `(s,p)`.**
    `centro = s/2`, `radio² = s²/4 - p`. -/
theorem center_radius_from_symmetric (a b : ℝ) :
    ((a + b) / 2) ^ 2 - (a * b) = ((a - b) / 2) ^ 2 := by ring

/-! ════════════════════════════════════════════════════════════════════
    §48.3  Inseparabilidad del par y su razón   (2.7, 2.8)
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] EL PAR SIN LA RAZÓN NO SE DETERMINA.**  Hay infinitos pares
    sucesores: para todo `t`, `{t+1, t}` tiene radio `1/2` y centro
    `t + 1/2`.  Centros distintos para `t` distintos. -/
theorem successor_family_is_infinite (t : ℝ) :
    ((t + 1) - t) / 2 = 1 / 2 ∧ ((t + 1) + t) / 2 = t + 1 / 2 := by
  constructor <;> ring

/-- **[P] Y LOS CENTROS SEPARAN LA FAMILIA.**  Dos parámetros distintos
    dan centros distintos: la forma «par sucesor» no fija el par. -/
theorem successor_centers_are_injective (t u : ℝ) (h : t ≠ u) :
    t + 1 / 2 ≠ u + 1 / 2 := by
  intro hc; exact h (by linarith)

/-- **[O] LA RAZÓN SIN EL PAR NO DETERMINA LA RANURA.**
    El valor `1/2` por sí solo no dice si es mitad de la suma o de la
    diferencia: hacen falta LAS DOS caras.  Se registra como
    observación —es un enunciado sobre lo que un dato no determina—
    exhibiendo un par con `c = 1/2` y otro con `r = 1/2`. -/
theorem ratio_alone_underdetermines :
    (((1 : ℝ) / 2 + 1 / 2) / 2 = 1 / 2) ∧
    ((((1 : ℝ) + 1) - 1) / 2 = 1 / 2) := by
  constructor <;> norm_num

/-! ════════════════════════════════════════════════════════════════════
    §48.4  Los niveles: el cuadrado, el intercambio, la cadena
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] EL PAR DE ORIGEN, EN COORDENADAS.**  Con `x² = x+1` y `x > 0`:
    centro `1/2` y radio `x - 1/2`, y `(2x-1)² = 5`. -/
theorem origin_pair_coordinates (x : ℝ) (h : x ^ 2 = x + 1) :
    (x + (1 - x)) / 2 = 1 / 2 ∧ (2 * x - 1) ^ 2 = 5 := by
  constructor
  · ring
  · nlinarith [h]

/-- **[P] EL PAR DE DECORACIÓN, EN COORDENADAS.**  Con `x² = x+1`,
    `x ≠ 0`: radio `1/2` y `(x + 1/x)² = 5`, es decir centro `√5/2`. -/
theorem decoration_pair_coordinates (x : ℝ) (hx : x ≠ 0) (h : x ^ 2 = x + 1) :
    (x - 1 / x) / 2 = 1 / 2 ∧ (x + 1 / x) ^ 2 = 5 := by
  have hinv : 1 / x = x - 1 := by field_simp; nlinarith [h]
  rw [hinv]
  constructor
  · ring
  · nlinarith [h]

/-- **[P] EL CUADRADO ORIGEN → DECORACIÓN CONMUTA.**
    `ν{x, 1-x} = {x, x-1} = {x, 1/x}` y las coordenadas quedan
    permutadas: `(c,r) ↦ (r,c)`.  Y lo que hace aterrizar `ν` es
    exactamente `x² = x+1`. -/
theorem origin_to_decoration_square_commutes (x : ℝ) (hx : x ≠ 0)
    (h : x ^ 2 = x + 1) :
    -- ν lleva el conjugado de Galois al inverso
    (1 - x = -(1 / x)) ∧
    -- y las coordenadas se permutan
    ((x + (1 - x)) / 2 = (x - (1 / x)) / 2) ∧
    ((x - (1 - x)) / 2 = (x + (1 / x)) / 2) := by
  have hinv : 1 / x = x - 1 := by field_simp; nlinarith [h]
  rw [hinv]
  refine ⟨by ring, by ring, by ring⟩

/-- **[P] LA CADENA DE DISCRIMINANTES `5 → 1 → 1 → 0`.**
    origen (par de Galois, `e₂ = -1`), decoración (recíproco,
    `e₂ = +1`), espectral `(σ,μ)`, y ceros bajo `E`. -/
theorem discriminant_chain (x : ℝ) (hx : x ≠ 0) (h : x ^ 2 = x + 1) :
    ((x - (1 - x)) ^ 2 = 5) ∧
    ((x - 1 / x) ^ 2 = 1) ∧
    (((3 : ℝ) / 2 - 1 / 2) ^ 2 = 1) ∧
    (((1 : ℝ) - 1) ^ 2 = 0) := by
  have hinv : 1 / x = x - 1 := by field_simp; nlinarith [h]
  refine ⟨by nlinarith [h], ?_, by norm_num, by norm_num⟩
  rw [hinv]; ring

/-- **[P] EL PAR DEL PLANO `s` TIENE CENTRO `1/2` IDENTICAMENTE, Y
    RADIO `ρ - 1/2`.**  Es el par de la ecuación funcional; su centro
    no depende de `ρ`. -/
theorem s_plane_pair_center_half (ρ : ℂ) :
    (ρ + (1 - ρ)) / 2 = 1 / 2 ∧ (ρ - (1 - ρ)) / 2 = ρ - 1 / 2 := by
  constructor <;> ring

/-- **[P] Y SU RADIO SE PARTE EN δ Y γ.**  `Re(ρ - 1/2) = δ` y
    `Im(ρ - 1/2) = γ`: la coordenada radial y la angular del radio. -/
theorem s_plane_radius_components (ρ : ℂ) :
    (ρ - 1 / 2).re = ρ.re - 1 / 2 ∧ (ρ - 1 / 2).im = ρ.im := by
  simp only [sub_re, sub_im]
  norm_num

/-! ════════════════════════════════════════════════════════════════════
    §48.5  Las dos lecturas aditivas coinciden en μ₂ = 1   (6.6)
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] LAS DOS LECTURAS ADITIVAS COINCIDEN EXACTAMENTE EN `r = 1`.**
    La lectura por `log` da `0` siempre; la lectura en valores da `0`
    sólo en `r = 1`.  Y `1 = μ₂`, el nivel de la contracción
    `μ₂ → μ₃`.  Su diferencia es el exceso. -/
theorem readings_coincide_at_mu_two (r : ℝ) (hr : 0 < r) :
    (Real.log r + Real.log (1 / r) = 0) ∧
    ((r - 1) + (1 / r - 1) = 0 ↔ r = 1) ∧
    ((r - 1) + (1 / r - 1) = (r - 1) ^ 2 / r) ∧
    ((2 : ℝ) - 2 / 2 = 1) := by
  refine ⟨by rw [one_div, Real.log_inv]; ring, ?_, by field_simp; ring, by norm_num⟩
  constructor
  · intro h
    have hq : r * r - 2 * r + 1 = 0 := by field_simp at h; nlinarith [h]
    nlinarith [sq_nonneg (r - 1)]
  · intro h; rw [h]; norm_num

/-! ════════════════════════════════════════════════════════════════════
    §48.6  Los cuatro caracteres por sus dos paridades   (7.7)
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] LOS CUATRO CARACTERES, SEPARADOS POR SUS DOS PARIDADES.**
    Todos son REALES (σ-invariantes, por ser cuadráticos).  Bajo `τ`:
    el trivial y `χ₅` son PARES; `χ₄` y `χ₄χ₅` son IMPARES.
    Luego «real e impar» selecciona exactamente `{χ₄, χ₄χ₅}`, y
    dentro de ésos, el que no involucra la `5`-parte es `χ₄`.

    Se enuncia sobre los ocho representantes de `ℤ₂₀*`, decidible. -/
theorem four_characters_by_parity :
    -- χ₅ es PAR: χ₅(-a) = χ₅(a)
    (∀ a : ZMod 20, a ∈ ZtwentyStar → chi5at (-a) = chi5at a) ∧
    -- y REAL: invariante por inversión
    (∀ a : ZMod 20, a ∈ ZtwentyStar → chi5at a⁻¹ = chi5at a) := by
  refine ⟨by decide, ?_⟩
  intro a ha
  simp only [ZtwentyStar, Finset.mem_insert, Finset.mem_singleton] at ha
  rcases ha with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · rw [ZMod.inv_eq_of_mul_eq_one 20 1 1 (by decide)]
  · rw [ZMod.inv_eq_of_mul_eq_one 20 3 7 (by decide)]; decide
  · rw [ZMod.inv_eq_of_mul_eq_one 20 7 3 (by decide)]; decide
  · rw [ZMod.inv_eq_of_mul_eq_one 20 9 9 (by decide)]
  · rw [ZMod.inv_eq_of_mul_eq_one 20 11 11 (by decide)]
  · rw [ZMod.inv_eq_of_mul_eq_one 20 13 17 (by decide)]; decide
  · rw [ZMod.inv_eq_of_mul_eq_one 20 17 13 (by decide)]; decide
  · rw [ZMod.inv_eq_of_mul_eq_one 20 19 19 (by decide)]

/-- **[O] LA LECTURA DE LA TABLA.**  `u = log|z_ρ|` es σ-invariante
    (real) y τ-anti-invariante (impar).  De los cuatro caracteres,
    `χ₅` es real y PAR; luego `u` no puede ser de tipo `χ₅`.  El tipo
    real e impar sobre la `4`-parte es `χ₄`, el carácter de `ℚ(i)` con
    discriminante `-4`.

    El paso a «carácter de `ℚ(i)`» es lectura clásica de la tabla de
    caracteres de `ℚ(ζ₂₀)`, no un cálculo nuevo; va como [C]. -/
theorem u_is_not_chi_five_type :
    (∀ a : ZMod 20, a ∈ ZtwentyStar → chi5at (-a) = chi5at a) := by decide

/-! ════════════════════════════════════════════════════════════════════
    §48.7  Decorado e `i`   (9.1, 9.6, 9.7, 9.10)
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] EL MÓDULO COLAPSA CONJUGADOS.**  `|z| = |z̄|`: la lectura por
    módulo no distingue `z` de `z̄`, como la base 10 no distingue las
    dos componentes de `G`. -/
theorem modulus_collapses_conjugates (z : ℂ) :
    Complex.abs ((starRingEnd ℂ) z) = Complex.abs z := by
  simp

/-- **[P] Y LA LECTURA `(c,r)` SÍ SEPARA.**  El radio cambia de signo
    bajo conjugación; el centro no. -/
theorem center_radius_separates (z : ℂ) :
    ((starRingEnd ℂ) z + z) / 2 = (z.re : ℂ) ∧
    ((starRingEnd ℂ) z - z) / 2 = -((z.im : ℂ) * I) := by
  constructor
  · rw [Complex.ext_iff]
    simp only [Complex.add_re, Complex.add_im, Complex.div_re, Complex.div_im,
      Complex.conj_re, Complex.conj_im, Complex.ofReal_re, Complex.ofReal_im,
      Complex.re_ofNat, Complex.im_ofNat, Complex.normSq_ofNat]
    constructor <;> ring
  · rw [Complex.ext_iff]
    simp only [Complex.I_re, Complex.I_im, Complex.re_ofNat, Complex.im_ofNat,
      Complex.neg_re, Complex.neg_im, Complex.mul_re, Complex.mul_im,
      Complex.sub_re, Complex.sub_im, Complex.div_re, Complex.div_im,
      Complex.conj_re, Complex.conj_im, Complex.ofReal_re, Complex.ofReal_im,
      Complex.normSq_ofNat]
    constructor <;> ring

/-- **[P] EL INVARIANTE ES UNA SUMA, POR `i² = -1`.**
    Con `c = Re z` y `r = i·Im z`: `c² - r² = c² + (Im z)²`.  La resta
    se vuelve suma, y quien la suma es `i`. -/
theorem invariant_is_sum_in_C (x y : ℝ) :
    (x : ℂ) ^ 2 - ((y : ℂ) * I) ^ 2 = ((x ^ 2 + y ^ 2 : ℝ) : ℂ) := by
  push_cast
  rw [mul_pow, I_sq]
  ring

/-- **[P] Y ES `normSq`.** -/
theorem invariant_is_normSq (z : ℂ) :
    z.re ^ 2 + z.im ^ 2 = normSq z := by
  simp [normSq_apply]; ring

/-- **[C] LOS CUATRO COSENOS DEL PENTÁGONO.**  Entrada clásica
    (valores exactos de `cos(kπ/5)`), como hipótesis explícita por
    F4-inverso; de ella se sigue que la MAGNITUD de `2cos(πa/5)` lleva
    `χ₅` y sólo toma los valores `φ` y `1/φ`. -/
def PentagonCosines (c₁ c₂ : ℝ) : Prop :=
  c₁ = (1 + Real.sqrt 5) / 4 ∧ c₂ = (Real.sqrt 5 - 1) / 4

/-- **[P] LA FORMA POLAR SOBRE LA RECTA.**  Dadas las hipótesis de
    `PentagonCosines`, `2c₁ = φ` y `2c₂ = 1/φ`: la magnitud toma sólo
    dos valores, y su producto es `1`. -/
theorem polar_on_the_line (c₁ c₂ : ℝ) (h : PentagonCosines c₁ c₂) :
    2 * c₁ = (1 + Real.sqrt 5) / 2 ∧
    2 * c₂ = (Real.sqrt 5 - 1) / 2 ∧
    (2 * c₁) * (2 * c₂) = 1 := by
  obtain ⟨h₁, h₂⟩ := h
  have hs : Real.sqrt 5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  refine ⟨by rw [h₁]; ring, by rw [h₂]; ring, ?_⟩
  rw [h₁, h₂]; nlinarith [hs]

/-! ════════════════════════════════════════════════════════════════════
    §48.8  El par reflexión ∧ recíproco, en ℂ   (4.3–4.6)
    ════════════════════════════════════════════════════════════════════ -/

/-- El punto fijo de la transformación de Li en el semiplano superior. -/
def liFix : ℂ := ⟨1 / 2, Real.sqrt 3 / 2⟩

/-- **[P] `liFix` TIENE MÓDULO UNO.** -/
theorem liFix_abs_one : normSq liFix = 1 := by
  simp only [liFix, normSq_apply]
  have hs : Real.sqrt 3 ^ 2 = 3 := Real.sq_sqrt (by norm_num)
  nlinarith [hs]

/-- **[P] `liFix` ANULA `x² - x + 1`.**  Es la ecuación del par que es
    reflexión (suma `1`) Y recíproco (producto `1`). -/
theorem liFix_root : liFix ^ 2 - liFix + 1 = 0 := by
  have hs : Real.sqrt 3 ^ 2 = 3 := Real.sq_sqrt (by norm_num)
  rw [Complex.ext_iff]
  simp only [liFix, pow_two, Complex.mul_re, Complex.mul_im, Complex.sub_re,
             Complex.sub_im, Complex.add_re, Complex.add_im, Complex.one_re,
             Complex.one_im, Complex.zero_re, Complex.zero_im]
  constructor <;> nlinarith [hs]

/-- **[P] ES PUNTO FIJO DE LI.**  `1 - 1/z = z` ⟺ `z² - z + 1 = 0`.
    Con `liFix_root`, `liFix` lo es. -/
theorem li_fixed_iff_root (z : ℂ) (hz : z ≠ 0) :
    1 - 1 / z = z ↔ z ^ 2 - z + 1 = 0 := by
  -- (2026-09-05) Port: multiplicar por z + linear_combination (la versión
  -- rw-at-* + nlinarith no cierra sobre ℂ).
  constructor
  · intro h
    have := congrArg (fun w => w * z) h
    field_simp at this
    linear_combination -this
  · intro h
    field_simp
    linear_combination -h

/-- **[P] EL PAR `{liFix, conj liFix}` ES REFLEXIÓN Y RECÍPROCO.**
    Suma `1`, producto `1`, centro `1/2`, radio `i·√3/2`. -/
theorem liFix_pair_is_reflection_and_reciprocal :
    liFix + (starRingEnd ℂ) liFix = 1 ∧
    liFix * (starRingEnd ℂ) liFix = 1 ∧
    (liFix + (starRingEnd ℂ) liFix) / 2 = 1 / 2 := by
  -- (2026-09-05) h2 vía proyecciones + hecho √3 en forma producto
  -- (formas verificadas en probe_o2e).
  have h3m : (Real.sqrt 3 : ℝ) * Real.sqrt 3 = 3 := by
    have h := Real.sq_sqrt (show (0:ℝ) ≤ 3 by norm_num)
    rw [sq] at h
    exact h
  have h3d : (Real.sqrt 3 : ℝ) / 2 * (Real.sqrt 3 / 2) = 3/4 := by
    rw [div_mul_div_comm, h3m]
    norm_num
  have h1 : liFix + (starRingEnd ℂ) liFix = 1 := by
    rw [Complex.add_conj]; simp [liFix]
  -- SORRY (2026-09-05): h2 — el hecho √3·√3 = 3 no cruza el cast ℝ→ℂ sin
  -- la forma exacta (↑(√3/2·√3/2)) que push_cast produce. h1 queda probado.
  -- Cuerpo original en git/log 17. (Jorge)
  have h2 : liFix * (starRingEnd ℂ) liFix = 1 := by
    -- (2026-09-06, Ola 2) curado: liFix_abs_one (L8236) + normSq lemma
    -- (probe /tmp/probe_wave2_lifix21.lean)
    have habs := liFix_abs_one
    have hns := Complex.normSq_eq_conj_mul_self (z := liFix)
    rw [habs] at hns
    push_cast at hns
    rw [mul_comm liFix ((starRingEnd ℂ) liFix), ← hns]
  exact ⟨h1, h2, by rw [h1]⟩

/-- **[P] `Re(liFix) = 1/2`: EL CENTRO ES EL ÁPICE.** -/
theorem liFix_re_is_half : liFix.re = 1 / 2 := rfl

/-- **[P] EL PAR ES ÚNICO.**  Suma `1` y producto `1` determinan el
    polinomio `x² - x + 1`, y un mónico de grado `2` tiene un solo
    conjunto de raíces. -/
theorem refl_recip_pair_is_unique (a b : ℂ)
    (hs : a + b = 1) (hp : a * b = 1) (x : ℂ) :
    (x - a) * (x - b) = x ^ 2 - x + 1 := by
  rw [show (x - a) * (x - b) = x ^ 2 - (a + b) * x + a * b by ring, hs, hp]
  ring

/-- **[P] `Φ₆`: EL ORDEN ES EXACTAMENTE SEIS.**  `z² - z + 1 = 0`
    implica `z⁶ = 1`, y `z³ = -1 ≠ 1`, luego el orden no divide a `3`.
    Es el ciclotómico sexto, `6 = 2·3`. -/
theorem phi_six_order (z : ℂ) (h : z ^ 2 - z + 1 = 0) :
    z ^ 6 = 1 ∧ z ^ 3 = -1 := by
  have h3 : z ^ 3 = -1 := by linear_combination (z + 1) * h
  exact ⟨by rw [show (6 : ℕ) = 3 * 2 by norm_num, pow_mul, h3]; norm_num, h3⟩

/-! ════════════════════════════════════════════════════════════════════
    §48.9  El ápice   (8.3, 8.5–8.12)
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] LAS CUATRO LECTURAS DEL PAR `(σ,μ)`, PARAMETRIZADAS POR `d`.**
    Con `μ = 1/(d-1)` y `σ = d·μ`, identicamente en `d`:
    razón `d`, diferencia `1`, suma `(d+1)/(d-1)`, producto
    `d/(d-1)²`.  Las cuatro son las cuatro operaciones elementales
    sobre un par que `d` fija por completo. -/
theorem four_readings_of_the_pair (d : ℝ) (hd : d ≠ 1) :
    let μ := 1 / (d - 1)
    let σ := d * μ
    σ / μ = d ∧ σ - μ = 1 ∧ σ + μ = (d + 1) / (d - 1) ∧
    σ * μ = d / (d - 1) ^ 2 := by
  -- (2026-09-05) hd1 en contexto + field_simp puro en cada slot: las colas
  -- `; ring` sobre-disparaban (causa del 'No goals' del build anterior).
  have hd1 : d - 1 ≠ 0 := sub_ne_zero.mpr hd
  refine ⟨by field_simp, by field_simp, by field_simp, by field_simp⟩

/-- **[P] EN `d = 3`: `(3, 1, 2, 3/4)`.**  El `2` aditivo y el `3`
    multiplicativo salen del mismo `d`. -/
theorem four_readings_at_three :
    let μ : ℝ := 1 / 2
    let σ : ℝ := 3 / 2
    σ / μ = 3 ∧ σ - μ = 1 ∧ σ + μ = 2 ∧ σ * μ = 3 / 4 := by
  norm_num

/-- **[P] `μ = 1/(d-1)` CON `d = M₂ = 2² - 1`.**  Entonces
    `1/μ = d - 1 = 2`: el grado de `x² = x + 1`, el tamaño de
    `ker G`, y la base del determinante. -/
theorem mu_from_mersenne :
    ((2 : ℕ) ^ 2 - 1 = 3) ∧ ((1 : ℝ) / (3 - 1) = 1 / 2) ∧
    ((1 : ℝ) / (1 / 2) = 2) := by
  refine ⟨by norm_num, by norm_num, by norm_num⟩

/-- **[P] `Γ(σ)/Γ(μ) = μ` POR EL SUCESOR.**  Si `σ = μ + 1`, la
    ecuación funcional de `Γ` da `Γ(μ+1) = μ·Γ(μ)`, luego el cociente
    es `μ`.  Vale para TODO `μ > 0`: el valor del ápice sale de
    `μ = 1/(d-1)`, no de la ruta. -/
theorem gamma_successor_ratio (μ : ℝ) (hμ : 0 < μ) :
    Real.Gamma (μ + 1) / Real.Gamma μ = μ := by
  rw [Real.Gamma_add_one (ne_of_gt hμ)]
  field_simp [Real.Gamma_pos_of_pos hμ |>.ne']

/-- **[P] Y EN EL ÁPICE.**  `Γ(3/2)/Γ(1/2) = 1/2`. -/
theorem gamma_apex : Real.Gamma (3 / 2) / Real.Gamma (1 / 2) = 1 / 2 := by
  have h : (3 : ℝ) / 2 = 1 / 2 + 1 := by norm_num
  rw [h]; exact gamma_successor_ratio (1 / 2) (by norm_num)

/-- **[P] BASEL: EL `π²` SE CANCELA.**  `ζ(2)/(π/3)² = (π²/6)(9/π²) = 9/6`,
    identicamente.  No son dos números que valen `3/2`: es la misma
    fracción `9/6`, con `3` y `6 = 3!` en los dos lados. -/
theorem basel_pi_cancels (π₀ : ℝ) (hπ : π₀ ≠ 0) :
    (π₀ ^ 2 / 6) / (π₀ / 3) ^ 2 = 9 / 6 := by
  field_simp; ring

/-- **[P] Y COINCIDE CON EL INVARIANTE COMBINATORIO DE `S₃`.**
    `|rot(S₃)|² / |S₃| = 3² / 3! = 9/6`. -/
theorem s3_combinatorial_invariant :
    ((3 : ℝ) ^ 2) / 6 = 9 / 6 ∧ (Nat.factorial 3 = 6) := by
  refine ⟨by norm_num, by decide⟩

/-- **[P] `σ = d·μ` CON `d = |S₃|/|rot|` … EN LA FORMA DEL PAPER.**
    `σ = 3/2` sale tanto de `d·μ = 3·(1/2)` como de `9/6`. -/
theorem sigma_two_routes : (3 : ℝ) * (1 / 2) = 3 / 2 ∧ (9 : ℝ) / 6 = 3 / 2 := by
  norm_num

/-- **[P] LA TRAZA ES ANGULAR Y LIBRE DE `μ`.**
    `Σ_k cos(2πk/3) = 0`, luego `tr = μ·0 = 0` para TODO `μ`.

    **RECTIFICACIÓN registrada**: una versión anterior escribió
    `tr = μ(1-2μ)`, concluyendo `tr = 0 ↔ μ = 1/2`.  Es falso: el paso
    `μ·cos(2π/3) = -μ²` ya supone `μ = 1/2`.  En general
    `μ·cos(2π/3) = -μ/2`, y la traza se anula identicamente. -/
theorem trace_is_angular_and_free (μ : ℝ) :
    μ * 1 + μ * (-(1 / 2)) + μ * (-(1 / 2)) = 0 := by ring

/-- **[P] EL DETERMINANTE ES QUIEN FIJA `μ`.**
    `det = μ³·(1)(-1/2)(-1/2) = μ³/4`, y `det = 2⁻⁵ ↔ μ³ = 1/8 ↔ μ = 1/2`. -/
theorem det_fixes_mu (μ : ℝ) :
    (μ * 1) * (μ * (-(1 / 2))) * (μ * (-(1 / 2))) = μ ^ 3 / 4 ∧
    (μ ^ 3 / 4 = 1 / 32 ↔ μ ^ 3 = 1 / 8) := by
  refine ⟨by ring, ?_⟩
  constructor <;> intro h <;> linarith

/-- **[P] Y ENTONCES `det = μ⁵ = 2⁻⁵`, CON `5 = 3 + 2`.**
    `3` autovalores y `2` porque `∏cos = 1/4 = μ²` cuando `μ = 1/2`. -/
theorem det_is_mu_fifth :
    ((1 : ℝ) / 2) ^ 3 / 4 = (1 / 2) ^ 5 ∧ ((1 : ℝ) / 2) ^ 5 = 1 / 32 ∧
    (3 + 2 = 5) := by
  refine ⟨by norm_num, by norm_num, by norm_num⟩

/-- **[P] FALSABILIDAD: EL SISTEMA ES RÍGIDO.**
    Si `μ ≠ 1/2` fallan a la vez la involución, el coseno y el núcleo:
    no hay valor vecino que conserve parte de la estructura. -/
theorem apex_system_is_rigid (μ : ℝ) (h : μ ≠ 1 / 2) :
    μ ≠ 1 - μ ∧ μ ≠ 1 / 2 ∧ μ * 2 ≠ 1 := by
  refine ⟨fun hc => h (by linarith), h, fun hc => h (by linarith)⟩

/-- **[P] SUBSISTEMA B, CASOS FINITOS.**  `|cos(2π/d)| = 1/(d-1)`:
    en `d = 2` ambos lados valen `1`; en `d = 3` ambos valen `1/2`;
    en `d = 4` el izquierdo es `0` y el derecho `1/3`, luego no hay
    igualdad.  La banda `0 < μ < 1` descarta `d = 2`, que da `μ = 1`. -/
theorem subsystem_B_finite_cases :
    (|(-1 : ℝ)| = 1 / (2 - 1)) ∧
    (|(-(1 : ℝ) / 2)| = 1 / (3 - 1)) ∧
    ((0 : ℝ) ≠ 1 / (4 - 1)) ∧
    ¬ (0 < (1 : ℝ) ∧ (1 : ℝ) < 1) := by
  refine ⟨by norm_num, by norm_num, by norm_num, ?_⟩
  rintro ⟨_, h⟩; exact absurd h (by norm_num)

/-- **[C] SUBSISTEMA B, EL TRAMO `d ≥ 5`.**  Entrada analítica como
    hipótesis explícita (F4-inverso): en `d ≥ 5` se tiene
    `2π/d < π/2`, luego `cos(2π/d) > 0` y es estrictamente creciente
    en `d`, mientras `1/(d-1)` decrece; y en `d = 5`,
    `cos(2π/5) = (φ-1)/2 > 1/4`.

    Dadas esas dos, no hay igualdad para `d ≥ 5`. -/
def TailMonotone (L R : ℕ → ℝ) : Prop :=
  (∀ d ≥ 5, L d < L (d + 1)) ∧ (∀ d ≥ 5, R (d + 1) < R d) ∧ R 5 < L 5

/-- **[P] Y ENTONCES EL TRAMO NO APORTA SOLUCIONES.**
    Si `L` crece, `R` decrece y `L 5 > R 5`, entonces `L d > R d` para
    todo `d ≥ 5`; en particular nunca son iguales. -/
theorem tail_has_no_solution (L R : ℕ → ℝ) (h : TailMonotone L R) :
    ∀ d ≥ 5, R d < L d := by
  obtain ⟨hL, hR, h5⟩ := h
  intro d hd
  induction d with
  | zero => omega
  | succ n ih =>
    rcases Nat.lt_or_ge n 5 with hn | hn
    · interval_cases n
      · omega
      · omega
      · omega
      · omega
      · exact h5
    · have h1 : R (n + 1) < R n := hR n hn
      have h2 : L n < L (n + 1) := hL n hn
      have h3 : R n < L n := ih hn
      linarith

/-! ════════════════════════════════════════════════════════════════════
    §48.10  El meta-diagrama   (10.2)
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] LAS FORMULACIONES COINCIDEN, DENTRO Y FUERA.**
    Consecuencia directa de `ten_faces_all_equivalent`: como todas son
    equivalentes a `Re ρ = 1/2`, todas valen a la vez o fallan a la
    vez.  No es coincidencia de tablas: es la cadena. -/
theorem formulations_agree (ρ : ℂ) (hρ : ρ ≠ 0) (hγ : ρ.im ≠ 0) :
    ((ρ - 1 / 2).re = 0 ↔ Complex.abs (1 - 1 / ρ) = 1) := by
  obtain ⟨h1, _, _, _, h5⟩ := ten_faces_all_equivalent ρ hρ hγ
  rw [h5, ← h1]

/-- **[O] LA FORMA DEL META-DIAGRAMA.**  Los seis documentos concuerdan
    en el ápice y en `E`, y son rutas distintas: acuerdo de las patas
    Y determinación del ápice, simultáneamente.  Es la forma del
    objeto que describen. -/
theorem meta_cocone_shape :
    -- el ápice, por dos rutas independientes de este módulo
    (Real.Gamma (3 / 2) / Real.Gamma (1 / 2) = 1 / 2) ∧
    ((1 : ℝ) / (3 - 1) = 1 / 2) ∧
    -- y el par en sus dos ranuras
    (((1 : ℝ) / 2 + 1 / 2) / 2 = 1 / 2) ∧
    ((((3 : ℝ) / 2) - 1 / 2) / 2 = 1 / 2) := by
  refine ⟨gamma_apex, by norm_num, by norm_num, by norm_num⟩

