/-! ## §106.1  El compañero conserva la ordenada -/

/-- El compañero de Klein, `στ(ρ) = 1 − ρ̄` ---`kmate`, §71. -/
def kmate₆ (ρ : ℂ) : ℂ := 1 - (starRingEnd ℂ) ρ

/-- **[P] CONSERVA LA ORDENADA, SIEMPRE.**  `Im(1 − ρ̄) = Im ρ`, sin
    hipótesis.  Restatement de `kmate_same_ordinate` (§71). -/
theorem kmate_keeps_ordinate (ρ : ℂ) : (kmate₆ ρ).im = ρ.im := by
  simp [kmate₆, Complex.sub_im, Complex.conj_im]

/-- **[P] Y REFLEJA LA ABSCISA.**  `Re(1 − ρ̄) = 1 − Re ρ`. -/
theorem kmate_reflects (ρ : ℂ) : (kmate₆ ρ).re = 1 - ρ.re := by
  simp [kmate₆, Complex.sub_re, Complex.conj_re]

/-- **[P] LA BISAGRA.**  `kmate ρ = ρ ⟺ Re ρ = 1/2`. -/
theorem kmate_fixed_iff_line (ρ : ℂ) : kmate₆ ρ = ρ ↔ ρ.re = 1 / 2 := by
  rw [Complex.ext_iff, kmate_reflects, kmate_keeps_ordinate]
  exact ⟨fun h => by have := h.1; linarith,
         fun h => ⟨by linarith, rfl⟩⟩

/-! ## §106.2  Fuera de la línea hay espaciado cero -/

/-- **[P] FUERA DE LA LÍNEA, DOS CEROS DISTINTOS CON LA MISMA
    ORDENADA.**  Si `Re ρ ≠ 1/2` entonces `kmate ρ ≠ ρ` y sin embargo
    `Im(kmate ρ) = Im ρ`.

    **Eso es espaciado cero**, y es lo que §71 identifica con `E`. -/
theorem off_line_gives_zero_spacing (ρ : ℂ) (h : ρ.re ≠ 1 / 2) :
    kmate₆ ρ ≠ ρ ∧ (kmate₆ ρ).im = ρ.im := by
  refine ⟨?_, kmate_keeps_ordinate ρ⟩
  intro hc
  exact h ((kmate_fixed_iff_line ρ).mp hc)

/-- **[P] Y EN LA LÍNEA NO.**  El compañero coincide con el punto:
    un solo cero, sin par de ordenada compartida. -/
theorem on_line_no_zero_spacing (ρ : ℂ) (h : ρ.re = 1 / 2) :
    kmate₆ ρ = ρ :=
  (kmate_fixed_iff_line ρ).mpr h

/-! ## §106.3  La repulsión prohíbe justo eso -/

/-- **[C] LA REPULSIÓN, COMO PREDICADO.**  Entrada `[N]`: los
    espaciados de `Z_{χ₅}` no bajan de un umbral positivo ---medido,
