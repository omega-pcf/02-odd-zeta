section MasaDelRelojBlock

/-
MasaDelReloj.lean — prop:clock-mass (i), sprint 70. Estado P* (sin compilar: el entorno de Claude no
alcanza la cache de Mathlib y la computadora de Jorge no estaba conectada). Compilar con:
  lake env lean MasaDelReloj.lean

Enunciado abstracto, que se instancia con a d = log Q(d), c = log φ, η n = η_n:
si el peso de los niveles que dividen a n es n·c + η n, entonces el nivel d pesa
φ(d)·c + Σ_{e|d} μ(d/e) η e.  Es la inversión de Möbius más Σ_{d|n} φ(d) = n.
Nombres de Mathlib usados: `ArithmeticFunction.sum_eq_iff_sum_mul_moebius_eq`, `Nat.sum_totient`.
-/

open ArithmeticFunction
open scoped ArithmeticFunction.Moebius

namespace MasaDelReloj

/-- **El tamaño arquimediano de cada nivel.**  Si `Σ_{d|n} a d = n c + η n` para todo `n > 0`,
entonces `a n = φ(n) c + Σ_{(x,y), x y = n} μ(x) η(y)`. -/
theorem level_size (c : ℝ) (a η : ℕ → ℝ)
    (h : ∀ n : ℕ, 0 < n → ∑ d ∈ n.divisors, a d = (n : ℝ) * c + η n) :
    ∀ n : ℕ, 0 < n → a n = (Nat.totient n : ℝ) * c +
      ∑ x ∈ n.divisorsAntidiagonal, (μ x.1 : ℝ) * η x.2 := by
  have hb : ∀ n : ℕ, 0 < n → ∑ d ∈ n.divisors, (a d - (Nat.totient d : ℝ) * c) = η n := by
    intro n hn
    rw [Finset.sum_sub_distrib, ← Finset.sum_mul, h n hn]
    have ht : (∑ d ∈ n.divisors, (Nat.totient d : ℝ)) = n := by
      exact_mod_cast Nat.sum_totient n
    rw [ht]; ring
  have hinv := (sum_eq_iff_sum_mul_moebius_eq
    (f := fun d => a d - (Nat.totient d : ℝ) * c) (g := η)).mp hb
  intro n hn
  have h2 := hinv n hn
  linarith

/-- **La parte lineal da exactamente φ(n) vueltas.**  Con `η = 0`: si los niveles que dividen a `n`
pesan `n c`, el nivel `n` pesa `φ(n) c`. -/
theorem level_size_main (c : ℝ) (a : ℕ → ℝ)
    (h : ∀ n : ℕ, 0 < n → ∑ d ∈ n.divisors, a d = (n : ℝ) * c) :
    ∀ n : ℕ, 0 < n → a n = (Nat.totient n : ℝ) * c := by
  intro n hn
  have := level_size c a (fun _ => 0) (by intro m hm; simpa using h m hm) n hn
  simpa using this

end MasaDelReloj

end MasaDelRelojBlock

