theorem minus_inv_phi_is_the_other_root :
    (-(((φ : ℝ))⁻¹)) ^ 2 - (-(((φ : ℝ))⁻¹)) - 1 = 0 := by
  have hp : (φ : ℝ) ≠ 0 := ne_of_gt φ_pos
  have key : (1 : ℝ) = (φ : ℝ)⁻¹ + (φ : ℝ)⁻¹ ^ 2 := by
    field_simp
    linear_combination phi_sq
  ring_nf
  linarith [key]

theorem minimal_poly_is_self_dual (x : ℝ) (hx : x ≠ 0) :
    (-(1/x)) ^ 2 - (-(1/x)) - 1 = -((x ^ 2 - x - 1) / x ^ 2) := by
  field_simp
  ring

theorem golden_pair_is_outside :
    (2 / Real.sqrt 3 < (φ : ℝ)) ∧ (((φ : ℝ))⁻¹ < Real.sqrt 3 / 2) := by
  have h3 : (1.73 : ℝ) < Real.sqrt 3 := by
    nlinarith [Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 3), Real.sqrt_nonneg 3]
  have h3pos : (0:ℝ) < Real.sqrt 3 := by linarith
  have h5 : (2.23 : ℝ) < Real.sqrt 5 := by
    nlinarith [Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 5), Real.sqrt_nonneg 5]
  have hphi : (1.61 : ℝ) < (φ : ℝ) := by unfold φ; linarith
  have hkey : (2:ℝ) < (φ : ℝ) * Real.sqrt 3 := by nlinarith
  constructor
  · rw [div_lt_iff₀ h3pos]; linarith [hkey]
  · rw [inv_lt_iff_one_lt_mul₀ φ_pos]
    nlinarith [hkey, h3pos]

theorem the_radius_origin_relation (r x : ℝ) (hr : 0 < r) (hx : x ≠ 0) :
    ((φ : ℝ) * ((φ : ℝ) - 1) = 1) ∧
    (valPhi (φ : ℝ) = 1) ∧
    (valPhi (1:ℝ) = 0) ∧
    (valPhi (1 / r) = - valPhi r) ∧
    ((-(1/x)) ^ 2 - (-(1/x)) - 1 = -((x ^ 2 - x - 1) / x ^ 2)) :=
  ⟨phi_mul_phi_sub_one, golden_pair_valuations.1, unit_maps_to_origin,
   radius_is_distance_to_origin r hr, minimal_poly_is_self_dual x hx⟩

