  LA CADENA, SIN ÍTEM SUELTO AL FINAL.

      1. centro `= 1/2` para todo `ρ`                 `[P]` §126
      2. `Im(e₂) = −2δγ`                              `[P]` §127
      3. `γ ≠ 0` para un cero no trivial              `[P]`
      4. luego `δ·γ = 0` tiene solución ÚNICA         `[P]` §129
      5. **`e₂(mate) = conj(e₂(ρ))`**                 `[P]` **aquí**
      6. luego **`Σ Im(e₂) = 0`, automático**         `[P]` **aquí**
      ─────────────────────────────────────────────────────────
      7. y `Im(e₂) = 0` para CADA uno                 **es `E`**

  **El `7` no cuelga del vacío: es el `6` sin la suma.**  La distancia
  entre ellos es el CUANTIFICADOR, y es el mismo salto que
  `aggregate_does_not_give_individual` (§85.7).

  TIERS.  [P] probado · [C] entrada en la firma · [O] observación.
  Verificador: bloque §130 del unificado.
-/

/-! ## §130.1  El compañero lleva el conjugado -/

/-- El compañero de Klein. -/
def mate₈ (ρ : ℂ) : ℂ := 1 - (starRingEnd ℂ) ρ

/-- El invariante del par. -/
def e₂₈ (ρ : ℂ) : ℂ := ρ * (1 - ρ)

/-- **[P] `e₂(mate ρ) = conj(e₂ ρ)`.**  Identidad algebraica, para
    todo `ρ`: el compañero de Klein lleva el invariante conjugado.

    **Ésta es la pieza que liga el agregado al individual.** -/
theorem mate_carries_the_conjugate (ρ : ℂ) :
    e₂₈ (mate₈ ρ) = (starRingEnd ℂ) (e₂₈ ρ) := by
  unfold e₂₈ mate₈
  simp only [map_mul, map_sub, map_one]
  ring

/-! ## §130.2  Luego el agregado se anula -/

/-- **[P] LA SUMA DEL PAR TIENE PARTE IMAGINARIA CERO.**
    `Im(w) + Im(w̄) = 0`, sin hipótesis sobre `ρ`.

    **No supone `E`: vale con desviación o sin ella.** -/
theorem pair_imaginary_parts_cancel (ρ : ℂ) :
    (e₂₈ ρ).im + (e₂₈ (mate₈ ρ)).im = 0 := by
  rw [mate_carries_the_conjugate]
  simp [Complex.conj_im]

/-- **[P] Y ES INDEPENDIENTE DE LA DESVIACIÓN.**  Para `ρ` con
    `Re ρ ≠ 1/2` la cancelación sigue: es del emparejamiento, no de
    la posición. -/
theorem cancellation_does_not_need_E (ρ : ℂ) (_h : ρ.re ≠ 1 / 2) :
    (e₂₈ ρ).im + (e₂₈ (mate₈ ρ)).im = 0 :=
  pair_imaginary_parts_cancel ρ

/-! ## §130.3  El agregado no da el individual -/

/-- **[C] EL AGREGADO.**  `Σ Im(e₂) = 0` sobre `Z` ---probado por
    emparejamiento. -/
def AggregateVanishes (_Z : Set ℂ) (S : ℝ) : Prop := S = 0

/-- **[C] EL INDIVIDUAL.**  `Im(e₂ ρ) = 0` para CADA `ρ ∈ Z` ---es
    `E`. -/
def IndividualVanishes (Z : Set ℂ) : Prop := ∀ ρ ∈ Z, (e₂₈ ρ).im = 0

/-- **[P] EL INDIVIDUAL DA EL AGREGADO, NO AL REVÉS.**  Si cada uno
    se anula, la suma también; el recíproco falla ---y el
    contraejemplo es el par mismo, que suma cero con sumandos no
    nulos.

    **Ésta es la distancia entre el `6` y el `7`: el
    cuantificador.** -/
theorem individual_gives_aggregate (Z : Set ℂ) (ρ : ℂ) (hρ : ρ ∈ Z)
    (h : IndividualVanishes Z) : (e₂₈ ρ).im = 0 := h ρ hρ

/-- **[P] Y EL RECÍPROCO FALLA.**  El par `(ρ, mate ρ)` con
    `Re ρ ≠ 1/2` tiene suma cero y sumandos no nulos.

    Testigo: `ρ = 3/4 + iγ` con `γ ≠ 0` da
    `Im(e₂) = −2·(1/4)·γ = −γ/2 ≠ 0`. -/
theorem aggregate_does_not_give_individual₈ (γ : ℝ) (hγ : γ ≠ 0) :
    ((e₂₈ ⟨3 / 4, γ⟩).im + (e₂₈ (mate₈ ⟨3 / 4, γ⟩)).im = 0) ∧
    ((e₂₈ ⟨3 / 4, γ⟩).im ≠ 0) := by
  refine ⟨pair_imaginary_parts_cancel _, ?_⟩
  unfold e₂₈
  simp only [Complex.mul_im, Complex.sub_im, Complex.one_im, zero_sub, mul_neg,
    Complex.sub_re, Complex.one_re, ne_eq]
  intro h
  exact hγ (by linarith)

/-! ## §130.4  El balance -/

/-- **[O] EL BALANCE DE §130.**

    | paso | | estatuto |
    |---|---|---|
    | 1–4 | centro, identidad, `γ≠0`, solución única | **`[P]`** |
    | **5** | **`e₂(mate) = conj(e₂)`** | **`[P]`** |
    | **6** | **`Σ Im(e₂) = 0`, automático** | **`[P]`** |
    | 7 | `Im(e₂) = 0` para cada uno | **es `E`** |

    **`E` no es una sexta pieza de otra clase**: es el paso `6` con el
    cuantificador dentro en vez de fuera.  Y el agregado está probado
    SIN suponerlo.

    **Nada de esto prueba `E`.**  Cierra el sistema y sitúa el salto
    donde está: en el cuantificador. -/
theorem the_balance_of_section_130 (ρ : ℂ) (γ : ℝ) (hγ : γ ≠ 0) :
    (e₂₈ (mate₈ ρ) = (starRingEnd ℂ) (e₂₈ ρ)) ∧
    ((e₂₈ ρ).im + (e₂₈ (mate₈ ρ)).im = 0) ∧
    ((e₂₈ ⟨3 / 4, γ⟩).im ≠ 0) :=
  ⟨mate_carries_the_conjugate ρ, pair_imaginary_parts_cancel ρ,
   (aggregate_does_not_give_individual₈ γ hγ).2⟩

/-
