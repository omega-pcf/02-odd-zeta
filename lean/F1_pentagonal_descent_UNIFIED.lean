   las dos resoluciones son una
   ===================================================================== -/


/-! ## 1.  El entrelazador, y que separar es lo mismo de los dos lados -/

/-- La fibra vista como exponente de `ζ₆`. -/
def fibreIdx (i : JointIdx) : Nat := toMu6 (i.2.1, i.2.2)

/-- **[P] SOBRE LA FIBRA SOLA: `toMu6` es inyectivo.** -/
theorem toMu6_inj (d e : Deck) (h : toMu6 d = toMu6 e) : d = e := by
  obtain ⟨x1, y1⟩ := d
  obtain ⟨x2, y2⟩ := e
  revert h
  cases x1 <;> cases y1 <;> cases x2 <;> cases y2 <;> decide

/-- **[P] LAS DOS CONDICIONES DE SEPARACIÓN SON LA MISMA.**  Dos índices
    conjuntos tienen la misma fibra si y sólo si tienen el mismo color y la
    misma orientación.  `toMu6` es el entrelazador y es biyectivo. -/
theorem same_fibre_iff_same_colour_and_orientation (i j : JointIdx) :
    fibreIdx i = fibreIdx j ↔ (i.2.1 = j.2.1 ∧ i.2.2 = j.2.2) := by
  constructor
  · intro h
    have := toMu6_inj (i.2.1, i.2.2) (j.2.1, j.2.2) h
    exact ⟨congrArg Prod.fst this, congrArg Prod.snd this⟩
  · intro h
    obtain ⟨hc, ho⟩ := h
    simp [fibreIdx, hc, ho]

/-- **[P] LA RUTA POR EL DUAL, SOBRE EL ÍNDICE CONJUNTO.**  Nivel más
    exponente de fibra separan `𝒥`. -/
theorem dual_route_separates (i j : JointIdx)
    (hlev : i.1 = j.1) (hfib : fibreIdx i = fibreIdx j) : i = j := by
  obtain ⟨hc, ho⟩ := (same_fibre_iff_same_colour_and_orientation i j).mp hfib
  obtain ⟨s1, x1, y1⟩ := i
  obtain ⟨s2, x2, y2⟩ := j
  simp at hlev hc ho
  subst hlev; subst hc; subst ho
  rfl

/-- **[P] Y LA RUTA POR LOS OBSERVABLES DA EXACTAMENTE ESO.**  Con espectros
    inyectivos, la terna reproduce la hipótesis de `dual_route_separates`. -/
theorem observable_route_gives_the_dual_hypotheses
    {R : Type} (E : Nat → R) (C : Colour → R) (O : Orient → R)
    (hE : ∀ a b : Nat, E a = E b → a = b)
    (hC : ∀ a b : Colour, C a = C b → a = b)
    (hO : ∀ a b : Orient, O a = O b → a = b)
    (i j : JointIdx)
    (h1 : symH E i = symH E j) (h2 : symC C i = symC C j)
    (h3 : symO O i = symO O j) :
    i.1 = j.1 ∧ fibreIdx i = fibreIdx j := by
  have hc : i.2.1 = j.2.1 := hC _ _ h2
  have ho : i.2.2 = j.2.2 := hO _ _ h3
  refine ⟨hE _ _ h1, ?_⟩
  exact (same_fibre_iff_same_colour_and_orientation i j).mpr ⟨hc, ho⟩

/-! ## 2.  Qué tipo de evidencia es esto -/

/-- **[P⊕] LAS DOS RUTAS SON UNA, EN DOS COORDENADAS.**

    (a) `toMu6` es biyectivo `Colour × Orient → ℤ/6`;
    (b) tener la misma fibra ⟺ tener el mismo color y la misma orientación;
    (c) luego la ruta por el dual y la ruta por los observables tienen
        hipótesis equivalentes y la misma conclusión.

    **Lo que esto NO es:** dos pruebas independientes que se corroboran.  Las
    dos descansan en que la fibra es un `ℤ/6`-torsor, y `toMu6` las traduce.
    Decir que coinciden y llamar a eso confirmación sería contar dos veces.

    **Lo que sí es:** la terna `(H, Ω̂, W)` no es una construcción ajustada al
    resultado —es el dual de `μ₆` escrito en las dos coordenadas de la fibra—.
    La canonicidad de la transformada viene de otro sitio y ya está
    demostrada: `the_deck_group_is_the_eisenstein_unit_group`, que lleva el
    generador distinguido al generador distinguido. -/
theorem the_two_routes_are_one :
    (∀ d : Deck, ofMu6 (toMu6 d) = d) ∧
    (∀ i j : JointIdx, fibreIdx i = fibreIdx j ↔ (i.2.1 = j.2.1 ∧ i.2.2 = j.2.2)) ∧
    (∀ i j : JointIdx, i.1 = j.1 → fibreIdx i = fibreIdx j → i = j) :=
  ⟨toMu6_bijective.1, same_fibre_iff_same_colour_and_orientation, dual_route_separates⟩



/- =====================================================================
   BLOQUE 14 de 16 - PCF_mra_obstruction
   la mitad aritmetica de la obstruccion MRA
   ===================================================================== -/


/-! ## 1.  Ningún entero es una dilatación admisible -/

/-- **[P] `d² = d + 1` NO TIENE SOLUCIÓN EN `ℤ`.**

    El kernel lo tiene sobre `ℕ`; la condición de retículo de un MRA entrega
    `a ∈ ℤ`, luego hace falta el enunciado sobre `ℤ`, negativos incluidos.

    Tres tramos: para `d ≤ -1` el cuadrado es `≥ 1` y `d + 1 ≤ 0`; para
    `d ∈ {0,1}` se comprueba; para `d ≥ 2` vale `d·d ≥ 2d = d + d ≥ d + 2`. -/
theorem no_int_dilation : ∀ d : Int, d * d ≠ d + 1 := by
  intro d h
  rcases Int.lt_or_le d 0 with hn | hp
  · have h1 : (1 : Int) ≤ -d := by omega
    have hsq : (1 : Int) * 1 ≤ (-d) * (-d) :=
      Int.mul_le_mul h1 h1 (by omega) (by omega)
    have e : (-d) * (-d) = d * d := Int.neg_mul_neg d d
    omega
  · rcases Int.lt_or_le d 2 with hs | hb
    · have : d = 0 ∨ d = 1 := by omega
      rcases this with rfl | rfl <;> omega
    · have hsq : 2 * d ≤ d * d :=
        Int.mul_le_mul hb (Int.le_refl d) (by omega) (by omega)
      omega

/-- **[P] Y NINGÚN NATURAL TAMPOCO.**  (Reexposición de `no_nat_closure`, para
    que la proposición del paper nombre las dos formas en un solo sitio.) -/
theorem no_nat_dilation : ∀ r : Nat, r * r ≠ r + 1 := no_nat_closure

/-- **[P] NI NINGÚN RACIONAL.**  `no_golden_rational` escrito como lo que la
    obstrucción necesita: no hay `m/f` con `f ≥ 1` que cumpla `x² = x + 1`. -/
theorem no_rat_dilation : ∀ f m : Nat, 0 < f → m * m ≠ m * f + f * f :=
  no_golden_rational

/-! ## 2.  La obstrucción, y qué mitad está compilada -/

/-- **[P⊕] LA MITAD ARITMÉTICA DE `prop:nomra`, COMPLETA.**

    (a) ningún entero cumple `d² = d + 1`;
    (b) ningún natural;
    (c) ningún racional.

    Con la condición de retículo —que es el paso clásico de teoría de MRA y se
    cita, no se demuestra aquí— esto cierra la proposición: la reducción
    entrega `a ∈ ℤ`, y (a) dice que ahí no hay nada.

    ALCANCE.  La reducción `V₀ ⊆ V₁ ⟹ aℤ ⊆ ℤ ⟹ a ∈ ℤ` es tier (L) y sigue
    sin formalizar; formalizarla exigiría espacios de funciones y no es
    aritmética.  Lo que aquí se afirma es exactamente lo que aquí se demuestra:
    que una vez reducida, la obstrucción es esta y no tiene escapatoria. -/
theorem the_arithmetic_half_of_the_MRA_obstruction :
    (∀ d : Int, d * d ≠ d + 1) ∧
    (∀ r : Nat, r * r ≠ r + 1) ∧
    (∀ f m : Nat, 0 < f → m * m ≠ m * f + f * f) :=
  ⟨no_int_dilation, no_nat_dilation, no_rat_dilation⟩



/- =====================================================================
   BLOQUE 15 de 16 - PCF_conventions
   completitud, Parseval, convolucion, incertidumbre, y por que phi
   ===================================================================== -/


/-! ## 1.  La relación de completitud (ortogonalidad en la otra variable) -/

/-- **[P] COMPLETITUD.**  `Σ_k χ_k(m)·conj(χ_k(n)) = 6·δ_{mn}`.

    `orthogonality` suma sobre la fibra y es la independencia de los
    caracteres; ésta suma sobre el dual y es que los seis BASTAN.  Las dos
    juntas son lo que hace de la matriz de caracteres una matriz cuadrada
    invertible.  Las 36 entradas. -/
theorem completeness :
    ∀ m ∈ [0,1,2,3,4,5], ∀ n ∈ [0,1,2,3,4,5],
      sum6 (fun k => Eis.mul (chi k m) (Eis.conj (chi k n)))
        = (if m = n then Eis.smul 6 Eis.one else Eis.zero) := by
  decide

/-! ## 2.  Linealidad del análisis -/

/-- **[P] ADITIVIDAD.**  `(f + g)^ = f̂ + ĝ`. -/
theorem analysis_additive (f g : Nat → Eis) (k : Nat) :
    analysis (fun n => Eis.add (f n) (g n)) k
      = Eis.add (analysis f k) (analysis g k) := by
  unfold analysis sum6
  simp [Eis.add, Eis.mul, Int.add_mul]
  refine ⟨by omega, by omega⟩

/-- **[P] HOMOGENEIDAD ENTERA.**  `(c·f)^ = c·f̂` para `c ∈ ℤ`. -/
theorem analysis_smul (c : Int) (f : Nat → Eis) (k : Nat) :
    analysis (fun n => Eis.smul c (f n)) k = Eis.smul c (analysis f k) := by
  unfold analysis sum6
  simp [Eis.smul, Eis.add, Eis.mul, Int.mul_add, Int.mul_sub, Int.mul_assoc]

/-! ## 3.  La base de deltas -/

/-- `δ_j`, la delta en el punto `j` de la fibra. -/
def delta (j : Nat) : Nat → Eis := fun n => if n = j then Eis.one else Eis.zero

/-- **[P] PARSEVAL SOBRE LA BASE.**  `Σ_k δ̂_m(k)·conj(δ̂_n(k)) = 6·δ_{mn}`.

    Con la bilinealidad de §2 —el paso clásico, que se cita— esto da Parseval
    para toda `f`: `Σ_k N(f̂(k)) = 6·Σ_n N(f(n))`. -/
theorem parseval_on_the_basis :
    ∀ m ∈ [0,1,2,3,4,5], ∀ n ∈ [0,1,2,3,4,5],
      sum6 (fun k => Eis.mul (analysis (delta m) k) (Eis.conj (analysis (delta n) k)))
        = (if m = n then Eis.smul 6 Eis.one else Eis.zero) := by
  decide

/-- `(f ∗ g)(n) = Σ_m f(m)·g(n − m)`, la diferencia tomada en `μ₆`. -/
def conv (f g : Nat → Eis) (n : Nat) : Eis :=
  sum6 (fun m => Eis.mul (f m) (g ((n + 6 - m) % 6)))

/-- **[P] CONVOLUCIÓN SOBRE LA BASE.**  `(δ_i ∗ δ_j)^(k) = δ̂_i(k)·δ̂_j(k)`.

    Con la bilinealidad, el teorema de convolución para toda `f`, `g`.  Es lo
    que vuelve utilizable a la transformada: filtrar es multiplicar. -/
theorem convolution_on_the_basis :
    ∀ i ∈ [0,1,2,3,4,5], ∀ j ∈ [0,1,2,3,4,5], ∀ k ∈ [0,1,2,3,4,5],
      analysis (conv (delta i) (delta j)) k
        = Eis.mul (analysis (delta i) k) (analysis (delta j) k) := by
  decide

/-! ## 3b.  Parseval, PARA TODA `f` — derivada de la inversión -/

/-- Suma puntual de dos funciones de la fibra. -/
def fadd (g h : Nat → Eis) : Nat → Eis := fun n => Eis.add (g n) (h n)

@[simp] theorem fadd_def (g h : Nat → Eis) : fadd g h = fun n => Eis.add (g n) (h n) := rfl

/-- Producto por un escalar de `ℤ[ω]`. -/
def fsmul (c : Eis) (g : Nat → Eis) : Nat → Eis := fun n => Eis.mul c (g n)

/-- La forma sesquilineal del dual: `⟨f, g⟩ = Σ_k f̂(k)·conj(ĝ(k))`. -/
def sesq (f g : Nat → Eis) : Eis :=
  sum6 (fun k => Eis.mul (analysis f k) (Eis.conj (analysis g k)))

/-- La forma sesquilineal de la fibra: `Σ_n f(n)·conj(g(n))`. -/
def inner (f g : Nat → Eis) : Eis :=
  sum6 (fun n => Eis.mul (f n) (Eis.conj (g n)))

/-- `Eis.mul` distribuye sobre `Eis.add`. -/
theorem mul_add_left (x y z : Eis) :
    Eis.mul x (Eis.add y z) = Eis.add (Eis.mul x y) (Eis.mul x z) := by
  simp [Eis.mul, Eis.add, Int.mul_add]
  refine ⟨by omega, by omega⟩

/-- `Eis.add` es asociativa y conmutativa. -/
theorem eadd_comm (x y : Eis) : Eis.add x y = Eis.add y x := by
  simp [Eis.add]; omega

theorem eadd_assoc (x y z : Eis) :
    Eis.add (Eis.add x y) z = Eis.add x (Eis.add y z) := by
  simp [Eis.add]; omega

/-- `conj` es aditiva. -/
theorem conj_add (x y : Eis) : Eis.conj (Eis.add x y)
    = Eis.add (Eis.conj x) (Eis.conj y) := by
  simp [Eis.conj, Eis.add]; omega

/-- **[P] LA TRANSFORMADA DE UNA DELTA ES UN CARÁCTER.**  `conj(δ̂_n(k)) = χ_k(n)`.
    De aquí sale todo lo demás sin un solo expandido. -/
theorem conj_analysis_delta (n : Nat) (hn : n < 6) (k : Nat) :
    Eis.conj (analysis (delta n) k) = chi k n := by
  match n, hn with
  | 0,_ => simp [analysis, sum6, delta, Eis.mul, Eis.add, Eis.conj, Eis.one, Eis.zero]
  | 1,_ => simp [analysis, sum6, delta, Eis.mul, Eis.add, Eis.conj, Eis.one, Eis.zero]
  | 2,_ => simp [analysis, sum6, delta, Eis.mul, Eis.add, Eis.conj, Eis.one, Eis.zero]
  | 3,_ => simp [analysis, sum6, delta, Eis.mul, Eis.add, Eis.conj, Eis.one, Eis.zero]
  | 4,_ => simp [analysis, sum6, delta, Eis.mul, Eis.add, Eis.conj, Eis.one, Eis.zero]
  | 5,_ => simp [analysis, sum6, delta, Eis.mul, Eis.add, Eis.conj, Eis.one, Eis.zero]
  | (m+6),h => exact absurd h (by omega)

/-- **[P] PARSEVAL CONTRA UNA DELTA — Y ES LA INVERSIÓN.**

        `⟨f, δ_n⟩ = síntesis(análisis f)(n) = 6·f(n)`

    Ésta es la observación que evita todo cálculo: contra una delta, la forma
    sesquilineal **es** la síntesis, y la síntesis ya está invertida
    (`inversion`).  Parseval no es un expandido nuevo: es la inversión leída
    en la otra variable. -/
theorem sesq_delta (f : Nat → Eis) (n : Nat) (hn : n < 6) :
    sesq f (delta n) = Eis.smul 6 (f n) := by
  have h : sesq f (delta n) = synthesis (analysis f) n := by
    simp only [sesq, synthesis, sum6, conj_analysis_delta n hn]
  rw [h, inversion f n hn]

/-! ### De la delta a toda `g`: el intercambio de sumas

  La ruta que sí cierra.  El obstáculo nunca fue matemático: era que `omega`
  no emparejaba átomos al expandir productos de `Eis` a componentes enteras.
  La solución es no expandirlos: se demuestra el intercambio de sumas con el
  sumando como ÁTOMO OPACO `F k n`, donde sólo hay sumas y `omega` lo cierra
  sin ver un solo producto.  Todo lo demás son reescrituras de seis términos.
-/

/-- `conj` conmuta con la suma de seis. -/
theorem conj_sum6 (F : Nat → Eis) :
    Eis.conj (sum6 F) = sum6 (fun n => Eis.conj (F n)) := by
  simp [sum6, Eis.conj, Eis.add]; refine ⟨by omega, by omega⟩

/-- `conj` es multiplicativa. -/
theorem conj_mul (x y : Eis) :
    Eis.conj (Eis.mul x y) = Eis.mul (Eis.conj x) (Eis.conj y) := by
  simp [Eis.conj, Eis.mul, Int.mul_sub, Int.sub_mul]
  refine ⟨by omega, by omega⟩

/-- El producto distribuye sobre la suma de seis. -/
theorem mul_sum6_left (a : Eis) (F : Nat → Eis) :
    Eis.mul a (sum6 F) = sum6 (fun n => Eis.mul a (F n)) := by
  simp [sum6, Eis.mul, Eis.add, Int.mul_add]
  refine ⟨by omega, by omega⟩

/-- **[P] EL INTERCAMBIO DE SUMAS.**  Con el sumando opaco: sólo hay sumas. -/
theorem sum6_swap (F : Nat → Nat → Eis) :
    sum6 (fun k => sum6 (fun n => F k n)) = sum6 (fun n => sum6 (fun k => F k n)) := by
  simp [sum6, Eis.add]; refine ⟨by omega, by omega⟩

theorem emul_comm (x y : Eis) : Eis.mul x y = Eis.mul y x := by
  simp [Eis.mul, Int.mul_comm]; omega

theorem emul_left_comm (x y z : Eis) :
    Eis.mul x (Eis.mul y z) = Eis.mul y (Eis.mul x z) := by
  simp [Eis.mul, Int.mul_add, Int.mul_sub,
        Int.mul_comm, Int.mul_left_comm]
  refine ⟨by omega, by omega⟩

theorem mul_smul_right (x y : Eis) (c : Int) :
    Eis.mul x (Eis.smul c y) = Eis.smul c (Eis.mul x y) := by
  simp [Eis.mul, Eis.smul, Int.mul_comm, Int.mul_left_comm,
        Int.mul_sub, Int.mul_add]

theorem smul_sum6 (c : Int) (F : Nat → Eis) :
    sum6 (fun n => Eis.smul c (F n)) = Eis.smul c (sum6 F) := by
  simp [sum6, Eis.smul, Eis.add, Int.mul_add]

/-- **[P] EL CONJUGADO DEL ANÁLISIS.**  `conj(ĝ(k)) = Σ_n conj(g(n))·χ_k(n)`. -/
theorem conj_analysis (g : Nat → Eis) (k : Nat) :
    Eis.conj (analysis g k) = sum6 (fun n => Eis.mul (Eis.conj (g n)) (chi k n)) := by
  simp only [analysis, conj_sum6, conj_mul, Eis.conj_conj]

/-- **[P] PARSEVAL, FORMA SESQUILINEAL, PARA TODA `f` Y TODA `g`.**

        `Σ_k f̂(k)·conj(ĝ(k))  =  6 · Σ_n f(n)·conj(g(n))`

    Sin hipótesis, sin caso base y sin expandido de doce variables.  La prueba
    es la clásica y ahora está entera: se abre `conj(ĝ(k))` como suma sobre la
    fibra, se intercambian las dos sumas, y la suma interior sobre el dual es
    la SÍNTESIS, que la inversión ya evalúa.

    **Parseval es la inversión, leída en la otra variable.** -/
theorem parseval_sesquilinear (f g : Nat → Eis) :
    sesq f g = Eis.smul 6 (inner f g) := by
  have step1 : sesq f g
      = sum6 (fun k => sum6 (fun n =>
          Eis.mul (Eis.conj (g n)) (Eis.mul (analysis f k) (chi k n)))) := by
    simp only [sesq, conj_analysis, mul_sum6_left, emul_left_comm]
  have step2 : sesq f g
      = sum6 (fun n => Eis.mul (Eis.conj (g n)) (synthesis (analysis f) n)) := by
    rw [step1, sum6_swap]
    simp only [synthesis, mul_sum6_left]
  rw [step2]
  simp only [inversion f 0 (by omega), inversion f 1 (by omega),
             inversion f 2 (by omega), inversion f 3 (by omega),
             inversion f 4 (by omega), inversion f 5 (by omega),
             sum6, mul_smul_right]
  simp only [inner, sum6, emul_comm (Eis.conj (g _)) (f _)]
  simp [Eis.smul, Eis.add]; refine ⟨by omega, by omega⟩

/-- **[P] PARSEVAL, FORMA CUADRÁTICA.**  `Σ_k N(f̂(k)) = 6·Σ_n N(f(n))` para
    toda `f`: la anterior con `g = f`, en la parte real, que es donde vive la
    norma de Eisenstein `N(x) = (x·conj x).a`. -/
theorem parseval (f : Nat → Eis) : (sesq f f).a = 6 * (inner f f).a := by
  rw [parseval_sesquilinear f f]; rfl

/-! ## 4.  Incertidumbre: el caso de igualdad de Donoho–Stark en `μ₆` -/

/-- **[P] UNA DELTA NECESITA LOS SEIS CARACTERES.**  Para cada punto `j` de la
    fibra, los seis coeficientes de `δ_j` son no nulos.

    `|sop δ_j| = 1` y `|sop δ̂_j| = 6`, luego `|sop f|·|sop f̂| = 6 = |μ₆|`: el
    caso de igualdad de Donoho–Stark.

    **Y ésta es la tesis del paper por la ruta convencional.**  Resolver un
    solo punto de la fibra exige los seis componentes.  Con el componente
    trivial solo —que es Fourier clásico— no se puede, y no por falta de
    resolución sino por incertidumbre. -/
theorem delta_needs_all_six :
    ∀ j ∈ [0,1,2,3,4,5], ∀ k ∈ [0,1,2,3,4,5],
      analysis (delta j) k ≠ Eis.zero := by
  decide

/-- **[P] Y EL SOPORTE DE LA DELTA ES UNO.**  Junto con lo anterior, el
    producto de soportes es exactamente `6`. -/
theorem delta_support_is_one :
    ∀ j ∈ [0,1,2,3,4,5], ∀ n ∈ [0,1,2,3,4,5],
      (delta j n ≠ Eis.zero) ↔ n = j := by
  decide

/-- **[P] LA OTRA CARA.**  Si sólo sobrevive el coeficiente `k = 0`, la
    síntesis es constante en la fibra: `|sop f̂| = 1` fuerza `|sop f| = 6` o
    `f = 0`.  Es `thm:k0` dicho con soportes, y es la misma desigualdad leída
    del otro lado. -/
theorem trivial_coefficient_alone_is_constant :
    ∀ n ∈ [0,1,2,3,4,5], ∀ m ∈ [0,1,2,3,4,5],
      synthesis (fun k => if k = 0 then Eis.one else Eis.zero) n
        = synthesis (fun k => if k = 0 then Eis.one else Eis.zero) m := by
  decide

/-! ## 4b.  Por qué `φ` y no otro irracional: los convergentes SON las potencias

  QUÉ FALTABA.  El paper demuestra que `φ` es irracional y nunca dice que es
  el irracional EXTREMAL: el peor aproximable por racionales (Hurwitz, y la
  fracción continua `[1;1,1,…]`).  Eso importa, porque convierte al objeto de
  este paper en la instancia más aguda del fenómeno y no en un ejemplo
  cualquiera.

  Y la extremalidad tiene la MISMA raíz aritmética que todo lo demás aquí:

        φ = 1 + 1/φ     ⟺     φ² = φ + 1     ⟺     `M_char`

  la fracción continua de puros unos es la identidad generadora del toro de
  aplicación.  Abajo se exhibe el puente que lo hace literal: los numeradores
  y denominadores de los convergentes de `φ` son las ENTRADAS de `Mⁿ`.
-/

/-- **[P] LOS CONVERGENTES DE `φ` SON LAS ENTRADAS DE `Mⁿ`.**

    `Mⁿ = ⟨q_n, p_n, p_n, p_n + q_n⟩` con `(p_n, q_n) = (F_n, F_{n-1})`, luego
    el convergente `n`-ésimo de `[1;1,1,…]` es el cociente de dos entradas de
    la misma matriz.  La aproximación diofántica de `φ` y la dinámica de `M`
    no son dos temas: son el mismo objeto leído dos veces. -/
theorem convergents_are_the_entries_of_M_pow (n : Nat) :
    Mat2.npow M n = ⟨(coef n).2, (coef n).1, (coef n).1, (coef n).1 + (coef n).2⟩ := by
  rw [npow_eq_lin n]; rfl

/-- **[P] Y SON FIBONACCI, EN LAS DOS COORDENADAS.**  `(p₀,q₀) = (0,1)` y
    `p_{n+1} = p_n + q_n`, `q_{n+1} = p_n`: la recursión de los convergentes de
    la fracción continua de puros unos. -/
theorem convergent_recursion (n : Nat) :
    (coef (n+1)).1 = (coef n).1 + (coef n).2 ∧ (coef (n+1)).2 = (coef n).1 :=
  ⟨rfl, rfl⟩

/-- **[P⊕] UNA IDENTIDAD, TRES LECTURAS.**

    (a) `M² = M + I` — la identidad generadora del toro de aplicación;
    (b) `φ = 1 + 1/φ` — la fracción continua `[1;1,1,…]`, que es lo que hace
        de `φ` el peor aproximable por racionales (Hurwitz, tier L);
    (c) `m² ≠ mf + f²` para `f ≥ 1` — la forma norma sin ceros no triviales,
        que es lo que ciega a Fourier.

    Son la misma ecuación.  Por eso este objeto no es un ejemplo entre muchos:
    el número que peor se deja aproximar es exactamente el que hace fallar a la
    transformada emparejada con las traslaciones. -/
theorem one_identity_three_readings :
    (Mat2.mul M M = Mat2.add M Mat2.one) ∧
    (∀ n : Nat, Mat2.npow M n
        = ⟨(coef n).2, (coef n).1, (coef n).1, (coef n).1 + (coef n).2⟩) ∧
    (∀ f m : Nat, 0 < f → m * m ≠ m * f + f * f) :=
  ⟨M_char, convergents_are_the_entries_of_M_pow, no_golden_rational⟩

/-! ## 4c.  Por qué `φ` y no otra matriz: el discriminante mínimo

    `convergents_are_the_entries_of_M_pow` dice por qué `φ` y no otro
    irracional.  Esto dice por qué **esta matriz** y no otra del mismo tipo.

    El discriminante `Δ = t² − 4d` de un `M ∈ GL₂(ℤ)` hiperbólico es `> 0` y
    no cuadrado.  El mínimo sobre toda la clase es `5`, y lo alcanzan
    exactamente `(t,d) = (±1,−1)` y `(t,d) = (±3,+1)`.  La segunda es el
    cuadrado de la primera —`M²` preserva la orientación, y en efecto pierde
    el factor `ℤ/2`, quedando en `μ₃`— así que la primitiva es la primera:
    es el `M` de este paper.

    Con `det M = −1` y traza impar, §3c del bloque 11 cierra todo primo
    impar, de modo que el grupo es `μ₆` = el grupo **completo** de unidades de
    `ℤ[ω]`, y no un subgrupo de índice dos.  De las dos matrices de
    discriminante mínimo, ésta es la que lo tiene completo. -/

/-- **[P] `Δ = 5` ES EL MÍNIMO DE LA CLASE HIPERBÓLICA, Y LO ALCANZAN
    EXACTAMENTE DOS CONJUGACIONES.** -/
theorem five_is_the_minimal_discriminant :
    disc 1 (-1) = 5 ∧ disc (-1) (-1) = 5 ∧ disc 3 1 = 5 ∧ disc (-3) 1 = 5 ∧
    disc 2 (-1) = 8 ∧ disc 4 1 = 12 ∧ disc 3 (-1) = 13 := by
  refine ⟨by decide, by decide, by decide, by decide, by decide, by decide, by decide⟩

/-- **[P⊕] Y EL `M` DE ESTE PAPER ES LA PRIMITIVA DE ESE MÍNIMO.**

    `M = [[0,1],[1,1]]`: traza `1`, determinante `−1`, `Δ = 5`.
    Traza impar, luego el 2 es inerte (`two_inert_of_trace_odd`) y
    `Δ ≡ 5 (mod 8)`; `det M = −1`, luego la orientación está presente y §3c
    cierra todo primo impar; luego el grupo es `μ₆`, el máximo de la clase
    exacta y el grupo completo de unidades de `ℤ[ω]`.

    `thm:worst` dice que `φ` es extremal para la aproximación; esto dice que
    la misma matriz es extremal para la construcción, y `Δ = 5` es la
    cantidad de la que hablan los dos enunciados. -/
theorem the_paper_object_is_the_primitive_minimum :
    disc 1 (-1) = 5 ∧
    (1 : Int) % 2 = 1 ∧
    (∀ x : Int, genPolyVal 1 (-1) x % 2 ≠ 0) ∧
    disc 1 (-1) % 8 = 5 ∧
    deckOrd 3 = 6 ∧
    inExactClass 6 ∧
    (∀ n : Nat, inExactClass n → n ≤ 6) := by
  refine ⟨by decide, by decide, ?_, by decide, by decide, ?_, exact_class_le_six⟩
  · exact two_inert_of_trace_odd 1 (-1) (by decide) (by decide)
  · unfold inExactClass; omega

/-! ## 5.  La conjunción -/

/-- **[P⊕] EL APARATO CONVENCIONAL.**

    (a) completitud, dual de la ortogonalidad: los seis caracteres bastan;
    (b) linealidad del análisis;
    (c) Parseval sobre la base;
    (d) convolución sobre la base;
    (e) el caso de igualdad de Donoho–Stark: una delta de la fibra tiene
        transformada de soporte pleno.

    Con (e), la tesis del paper queda dicha dos veces por caminos distintos:
    `thm:blind` la obtiene del torsor, la incertidumbre la obtiene del tamaño
    del grupo. -/
theorem the_conventional_apparatus :
    (∀ m ∈ [0,1,2,3,4,5], ∀ n ∈ [0,1,2,3,4,5],
      sum6 (fun k => Eis.mul (chi k m) (Eis.conj (chi k n)))
        = (if m = n then Eis.smul 6 Eis.one else Eis.zero)) ∧
    (∀ f g : Nat → Eis, ∀ k : Nat,
      analysis (fun n => Eis.add (f n) (g n)) k
        = Eis.add (analysis f k) (analysis g k)) ∧
    (∀ i ∈ [0,1,2,3,4,5], ∀ j ∈ [0,1,2,3,4,5], ∀ k ∈ [0,1,2,3,4,5],
      analysis (conv (delta i) (delta j)) k
        = Eis.mul (analysis (delta i) k) (analysis (delta j) k)) ∧
    (∀ j ∈ [0,1,2,3,4,5], ∀ k ∈ [0,1,2,3,4,5],
      analysis (delta j) k ≠ Eis.zero) :=
  ⟨completeness, analysis_additive, convolution_on_the_basis, delta_needs_all_six⟩



