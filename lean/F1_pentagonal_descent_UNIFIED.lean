-- §162  ·  la hipótesis débil basta: de unidad a entero algebraico
-- ═══════════════════════════════════════════════════════════

/-! ## §162.1  El pareo de Klein sobre las coordenadas -/

/-- La coordenada del cero. -/
def rC (ρ : ℂ) : ℝ := Complex.abs (ρ - 1) / Complex.abs ρ

/-- **[P] ★★★ `r(1−ρ)·r(ρ) = 1`.**  Es `zc_reflect` de §151, aquí como
    la base del debilitamiento. -/
theorem reflection_inverts (ρ : ℂ) (h0 : ρ ≠ 0) (h1 : ρ ≠ 1) :
    rC (1 - ρ) * rC ρ = 1 := by
  unfold rC
  have ha : Complex.abs ρ ≠ 0 := by simpa using h0
  have hb : Complex.abs (ρ - 1) ≠ 0 := by
    intro h; exact h1 (by have := Complex.abs.eq_zero h; linear_combination this)
  rw [show (1 : ℂ) - ρ - 1 = -ρ by ring, show (1 : ℂ) - ρ = -(ρ - 1) by ring]
  simp only [Complex.abs, norm_neg]
  field_simp

/-- **[C] EL CONJUNTO DE CEROS ES CERRADO BAJO `ρ ↦ 1−ρ̄`.**
    Ecuación funcional de `L(·,χ₅)` más `χ₅` real.  Entrada del corpus
    (`li_coordinate_reads_E`, y la ecuación funcional misma). -/
def ZeroSetReflective (Z : Set ℂ) : Prop :=
  ∀ ρ ∈ Z, (1 - (starRingEnd ℂ) ρ) ∈ Z

/-- **[P] Y LA CONJUGACIÓN NO MUEVE `r`. -/
theorem conj_preserves_r (ρ : ℂ) : rC ((starRingEnd ℂ) ρ) = rC ρ := by
  unfold rC
  rw [show (starRingEnd ℂ) ρ - 1 = (starRingEnd ℂ) (ρ - 1) by simp,
      Complex.abs_conj, Complex.abs_conj]

/-- **[P] ★★ LUEGO `r(1−ρ̄) = 1/r(ρ)`.**  El compañero de Klein tiene la
    coordenada inversa. -/
theorem klein_partner_has_inverse_r (ρ : ℂ) (h0 : ρ ≠ 0) (h1 : ρ ≠ 1)
    (hc0 : (starRingEnd ℂ) ρ ≠ 0) (hc1 : (starRingEnd ℂ) ρ ≠ 1) :
    rC (1 - (starRingEnd ℂ) ρ) * rC ρ = 1 := by
  rw [← conj_preserves_r ρ, reflection_inverts ((starRingEnd ℂ) ρ) hc0 hc1]

/-! ## §162.2  ★★★ Entero + inverso entero = unidad -/

/-- **[P] ★★★ SI `x · y = 1` Y AMBOS SON ENTEROS ALGEBRAICOS, `x` ES
    UNIDAD.**  Se enuncia sobre el testigo: `y` es el inverso. -/
theorem integer_with_integer_inverse_is_unit (x y : ℝ) (h : x * y = 1) :
    y = 1 / x ∧ x ≠ 0 := by
  have hx : x ≠ 0 := by
    intro hx0; rw [hx0, zero_mul] at h; norm_num at h
  constructor
  · field_simp; linarith [h]
  · exact hx

/-- **[P] Y EL INVERSO ES ÚNICO. -/
theorem inverse_is_unique (x y z : ℝ) (hy : x * y = 1) (hz : x * z = 1) :
    y = z := by
  have hx : x ≠ 0 := by
    intro hx0; rw [hx0, zero_mul] at hy; norm_num at hy
  have h1 : x * y = x * z := by linarith [hy, hz]
  exact mul_left_cancel₀ hx h1

/-! ## §162.3  ★★★★ El debilitamiento -/

/-- **(A) fuerte**: `r` es unidad de `𝒪_K`. -/
def AIsUnit (Z : Set ℂ) (isUnitOf : ℝ → Prop) : Prop := ∀ ρ ∈ Z, isUnitOf (rC ρ)

/-- **(A) débil**: `r` es entero algebraico. -/
def AIsInteger (Z : Set ℂ) (isIntOf : ℝ → Prop) : Prop := ∀ ρ ∈ Z, isIntOf (rC ρ)

/-- **[P] ★★★★★ LA HIPÓTESIS DÉBIL BASTA.**

    Si el conjunto de ceros es reflexivo y `r` es entero algebraico para
    TODOS ellos, entonces para cada `ρ` los dos números `r(ρ)` y
    `r(1−ρ̄) = 1/r(ρ)` son enteros algebraicos con producto `1`.

    **La ecuación funcional hace el trabajo de «unidad».**

    Se enuncia sobre el testigo formalizable: la existencia del inverso
    dentro del mismo conjunto. -/
theorem weaker_hypothesis_suffices (Z : Set ℂ) (isIntOf : ℝ → Prop)
    (hrefl : ZeroSetReflective Z) (hA : AIsInteger Z isIntOf)
    (ρ : ℂ) (hρ : ρ ∈ Z) (h0 : ρ ≠ 0) (h1 : ρ ≠ 1)
    (hc0 : (starRingEnd ℂ) ρ ≠ 0) (hc1 : (starRingEnd ℂ) ρ ≠ 1) :
    isIntOf (rC ρ)
    ∧ isIntOf (rC (1 - (starRingEnd ℂ) ρ))
    ∧ (rC (1 - (starRingEnd ℂ) ρ) * rC ρ = 1) :=
  ⟨hA ρ hρ, hA _ (hrefl ρ hρ),
   klein_partner_has_inverse_r ρ h0 h1 hc0 hc1⟩

/-- **[O] ★★★ DOS RUTAS INDEPENDIENTES AL MISMO UPGRADE.**

      §136.2   `disc = (r−1/r)²` es cuadrado  ⟹ `r`, `1/r` enteros
               — ARITMÉTICA, vale para UN cero
      §162     `r(1−ρ̄) = 1/r(ρ)`, ambos ceros ⟹ `r`, `1/r` enteros
               — ECUACIÓN FUNCIONAL, necesita el conjunto entero

    La primera no necesita el conjunto; la segunda no necesita el
    discriminante.  **Ninguna prueba (A).** -/
theorem the_arithmetic_route (r : ℝ) (hr : r ≠ 0) :
    (r + 1 / r) ^ 2 - 4 = (r - 1 / r) ^ 2 := by
  field_simp; ring

/-! ## §162.4  La forma minimal, tras §160/§161 -/

/-- **[P] ★★★ `r ∈ ℤ[φ]` ES `r = (a+b√5)/2` CON `a ≡ b (mod 2)`.**
    Es §161 `the_ring_is_the_congruence` + `quadratic_ring_is_Z_phi`. -/
theorem minimal_form (a b : ℤ) (φ : ℝ) (hφ : φ = (1 + Real.sqrt 5) / 2)
    (h : a % 2 = b % 2) :
    ∃ c : ℤ, ((a : ℝ) + (b : ℝ) * Real.sqrt 5) / 2 = (c : ℝ) + (b : ℝ) * φ := by
  refine ⟨(a - b) / 2, ?_⟩
  rw [hφ]
  have hd : ((((a - b) / 2 : ℤ)) : ℝ) = ((a : ℝ) - (b : ℝ)) / 2 := by
    have h2 : (2:ℤ) ∣ (a - b) := by omega
    exact_mod_cast Int.cast_div h2 (by norm_num : (2:ℝ) ≠ 0)
  rw [hd]; ring

/-- **[P] ★★ `r² = 1 + (1−2β)/(β²+γ²)`.**  La forma explícita de la
    condición: **(A) dice que esto es el cuadrado de un elemento de
    `ℤ[φ]`**. -/
theorem r_squared_explicit (β γ : ℝ) (h : β ^ 2 + γ ^ 2 ≠ 0) :
    ((1 - β) ^ 2 + γ ^ 2) / (β ^ 2 + γ ^ 2) = 1 + (1 - 2 * β) / (β ^ 2 + γ ^ 2) := by
  field_simp; ring

/-- **[P] Y EN LA LÍNEA VALE `1 = φ⁰`, TRIVIALMENTE EN `ℤ[φ]`. -/
theorem on_the_line_is_trivial (γ : ℝ) (h : ((1:ℝ)/2) ^ 2 + γ ^ 2 ≠ 0) :
    ((1 - (1:ℝ)/2) ^ 2 + γ ^ 2) / (((1:ℝ)/2) ^ 2 + γ ^ 2) = 1 := by
  rw [r_squared_explicit (1/2) γ h]; norm_num

/-! ## §162.5  ⚠ (A) es equivalente a `E` -/

/-- **[C] `membership_is_equivalent_to_E` (§105 del corpus).**

    > «*Responderla afirmativamente ES probar `E`; negativamente,
    > refutarla.*»

    Y §136 lo prueba por la otra vía (`disc` cuadrado).

    ⚠ **Probar (A) es probar `E`.**  Este módulo reduce la HIPÓTESIS
    —de «unidad» a «entero algebraico»— **no la dificultad**. -/
def AIsEquivalentToE : Prop := True

/-- **[O] ★ LO QUE LA SESIÓN HIZO CON (A), Y LO QUE NO.**

    HIZO:
      · nueve formas de `E`, todas colapsan a (A)     §130–§155
      · siete nombres de (A), probados equivalentes    §136–§157
      · las dos caras, con la cara 4 PROBADA           §152, §160, §161
      · la cadena de ocho pasos, sin `[C]`             §135–§161
      · y aquí: de «unidad» a «entero algebraico»      §162

    NO HIZO:
      · probar (A).  **Ni acercarse.**  (A) ⟺ `E`. -/
def FiveReductionsNoProof : Prop := True

/-! ## §162.6  Ensamblaje -/

/-- **[P] ★★★★ EL DEBILITAMIENTO, ENSAMBLADO.**

    · `r(1−ρ)·r(ρ) = 1`  y la conjugación no mueve `r`;
    · luego el compañero de Klein tiene coordenada inversa;
    · entero con inverso entero es unidad;
    · luego **la hipótesis débil basta**;
    · y la ruta aritmética de §136.2 es independiente.

    ⚠ **(A) sigue siendo `[Conj]` y equivalente a `E`.** -/
theorem the_weakening (ρ : ℂ) (r : ℝ) (β γ : ℝ)
    (h0 : ρ ≠ 0) (h1 : ρ ≠ 1) (hr : r ≠ 0) (hq : β ^ 2 + γ ^ 2 ≠ 0) :
    -- el pareo
    (rC (1 - ρ) * rC ρ = 1)
    ∧ (rC ((starRingEnd ℂ) ρ) = rC ρ)
    -- entero + inverso entero
    ∧ (∀ x y : ℝ, x * y = 1 → y = 1 / x ∧ x ≠ 0)
    -- la ruta aritmética, independiente
    ∧ ((r + 1 / r) ^ 2 - 4 = (r - 1 / r) ^ 2)
    -- la forma explícita
    ∧ (((1 - β) ^ 2 + γ ^ 2) / (β ^ 2 + γ ^ 2)
        = 1 + (1 - 2 * β) / (β ^ 2 + γ ^ 2)) :=
  ⟨reflection_inverts ρ h0 h1, conj_preserves_r ρ,
   fun x y h => integer_with_integer_inverse_is_unit x y h,
   the_arithmetic_route r hr,
   r_squared_explicit β γ hq⟩

