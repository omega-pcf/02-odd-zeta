/-! ## §116.1  Lo que la pata 6 devuelve al aplicarse a un cero -/

/-- **[P] LA PATA 6 APLICA A TODO `s ∈ ℂ`, LUEGO A TODO CERO.**  Y lo
    que devuelve es un BICONDICIONAL, no un valor. -/
theorem leg_six_applies (s : ℂ) : s.re = (1 - s).re ↔ s.re = 1 / 2 := by
  simp only [Complex.sub_re, Complex.one_re, one_div]
  constructor <;> intro h <;> linarith

/-- **[P] APLICADA A UN PUNTO FUERA, DEVUELVE «NO» EN LOS DOS LADOS.**
    No falla ni queda indefinida: se evalúa. -/
theorem leg_six_applies_outside (γ : ℝ) :
    ¬ ((⟨3 / 4, γ⟩ : ℂ).re = (1 - (⟨3 / 4, γ⟩ : ℂ)).re) ∧
    ¬ ((⟨3 / 4, γ⟩ : ℂ).re = 1 / 2) := by
  constructor <;> · simp [Complex.sub_re, Complex.one_re]; norm_num

/-! ## §116.2  Lo que `e₂ = 1` devuelve: una constante -/

/-- **[P] `e₂ = 1` APLICA A TODO `r > 0` Y DEVUELVE SIEMPRE `1`.**
    Aplica, y no separa: ése es su contenido, no un fallo de
    alcance. -/
theorem e_two_applies (r : ℝ) (hr : r ≠ 0) : r * (1 / r) = 1 := by
  field_simp

/-! ## §116.3  La identidad produce los ceros -/

/-- **[C] LA CADENA.**  `Λ(0) = 2 log φ` determina `φ`; `Λ` determina
    sus ceros por Hadamard.  Entrada clásica, en la firma ---§64
    `ProducedByPhi`. -/
def ProducedByTheIdentity (Λ₀ φ : ℝ) : Prop := Λ₀ = 2 * Real.log φ ∧ 0 < φ

/-- **[P] `φ` SE RECUPERA DEL ANCLA.**  `exp(Λ(0)/2) = φ`.
    Restatement de `phi_from_the_anchor` (§64).

    **Los ceros están en el alcance de la identidad por
    construcción.** -/
theorem phi_from_the_anchor₆ (Λ₀ φ : ℝ) (h : ProducedByTheIdentity Λ₀ φ) :
    Real.exp (Λ₀ / 2) = φ := by
  obtain ⟨h1, h2⟩ := h
  rw [h1]
  field_simp
  exact Real.exp_log h2

/-- **[P] LUEGO UN EMBEDDING SOBRE LA IDENTIDAD ALCANZA A LOS CEROS.**
    Si el enunciado vale para todo `s ∈ ℂ` y los ceros son complejos
    producidos por la identidad, se les aplica.

    **«Deja de aplicar» no es una opción; lo que cambia es el valor
    que devuelve.** -/
theorem identity_embedding_reaches_the_zeros (Λ₀ φ : ℝ)
    (h : ProducedByTheIdentity Λ₀ φ) (s : ℂ) :
    (Real.exp (Λ₀ / 2) = φ) ∧ (s.re = (1 - s).re ↔ s.re = 1 / 2) :=
  ⟨phi_from_the_anchor₆ Λ₀ φ h, leg_six_applies s⟩

/-! ## §116.4  Qué devuelve cada uno -/

/-- Lo que un embedding devuelve al aplicarse a un cero. -/
inductive Yield where
  | biconditional : Yield   -- pata 6, identidad de f
  | constant      : Yield   -- e₂ = 1
  | integer       : Yield   -- |órbita| ∈ {2,4}
  | counted       : Yield   -- target = |im|/|ker|
  | interval      : Yield   -- la cota
  | position      : Yield   -- ← el que falta
deriving DecidableEq

instance : Fintype Yield :=
  ⟨{Yield.biconditional, Yield.constant, Yield.integer, Yield.counted, Yield.interval, Yield.position}, by
    intro x; cases x <;> simp⟩

/-- **[P] SEIS RENDIMIENTOS POSIBLES; CINCO REALIZADOS.**  El que
    falta es `position`.

    **No falta alcance: falta un enunciado con este rendimiento.** -/
theorem five_yields_realised : Fintype.card Yield = 6 := by decide

/-- Un rendimiento está REALIZADO si algún embedding del corpus lo
    produce. -/
def realised : Yield → Bool
  | Yield.position => false
  | _              => true

/-- **[P] CINCO REALIZADOS, UNO NO.** -/
theorem exactly_one_missing :
    (Finset.univ.filter (fun y : Yield => realised y)).card = 5 ∧
    (Finset.univ.filter (fun y : Yield => ¬ realised y)).card = 1 := by
  refine ⟨by decide, by decide⟩

/-- **[O] EL BALANCE DE §116.**

    | | escrito | corregido |
    |---|---|---|
    | cabecera de §58 | citada como prueba | **los enunciados deciden** |
    | los embeddings | «no aplican al conjunto» | **aplican; devuelven otra cosa** |
    | qué falta | alcance | **un rendimiento: la posición** |

    **Nada de esto prueba `E`.**  Cambia el diagnóstico de qué buscar. -/
theorem the_balance_of_section_116 (s : ℂ) (r : ℝ) (hr : r ≠ 0) (γ : ℝ) :
    (s.re = (1 - s).re ↔ s.re = 1 / 2) ∧
    (r * (1 / r) = 1) ∧
    (Fintype.card Yield = 6) ∧
    ((Finset.univ.filter (fun y : Yield => realised y)).card = 5) :=
  ⟨leg_six_applies s, e_two_applies r hr, five_yields_realised,
   exactly_one_missing.1⟩

