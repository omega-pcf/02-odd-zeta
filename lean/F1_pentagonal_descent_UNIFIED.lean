theorem conjugation_is_what_makes_the_pair_horizontal (ρ : ℂ) (hγ : ρ.im ≠ 0) :
    (1 - (starRingEnd ℂ) ρ).im = ρ.im ∧ (1 - ρ).im ≠ ρ.im := by
  refine ⟨kmate_preserves_ordinate ρ, ?_⟩
  rw [companion_does_not_preserve_ordinate]
  intro h; apply hγ; linarith

theorem the_pair_is_the_sign_orbit (ρ : ℂ) (h₀ : ρ ≠ 0) (h₁ : ρ ≠ 1) :
