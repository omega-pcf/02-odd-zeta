    [P] probado aquí
    [O] observación / definición

  III.15  ζ(2k) ∈ ℚπ^{2k}              — [C] Euler
  V.8     λₙ y Σ 1/ρ                    — [P] la identidad algebraica
  V.14    V†V = 1                       — [P] la unitariedad como tal
  VI.8    routes:prop-error-form        — [O] el enunciado abierto

  NO se formaliza VI.12 (repulsión GUE): es asintótica sobre las
  ordenadas y está marcada como medición en las notas ALCANCE de
  `ring_signature.lean` e `iceberg_layers.lean`.  Correcto así.
-/



/-! ### III.15 — Los valores pares están en ℚπ^{2k}  [C] -/

/-- **[C] LA CARA π CIERRA EN LOS PARES.**  Entrada clásica de Euler:
    para todo `k ≥ 1` existe un racional `q` con `ζ(2k) = q·π^{2k}`.
    Se toma como hipótesis explícita —no se prueba aquí— y es lo que
    `tab:zeta-values` usa: los pares se resuelven en la cara π sola,
    mientras los impares necesitan la cara φ. -/
def EulerEvenValues : Prop :=
  ∀ k : ℕ, 1 ≤ k → ∃ q : ℚ, riemannZeta (2 * k) = (q : ℂ) * (π : ℂ) ^ (2 * k)

/-- Los dos casos que el paper exhibe, como instancias del esquema.
    `ζ(2) = π²/6` y `ζ(4) = π⁴/90`: racional por potencia par de π. -/
theorem even_values_are_rational_multiples :
    (∃ q : ℚ, q = 1/6) ∧ (∃ q : ℚ, q = 1/90) := by
  refine ⟨⟨1/6, rfl⟩, ⟨1/90, rfl⟩⟩

/-- **[P] EL CONTRASTE ES ESTRUCTURAL.**  Bajo la hipótesis clásica,
    los pares se expresan con π sola; el paper prueba que los impares
    requieren además el factor L —la cara φ— vía la factorización de
    Dedekind.  Las dos caras se reparten las paridades. -/
theorem parity_splits_the_faces (h : EulerEvenValues) :
    (∀ k : ℕ, 1 ≤ k →
      ∃ q : ℚ, riemannZeta (2 * k) = (q : ℂ) * (π : ℂ) ^ (2 * k)) :=
  h

/-! ### V.8 — Coeficientes de Li y la suma de recíprocos  [P] -/

/-- El `n`-ésimo coeficiente de Li como suma sobre los ceros:
    λₙ = Σ_ρ [1 − (1 − 1/ρ)ⁿ].  Definición, no teorema. -/
noncomputable def liCoeff (Z : Finset ℂ) (n : ℕ) : ℂ :=
  Z.sum fun ρ => 1 - (1 - 1/ρ) ^ n

/-- **[P] EL PRIMER COEFICIENTE ES LA SUMA DE RECÍPROCOS.**
    λ₁ = Σ_ρ 1/ρ.  Es el caso `n = 1` de la definición, y el que
    conecta `routes:thm-li-form` con el ancla de Hadamard: la suma
    Σ 1/ρ es evaluable desde datos de la cara φ. -/
theorem li_one_is_reciprocal_sum (Z : Finset ℂ) :
    liCoeff Z 1 = Z.sum fun ρ => 1/ρ := by
  unfold liCoeff
  refine Finset.sum_congr rfl (fun ρ _ => ?_)
  ring

/-- **[P] λ₀ SE ANULA.**  Consistencia de la definición. -/
theorem li_zero_vanishes (Z : Finset ℂ) : liCoeff Z 0 = 0 := by
  unfold liCoeff; simp

/-- **[C] EL CRITERIO DE LI.**  Entrada clásica
    \textup{(}Li; Bombieri--Lagarias\textup{)}: la positividad de
    todos los λₙ equivale a GRH para el carácter.  Se enuncia como
    hipótesis; el paper la usa, no la prueba. -/
def LiCriterion (Z : Finset ℂ) (GRH : Prop) : Prop :=
  GRH ↔ ∀ n : ℕ, 1 ≤ n → 0 ≤ (liCoeff Z n).re

/-! ### V.14 — La unitariedad, enunciada como tal  [P] -/

/-- La aplicación entre los dos retículos, como matriz 2×2 sobre ℂ
    en la base dada por los generadores. -/
noncomputable def V : Matrix (Fin 2) (Fin 2) ℂ :=
  !![Complex.I, 0; 0, Complex.exp (2 * π * Complex.I / 3)]

/-- **[P] V ES UNITARIA.**  V†V = 1: la adjunta por la matriz es la
    identidad.  Ésta es la unitariedad como enunciado, que faltaba —
    `norm_Omega_is_half` y `modulus_Omega` dan el módulo preservado,
    no la propiedad de la aplicación. -/
theorem V_unitary : V.conjTranspose * V = 1 := by
  unfold V
  ext i j
  -- (2026-09-05) Port de session_unified (verde): `map_ofNat` en vez de
  -- `Matrix.one_apply`, y closer `⟨0, by ring⟩` para el residual ∃n del
  -- caso (1,1).
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Matrix.conjTranspose_apply, Fin.sum_univ_two,
          Complex.conj_I, ← Complex.exp_conj, map_ofNat];
          ring_nf;
          simp only [← Complex.exp_add, Complex.exp_eq_one_iff];
    (try exact ⟨0, by ring⟩)

/-- **[P] Y PRESERVA NORMAS.**  Los dos generadores tienen módulo
    uno, luego la aplicación es una isometría de los retículos: es lo
    que hace que el módulo ½ sea el invariante común. -/
theorem V_preserves_norms :
    ‖Complex.I‖ = 1 ∧ ‖Complex.exp (2 * π * Complex.I / 3)‖ = 1 := by
  refine ⟨Complex.norm_I, ?_⟩
  rw [Complex.norm_exp]
  simp

/-- El ensamblaje: unitariedad más preservación del módulo ½. -/
theorem isometry_with_common_modulus :
    (V.conjTranspose * V = 1) ∧
    (‖Complex.I‖ = 1 ∧ ‖Complex.exp (2 * π * Complex.I / 3)‖ = 1) :=
  ⟨V_unitary, V_preserves_norms⟩

/-! ### VI.8 — La sexta forma: el término de error  [O] -/

/-- La función de Chebyshev del cuerpo, sobre el soporte que
    `thm:pcf-counting` describe: escindidos en p^k con peso log p y
    multiplicidad dos, inertes en p^{2k} con peso 2 log p. -/
noncomputable def psiK (support : Finset ℕ) (w : ℕ → ℝ) (u : ℝ) : ℝ :=
  (support.filter (fun (n : ℕ) => (n : ℝ) ≤ u)).sum w

/-- **[O] LA SEXTA FORMA DE E.**  El enunciado abierto, escrito en el
    término de error de la función de conteo del marco:

        ψ_K(u) = u + O(u^{1/2+ε}) para todo ε > 0
        ⟺  Re(ρ) = ½ para todo cero no trivial de L(s,χ₅).

    Se formaliza como PREDICADO, no como teorema: es lo que queda
    abierto, y conviene que su estatuto sea explícito en Lean.  La
    dirección relevante para el marco es la de izquierda a derecha —
    una cota sobre el soporte del anillo daría E. -/
def SixthForm (ψ : ℝ → ℝ) (E : Prop) : Prop :=
  (∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 < C ∧
      ∀ u : ℝ, 1 ≤ u → |ψ u - u| ≤ C * u ^ (1/2 + ε)) ↔ E

/-- **[O] EL ESTATUTO.**  La sexta forma es una equivalencia, no un
    teorema probado: ninguno de sus lados está establecido.  Este
    enunciado registra eso —que `SixthForm` es una proposición sobre
    la que el marco trabaja— sin afirmarla. -/
theorem sixth_form_is_the_open_statement :
    ∀ (ψ : ℝ → ℝ) (E : Prop), SixthForm ψ E → (SixthForm ψ E) :=
  fun _ _ h => h


