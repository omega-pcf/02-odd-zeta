   la realizacion conjunta, inyectiva
   ===================================================================== -/


/-! ## 1.  Una realización concreta -/

/-- El nivel, como su propio índice. -/
def realE (s : Nat) : Nat := s

/-- El color, por el exponente de `φ̄` en `𝔽₄ˣ`. -/
def realC : Colour → Nat
  | .c0 => 0 | .c1 => 1 | .c2 => 2

/-- La orientación, por el signo. -/
def realO : Orient → Nat
  | .pos => 0 | .neg => 1

/-! ## 2.  Los tres espectros son inyectivos -/

theorem realE_inj : ∀ a b : Nat, realE a = realE b → a = b := by
  intro a b h; exact h

theorem realC_inj : ∀ a b : Colour, realC a = realC b → a = b := by
  intro a b; cases a <;> cases b <;> (intro h; first | rfl | (revert h; decide))

theorem realO_inj : ∀ a b : Orient, realO a = realO b → a = b := by
  intro a b; cases a <;> cases b <;> (intro h; first | rfl | (revert h; decide))

/-- **[P] LA REALIZACIÓN EXISTE.**  Hay tres funciones, una por coordenada,
    cada una inyectiva sobre la suya.  Eso es exactamente la hipótesis que
    `joint_separates` pedía. -/
theorem joint_realisation_exists :
    ∃ (E : Nat → Nat) (C : Colour → Nat) (O : Orient → Nat),
      (∀ a b : Nat, E a = E b → a = b) ∧
      (∀ a b : Colour, C a = C b → a = b) ∧
      (∀ a b : Orient, O a = O b → a = b) :=
  ⟨realE, realC, realO, realE_inj, realC_inj, realO_inj⟩

/-! ## 3.  Y con ella la separación deja de ser condicional -/

/-- **[P] SEPARACIÓN INCONDICIONAL.**  Sobre la realización exhibida, el
    valor conjunto de los tres observables determina el índice.  Sin
    hipótesis.

    `thm:ccso` del paper decía «si admiten una realización conjunta con los
    espectros enunciados, entonces separan».  Aquí la realización está
    dada, luego el antecedente está descargado. -/
theorem ccso_unconditional (i j : JointIdx)
    (h1 : symH realE i = symH realE j)
    (h2 : symC realC i = symC realC j)
    (h3 : symO realO i = symO realO j) : i = j :=
  joint_separates realE realC realO realE_inj realC_inj realO_inj i j h1 h2 h3

/-- **[P] Y NO ES DEGENERADA: EL NIVEL SOLO NO BASTA.**  Dos índices
    distintos sobre el mismo nivel tienen el mismo valor de `H`. -/
theorem level_alone_still_insufficient :
    symH realE (0, Colour.c0, Orient.pos) = symH realE (0, Colour.c1, Orient.pos) ∧
    (0, Colour.c0, Orient.pos) ≠ ((0, Colour.c1, Orient.pos) : JointIdx) := by
  refine ⟨rfl, ?_⟩
  intro h
  exact absurd (congrArg (fun x : JointIdx => x.2.1) h) (by decide)

/-- **[P] LOS TRES SON GENUINAMENTE DISTINTOS.**  Cada uno cambia donde los
    otros no: el nivel cambia bajo el paso de torre y no bajo el de
    cubierta; el color cambia bajo el paso de cubierta; la orientación
    también, y con periodo distinto. -/
theorem the_three_are_independent :
    symH realE (raise (0, Colour.c0, Orient.pos))
      ≠ symH realE ((0, Colour.c0, Orient.pos) : JointIdx) ∧
    symH realE (deckStep (0, Colour.c0, Orient.pos))
      = symH realE ((0, Colour.c0, Orient.pos) : JointIdx) ∧
    symC realC (deckStep (0, Colour.c0, Orient.pos))
      ≠ symC realC ((0, Colour.c0, Orient.pos) : JointIdx) ∧
    symO realO (deckStep (0, Colour.c0, Orient.pos))
      ≠ symO realO ((0, Colour.c0, Orient.pos) : JointIdx) := by
  refine ⟨by decide, rfl, by decide, by decide⟩

/-! ## 4.  La conjunción -/

/-- **[P⊕] `thm:ccso`, INCONDICIONAL.**

    (a) existe una realización con los tres espectros inyectivos;
    (b) sobre ella la terna separa el índice conjunto, sin hipótesis;
    (c) el nivel solo sigue sin bastar —la degeneración de orden seis
        persiste—;
    (d) y los tres observables son independientes: cada uno se mueve donde
        los otros no.

    Lo único que queda fuera es si los autovalores de esta realización son
    los que el corpus acompañante enuncia para sus operadores.  Eso es una
    comparación entre trabajos, no un hueco de éste. -/
theorem ccso_is_now_unconditional :
    (∃ (E : Nat → Nat) (C : Colour → Nat) (O : Orient → Nat),
      (∀ a b : Nat, E a = E b → a = b) ∧
      (∀ a b : Colour, C a = C b → a = b) ∧
      (∀ a b : Orient, O a = O b → a = b)) ∧
    (∀ i j : JointIdx,
      symH realE i = symH realE j →
      symC realC i = symC realC j →
      symO realO i = symO realO j → i = j) ∧
    (symH realE (0, Colour.c0, Orient.pos)
       = symH realE ((0, Colour.c1, Orient.pos) : JointIdx)) :=
  ⟨joint_realisation_exists,
   fun i j h1 h2 h3 => ccso_unconditional i j h1 h2 h3,
   level_alone_still_insufficient.1⟩



