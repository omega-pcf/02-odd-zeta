  fun z => link_five z (h6 z)

theorem where_the_chain_breaks (z : Chi5Zero) (c : ℝ) :
    (DirichletCharacter.LFunction chi5_D (1 - z.ρ) = 0) ∧
    (zeroCoord (1 - z.ρ) = (zeroCoord z.ρ)⁻¹) ∧
    (1 - (1 - c) = c) ∧
    ((∀ w : Chi5Zero, zeroCoord (1 - w.ρ) = zeroCoord w.ρ) →
       ∀ w : Chi5Zero, w.ρ.re = 1/2) :=
  ⟨(links_one_and_two z).1, (links_one_and_two z).2,
   (link_six_is_the_gap c).1, link_six_would_close_it⟩

