/-- La reflexión de Schwarz de `L`. -/
noncomputable def conjReflect (L : ℂ → ℂ) : ℂ → ℂ :=
  fun s => (starRingEnd ℂ) (L ((starRingEnd ℂ) s))

theorem conjReflect_apply (L : ℂ → ℂ) (s : ℂ) :
    conjReflect L s = (starRingEnd ℂ) (L ((starRingEnd ℂ) s)) := rfl

theorem conjReflect_involutive (L : ℂ → ℂ) (s : ℂ) :
    conjReflect (conjReflect L) s = L s := by
  simp [conjReflect]

theorem conjReflect_eq_iff_conj_commutes (L : ℂ → ℂ) :
    (∀ s : ℂ, conjReflect L s = L s) ↔
    (∀ s : ℂ, L ((starRingEnd ℂ) s) = (starRingEnd ℂ) (L s)) := by
  constructor
  · intro h s
    have happly : conjReflect L s = L s := h s
    unfold conjReflect at happly
    have h3 := congrArg (starRingEnd ℂ) happly
    rw [Complex.conj_conj] at h3
    exact h3
  · intro h s
    simp only [conjReflect, h s, Complex.conj_conj]

theorem conjReflect_of_real_series_term (c : ℂ) (hc : (starRingEnd ℂ) c = c)
    (z : ℂ) : (starRingEnd ℂ) (c * (starRingEnd ℂ) z) = c * z := by
  rw [map_mul, hc, Complex.conj_conj]

theorem identity_theorem_transfers
    (L : ℂ → ℂ) (hL : Differentiable ℂ L)
    (hR : Differentiable ℂ (conjReflect L))
    (hagree : ∀ s : ℂ, 1 < s.re → conjReflect L s = L s)
    (hid : ∀ f g : ℂ → ℂ, Differentiable ℂ f → Differentiable ℂ g →
             (∀ s : ℂ, 1 < s.re → f s = g s) → ∀ s : ℂ, f s = g s) :
    ∀ s : ℂ, L ((starRingEnd ℂ) s) = (starRingEnd ℂ) (L s) :=
  (conjReflect_eq_iff_conj_commutes L).mp (hid _ _ hR hL hagree)

theorem realCoefficients_from_schwarz
    (L : ℂ → ℂ) (hL : Differentiable ℂ L)
    (hR : Differentiable ℂ (conjReflect L))
    (hagree : ∀ s : ℂ, 1 < s.re → conjReflect L s = L s)
    (hid : ∀ f g : ℂ → ℂ, Differentiable ℂ f → Differentiable ℂ g →
             (∀ s : ℂ, 1 < s.re → f s = g s) → ∀ s : ℂ, f s = g s) :
    RealCoefficients L :=
  realCoefficients_of_conj_comm L (identity_theorem_transfers L hL hR hagree hid)

