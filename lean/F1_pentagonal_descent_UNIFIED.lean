    -- y el espectro es distinto COMO TORSOR μ₃, con módulo uno la torsión
    ((Omega_hat k = ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) : ℝ) * w_pcf ^ (k : ℕ)) ∧
     (Complex.abs (w_pcf ^ (k : ℕ)) = 1) ∧
