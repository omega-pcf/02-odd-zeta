section FibraYRelojBlock

/-
FibraYReloj.lean — Sprint 111. La fibra μ₆ = ℤ/3 × ℤ/2: el paso de la cubierta D, el operador Y = 2 Ω̂ W
y su relación de Weyl; Y separa la fibra; det(M - 1) = -1.
La fibra se indexa por `Fin 3 × Fin 2` (= ℤ/3 × ℤ/2, con la suma módulo 3 y módulo 2).
-/

namespace FibraYReloj
open Matrix

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- La matriz de una permutación `σ`: lleva el punto `i` al punto `σ i`. -/
def permM (σ : Equiv.Perm n) : Matrix n n ℂ := fun i j => if σ i = j then 1 else 0

/-- Conjugar un operador diagonal por una permutación traslada su diagonal. -/
theorem perm_mul_diagonal (σ : Equiv.Perm n) (d : n → ℂ) :
    permM σ * diagonal d = diagonal (fun i => d (σ i)) * permM σ := by
  ext i j
  rw [Matrix.mul_diagonal, Matrix.diagonal_mul]
  unfold permM
  split_ifs with h
  · subst h; ring
  · ring

/-- Relación de Weyl: si la diagonal se multiplica por `q` al dar el paso, `D Y = q • (Y D)`. -/
theorem weyl_relation (σ : Equiv.Perm n) (d : n → ℂ) (q : ℂ) (h : ∀ i, d (σ i) = q * d i) :
    permM σ * diagonal d = q • (diagonal d * permM σ) := by
  rw [perm_mul_diagonal]
  ext i j
  simp [Matrix.diagonal_mul, Matrix.smul_apply, h i, mul_assoc]

/-- El paso de la cubierta en la fibra: `(k, ε) ↦ (k + 1, ε + 1)`. -/
def deck : Equiv.Perm (Fin 3 × Fin 2) where
  toFun x := (x.1 + 1, x.2 + 1)
  invFun x := (x.1 - 1, x.2 - 1)
  left_inv x := by obtain ⟨a, b⟩ := x; fin_cases a <;> fin_cases b <;> rfl
  right_inv x := by obtain ⟨a, b⟩ := x; fin_cases a <;> fin_cases b <;> rfl

/-- El color: `1, ζ, ζ²` en los tres puntos de `ℤ/3`. -/
def colour (ζ : ℂ) : Fin 3 → ℂ := ![1, ζ, ζ ^ 2]

/-- La orientación: `1, -1` en los dos puntos de `ℤ/2`. -/
def sign : Fin 2 → ℂ := ![1, -1]

/-- La diagonal de `Y = 2 Ω̂ W`: `ζ^k · (-1)^ε`. -/
def yDiag (ζ : ℂ) (x : Fin 3 × Fin 2) : ℂ := colour ζ x.1 * sign x.2

/-- Al dar el paso de la cubierta, la diagonal de `Y` se multiplica por `-ζ`. -/
theorem yDiag_deck (ζ : ℂ) (hζ : ζ ^ 3 = 1) (x : Fin 3 × Fin 2) :
    yDiag ζ (deck x) = (-ζ) * yDiag ζ x := by
  obtain ⟨k, e⟩ := x
  fin_cases k <;> fin_cases e <;> simp [yDiag, deck, colour, sign] <;>
    first | ring1 | linear_combination hζ | linear_combination (-1 : ℂ) * hζ

/-- `D Y = (-ζ₃) • (Y D)` en la fibra: el par que genera el álgebra de matrices de orden seis. -/
theorem deck_weyl (ζ : ℂ) (hζ : ζ ^ 3 = 1) :
    permM deck * diagonal (yDiag ζ) = (-ζ) • (diagonal (yDiag ζ) * permM deck) :=
  weyl_relation deck (yDiag ζ) (-ζ) (yDiag_deck ζ hζ)

/-- `det (M - 1) = -1`: el primer factor de la abelianización del toro de aplicación se anula. -/
theorem det_M_sub_one : ((!![0, 1; 1, 1] : Matrix (Fin 2) (Fin 2) ℤ) - 1).det = -1 := by
  simp [Matrix.det_fin_two]

/-- El cubo de la diagonal de `Y` lee la orientación. -/
theorem yDiag_pow_three (ζ : ℂ) (hζ : ζ ^ 3 = 1) (x : Fin 3 × Fin 2) :
    yDiag ζ x ^ 3 = sign x.2 := by
  obtain ⟨k, e⟩ := x
  fin_cases k <;> fin_cases e <;> simp [yDiag, colour, sign] <;>
    first
      | ring1 | linear_combination hζ | linear_combination (-1 : ℂ) * hζ
      | linear_combination (ζ ^ 3 + 1) * hζ | linear_combination (-(ζ ^ 3 + 1)) * hζ

/-- La cuarta potencia de la diagonal de `Y` lee el color. -/
theorem yDiag_pow_four (ζ : ℂ) (hζ : ζ ^ 3 = 1) (x : Fin 3 × Fin 2) :
    yDiag ζ x ^ 4 = colour ζ x.1 := by
  obtain ⟨k, e⟩ := x
  fin_cases k <;> fin_cases e <;> simp [yDiag, colour, sign] <;>
    first
      | ring1 | linear_combination ζ * hζ | linear_combination (ζ ^ 2 * (ζ ^ 3 + 1)) * hζ

/-- `Y` sola separa la fibra: con `ζ³ = 1`, `ζ ≠ 1`, los seis valores `ζ^k (-1)^ε` son distintos. -/
theorem yDiag_injective (ζ : ℂ) (hζ : ζ ^ 3 = 1) (h1 : ζ ≠ 1) : Function.Injective (yDiag ζ) := by
  have a2 : ζ ^ 2 ≠ 1 := fun h => h1 (by linear_combination hζ - ζ * h)
  have a3 : ζ ^ 2 ≠ ζ := fun h => h1 (by linear_combination hζ - (ζ + 1) * h)
  have a1 : ζ ≠ -1 := fun h => by rw [h] at hζ; norm_num at hζ
  have a0 : ζ ≠ 0 := fun h => by rw [h] at hζ; norm_num at hζ
  intro x y h
  have e3 : sign x.2 = sign y.2 := by
    rw [← yDiag_pow_three ζ hζ, ← yDiag_pow_three ζ hζ, h]
  have e4 : colour ζ x.1 = colour ζ y.1 := by
    rw [← yDiag_pow_four ζ hζ, ← yDiag_pow_four ζ hζ, h]
  obtain ⟨k, e⟩ := x
  obtain ⟨k', e'⟩ := y
  have hk : k = k' := by
    revert e4
    fin_cases k <;> fin_cases k' <;> simp [colour] <;>
      first
        | exact h1 | exact (Ne.symm h1) | exact a2 | exact (Ne.symm a2)
        | exact a3 | exact (Ne.symm a3)
        | (constructor <;> first | exact h1 | exact a1 | exact a0)
  have he : e = e' := by
    revert e3
    fin_cases e <;> fin_cases e' <;> simp [sign] <;> norm_num
  rw [hk, he]

end FibraYReloj

end FibraYRelojBlock

