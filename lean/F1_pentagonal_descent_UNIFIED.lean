/-! ## §127.1  El invariante, con el centro fijado -/

/-- **[P] `e₂ = 1/4 − rad²` CUANDO EL CENTRO ES `1/2`.**  Es
    `invariant_ties` (§77) con `ctr = 1/2`: identidad algebraica. -/
theorem e_two_from_the_centre (ρ : ℂ) :
    ρ * (1 - ρ) = 1 / 4 - (ρ - 1 / 2) ^ 2 := by ring

/-- **[P] Y `rad = ρ − 1/2`.**  Restatement, para componer. -/
theorem radius_is_rho_minus_half₇ (ρ : ℂ) :
    (ρ - (1 - ρ)) / 2 = ρ - 1 / 2 := by ring

/-! ## §127.2  La parte imaginaria factoriza -/

/-- **[P] `Im(e₂) = −2·δ·γ`.**  Con `ρ = (1/2 + δ) + iγ`, la parte
    imaginaria del invariante es el producto de las dos desviaciones.

    **Ésta es la factorización.** -/
theorem im_e_two_factorises (δ γ : ℝ) :
    ((⟨1 / 2 + δ, γ⟩ : ℂ) * (1 - ⟨1 / 2 + δ, γ⟩)).im = -(2 * δ * γ) := by
  simp [Complex.mul_im, Complex.sub_re, Complex.sub_im,
        Complex.one_re, Complex.one_im]
  ring

/-- **[P] LUEGO SE ANULA SI Y SÓLO SI UN FACTOR SE ANULA.** -/
theorem im_zero_iff_product_zero (δ γ : ℝ) :
    ((⟨1 / 2 + δ, γ⟩ : ℂ) * (1 - ⟨1 / 2 + δ, γ⟩)).im = 0 ↔ δ * γ = 0 := by
  rw [im_e_two_factorises]
  constructor
  · intro h; linarith
  · intro h; linarith

/-! ## §127.3  Y `γ ≠ 0` descarta un factor -/

/-- **[P] CON `γ ≠ 0`, SÓLO QUEDA `δ = 0`.**  Un cero no trivial tiene
    ordenada no nula, luego el factor `γ` está descartado y el
    enunciado se reduce a un solo factor. -/
theorem gamma_nonzero_leaves_delta (δ γ : ℝ) (hγ : γ ≠ 0)
    (h : δ * γ = 0) : δ = 0 := by
  rcases mul_eq_zero.mp h with h1 | h2
  · exact h1
  · exact absurd h2 hγ

/-- **[P] LA COMPOSICIÓN COMPLETA.**  `Im(e₂) = 0` con `γ ≠ 0` da
    `δ = 0`, es decir `Re ρ = 1/2`.

    **`E` es la anulación de UN factor, no de una cantidad opaca.** -/
theorem E_is_one_factor (δ γ : ℝ) (hγ : γ ≠ 0)
    (h : ((⟨1 / 2 + δ, γ⟩ : ℂ) * (1 - ⟨1 / 2 + δ, γ⟩)).im = 0) :
    δ = 0 :=
  gamma_nonzero_leaves_delta δ γ hγ ((im_zero_iff_product_zero δ γ).mp h)

/-- **[P] Y ENTONCES `Re ρ = 1/2`.** -/
theorem delta_zero_gives_critical (δ γ : ℝ) (h : δ = 0) :
    (⟨1 / 2 + δ, γ⟩ : ℂ).re = 1 / 2 := by
  simp [h]

/-! ## §127.4  El balance -/

/-- **[O] EL BALANCE DE §127.**

    | | §126 | §127 |
    |---|---|---|
    | forma de `E` | «radio con parte real nula» | **`Im(ρ(1−ρ)) = 0`** |
    | estructura | una coordenada | **un PRODUCTO `δ·γ`** |
    | factores | --- | **dos, y `γ ≠ 0` descarta uno** |

    **Nada de esto prueba `E`.**  Lo que hace es factorizar el
    enunciado abierto: de una cantidad que debe anularse a un producto
    de dos, con uno ya conocido no nulo.

    Y la pieza del corpus que lo permite es
    `e_two_real_iff_critical`, que da `Im(e₂) = 0 ⟺ Re ρ = 1/2` para
    cada cero. -/
theorem the_balance_of_section_127 (ρ : ℂ) (δ γ : ℝ) (hγ : γ ≠ 0) :
    (ρ * (1 - ρ) = 1 / 4 - (ρ - 1 / 2) ^ 2) ∧
    (((⟨1 / 2 + δ, γ⟩ : ℂ) * (1 - ⟨1 / 2 + δ, γ⟩)).im = -(2 * δ * γ)) ∧
    (((⟨1 / 2 + δ, γ⟩ : ℂ) * (1 - ⟨1 / 2 + δ, γ⟩)).im = 0 ↔ δ * γ = 0) :=
  ⟨e_two_from_the_centre ρ, im_e_two_factorises δ γ,
   im_zero_iff_product_zero δ γ⟩

