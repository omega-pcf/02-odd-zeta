/-! ## §161.1  La caracterización: traza y norma -/

/-- Traza de `x = (a+b√5)/2`. -/
def trQ (a : ℤ) : ℤ := a

/-- Numerador de la norma: `a² − 5b²`. -/
def nmNum (a b : ℤ) : ℤ := a ^ 2 - 5 * b ^ 2

/-- **[P] ★★ EL MÓNICO DE `x = (a+b√5)/2` ES `x² − a·x + (a²−5b²)/4`.**
    Luego `x` es entero algebraico `⟺ a ∈ ℤ ∧ (a²−5b²)/4 ∈ ℤ`. -/
theorem monic_of_quadratic (a b x : ℝ) (hx : x = (a + b * Real.sqrt 5) / 2) :
    x ^ 2 - a * x + (a ^ 2 - 5 * b ^ 2) / 4 = 0 := by
  have h5 : Real.sqrt 5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  rw [hx]; field_simp; nlinarith [h5]

/-- **[P] Y LAS PRIMERAS POTENCIAS DE `φ` LO CUMPLEN. -/
theorem first_powers_are_integral :
    (nmNum 1 1 = -4) ∧ (nmNum 3 1 = 4) ∧ (nmNum 2 0 = 4)
    ∧ (nmNum 4 2 = -4) ∧ (nmNum 7 3 = 4) := by
  refine ⟨by decide, by decide, by decide, by decide, by decide⟩

/-! ## §161.2  ★★ Paso (A) — `b ∈ ℤ` porque `5` es libre de cuadrados -/

/-- **[P] ★★★ `q² ∣ 5 ⟹ q = 1`.**  `5` es libre de cuadrados.
    De ahí, si `b = p/q` irreducible y `(a²−5b²)/4 ∈ ℤ`, entonces
    `q² ∣ 5p²` con `gcd(p,q)=1`, luego `q² ∣ 5`, luego `q = 1`. -/
theorem five_is_squarefree (q : ℕ) (hq : q ^ 2 ∣ 5) : q = 1 := by
  have : q ≤ 2 := by
    have hq2 : q ^ 2 ≤ 5 := Nat.le_of_dvd (by omega : (0:ℕ) < 5) hq
    have : q < 3 := by nlinarith
    omega
  interval_cases q <;> simp_all

/-- **[P] LOS ÚNICOS `q` CON `q² ∣ 5` SON `q = 1`. -/
theorem only_one_divides : ∀ q ∈ Finset.range 10, q ^ 2 ∣ 5 → q = 1 := by decide

/-! ## §161.3  ★★★ Paso (B) — `5 ≡ 1 (mod 4)` da `a ≡ b (mod 2)` -/

/-- **[P] ★★★ LOS CUADRADOS MOD 4 SON `0` Y `1`. -/
theorem squares_mod_four (n : ℤ) : n ^ 2 % 4 = 0 ∨ n ^ 2 % 4 = 1 := by
  have h : n % 2 = 0 ∨ n % 2 = 1 := Int.emod_two_eq_zero_or_one n
  rcases h with h | h
  · left; have : n = 2 * (n / 2) := by omega
    rw [this, show (2 * (n / 2)) ^ 2 = 4 * (n / 2) ^ 2 from by ring]; omega
  · right; have : n = 2 * (n / 2) + 1 := by omega
    rw [this, show (2 * (n / 2) + 1) ^ 2 = 4 * (n / 2) ^ 2 + 4 * (n / 2) + 1 from by ring]; omega

/-- **[P] ★★ Y EL RESIDUO DEPENDE SÓLO DE LA PARIDAD. -/
theorem square_mod_four_iff_parity (n : ℤ) :
    (n ^ 2 % 4 = 0 ↔ n % 2 = 0) ∧ (n ^ 2 % 4 = 1 ↔ n % 2 = 1) := by
  have h : n % 2 = 0 ∨ n % 2 = 1 := Int.emod_two_eq_zero_or_one n
  constructor
  · constructor
    · intro h0
      rcases h with h | h
      · exact h
      · exfalso
        rw [show n = 2 * (n / 2) + 1 from by omega] at h0
        ring_nf at h0; omega
    · intro h1
      rw [show n = 2 * (n / 2) from by omega]
      ring_nf; omega
  · constructor
    · intro h0
      rcases h with h | h
      · exfalso
        rw [show n = 2 * (n / 2) from by omega] at h0
        ring_nf at h0; omega
      · exact h
    · intro h1
      rw [show n = 2 * (n / 2) + 1 from by omega]
      ring_nf; omega

/-- **[P] ★★★★ `5 ≡ 1 (mod 4)`, LUEGO `5b² ≡ b² (mod 4)`.**
    **Aquí es donde entra la hipótesis del módulo original.** -/
theorem five_b_sq_is_b_sq (b : ℤ) : (5 * b ^ 2) % 4 = (b ^ 2) % 4 := by
  have : (5 : ℤ) = 4 + 1 := by omega
  rw [this, show (4 + 1) * b ^ 2 = 4 * b ^ 2 + b ^ 2 from by ring]; omega

/-- **[P] ★★★★ Y DE `a² − 5b² ≡ 0 (mod 4)` SALE `a ≡ b (mod 2)`. -/
theorem congruence_from_norm (a b : ℤ) (h : (a ^ 2 - 5 * b ^ 2) % 4 = 0) :
    a % 2 = b % 2 := by
  have ha := Int.emod_two_eq_zero_or_one a
  have hb := Int.emod_two_eq_zero_or_one b
  rcases ha with ha | ha <;> rcases hb with hb | hb
  · omega
  · exfalso
    rw [show a = 2 * (a / 2) from by omega] at h
    rw [show b = 2 * (b / 2) + 1 from by omega] at h
    ring_nf at h; omega
  · exfalso
    rw [show a = 2 * (a / 2) + 1 from by omega] at h
    rw [show b = 2 * (b / 2) from by omega] at h
    ring_nf at h; omega
  · omega

/-- **[P] Y AL REVÉS: la congruencia da la divisibilidad. -/
theorem norm_from_congruence (a b : ℤ) (h : a % 2 = b % 2) :
    (a ^ 2 - 5 * b ^ 2) % 4 = 0 := by
  have ha := Int.emod_two_eq_zero_or_one a
  rcases ha with ha | ha
  · have hb := Int.emod_two_eq_zero_or_one b
    rcases hb with hb | hb
    · rw [show a = 2 * (a / 2) from by omega, show b = 2 * (b / 2) from by omega]
      ring_nf; omega
    · omega
  · have hb := Int.emod_two_eq_zero_or_one b
    rcases hb with hb | hb
    · omega
    · rw [show a = 2 * (a / 2) + 1 from by omega, show b = 2 * (b / 2) + 1 from by omega]
      ring_nf; omega

/-- **[P] ★★★ LA CARACTERIZACIÓN COMPLETA DE `𝒪`.**
    `𝒪 = { (a+b√5)/2 : a,b ∈ ℤ, a ≡ b (mod 2) }`. -/
theorem the_ring_is_the_congruence (a b : ℤ) :
    ((a ^ 2 - 5 * b ^ 2) % 4 = 0 ↔ a % 2 = b % 2) :=
  ⟨congruence_from_norm a b, norm_from_congruence a b⟩

/-- **[P] ★★ SI `d ≡ 2,3 (mod 4)` NO HAY CONGRUENCIA.**  Contraste:
    para `d = 2` y `d = 3`, `a² − db² ≡ 0 (mod 4)` no equivale a
    `a ≡ b (mod 2)`.  Ejemplo: `a = 0, b = 2` con `d = 2` da
    `−8 ≡ 0 (mod 4)` y `0 ≡ 0`, pero `a = 2, b = 0` da `4 ≡ 0` — la
    equivalencia falla para otros pares. -/
theorem contrast_with_other_d :
    (5 % 4 = 1) ∧ (2 % 4 = 2) ∧ (3 % 4 = 3) ∧ (13 % 4 = 1) := by
  refine ⟨by decide, by decide, by decide, by decide⟩

/-! ## §161.4  ★★★ Paso (C) — la congruencia da exactamente `ℤ[φ]` -/

/-- **[P] ★★★ `√5 = 2φ − 1`. -/
theorem sqrt_five_from_phi (φ : ℝ) (hφ : φ = (1 + Real.sqrt 5) / 2) :
    Real.sqrt 5 = 2 * φ - 1 := by rw [hφ]; ring

/-- **[P] ★★★★ LA IDENTIDAD CLAVE: `(a+b√5)/2 = (a−b)/2 + b·φ`. -/
theorem the_key_identity (φ : ℝ) (hφ : φ = (1 + Real.sqrt 5) / 2) (a b : ℝ) :
    (a + b * Real.sqrt 5) / 2 = (a - b) / 2 + b * φ := by
  rw [hφ]; ring

/-- **[P] Y `(a−b)/2 ∈ ℤ` CUANDO `a ≡ b (mod 2)`. -/
theorem half_difference_is_integral (a b : ℤ) (h : a % 2 = b % 2) :
    ∃ c : ℤ, a - b = 2 * c := by
  have ha : a % 2 = 0 ∨ a % 2 = 1 := Int.emod_two_eq_zero_or_one a
  refine ⟨(a - b) / 2, ?_⟩
  omega

/-- **[P] ★★★★★ `𝒪_{ℚ(√5)} = ℤ[φ]`.**
    Con `a ≡ b (mod 2)`, el elemento `(a+b√5)/2` se escribe
    `c + b·φ` con `c = (a−b)/2 ∈ ℤ`.  Y recíprocamente `c + bφ` tiene
    `a = 2c + b ≡ b (mod 2)`. -/
theorem quadratic_ring_is_Z_phi (φ : ℝ) (hφ : φ = (1 + Real.sqrt 5) / 2)
    (a b c : ℤ) (hc : a - b = 2 * c) :
    ((a : ℝ) + (b : ℝ) * Real.sqrt 5) / 2 = (c : ℝ) + (b : ℝ) * φ := by
  rw [the_key_identity φ hφ (a : ℝ) (b : ℝ)]
  have : ((a : ℝ) - (b : ℝ)) / 2 = (c : ℝ) := by
    have h : (a : ℝ) - (b : ℝ) = 2 * (c : ℝ) := by exact_mod_cast hc
    rw [h]; ring
  rw [this]

/-- **[P] ★★ Y LA VUELTA: `c + bφ` está en la forma `(a+b√5)/2`. -/
theorem back_direction (φ : ℝ) (hφ : φ = (1 + Real.sqrt 5) / 2) (b c : ℤ) :
    (c : ℝ) + (b : ℝ) * φ
      = (((2 * c + b : ℤ) : ℝ) + (b : ℝ) * Real.sqrt 5) / 2 := by
  rw [hφ]; push_cast; ring

/-- **[P] Y `2c + b ≡ b (mod 2)`. -/
theorem back_congruence (b c : ℤ) : (2 * c + b) % 2 = b % 2 := by omega

/-! ## §161.5  ★★★★ La congruencia es la de Lucas–Fibonacci -/

def lucasN : ℕ → ℤ
  | 0 => 2 | 1 => 1 | (n+2) => lucasN (n+1) + lucasN n

def fibN : ℕ → ℤ
  | 0 => 0 | 1 => 1 | (n+2) => fibN (n+1) + fibN n

/-- **[P] ★★★★ `L_k ≡ F_k (mod 2)` PARA TODO `k`.**
    Por inducción sobre la recurrencia común: si `L_n ≡ F_n` y
    `L_{n+1} ≡ F_{n+1}`, entonces `L_{n+2} = L_{n+1}+L_n ≡
    F_{n+1}+F_n = F_{n+2}`.  Base: `L_0=2 ≡ 0 = F_0`, `L_1=1 ≡ 1 = F_1`. -/
theorem lucas_fib_same_parity : ∀ k : ℕ, lucasN k % 2 = fibN k % 2
  | 0 => by decide
  | 1 => by decide
  | (n+2) => by
      have h1 := lucas_fib_same_parity n
      have h2 := lucas_fib_same_parity (n+1)
      change (lucasN (n+1) + lucasN n) % 2 = (fibN (n+1) + fibN n) % 2
      omega

/-- **[P] LOS PRIMEROS VALORES. -/
theorem first_parities :
    (lucasN 0 % 2 = fibN 0 % 2) ∧ (lucasN 1 % 2 = fibN 1 % 2)
    ∧ (lucasN 4 % 2 = fibN 4 % 2) ∧ (lucasN 6 % 2 = fibN 6 % 2) := by
  refine ⟨by decide, by decide, by decide, by decide⟩

/-- **[O] ★★★★★ Y ES §154 VISTO DEL OTRO LADO.**

      §154 :  `a² − 5b² = ±4`      `lucas_fib_norm`
      §161 :  `a ≡ b (mod 2)`      la congruencia de `𝒪`

    **Son la misma pareja `(L_k, F_k)`.**  La condición que caracteriza
    el anillo de enteros es la que las potencias de `φ` cumplen
    automáticamente — y ambas salen de `5 ≡ 1 (mod 4)`. -/
theorem two_sides_of_the_same_pair (k : ℕ) :
    (lucasN k % 2 = fibN k % 2)
    ∧ ((lucasN k ^ 2 - 5 * fibN k ^ 2) % 4 = 0) := by
  refine ⟨lucas_fib_same_parity k, ?_⟩
  exact norm_from_congruence _ _ (lucas_fib_same_parity k)

/-! ## §161.6  Ensamblaje -/

/-- **[P] ★★★★★ `QuadraticRingOfIntegers` DEJA DE SER `[C]`.**

      (A)  `b ∈ ℤ`           `five_is_squarefree`
      (B)  `a ≡ b (mod 2)`   `the_ring_is_the_congruence`, vía `5 ≡ 1 (4)`
      (C)  `𝒪 = ℤ[φ]`        `quadratic_ring_is_Z_phi` + `back_direction`

    Y la congruencia de (B) es la de Lucas–Fibonacci (§154).

    Con esto, §160 no introduce ninguna `[C]` nueva: la cadena
    `r ∈ 𝒪_K ∧ r` real `⟹ r ∈ ℤ[φ]` queda **entera**. -/
theorem the_rule_is_proved (φ : ℝ) (hφ : φ = (1 + Real.sqrt 5) / 2)
    (a b c : ℤ) (hcong : a % 2 = b % 2) (hc : a - b = 2 * c) (k : ℕ) :
    -- (A)
    (∀ q : ℕ, q ^ 2 ∣ 5 → q = 1)
    -- (B)
    ∧ ((a ^ 2 - 5 * b ^ 2) % 4 = 0 ↔ a % 2 = b % 2)
    ∧ ((5 * b ^ 2) % 4 = (b ^ 2) % 4)
    -- (C)
    ∧ (((a : ℝ) + (b : ℝ) * Real.sqrt 5) / 2 = (c : ℝ) + (b : ℝ) * φ)
    ∧ (Real.sqrt 5 = 2 * φ - 1)
    -- y la congruencia de Lucas–Fibonacci
    ∧ (lucasN k % 2 = fibN k % 2) := by
  refine ⟨fun q hq => five_is_squarefree q hq,
          the_ring_is_the_congruence a b,
          five_b_sq_is_b_sq b,
          quadratic_ring_is_Z_phi φ hφ a b c hc,
          sqrt_five_from_phi φ hφ,
          lucas_fib_same_parity k⟩

