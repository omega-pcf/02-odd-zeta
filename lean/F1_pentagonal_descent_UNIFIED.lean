section AlcanceZetaBlock

namespace AlcanceZeta
open F1PCFUnified

/-- RH for `ζ`, as a statement. -/
def RiemannZetaZerosOnLine : Prop :=
  ∀ s : ℂ, riemannZeta s = 0 → (¬∃ n : ℕ, s = -2 * ((n : ℂ) + 1)) → s ≠ 1 → s.re = 1 / 2

/-- GRH for the Dirichlet `L`-functions, as a statement. -/
def DirichletLZerosOnLine : Prop :=
  ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N) (s : ℂ),
    0 < s.re → s.re < 1 → DirichletCharacter.LFunction χ s = 0 → s.re = 1 / 2

/-- **RH for the zeros of `ζ · L(·, χ₅)` in the strip**, from RH and GRH. -/
theorem dedekind_strip_zeros_on_line (hζ : RiemannZetaZerosOnLine)
    (hL : DirichletLZerosOnLine) (s : ℂ) (h0 : 0 < s.re) (h1 : s.re < 1)
    (hz : riemannZeta s * DirichletCharacter.LFunction chi5_D s = 0) : s.re = 1 / 2 := by
  rcases mul_eq_zero.mp hz with h | h
  · refine hζ s h ?_ ?_
    · rintro ⟨n, hn⟩
      have hre : s.re = -2 * ((n : ℝ) + 1) := by
        rw [hn]; simp
      have : (0 : ℝ) ≤ n := Nat.cast_nonneg n
      linarith
    · intro hs
      rw [hs, Complex.one_re] at h1
      exact lt_irrefl _ h1
  · exact hL 5 chi5_D s h0 h1 h

end AlcanceZeta

