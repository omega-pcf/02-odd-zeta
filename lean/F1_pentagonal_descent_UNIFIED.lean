-- BLOCK 21. F1Lawvere
-- Lawvere, the diagonal argument, fixed points of Frobenius lifts, the reflection (sections 5.3, 20.5)
-- ════════════════════════════════════════════════════════════════════════════

section Block21
/-
  F1Paper/Lawvere.lean  (from F1_Lawvere_descent.lean)
  Lawvere's fixed-point theorem and the F1-descent of the PCF ring.
  STATUS: [P*] written without a local Lean toolchain; must be compiled
  against the project's Mathlib before any statement is cited as compiled.
  §1 is cited in the paper (§5.3).  §2–§4 are registered in the ontology
  (LAWVERE_HP_F1.md, part 2) and not yet cited.
-/

namespace F1Lawvere

/-! ## 1. Lawvere's fixed-point theorem (category of types)

Lawvere 1969: if `g : A → (A → Y)` is surjective, every endomorphism of
`Y` has a fixed point.  The witness is the diagonal value `g a a`. -/

theorem lawvere_fixed_point {A Y : Type*} (g : A → A → Y)
    (hg : Function.Surjective g) (t : Y → Y) : ∃ y, t y = y := by
  obtain ⟨a, ha⟩ := hg (fun x => t (g x x))
  exact ⟨g a a, (congrFun ha a).symm⟩

/-- Contrapositive (the diagonal argument): a fixed-point-free
endomorphism of `Y` forbids every surjection `A → (A → Y)`. -/
theorem no_surjection_of_fixedPointFree {A Y : Type*} (t : Y → Y)
    (ht : ∀ y, t y ≠ y) (g : A → A → Y) : ¬ Function.Surjective g :=
  fun hg => by
    obtain ⟨y, hy⟩ := lawvere_fixed_point g hg t
    exact ht y hy

/-! ## 2. Fixed points of Frobenius lifts

A Λ-structure (Borger) is a commuting family of ring endomorphisms; on
the Λ-monoid the Frobenius is the power map `u ↦ u^p`.  Every ring
endomorphism fixes the image of `ℤ`; every monoid endomorphism fixes `1`.
So no Frobenius lift is fixed-point-free. -/

theorem ringHom_fixes_intCast {R : Type*} [Ring R] (f : R →+* R) (n : ℤ) :
    f (n : R) = n := map_intCast f n

theorem ringHom_not_fixedPointFree {R : Type*} [Semiring R] (f : R →+* R) :
    ¬ ∀ y, f y ≠ y := fun h => h 0 (map_zero f)

theorem family_common_fixed_point {R ι : Type*} [Semiring R]
    (ψ : ι → R →+* R) : ∃ y : R, ∀ i, ψ i y = y :=
  ⟨0, fun i => map_zero (ψ i)⟩

theorem powMonoidHom_fixes_one {M : Type*} [CommMonoid M] (p : ℕ) :
    (powMonoidHom p : M →* M) 1 = 1 := map_one _

theorem monoidHom_not_fixedPointFree {M : Type*} [Monoid M] (f : M →* M) :
    ¬ ∀ y, f y ≠ y := fun h => h 1 (map_one f)

/-! ## 3. The reflection `x ↦ 1 - x`

Fixed-point-free on `ℤ`; in every commutative ring with `2` invertible
its unique fixed point is `⅟2`. -/

theorem reflection_fixedPointFree_int : ∀ x : ℤ, 1 - x ≠ x := by
  intro x h; omega

theorem reflection_fixed_iff {R : Type*} [CommRing R] [Invertible (2 : R)]
    (x : R) : 1 - x = x ↔ x = ⅟(2 : R) := by
  constructor
  · intro h
    have h2 : (2 : R) * x = 1 := by linear_combination -h
    calc x = ⅟(2 : R) * (2 * x) := by rw [← mul_assoc, invOf_mul_self, one_mul]
      _ = ⅟(2 : R) := by rw [h2, mul_one]
  · rintro rfl
    have h := mul_invOf_self (2 : R)
    linear_combination -h

theorem no_surjection_int {A : Type*} (g : A → A → ℤ) :
    ¬ Function.Surjective g :=
  no_surjection_of_fixedPointFree (fun x => 1 - x)
    reflection_fixedPointFree_int g

/-! ## 4. The descent datum on ℤ[ω], ω² = ω + 1, built from scratch

`ψ n` depends only on `n mod 5` and on the ring `ℤ[ω]`; no zeta
function, zero or Euler product enters any definition below. -/

open Polynomial

noncomputable section

abbrev Zω := AdjoinRoot (X ^ 2 - X - 1 : ℤ[X])

abbrev ω : Zω := AdjoinRoot.root (X ^ 2 - X - 1 : ℤ[X])

theorem ω_sq : ω ^ 2 = ω + 1 := by
  have h := AdjoinRoot.eval₂_root (X ^ 2 - X - 1 : ℤ[X])
  simp only [eval₂_sub, eval₂_pow, eval₂_X, eval₂_one] at h
  linear_combination h

/-- Conjugation `ω ↦ 1 - ω`, a ring endomorphism of `ℤ[ω]`. -/
def σ : Zω →+* Zω :=
  AdjoinRoot.lift (algebraMap ℤ Zω) (1 - ω) (by
    simp only [eval₂_sub, eval₂_pow, eval₂_X, eval₂_one]
    linear_combination ω_sq)

theorem σ_ω : σ ω = 1 - ω := AdjoinRoot.lift_root _

theorem σ_comp_σ : σ.comp σ = RingHom.id Zω := by
  apply AdjoinRoot.ringHom_ext
  · exact RingHom.ext_int _ _
  · simp [σ_ω, map_sub, map_one]

/-- The quadratic character mod 5 (Legendre symbol `(· / 5)`). -/
def chi5 (n : ℕ) : ℤ :=
  match n % 5 with
  | 1 => 1 | 4 => 1 | 2 => -1 | 3 => -1 | _ => 0

theorem chi5_mul (m n : ℕ) : chi5 (m * n) = chi5 m * chi5 n := by
  have hm := Nat.mod_lt m (by norm_num : 5 > 0)
  have hn := Nat.mod_lt n (by norm_num : 5 > 0)
  unfold chi5
  rw [Nat.mul_mod]
  interval_cases (m % 5) <;> interval_cases (n % 5) <;> rfl

/-- The Frobenius lift at `n` (Artin): identity if `chi5 n = 1`,
conjugation otherwise.  Used only for `n` prime to 5. -/
def ψ (n : ℕ) : Zω →+* Zω := if chi5 n = 1 then RingHom.id Zω else σ

theorem chi5_unit (n : ℕ) (h : n % 5 ≠ 0) : chi5 n = 1 ∨ chi5 n = -1 := by
  have := Nat.mod_lt n (by norm_num : 5 > 0)
  unfold chi5
  interval_cases (n % 5) <;> simp_all

/-- `ψ_m ∘ ψ_n = ψ_{mn}` for `m, n` prime to 5: the datum is indexed by
the multiplicative monoid and generated by its values at the primes. -/
theorem ψ_comp (m n : ℕ) (hm : m % 5 ≠ 0) (hn : n % 5 ≠ 0) :
    (ψ m).comp (ψ n) = ψ (m * n) := by
  rcases chi5_unit m hm with h1 | h1 <;> rcases chi5_unit n hn with h2 | h2 <;>
    simp [ψ, chi5_mul, h1, h2, σ_comp_σ]

theorem ψ_commute (m n : ℕ) (hm : m % 5 ≠ 0) (hn : n % 5 ≠ 0) :
    (ψ m).comp (ψ n) = (ψ n).comp (ψ m) := by
  rw [ψ_comp m n hm hn, ψ_comp n m hn hm, Nat.mul_comm]

/-- Every Frobenius lift fixes the integers. -/
theorem ψ_fixes_int (n : ℕ) (k : ℤ) : ψ n (k : Zω) = k := map_intCast _ k

/-- **[P*] The reflection has no fixed point in `ℤ[ω]`.**  `1 - x = x` would give `2x = 1`.
    Lifting `x` to a polynomial `p`, `X² - X - 1` would divide `2p - 1`; reduced modulo 2 it
    would divide `-1`, so it would be a unit of `(ZMod 2)[X]`, which is impossible since it is
    monic of degree 2.  So `2` is not a unit of `ℤ[φ]` and the fixed point `⅟2` of the
    reflection, the apex `½`, is not in the ring. -/
theorem reflection_fixedPointFree_Zω : ∀ x : Zω, 1 - x ≠ x := by
  intro x hx
  obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective x
  have h2 : AdjoinRoot.mk (X ^ 2 - X - 1 : ℤ[X]) (2 * p - 1) = 0 := by
    rw [map_sub, map_mul, map_one, map_ofNat]
    linear_combination -hx
  rw [AdjoinRoot.mk_eq_zero] at h2
  have hd := Polynomial.map_dvd (Int.castRingHom (ZMod 2)) h2
  have h20 : ((2 : ℤ[X]).map (Int.castRingHom (ZMod 2))) = 0 := by
    rw [Polynomial.map_ofNat]; exact CharTwo.two_eq_zero
  have hm : (2 * p - 1 : ℤ[X]).map (Int.castRingHom (ZMod 2)) = -1 := by
    rw [Polynomial.map_sub, Polynomial.map_mul, Polynomial.map_one, h20, zero_mul, zero_sub]
  rw [hm] at hd
  have hmon : (X ^ 2 - X - 1 : ℤ[X]).Monic := by monicity!
  have hdeg : ((X ^ 2 - X - 1 : ℤ[X]).map (Int.castRingHom (ZMod 2))).natDegree = 2 := by
    rw [hmon.natDegree_map]; compute_degree!
  have hunit := isUnit_of_dvd_unit hd isUnit_one.neg
  have h0 := Polynomial.natDegree_eq_zero_of_isUnit hunit
  omega

end

end F1Lawvere
end Block21

