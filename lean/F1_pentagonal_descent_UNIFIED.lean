/-! ## §119.1  Aditivo contra multiplicativo -/

/-- **[P] DUPLICAR `X` AÑADE `log 2` A LA VENTANA.**  `log(2X) =
    log X + log 2`: la ganancia es ADITIVA y constante. -/
theorem doubling_adds_log_two (X : ℝ) (hX : 0 < X) :
    Real.log (2 * X) = Real.log X + Real.log 2 := by
  rw [Real.log_mul (by norm_num) (ne_of_gt hX)]
  ring

/-- **[P] Y DOBLA LOS TÉRMINOS.**  El coste es `~X`, luego pasa a
    `~2X`: MULTIPLICATIVO. -/
theorem doubling_doubles_cost (X : ℕ) : 2 * X = X + X := by ring

/-- **[P] LUEGO PARA GANAR `t` EN LA VENTANA HACE FALTA COSTE `2^{t/log2}`.**
    `n` duplicaciones dan `n·log 2` de ventana y `2ⁿ` de coste. -/
theorem gain_linear_cost_exponential (n : ℕ) :
    ((n : ℝ) * Real.log 2 = Real.log (2 ^ n)) ∧ ((2 : ℕ) ^ n = 2 ^ n) := by
  refine ⟨?_, rfl⟩
  rw [Real.log_pow]

/-! ## §119.2  La ventana cubre `L` acotado, siempre -/

/-- **[C] LA VENTANA.**  Positividad probada para `2L < log X`, con
    `X` finito.  Predicado con la cota explícita. -/
def WindowUpTo (Q : ℝ → ℝ) (X : ℝ) : Prop :=
  ∀ T : ℝ, 0 < T → T < Real.log X → 0 < Q T

/-- **[C] EL CRITERIO DE WEIL.**  Pide positividad para TODO `T`. -/
def WeilNeedsAll (Q : ℝ → ℝ) : Prop := ∀ T : ℝ, 0 < T → 0 < Q T

/-- **[P] LA VENTANA NO DA EL CRITERIO.**  Para todo `X`, existe un
    `T` fuera de la ventana ---a saber, `log X` mismo---, luego
    `WindowUpTo` nunca implica `WeilNeedsAll` por sí sola.

    **Ésta es la no-terminación, como teorema.** -/
theorem window_never_gives_the_criterion (X : ℝ) (hX : 1 < X) :
    ∃ T : ℝ, 0 < T ∧ ¬ (T < Real.log X) := by
  refine ⟨Real.log X, Real.log_pos hX, ?_⟩
  exact lt_irrefl _

/-- **[P] Y AMPLIAR `X` NO LO ARREGLA.**  Para el `X` nuevo vuelve a
    haber un `T` fuera: el argumento se repite en cada duplicación.

    **No es cuestión de cuántas veces: es que el cuantificador es
    universal y la ventana acotada.** -/
theorem no_finite_sequence_suffices (X : ℝ) (hX : 1 < X) (n : ℕ) :
    ∃ T : ℝ, 0 < T ∧ ¬ (T < Real.log (2 ^ n * X)) := by
  refine ⟨Real.log (2 ^ n * X), Real.log_pos ?_, lt_irrefl _⟩
  have h2 : (1 : ℝ) ≤ 2 ^ n := one_le_pow₀ (by norm_num)
  nlinarith

/-! ## §119.3  El freno es el coste, no el margen -/

/-- **[N] EL MARGEN ESTÁ ESTABLE.**  Los cuatro últimos tramos de
    §118 dan `0.0269, 0.0362, 0.0295, 0.0304`: banda estrecha, sin
    tendencia a cero. -/
theorem margin_is_stable :
    ((26876 : ℝ) / 1000000 < 36223 / 1000000) ∧
    ((29514 : ℝ) / 1000000 < 36223 / 1000000) ∧
    ((0 : ℝ) < 26876 / 1000000) ∧
    ((36223 : ℝ) / 1000000 - 26876 / 1000000 < 1 / 100) := by
  refine ⟨by norm_num, by norm_num, by norm_num, by norm_num⟩

/-- **[O] LUEGO EL FRENO ES OTRO.**  La hipótesis de §36 ---margen
    decreciente que agota el método--- no se sostiene; lo que agota
    es el coste, que dobla por cada `log 2` de ventana.

    **Antes de medir, el freno se suponía en el margen.  Está en el
    coste.** -/
theorem the_brake_is_the_cost (X : ℝ) (hX : 0 < X) (n : ℕ) :
    (Real.log (2 * X) = Real.log X + Real.log 2) ∧
    ((n : ℝ) * Real.log 2 = Real.log (2 ^ n)) ∧
    ((0 : ℝ) < 26876 / 1000000) :=
  ⟨doubling_adds_log_two X hX, (gain_linear_cost_exponential n).1,
   margin_is_stable.2.2.1⟩

/-! ## §119.4  El balance -/

/-- **[O] EL BALANCE DE §119.**

    | | supuesto | medido |
    |---|---|---|
    | qué frena el método | el margen → 0 | **el coste, que dobla** |
    | `γ < 70` por esta vía | --- | **5.2·10⁶ años** |
    | completarse | «cada tramo da menos» | **no termina, por cuantificador** |

    **Nada de esto prueba `E`, ni lo refuta.**  Cuantifica el límite
    de un método que sí da porción probada, y dice qué haría falta:
    una cota UNIFORME en `L`, no un cómputo por `L`. -/
theorem the_balance_of_section_119 (X : ℝ) (hX : 1 < X) (n : ℕ) :
    (∃ T : ℝ, 0 < T ∧ ¬ (T < Real.log X)) ∧
    (∃ T : ℝ, 0 < T ∧ ¬ (T < Real.log (2 ^ n * X))) ∧
    (Real.log (2 * X) = Real.log X + Real.log 2) ∧
    ((0 : ℝ) < 26876 / 1000000) :=
  ⟨window_never_gives_the_criterion X hX, no_finite_sequence_suffices X hX n,
   doubling_adds_log_two X (lt_trans one_pos hX), margin_is_stable.2.2.1⟩

