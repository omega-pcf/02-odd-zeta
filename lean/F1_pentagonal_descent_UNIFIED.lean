theorem the_zero_pair_in_valPhi_has_opposite_signs (z : Chi5Zero) :
    valPhi (zeroCoord z.ρ) = - valPhi (zeroCoord (1 - z.ρ)) := by
  have hprod := (coords_closed_under_inversion z).1
  have hpos : 0 < zeroCoord z.ρ := by
    have hip := z.in_strip_pos
    have hlt := z.in_strip_lt
    refine Complex.abs.pos (fun hz => ?_)
    have hne : z.ρ ≠ 0 := by
      intro h; rw [h] at hip; simp at hip
    unfold liMap at hz
    field_simp at hz
    rw [mul_zero] at hz
    have hre : z.ρ.re = 1 := by
      have h := Complex.ext_iff.mp hz
      simp [Complex.sub_re, Complex.one_re] at h
      linarith
    rw [hre] at hlt
    linarith
  have hne2 : 1 - z.ρ ≠ 0 := by
    intro h
    have hip := z.in_strip_pos
    have hlt := z.in_strip_lt
    have hc : ((1 : ℂ) - z.ρ).re = (0 : ℝ) := by
      rw [h]
      simp
    rw [Complex.sub_re, Complex.one_re] at hc
    have hz1 : z.ρ.re = 1 := by linarith
    linarith [hip, hlt, hz1]
  have hinv : zeroCoord (1 - z.ρ) = (zeroCoord z.ρ)⁻¹ := by
    rw [show (zeroCoord z.ρ)⁻¹ = 1 / zeroCoord z.ρ from by field_simp, ← hprod]
    field_simp
  rw [hinv]
  have h := valPhi_inversion_is_negation (zeroCoord z.ρ) hpos
  rw [show (zeroCoord z.ρ)⁻¹ = 1 / zeroCoord z.ρ from by field_simp]
  linarith [h]

