/-! ════════════════════════════════════════════════════════════════════
    §49.1  La órbita bajo el grupo de Klein, y su discretitud
    ════════════════════════════════════════════════════════════════════ -/

/-- La órbita de `ρ` bajo `V = {1, σ, τ, στ}`, con `σ : ρ ↦ ρ̄` y
    `τ : ρ ↦ 1 - ρ`. -/
def kleinOrbit (ρ : ℂ) : Finset ℂ :=
  {ρ, (starRingEnd ℂ) ρ, 1 - ρ, 1 - (starRingEnd ℂ) ρ}

/-- **[P] `στ` FIJA `ρ` ↔ `Re ρ = 1/2`.**  El compañero de Klein
    `1 - ρ̄` coincide con `ρ` exactamente sobre la línea. -/
theorem klein_partner_fixed_iff (ρ : ℂ) :
    1 - (starRingEnd ℂ) ρ = ρ ↔ ρ.re = 1 / 2 := by
  rw [Complex.ext_iff]
  simp only [sub_re, sub_im, conj_re, conj_im, one_re, one_im, zero_sub,
             neg_neg]
  constructor
  · intro h; have := h.1; linarith
  · intro h; exact ⟨by linarith, trivial⟩

/-- **[P] `σ` NO FIJA NINGÚN CERO NO REAL.**  `ρ̄ = ρ` obliga a
    `Im ρ = 0`.  Por eso la degeneración de abajo la produce `στ`, no
    `σ` —a diferencia de arriba, donde la produce `σ` (`a² = 1`). -/
theorem sigma_fixes_only_reals (ρ : ℂ) (hγ : ρ.im ≠ 0) :
    (starRingEnd ℂ) ρ ≠ ρ := by
  intro h
  have : -ρ.im = ρ.im := congrArg Complex.im h
  exact hγ (by linarith)

/-- **[P] `τ` NO FIJA NADA.**  `1 - ρ = ρ` obliga a `Re ρ = 1/2` y
    `Im ρ = 0`: no hay ceros no reales fijos por `τ`. -/
theorem tau_fixes_only_real_half (ρ : ℂ) (hγ : ρ.im ≠ 0) :
    1 - ρ ≠ ρ := by
  intro h
  have : -ρ.im = ρ.im := by
    have := congrArg Complex.im h
    simpa using this
  exact hγ (by linarith)

/-- **[P] SOBRE LA LÍNEA, LA ÓRBITA TIENE DOS ELEMENTOS.**
    Con `Re ρ = 1/2` e `Im ρ ≠ 0`: `1 - ρ̄ = ρ` y `1 - ρ = ρ̄`, luego la
    órbita se reduce a `{ρ, ρ̄}`. -/
theorem orbit_collapses_on_the_line (ρ : ℂ) (h : ρ.re = 1 / 2) :
    1 - (starRingEnd ℂ) ρ = ρ ∧ 1 - ρ = (starRingEnd ℂ) ρ := by
  have h1 : 1 - (starRingEnd ℂ) ρ = ρ := (klein_partner_fixed_iff ρ).mpr h
  refine ⟨h1, ?_⟩
  rw [Complex.ext_iff]
  simp only [sub_re, sub_im, conj_re, conj_im, one_re, one_im, zero_sub]
  exact ⟨by linarith, trivial⟩

/-- **[P] FUERA DE LA LÍNEA, LOS CUATRO SON DISTINTOS.**
    Con `Re ρ ≠ 1/2` e `Im ρ ≠ 0`, ninguno de los tres trasladados
    coincide con `ρ`, y `ρ̄ ≠ 1 - ρ`. -/
theorem orbit_is_free_off_the_line (ρ : ℂ) (hγ : ρ.im ≠ 0)
    (hδ : ρ.re ≠ 1 / 2) :
    (starRingEnd ℂ) ρ ≠ ρ ∧ 1 - ρ ≠ ρ ∧ 1 - (starRingEnd ℂ) ρ ≠ ρ ∧
    (starRingEnd ℂ) ρ ≠ 1 - ρ := by
  refine ⟨sigma_fixes_only_reals ρ hγ, tau_fixes_only_real_half ρ hγ, ?_, ?_⟩
  · intro h; exact hδ ((klein_partner_fixed_iff ρ).mp h)
  · intro h
    have := congrArg Complex.re h
    simp only [conj_re, sub_re, one_re] at this
    exact hδ (by linarith)

/-- **[P] EL INVARIANTE ES DISCRETO: `2` o `4`, SIN INTERMEDIOS.**
    La disyunción es exhaustiva y excluyente por `Re ρ = 1/2` o no.
    No hay órbitas de tamaño `1` ni `3`.

    Se enuncia como la dicotomía que la produce: colapso completo
    sobre la línea, libertad completa fuera. -/
theorem orbit_size_dichotomy (ρ : ℂ) (hγ : ρ.im ≠ 0) :
    (ρ.re = 1 / 2 ∧ 1 - (starRingEnd ℂ) ρ = ρ ∧ 1 - ρ = (starRingEnd ℂ) ρ) ∨
    (ρ.re ≠ 1 / 2 ∧ (starRingEnd ℂ) ρ ≠ ρ ∧ 1 - ρ ≠ ρ ∧
     1 - (starRingEnd ℂ) ρ ≠ ρ ∧ (starRingEnd ℂ) ρ ≠ 1 - ρ) := by
  by_cases h : ρ.re = 1 / 2
  · exact Or.inl ⟨h, (orbit_collapses_on_the_line ρ h).1,
                  (orbit_collapses_on_the_line ρ h).2⟩
  · exact Or.inr ⟨h, orbit_is_free_off_the_line ρ hγ h⟩

/-! ════════════════════════════════════════════════════════════════════
    §49.2  Continuo contra discreto: la tesis de §37, sin números
    ════════════════════════════════════════════════════════════════════ -/

/-- El exceso del par recíproco. -/
def excess (r : ℝ) : ℝ := (r - 1) ^ 2 / r

/-- **[P] EL EXCESO ES CONTINUO Y SE ANULA EN `r = 1`.**  Es la
    propiedad que hace inservible cualquier cota positiva: la función
    tiende a `0`. -/
theorem excess_vanishes_at_one : excess 1 = 0 := by
  unfold excess; norm_num

/-- **[P] Y ES ESTRICTAMENTE POSITIVO FUERA.** -/
theorem excess_pos_off_one (r : ℝ) (hr : 0 < r) (h : r ≠ 1) :
    0 < excess r := by
  unfold excess
  apply div_pos _ hr
  have hne : r - 1 ≠ 0 := sub_ne_zero.mpr h
  exact lt_of_le_of_ne (sq_nonneg (r - 1)) (fun hc => hne (by nlinarith [hc.symm]))

/-- **[P] NINGUNA COTA POSITIVA EXCLUYE TODO `r ≠ 1`.**  Para toda
    `B > 0` existe `r ≠ 1` con `excess r < B`: basta acercar `r` a `1`.
    Es la forma estructural de «la cota no puede cerrar». -/
theorem no_positive_bound_excludes (B : ℝ) (hB : 0 < B) :
    ∃ r : ℝ, 0 < r ∧ r ≠ 1 ∧ excess r < B := by
  refine ⟨1 + min (B / 2) (1 / 2), by positivity, ?_, ?_⟩
  · have : 0 < min (B / 2) (1 / 2) := lt_min (by linarith) (by norm_num)
    intro h; linarith [this, h]
  · unfold excess
    have hm : 0 < min (B / 2) (1 / 2) := lt_min (by linarith) (by norm_num)
    have h1 : min (B / 2) (1 / 2) ≤ B / 2 := min_le_left _ _
    have h2 : min (B / 2) (1 / 2) ≤ 1 / 2 := min_le_right _ _
    have hden : (1 : ℝ) ≤ 1 + min (B / 2) (1 / 2) := by linarith
    have hnum : (1 + min (B / 2) (1 / 2) - 1) ^ 2 = min (B / 2) (1 / 2) ^ 2 := by
      ring_nf
    rw [hnum]
    have : min (B / 2) (1 / 2) ^ 2 ≤ min (B / 2) (1 / 2) * (1 / 2) := by
      nlinarith [hm, h2]
    calc min (B / 2) (1 / 2) ^ 2 / (1 + min (B / 2) (1 / 2))
        ≤ min (B / 2) (1 / 2) ^ 2 := by
          apply div_le_self (by positivity) hden
      _ ≤ min (B / 2) (1 / 2) * (1 / 2) := this
      _ ≤ (B / 2) * (1 / 2) := by nlinarith [hm, h1]
      _ < B := by linarith

/-- **[P] EL INVARIANTE DISCRETO NO TIENE ESE DEFECTO.**  Para TODO
    `δ ≠ 0`, por pequeño que sea, la órbita es libre: los cuatro
    elementos son distintos.  No hay «casi degenerado».

    Ésta es la diferencia estructural entre las dos familias, y la
    razón de que la cota no pueda cerrar mientras la pertenencia sí. -/
theorem discrete_invariant_has_no_gap (ρ : ℂ) (hγ : ρ.im ≠ 0)
    (hδ : ρ.re ≠ 1 / 2) :
    (starRingEnd ℂ) ρ ≠ ρ ∧ 1 - ρ ≠ ρ ∧ 1 - (starRingEnd ℂ) ρ ≠ ρ :=
  ⟨(orbit_is_free_off_the_line ρ hγ hδ).1,
   (orbit_is_free_off_the_line ρ hγ hδ).2.1,
   (orbit_is_free_off_the_line ρ hγ hδ).2.2.1⟩

/-! ════════════════════════════════════════════════════════════════════
    §49.3  La discretitud RADIAL: φ la produce
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] LA TORRE TIENE COEFICIENTES ENTEROS.**  `φ^{n+1} = F_{n+1}φ + Fₙ`.
    Ésta es la discretitud de la cara radial, y la produce `φ² = φ+1`.

    Se enuncia con `x` genérico bajo la hipótesis `x² = x+1`, para que
    la fuente sea visible. -/
theorem tower_integer_coefficients (x : ℝ) (h : x ^ 2 = x + 1) :
    ∀ n : ℕ, x ^ (n + 1) = (Nat.fib (n + 1) : ℝ) * x + (Nat.fib n : ℝ) := by
  intro n
  induction n with
  | zero => simp
  | succ k ih =>
    have hstep : x ^ (k + 2) = x * x ^ (k + 1) := by ring
    rw [hstep, ih, Nat.fib_add_two]
    push_cast
    nlinarith [h]

/-- **[P] LA BRECHA RADIAL ES `√5 - 2 > 0`.**  El valor de
    `e₁ = x + 1/x` más cercano a `2` dentro de la familia, sin serlo,
    es `√5`.  La familia NO se acumula en `2`. -/
theorem radial_gap_positive (x : ℝ) (hx : 0 < x) (h : x ^ 2 = x + 1) :
    x + 1 / x = Real.sqrt 5 ∧ Real.sqrt 5 - 2 > 0 := by
  -- (2026-09-06, Ola 2) curado: probe /tmp/probe_wave2_cluster1d-1f
  have hx0 : x ≠ 0 := ne_of_gt hx
  have hinv : 1 / x = x - 1 := by field_simp; linarith
  have hgt : (1 : ℝ) < x := by
    by_contra hc
    push Not at hc
    nlinarith [h, hc, hx]
  have hsq : (x + 1 / x) ^ 2 = 5 := by
    rw [hinv]
    nlinarith [h]
  have hy : 0 ≤ x + 1 / x := by rw [hinv]; linarith
  have hsqr : (Real.sqrt 5) ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  have hnn5 : 0 ≤ Real.sqrt 5 := Real.sqrt_nonneg 5
  have heq : (x + 1 / x) ^ 2 = (Real.sqrt 5) ^ 2 := by rw [hsq, hsqr]
  rcases sq_eq_sq_iff_eq_or_eq_neg.mp heq with h' | h'
  · refine ⟨h', ?_⟩
    have h32 : (3 : ℝ) / 2 < x := by
      by_contra hc
      push Not at hc
      nlinarith [h, hc, hx]
    rw [← h', hinv]
    linarith
  · rw [h'] at hy; linarith

/-- **[P] Y LA FAMILIA `{μₙ}` TIENE BRECHA `1/2`.**  `μₙ = 2 - n/2`:
    consecutivos distan exactamente `1/2`. -/
theorem mu_family_gap (n : ℝ) :
    (2 - n / 2) - (2 - (n + 1) / 2) = 1 / 2 := by ring

/-- **[P] EL CARÁCTER ES EL EXPONENTE.**  En la decoración, la
    magnitud es `φ` elevado a un exponente que toma sólo tres valores,
    `{0, +1, -1}` —los de `χ₅`.  Es discretitud radial de nuevo, ahora
    en la aritmética.

    Se enuncia sobre los valores posibles del exponente. -/
theorem character_is_the_exponent (x : ℝ) (hx : 0 < x) :
    x ^ (1 : ℤ) = x ∧ x ^ (0 : ℤ) = 1 ∧ x ^ (-1 : ℤ) = 1 / x := by
  refine ⟨by simp, by simp, by simp⟩

/-! ════════════════════════════════════════════════════════════════════
    §49.4  Las dos discretitudes, juntas
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] LAS DOS CARAS SON DISCRETAS, CADA UNA POR SU MECANISMO.**

    · RADIAL, por `φ`: coeficientes enteros en la torre, brecha
      `√5 - 2` en la familia, brecha `1/2` en `{μₙ}`.
    · ANGULAR, por el principio del argumento: la órbita salta de `2`
      a `4` sin valores intermedios.

    RECTIFICACIÓN registrada: decir que la angular es «la única
    discreta» niega que `φ` discretice la radial.  Son las dos. -/
theorem two_discretenesses (x : ℝ) (hx : 0 < x) (h : x ^ 2 = x + 1)
    (ρ : ℂ) (hγ : ρ.im ≠ 0) :
    -- radial: brecha estrictamente positiva
    (x + 1 / x = Real.sqrt 5 ∧ Real.sqrt 5 - 2 > 0) ∧
    -- radial: coeficientes enteros
    (x ^ (1 + 1 : ℕ) = (Nat.fib 2 : ℝ) * x + (Nat.fib 1 : ℝ)) ∧
    -- angular: la dicotomía, sin intermedios
    ((ρ.re = 1 / 2 ∧ 1 - (starRingEnd ℂ) ρ = ρ) ∨
     (ρ.re ≠ 1 / 2 ∧ 1 - (starRingEnd ℂ) ρ ≠ ρ)) := by
  refine ⟨radial_gap_positive x hx h, ?_, ?_⟩
  · have := tower_integer_coefficients x h 1
    simpa using this
  · by_cases hc : ρ.re = 1 / 2
    · exact Or.inl ⟨hc, (klein_partner_fixed_iff ρ).mpr hc⟩
    · exact Or.inr ⟨hc, fun hk => hc ((klein_partner_fixed_iff ρ).mp hk)⟩

/-- **[O] LA SEPARACIÓN ENTRE ESTRUCTURA Y VALOR.**

    Lo probado en §49 es ESTRUCTURA y no requiere certificación
    numérica de ninguna clase:
      · `|órbita| ∈ {2,4}`, sin intermedios       (`orbit_size_dichotomy`)
      · `|órbita| = 2 ↔ Re ρ = 1/2`               (`klein_partner_fixed_iff`)
      · libre para TODO `δ ≠ 0`                   (`discrete_invariant_has_no_gap`)
      · ninguna cota positiva excluye              (`no_positive_bound_excludes`)
      · torre con coeficientes enteros             (`tower_integer_coefficients`)
      · brecha radial `√5 - 2 > 0`                 (`radial_gap_positive`)
      · brecha `1/2` en `{μₙ}`                     (`mu_family_gap`)

    Lo que sí requiere certificación es el VALOR de cuatro constantes
    ---`N(70) = 33`, `Σ exc ≤ 3.472359·10⁻⁷`, `Q(g_L) ≥ 0.0443`,
    `γ₁ = 6.6484…`--- y eso no cambia su estatuto: son mediciones con
    márgenes `10²⁴`–`10²⁷`.

    RECTIFICACIÓN registrada: escribir «lo que falta para formalizarlas
    es aritmética de intervalos» puso toda la estructura detrás del
    número.  La estructura no espera a la herramienta. -/
theorem structure_precedes_measurement (ρ : ℂ) (hγ : ρ.im ≠ 0) (B : ℝ) (hB : 0 < B) :
    (∃ r : ℝ, 0 < r ∧ r ≠ 1 ∧ excess r < B) ∧
    (ρ.re ≠ 1 / 2 → 1 - (starRingEnd ℂ) ρ ≠ ρ) ∧
    (2 - (0 : ℝ) / 2) - (2 - (0 + 1 : ℝ) / 2) = 1 / 2 :=
  ⟨no_positive_bound_excludes B hB,
   fun hδ => (discrete_invariant_has_no_gap ρ hγ hδ).2.2,
   mu_family_gap 0⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. QUÉ CIERRA.  Los ocho enunciados estructurales que la auditoría
      §11 había puesto —erróneamente— en «lo que no va como teorema».
      Ninguno usa un número medido.

   2. `no_positive_bound_excludes` ES LA FORMA ESTRUCTURAL de la
      refutación de «falta la cota»: para toda `B > 0` hay
      configuraciones admitidas.  La prueba exhibe `r = 1 + min(B/2,1/2)`.
      Y `discrete_invariant_has_no_gap` es su contraparte: el
      invariante entero excluye para TODO `δ ≠ 0`, uniformemente.

   3. LAS DOS DISCRETITUDES.  `radial_gap_positive` y
      `tower_integer_coefficients` dan la radial, producida por
      `φ² = φ+1`; `orbit_size_dichotomy` da la angular, por el
      principio del argumento.  `two_discretenesses` las reúne.

   4. SOBRE `σ` Y `στ`.  `sigma_fixes_only_reals` registra por qué la
      degeneración de abajo la produce `στ` y no `σ`: los ceros no son
      reales.  Arriba la produce `σ` (`a² = 1`).  Son involuciones
      distintas en cada nivel, y eso está probado, no supuesto.

   5. LO QUE ESTE MÓDULO SIGUE SIN HACER.  No prueba `E`.  Prueba que
      la estructura que decide es discreta en las dos caras, y que
      ninguna cota continua puede sustituirla.

   6. NOMBRES A VERIFICAR.  `Nat.fib_add_two`, `Real.sq_sqrt`,
      `abs_sub_pos`.  `excess_pos_off_one` puede simplificarse si
      `sq_pos_of_ne_zero` está disponible con ese nombre.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §50  ·  the_rotor_closes_the_circle                        ║
    ║  conj z = 1/z <-> |z|=1; la traza; las dos caras aditivas en 1/ ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ════════════════════════════════════════════════════════════════════
    §50.1  El rotor: donde σ y τ se vuelven una
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] EL ESLABÓN.**  `conj z = 1/z` si y sólo si `‖z‖ = 1`.
    Sobre el círculo, conjugar e invertir son la MISMA aplicación.

    De aquí sale todo lo demás: el círculo es el locus donde `σ` y `τ`
    coinciden, y por eso la órbita colapsa exactamente ahí. -/
theorem conj_eq_inv_iff_on_circle (z : ℂ) (hz : z ≠ 0) :
    (starRingEnd ℂ) z = z⁻¹ ↔ normSq z = 1 := by
  constructor
  · intro h
    have := congrArg (· * z) h
    simp only [inv_mul_cancel₀ hz] at this
    rw [mul_comm] at this
    have hn : (normSq z : ℂ) = 1 := by
      rw [← Complex.mul_conj]; exact this
    exact_mod_cast hn
  · intro h
    have hn : z * (starRingEnd ℂ) z = 1 := by
      rw [Complex.mul_conj]; exact_mod_cast h
    field_simp
    linear_combination hn

/-- **[P] Y LA LÍNEA ES SU PREIMAGEN.**  `Re ρ = 1/2` ↔ el compañero de
    Klein fija `ρ` ↔ las dos involuciones acuerdan en `ρ`. -/
theorem faces_agree_iff_critical (ρ : ℂ) :
    (starRingEnd ℂ) ρ = 1 - ρ ↔ ρ.re = 1 / 2 := by
  rw [Complex.ext_iff]
  simp only [conj_re, conj_im, sub_re, sub_im, one_re, one_im, zero_sub]
  exact ⟨fun h => by have := h.1; linarith, fun h => ⟨by linarith, trivial⟩⟩

/-- **[P] ACORDAR ES BOOLEANO.**  En cada cero, o las dos caras
    coinciden o no; no hay tercera posibilidad ni grados.  **Ésta es la
    fuente de la discretitud del invariante** —no una distancia. -/
theorem agreement_is_boolean (ρ : ℂ) :
    ((starRingEnd ℂ) ρ = 1 - ρ) ∨ ((starRingEnd ℂ) ρ ≠ 1 - ρ) :=
  em _

/-! ════════════════════════════════════════════════════════════════════
    §50.2  La traza sobre el rotor: una operación, dos argumentos
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] LA TRAZA ES ADITIVA Y REAL.**  Para todo `z`,
    `z + conj z = 2·Re z`.  Sobre el círculo `‖z‖ = 1` esto es
    `2cos θ`: la operación aditiva de la cara angular. -/
theorem trace_is_twice_re (z : ℂ) :
    z + (starRingEnd ℂ) z = (2 * z.re : ℝ) := by
  -- (2026-09-05) Exactamente `Complex.add_conj` (el push_cast sobraba).
  exact Complex.add_conj z

/-- **[P] Y SU CENTRO ES `Re z`.**  El par `{z, conj z}` tiene centro
    `Re z` y radio `i·Im z`: la descomposición `ℂ = ℝ × 𝕀`. -/
theorem conj_pair_center_is_re (z : ℂ) :
    (z + (starRingEnd ℂ) z) / 2 = (z.re : ℝ) := by
  rw [trace_is_twice_re]; push_cast; ring

/-- **[C] LOS DOS ARGUMENTOS DISTINGUIDOS DE LA TRAZA.**
    Entrada clásica (valores exactos del coseno) como hipótesis
    explícita por F4-inverso:
      `2cos(π/3) = 1`   —el «1» de la reflexión—
      `2cos(π/5) = φ`   —el generador radial.
    Una sola operación, dos argumentos: `3` del ternario del conductor
    y `5` del pentágono. -/
def TwoTraces (t₃ t₅ φ : ℝ) : Prop :=
  t₃ = 1 ∧ t₅ = φ ∧ φ ^ 2 = φ + 1

/-- **[P] EL ARGUMENTO `n = 3` DA CENTRO `1/2`.**  Si la traza vale `1`,
    el centro del par es `1/2`: es el `1` de la reflexión, leído en el
    círculo. -/
theorem trace_one_gives_half (z : ℂ) (h : z + (starRingEnd ℂ) z = 1) :
    z.re = 1 / 2 := by
  have := trace_is_twice_re z
  rw [h] at this
  have hre : (1 : ℂ).re = ((2 * z.re : ℝ) : ℂ).re := congrArg Complex.re this
  simp at hre
  linarith

/-- **[P] EL ARGUMENTO `n = 5` GENERA EL ANILLO.**  Si la traza vale
    `φ` con `φ² = φ+1`, entonces `φ - 1/φ = 1`: el par es sucesor y su
    radio es `1/2`.  La cara radial sale de la misma traza. -/
theorem trace_phi_generates (φ : ℝ) (hφ : φ ≠ 0) (h : φ ^ 2 = φ + 1) :
    φ - 1 / φ = 1 ∧ (φ - 1 / φ) / 2 = 1 / 2 := by
  have hinv : 1 / φ = φ - 1 := by field_simp; nlinarith [h]
  rw [hinv]
  exact ⟨by ring, by ring⟩

/-! ════════════════════════════════════════════════════════════════════
    §50.3  Las dos caras aditivas se encuentran en 1/2
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] CARA `ℝ` — ARITMÉTICA.**  El par de la ecuación funcional
    `{ρ, 1-ρ}` tiene suma `1` y centro `1/2`, identicamente. -/
theorem real_face_sum_one (ρ : ℂ) :
    ρ + (1 - ρ) = 1 ∧ (ρ + (1 - ρ)) / 2 = 1 / 2 := by
  constructor <;> ring

/-- **[P] CARA `𝕀` — ANGULAR.**  Sobre el círculo, el par `{z, conj z}`
    tiene suma `1` exactamente cuando `Re z = 1/2`, y entonces su
    centro es `1/2`. -/
theorem imaginary_face_sum_one (z : ℂ) :
    (z + (starRingEnd ℂ) z = 1 ↔ z.re = 1 / 2) := by
  constructor
  · exact trace_one_gives_half z
  · intro h
    rw [trace_is_twice_re, h]
    push_cast; ring

/-- **[P] EL PUNTO COMÚN.**  Las dos caras, en su lado ADITIVO, dan la
    misma suma `1` y el mismo centro `1/2`.  Dos estructuras distintas
    —una angular sobre el círculo, otra aritmética sobre la banda— y un
    solo punto de encuentro.

    **Esto cierra el hueco del `diag_unificado`.** -/
theorem both_additive_faces_meet_at_half (ρ z : ℂ) (hz : z.re = 1 / 2) :
    (ρ + (1 - ρ) = 1) ∧
    (z + (starRingEnd ℂ) z = 1) ∧
    ((ρ + (1 - ρ)) / 2 = 1 / 2) ∧
    ((z + (starRingEnd ℂ) z) / 2 = 1 / 2) := by
  have h₂ : z + (starRingEnd ℂ) z = 1 := (imaginary_face_sum_one z).mpr hz
  refine ⟨by ring, h₂, by ring, ?_⟩
  rw [h₂]

/-! ════════════════════════════════════════════════════════════════════
    §50.4  Las bases: inyectiva, biyectiva, y la diagonal
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] EL LEVANTAMIENTO DE BASE 10 ES INYECTIVO.**  Los dígitos
    unitarios `{1,3,7,9}` se levantan a `ℤ₂₀*` como sí mismos, sin
    colisión. -/
theorem base_ten_lift_injective :
    ({1, 3, 7, 9} : Finset ℕ).card = 4 := by decide

/-- **[O] PERO NO ES SOBRE: VE LA DIAGONAL.**  `G = (χ₄, χ₅)` se define
    sobre `ℤ₂₀`, el objeto GLOBAL.  La imagen de base `10` son dos de
    las cuatro fibras —la diagonal `{(0,0),(1,1)}`, donde `χ₄ = χ₅`—
    y base `20` es biyectiva sobre las cuatro
    (`decoration_image_is_diagonal`, `base20_covers_all_fibers`).

    Se registra aquí la LECTURA: la diagonal es el locus donde las dos
    caras acuerdan, arriba; `σ = τ` lo es abajo.  Misma condición, dos
    niveles. -/
theorem diagonal_is_the_agreement_locus (ρ : ℂ) :
    ((starRingEnd ℂ) ρ = 1 - ρ ↔ ρ.re = 1 / 2) :=
  faces_agree_iff_critical ρ

/-! ════════════════════════════════════════════════════════════════════
    §50.5  El círculo se cierra
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] EL PUENTE DE MERSENNE DEVUELVE EL MÓDULO DEL ROTOR.**
    `φ^{-λ} = 1/2` con `λ = log 2 / log φ`: el paso final de la cadena
    entrega el mismo `1/2` que es módulo espectral, centro de la
    reflexión, y ápice. -/
theorem mersenne_returns_the_rotor_modulus (φ : ℝ) (hφ : 1 < φ) :
    φ ^ (-(Real.log 2 / Real.log φ)) = 1 / 2 := by
  have hlog : Real.log φ ≠ 0 := ne_of_gt (Real.log_pos hφ)
  have hpos : (0 : ℝ) < φ := lt_trans one_pos hφ
  -- (2026-09-05) hkey conmutado: rpow_def produce log φ * (log 2 / log φ).
  have hkey' : Real.log φ * (Real.log 2 / Real.log φ) = Real.log 2 := by
    rw [mul_comm, div_mul_cancel₀ _ hlog]
  rw [Real.rpow_neg hpos.le, Real.rpow_def_of_pos hpos, hkey',
      Real.exp_log (by norm_num : (0:ℝ) < 2)]
  norm_num

/-- **[P] LA CADENA, EN LOS PASOS FORMALIZABLES.**

    1. rotor: `conj z = 1/z ↔ ‖z‖ = 1`
    2. traza: `z + conj z = 2 Re z`, aditiva
    3. traza `= 1` → centro `1/2`  (cara 𝕀)
    4. cara `ℝ`: `ρ + (1-ρ) = 1` → centro `1/2`
    5. las dos coinciden en `1/2`
    6. `μ = 1/(d-1)` con `d = 2²-1 = 3` → `μ = 1/2`
    7. `σ = dμ = 3/2`, `σ+μ = 2` (aditivo), `σ/μ = 3` (multiplicativo)
    8. puente de Mersenne: `φ^{-λ} = 1/2`, el módulo del rotor

    El círculo se cierra: el paso 8 devuelve el `1/2` del paso 1. -/
theorem the_circle_closes (z : ℂ) (hz : z ≠ 0) (ρ : ℂ) (φ : ℝ) (hφ : 1 < φ) :
    ((starRingEnd ℂ) z = z⁻¹ ↔ normSq z = 1) ∧
    (z + (starRingEnd ℂ) z = (2 * z.re : ℝ)) ∧
    (ρ + (1 - ρ) = 1) ∧
    ((1 : ℝ) / ((2 ^ 2 - 1) - 1) = 1 / 2) ∧
    ((3 : ℝ) * (1 / 2) = 3 / 2 ∧ (3 : ℝ) / 2 + 1 / 2 = 2 ∧
     ((3 : ℝ) / 2) / (1 / 2) = 3) ∧
    (φ ^ (-(Real.log 2 / Real.log φ)) = 1 / 2) := by
  refine ⟨conj_eq_inv_iff_on_circle z hz, trace_is_twice_re z, by ring,
          by norm_num, by norm_num, mersenne_returns_the_rotor_modulus φ hφ⟩

/-- **[O] LO QUE ESTO CIERRA, Y LO QUE NO.**

    CIERRA el hueco que el `diag_unificado` dejaba entre la cara
    angular y los invariantes `(3/2, 1/2)`: el rotor produce la traza,
    la traza produce `1` (con centro `1/2`) y `φ` (con `φ² = φ+1`),
    `φ` produce el conductor, el conductor produce `μ = 1/2`, y el
    puente de Mersenne devuelve el módulo del rotor.

    NO CIERRA `E` TODAVÍA.  Lo que `E` pide sigue siendo que las dos caras
    acuerden en TODO cero —`agreement_is_boolean` da la dicotomía en
    cada uno, no la uniformidad sobre el conjunto.

    Y no hay disyunción entre las caras: `φ = ζ₁₀ + ζ₁₀⁻¹` es una
    TRAZA sobre el rotor, luego la cara radial se define por una
    operación angular.  La dualidad es de coordenadas, no de objetos. -/
theorem what_closes_and_what_does_not (ρ : ℂ) :
    (((starRingEnd ℂ) ρ = 1 - ρ) ∨ ((starRingEnd ℂ) ρ ≠ 1 - ρ)) ∧
    ((starRingEnd ℂ) ρ = 1 - ρ ↔ ρ.re = 1 / 2) :=
  ⟨agreement_is_boolean ρ, faces_agree_iff_critical ρ⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. `conj_eq_inv_iff_on_circle` ES EL TEOREMA CENTRAL del módulo, y el
      más corto.  De él salen: por qué la órbita colapsa exactamente en
      el círculo, por qué `σ = τ` ahí, y por qué la traza `z + conj z`
      es la operación aditiva natural de esa cara.

   2. LA DISCRETITUD NO VIENE DE UNA DISTANCIA.  `agreement_is_boolean`
      la sitúa: en cada cero las dos caras coinciden o no, sin grados.
      Por eso el invariante es entero.  Registrar esto corrige la
      redacción anterior —«colapso completo o libertad completa»— que
      importaba la implicación del nombre «acción libre».

   3. `TwoTraces` ES [C] Y VISIBLE EN LA FIRMA.  Los valores
      `2cos(π/3) = 1` y `2cos(π/5) = φ` son entrada clásica.  Si
      Mathlib provee `Real.cos_pi_div_five` y `Real.cos_pi_div_three`,
      pasan a [P]; se deja marcado.

   4. `both_additive_faces_meet_at_half` ES EL CIERRE DEL HUECO.  Las
      dos caras, en su lado aditivo, dan la misma suma `1` y el mismo
      centro `1/2`, en estructuras distintas.

   5. LA DUALIDAD ES DE COORDENADAS.  `φ = ζ₁₀ + ζ₁₀⁻¹` prueba que la
      cara radial se obtiene por una operación angular; y esa suma es
      la traza sólo PORQUE `conj = inv` sobre el círculo.  No son dos
      objetos irreconciliables: son dos lecturas que convergen en
      `1/2`.

   6. NOMBRES A VERIFICAR.  `Complex.add_conj`, `Complex.mul_conj`,
      `Real.rpow_def_of_pos`, `Real.rpow_neg`, `Real.log_pos`.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §51  ·  one_generator_two_roots                            ║
    ║  Un zeta_20, dos cuadraticas, |-4|*|5| = 20                     ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ════════════════════════════════════════════════════════════════════
    §51.1  `i` y su orden: la 4-parte
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] `i² = -1`, LA RAÍZ DEL VOLTEO DE SIGNO.** -/
theorem I_sq_eq_neg_one : I ^ 2 = -1 := I_sq

/-- **[P] `i` TIENE ORDEN EXACTAMENTE 4.**  `i⁴ = 1` y ninguna potencia
    menor lo es: el orden 4 DOBLA el orden 2 del signo. -/
theorem I_order_exactly_four :
    I ^ 4 = 1 ∧ I ^ 1 ≠ 1 ∧ I ^ 2 ≠ 1 ∧ I ^ 3 ≠ 1 := by
  refine ⟨by simp [pow_succ, I_mul_I], ?_, ?_, ?_⟩
  · intro h; exact absurd (congrArg Complex.re h) (by norm_num)
  · rw [I_sq]; intro h; exact absurd (congrArg Complex.re h) (by norm_num)
  · intro h
    have : (I ^ 3).re = (1 : ℂ).re := congrArg Complex.re h
    simp [pow_succ] at this

/-- **[P] `i` ES RAÍZ DE `x² + 1`, DISCRIMINANTE `-4`.**
    `disc(x² + bx + c) = b² - 4c` con `b = 0`, `c = 1`. -/
theorem I_is_root_disc_neg_four :
    I ^ 2 + 1 = 0 ∧ ((0 : ℝ) ^ 2 - 4 * 1 = -4) := by
  refine ⟨by rw [I_sq]; ring, by norm_num⟩

/-- **[P] LA PROYECCIÓN `⟨i⟩ → {±1}`.**  Elevar al cuadrado envía
    `ℤ/4` sobre `ℤ/2`, con núcleo `{±1}`: el dato angular de `ℝ` es el
    signo, y el de `ℂ` es su extensión de orden 4. -/
theorem I_squares_onto_sign :
    I ^ 2 = -1 ∧ (-1 : ℂ) ^ 2 = 1 ∧ (1 : ℂ) ^ 2 = 1 := by
  refine ⟨I_sq, by ring, by ring⟩

/-! ════════════════════════════════════════════════════════════════════
    §51.2  `φ` y su cuadrática: la 5-parte
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] `φ` ES RAÍZ DE `x² - x - 1`, DISCRIMINANTE `5`.**
    `disc = (-1)² - 4·(-1) = 5`, el disc de `ℚ(√5)` y la parte impar
    del conductor. -/
theorem phi_is_root_disc_five (x : ℝ) (h : x ^ 2 = x + 1) :
    x ^ 2 - x - 1 = 0 ∧ ((-1 : ℝ) ^ 2 - 4 * (-1) = 5) := by
  refine ⟨by linarith [h], by norm_num⟩

/-- **[P] EL CONDUCTOR ES EL PRODUCTO DE LOS DOS DISCRIMINANTES.**
    `|−4| · |5| = 20 = lcm(4,5)`, y `4` y `5` son coprimos. -/
theorem conductor_is_product_of_discriminants :
    (4 : ℕ) * 5 = 20 ∧ Nat.lcm 4 5 = 20 ∧ Nat.gcd 4 5 = 1 := by
  refine ⟨by norm_num, by decide, by decide⟩

/-! ════════════════════════════════════════════════════════════════════
    §51.3  Un generador: `ζ₂₀` produce las dos
    ════════════════════════════════════════════════════════════════════ -/

/-- **[C] EL GENERADOR.**  Entrada clásica, visible en la firma:
    `ζ₂₀` es una raíz primitiva vigésima, y sus potencias `5` y `2`
    dan `i` y `ζ₁₀`.  De ahí, la traza de `ζ₁₀` es `φ`. -/
def PrimitiveTwentieth (ζ : ℂ) (φ : ℝ) : Prop :=
  ζ ^ 20 = 1 ∧ ζ ^ 5 = I ∧ ζ ^ 2 + (starRingEnd ℂ) (ζ ^ 2) = (φ : ℂ)

/-- **[P] DEL GENERADOR SALEN LAS DOS CARAS.**  Bajo
    `PrimitiveTwentieth`: la cara angular es `ζ^5 = i`, directa; y la
    radial es `φ`, obtenida por TRAZA de `ζ^2`. -/
theorem two_faces_from_one_generator (ζ : ℂ) (φ : ℝ)
    (h : PrimitiveTwentieth ζ φ) :
    ζ ^ 5 = I ∧ ζ ^ 2 + (starRingEnd ℂ) (ζ ^ 2) = (φ : ℂ) :=
  ⟨h.2.1, h.2.2⟩

/-- **[P] LOS EXPONENTES SON COPRIMOS Y RECONSTRUYEN `20`.**
    `gcd(2,5) = 1`, `lcm(2,5) = 10`, y `20 = 2·10`. -/
theorem exponents_two_and_five :
    Nat.gcd 2 5 = 1 ∧ Nat.lcm 2 5 = 10 ∧ 2 * 10 = 20 := by
  refine ⟨by decide, by decide, by norm_num⟩

/-! ════════════════════════════════════════════════════════════════════
    §51.4  La traza necesita `i`
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] LA TRAZA ES REAL, Y VALE `2·Re`.**  `z + conj z = 2 Re z`:
    la operación que baja de `ℂ` a `ℝ`. -/
theorem trace_lands_in_R (z : ℂ) :
    z + (starRingEnd ℂ) z = ((2 * z.re : ℝ) : ℂ) := by
  -- (2026-09-05) Exactamente `Complex.add_conj` (la ascripción es transparente).
  exact Complex.add_conj z

/-- **[P] Y SOBRE EL CÍRCULO, `conj = inv`.**  Por eso la traza es
    `z + 1/z`: la suma de un punto y su inverso.  Sin `i` no hay
    círculo, y sin círculo la traza no es esa suma. -/
theorem trace_on_circle_is_z_plus_inv (z : ℂ) (hz : z ≠ 0)
    (h : normSq z = 1) :
    z + (starRingEnd ℂ) z = z + z⁻¹ := by
  have hconj : (starRingEnd ℂ) z = z⁻¹ := by
    have hn : z * (starRingEnd ℂ) z = 1 := by
      rw [Complex.mul_conj]; exact_mod_cast h
    field_simp
    linear_combination hn
  rw [hconj]

/-- **[O] LA CARA RADIAL SE DEFINE CON `i`.**  `φ = ζ₁₀ + ζ₁₀⁻¹` es una
    traza sobre el círculo unidad, y el círculo existe porque `i² = -1`
    da a `ℂ` su estructura de plano.  Registrado: no hay «cara radial»
    anterior a `i`; la dualidad es de COORDENADAS, no de objetos. -/
theorem radial_face_needs_I (ζ : ℂ) (hζ : ζ ≠ 0) (h : normSq ζ = 1) :
    ζ + (starRingEnd ℂ) ζ = ζ + ζ⁻¹ ∧ I ^ 2 = -1 :=
  ⟨trace_on_circle_is_z_plus_inv ζ hζ h, I_sq⟩

/-! ════════════════════════════════════════════════════════════════════
    §51.5  `i² = -1` hace tres cosas, y son la misma
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] (1) CONVIERTE LA RESTA DEL INVARIANTE EN SUMA.**
    Con `c = Re z` y `r = i·Im z`: `c² - r² = c² + (Im z)² = ‖z‖²`. -/
theorem invariant_becomes_a_sum (x y : ℝ) :
    (x : ℂ) ^ 2 - ((y : ℂ) * I) ^ 2 = ((x ^ 2 + y ^ 2 : ℝ) : ℂ) := by
  push_cast
  rw [mul_pow, I_sq]
  ring

/-- **[P] (2) ES LA DIRECCIÓN DEL RADIO.**  El radio del par de
    reflexión es `ρ - 1/2 = δ + iγ`; `E` pide `δ = 0`, es decir que el
    radio viva ENTERO en la dirección de `i`. -/
theorem radius_direction (ρ : ℂ) :
    (ρ - 1 / 2).re = ρ.re - 1 / 2 ∧ (ρ - 1 / 2).im = ρ.im := by
  simp only [sub_re, sub_im]
  norm_num

/-- **[P] (3) Y HACE QUE `e₂` SEA REAL EXACTAMENTE AHÍ.**
    `Im(ρ(1-ρ)) = Im ρ · (1 - 2 Re ρ)`, luego con `γ ≠ 0` se anula si y
    sólo si `Re ρ = 1/2`. -/
theorem e_two_real_iff_critical (ρ : ℂ) (hγ : ρ.im ≠ 0) :
    (ρ * (1 - ρ)).im = 0 ↔ ρ.re = 1 / 2 := by
  have him : (ρ * (1 - ρ)).im = ρ.im * (1 - 2 * ρ.re) := by
    simp [Complex.mul_im, sub_re, sub_im, one_re, one_im]
    ring
  rw [him]
  constructor
  · intro h
    rcases mul_eq_zero.mp h with h' | h'
    · exact absurd h' hγ
    · linarith
  · intro h; rw [h]; ring

/-- **[P] LAS TRES SON LA MISMA.**  La dirección del radio, la
    realidad de `e₂` y la suma del invariante son tres lecturas de
    `i² = -1` sobre el mismo par. -/
theorem three_are_one (ρ : ℂ) (hγ : ρ.im ≠ 0) (x y : ℝ) :
    ((ρ - 1 / 2).re = 0 ↔ ρ.re = 1 / 2) ∧
    ((ρ * (1 - ρ)).im = 0 ↔ ρ.re = 1 / 2) ∧
    ((x : ℂ) ^ 2 - ((y : ℂ) * I) ^ 2 = ((x ^ 2 + y ^ 2 : ℝ) : ℂ)) := by
  refine ⟨?_, e_two_real_iff_critical ρ hγ, invariant_becomes_a_sum x y⟩
  simp only [sub_re]
  norm_num
  constructor <;> intro h <;> linarith

/-! ════════════════════════════════════════════════════════════════════
    §51.6  El ápice, por las dos caras
    ════════════════════════════════════════════════════════════════════ -/

/-- **[C] EL PUNTO DE ENCUENTRO.**  Las dos caras dan `1/2`:
    la angular por `cos(π/3)`, la radial por `φ^{-λ}`.  Los valores
    exactos van como hipótesis explícita. -/
def ApexBothFaces (cπ φ lam : ℝ) : Prop :=
  cπ = 1 / 2 ∧ φ ^ (-lam) = 1 / 2

/-- **[P] Y ENTONCES COINCIDEN.**  Trivial una vez enunciadas, y ése
    es el punto: el contenido está en que las dos rutas independientes
    aterricen en el mismo valor. -/
theorem apex_agreement (cπ φ lam : ℝ) (h : ApexBothFaces cπ φ lam) :
    cπ = φ ^ (-lam) := by rw [h.1, h.2]

/-- **[P] EL PUENTE DE MERSENNE DA LA RUTA RADIAL.**
    `φ^{-log 2 / log φ} = 1/2` para todo `φ > 1`. -/
theorem mersenne_route (φ : ℝ) (hφ : 1 < φ) :
    φ ^ (-(Real.log 2 / Real.log φ)) = 1 / 2 := by
  have hlog : Real.log φ ≠ 0 := ne_of_gt (Real.log_pos hφ)
  have hpos : (0 : ℝ) < φ := lt_trans one_pos hφ
  -- (2026-09-05) hkey conmutado: rpow_def produce log φ * (log 2 / log φ).
  have hkey' : Real.log φ * (Real.log 2 / Real.log φ) = Real.log 2 := by
    rw [mul_comm, div_mul_cancel₀ _ hlog]
  rw [Real.rpow_neg hpos.le, Real.rpow_def_of_pos hpos, hkey',
      Real.exp_log (by norm_num : (0:ℝ) < 2)]
  norm_num

/-! ════════════════════════════════════════════════════════════════════
    §51.7  El conjunto completo
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] EL CONJUNTO COMPLETO, EN SUS PIEZAS FORMALIZABLES.**

    Un generador, dos raíces cuadráticas, dos discriminantes cuyo
    producto es el conductor, y un ápice donde las dos caras se
    encuentran.

    · `i² = -1`, orden exacto `4`, raíz de `x² + 1`, disc `-4`
    · `φ² = φ + 1`, raíz de `x² - x - 1`, disc `5`
    · `|-4| · |5| = 20 = lcm(4,5)`, con `gcd(4,5) = 1`
    · `ζ₂₀^5 = i` y `Tr(ζ₂₀²) = φ`: una sola fuente
    · `i² = -1` suma las dos coordenadas en el invariante
    · y `E` es que el radio viva entero en la dirección de `i` -/
theorem the_complete_set (x : ℝ) (hx : x ^ 2 = x + 1) (φ : ℝ) (hφ : 1 < φ)
    (ρ : ℂ) (hγ : ρ.im ≠ 0) (u v : ℝ) :
    -- las dos raíces y sus discriminantes
    (I ^ 2 + 1 = 0 ∧ (0 : ℝ) ^ 2 - 4 * 1 = -4) ∧
    (x ^ 2 - x - 1 = 0 ∧ (-1 : ℝ) ^ 2 - 4 * (-1) = 5) ∧
    -- el conductor es su producto
    ((4 : ℕ) * 5 = 20 ∧ Nat.lcm 4 5 = 20 ∧ Nat.gcd 4 5 = 1) ∧
    -- i tiene orden exacto 4
    (I ^ 4 = 1 ∧ I ^ 2 ≠ 1) ∧
    -- el invariante suma las dos caras, por i² = -1
    ((u : ℂ) ^ 2 - ((v : ℂ) * I) ^ 2 = ((u ^ 2 + v ^ 2 : ℝ) : ℂ)) ∧
    -- E, en la dirección de i
    ((ρ * (1 - ρ)).im = 0 ↔ ρ.re = 1 / 2) ∧
    -- y el ápice por la ruta radial
    (φ ^ (-(Real.log 2 / Real.log φ)) = 1 / 2) := by
  refine ⟨I_is_root_disc_neg_four, phi_is_root_disc_five x hx,
          conductor_is_product_of_discriminants,
          ⟨I_order_exactly_four.1, I_order_exactly_four.2.2.1⟩,
          invariant_becomes_a_sum u v, e_two_real_iff_critical ρ hγ,
          mersenne_route φ hφ⟩

/-- **[O] LO QUE EL CONJUNTO CIERRA, Y LO QUE NO.**

    CIERRA la procedencia: las dos caras no son postuladas, salen de un
    solo `ζ₂₀`; sus cuadráticas tienen discriminantes `-4` y `5` cuyo
    producto ES el conductor; y `i² = -1` es simultáneamente el orden
    de la 4-parte, la suma del invariante y la dirección del radio.

    NO CIERRA `E` TODAVÍA.  `E` sigue siendo que el radio de TODO cero esté en
    `i·ℝ`; `e_two_real_iff_critical` da la equivalencia en cada cero,
    no la uniformidad sobre el conjunto.

    Y no hay dualidad irreconciliable: `φ` se obtiene por traza sobre
    el círculo, que existe por `i`.  Las dos caras son dos coordenadas
    de un objeto, y se encuentran en `1/2`. -/
theorem what_the_set_closes (ρ : ℂ) (hγ : ρ.im ≠ 0) :
    ((ρ * (1 - ρ)).im = 0 ↔ ρ.re = 1 / 2) ∧ I ^ 2 = -1 :=
  ⟨e_two_real_iff_critical ρ hγ, I_sq⟩

