    (Omega_hat k = ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) : ℝ) * w_pcf ^ (k : ℕ)) ∧
    (¬ ∃ n : ℤ, (φ : ℝ) ^ n = 2) :=
  ⟨spectrum_modulus_is_the_anchor k hw,
   spectrum_is_anchor_times_orbit k,
   anchor_is_outside_the_monoid⟩

