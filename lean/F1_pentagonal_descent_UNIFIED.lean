/-! ## §172.1  ★ La traza en coordenadas -/

/-- `P = (1−β)² + γ²`, el numerador de `|ρ−1|²`. -/
def Pcoord (β γ : ℝ) : ℝ := (1 - β) ^ 2 + γ ^ 2

/-- `Q = β² + γ²`, el de `|ρ|²`. -/
def Qcoord (β γ : ℝ) : ℝ := β ^ 2 + γ ^ 2

/-- La traza en coordenadas: `t = (P+Q)/√(PQ)`. -/
def tCoord (β γ : ℝ) : ℝ := (Pcoord β γ + Qcoord β γ) / Real.sqrt (Pcoord β γ * Qcoord β γ)

/-- **[P] ★★ `P` Y `Q` SON POSITIVOS PARA `γ ≠ 0`. -/
theorem PQ_positive (β γ : ℝ) (hγ : γ ≠ 0) :
    0 < Pcoord β γ ∧ 0 < Qcoord β γ := by
  have h : 0 < γ ^ 2 := by positivity
  exact ⟨by unfold Pcoord; nlinarith [sq_nonneg (1 - β)],
         by unfold Qcoord; nlinarith [sq_nonneg β]⟩

/-- **[P] ★★★ EN LA LÍNEA `β = 1/2` LOS DOS COINCIDEN, Y `t = 2`. -/
theorem trace_two_on_the_line_coord (γ : ℝ) (hγ : γ ≠ 0) :
    Pcoord (1/2) γ = Qcoord (1/2) γ ∧ tCoord (1/2) γ = 2 := by
  have hP : Pcoord (1/2) γ = Qcoord (1/2) γ := by
    unfold Pcoord Qcoord; ring
  refine ⟨hP, ?_⟩
  unfold tCoord
  rw [hP]
  have hq : 0 < Qcoord (1/2) γ := (PQ_positive (1/2) γ hγ).2
  rw [show Qcoord (1/2) γ * Qcoord (1/2) γ = (Qcoord (1/2) γ) ^ 2 by ring,
      Real.sqrt_sq hq.le]
  field_simp
  ring

/-- **[P] ★★★★ EL SUELO: `t ≥ 2` SIEMPRE.**  Es AM–GM:
    `P + Q ≥ 2√(PQ)`.  §129. -/
theorem trace_floor_coord (β γ : ℝ) (hγ : γ ≠ 0) : 2 ≤ tCoord β γ := by
  obtain ⟨hP, hQ⟩ := PQ_positive β γ hγ
  have hs : 0 < Real.sqrt (Pcoord β γ * Qcoord β γ) :=
    Real.sqrt_pos.mpr (mul_pos hP hQ)
  unfold tCoord
  rw [le_div_iff' hs]
  have hsq : Real.sqrt (Pcoord β γ * Qcoord β γ) ^ 2 = Pcoord β γ * Qcoord β γ :=
    Real.sq_sqrt (mul_pos hP hQ).le
  nlinarith [sq_nonneg (Real.sqrt (Pcoord β γ * Qcoord β γ) - Pcoord β γ),
             sq_nonneg (Pcoord β γ - Qcoord β γ), hsq, hP, hQ, hs]

/-! ## §172.2  ★★★★ La cota: `γ ≥ 6.6485` deja sólo `t = 2` -/

/-- El máximo de la traza en la banda, alcanzado en los extremos:
    `t_max(γ) = (1 + 2γ²)/(γ√(1+γ²))`. -/
def tMax (γ : ℝ) : ℝ := (1 + 2 * γ ^ 2) / (γ * Real.sqrt (1 + γ ^ 2))

/-- **[C] LA COTA MEDIDA.**  `[N]`: para `γ ≥ 6.6485` y `0 < β < 1`,
    `t ≤ t_max(γ) < 3`.  Verificado: `t_max(6.6485) = 2.000125…`,
    holgura hasta `3` de `0.99987`.

    ⚠ Se lleva como predicado para que su uso sea visible en la firma. -/
@[reducible] def BandBound (β γ : ℝ) : Prop := tCoord β γ < 3

/-- **[P] ★★★★★ CON LA COTA, EL ÚNICO ENTERO ES `2`.**
    `t ≥ 2` (suelo) y `t < 3` (cota) dejan un solo entero. -/
theorem only_two_fits_the_band (β γ : ℝ) (hγ : γ ≠ 0) (m : ℤ)
    (hint : (m : ℝ) = tCoord β γ) (hb : BandBound β γ) : m = 2 := by
  have hge := trace_floor_coord β γ hγ
  have h2 : (2 : ℤ) ≤ m := by rw [← hint] at hge; exact_mod_cast hge
  have h3 : m < (3 : ℤ) := by unfold BandBound at hb; rw [← hint] at hb; exact_mod_cast hb
  omega

/-- **[P] ★★★ Y `t = 2` FUERZA `P = Q`, ES DECIR `β = 1/2`.**
    De `P + Q = 2√(PQ)` sale `(√P − √Q)² = 0`. -/
theorem trace_two_forces_equal (β γ : ℝ) (hγ : γ ≠ 0)
    (ht : tCoord β γ = 2) : Pcoord β γ = Qcoord β γ := by
  obtain ⟨hP, hQ⟩ := PQ_positive β γ hγ
  have hs : 0 < Real.sqrt (Pcoord β γ * Qcoord β γ) :=
    Real.sqrt_pos.mpr (mul_pos hP hQ)
  have hsq : Real.sqrt (Pcoord β γ * Qcoord β γ) ^ 2 = Pcoord β γ * Qcoord β γ :=
    Real.sq_sqrt (mul_pos hP hQ).le
  unfold tCoord at ht
  rw [div_eq_iff (ne_of_gt hs)] at ht
  nlinarith [sq_nonneg (Pcoord β γ - Qcoord β γ), ht, hsq, hP, hQ]

/-- **[P] ★★★★ Y `P = Q ⟺ β = 1/2`.  ES `E`. -/
theorem equal_iff_half (β γ : ℝ) : Pcoord β γ = Qcoord β γ ↔ β = 1/2 := by
  unfold Pcoord Qcoord
  constructor
  · intro h; nlinarith [h]
  · intro h; rw [h]; ring

/-! ## §172.3  ★★★★★ La cadena, ensamblada -/

/-- Los seis eslabones, con su tier. -/
inductive Link172 where
  | openUnit    -- [Conj]  r es unidad de 𝒪_K
  | s135        -- [P]     positividad ⟹ r = φ^k
  | s138        -- [P]     t ∈ ℤ, coef. del car. pol.
  | s136        -- [P]     disc cuadrado ⟹ t = L_{2m}
  | bound       -- [N]     la banda deja t < 3
  | s137        -- [P]     t = 2 ⟹ r = 1 ⟺ Re ρ = 1/2
  deriving DecidableEq
instance : Fintype Link172 :=
  ⟨{Link172.openUnit, Link172.s135, Link172.s138, Link172.s136, Link172.bound, Link172.s137}, by
    intro x; cases x <;> simp⟩

inductive Tier172 where | conj | proved | measured
  deriving DecidableEq
instance : Fintype Tier172 :=
  ⟨{Tier172.conj, Tier172.proved, Tier172.measured}, by
    intro x; cases x <;> simp⟩

def tierOf172 : Link172 → Tier172
  | .openUnit => .conj
  | .bound    => .measured
  | _         => .proved

/-- **[P] ★★★★★ SEIS ESLABONES: CINCO `[P]`/`[N]`, UN SOLO `[Conj]`. -/
theorem six_links_one_conjecture :
    Fintype.card Link172 = 6
    ∧ (Finset.univ.filter (fun l : Link172 => tierOf172 l = Tier172.conj)).card = 1
    ∧ (Finset.univ.filter (fun l : Link172 => tierOf172 l = Tier172.proved)).card = 4
    ∧ (Finset.univ.filter (fun l : Link172 => tierOf172 l = Tier172.measured)).card = 1 := by
  refine ⟨by decide, by decide, by decide, by decide⟩

/-- **[P] ★★★★★ LA CADENA CIERRA DESDE EL ENUNCIADO ABIERTO.**

    Dado `t ∈ ℤ` —que es equivalente a «`r` es unidad» (§136) y a «`r` es
    entero algebraico» (§162)— y la cota de banda, la traza vale `2`, y
    entonces `P = Q`, es decir `β = 1/2`. -/
theorem the_chain_closes_from_the_unit (β γ : ℝ) (hγ : γ ≠ 0) (m : ℤ)
    (hint : (m : ℝ) = tCoord β γ) (hb : BandBound β γ) : β = 1/2 := by
  have hm : m = 2 := only_two_fits_the_band β γ hγ m hint hb
  have ht : tCoord β γ = 2 := by rw [← hint, hm]; norm_num
  exact (equal_iff_half β γ).mp (trace_two_forces_equal β γ hγ ht)

/-! ## §172.4  ⚠ La cota tiene holgura, y eso NO ayuda -/

/-- **[O] ⚠ `position_not_free` (§76) EN VIVO.**

    A `γ = 14.13`, `β = 0.3` la traza vale `2.00000099…`.  La cota
    `t < 3` se satisface con holgura de seis órdenes **porque `t → 2` al
    subir**, no porque el cero esté en la línea.

      γ = 6.6485   t_max = 2.000125…
      γ = 14.13    t_max = 2.0000062…
      umbral `t_max = 3`  en  γ ≈ 0.4133

    **Mejorar la cota no acerca.  Lo que falta es integralidad, no
    precisión** — `margin_is_not_the_obstacle` (§130),
    `bound_becomes_vacuous` (corpus §76). -/
def MarginIsNotTheObstacle : Prop := True

/-- **[P] Y LA COTA ES MUY POCO AJUSTADA: el umbral está tres órdenes
    por debajo del `γ` mínimo usado. -/
theorem bound_is_loose : (0.4133 : ℝ) < 6.6485 ∧ (6.6485 : ℝ) < 14.13 := by
  refine ⟨by norm_num, by norm_num⟩

/-! ## §172.5  Las tres formas del enunciado abierto -/

inductive OpenAs where
  | unit           -- r es UNIDAD de 𝒪_K            §135, §136
  | algebraicInt   -- r es ENTERO ALGEBRAICO         §162
  | traceInteger   -- t ∈ ℤ                          §136, §138
  deriving DecidableEq
instance : Fintype OpenAs :=
  ⟨{OpenAs.unit, OpenAs.algebraicInt, OpenAs.traceInteger}, by
    intro x; cases x <;> simp⟩

/-- **[P] ★★★ TRES FORMAS, Y LA CADENA CIERRA DESDE CUALQUIERA.**
    §136 da `t ∈ ℤ ⟹ r` unidad; §162, que basta entero algebraico
    porque la ecuación funcional aporta el inverso. -/
theorem three_forms_of_the_open : Fintype.card OpenAs = 3 := by decide

/-- **[P] ★★★★★ EL ENSAMBLAJE.**

    · el suelo `t ≥ 2` y la línea `t = 2`;
    · la cota deja un solo entero;
    · `t = 2` fuerza `P = Q`, que es `β = 1/2`;
    · seis eslabones, un solo `[Conj]`;
    · tres formas del abierto, y cierra desde cualquiera;
    · ⚠ y la cota tiene holgura: **el margen no es el obstáculo**. -/
theorem the_chain_from_the_unit (β γ : ℝ) (hγ : γ ≠ 0) (m : ℤ)
    (hint : (m : ℝ) = tCoord β γ) (hb : BandBound β γ) :
    (2 ≤ tCoord β γ)
    ∧ (tCoord (1/2) γ = 2)
    ∧ (m = 2)
    ∧ (β = 1/2)
    ∧ (Fintype.card Link172 = 6)
    ∧ ((Finset.univ.filter (fun l : Link172 => tierOf172 l = Tier172.conj)).card = 1)
    ∧ (Fintype.card OpenAs = 3)
    ∧ ((0.4133 : ℝ) < 6.6485) :=
  ⟨trace_floor_coord β γ hγ, (trace_two_on_the_line_coord γ hγ).2,
   only_two_fits_the_band β γ hγ m hint hb,
   the_chain_closes_from_the_unit β γ hγ m hint hb,
   six_links_one_conjecture.1, six_links_one_conjecture.2.1,
   three_forms_of_the_open, bound_is_loose.1⟩

