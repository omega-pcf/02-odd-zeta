  ⟨companion_flips_height ρ, kmate_keeps_height ρ,
   the_two_maps_differ ρ hγ, link_six_correct ρ r hr⟩

theorem coordinate_gap_is_disc (r : ℝ) (hr : r ≠ 0) :
