/-! ## §122.1  Las componentes son las involuciones -/

/-- **[P] `|V| = 2²` Y TRES NO TRIVIALES.**  Tres involuciones, tres
    componentes de `Ω̂ = (P,C,F)`, y `3 = 2² − 1`. -/
theorem three_involutions_three_components :
    (2 : ℕ) ^ 2 = 4 ∧ (4 : ℕ) - 1 = 3 ∧ (3 : ℕ) = 2 ^ 2 - 1 := by
  refine ⟨by norm_num, by norm_num, by norm_num⟩

/-- **[C] LAS COMPONENTES SON `σ, τ, στ`.**  Entrada del corpus, en
    la firma: no es analogía, son los mismos tres objetos. -/
def ComponentsAreInvolutions (comps invols : ℕ) : Prop :=
  comps = invols ∧ comps = 3

/-- **[P] LUEGO `Ω̂` NO ES UN OBJETO AL LADO DEL GRUPO: ESTÁ HECHO DE
    ÉL.** -/
theorem operator_is_made_of_the_group (c i : ℕ)
    (h : ComponentsAreInvolutions c i) :
    c = i ∧ c = 3 ∧ (3 : ℕ) = 2 ^ 2 - 1 :=
  ⟨h.1, h.2, three_involutions_three_components.2.2⟩

/-! ## §122.2  Y bajan del grado dos -/

/-- **[P] `σ` DE LA REALIDAD DE `χ₅`.**  Restatement de
    `inversion_gives_sigma` (§104). -/
theorem sigma_from_reality :
    ∀ a : ZMod 20, a ∈ ZtwentyStar → chi5at a⁻¹ = chi5at a :=
  inversion_gives_sigma

/-- **[P] `τ` DE LA PARIDAD.**  Restatement de `negation_gives_tau`. -/
theorem tau_from_parity : ∀ a : ZMod 20, chi5at (-a) = chi5at a :=
  negation_gives_tau

/-- **[P] LUEGO LAS COMPONENTES DE `Ω̂` DESCIENDEN DEL GRADO DOS.**
    Como las otras nueve formas (§114): un ingrediente, diez formas. -/
theorem components_descend_from_degree_two :
    (∀ a : ZMod 20, a ∈ ZtwentyStar → chi5at a⁻¹ = chi5at a) ∧
    (∀ a : ZMod 20, chi5at (-a) = chi5at a) ∧
    ((2 : ℕ) ^ 2 = 4) :=
  ⟨sigma_from_reality, tau_from_parity, three_involutions_three_components.1⟩

/-! ## §122.3  El isomorfismo: la norma es el invariante -/

/-- **[P] LOS DOS GENERADORES TIENEN MÓDULO UNO.**  Gauss y
    Eisenstein; la isometría preserva el módulo `1/2`. -/
theorem both_generators_unit :
    ‖Complex.I‖ = 1 ∧ ‖Complex.exp (2 * Real.pi * Complex.I / 3)‖ = 1 := by
  refine ⟨Complex.norm_I, ?_⟩
  rw [Complex.norm_exp]; simp

/-- **[C] Y `‖Ω̂₀‖ = 1/2` ES ESE INVARIANTE.**  Entrada del corpus. -/
def OperatorNormIsTheInvariant (n : ℝ) : Prop := n = 1 / 2

/-- **[P] EL OPERADOR VIVE EN LA ISOMETRÍA.**  Su norma no coincide
    con el invariante por casualidad: **es** el invariante. -/
theorem operator_lives_in_the_isometry (n : ℝ)
    (h : OperatorNormIsTheInvariant n) :
    (n = 1 / 2) ∧ (‖Complex.I‖ = 1) ∧
    (‖Complex.exp (2 * Real.pi * Complex.I / 3)‖ = 1) :=
  ⟨h, both_generators_unit.1, both_generators_unit.2⟩

/-! ## §122.4  La forma es propia: no colapsa -/

/-- **[P] SÓLO LA PATA 2 FACTORIZA POR AUTOVALOR.**  Cada `spec_k` es
    `cara φ × cara π`, con `cara φ = 1/2`:

        `spec₀ = (1/2)·( 1  ) =  1/2`
        `spec₁ = (1/2)·(−1/2) = −1/4`
        `spec₂ = (1/2)·(−1/2) = −1/4`

    Las demás patas dan un número; ésta da TRES, y cada uno
    factorizado. -/
theorem only_leg_two_factorises_per_eigenvalue (v : ℝ) (hv : v = 1 / 2) :
    (v * 1 = 1 / 2) ∧ (v * (-(1 / 2)) = -(1 / 4)) ∧
    (v * 1 + v * (-(1 / 2)) + v * (-(1 / 2)) = 0) := by
  subst hv
  refine ⟨by norm_num, by norm_num, by norm_num⟩

/-- **[O] CUATRO REGISTROS IGUALES, LA FORMA DISTINTA.**

    | registro | para `Ω̂` | con las otras patas |
    |---|---|---|
    | valor | `‖Ω̂₀‖ = 1/2` | IGUAL |
    | ingrediente | traza cero, de `\|V\| = 2²` | IGUAL |
    | isomorfismo | norma `=` invariante | IGUAL |
    | unicidad | otro grado ⟹ otro ápice | IGUAL |
    | **forma** | **operador, 3 autovalores** | **DISTINTA** |

    **Ser parte de la identidad no lo hace prescindible ni
    reducible.**  Es una forma más, irreducible a las otras: es la
    única que factoriza por autovalor. -/
theorem four_equal_one_distinct (v : ℝ) (hv : v = 1 / 2) :
    (v = 1 / 2) ∧
    ((2 : ℕ) ^ 2 = 4) ∧
    (‖Complex.I‖ = 1) ∧
    (v * 1 + v * (-(1 / 2)) + v * (-(1 / 2)) = 0) :=
  ⟨hv, three_involutions_three_components.1, both_generators_unit.1,
   (only_leg_two_factorises_per_eigenvalue v hv).2.2⟩

/-- **[O] EL BALANCE DE §122.**

    Ser pata del cocono hace a `Ω̂` parte de la identidad ---sus
    componentes SON las involuciones que el grado dos produce--- y
    parte del isomorfismo ---su norma ES el invariante de `V†V = 1`.

    Y no colapsa nada: su forma ---operador con espectro que
    factoriza por autovalor--- no la tiene ninguna otra pata.

    **Nada de esto prueba `E`.** -/
theorem the_balance_of_section_122 (v : ℝ) (hv : v = 1 / 2) (c i : ℕ)
    (h : ComponentsAreInvolutions c i) :
    (c = 3) ∧
    (∀ a : ZMod 20, chi5at (-a) = chi5at a) ∧
    (‖Complex.I‖ = 1) ∧
    (v * (-(1 / 2)) = -(1 / 4)) :=
  ⟨h.2, tau_from_parity, both_generators_unit.1,
   (only_leg_two_factorises_per_eigenvalue v hv).2.1⟩

