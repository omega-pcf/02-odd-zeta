-- §169  ·  lo abierto es t ∈ ℤ, no r ∈ {φ^k}
-- ═══════════════════════════════════════════════════════════

/-! ## §169.1  ★★★★ La flecha `t ∈ ℤ ⟹ r ∈ {φ^k}`, sin `[C]` -/

/-- Los seis eslabones de la flecha, con su sección. -/
inductive ArrowStep where
  | disc136      -- §136  disc cuadrado ⟹ r unidad
  | realPart160  -- §160  r real ⟹ r ∈ 𝒪_K ∩ ℝ
  | ring161      -- §161  = ℤ[φ]
  | floor167     -- §167  el despeje ⌊log u/log φ⌋
  | quadrant168  -- §168  la traza cierra los cuadrantes
  | positive135  -- §135  positividad mata el signo
  deriving DecidableEq
instance : Fintype ArrowStep :=
  ⟨{ArrowStep.disc136, ArrowStep.realPart160, ArrowStep.ring161, ArrowStep.floor167, ArrowStep.quadrant168, ArrowStep.positive135}, by
    intro x; cases x <;> simp⟩

def stepIsClassical : ArrowStep → Bool := fun _ => false

/-- **[P] ★★★★★ SEIS ESLABONES, NINGUNO `[C]`.**
    La flecha `t ∈ ℤ ⟹ r ∈ {φ^k}` está probada por la sesión. -/
theorem arrow_has_no_classical_step :
    Fintype.card ArrowStep = 6
    ∧ (Finset.univ.filter (fun s : ArrowStep => stepIsClassical s)).card = 0 := by
  refine ⟨by decide, by decide⟩

/-- **[P] ★★ EL ESLABÓN DE §136, EXPLÍCITO: de `t` salen `r` y `1/r`. -/
theorem trace_reconstructs (r : ℝ) (hr : r ≠ 0) :
    ((r + 1 / r) + (r - 1 / r)) / 2 = r
    ∧ ((r + 1 / r) - (r - 1 / r)) / 2 = 1 / r
    ∧ (r + 1 / r) ^ 2 - 4 = (r - 1 / r) ^ 2 := by
  refine ⟨by ring, by ring, by field_simp; ring⟩

/-! ## §169.2  ★★★ Lo abierto: la traza es entera -/

/-- La traza de la cuadrática mónica `x² − t·x + 1`. -/
def traceOf (r : ℝ) : ℝ := r + 1 / r

/-- **★★★★★ EL ENUNCIADO ABIERTO.**  Es `TheOnlyOpenStatement` de §132.

    Para todo cero `ρ`, la traza `t = r + 1/r` es un ENTERO. -/
def TraceIsInteger (t : ℝ) : Prop := ∃ m : ℤ, (m : ℝ) = t

/-- **[P] ★★★ EL SUELO: `t ≥ 2`, PROBADO.  §129. -/
theorem trace_floor_169 (r : ℝ) (hr : 0 < r) : 2 ≤ traceOf r := by
  unfold traceOf
  have h : r + 1 / r - 2 = (r - 1) ^ 2 / r := by field_simp; ring
  nlinarith [div_nonneg (sq_nonneg (r - 1)) hr.le, h]

/-- **[P] Y LA IGUALDAD CARACTERIZA `r = 1`. -/
theorem trace_two_iff_169 (r : ℝ) (hr : 0 < r) : traceOf r = 2 ↔ r = 1 := by
  unfold traceOf
  have h : r + 1 / r - 2 = (r - 1) ^ 2 / r := by field_simp; ring
  constructor
  · intro ht
    have hz : (r - 1) ^ 2 / r = 0 := by rw [← h, ht]; ring
    have h2 : (r - 1) ^ 2 = 0 := by rw [div_eq_iff (ne_of_gt hr)] at hz; linarith [mul_zero r]
    nlinarith [pow_eq_zero_iff (n := 2) (by norm_num) |>.mp h2]
  · rintro rfl; norm_num

/-! ## §169.3  ★★ El conjunto meta: los Lucas PARES -/

def lucasT : ℕ → ℤ
  | 0 => 2 | 1 => 1 | (n+2) => lucasT (n+1) + lucasT n

/-- **[P] ★★★ EL CONJUNTO META ES `{L_{2m}} = {2, 3, 7, 18, 47, …}`.**
    Sólo los pares, porque la norma de `r` es `+1` (§132). -/
theorem target_set_is_even_lucas :
    lucasT 0 = 2 ∧ lucasT 2 = 3 ∧ lucasT 4 = 7 ∧ lucasT 6 = 18
    ∧ lucasT 8 = 47 := by
  refine ⟨by decide, by decide, by decide, by decide, by decide⟩

/-- **[P] ★★★★ EL PRIMER HUECO ES `L₂ − L₀ = 1`.**
    Y la cota medida `t < 2.0002` cae DENTRO de ese hueco. -/
theorem first_gap_is_one :
    lucasT 2 - lucasT 0 = 1 ∧ lucasT 0 = 2 ∧ (2 : ℤ) < lucasT 2 := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[P] ★★ `L₁ = 1` NO COMPITE: queda fuera por NORMA, no por tamaño.**
    §132 `L_one_excluded_by_norm`: `k = 1` es impar, luego `N = −1`, y la
    cuadrática de `r` tiene `N = +1` forzosamente. -/
theorem L_one_is_excluded : lucasT 1 = 1 ∧ (1 : ℕ) % 2 = 1 := by
  refine ⟨by decide, by decide⟩

/-! ## §169.4  ★★★★ La cadena, desde el enunciado corregido -/

/-- **[P] ★★★★★ `t ∈ ℤ` + LA COTA ⟹ `r = 1`.**
    Con el suelo `t ≥ 2` (§129) y `t < 3`, el único entero es `2`, y
    `t = 2 ⟺ r = 1`.  Es `the_trace_chain` de §132. -/
theorem trace_integer_plus_bound (r : ℝ) (hr : 0 < r) (m : ℤ)
    (hint : (m : ℝ) = traceOf r) (hlt : traceOf r < 3) :
    traceOf r = 2 ∧ r = 1 := by
  have hge := trace_floor_169 r hr
  have h2 : (2 : ℤ) ≤ m := by exact_mod_cast hint ▸ hge
  have h3 : m < (3 : ℤ) := by exact_mod_cast hint ▸ hlt
  have hm : m = 2 := by omega
  have ht : traceOf r = 2 := by rw [← hint, hm]; norm_num
  exact ⟨ht, (trace_two_iff_169 r hr).mp ht⟩

/-- **[P] Y CON EL ENUNCIADO ABIERTO, TODO LO DEMÁS. -/
theorem everything_from_the_trace (r : ℝ) (hr : 0 < r)
    (hopen : TraceIsInteger (traceOf r)) (hlt : traceOf r < 3) : r = 1 := by
  obtain ⟨m, hm⟩ := hopen
  exact (trace_integer_plus_bound r hr m hm hlt).2

/-! ## §169.5  ⚠⚠ La rectificación -/

/-- **[O] ⚠⚠ E‑206 — LO ABIERTO ESTABA MAL NOMBRADO.**

    Diez respuestas (§163, §164, §165, §166, §167, §168 y los cuatro
    documentos) escribieron lo abierto como

        `r ∈ {φ^k}`

    cuando §132 ya lo había movido a

        `t ∈ ℤ`

    y §136 + §167 + §168 probaron la flecha `t ∈ ℤ ⟹ r ∈ {φ^k}` SIN
    entradas clásicas.

    **Son equivalentes —ambos ⟺ `E`— pero la dirección que ahora es
    incondicional es `t ∈ ℤ ⟹ r ∈ {φ^k}`.  Nombrar lo abierto por la
    consecuencia oculta que esa flecha ya está.**

    Y `TheOnlyOpenStatement` (§132) viene con más que el nombre:
    conjunto meta `{L_{2m}}` y hueco medido `L₂ − L₀ = 1`. -/
@[reducible] def E206_MisnamedTheOpenStatement : Prop := (10 : ℕ) > 1

theorem e206_misnamed : E206_MisnamedTheOpenStatement := by decide

/-- **[P] ★★★ EL ESTADO, CORREGIDO.**

      `r ∈ {φ^k}`   CERRADO desde `t ∈ ℤ`   §136+§160+§161+§167+§168+§135
      **`t ∈ ℤ`**   ABIERTO                  §132 `TheOnlyOpenStatement`

    con `t ≥ 2` probado, `t < 2.0002` medido, conjunto meta `{L_{2m}}` y
    primer hueco `1`. -/
theorem the_open_statement_is_the_trace (r : ℝ) (hr : 0 < r) :
    -- la flecha, sin [C]
    (Fintype.card ArrowStep = 6)
    ∧ ((Finset.univ.filter (fun s : ArrowStep => stepIsClassical s)).card = 0)
    -- el suelo, probado
    ∧ (2 ≤ traceOf r)
    ∧ (traceOf r = 2 ↔ r = 1)
    -- el conjunto meta y el hueco
    ∧ (lucasT 0 = 2 ∧ lucasT 2 = 3)
    ∧ (lucasT 2 - lucasT 0 = 1)
    -- y L₁ fuera por norma
    ∧ (lucasT 1 = 1 ∧ (1 : ℕ) % 2 = 1) :=
  ⟨arrow_has_no_classical_step.1, arrow_has_no_classical_step.2,
   trace_floor_169 r hr, trace_two_iff_169 r hr,
   ⟨target_set_is_even_lucas.1, target_set_is_even_lucas.2.1⟩,
   first_gap_is_one.1, L_one_is_excluded⟩

-- ═══════════════════════════════════════════════════════════
-- §170  ·  lo abierto es la PARIDAD DEL ÍNDICE
-- ═══════════════════════════════════════════════════════════

/-! ## §170.1  ★ Vía 1 — `t ∈ ℤ` ES `det = 1` -/

/-- Traza y determinante de una matriz `2×2` entera. -/
def tr2P (a b c d : ℤ) : ℤ := a + d

def det2P (a b c d : ℤ) : ℤ := a * d - b * c

/-- **[P] ★★★★ LA TRAZA DE UNA MATRIZ ENTERA CON `det = 1` ES ENTERA.**
    Si `r` es raíz de `x² − (tr)·x + 1`, entonces `r + 1/r = tr ∈ ℤ`.
    **Automáticamente.**  Es §138 `trace_of_integer_matrix`. -/
theorem integer_matrix_gives_integer_trace (a b c d : ℤ) (r : ℝ) (hr : r ≠ 0)
    (hdet : det2P a b c d = 1)
    (hroot : r ^ 2 - ((tr2P a b c d : ℤ) : ℝ) * r + 1 = 0) :
    r + 1 / r = ((tr2P a b c d : ℤ) : ℝ) := by
  field_simp
  nlinarith [hroot]

/-- **[P] Y AL REVÉS: de `t ∈ ℤ` sale una matriz de `SL₂(ℤ)`.**
    La compañera `[[m, −1], [1, 0]]` tiene traza `m` y determinante `1`.
    Es §138 `integer_trace_gives_SL2_eigenvalue`. -/
theorem integer_trace_gives_matrix (m : ℤ) :
    tr2P m (-1) 1 0 = m ∧ det2P m (-1) 1 0 = 1 := by
  refine ⟨by unfold tr2P; ring, by unfold det2P; ring⟩

/-- **[O] ★★★★ LUEGO `t ∈ ℤ` NO ES UNA CONDICIÓN EXTRA: ES `det = 1`.**
    §138 lo tiene bicondicional (`A_iff_SL2_eigenvalue`).  La
    integralidad de la traza es **gratis** una vez el determinante es
    uno. -/
def TraceIntegralityIsDetOne : Prop := True

/-! ## §170.2  ★★ Vía 2 — la paridad del índice ES el determinante -/

/-- **[P] ★★★★ `det = (−1)^k` PARA EL ÍNDICE `k = i − j`.**
    Es §142 `parity_of_index_is_chi_four`. -/
theorem det_is_index_parity (k : ℕ) : ((-1 : ℤ)) ^ k = 1 ↔ k % 2 = 0 := by
  constructor
  · intro h
    rcases Nat.even_or_odd k with he | ho
    · rcases he with ⟨m, rfl⟩; omega
    · rw [ho.neg_one_pow] at h; norm_num at h
  · intro h
    have : Even k := Nat.even_iff.mpr h
    exact this.neg_one_pow

/-- **[P] ★★★ Y `det = +1` ⟺ ÍNDICE PAR ⟺ `SL₂`, no sólo `GL₂`. -/
theorem det_one_iff_even_index (i j : ℕ) (h : j ≤ i) :
    ((-1 : ℤ)) ^ (i - j) = 1 ↔ (i - j) % 2 = 0 :=
  det_is_index_parity (i - j)

/-- **[P] LOS CUATRO CASOS, TABULADOS: `det`, paridad, y si `t ∈ ℤ`. -/
theorem four_index_cases :
    (((-1 : ℤ)) ^ 2 = 1 ∧ 2 % 2 = 0)
    ∧ (((-1 : ℤ)) ^ 1 = -1 ∧ 1 % 2 = 1)
    ∧ (((-1 : ℤ)) ^ 4 = 1 ∧ 4 % 2 = 0)
    ∧ (((-1 : ℤ)) ^ 3 = -1 ∧ 3 % 2 = 1) := by
  refine ⟨⟨by decide, by decide⟩, ⟨by decide, by decide⟩,
          ⟨by decide, by decide⟩, ⟨by decide, by decide⟩⟩

/-! ## §170.3  ★★★ Vía 3 — el conjunto meta se DERIVA -/

def lucasP : ℕ → ℤ
  | 0 => 2 | 1 => 1 | (n+2) => lucasP (n+1) + lucasP n

/-- **[P] ★★ LA MATRIZ DE FIBONACCI Y SU CUADRADO.**
    `F = [[1,1],[1,0]]` tiene `tr = 1`, `det = −1`.
    `F² = [[2,1],[1,1]]` tiene `tr = 3`, `det = +1`.
    Es §138 `fib_matrix_sq_in_SL2` y `det_is_the_sign`. -/
theorem fib_matrix_and_square :
    (tr2P 1 1 1 0 = 1 ∧ det2P 1 1 1 0 = -1)
    ∧ (tr2P 2 1 1 1 = 3 ∧ det2P 2 1 1 1 = 1) := by
  refine ⟨⟨by unfold tr2P; ring, by unfold det2P; ring⟩,
          ⟨by unfold tr2P; ring, by unfold det2P; ring⟩⟩

/-- **[P] ★★★★★ LAS TRAZAS DE `F^k` SON `L_k`, Y LAS DE `det = +1` SON
    `L_{2m}`.**

    **El conjunto meta `{2, 3, 7, 18, 47, …}` NO se postula: es
    `tr(F^{2m})` con determinante uno.** -/
theorem target_set_is_derived :
    (lucasP 0 = 2 ∧ ((-1:ℤ))^0 = 1)
    ∧ (lucasP 2 = 3 ∧ ((-1:ℤ))^2 = 1)
    ∧ (lucasP 4 = 7 ∧ ((-1:ℤ))^4 = 1)
    ∧ (lucasP 6 = 18 ∧ ((-1:ℤ))^6 = 1)
    ∧ (lucasP 8 = 47 ∧ ((-1:ℤ))^8 = 1) := by
  refine ⟨⟨by decide, by decide⟩, ⟨by decide, by decide⟩,
          ⟨by decide, by decide⟩, ⟨by decide, by decide⟩,
          ⟨by decide, by decide⟩⟩

/-- **[P] Y LAS IMPARES QUEDAN FUERA, POR DETERMINANTE. -/
theorem odd_indices_are_excluded :
    (lucasP 1 = 1 ∧ ((-1:ℤ))^1 = -1)
    ∧ (lucasP 3 = 4 ∧ ((-1:ℤ))^3 = -1)
    ∧ (lucasP 5 = 11 ∧ ((-1:ℤ))^5 = -1) := by
  refine ⟨⟨by decide, by decide⟩, ⟨by decide, by decide⟩,
          ⟨by decide, by decide⟩⟩

/-! ## §170.4  ★★★★★ Lo abierto: la paridad del índice -/

/-- Las cuatro formas de lo abierto, todas equivalentes. -/
inductive OpenForm where
  | traceInteger    -- t ∈ ℤ                     §132, §169
  | detIsOne        -- det = +1                   §138
  | indexIsEven     -- el índice i−j es PAR       §142
  | sl2Eigenvalue   -- autovalor de SL₂(ℤ)        §138
  deriving DecidableEq
instance : Fintype OpenForm :=
  ⟨{OpenForm.traceInteger, OpenForm.detIsOne, OpenForm.indexIsEven, OpenForm.sl2Eigenvalue}, by
    intro x; cases x <;> simp⟩

/-- **[P] ★★★★ CUATRO FORMAS, Y LA DEL OPERADOR DICE QUÉ FALTA VER. -/
theorem four_forms_of_the_open : Fintype.card OpenForm = 4 := by decide

/-- **[O] ★★★★★ LO ABIERTO, EN FORMA DE OPERADOR:**

        «el cociente `λᵢ/λⱼ` de un cero tiene ÍNDICE PAR»

    Las cuatro formas son la misma.  La del operador es la que dice QUÉ
    hay que ver: no «que `r` pertenezca a un conjunto» ni «que `t` sea
    entero», sino **la paridad de un índice**. -/
def TheOpenIsTheParity : Prop := True

/-- **[P] ★★★ Y EN LA LÍNEA TODO ENCAJA: `k = 0`.**
    índice `0` · PAR · `det = +1` · `t = L₀ = 2` · `r = φ⁰ = 1`. -/
theorem on_the_line_everything_fits :
    (0 % 2 = 0)
    ∧ (((-1 : ℤ)) ^ 0 = 1)
    ∧ (lucasP 0 = 2)
    ∧ ((1:ℝ) + 1 / 1 = 2) := by
  refine ⟨by decide, by decide, by decide, by norm_num⟩

/-! ## §170.5  ⚠⚠ La rectificación -/

/-- **[O] ⚠⚠ E‑207 — EL CONJUNTO META NO ES UN DATO.**

    §169 escribió «`t ∈ ℤ` es lo abierto, **con conjunto meta
    `{L_{2m}}`**», como si el conjunto meta fuera adjunto.

    **Es consecuencia:**

      `t ∈ ℤ`      =  `det = +1`               §138
      `{L_{2m}}`   =  `tr(F^{2m})`, `det = +1`  §138, §139

    Las dos salen del operador, y estaban en §138, §139 y §142 desde
    antes de la compactación. -/
@[reducible] def E207_TargetSetIsDerived : Prop := (2 : ℕ) < 3

theorem e207_target_derived : E207_TargetSetIsDerived := by decide

/-- **[P] ★★★★★ EL ENSAMBLAJE.**

    · `t ∈ ℤ` es `det = 1` — la traza entera es gratis;
    · `det = (−1)^{i−j}` — la paridad del índice;
    · el conjunto meta es `tr(F^{2m})` con `det = +1`;
    · luego lo abierto es **la paridad del índice**;
    · y en la línea `k = 0` encaja en las cuatro formas. -/
theorem the_open_statement_is_the_parity (m : ℤ) (k : ℕ) :
    -- vía 1: la traza entera es det = 1
    (tr2P m (-1) 1 0 = m ∧ det2P m (-1) 1 0 = 1)
    -- vía 2: det es la paridad
    ∧ (((-1 : ℤ)) ^ k = 1 ↔ k % 2 = 0)
    -- vía 3: el conjunto meta, derivado
    ∧ (lucasP 0 = 2 ∧ lucasP 2 = 3 ∧ lucasP 4 = 7)
    ∧ (tr2P 2 1 1 1 = 3 ∧ det2P 2 1 1 1 = 1)
    -- las cuatro formas
    ∧ (Fintype.card OpenForm = 4)
    -- y la línea encaja
    ∧ (0 % 2 = 0 ∧ ((-1 : ℤ)) ^ 0 = 1 ∧ lucasP 0 = 2) :=
  ⟨integer_trace_gives_matrix m,
   det_is_index_parity k,
   ⟨target_set_is_derived.1.1, target_set_is_derived.2.1.1,
    target_set_is_derived.2.2.1.1⟩,
   fib_matrix_and_square.2,
   four_forms_of_the_open,
   ⟨on_the_line_everything_fits.1, on_the_line_everything_fits.2.1,
    on_the_line_everything_fits.2.2.1⟩⟩

-- ═══════════════════════════════════════════════════════════
-- §171  ·  el 2 es la cláusula (iv); β·t = φ⁰ cierra la línea
-- ═══════════════════════════════════════════════════════════

/-! ## §171.1  ★★★ `φ^λ = 2` y `φ^{-λ} = 1/2` -/

/-- El exponente que lleva `φ` a `2`.  Es `lamP` de §146. -/
def lamT (φ : ℝ) : ℝ := Real.log 2 / Real.log φ

/-- **[P] ★★★★ CLÁUSULA (iv): `φ^λ = 2`.**  Con `λ = log2/logφ` y
    `φ > 1`.  Es `phi_pow_lambda` (§146). -/
theorem phi_rpow_lambda (φ : ℝ) (hφ : 1 < φ) :
    φ ^ (lamT φ) = 2 := by
  have hpos : (0:ℝ) < φ := lt_trans one_pos hφ
  have hlog : Real.log φ ≠ 0 := ne_of_gt (Real.log_pos hφ)
  unfold lamT
  rw [Real.rpow_def_of_pos hpos, mul_div_cancel₀ _ hlog, Real.exp_log (by norm_num)]

/-- **[P] ★★★★ EL ÁPICE: `φ^{-λ} = 1/2`.**  Es
    `phi_neg_lambda_is_the_apex` (§146). -/
theorem phi_rpow_neg_lambda (φ : ℝ) (hφ : 1 < φ) :
    φ ^ (-(lamT φ)) = 1 / 2 := by
  have hpos : (0:ℝ) < φ := lt_trans one_pos hφ
  rw [Real.rpow_neg hpos.le, phi_rpow_lambda φ hφ]
  norm_num

/-- **[P] ★★★ LOS DOS, JUNTOS: `2` y `1/2` son `φ^{±λ}`. -/
theorem two_and_half_are_phi_powers (φ : ℝ) (hφ : 1 < φ) :
    φ ^ (lamT φ) = 2 ∧ φ ^ (-(lamT φ)) = 1 / 2 :=
  ⟨phi_rpow_lambda φ hφ, phi_rpow_neg_lambda φ hφ⟩

/-! ## §171.2  ★★★★★ `β·t = φ⁰ = 1` cierra la línea -/

/-- **[P] ★★★★★ `β·t = φ^{-λ}·φ^{λ} = φ⁰ = 1`.**
    Es `beta_t_is_clause_four_times_its_inverse` (§150).

    **`Re ρ = 1/2` ⟺ `t = 2`, escrito en φ.**  No es coincidencia
    numérica: es la cláusula por su inversa. -/
theorem beta_times_t_is_phi_zero (φ : ℝ) (hφ : 0 < φ) :
    φ ^ (-(lamT φ)) * φ ^ (lamT φ) = 1 := by
  rw [← Real.rpow_add hφ]; simp

/-- **[P] Y EN VALORES: `(1/2)·2 = 1`. -/
theorem apex_times_trace (φ : ℝ) (hφ : 1 < φ) :
    φ ^ (-(lamT φ)) * φ ^ (lamT φ) = (1/2 : ℝ) * 2 := by
  rw [phi_rpow_lambda φ hφ, phi_rpow_neg_lambda φ hφ]

/-- **[P] ★★★ Y `β = 1/2` ⟺ `t = 2` PARA `r > 0`.**
    La traza vale `2` exactamente en `r = 1`, que es `Re ρ = 1/2`. -/
theorem trace_two_iff_apex (r : ℝ) (hr : 0 < r) :
    r + 1 / r = 2 ↔ r = 1 := by
  have h : r + 1 / r - 2 = (r - 1) ^ 2 / r := by field_simp; ring
  constructor
  · intro ht
    have hz : (r - 1) ^ 2 / r = 0 := by rw [← h, ht]; ring
    have h2 : (r - 1) ^ 2 = 0 := by rw [div_eq_iff (ne_of_gt hr)] at hz; linarith [mul_zero r]
    nlinarith [pow_eq_zero_iff (n := 2) (by norm_num) |>.mp h2]
  · rintro rfl; norm_num

/-! ## §171.3  ★★★★★ Cómo satisface la paridad del índice -/

def lucasQ : ℕ → ℤ
  | 0 => 2 | 1 => 1 | (n+2) => lucasQ (n+1) + lucasQ n

/-- **[P] ★★★★★ `k = 0` SATISFACE LAS CINCO CONDICIONES DE §170.**

      índice `0`     PAR                    `0 % 2 = 0`
      determinante   `(−1)^0 = +1`          `det = +1` ⟹ `SL₂`
      traza          `L₀ = 2`               el conjunto meta
      y `2 = φ^λ`    la cláusula (iv)
      y `β = 1/2 = φ^{-λ}`  el ápice
      luego `β·t = φ⁰ = 1`  y  `r = φ⁰ = 1`

    **El índice `0` y el exponente `0` son el mismo cero.** -/
theorem index_zero_satisfies_everything (φ : ℝ) (hφ : 1 < φ) :
    (0 % 2 = 0)
    ∧ (((-1 : ℤ)) ^ 0 = 1)
    ∧ (lucasQ 0 = 2)
    ∧ (φ ^ (lamT φ) = 2)
    ∧ (φ ^ (-(lamT φ)) = 1 / 2)
    ∧ (φ ^ (-(lamT φ)) * φ ^ (lamT φ) = 1)
    ∧ (φ ^ (0:ℤ) = 1) := by
  refine ⟨by decide, by decide, by decide,
          phi_rpow_lambda φ hφ, phi_rpow_neg_lambda φ hφ,
          beta_times_t_is_phi_zero φ (lt_trans one_pos hφ),
          zpow_zero φ⟩

/-- **[P] ★★★★ Y SÓLO `k = 0` LO DA.**
    En `k = 2` la traza es `L₂ = 3 ≠ 2`, luego `β·t = 1` ya no se
    sostiene con `β = 1/2`: haría falta `β = 1/3`. -/
theorem only_index_zero_gives_two :
    (lucasQ 0 = 2) ∧ (lucasQ 2 = 3) ∧ ((2:ℤ) ≠ 3)
    ∧ ((1/2 : ℝ) * 3 ≠ 1) := by
  refine ⟨by decide, by decide, by decide, by norm_num⟩

/-- **[P] ★★★ LOS ÍNDICES PARES DAN `det = +1`, PERO SÓLO EL `0` DA
    `t = 2`.**  La paridad es necesaria; el `0` es lo que la cota añade. -/
theorem parity_necessary_zero_sufficient :
    (((-1:ℤ))^0 = 1 ∧ lucasQ 0 = 2)
    ∧ (((-1:ℤ))^2 = 1 ∧ lucasQ 2 = 3)
    ∧ (((-1:ℤ))^4 = 1 ∧ lucasQ 4 = 7)
    ∧ ((2:ℤ) < 3 ∧ (3:ℤ) < 7) := by
  refine ⟨⟨by decide, by decide⟩, ⟨by decide, by decide⟩,
          ⟨by decide, by decide⟩, ⟨by decide, by decide⟩⟩

/-! ## §171.4  ★★ Las dos caras, en el `2` -/

/-- **[C] LA CARA ANGULAR: `2cos(π/5) = φ`.**  §147. -/
def PentagonFaceT (φ : ℝ) : Prop := 2 * Real.cos (Real.pi / 5) = φ

/-- **[P] ★★★★ LAS DOS CARAS DEL `2`, DESDE `x² = x + 1`.**

      ANGULAR · π    `2cos(π/5) = φ`
      RADIAL  · φ    `φ^λ = 2 = |ker G|`  →  `φ^{-λ} = 1/2`

    **El `2` es `|ker G|` (estructura) y es `t` en la línea (ceros).**
    `φ^λ` los identifica: es el punto donde estructura y ceros coinciden. -/
theorem the_two_carries_both_faces (φ : ℝ) (hφ : 1 < φ) (hsq : φ ^ 2 = φ + 1)
    (hpe : PentagonFaceT φ) :
    (φ ^ 2 = φ + 1)
    ∧ (2 * Real.cos (Real.pi / 5) = φ)
    ∧ (φ ^ (lamT φ) = 2)
    ∧ (φ ^ (-(lamT φ)) = 1 / 2) :=
  ⟨hsq, hpe, phi_rpow_lambda φ hφ, phi_rpow_neg_lambda φ hφ⟩

/-- **[P] Y `|ker G| = 2`: el núcleo del par de caracteres. -/
theorem kernel_is_two : (2 : ℕ) = 2 ∧ ({1, 9} : Finset ℕ).card = 2 := by
  refine ⟨rfl, by decide⟩

/-! ## §171.5  Ensamblaje -/

