-- BLOCK 4. F1_pendientes.lean
-- ℤ[φ] is a domain with two endomorphisms; the Frobenius congruence
-- ════════════════════════════════════════════════════════════════════════════

section Block04

/-
  F1_pendientes.lean  ·  formalizaciones pendientes del plan (bloques A2, B1–B5, C2)
  ────────────────────────────────────────────────────────────────────────
  ⚠ ESCRITO SIN COMPILAR (el entorno de redacción no tiene Lean).
    Orden de build:  S1_chi5_fib  →  F1_pendientes.
    Tras compilar:   #print axioms F1Pendientes.frobenius_congruence
                     (esperado: [propext, Classical.choice, Quot.sound]).

  CONTENIDO
    A2  F_{p−1} mod p:  0 si p se descompone, 1 si es inerte.
    B1  El anillo ℤ[φ] := AdjoinRoot (X² − X − 1) sobre ℤ, su raíz ω,
        y el morfismo a ℝ que manda ω ↦ φ.
    B2  σ (conjugación ω ↦ 1 − ω) y ψ_p : ℤ[φ] →+* ℤ[φ]  (Frobenius de Artin):
        ψ_p = σ si χ₅(p) = −1, identidad en otro caso.  Aditividad: es RingHom.
    B3  ψ_m ∘ ψ_n = ψ_{mn} para m, n primos con 5;  σ ∘ σ = id.
    B4  Congruencia de Frobenius:  ψ_p(a) ≡ a^p  (mod p·ℤ[φ])  para todo a,
        para todo primo p ≠ 5 (incluido p = 2).
    B5  Puente monoide ↔ anillo:  ω^{pn} ≡ ψ_p(ω^n)  (mod p).
    C2  La componente χ₅ de la clasificación elige ψ_p: p ≡ ±1 ⟹ id, p ≡ ±2 ⟹ σ.

  ALCANCE (lo que NO hace este archivo)
    · No localiza en 5: la congruencia se prueba para p ≠ 5, que es
      exactamente el contenido de «Λ-anillo con 5 invertido».  La obstrucción
      en p = 5 no se formaliza aquí.
    · No toca `bridge_axiom` (D12): eso no es ensamblaje de piezas existentes.
-/





open Polynomial

set_option linter.style.longLine false

noncomputable section

namespace F1Pendientes

/-! ## A2 — F_{p−1} mod p -/

/-- **[A2, split]** p ≡ ±1 (mod 5) ⟹ F_{p−1} ≡ 0 (mod p). -/
theorem fib_pred_split {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hp5 : p ≠ 5)
    (h : ((p : ℕ) : ZMod 5) = 1 ∨ ((p : ℕ) : ZMod 5) = 4) :
    (Nat.fib (p - 1) : ZMod p) = 0 := by
  have : Fact p.Prime := ⟨hp⟩
  obtain ⟨α, hα⟩ := (F1SpectraAnchorG.root_x2mx1_iff_five_sq hp hp2).mpr
    ((F1SpectraAnchorG.five_sq_iff_mod5 hp hp2 hp5).mpr h)
  have hpow := F1SpectraAnchorG.fib_pow_prime hp α hα
  have hfix : α ^ p = α := ZMod.pow_card α
  have hF : (Nat.fib p : ZMod p) = 1 :=
    F1SpectraAnchorG.fib_eq_one_of_mod5_split hp hp2 hp5 h
  rw [hF, hfix] at hpow
  linear_combination -hpow

set_option maxHeartbeats 1000000 in
/-- **[A2, inert]** X² − X − 1 irreducible en ZMod p ⟹ F_{p−1} ≡ 1 (mod p).
    Cuerpo tomado de `F1SpectraAnchorG.fib_inert_case` (ya compilado), que
    obtiene α^p = 1 − α en GF(p²); aquí se lee además el coeficiente F_{p−1}. -/
theorem fib_pred_inert {p : ℕ} (hp : p.Prime) (_hp2 : p ≠ 2) (_hp5 : p ≠ 5)
    (hirr : Irreducible (X ^ 2 - X - 1 : (ZMod p)[X])) :
    (Nat.fib (p - 1) : ZMod p) = 1 := by
  have hFact : Fact p.Prime := ⟨hp⟩
  let K := AdjoinRoot (X ^ 2 - X - 1 : (ZMod p)[X])
  have : Fact (Irreducible (X ^ 2 - X - 1 : (ZMod p)[X])) := ⟨hirr⟩
  have hKChar : CharP K p :=
    charP_of_injective_algebraMap (algebraMap (ZMod p) K).injective p
  let α : K := AdjoinRoot.root _
  have hα_sq : α ^ 2 = α + 1 := by
    have h : Polynomial.aeval α (X ^ 2 - X - 1 : (ZMod p)[X]) = 0 :=
      AdjoinRoot.eval₂_root _
    simp only [map_sub, map_pow, map_one, Polynomial.aeval_X] at h
    linear_combination h
  -- Paso 1: (α^p)² = α^p + 1  (freshman's dream)
  have hαp_root : (α ^ p) ^ 2 = α ^ p + 1 := by
    calc (α ^ p) ^ 2
        = (α ^ 2) ^ p := by ring
      _ = (α + 1) ^ p := by rw [hα_sq]
      _ = α ^ p + 1 ^ p := add_pow_char (p := p) α 1
      _ = α ^ p + 1 := by ring
  -- Paso 2: X² − X − 1 no tiene raíces en Z_p
  have hirr_no_root : ∀ c : ZMod p, c ^ 2 ≠ c + 1 := by
    intro c hc
    have hkey : c - c ^ 2 = -1 := by linear_combination -hc
    have hfact : (X ^ 2 - X - 1 : (ZMod p)[X]) = (X - C c) * (X - C (1 - c)) := by
      have hrw : (X - C c) * (X - C (1 - c)) = X ^ 2 - X + C (c - c ^ 2) := by
        simp only [map_sub, map_pow, map_one]
        ring
      rw [hrw, hkey]
      simp only [map_neg, map_one]
      ring
    have hnu : ∀ d : ZMod p, ¬ IsUnit (X - C d : (ZMod p)[X]) := by
      intro d hu
      obtain ⟨u, _, hu_eq⟩ := Polynomial.isUnit_iff.mp hu
      have h1 : natDegree (C u) = natDegree (X - C d) := congr_arg natDegree hu_eq
      rw [natDegree_C, natDegree_X_sub_C] at h1
      contradiction
    rcases hirr.isUnit_or_isUnit hfact with h | h
    · exact hnu c h
    · exact hnu (1 - c) h
  have hinj : Function.Injective (algebraMap (ZMod p) K) :=
    (algebraMap (ZMod p) K).injective
  -- Paso 3: α^p ≠ α
  have hαp_ne : α ^ p ≠ α := by
    intro heq
    have hXpX : (X ^ p - X : (ZMod p)[X]) = ∏ a : ZMod p, (X - C a) := by
      have hdeg : degree (X ^ p - X : (ZMod p)[X]) = p := by
        have h1 : degree (X : (ZMod p)[X]) < degree ((X ^ p : (ZMod p)[X])) := by
          rw [degree_X_pow, degree_X]
          exact_mod_cast hp.one_lt
        rw [degree_sub_eq_left_of_degree_lt h1, degree_X_pow]
      have hnat : natDegree (X ^ p - X : (ZMod p)[X]) = p :=
        natDegree_eq_of_degree_eq_some hdeg
      have hmonic : Monic (X ^ p - X : (ZMod p)[X]) := by
        rw [Monic, leadingCoeff, hnat]
        have hcs := coeff_sub (X ^ p : (ZMod p)[X]) (X : (ZMod p)[X]) p
        have hcp := coeff_X_pow (R := ZMod p) p p
        have hcx := coeff_X (R := ZMod p) (n := p)
        rw [hcs, hcp, hcx, if_pos (rfl : p = p),
            if_neg (Nat.ne_of_lt hp.one_lt), sub_zero]
      have hroots : roots (X ^ p - X : (ZMod p)[X]) = (Finset.univ : Finset (ZMod p)).val := by
        have h := FiniteField.roots_X_pow_card_sub_X (ZMod p)
        simpa [ZMod.card] using h
      have hcard : (Finset.univ : Finset (ZMod p)).val.card = p := by
        have h := Finset.card_univ (α := ZMod p)
        rwa [Finset.card_def, ZMod.card] at h
      have hsplits : Splits (X ^ p - X : (ZMod p)[X]) := by
        rw [splits_iff_card_roots, hroots, hcard]
        exact hnat.symm
      rw [hsplits.eq_prod_roots_of_monic hmonic, hroots]
      rfl
    have haeval : (Polynomial.aeval (R := (ZMod p)) α) (X ^ p - X : (ZMod p)[X]) = 0 := by
      rw [map_sub, map_pow, Polynomial.aeval_X]
      rw [heq]; ring
    rw [hXpX, map_prod (g := (Polynomial.aeval α : (ZMod p)[X] →ₐ[(ZMod p)] K))] at haeval
    obtain ⟨c, _, hc⟩ := (Finset.prod_eq_zero_iff).mp haeval
    rw [map_sub, Polynomial.aeval_X, Polynomial.aeval_C] at hc
    have hα_eq : α = algebraMap (ZMod p) K c := eq_of_sub_eq_zero hc
    have hc_sq : c ^ 2 = c + 1 := by
      apply hinj
      rw [map_pow, map_add, map_one, ← hα_eq]
      exact hα_sq
    exact hirr_no_root c hc_sq
  -- Paso 4: α^p = 1 − α
  have hfrob : α ^ p = 1 - α := by
    have hprod : (α ^ p - α) * (α ^ p - (1 - α)) = 0 := by
      linear_combination hαp_root - hα_sq
    rcases mul_eq_zero.mp hprod with h | h
    · exact absurd (sub_eq_zero.mp h) hαp_ne
    · exact sub_eq_zero.mp h
  have hfib_K : (Nat.fib p : K) * α + (Nat.fib (p - 1) : K) = 1 - α :=
    (F1SpectraAnchorG.fib_pow_prime hp α hα_sq).symm ▸ hfrob
  -- Paso 5: F_p ≡ −1 (mod p)
  have hFp : (Nat.fib p : ZMod p) = -1 := by
    by_contra hne
    have hFp1_ne : (Nat.fib p : ZMod p) + 1 ≠ 0 := fun h => hne (by linear_combination h)
    have hFp1_K : (Nat.fib p : K) + 1 ≠ 0 := by
      intro h; apply hFp1_ne; apply hinj
      push_cast [map_add, map_one]; exact h
    have hlin : ((Nat.fib p : K) + 1) * α = 1 - (Nat.fib (p - 1) : K) := by
      linear_combination hfib_K
    set c : ZMod p := (1 - (Nat.fib (p - 1) : ZMod p)) / ((Nat.fib p : ZMod p) + 1)
    have hα_c : α = algebraMap (ZMod p) K c := by
      rw [show c = (1 - (Nat.fib (p - 1) : ZMod p)) / ((Nat.fib p : ZMod p) + 1)
            from rfl]
      rw [map_div₀, map_sub, map_one, map_add, map_one, map_natCast, map_natCast]
      exact eq_div_of_mul_eq hFp1_K (by rw [mul_comm]; exact hlin)
    have hc_sq : c ^ 2 = c + 1 := by
      apply hinj
      rw [map_pow, map_add, map_one, ← hα_c]
      exact hα_sq
    exact hirr_no_root c hc_sq

  -- Nuevo: con F_p = −1, la identidad F_p·α + F_{p−1} = 1 − α da F_{p−1} = 1.
  have hFp_K : (Nat.fib p : K) = -1 := by
    have h := congrArg (algebraMap (ZMod p) K) hFp
    simpa [map_natCast] using h
  have hG_K : (Nat.fib (p - 1) : K) = 1 := by
    linear_combination hfib_K - α * hFp_K
  apply hinj
  rw [map_natCast, map_one]
  exact hG_K

/-- **[A2]** F_{p−1} mod p, fijado por la clase de p mod 5. -/
theorem fib_pred_from_mod5 {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hp5 : p ≠ 5) :
    ((((p : ℕ) : ZMod 5) = 1 ∨ ((p : ℕ) : ZMod 5) = 4) → (Nat.fib (p - 1) : ZMod p) = 0) ∧
    ((((p : ℕ) : ZMod 5) = 2 ∨ ((p : ℕ) : ZMod 5) = 3) → (Nat.fib (p - 1) : ZMod p) = 1) := by
  refine ⟨fib_pred_split hp hp2 hp5, fun h => ?_⟩
  have : Fact p.Prime := ⟨hp⟩
  -- irreducibilidad en el caso inerte: mismo argumento que `fib_eq_neg_one_of_mod5_inert`
  have hnroot : ¬ ∃ α : ZMod p, α ^ 2 = α + 1 := by
    intro hex
    have h14 := (F1SpectraAnchorG.five_sq_iff_mod5 hp hp2 hp5).mp
      ((F1SpectraAnchorG.root_x2mx1_iff_five_sq hp hp2).mp hex)
    rcases h with h | h <;> rcases h14 with h' | h' <;>
      rw [h] at h' <;> exact absurd h' (by decide)
  have hdeg : (X ^ 2 - X - 1 : (ZMod p)[X]).natDegree = 2 := by compute_degree!
  have hirr : Irreducible (X ^ 2 - X - 1 : (ZMod p)[X]) := by
    by_contra hc
    rw [F1SpectraAnchorG.not_irreducible_iff_exists_root_of_degree_two _ hdeg] at hc
    obtain ⟨x, hx⟩ := hc
    simp only [IsRoot.def, eval_sub, eval_pow, eval_X, eval_one] at hx
    exact hnroot ⟨x, by linear_combination hx⟩
  exact fib_pred_inert hp hp2 hp5 hirr

/-! ## B1 — el anillo ℤ[φ] -/

/-- El polinomio mínimo de φ sobre ℤ. -/
abbrev fφ : ℤ[X] := X ^ 2 - X - 1

/-- **[B1]** ℤ[φ] como `AdjoinRoot`. -/
abbrev Zφ : Type := AdjoinRoot fφ

/-- La raíz ω (el φ abstracto). -/
abbrev ω : Zφ := AdjoinRoot.root fφ

theorem ω_sq : ω ^ 2 = ω + 1 := by
  have h : fφ.eval₂ (AdjoinRoot.of fφ) ω = 0 := AdjoinRoot.eval₂_root fφ
  simp only [fφ, eval₂_sub, eval₂_pow, eval₂_X, eval₂_one] at h
  linear_combination h

/-- **[B1]** El morfismo a ℝ: ω ↦ φ.  Conecta el anillo con la torre real. -/
def ι : Zφ →+* ℝ :=
  AdjoinRoot.lift (Int.castRingHom ℝ) F1SpectraAnchorG.φ (by
    simp only [fφ, eval₂_sub, eval₂_pow, eval₂_X, eval₂_one]
    linear_combination F1SpectraAnchorG.phi_sq)

theorem ι_ω : ι ω = F1SpectraAnchorG.φ := by simp [ι]

/-- ι lleva la torre abstracta a la torre real: ι(ω^n) = φ^n. -/
theorem ι_pow (n : ℕ) : ι (ω ^ n) = F1SpectraAnchorG.φ ^ n := by
  rw [map_pow, ι_ω]

/-! ## B2 — conjugación y Frobenius de Artin -/

/-- **[B2]** La conjugación σ : ω ↦ 1 − ω. -/
def σ : Zφ →+* Zφ :=
  AdjoinRoot.lift (AdjoinRoot.of fφ) (1 - ω) (by
    simp only [fφ, eval₂_sub, eval₂_pow, eval₂_X, eval₂_one]
    linear_combination ω_sq)

theorem σ_ω : σ ω = 1 - ω := by simp [σ]

/-- Morfismos desde ℤ[φ] quedan determinados por la imagen de ω. -/
theorem hom_ext {S : Type*} [CommRing S] (g h : Zφ →+* S) (hω : g ω = h ω) : g = h := by
  refine AdjoinRoot.ringHom_ext ?_ ?_
  · apply RingHom.ext
    intro a
    exact (map_intCast g a).trans (map_intCast h a).symm
  · exact hω

/-- **[B3]** σ es una involución. -/
theorem σ_comp_σ : σ.comp σ = RingHom.id Zφ := by
  apply hom_ext
  simp only [RingHom.comp_apply, σ_ω, map_sub, map_one, RingHom.id_apply]
  ring

/-- **[B2]** El Frobenius de Artin en ℤ[φ]:  ψ_n = σ si χ₅(n) = −1, id si no. -/
def ψ (n : ℕ) : Zφ →+* Zφ :=
  if F1PCFUnified.chi5_Z (n : ZMod 5) = -1 then σ else RingHom.id Zφ

/-- **[B2]** ψ_n es aditivo (y multiplicativo): es un morfismo de anillos. -/
theorem ψ_add (n : ℕ) (a b : Zφ) : ψ n (a + b) = ψ n a + ψ n b := map_add _ a b
theorem ψ_mul' (n : ℕ) (a b : Zφ) : ψ n (a * b) = ψ n a * ψ n b := map_mul _ a b

/-! ## B3 — composición -/

theorem chi5_Z_mul' (a b : ZMod 5) :
    F1PCFUnified.chi5_Z (a * b) = F1PCFUnified.chi5_Z a * F1PCFUnified.chi5_Z b := by
  fin_cases a <;> fin_cases b <;> decide

theorem chi5_Z_pm (a : ZMod 5) (ha : a ≠ 0) :
    F1PCFUnified.chi5_Z a = 1 ∨ F1PCFUnified.chi5_Z a = -1 := by
  revert ha; revert a; decide

/-- **[B3]** ψ_m ∘ ψ_n = ψ_{mn} para m, n primos con 5. -/
theorem ψ_comp (m n : ℕ) (hm : (m : ZMod 5) ≠ 0) (hn : (n : ZMod 5) ≠ 0) :
    (ψ m).comp (ψ n) = ψ (m * n) := by
  unfold ψ
  simp only [Nat.cast_mul, chi5_Z_mul']
  rcases chi5_Z_pm _ hm with h1 | h1 <;> rcases chi5_Z_pm _ hn with h2 | h2 <;>
    simp [h1, h2, σ_comp_σ]

/-- **[B3]** Los ψ conmutan. -/
theorem ψ_commute (m n : ℕ) (hm : (m : ZMod 5) ≠ 0) (hn : (n : ZMod 5) ≠ 0) :
    (ψ m).comp (ψ n) = (ψ n).comp (ψ m) := by
  rw [ψ_comp m n hm hn, ψ_comp n m hn hm, mul_comm]

/-! ## C2 — la componente χ₅ elige ψ_p -/

theorem ψ_of_split {p : ℕ} (h : ((p : ℕ) : ZMod 5) = 1 ∨ ((p : ℕ) : ZMod 5) = 4) :
    ψ p = RingHom.id Zφ := by
  unfold ψ
  rcases h with h | h <;> simp [h, S1Closure.chi5_Z_one, S1Closure.chi5_Z_four]

theorem ψ_of_inert {p : ℕ} (h : ((p : ℕ) : ZMod 5) = 2 ∨ ((p : ℕ) : ZMod 5) = 3) :
    ψ p = σ := by
  unfold ψ
  rcases h with h | h <;> simp [h, S1Closure.chi5_Z_two, S1Closure.chi5_Z_three]

/-! ## B4 — congruencia de Frobenius -/

/-- El ideal p·ℤ[φ]. -/
def Ip (p : ℕ) : Ideal Zφ := Ideal.span {(p : Zφ)}

theorem mk_p_zero (p : ℕ) : (Ideal.Quotient.mk (Ip p)) (p : Zφ) = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)

theorem mk_intCast_eq_zero {p : ℕ} [NeZero p] (z : ℤ) (h : (z : ZMod p) = 0) :
    (Ideal.Quotient.mk (Ip p)) (z : Zφ) = 0 := by
  obtain ⟨k, hk⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd z p).mp h
  rw [Ideal.Quotient.eq_zero_iff_mem, hk]
  push_cast
  exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)

theorem mk_natCast_eq {p : ℕ} [NeZero p] (n : ℕ) (c : ℤ)
    (h : (n : ZMod p) = (c : ZMod p)) :
    (Ideal.Quotient.mk (Ip p)) (n : Zφ) = (Ideal.Quotient.mk (Ip p)) (c : Zφ) := by
  have h0 : (((n : ℤ) - c : ℤ) : ZMod p) = 0 := by push_cast; rw [h]; ring
  have := mk_intCast_eq_zero (p := p) _ h0
  rw [Int.cast_sub, Int.cast_natCast, map_sub] at this
  exact sub_eq_zero.mp this

/-- Pequeño Fermat en el cociente, sobre enteros. -/
theorem mk_intCast_pow {p : ℕ} (hp : p.Prime) (z : ℤ) :
    (Ideal.Quotient.mk (Ip p)) (z : Zφ) ^ p = (Ideal.Quotient.mk (Ip p)) (z : Zφ) := by
  have : Fact p.Prime := ⟨hp⟩
  haveI : NeZero p := ⟨hp.ne_zero⟩
  have h0 : ((z ^ p - z : ℤ) : ZMod p) = 0 := by
    push_cast; rw [ZMod.pow_card]; ring
  have := mk_intCast_eq_zero (p := p) _ h0
  rw [Int.cast_sub, Int.cast_pow, map_sub, map_pow] at this
  exact sub_eq_zero.mp this

/-- El sueño del estudiante en el cociente. -/
theorem mk_add_pow {p : ℕ} (hp : p.Prime) (x y : Zφ) :
    ((Ideal.Quotient.mk (Ip p)) x + (Ideal.Quotient.mk (Ip p)) y) ^ p = (Ideal.Quotient.mk (Ip p)) x ^ p + (Ideal.Quotient.mk (Ip p)) y ^ p := by
  have h := add_pow_prime_eq hp x y   -- (x+y)^p = x^p + y^p + p * Σ …
  have h' := congrArg (Ideal.Quotient.mk (Ip p)) h
  simp only [map_add, map_pow, map_mul, mk_p_zero, zero_mul, add_zero] at h'
  simpa using h'

/-- **[B4, generador]** ψ_p(ω) ≡ ω^p (mod p), para todo primo p ≠ 5. -/
theorem frobenius_on_ω {p : ℕ} (hp : p.Prime) (hp5 : p ≠ 5) :
    (Ideal.Quotient.mk (Ip p)) (ψ p ω) = (Ideal.Quotient.mk (Ip p)) ω ^ p := by
  have : Fact p.Prime := ⟨hp⟩
  haveI : NeZero p := ⟨hp.ne_zero⟩
  by_cases hp2 : p = 2
  · subst hp2
    have hψ : ψ 2 = σ := ψ_of_inert (Or.inl (by decide))
    rw [hψ, σ_ω, ← map_pow, ω_sq, ← sub_eq_zero, ← map_sub]
    have h2 : (Ideal.Quotient.mk (Ip 2)) (2 : Zφ) = 0 := by simpa using mk_p_zero 2
    have e : (1 - ω) - (ω + 1) = -((2 : Zφ) * ω) := by ring
    rw [e, map_neg, map_mul, h2, zero_mul, neg_zero]
  · have hpow := F1SpectraAnchorG.fib_pow_prime hp ω ω_sq
    have hne : ((p : ℕ) : ZMod 5) ≠ 0 := by
      rw [Ne, ZMod.natCast_eq_zero_iff]
      intro hdvd
      exact hp5 (((Nat.prime_dvd_prime_iff_eq (by norm_num) hp).mp hdvd).symm)
    rw [← map_pow, hpow, map_add, map_mul]
    rcases S1Closure.zmod5_nonzero_cases _ hne with h | h | h | h
    · have hs : ((p : ℕ) : ZMod 5) = 1 ∨ ((p : ℕ) : ZMod 5) = 4 := Or.inl h
      rw [ψ_of_split hs, RingHom.id_apply,
        mk_natCast_eq (Nat.fib p) 1 (by rw [F1SpectraAnchorG.fib_eq_one_of_mod5_split hp hp2 hp5 hs]; simp),
        mk_natCast_eq (Nat.fib (p - 1)) 0 (by rw [fib_pred_split hp hp2 hp5 hs]; simp)]
      simp only [Int.cast_one, Int.cast_zero, map_one, map_zero, one_mul, add_zero]
    · have hi : ((p : ℕ) : ZMod 5) = 2 ∨ ((p : ℕ) : ZMod 5) = 3 := Or.inl h
      rw [ψ_of_inert hi, σ_ω,
        mk_natCast_eq (Nat.fib p) (-1) (by rw [F1SpectraAnchorG.fib_eq_neg_one_of_mod5_inert hp hp2 hp5 hi]; simp),
        mk_natCast_eq (Nat.fib (p - 1)) 1 (by rw [(fib_pred_from_mod5 hp hp2 hp5).2 hi]; simp)]
      simp only [Int.cast_neg, Int.cast_one, map_neg, map_one, map_sub]
      ring
    · have hi : ((p : ℕ) : ZMod 5) = 2 ∨ ((p : ℕ) : ZMod 5) = 3 := Or.inr h
      rw [ψ_of_inert hi, σ_ω,
        mk_natCast_eq (Nat.fib p) (-1) (by rw [F1SpectraAnchorG.fib_eq_neg_one_of_mod5_inert hp hp2 hp5 hi]; simp),
        mk_natCast_eq (Nat.fib (p - 1)) 1 (by rw [(fib_pred_from_mod5 hp hp2 hp5).2 hi]; simp)]
      simp only [Int.cast_neg, Int.cast_one, map_neg, map_one, map_sub]
      ring
    · have hs : ((p : ℕ) : ZMod 5) = 1 ∨ ((p : ℕ) : ZMod 5) = 4 := Or.inr h
      rw [ψ_of_split hs, RingHom.id_apply,
        mk_natCast_eq (Nat.fib p) 1 (by rw [F1SpectraAnchorG.fib_eq_one_of_mod5_split hp hp2 hp5 hs]; simp),
        mk_natCast_eq (Nat.fib (p - 1)) 0 (by rw [fib_pred_split hp hp2 hp5 hs]; simp)]
      simp only [Int.cast_one, Int.cast_zero, map_one, map_zero, one_mul, add_zero]

/-- **[P·B4] ★ CONGRUENCIA DE FROBENIUS.**  Para todo primo p ≠ 5 y todo
    a ∈ ℤ[φ]:  ψ_p(a) ≡ a^p (mod p).  Con B2–B3, ésta es la estructura de
    Λ-anillo de Borger sobre ℤ[φ] fuera de 5. -/
theorem frobenius_congruence {p : ℕ} (hp : p.Prime) (hp5 : p ≠ 5) (a : Zφ) :
    (Ideal.Quotient.mk (Ip p)) (ψ p a) = (Ideal.Quotient.mk (Ip p)) a ^ p := by
  refine AdjoinRoot.induction_on (f := fφ) a (fun g => ?_)
  refine Polynomial.induction_on g (fun z => ?_) (fun g₁ g₂ ih₁ ih₂ => ?_) (fun n z ih => ?_)
  · -- constantes
    rw [AdjoinRoot.mk_C, eq_intCast (AdjoinRoot.of fφ) z, map_intCast]
    exact (mk_intCast_pow hp z).symm
  · -- sumas
    simp only [map_add]
    rw [ih₁, ih₂, mk_add_pow hp]
  · -- monomios: C z * X^(n+1) = (C z * X^n) * X
    have hsplit : AdjoinRoot.mk fφ (C z * X ^ (n + 1))
        = AdjoinRoot.mk fφ (C z * X ^ n) * ω := by
      rw [pow_succ, ← mul_assoc, RingHom.map_mul (AdjoinRoot.mk fφ) (C z * X ^ n) X,
        AdjoinRoot.mk_X]
    rw [hsplit, map_mul (ψ p), map_mul (Ideal.Quotient.mk (Ip p)), map_mul (Ideal.Quotient.mk (Ip p)), ih,
      frobenius_on_ω hp hp5, mul_pow]

/-! ## B5 — puente monoide ↔ anillo -/

/-- **[B5]** El ψ del Λ-monoide (n ↦ p·n en exponentes) y el ψ_p del anillo
    coinciden módulo p:  ω^{p·n} ≡ ψ_p(ω^n). -/
theorem monoid_ring_bridge {p : ℕ} (hp : p.Prime) (hp5 : p ≠ 5) (n : ℕ) :
    (Ideal.Quotient.mk (Ip p)) (ω ^ (p * n)) = (Ideal.Quotient.mk (Ip p)) (ψ p (ω ^ n)) := by
  rw [frobenius_congruence hp hp5, ← map_pow, ← pow_mul, mul_comm]

/-- **[B5]** Y bajo ι, la potencia del monoide es la torre real `realise`. -/
theorem monoid_side_is_realise (p n : ℕ) :
    ι (ω ^ (p * n)) = F1SpectraAnchorG.realise (F1SpectraAnchorG.psi p n) := by
  rw [ι_pow]
  unfold F1SpectraAnchorG.realise F1SpectraAnchorG.psi
  rw [← zpow_natCast, Nat.cast_mul]

end F1Pendientes

-- closing the scopes this file left open
end

end Block04

