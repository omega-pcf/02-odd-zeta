theorem coordinate_is_equivariant (ρ : ℂ) (h₀ : ρ ≠ 0) (h₁ : ρ ≠ 1) :
    zeroCoord (1 - ρ) = (zeroCoord ρ)⁻¹ := by
  have hprod := moduli_product_is_one ρ h₀ h₁
  have hpos : zeroCoord ρ ≠ 0 := by
    unfold zeroCoord
    intro h
    have : liMap ρ = 0 := by
      have := Complex.abs.eq_zero (show Complex.abs _ = 0 from h)
      exact this
    unfold liMap at this
    field_simp at this
    rw [mul_zero] at this
    exact h₁ (sub_eq_zero.mp this)
  unfold zeroCoord at *
  field_simp
  linarith [hprod]

theorem family_is_equivariant (k : ℤ) :
    (φ : ℝ) ^ (-k) = ((φ : ℝ) ^ k)⁻¹ := by
