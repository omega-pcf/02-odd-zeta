-- BLOCK 5. F1_pendientes_2.lean
-- the obstruction at 5, the monoid–ring bridge
-- ════════════════════════════════════════════════════════════════════════════

section Block05

/-
  F1_pendientes_2.lean  ·  obstrucción en p = 5 y eslabón C1 como implicación
  ────────────────────────────────────────────────────────────────────────
  ⚠ ESCRITO SIN COMPILAR.  Orden: S1_chi5_fib → F1_pendientes → F1_pendientes_2.

  CONTENIDO
    D1  ℤ[φ] es dominio:  X² − X − 1 es irreducible sobre ℤ (vía su reducción
        mod 2, sin raíces en 𝔽₂) y por tanto primo en ℤ[X] (UFD).
    D2  Todo endomorfismo de ℤ[φ] manda ω a ω o a 1 − ω.
    O5  OBSTRUCCIÓN EN 5: ningún endomorfismo f de ℤ[φ] cumple
        f(ω) ≡ ω⁵ (mod 5).  Testigo: el morfismo ℤ[φ] → 𝔽₅[ε], ω ↦ 3 + ε.
        Por eso el Λ-anillo exige invertir 5.
    C1  ψ_p DETERMINA χ₅(p) ≡ F_p:  de la sola congruencia de Frobenius en el
        generador se deduce F_p ≡ χ₅(p) y F_{p−1} ≡ (1 − χ₅(p))/2 (mod p).
        Es la dirección que el manuscrito afirma (HP L4766) — ahora teorema.
        Herramienta: los coeficientes en la base {1, ω} se leen módulo p
        (reducción ℤ[φ] → 𝔽_p[X]/(X² − X − 1) y grado < 2).
-/






open Polynomial

set_option linter.style.longLine false

noncomputable section

namespace F1Pendientes

/-! ## D1 — ℤ[φ] es un dominio -/

theorem fφ_monic : fφ.Monic := by unfold fφ; monicity!

theorem fφ_map_two_irreducible :
    Irreducible (fφ.map (Int.castRingHom (ZMod 2))) := by
  have hmap : fφ.map (Int.castRingHom (ZMod 2)) = (X ^ 2 - X - 1 : (ZMod 2)[X]) := by
    simp [fφ, Polynomial.map_sub, Polynomial.map_pow]
  rw [hmap]
  have hdeg : (X ^ 2 - X - 1 : (ZMod 2)[X]).natDegree = 2 := by compute_degree!
  by_contra hc
  rw [F1SpectraAnchorG.not_irreducible_iff_exists_root_of_degree_two _ hdeg] at hc
  obtain ⟨x, hx⟩ := hc
  simp only [IsRoot.def, eval_sub, eval_pow, eval_X, eval_one] at hx
  revert hx; revert x; decide

theorem fφ_irreducible : Irreducible fφ :=
  Polynomial.Monic.irreducible_of_irreducible_map (Int.castRingHom (ZMod 2)) fφ
    fφ_monic fφ_map_two_irreducible

theorem fφ_prime : Prime fφ :=
  UniqueFactorizationMonoid.irreducible_iff_prime.mp fφ_irreducible

instance : IsDomain Zφ := AdjoinRoot.isDomain_of_prime fφ_prime

/-! ## D2 — los endomorfismos de ℤ[φ] -/

/-- Todo endomorfismo manda ω a una de las dos raíces. -/
theorem endo_on_ω (f : Zφ →+* Zφ) : f ω = ω ∨ f ω = 1 - ω := by
  have hf : f ω ^ 2 = f ω + 1 := by rw [← map_pow, ω_sq, map_add, map_one]
  have hprod : (f ω - ω) * (f ω - (1 - ω)) = 0 := by
    linear_combination hf - ω_sq
  rcases mul_eq_zero.mp hprod with h | h
  · exact Or.inl (sub_eq_zero.mp h)
  · exact Or.inr (sub_eq_zero.mp h)

/-! ## O5 — la obstrucción en 5 -/

/-- El testigo: ℤ[φ] → 𝔽₅[ε],  ω ↦ 3 + ε.  (3 es la raíz doble de X² − X − 1
    en 𝔽₅; ε registra la ramificación.) -/
theorem five_eq_zero_dual : (5 : DualNumber (ZMod 5)) = 0 := by
  have h : (5 : ZMod 5) = 0 := by decide
  have := congrArg (algebraMap (ZMod 5) (DualNumber (ZMod 5))) h
  exact this

def δ5 : Zφ →+* DualNumber (ZMod 5) :=
  AdjoinRoot.lift (Int.castRingHom _) (3 + DualNumber.eps) (by
    simp only [fφ, eval₂_sub, eval₂_pow, eval₂_X, eval₂_one]
    have e2 : (DualNumber.eps : DualNumber (ZMod 5)) * DualNumber.eps = 0 :=
      DualNumber.eps_mul_eps
    linear_combination e2 + (1 + DualNumber.eps) * five_eq_zero_dual)

theorem δ5_ω : δ5 ω = 3 + DualNumber.eps := by simp [δ5]

theorem δ5_kills_I5 {x : Zφ} (hx : (Ideal.Quotient.mk (Ip 5)) x = 0) : δ5 x = 0 := by
  rw [Ideal.Quotient.eq_zero_iff_mem, Ip, Ideal.mem_span_singleton'] at hx
  obtain ⟨y, rfl⟩ := hx
  rw [map_mul, map_natCast]
  simp [five_eq_zero_dual]

theorem eps_ne_zero' : (DualNumber.eps : DualNumber (ZMod 5)) ≠ 0 := by
  intro h
  have := congrArg TrivSqZeroExt.snd h
  simp at this
  nomatch this

theorem ω_pow_five : ω ^ 5 = 5 * ω + 3 := by
  linear_combination (ω ^ 3 + ω ^ 2 + 2 * ω + 3) * ω_sq

/-- **[P·O5] ★ OBSTRUCCIÓN EN 5.**  Ningún endomorfismo de ℤ[φ] satisface la
    congruencia de Frobenius en p = 5.  Luego ℤ[φ, φ⁻¹, ½] (5 NO invertido)
    no admite estructura de Λ-anillo; con 5 invertido, la condición en 5 es
    vacía y B4 da el resto. -/
theorem no_frobenius_lift_at_five (f : Zφ →+* Zφ) :
    (Ideal.Quotient.mk (Ip 5)) (f ω) ≠ (Ideal.Quotient.mk (Ip 5)) ω ^ 5 := by
  intro h
  rw [← map_pow, ω_pow_five, ← sub_eq_zero, ← map_sub] at h
  have hδ := δ5_kills_I5 h
  rcases endo_on_ω f with hf | hf
  · -- f ω = ω:  δ(ω − (5ω + 3)) = (3 + ε) − 3 = ε ≠ 0
    rw [hf] at hδ
    simp only [map_sub, map_add, map_mul, δ5_ω, map_ofNat] at hδ
    apply eps_ne_zero'
    linear_combination hδ + (3 + DualNumber.eps) * five_eq_zero_dual
  · -- f ω = 1 − ω:  δ((1 − ω) − (5ω + 3)) = −5 − ε − 5(…) = −ε ≠ 0
    rw [hf] at hδ
    simp only [map_sub, map_add, map_mul, map_one, δ5_ω, map_ofNat] at hδ
    apply eps_ne_zero'
    -- hδ: (1 − (3+ε)) − (5(3+ε) + 3) = −20 − 6ε = 0;  ε = −hδ + 5·(−4 − ε)
    linear_combination -hδ + (-4 - DualNumber.eps) * five_eq_zero_dual

/-! ## C1 — ψ_p determina χ₅(p) ≡ F_p -/

/-- La reducción ℤ[φ] → 𝔽_p[X]/(X² − X − 1). -/
def redp (p : ℕ) : Zφ →+* AdjoinRoot (X ^ 2 - X - 1 : (ZMod p)[X]) :=
  AdjoinRoot.lift ((AdjoinRoot.of _).comp (Int.castRingHom (ZMod p)))
    (AdjoinRoot.root _) (by
      have h := AdjoinRoot.eval₂_root (X ^ 2 - X - 1 : (ZMod p)[X])
      simp only [fφ, eval₂_sub, eval₂_pow, eval₂_X, eval₂_one] at h ⊢
      exact h)

theorem redp_kills_Ip (p : ℕ) {x : Zφ} (hx : (Ideal.Quotient.mk (Ip p)) x = 0) :
    redp p x = 0 := by
  rw [Ideal.Quotient.eq_zero_iff_mem, Ip, Ideal.mem_span_singleton'] at hx
  obtain ⟨y, rfl⟩ := hx
  rw [map_mul, map_natCast]
  have : ((p : ℕ) : AdjoinRoot (X ^ 2 - X - 1 : (ZMod p)[X])) = 0 := by
    rw [← map_natCast (AdjoinRoot.of (X ^ 2 - X - 1 : (ZMod p)[X])) p, ZMod.natCast_self,
      map_zero]
  rw [this, mul_zero]

/-- **Los coeficientes se leen módulo p.**  a·ω + b ≡ 0 (mod p) ⟹ p ∣ a y p ∣ b. -/
theorem coeffs_mod_p {p : ℕ} (hp : p.Prime) (a b : ℤ)
    (h : (Ideal.Quotient.mk (Ip p)) ((a : Zφ) * ω + (b : Zφ)) = 0) :
    (a : ZMod p) = 0 ∧ (b : ZMod p) = 0 := by
  have : Fact p.Prime := ⟨hp⟩
  have hr := redp_kills_Ip p h
  set g : (ZMod p)[X] := C (a : ZMod p) * X + C (b : ZMod p) with hg
  have hmk : AdjoinRoot.mk (X ^ 2 - X - 1 : (ZMod p)[X]) g = 0 := by
    rw [← hr]
    simp [g, redp, map_add, map_mul, AdjoinRoot.mk_C, AdjoinRoot.mk_X]
  rw [AdjoinRoot.mk_eq_zero] at hmk
  have hg0 : g = 0 := by
    by_contra hne
    have h1 := Polynomial.degree_le_of_dvd hmk hne
    have h2 : g.degree ≤ 1 := Polynomial.degree_linear_le
    have hdeg : (X ^ 2 - X - 1 : (ZMod p)[X]).degree = 2 := by compute_degree!
    rw [hdeg] at h1
    have := h1.trans h2
    exact absurd this (by decide)
  have ca := congrArg (fun q => q.coeff 1) hg0
  have cb := congrArg (fun q => q.coeff 0) hg0
  simp only [g, coeff_add, coeff_C_mul_X, coeff_C, coeff_zero] at ca cb
  norm_num at ca cb
  exact ⟨ca, cb⟩

/-- **[P·C1] ★ ψ_p DETERMINA χ₅(p) ≡ F_p.**  De la congruencia de Frobenius en
    el generador (hipótesis `H`, que B4 prueba) se DEDUCE F_p ≡ χ₅(p) (mod p).
    Es la implicación que `bridge_components` sólo yuxtaponía. -/
theorem chi5_from_frobenius {p : ℕ} (hp : p.Prime) (hp5 : p ≠ 5)
    (H : (Ideal.Quotient.mk (Ip p)) (ψ p ω) = (Ideal.Quotient.mk (Ip p)) ω ^ p) :
    ((F1PCFUnified.chi5_Z (p : ZMod 5) : ℤ) : ZMod p) = (Nat.fib p : ZMod p) := by
  have : Fact p.Prime := ⟨hp⟩
  have hpow := F1SpectraAnchorG.fib_pow_prime hp ω ω_sq
  rw [← map_pow, hpow, ← sub_eq_zero, ← map_sub] at H
  have hne : ((p : ℕ) : ZMod 5) ≠ 0 := by
    rw [Ne, ZMod.natCast_eq_zero_iff]
    intro hdvd
    exact hp5 (((Nat.prime_dvd_prime_iff_eq (by norm_num) hp).mp hdvd).symm)
  rcases S1Closure.zmod5_nonzero_cases _ hne with h | h | h | h
  · -- split: ψ = id,  ω − (F_p ω + F_{p−1}) = (1 − F_p)·ω + (−F_{p−1})
    rw [ψ_of_split (Or.inl h), RingHom.id_apply] at H
    have e : ω - ((Nat.fib p : Zφ) * ω + (Nat.fib (p - 1) : Zφ))
        = (((1 - (Nat.fib p : ℤ)) : ℤ) : Zφ) * ω + ((-(Nat.fib (p - 1) : ℤ) : ℤ) : Zφ) := by
      push_cast; ring
    rw [e] at H
    obtain ⟨ha, -⟩ := coeffs_mod_p hp _ _ H
    rw [h, S1Closure.chi5_Z_one]; push_cast at ha ⊢; linear_combination ha
  · rw [ψ_of_inert (Or.inl h), σ_ω] at H
    have e : (1 - ω) - ((Nat.fib p : Zφ) * ω + (Nat.fib (p - 1) : Zφ))
        = (((-1 - (Nat.fib p : ℤ)) : ℤ) : Zφ) * ω + (((1 - (Nat.fib (p - 1) : ℤ)) : ℤ) : Zφ) := by
      push_cast; ring
    rw [e] at H
    obtain ⟨ha, -⟩ := coeffs_mod_p hp _ _ H
    rw [h, S1Closure.chi5_Z_two]; push_cast at ha ⊢; linear_combination ha
  · rw [ψ_of_inert (Or.inr h), σ_ω] at H
    have e : (1 - ω) - ((Nat.fib p : Zφ) * ω + (Nat.fib (p - 1) : Zφ))
        = (((-1 - (Nat.fib p : ℤ)) : ℤ) : Zφ) * ω + (((1 - (Nat.fib (p - 1) : ℤ)) : ℤ) : Zφ) := by
      push_cast; ring
    rw [e] at H
    obtain ⟨ha, -⟩ := coeffs_mod_p hp _ _ H
    rw [h, S1Closure.chi5_Z_three]; push_cast at ha ⊢; linear_combination ha
  · rw [ψ_of_split (Or.inr h), RingHom.id_apply] at H
    have e : ω - ((Nat.fib p : Zφ) * ω + (Nat.fib (p - 1) : Zφ))
        = (((1 - (Nat.fib p : ℤ)) : ℤ) : Zφ) * ω + ((-(Nat.fib (p - 1) : ℤ) : ℤ) : Zφ) := by
      push_cast; ring
    rw [e] at H
    obtain ⟨ha, -⟩ := coeffs_mod_p hp _ _ H
    rw [h, S1Closure.chi5_Z_four]; push_cast at ha ⊢; linear_combination ha

/-- **[P·C1] La cadena como implicación:  Λ-estructura (B4) ⟹ χ₅(p) ≡ F_p.**
    Instancia `chi5_from_frobenius` con la congruencia probada en B4.  Da una
    segunda prueba de S1, independiente de `fib_value_from_mod5` en su último
    paso: el carácter se LEE del Frobenius. -/
theorem lambda_structure_gives_chi5 {p : ℕ} (hp : p.Prime) (hp5 : p ≠ 5) :
    ((F1PCFUnified.chi5_Z (p : ZMod 5) : ℤ) : ZMod p) = (Nat.fib p : ZMod p) :=
  chi5_from_frobenius hp hp5 (frobenius_on_ω hp hp5)

end F1Pendientes

-- closing the scopes this file left open
end

end Block05

-- ════════════════════════════════════════════════════════════════════════════
-- BLOCK 6. F1_frobenius_eigenvalue.lean
-- the Frobenius eigenvalue on √5, the characteristic polynomial
-- ════════════════════════════════════════════════════════════════════════════

section Block06

/-
  F1_frobenius_eigenvalue.lean
  ────────────────────────────────────────────────────────────────────────
  RUTA AL NÚCLEO — PASO 1: el Frobenius de ℤ[φ] tiene valor propio χ₅(p)
  sobre √5, y el factor de Euler de L(s,χ₅) es su polinomio característico.

  Contexto (ver `the_floating_piece.lean` y el plan):
    · La pieza que falta es `RadiusInTower`: la coordenada de cada cero en
      el monoide aditivo ⟨φ⟩.  En el corpus es equivalente a E y los únicos
      mecanismos que actúan sobre ceros individuales son de orden dos
      (`the_available_mechanisms_are_of_order_two`).
    · La única vía clásica que lleva información del lado de los primos
      (donde vive el Frobenius) a TODOS los ceros a la vez es la fórmula
      explícita de Weil, con la positividad de Weil como forma equivalente
      de GRH(χ₅).  En esa fórmula los primos entran por la TRAZA del
      Frobenius.  Este archivo construye ese lado: el Frobenius de ℤ[φ]
      actúa sobre la recta anti-invariante √5 = 2ω − 1 con valor propio
      χ₅(p), y el factor local de L(s,χ₅) es det(1 − p^{−s} ψ_p | ℤ·√5).

  Estado:  [P*] redactado, sin compilar.  Depende de `F1_pendientes`.
  Nada de este archivo afirma E.
-/



namespace F1FrobeniusEigen

open F1Pendientes

/-- √5 dentro de ℤ[φ]:  2ω − 1. -/
noncomputable def sqrt5 : Zφ := 2 * ω - 1

/-- **[P*]** (2ω − 1)² = 5. -/
theorem sqrt5_sq : sqrt5 ^ 2 = 5 := by
  unfold sqrt5
  have h := ω_sq
  linear_combination 4 * h

/-- **[P*]** La conjugación cambia el signo de √5. -/
theorem σ_sqrt5 : σ sqrt5 = -sqrt5 := by
  unfold sqrt5
  simp only [map_sub, map_mul, map_one, map_ofNat, σ_ω]
  ring

/-- **[P*]** El Frobenius fija la recta invariante. -/
theorem ψ_one (n : ℕ) : ψ n 1 = 1 := map_one _

/-- **[P*] ★★★★★ VALOR PROPIO DEL FROBENIUS SOBRE √5.**

    Para n primo con 5:  ψ_n(√5) = χ₅(n) · √5.

    Es el análogo exacto del ingrediente (b) de la plantilla de Weil a nivel
    finito: el carácter es el valor propio del Frobenius sobre la parte
    anti-invariante de ℤ[φ]. -/
theorem frobenius_eigenvalue_on_sqrt5 (n : ℕ) (hn : ((n : ℕ) : ZMod 5) ≠ 0) :
    ψ n sqrt5 = ((F1PCFUnified.chi5_Z (n : ZMod 5) : ℤ) : Zφ) * sqrt5 := by
  unfold ψ
  split_ifs with h
  · rw [σ_sqrt5, h]; push_cast; ring
  · rcases chi5_Z_pm _ hn with h1 | h1
    · rw [h1]; simp
    · exact absurd h1 h

/-- **[P*]** La traza del Frobenius sobre ℤ[φ] ⊗ ℚ, en la base (1, √5),
    es 1 + χ₅(n).  El carácter es traza − 1. -/
theorem trace_minus_one_is_chi5 (χ : ℤ) :
    Matrix.trace (!![1, 0; 0, χ] : Matrix (Fin 2) (Fin 2) ℤ) - 1 = χ := by
  simp [Matrix.trace_fin_two]

/-- **[P*] ★★★★ EL FACTOR DE EULER ES EL POLINOMIO CARACTERÍSTICO.**

    Con M = diag(1, χ₅(p)) la matriz de ψ_p en la base (1, √5):
      det(1 − t·M) = (1 − t)(1 − χ₅(p) t),
    que con t = p^{−s} es el inverso del factor local de
    ζ_{ℚ(√5)} = ζ · L(·,χ₅); el factor de L(·,χ₅) es el de la recta √5. -/
theorem euler_factor_is_char_poly {R : Type*} [CommRing R] (t χ : R) :
    Matrix.det ((1 : Matrix (Fin 2) (Fin 2) R) - t • !![1, 0; 0, χ])
      = (1 - t) * (1 - χ * t) := by
  simp [Matrix.det_fin_two, Matrix.one_apply]
  ring

/-- **[P*]** Casos: descompuesto (1 − t)², inerte 1 − t². -/
theorem euler_factor_split {R : Type*} [CommRing R] (t : R) :
    (1 - t) * (1 - 1 * t) = (1 - t) ^ 2 := by ring

theorem euler_factor_inert {R : Type*} [CommRing R] (t : R) :
    (1 - t) * (1 - (-1) * t) = 1 - t ^ 2 := by ring

/-- **[P*]** Potencias: la traza de ψ_p^k sobre √5 es χ₅(p)^k, que es el
    coeficiente con el que p^k entra en la fórmula explícita. -/
theorem frobenius_power_eigenvalue (n k : ℕ) (hn : ((n : ℕ) : ZMod 5) ≠ 0) :
    (ψ n)^[k] sqrt5 = ((F1PCFUnified.chi5_Z (n : ZMod 5) : ℤ) : Zφ) ^ k * sqrt5 := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [Function.iterate_succ_apply', ih, map_mul, map_pow, map_intCast,
        frobenius_eigenvalue_on_sqrt5 n hn]
    ring

end F1FrobeniusEigen

