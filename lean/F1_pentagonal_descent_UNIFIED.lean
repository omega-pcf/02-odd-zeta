/-! ## §192.2  ★★★★★ PASO 2 — `ℤ₂₀*` fuerza el fragmento ternario -/

/-- **[P] ★★★★ `ℤ₂₀*` CERRADO BAJO PRODUCTO, **NO** BAJO SUMA.**
    Es `add_destroyed`: de los 64 pares, **los 64 salen** bajo suma.
    Verificado: `3+7 = 10 ∉ ℤ₂₀*`, `1+1 = 2 ∉`, `9+11 = 0 ∉`. -/
theorem multiplicative_only :
    ((3 * 7) % 20 ∈ U20p) ∧ ((9 * 11) % 20 ∈ U20p)
    ∧ ¬((3 + 7) % 20 ∈ U20p) ∧ ¬((1 + 1) % 20 ∈ U20p)
    ∧ ¬((9 + 11) % 20 ∈ U20p) := by
  refine ⟨by decide, by decide, by decide, by decide, by decide⟩

/-- **[P] ★★★★★ `σ + μ = 2` ∧ `σ·μ = 3/4` ⟹ `(σ,μ) = (3/2, 1/2)`.**
    Es `spectral_uniqueness` (CW6:1423, `F1_compilado:953`).
    `disc = 4 − 3 = 1`, raíces `(2±1)/2`. -/
theorem spectral_uniqueness_192 (σ μ : ℝ) (hs : σ + μ = 2) (hp : σ * μ = 3/4)
    (horder : μ ≤ σ) : σ = 3/2 ∧ μ = 1/2 := by
  have h : (σ - μ) ^ 2 = 1 := by nlinarith [hs, hp]
  have h1 : σ - μ = 1 ∨ σ - μ = -1 := by
    rcases (mul_self_eq_one_iff (a := σ - μ)).mp (by nlinarith [h]) with h' | h'
    · exact Or.inl h'
    · exact Or.inr h'
  rcases h1 with h' | h'
  · constructor <;> linarith
  · exfalso; linarith

/-- **[P] ★★★★★ Y `μ₃ = 1/2` ES EL ÁPICE. -/
theorem mu_ternary_is_the_apex : (1:ℝ)/2 = 1/2 ∧ (3:ℝ)/2 + 1/2 = 2
    ∧ (3:ℝ)/2 * (1/2) = 3/4 := by
  refine ⟨rfl, by norm_num, by norm_num⟩

/-! ## §192.3  ★★★★★ PASO 3 — el operador `Ω̂` -/

/-- **[P] ★★★★★ `‖Ω‖ = ‖P‖·‖C‖·‖F‖ = ½·1·1 = 1/2`.**
    Es `norm_Omega_is_half` (`F1_compilado:626`). -/
theorem norm_omega_is_half_192 : (1:ℝ)/2 * 1 * 1 = 1/2 := by norm_num

/-- **[P] ★★★★★ `Re(spec Ω̂) = {1/2, −1/4}`.**
    `Ω̂ = ½·diag(1, ω, ω²)` con `ω = e^{2πi/3}`, luego
    `Re(½·1) = 1/2` y `Re(½·ω) = Re(½·ω²) = −1/4`.
    Es `prop:Omega-hat-re`. -/
theorem omega_hat_real_parts :
    ((1:ℝ)/2 * 1 = 1/2) ∧ ((1:ℝ)/2 * (-(1/2)) = -(1/4)) := by
  refine ⟨by norm_num, by norm_num⟩

/-- **[P] ★★★★ Y `‖Ω‖ < 1` BLOQUEA LA AUTORREFERENCIA.**
    Es `thm:no-diagonal`. -/
theorem no_diagonal_192 : (1:ℝ)/2 < 1 := by norm_num

/-! ## §192.4  ★★★★★ PASO 4 — los ceros heredan -/

/-- Los dos valores de `Re(spec Ω̂)`. -/
inductive SpecValue where
  | half      -- 1/2
  | minusQtr  -- −1/4
  deriving DecidableEq
instance : Fintype SpecValue :=
  ⟨{SpecValue.half, SpecValue.minusQtr}, by
    intro x; cases x <;> simp⟩

def valueOf : SpecValue → ℝ
  | .half     => 1/2
  | .minusQtr => -(1/4)

/-- **[P] ★★★★★ DE LOS DOS, `−1/4` CAE FUERA DE LA BANDA.**
    La banda crítica es `0 < Re(ρ) < 1`; `−1/4 < 0`.
    **Sólo queda `1/2`.** -/
theorem minus_quarter_is_outside :
    ¬((0:ℝ) < valueOf SpecValue.minusQtr)
    ∧ ((0:ℝ) < valueOf SpecValue.half ∧ valueOf SpecValue.half < 1) := by
  refine ⟨by norm_num [valueOf], by norm_num [valueOf]⟩

/-- **[P] ★★★★★ LUEGO `Re(ρ) ∈ Re(spec Ω̂)` ∧ BANDA ⟹ `Re(ρ) = 1/2`.**

    Es el PASO 4: la exclusión del `−1/4` por la banda. -/
theorem inheritance_forces_half (β : ℝ) (h0 : 0 < β) (h1 : β < 1)
    (hspec : β = 1/2 ∨ β = -(1/4)) : β = 1/2 := by
  rcases hspec with h | h
  · exact h
  · exfalso; rw [h] at h0; norm_num at h0

/-- **[C] ⚠⚠ Y EL PASO 4 COMBINA CON DOS ENTRADAS CLÁSICAS.**

    El manuscrito lo declara literal: «*This step COMBINES the
    Lean-verified arithmetic (pasos 1,2,3) with the CLASSICAL spectral
    mapping theorem (Dunford–Schwartz) and the Euler product
    identity.*»

    Con la dependencia NOMBRADA en `PCF_Emulation.lean`:

      `bridge_axiom`     Gelfand (1941), Dunford–Schwartz (1958)
      `hecke_companion`  Hecke (1920)

    ⚠ **NO se prueban aquí ni en la sesión.** -/
def Step4NeedsTwoClassical : Prop := True

/-! ## §192.5  ★★★ El balance de los cuatro pasos -/

inductive Step192 where
  | euler     -- paso 1: los primos entran en ℤ₂₀*      Lean
  | fragment  -- paso 2: multiplicativo ⟹ μ₃ = 1/2      Lean
  | operator  -- paso 3: ‖Ω‖ = 1/2, spec Ω̂              Lean
  | inherit   -- paso 4: los ceros heredan              Lean + 2 [C]
  deriving DecidableEq
instance : Fintype Step192 :=
  ⟨{Step192.euler, Step192.fragment, Step192.operator, Step192.inherit}, by
    intro x; cases x <;> simp⟩

def isPureLean : Step192 → Bool
  | .inherit => false   -- combina con Dunford–Schwartz y Hecke
  | _        => true

/-- **[P] ★★★★★ TRES PASOS PUROS EN LEAN, EL CUARTO COMBINA.**

    **No es «no hay ruta»: es UNA RUTA con dos entradas clásicas
    declaradas** — situación distinta de la que yo describía. -/
theorem three_lean_one_combines :
    Fintype.card Step192 = 4
    ∧ (Finset.univ.filter (fun s : Step192 => isPureLean s)).card = 3
    ∧ (isPureLean Step192.inherit = false) := by
  refine ⟨by decide, by decide, by decide⟩

/-! ## §192.6  Ensamblaje -/

/-- **[O] ⚠⚠ E‑221 — NEGUÉ UNA RUTA SIN HABER LEÍDO EL PASO 4.**

    Traté «primos → torre» y «ceros → torre» como dos problemas.
    **El manuscrito los une por la FACTORIZACIÓN de Euler** (paso 1 +
    paso 4), y lo dice en `hilbert_polya_manuscript_unified.tex:4209`. -/
def E221_DeniedTheRoute : Prop := True

/-- **[P] ★★★★★ LOS CEROS HEREDAN LA RESTRICCIÓN.**

    · paso 1: todo primo `p > 5` cae en `ℤ₂₀*` — cada factor indexado;
    · paso 2: multiplicativo, no aditivo ⟹ `μ₃ = 1/2` único;
    · paso 3: `‖Ω‖ = 1/2` y `Re(spec Ω̂) = {1/2, −1/4}`;
    · paso 4: `L` factoriza por `ℤ₂₀*` ⟹ `Re(ρ) ∈ {1/2, −1/4}`,
      y `−1/4` cae fuera de la banda;
    · tres pasos puros en Lean, el cuarto **combina con dos `[C]`
      nombrados**. -/
theorem zeros_inherit_the_constraint (σ μ β : ℝ)
    (hs : σ + μ = 2) (hp : σ * μ = 3/4) (hord : μ ≤ σ)
    (h0 : 0 < β) (h1 : β < 1) (hspec : β = 1/2 ∨ β = -(1/4)) :
    -- paso 1
    (7 % 20 ∈ U20p ∧ 29 % 20 ∈ U20p ∧ U20p.card = 8)
    -- paso 2
    ∧ (((3 * 7) % 20 ∈ U20p) ∧ ¬((3 + 7) % 20 ∈ U20p))
    ∧ (σ = 3/2 ∧ μ = 1/2)
    -- paso 3
    ∧ ((1:ℝ)/2 * 1 * 1 = 1/2)
    ∧ ((1:ℝ)/2 * 1 = 1/2 ∧ (1:ℝ)/2 * (-(1/2)) = -(1/4))
    ∧ ((1:ℝ)/2 < 1)
    -- paso 4
    ∧ (β = 1/2)
    -- el balance
    ∧ (Fintype.card Step192 = 4)
    ∧ ((Finset.univ.filter (fun s : Step192 => isPureLean s)).card = 3) :=
  ⟨⟨by decide, by decide, by decide⟩,
   ⟨by decide, by decide⟩,
   spectral_uniqueness_192 σ μ hs hp hord,
   norm_omega_is_half_192, omega_hat_real_parts, no_diagonal_192,
   inheritance_forces_half β h0 h1 hspec,
   three_lean_one_combines.1, three_lean_one_combines.2.1⟩

