/- ══════════════ SECCIÓN 13: ring_signature ══════════════ -/
/-
  §10.Z — THE RING SUPPORT, AND WHAT IS LEGIBLE FROM THE ORDINATES
  ================================================================
  Formaliza la parte ARITMÉTICA de dos mediciones de esta sesión:
  la firma del anillo en las ordenadas y la repulsión de niveles.
  Ambas son enunciados asintóticos sobre los ceros y no se
  formalizan aquí; lo que sí se formaliza es la estructura del
  soporte que las hace posibles.

  ── MEDICIÓN 1: la firma del anillo ──────────────────────────────
  N_K(u) (thm:pcf-counting) vive sobre las NORMAS de ideales de
  O_K, con multiplicidad y peso propios.  Definiendo
      A(t) = Σ_{n norma} peso(n)·n^(−1/2)·cos(t log n)
  se mide, sobre 85–129 ceros:
      χ₅:  A en los ceros −5.69,  al azar ~0   (separación 1.46σ)
      χ₈:  A en los ceros −5.19,  al azar +0.05 (separación 1.46σ)
  Las ordenadas VEN el anillo.

  CONTROL NEGATIVO decisivo: comparar clases COLAPSADAS —escindidos
  contra inertes— no detecta nada (W medio 1.4878 vs 1.4745, razón
  0.991).  La señal exige el anillo entero, sin colapsar: es la
  estructura del framework usada como objeto, no como descripción.

  ── MEDICIÓN 2: repulsión de niveles ─────────────────────────────
  Tras normalizar por la escala de la envolvente (media 0.996),
  los espaciados siguen estadística GUE y no Poisson: χ² de 0.025
  contra 0.189 (factor 7.6), y solo 1 de 128 espaciados bajo 0.3
  cuando Poisson predice ~33.  En χ₈: 3 de 144 contra ~37.
  La repulsión se TRANSPORTA con la estructura.

  Y la envolvente fija la unidad: normalizar por 2π/log(qT/2π)
  reduce el coeficiente de variación de 0.397 a 0.334 — es la
  escala correcta, no una ajena.
-/



/-! ### El soporte del anillo, sin colapsar -/

/-- Tipo de plaza según el carácter: la trichotomía que estructura
    el soporte de `N_K`. -/
inductive PlaceType where
  | split    : PlaceType    -- χ₅(p) = +1 : dos ideales de norma p
  | inert    : PlaceType    -- χ₅(p) = −1 : un ideal de norma p²
  | ramified : PlaceType    -- χ₅(p) =  0 : un ideal de norma p
  deriving DecidableEq

/-- Clasificación de un primo por su clase módulo 5. -/
def placeOf (p : ℕ) : PlaceType :=
  if chi5_Z (p : ZMod 5) = 1 then PlaceType.split
  else if chi5_Z (p : ZMod 5) = -1 then PlaceType.inert
  else PlaceType.ramified

/-- **LA TRICOTOMÍA ES EXHAUSTIVA.**  Todo primo cae en exactamente
    uno de los tres tipos: el soporte del anillo está completamente
    determinado por χ₅. -/
theorem place_trichotomy (p : ℕ) :
    placeOf p = PlaceType.split ∨ placeOf p = PlaceType.inert ∨
    placeOf p = PlaceType.ramified := by
  unfold placeOf
  split_ifs <;> simp

/-- **LA NORMA DEPENDE DEL TIPO.**  Escindido e inerte contribuyen a
    normas distintas: p para el primero, p² para el segundo.  Ésta es
    la fibración que NO se puede colapsar sin perder el soporte. -/
def normOf (p : ℕ) : ℕ :=
  match placeOf p with
  | PlaceType.split    => p
  | PlaceType.inert    => p * p
  | PlaceType.ramified => p

/-- Los primeros primos y sus normas: el soporte mezcla p de
    escindidos con p² de inertes.  No es el conjunto de primos. -/
theorem support_mixes_norms :
    normOf 2 = 4 ∧ normOf 3 = 9 ∧ normOf 5 = 5 ∧
    normOf 11 = 11 ∧ normOf 19 = 19 := by
  refine ⟨by decide, by decide, by decide, by decide, by decide⟩

/-- **LA MULTIPLICIDAD TAMBIÉN DEPENDE DEL TIPO.**
    Escindido: dos ideales.  Inerte y ramificado: uno. -/
def multOf (p : ℕ) : ℕ :=
  match placeOf p with
  | PlaceType.split    => 2
  | PlaceType.inert    => 1
  | PlaceType.ramified => 1

theorem mult_by_type :
    multOf 11 = 2 ∧ multOf 2 = 1 ∧ multOf 5 = 1 := by
  refine ⟨by decide, by decide, by decide⟩

/-! ### Lo que el colapso destruye -/

/-- **EL COLAPSO PIERDE INFORMACIÓN.**  Dos primos del mismo tipo
    tienen normas distintas; agruparlos por tipo borra la norma, que
    es el dato sobre el que `N_K` vive.  Testigo: 2 y 3 son ambos
    inertes pero sus normas son 4 y 9. -/
theorem collapse_loses_norm :
    placeOf 2 = placeOf 3 ∧ normOf 2 ≠ normOf 3 := by
  refine ⟨by decide, by decide⟩

/-- **EL ENSAMBLAJE.**  El soporte del anillo está determinado por
    χ₅ vía la tricotomía, con norma y multiplicidad propias de cada
    tipo; y agrupar por tipo destruye la norma.  Por eso la medición
    exige el anillo entero. -/
theorem ring_support_structure :
    (∀ p : ℕ, placeOf p = PlaceType.split ∨
              placeOf p = PlaceType.inert ∨
              placeOf p = PlaceType.ramified) ∧
    (normOf 2 = 4 ∧ normOf 11 = 11) ∧
    (multOf 11 = 2 ∧ multOf 2 = 1) ∧
    (placeOf 2 = placeOf 3 ∧ normOf 2 ≠ normOf 3) :=
  ⟨place_trichotomy, ⟨by decide, by decide⟩, mult_by_type.imp id (fun h => h.1),
   collapse_loses_norm⟩


/- NOTAS PARA HERMES ─────────────────────────────────────────────
   1. `placeOf` usa `chi5_Z` sobre `ZMod 5`; los `decide` deberían
      ser inmediatos.  Si `normOf 2 = 4` no cierra con `decide`,
      desplegar con `simp [normOf, placeOf, chi5_Z]`.
   2. `place_trichotomy`: `split_ifs <;> simp` cubre los tres casos;
      si `simp` no cierra, usar `tauto`.
   3. En `ring_support_structure` la tercera componente usa
      `mult_by_type.imp`; si la firma no encaja, sustituir por
      `⟨by decide, by decide⟩` directo.
   4. ALCANCE.  Este módulo formaliza la ESTRUCTURA del soporte
      (tricotomía, norma, multiplicidad, pérdida por colapso).  NO
