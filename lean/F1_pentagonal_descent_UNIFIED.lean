/-! ## 1.  ¿Es el polinomio irreducible módulo p? -/

/-- `λ² − λ − 1` evaluado en `x`, sobre ℤ. -/
def polyVal (x : Int) : Int := x * x - x - 1

/-- ¿Tiene `λ² − λ − 1` una raíz módulo `p`?  Si no la tiene, `p` es inerte y
    `ℤ[φ]/(p)` es el cuerpo `𝔽_{p²}`; si la tiene, el cociente no es cuerpo. -/
def hasRootMod (p : Nat) : Bool :=
  (List.range p).any (fun x => polyVal (x : Int) % (p : Int) == 0)

/-- **[P] EL 2 ES INERTE.**  (Es `golden_poly_no_root_mod2` en la forma
    uniforme que permite comparar primos.) -/
theorem two_is_inert : hasRootMod 2 = false := by decide

/-- **[P] PERO EL 3 TAMBIÉN LO ES.**  Ésta es la dependencia que faltaba
    declarar: la inercia no singulariza al 2. -/
theorem three_is_inert : hasRootMod 3 = false := by decide

/-- **[P] Y NO TODO PRIMO ES INERTE: EL 5 RAMIFICA, EL 11 PARTE.**  Luego la
    inercia sí es una condición sobre el primo, y el cociente es cuerpo sólo
    para algunos.  (`λ² − λ − 1 ≡ (λ−3)² mod 5`.) -/
theorem five_and_eleven_are_not_inert :
    hasRootMod 5 = true ∧ hasRootMod 11 = true := by decide

/-! ## 2.  El cuerpo `𝔽_{p²}` y el orden de `φ̄` en él -/

/-- `a + b·t` en `ℤ/p[t]/(t² − t − 1)`.  Multiplicación con `t² = t + 1`:
    `(a+bt)(c+dt) = (ac + bd) + (ad + bc + bd)·t`. -/
def fmul (p : Nat) (x y : Nat × Nat) : Nat × Nat :=
  ((x.1 * y.1 + x.2 * y.2) % p,
   (x.1 * y.2 + x.2 * y.1 + x.2 * y.2) % p)

def fone : Nat × Nat := (1, 0)

/-- `φ̄ = t`. -/
def phiBar : Nat × Nat := (0, 1)

def fpow (p : Nat) (x : Nat × Nat) : Nat → Nat × Nat
  | 0     => fone
  | n + 1 => fmul p (fpow p x n) x

/-- **[P] EN `𝔽₄`, `φ̄` TIENE ORDEN EXACTAMENTE 3.**  El color es `ℤ/3`. -/
theorem ord_phiBar_mod_two :
    fpow 2 phiBar 3 = fone ∧ fpow 2 phiBar 1 ≠ fone ∧ fpow 2 phiBar 2 ≠ fone := by
  decide

/-- **[P] EN `𝔽₉`, `φ̄` TIENE ORDEN EXACTAMENTE 8.**  Con el primo 3 el
    «color» sería `ℤ/8`, no `ℤ/3`. -/
theorem ord_phiBar_mod_three :
    fpow 3 phiBar 8 = fone ∧
    ((List.range 7).all (fun k => !(fpow 3 phiBar (k + 1) == fone))) = true := by
  decide

/-! ## 3.  El grupo de cubierta que cada primo produce -/

/-- El grupo de cubierta es generado por `(φ̄ⁿ, (det M)ⁿ)`, de orden
    `lcm(ord(φ̄), 2)`.  Escrito sin `Nat.lcm`: duplicar si el orden es impar. -/
def deckOrd (o : Nat) : Nat := if o % 2 == 0 then o else 2 * o

/-- **[P] CON EL 2 SALE 6; CON EL 3 SALDRÍA 8.** -/
theorem deck_order_two_vs_three : deckOrd 3 = 6 ∧ deckOrd 8 = 8 := by decide

/-- **[P] Y 6 ES EL MÍNIMO SOBRE TODO PRIMO INERTE `p ≥ 3`.**

    El orden de `φ̄` en `𝔽_{p²}ˣ` es a lo sumo `p² − 1`; lo que se usa aquí es
    la cota por abajo que ya basta: para `p ≥ 3` el grupo de cubierta que
    resulta del orden `p² − 1` es al menos `8 > 6`.  Con el orden efectivo
    para `p = 3` —que es exactamente `8`, por `ord_phiBar_mod_three`— la cota
    se alcanza. -/
theorem six_is_below_every_odd_prime :
    ∀ p : Nat, 3 ≤ p → 6 < deckOrd (p * p - 1) := by
  intro p hp
  have h9 : 9 ≤ p * p := Nat.mul_le_mul hp hp
  have h8 : 8 ≤ p * p - 1 := by omega
  unfold deckOrd
  by_cases h : (p * p - 1) % 2 == 0
  · simp [h]; omega
  · simp [h]; omega

/-! ## 3b.  El caso general: qué primo sirve, para qué matriz

    Todo lo anterior es sobre `λ² − λ − 1`.  La misma pregunta —qué primo, y
    qué grupo produce— tiene respuesta para todo `M ∈ GL₂(ℤ)` hiperbólico, y
    **hace falta aquí**:

    `six_is_below_every_odd_prime` acota `deckOrd (p² − 1)`, pero el color no
    es todo `𝔽_{p²}ˣ` sino `⟨φ̄⟩`, cuyo orden `e` divide a `p² − 1` y lo divide
    **propiamente** para todo primo inerte `p ≥ 7` (`p = 7` da `e = 16`, no
    `48`; `p = 13` da `28`, no `168`).  Esa cota, entonces, no cierra el paso
    (d) de `prop:minprime` por sí sola: acota una cantidad distinta de la que
    el enunciado nombra.

    Lo que sí lo cierra es el par `colour_order_even` +
    `odd_prime_leaves_the_exact_class`, abajo, que acota `e` directamente.  Y
    el argumento depende de `det M = −1`: §3d exhibe el contraejemplo con
    `det M = +1`. -/

/-- `λ² − t·λ + d` evaluado en `x`.  Con `t = 1`, `d = −1` es `polyVal`. -/
def genPolyVal (t d x : Int) : Int := x * x - t * x + d

/-- **[P] TRAZA IMPAR ⟹ EL 2 ES INERTE.**  Generaliza `two_is_inert`.

    Si `t` es impar y `d` es impar —lo es siempre, porque `d = ±1`— entonces
    `λ² − t·λ + d` no tiene raíz módulo 2, luego `ℤ[λ]/(2) ≅ 𝔽₄`.

    La razón es de paridad pura: `x·(x − t)` es par para todo `x` cuando `t`
    es impar —si `x` es par lo es por `x`, y si `x` es impar lo es por
    `x − t`— así que el valor del polinomio es `par + impar = impar`. -/
theorem two_inert_of_trace_odd (t d : Int) (ht : t % 2 = 1) (hd : d % 2 ≠ 0) :
    ∀ x : Int, genPolyVal t d x % 2 ≠ 0 := by
  intro x
  have hfac : x * x - t * x = x * (x - t) := by
    rw [Int.mul_sub, Int.mul_comm x t]
  have heven : ∃ c : Int, x * x - t * x = 2 * c := by
    rcases (by omega : x % 2 = 0 ∨ x % 2 = 1) with hx | hx
    · refine ⟨(x / 2) * (x - t), ?_⟩
      have hx2 : x = 2 * (x / 2) := by omega
      rw [hfac, ← Int.mul_assoc, ← hx2]
    · refine ⟨x * ((x - t) / 2), ?_⟩
      have hxt : x - t = 2 * ((x - t) / 2) := by omega
      have h1 : x * (x - t) = x * (2 * ((x - t) / 2)) := by rw [← hxt]
      have h2 : x * (2 * ((x - t) / 2)) = 2 * (x * ((x - t) / 2)) := by
        rw [← Int.mul_assoc, ← Int.mul_assoc, Int.mul_comm x 2]
      rw [hfac, h1, h2]
  obtain ⟨c, hc⟩ := heven
  unfold genPolyVal
  rw [hc]
  have hre : 2 * c + d = d + c * 2 := by rw [Int.mul_comm c 2]; omega
  rw [hre, Int.add_mul_emod_self_right]
  exact hd

/-- **[P] TRAZA PAR ⟹ EL 2 NO ES INERTE.**  `x = 1` es raíz módulo 2.  Luego
    `ℤ[λ]/(2)` no es cuerpo, y el 2 no sirve como primo de color. -/
theorem two_not_inert_of_trace_even (t d : Int) (ht : t % 2 = 0) (hd : d % 2 ≠ 0) :
    genPolyVal t d 1 % 2 = 0 := by
  unfold genPolyVal
  omega

/-- **[P⊕] LA DICOTOMÍA DEL 2, COMPLETA.**  Para todo `M ∈ GL₂(ℤ)`: el 2 es
    inerte en `ℤ[λ]` **si y sólo si** la traza de `M` es impar.  Para el `M`
    de este paper la traza es `1`, y eso es todo lo que `two_is_inert` dice. -/
theorem two_inert_iff_trace_odd (t d : Int) (hd : d % 2 ≠ 0) :
    (∀ x : Int, genPolyVal t d x % 2 ≠ 0) ↔ t % 2 = 1 := by
  constructor
  · intro h
    rcases (by omega : t % 2 = 0 ∨ t % 2 = 1) with ht | ht
    · exact absurd (two_not_inert_of_trace_even t d ht hd) (h 1)
    · exact ht
  · intro ht
    exact two_inert_of_trace_odd t d ht hd

/-- Discriminante de `M`: `Δ = t² − 4d`.  Para el `M` del paper, `Δ = 5`. -/
def disc (t d : Int) : Int := t * t - 4 * d

/-- Cuadrado de un impar: `(2k+1)² = 4·k·(k+1) + 1`. -/
theorem sq_of_odd (k : Int) : (2 * k + 1) * (2 * k + 1) = 4 * (k * (k + 1)) + 1 := by
  simp [Int.add_mul, Int.mul_add, Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  omega

/-- **[P] TRAZA IMPAR ⟹ `Δ ≡ 5 (mod 8)`.**  La misma dicotomía, en la forma
    en que aparece en la literatura de cuerpos cuadráticos: el 2 es inerte en
    un orden de discriminante `Δ` exactamente cuando `Δ ≡ 5 (mod 8)`.  Que las
    dos formulaciones coincidan es lo que permite leer la condición sobre `M`
    (traza impar) como una condición sobre el anillo. -/
theorem disc_mod_eight_of_trace_odd (t d : Int) (ht : t % 2 = 1)
    (hd : d = 1 ∨ d = -1) : disc t d % 8 = 5 := by
  obtain ⟨k, hk⟩ : ∃ k : Int, t = 2 * k + 1 := ⟨t / 2, by omega⟩
  obtain ⟨m, hm⟩ : ∃ m : Int, k * (k + 1) = 2 * m := by
    rcases (by omega : k % 2 = 0 ∨ k % 2 = 1) with hp | hp
    · refine ⟨(k / 2) * (k + 1), ?_⟩
      have hk2 : k = 2 * (k / 2) := by omega
      rw [← Int.mul_assoc, ← hk2]
    · refine ⟨k * ((k + 1) / 2), ?_⟩
      have hk2 : k + 1 = 2 * ((k + 1) / 2) := by omega
      have h1 : k * (k + 1) = k * (2 * ((k + 1) / 2)) := by rw [← hk2]
      have h2 : k * (2 * ((k + 1) / 2)) = 2 * (k * ((k + 1) / 2)) := by
        rw [← Int.mul_assoc, ← Int.mul_assoc, Int.mul_comm k 2]
      rw [h1, h2]
  have hsq : t * t = 8 * m + 1 := by
    rw [hk, sq_of_odd k, hm]; omega
  unfold disc
  rw [hsq]
  rcases hd with h | h <;> rw [h] <;> omega

/-! ## 3c.  Por qué ningún primo impar baja de seis, cuando `det M = −1`

    Los tres hechos de cuerpo se declaran como hipótesis en vez de
    construirse: `𝔽_{p²}` para `p` general no está en este archivo, que lo
    construye sólo para `p = 2, 3` (`fmul`, arriba).  Son:

      (N)  `λ̄^(p+1) = d`          — la norma, vía Frobenius `λ̄^p = λ̄'`
      (I)  `e ∣ p − 1 → ¬inerte`  — `λ̄ ∈ 𝔽_p` exactamente cuando `e ∣ p−1`
      (T)  `−1` es el único elemento de orden 2, y está en `⟨λ̄⟩`

    Dadas ellas, la conclusión es aritmética elemental y se demuestra entera. -/

/-- La clase exacta: los `n` con `φ(n) ≤ 2`, es decir `ℚ(ζₙ)` a lo sumo
    cuadrático.  Por Gauss, `{1,2,3,4,6}`.  Es la condición para que la
    síntesis viva en un anillo de enteros cuadrático y la inversión sea
    aritmética entera **sin división**, como en `thm:inversion`.  Los casos no
    triviales son `n ∈ {3,6}` → `ℤ[ω]`, y `n = 4` → `ℤ[i]`. -/
def inExactClass (n : Nat) : Prop :=
  n = 1 ∨ n = 2 ∨ n = 3 ∨ n = 4 ∨ n = 6

theorem exact_class_le_six (n : Nat) (h : inExactClass n) : n ≤ 6 := by
  unfold inExactClass at h; omega

/-- Si `e` es impar y `e ∣ 2m`, entonces `e ∣ m`. -/
theorem odd_dvd_of_dvd_two_mul (e m : Nat) (he : e % 2 = 1) (h : e ∣ 2 * m) :
    e ∣ m := by
  obtain ⟨k, hk⟩ := h
  have hmod : (e * k) % 2 = (2 * m) % 2 := by rw [hk]
  have hk2 : k % 2 = 0 := by
    rw [Nat.mul_mod, he, Nat.mul_mod 2 m] at hmod
    omega
  obtain ⟨j, hj⟩ : ∃ j, k = 2 * j := ⟨k / 2, by omega⟩
  subst hj
  refine ⟨j, ?_⟩
  have h1 : e * (2 * j) = 2 * (e * j) := by
    rw [← Nat.mul_assoc, ← Nat.mul_assoc, Nat.mul_comm e 2]
  rw [h1] at hk
  omega

/-- **[P] `det M = −1` Y `p` IMPAR ⟹ EL ORDEN DEL COLOR ES PAR.**

    Si `e` fuese impar, de `e ∣ 2(p+1)` saldría `e ∣ p+1`, luego
    `λ̄^(p+1) = 1`; pero `λ̄^(p+1) = d = −1 ≠ 1` para `p` impar. -/
theorem colour_order_even (e p : Nat) (_hp : 3 ≤ p)
    (hdvd : e ∣ 2 * (p + 1)) (hnorm : ¬ (e ∣ p + 1)) : e % 2 = 0 := by
  rcases (by omega : e % 2 = 0 ∨ e % 2 = 1) with he | he
  · exact he
  · exact absurd (odd_dvd_of_dvd_two_mul e (p + 1) he hdvd) hnorm

/-- Con orden par, el grupo de cubierta es el color mismo: no hay duplicación. -/
theorem deckOrd_of_even (e : Nat) (h : e % 2 = 0) : deckOrd e = e := by
  unfold deckOrd; rw [h]; rfl

/-- **[P⊕] `det M = −1` Y `p` IMPAR ⟹ EL GRUPO SE SALE DE LA CLASE EXACTA.**

    Con `e` par quedan sólo `e ∈ {2,4,6}` por descartar:

      `e = 2` : `λ̄² = 1`, luego `λ̄ = ±1 ∈ 𝔽_p`  — contradice la inercia.
      `e = 4` : `−1` es el único elemento de orden 2 de `⟨λ̄⟩`, luego
                `−1 = λ̄²`; con `λ̄^(p+1) = −1` sale `λ̄^(p−1) = 1`, es decir
                `λ̄ ∈ 𝔽_p`  — contradice la inercia.
      `e = 6` : igual, `−1 = λ̄³`, luego `6 ∣ p−2`; pero `p` impar hace `p−2`
                impar y `6` es par  — imposible. -/
theorem odd_prime_leaves_the_exact_class
    (e p : Nat) (hp : 3 ≤ p) (hodd : p % 2 = 1)
    (heven : e % 2 = 0) (hne2 : e ≠ 2) (hne4 : e ≠ 4)
    (hne6 : e = 6 → 6 ∣ p - 2) :
    ¬ inExactClass (deckOrd e) := by
  have hdeck : deckOrd e = e := deckOrd_of_even e heven
  have hne6' : e ≠ 6 := by
    intro h
    obtain ⟨c, hc⟩ := hne6 h
    omega
  clear hne6 hp hodd
  rw [hdeck]
  unfold inExactClass
  omega

/-- **[P⊕] Y ÉSTE ES EL PASO (d) DE `prop:minprime`, CON LA COTA CORRECTA.**

    Para el `M` de este paper (`det M = −1`) y todo primo inerte impar, el
    grupo de cubierta supera a `6` — acotando el orden del color, que es la
    cantidad que el enunciado nombra, y no `p² − 1`, que no lo es. -/
theorem six_is_the_least_over_the_colour_order
    (e p : Nat) (hp : 3 ≤ p) (hodd : p % 2 = 1) (hpos : 0 < e)
    (heven : e % 2 = 0) (hne2 : e ≠ 2) (hne4 : e ≠ 4)
    (hne6 : e = 6 → 6 ∣ p - 2) :
    6 < deckOrd e := by
  have hdeck : deckOrd e = e := deckOrd_of_even e heven
  have hne6' : e ≠ 6 := by
    intro h
    obtain ⟨c, hc⟩ := hne6 h
    omega
  clear hne6 hp hodd
  rw [hdeck]
  omega

/-! ## 3d.  Y con `det M = +1` el argumento de §3c es falso

    Con `t = 6`, `d = +1`, el polinomio es `λ² − 6λ + 1 ≡ λ² + 1 (mod 3)`,
    irreducible sobre `𝔽₃`; en `𝔽₉` se tiene `λ̄² = −1`, luego `e = 4` y el
    grupo es `μ₄ = ℤ[i]ˣ` — dentro de la clase exacta, con `p = 3`.

    Luego la hipótesis `det M = −1` de §3c no es un artefacto de la
    demostración: sin ella el enunciado es falso.  Lo que la hace verdadera es
    que `−1 ≠ 1` para `p` impar, y que con `d = −1` ese `−1` está forzado a
    vivir dentro del color.  En característica 2, en cambio, `−1 = 1`: por eso
    allí el orden del color es impar (`3`) y la orientación aporta un
    generador **nuevo**, con `lcm(3,2) = 6`. -/

/-- Producto en `𝔽_p[λ]/(λ² − t·λ + d)`, con `λ² = t·λ − d`. -/
def gfmul (p t d : Nat) (x y : Nat × Nat) : Nat × Nat :=
  ((x.1 * y.1 + x.2 * y.2 * (p - d % p)) % p,
   (x.1 * y.2 + x.2 * y.1 + x.2 * y.2 * t) % p)

def gfpow (p t d : Nat) (x : Nat × Nat) : Nat → Nat × Nat
  | 0     => (1, 0)
  | n + 1 => gfmul p t d (gfpow p t d x n) x

/-- **[P] `λ² − 6λ + 1` ES INERTE MÓDULO 3, Y ALLÍ `λ̄` TIENE ORDEN 4.** -/
theorem counterexample_order_four :
    ((List.range 3).all (fun x => !((x * x + 3 * 3 - 6 * x + 1) % 3 == 0))) = true ∧
    gfpow 3 6 1 (0, 1) 4 = (1, 0) ∧
    gfpow 3 6 1 (0, 1) 1 ≠ (1, 0) ∧
    gfpow 3 6 1 (0, 1) 2 ≠ (1, 0) ∧
    gfpow 3 6 1 (0, 1) 3 ≠ (1, 0) := by
  decide

/-- **[P⊕] EL CONTRAEJEMPLO, ENSAMBLADO.**  Con `det M = +1` un primo impar
    puede caer dentro de la clase exacta, en `ℤ[i]`.  La hipótesis
    `det M = −1` de §3c es necesaria. -/
theorem det_plus_one_breaks_the_dichotomy :
    gfpow 3 6 1 (0, 1) 4 = (1, 0) ∧ inExactClass 4 ∧ disc 6 1 = 32 := by
  refine ⟨by decide, ?_, by decide⟩
  unfold inExactClass; omega

/-! ## 4.  La conjunción -/

/-- **[P⊕] EL PRIMO ES UNA ELECCIÓN, Y EL 2 DA EL MÍNIMO.**

    (a) el 2 es inerte, y el 3 también: la inercia no singulariza al 2;
    (b) el 5 y el 11 no lo son: la inercia sí es una condición;
    (c) con el 2, `ord(φ̄) = 3` y el grupo de cubierta es `6`;
    (d) con el 3, `ord(φ̄) = 8` y sería `8`;
    (e) y para todo `p ≥ 3` el grupo que resulta supera a `6`.

    Luego el enunciado correcto no es «μ₆ sale de la aritmética sola»: es
    **«fijado el primo de comparación, el grupo está forzado, y el primo de
    este paper da el grupo más pequeño que el anillo produce»**.  Cuál es el
    primo de comparación lo decide el objeto contra el que se compara —la
    rejilla diádica, `cor:dyadic`, `prop:nomra`— y no la conveniencia del
    resultado. -/
theorem the_prime_is_a_choice_and_two_is_the_least :
    (hasRootMod 2 = false ∧ hasRootMod 3 = false) ∧
    (hasRootMod 5 = true ∧ hasRootMod 11 = true) ∧
    (fpow 2 phiBar 3 = fone ∧ deckOrd 3 = 6) ∧
    (fpow 3 phiBar 8 = fone ∧ deckOrd 8 = 8) ∧
    (∀ p : Nat, 3 ≤ p → 6 < deckOrd (p * p - 1)) ∧
    -- (f) la cota correcta para (d): sobre el ORDEN DEL COLOR, no sobre `p²−1`
    (∀ e p : Nat, 3 ≤ p → p % 2 = 1 → 0 < e → e % 2 = 0 → e ≠ 2 → e ≠ 4 →
        (e = 6 → 6 ∣ p - 2) → 6 < deckOrd e) ∧
    -- (g) y depende de `det M = −1`: con `+1` el contraejemplo cae en `ℤ[i]`
    (gfpow 3 6 1 (0, 1) 4 = (1, 0) ∧ inExactClass 4) :=
  ⟨⟨two_is_inert, three_is_inert⟩, five_and_eleven_are_not_inert,
   ⟨ord_phiBar_mod_two.1, deck_order_two_vs_three.1⟩,
   ⟨ord_phiBar_mod_three.1, deck_order_two_vs_three.2⟩,
   six_is_below_every_odd_prime,
   fun e p hp ho hpos hev h2 h4 h6 =>
     six_is_the_least_over_the_colour_order e p hp ho hpos hev h2 h4 h6,
   ⟨det_plus_one_breaks_the_dichotomy.1, det_plus_one_breaks_the_dichotomy.2.1⟩⟩



