theorem links_one_and_two (z : Chi5Zero) :
    (DirichletCharacter.LFunction chi5_D (1 - z.ρ) = 0) ∧
    (zeroCoord (1 - z.ρ) = (zeroCoord z.ρ)⁻¹) := by
  have h0 : z.ρ ≠ 0 := by
    intro h; have := z.in_strip_pos; rw [h] at this; simp at this
  have h1 : z.ρ ≠ 1 := by
    intro h; have := z.in_strip_lt; rw [h] at this; simp at this
  exact ⟨hecke_chi5_derived z.in_strip_pos z.in_strip_lt z.is_zero,
         coordinate_is_equivariant z.ρ h0 h1⟩

theorem link_five (z : Chi5Zero)
    (hself : zeroCoord (1 - z.ρ) = zeroCoord z.ρ) :
    z.ρ.re = 1/2 := by
  have hpos : 0 < zeroCoord z.ρ := zeroCoord_pos_on_zeros z.ρ ⟨z, rfl⟩
  have hinv := (links_one_and_two z).2
  have hsq : zeroCoord z.ρ * zeroCoord z.ρ = 1 := by
    rw [hself] at hinv
    field_simp at hinv
    nlinarith [hinv, hpos]
  have h1 : zeroCoord z.ρ = 1 := by nlinarith [hsq, hpos]
  exact (hcoord_discharged z.ρ z.in_strip_pos).mp h1

theorem link_six_is_the_gap (c : ℝ) :
