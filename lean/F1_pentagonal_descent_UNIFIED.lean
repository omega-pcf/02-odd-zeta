theorem zeroCoord_is_a_distance_ratio (ρ : ℂ) (h₀ : ρ ≠ 0) :
    zeroCoord ρ = Complex.abs (ρ - 1) / Complex.abs ρ := by
  unfold zeroCoord liMap Complex.abs
  rw [show (1 : ℂ) - 1/ρ = (ρ - 1)/ρ by field_simp, norm_div]

theorem level_one_is_equidistance (ρ : ℂ) :
    Complex.abs (ρ - 1) = Complex.abs ρ ↔ ρ.re = 1/2 := by
  have key : Complex.abs (ρ - 1) ^ 2 = Complex.abs ρ ^ 2 ↔ ρ.re = 1/2 := by
    rw [Complex.sq_abs, Complex.sq_abs, Complex.normSq_apply, Complex.normSq_apply]
    simp only [Complex.sub_re, Complex.sub_im, Complex.one_re, Complex.one_im, sub_zero]
    constructor <;> intro h <;> nlinarith [h]
  constructor
  · intro h; exact key.mp (by rw [h])
  · intro h
    have h2 := key.mpr h
    have ha := Complex.abs.nonneg (ρ - 1)
    have hb := Complex.abs.nonneg ρ
    nlinarith [h2, ha, hb]

theorem radius_le_one_above (k : ℝ) (hk : 1 < k) :
    k / (k ^ 2 - 1) ≤ 1 ↔ 0 ≤ k ^ 2 - k - 1 := by
  have hd : 0 < k ^ 2 - 1 := by nlinarith
  rw [div_le_one hd]
  constructor <;> intro h <;> linarith

theorem phi_gives_radius_exactly_one :
    (φ : ℝ) / ((φ : ℝ) ^ 2 - 1) = 1 := by
  have h := phi_sq
  have hpos : (0:ℝ) < (φ : ℝ) ^ 2 - 1 := by
    rw [h]; linarith [φ_pos]
  rw [div_eq_one_iff_eq (ne_of_gt hpos)]
  linarith [h]

theorem inv_phi_gives_radius_exactly_one :
    ((φ : ℝ))⁻¹ / (1 - ((φ : ℝ))⁻¹ ^ 2) = 1 := by
  have hp : (φ : ℝ) ≠ 0 := ne_of_gt φ_pos
  have key : (1 : ℝ) - (φ : ℝ)⁻¹ ^ 2 = (φ : ℝ)⁻¹ := by
    field_simp
    linear_combination phi_sq
  have hpos : (0:ℝ) < (1:ℝ) - (φ : ℝ)⁻¹ ^ 2 := by
    rw [key]; exact inv_pos.mpr φ_pos
  rw [div_eq_one_iff_eq (ne_of_gt hpos)]
  linarith [key]

theorem radius_shrinks_further_out :
    ((φ : ℝ) ^ 2) / (((φ : ℝ) ^ 2) ^ 2 - 1) < 1 := by
  have h := phi_sq
  have h1 : (1.61 : ℝ) < (φ : ℝ) := by
    have h5 : (2.23 : ℝ) < Real.sqrt 5 := by
      nlinarith [Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 5), Real.sqrt_nonneg 5]
    unfold φ; linarith
  have hd : (0:ℝ) < ((φ : ℝ) ^ 2) ^ 2 - 1 := by nlinarith
  rw [div_lt_one hd]
  nlinarith [h, h1]

theorem membership_is_apollonius (ρ : ℂ) (h₀ : ρ ≠ 0) (k : ℝ) (hk : 1 < k) :
    (zeroCoord ρ = Complex.abs (ρ - 1) / Complex.abs ρ) ∧
    (Complex.abs (ρ - 1) = Complex.abs ρ ↔ ρ.re = 1/2) ∧
    (k / (k ^ 2 - 1) ≤ 1 ↔ 0 ≤ k ^ 2 - k - 1) ∧
    ((φ : ℝ) / ((φ : ℝ) ^ 2 - 1) = 1) :=
  ⟨zeroCoord_is_a_distance_ratio ρ h₀,
   level_one_is_equidistance ρ,
   radius_le_one_above k hk,
   phi_gives_radius_exactly_one⟩

