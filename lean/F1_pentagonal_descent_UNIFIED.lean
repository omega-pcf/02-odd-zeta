    ((1:ℝ)/8 = (1/2)/4) ∧
    (Complex.abs (Omega_hat k) = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ))) :=
  ⟨golden_fixed_point_unique x hx heq, phiUnit_is_genuine,
   ⟨four_traces_differ, kernel_two_and_four_fibres.1⟩,
   ⟨zeroSetDeterminedByPhi_is_vacuous Z, Iff.rfl⟩,
   alpha0_is_sigma_minus_mu_over_conductor, by norm_num,
