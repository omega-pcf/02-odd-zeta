/-! ## §129.1  La información no se pierde: la cadena es inyectiva -/

/-- **[C] LA CADENA INYECTIVA.**  Generadores distintos dan conjuntos
    de ceros distintos ---§64 `ChainInjective`, medido:
    `φ → γ₁ = 6.6484`, `1+√2 → γ₁ = 4.8999`. -/
def ChainInjective₉ (gen zeros : ℕ → ℝ) : Prop :=
  ∀ m n, zeros m = zeros n → gen m = gen n

/-- **[P] LUEGO EL DESCENSO NO PIERDE INFORMACIÓN.**  El conjunto de
    ceros determina el generador.

    **Ésta es la refutación de E148: la diferencia NO es de
    cardinal.** -/
theorem descent_loses_nothing (gen zeros : ℕ → ℝ)
    (h : ChainInjective₉ gen zeros) (m n : ℕ) (heq : zeros m = zeros n) :
    gen m = gen n := h m n heq

/-! ## §129.2  La distinción desciende -/

/-- **[P] EL CENTRO DESCIENDE, EXACTO.**  `ctr(ρ,1−ρ) = 1/2` para
    todo `ρ`, sin hipótesis ---§126. -/
theorem centre_descends (ρ : ℂ) : (ρ + (1 - ρ)) / 2 = 1 / 2 := by ring

/-- **[P] Y EL CRITERIO TAMBIÉN.**  `1 − ρ̄ = ρ ⟺ Re ρ = 1/2`: la
    simetría al eje real, abajo. -/
theorem criterion_descends (ρ : ℂ) :
    (1 : ℂ) - (starRingEnd ℂ) ρ = ρ ↔ ρ.re = 1 / 2 := by
  rw [Complex.ext_iff]
  simp only [Complex.sub_re, Complex.one_re, Complex.conj_re, Complex.sub_im,
    Complex.one_im, Complex.conj_im, sub_neg_eq_add, zero_add, and_true, one_div]
  constructor
  · intro h; linarith
  · intro h; linarith

/-- **[P] LOS DOS VALORES SE REALIZAN ABAJO.**  Hay puntos de `ℂ` con
    `Re = 1/2` y puntos con `Re ≠ 1/2`; luego el invariante toma los
    dos valores.

    **Ésta es la refutación de E147: la partición NO es vacía abajo,
    se realiza.** -/
theorem both_values_realised (γ : ℝ) :
    ((⟨1 / 2, γ⟩ : ℂ).re = 1 / 2) ∧ (¬ ((⟨3 / 4, γ⟩ : ℂ).re = 1 / 2)) := by
  refine ⟨by simp, ?_⟩
  simp; norm_num

/-! ## §129.3  Arriba y abajo, la misma estructura -/

/-- **[C] LAS TRES ÓRBITAS DE `V` SOBRE `ℤ₂₀*`.**  Cardinales `2, 4,
    2`: `{1,19}`, `{3,7,13,17}`, `{9,11}`.  La libre EXISTE, y se
    establece por `decide`. -/
def UpstairsOrbits (c₁ c₂ c₃ : ℕ) : Prop :=
  c₁ = 2 ∧ c₂ = 4 ∧ c₃ = 2

/-- **[P] Y ABAJO LOS MISMOS CARDINALES.**  `|órbita| ∈ {2,4}` para
    todo cero ---§94.  **Misma estructura, los dos niveles.** -/
theorem same_cardinals_both_levels (c₁ c₂ c₃ : ℕ)
    (h : UpstairsOrbits c₁ c₂ c₃) (n : ℕ) (hn : n ∣ 4) (hne : n ≠ 1) :
    (c₁ = 2 ∧ c₂ = 4) ∧ (n = 2 ∨ n = 4) := by
  refine ⟨⟨h.1, h.2.1⟩, ?_⟩
  have h4 : n ≤ 4 := Nat.le_of_dvd (by norm_num) hn
  interval_cases n <;> simp_all

/-! ## §129.4  Lo único que queda -/

/-- **[C] `E`, COMO EL VEREDICTO.**  Cuál de los dos valores toma el
    invariante sobre `Z_{χ₅}`. -/
def TheVerdict (Z : Set ℂ) : Prop := ∀ ρ ∈ Z, ρ.re = 1 / 2

/-- **[O] TODO DESCIENDE SALVO EL VEREDICTO.**

    | registro | arriba | abajo |
    |---|---|---|
    | la distinción | existe | **desciende** |
    | los dos valores | se realizan | se realizan |
    | la información | la misma | **la misma** |
    | el criterio | simetría al eje | `arg(e₂)=0` |
    | **cuál ocurre** | decidido | **es `E`** |

    **No hay nada más que caracterizar.**  Las cuatro frases que puse
    ---obstáculo, vacía, cardinal, sin caracterizar--- nombraban un
    hueco donde hay una estructura completa y un solo veredicto
    pendiente. -/
theorem everything_descends_but_the_verdict (ρ : ℂ) (γ : ℝ)
    (gen zeros : ℕ → ℝ) (h : ChainInjective₉ gen zeros) (m n : ℕ)
    (heq : zeros m = zeros n) :
    ((ρ + (1 - ρ)) / 2 = 1 / 2) ∧
    ((1 : ℂ) - (starRingEnd ℂ) ρ = ρ ↔ ρ.re = 1 / 2) ∧
    ((⟨1 / 2, γ⟩ : ℂ).re = 1 / 2) ∧
    (gen m = gen n) :=
  ⟨centre_descends ρ, criterion_descends ρ,
   (both_values_realised γ).1, descent_loses_nothing gen zeros h m n heq⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS PARA HERMES
  ══════════════════════════════════════════════════════════════════════════

   1. DEPENDENCIAS.  §64 `ChainInjective`, `family_is_determined`,
      `decided_terms_vanish`; §94; §104; §124; §126; §127;
