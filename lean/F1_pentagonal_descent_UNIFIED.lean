/-! ## §88.1  El acarreo de la base φ es la identidad -/

/-- **[P] LA REGLA DE ACARREO.**  En base `φ` con dígitos `0/1`, el
    acarreo es `011 → 100`, es decir `φ^{k−1} + φ^{k−2} = φ^k`.

    **Es `φ² = φ + 1` desplazado `k−2` veces**, no una analogía. -/
theorem phi_base_carry (k : ℕ) :
    (φ : ℝ) ^ (k + 1) + (φ : ℝ) ^ k = (φ : ℝ) ^ (k + 2) := by
  have h := phi_sq
  have : (φ : ℝ) ^ (k + 2) = (φ : ℝ) ^ k * φ ^ 2 := by ring
  rw [this, h]; ring

/-- **[P] Y EN `k = 0` ES LA IDENTIDAD MISMA.** -/
theorem carry_at_zero_is_the_identity :
    (φ : ℝ) ^ (1 : ℕ) + (φ : ℝ) ^ (0 : ℕ) = (φ : ℝ) ^ (2 : ℕ) ∧
    ((φ : ℝ) ^ 2 = φ + 1) := by
  refine ⟨?_, phi_sq⟩
  simpa using phi_base_carry 0

/-! ## §88.2  Monomialidad: la longitud es lo restrictivo -/

/-- Una expansión finita en base `φ` con dígitos en `{0,1}`: el
    conjunto de posiciones ocupadas. -/
def PhiExpansion (x : ℝ) (S : Finset ℤ) : Prop :=
  x = S.sum (fun k => (φ : ℝ) ^ k)

/-- **[O] SER MONOMIO ES QUE LA EXPANSIÓN TENGA UN SOLO DÍGITO.** -/
def IsMonomial (x : ℝ) : Prop := ∃ k : ℤ, x = (φ : ℝ) ^ k

/-- **[P] MONOMIO ⟹ EXPANSIÓN DE LONGITUD UNO.** -/
theorem monomial_has_one_digit (x : ℝ) (h : IsMonomial x) :
    ∃ S : Finset ℤ, S.card = 1 ∧ PhiExpansion x S := by
  obtain ⟨k, rfl⟩ := h
  exact ⟨{k}, Finset.card_singleton k, by simp [PhiExpansion]⟩

/-- **[P] Y RECÍPROCAMENTE.**  Longitud uno es exactamente ser
    monomio: las dos formulaciones de la conjetura coinciden. -/
theorem one_digit_is_monomial (x : ℝ) (S : Finset ℤ)
    (hc : S.card = 1) (he : PhiExpansion x S) : IsMonomial x := by
  obtain ⟨k, rfl⟩ := Finset.card_eq_one.mp hc
  exact ⟨k, by simpa [PhiExpansion] using he⟩

/-- **[P] LA EQUIVALENCIA, COMO ENUNCIADO.**  `(I')` de §87 y «un
    solo dígito en base φ» son el mismo enunciado. -/
theorem monomial_iff_one_digit (x : ℝ) :
    IsMonomial x ↔ ∃ S : Finset ℤ, S.card = 1 ∧ PhiExpansion x S :=
  ⟨monomial_has_one_digit x,
   fun ⟨S, hc, he⟩ => one_digit_is_monomial x S hc he⟩

/-- **[O] TENER EXPANSIÓN NO RESTRINGE  (E64).**  Predicado sin
    condición de longitud: es lo que Bergman/Zeckendorf da para toda
    real, y por tanto no distingue nada.

    Verificado: `π` tiene 50 dígitos, `|z_ρ|` con `β=0.75` tiene 45.
    Lo que distingue es `S.card = 1`. -/
def HasExpansion (x : ℝ) : Prop := ∃ S : Finset ℤ, PhiExpansion x S

theorem monomial_is_stronger (x : ℝ) (h : IsMonomial x) : HasExpansion x := by
  obtain ⟨S, _, he⟩ := monomial_has_one_digit x h
  exact ⟨S, he⟩

/-! ## §88.3  Los tres niveles con exponente entero -/

/-- **[P] TORRE, ARITMÉTICA, ANCLA: exponente entero.**  Los tres que
    la conjetura puede usar como precedente.  El espectro
    (`−λ = −log_φ 2`) y el parámetro (`2 − n/2`) NO: están
    cuantizados, no enterizados. -/
theorem three_levels_have_integer_exponent :
    IsMonomial ((φ : ℝ) ^ (3 : ℤ)) ∧
    IsMonomial ((φ : ℝ) ^ (1 : ℤ)) ∧
    IsMonomial ((φ : ℝ) ^ (-1 : ℤ)) ∧
    IsMonomial ((φ : ℝ) ^ (0 : ℤ)) ∧
    (2 * Real.log φ = Real.log ((φ : ℝ) ^ 2)) := by
  refine ⟨⟨3, rfl⟩, ⟨1, rfl⟩, ⟨-1, rfl⟩, ⟨0, rfl⟩, ?_⟩
  rw [Real.log_pow]; norm_num

/-! ## §88.4  El conductor como producto de discriminantes -/

/-- **[P] `20 = |disc ℚ(i)| · |disc ℚ(√5)|`.**  `|−4| · |5| = 20`.

    §85 item (10) lo escribe `4·5=20`, aritmética.  Escrito así se
    pierde que los factores son DISCRIMINANTES ---uno por cara---, y
    con §87 eso importa: el volteo es la cara `χ₄` y el `5` es su
    invariante. -/
theorem conductor_is_product_of_discriminants_l818 :
    (Int.natAbs (-4) * Int.natAbs 5 = 20) ∧
    (Nat.lcm 4 5 = 20) := by
  refine ⟨by decide, by decide⟩

/-! ## §88.5  El balance -/

/-- **[O] LOS CINCO ÍTEMS, Y DÓNDE QUEDAN.**

    | ítem | dónde |
    |---|---|
    | 1. desplazamiento `e₂: −1 → +1` | §87 `galois_pair_is_the_sign_flip` |
    | 2. el par de Galois como origen | §87 `both_readings_hold` |
    | 3. razón de colapso `848.489` | `[N]`, verificador §88 bloque E |
    | 4. la capa de numeración | §88 `monomial_iff_one_digit` |
    | 5. `20` como producto de discriminantes | §88 `conductor_is_product_of_discriminants` |

    Y la rectificación E96: **tres** niveles con exponente entero, no
    cuatro. -/
theorem the_balance_of_section_88 (x : ℝ) :
    (∀ k : ℕ, (φ : ℝ) ^ (k + 1) + (φ : ℝ) ^ k = (φ : ℝ) ^ (k + 2)) ∧
    (IsMonomial x ↔ ∃ S : Finset ℤ, S.card = 1 ∧ PhiExpansion x S) ∧
    (Int.natAbs (-4) * Int.natAbs 5 = 20) :=
  ⟨phi_base_carry, monomial_iff_one_digit x,
   conductor_is_product_of_discriminants_l818.1⟩

