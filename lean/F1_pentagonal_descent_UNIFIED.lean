/-! ## §115.1  El isomorfismo: la isometría preserva el módulo -/

/-- **[P] LOS DOS GENERADORES TIENEN MÓDULO UNO.**  `‖i‖ = 1` y
    `‖e^{2πi/3}‖ = 1` ---restatement de `V_preserves_norms`, aquí para
    componerlo con la igualdad y la unicidad. -/
theorem generators_have_unit_modulus :
    ‖Complex.I‖ = 1 ∧ ‖Complex.exp (2 * Real.pi * Complex.I / 3)‖ = 1 := by
  refine ⟨Complex.norm_I, ?_⟩
  rw [Complex.norm_exp]
  simp

/-- **[C] LA UNITARIEDAD.**  `V†V = 1` ---`V_unitary`, §V.14---, que
    con la preservación de normas da la ISOMETRÍA de los retículos.
    En la firma: es lo que hace del `½` un invariante común, no una
    coincidencia entre dos cálculos. -/
def IsIsometry (unitary : Prop) : Prop := unitary

/-- **[P] ISOMETRÍA CON MÓDULO COMÚN.**  Unitariedad más preservación
    de normas. -/
theorem isometry_with_common_modulus₅ (u : Prop) (hu : IsIsometry u) :
    u ∧ (‖Complex.I‖ = 1 ∧ ‖Complex.exp (2 * Real.pi * Complex.I / 3)‖ = 1) :=
  ⟨hu, generators_have_unit_modulus⟩

/-! ## §115.2  Los cuatro registros, compuestos -/

/-- Los registros en que el ápice está determinado. -/
inductive Register where
  | equality    : Register   -- las diez formas dan μ₃
  | uniqueness  : Register   -- mover el ápice pide otro grado
  | isomorphism : Register   -- V†V = 1 preserva el módulo
  | ingredient  : Register   -- uno: el grado dos
  | form        : Register   -- diez, distintas  ← la única que varía
deriving DecidableEq

instance : Fintype Register :=
  ⟨{Register.equality, Register.uniqueness, Register.isomorphism, Register.ingredient, Register.form}, by
    intro x; cases x <;> simp⟩

/-- **[P] SON CINCO REGISTROS.** -/
theorem five_registers : Fintype.card Register = 5 := by decide

/-- Un registro COINCIDE si su contenido es el mismo en las diez
    formas; sólo `form` varía. -/
def coincides : Register → Bool
  | Register.form => false
  | _             => true

/-- **[P] CUATRO COINCIDEN, UNA VARÍA.**  Ésta es la corrección de
    E131 en forma de conteo: mi frase oponía dos de los cuatro que
    coinciden. -/
theorem four_coincide :
    (Finset.univ.filter (fun r : Register => coincides r)).card = 4 ∧
    (Finset.univ.filter (fun r : Register => ¬ coincides r)).card = 1 := by
  refine ⟨by decide, by decide⟩

/-! ## §115.3  La unicidad, con el grado como único parámetro -/

/-- **[P] SÓLO EL GRADO DOS DA `1/2`.**  Con `deg = 3` la razón sería
    `1/3`; con `deg = 4`, `1/4`.  El ápice está atado al grado. -/
theorem only_degree_two_gives_half :
    ((2 : ℝ) / (2 ^ 2) = 1 / 2) ∧
    ((3 : ℝ) / (3 ^ 2) ≠ 1 / 2) ∧
    ((4 : ℝ) / (4 ^ 2) ≠ 1 / 2) := by
  refine ⟨by norm_num, by norm_num, by norm_num⟩

/-! ## §115.4  El balance -/

/-- **[O] EL ENUNCIADO, SIN OPOSICIÓN.**

    Las diez formas tienen el **mismo valor**, el **mismo
    ingrediente**, un **ápice único** y están ligadas por una
    **isometría** que preserva el módulo.  Lo que cambia es la FORMA
    en que cada una lo expresa.

    Eso es lo que hace informativo el cocono.  No la independencia
    ---que no hay---, sino que una identidad de grado dos alcance diez
    expresiones sin que el ápice se mueva.

    **Nada de esto prueba `E`.** -/
theorem the_balance_of_section_115 (u : Prop) (hu : IsIsometry u) :
    (Fintype.card Register = 5) ∧
    ((Finset.univ.filter (fun r : Register => coincides r)).card = 4) ∧
    (‖Complex.I‖ = 1) ∧
    ((2 : ℝ) / (2 ^ 2) = 1 / 2) ∧
    ((3 : ℝ) / (3 ^ 2) ≠ 1 / 2) :=
  ⟨five_registers, four_coincide.1, generators_have_unit_modulus.1,
   only_degree_two_gives_half.1, only_degree_two_gives_half.2.1⟩

