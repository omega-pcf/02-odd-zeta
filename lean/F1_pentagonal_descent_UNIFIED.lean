/-- **[P] EL PAR DE GALOIS ES EL VOLTEO DEL DE LA DECORACIÓN.** -/
theorem flip_invariant (a b : ℝ) :
    (sym₁ a b) ^ 2 * discr a b = (a ^ 2 - b ^ 2) ^ 2 := by
