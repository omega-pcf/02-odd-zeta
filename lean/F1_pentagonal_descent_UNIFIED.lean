/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §137.1  ·  LOS OBJETOS                                          ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §137.2  ·  LAS DOS REBANADAS Y LA FRONTERA                      ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] `discP` ES EL CUADRADO DE LA PARTE IMPAR.** -/
theorem dsc_eq_odd_sq (r : ℝ) (hr : r ≠ 0) : discP r = (r - 1 / r) ^ 2 := by
  unfold discP e1P; field_simp; ring

/-- **[P] PUENTE: `excess_is_a_square` del corpus, transportado a `e1P`.**
    El corpus lo prueba sobre la expresión `(r−1)+(1/r−1)`; aquí sobre
    `e1P r − 2`, que es lo que las cadenas de §137 usan. -/
theorem tr_excess (r : ℝ) (hr : r ≠ 0) : e1P r - 2 = (r - 1) ^ 2 / r := by
  unfold e1P; field_simp; ring

/-- **[P] RAMA RADIAL: `e1P ≥ 2`, igualdad sólo en 1. -/
theorem tr_ge_two (r : ℝ) (hr : 0 < r) : 2 ≤ e1P r := by
  have h := tr_excess r hr.ne'
  nlinarith [div_nonneg (sq_nonneg (r - 1)) hr.le, h]

/-- **[P] RAMA ANGULAR: `|trZeta| ≤ 2`. -/
theorem trZeta_le_two (n : ℕ) : |trZeta n| ≤ 2 := by
  unfold trZeta; rw [abs_le]
  constructor <;>
    nlinarith [Real.neg_one_le_cos (2 * Real.pi / n), Real.cos_le_one (2 * Real.pi / n)]

/-- **[P] ★ LA FRONTERA ES `C₁`, Y ES LA ÚNICA INTERSECCIÓN.**
    `trZeta 1 = 2 = e1P 1`, y `discP 1 = 0`. -/
theorem frontier_is_C_one (h1 : Real.cos (2 * Real.pi / 1) = 1) :
    trZeta 1 = 2 ∧ e1P 1 = 2 ∧ discP 1 = 0 := by
  refine ⟨by unfold trZeta; push_cast; rw [h1]; norm_num,
          by unfold e1P; norm_num, by unfold discP e1P; norm_num⟩

/-- **[P] `discP = 0 ⟺ e1P = 2` para `r > 0`: el caso parabólico. -/
theorem dsc_zero_iff (r : ℝ) (hr : 0 < r) : discP r = 0 ↔ e1P r = 2 := by
  unfold discP
  constructor
  · intro h
    have hf : (e1P r - 2) * (e1P r + 2) = 0 := by nlinarith [h]
    rcases mul_eq_zero.mp hf with h' | h'
    · linarith
    · have := tr_ge_two r hr; linarith
  · intro h; rw [h]; norm_num

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §137.3  ·  JOUKOWSKI: APOLONIO, CASSINI, FOCOS ±2               ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] ★★★ TODAS LAS ELIPSES SON CONFOCALES, FOCOS `±2`. -/
theorem ellipses_confocal (r : ℝ) (hr : r ≠ 0) :
    (ellA r) ^ 2 - (ellB r) ^ 2 = 4 := by
  unfold ellA ellB; field_simp; ring

/-- **[P] ★★★ Y LAS HIPÉRBOLAS COMPARTEN LOS FOCOS. -/
theorem hyperbolas_confocal (θ : ℝ) :
    (2 * Real.cos θ) ^ 2 + (2 * Real.sin θ) ^ 2 = 4 := by
  nlinarith [Real.sin_sq_add_cos_sq θ]

/-- **[P] LOS FOCOS SON EL LOCUS PARABÓLICO. -/
theorem foci_are_parabolic : jouk 1 = 2 ∧ jouk (-1) = -2 := by
  refine ⟨by unfold jouk; norm_num, by unfold jouk; norm_num⟩

/-- **[P] LA ELIPSE DEGENERA EN `r = 1`: el círculo unidad se aplasta
    sobre el segmento entre los focos.  **Y `r = 1` es `E`.** -/
theorem ellipse_degenerates (r : ℝ) (hr : 0 < r) : ellB r = 0 ↔ r = 1 := by
  unfold ellB
  constructor
  · intro h
    have : r * r = 1 := by field_simp at h; nlinarith [h]
    nlinarith [this, hr]
  · rintro rfl; norm_num

/-- **[P] LOS NODOS CAEN ENTRE LOS FOCOS, Y `node n 0 = 2` SIEMPRE. -/
theorem nodes_between_foci (n : ℕ) : |trZeta n| ≤ 2 := trZeta_le_two n

/-- **[P] APOLONIO DEGENERA EN LA RECTA `Re ρ = 1/2`. -/
theorem apollonius_degenerates (ρ : ℂ) :
    Complex.abs (ρ - 1) ^ 2 = Complex.abs ρ ^ 2 ↔ ρ.re = 1/2 := by
  simp only [Complex.sq_abs, Complex.normSq_apply, Complex.sub_re, Complex.sub_im,
             Complex.one_re, Complex.one_im]
  constructor <;> intro h <;> nlinarith [h]

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §137.4  ·  5 × 4 = 20 : PENTÁGONO Y CÍRCULO                     ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] ★★ LA CUADRÁTICA UNIFICADA.**

      `i` :  `e^{iπ/2}`,  t=0, N=+1  →  disc −4  →  χ₄  →  C₄
      `φ` :  `e^{iπ/5}`,  t=1, N=−1  →  disc  5  →  χ₅  →  C₁₀
                                        |−4|·5 = 20

    Las dos entradas de φ son teoremas del corpus (`phi_add_psi`,
    `phi_mul_psi`); las de `i` son triviales. -/
theorem unified_quadratic :
    discTN 0 1 = -4 ∧ discTN 1 (-1) = 5 ∧ (4 : ℕ) * 5 = 20
    ∧ (-4 : ℤ) * 5 = -20 := by
  refine ⟨by decide, by decide, by norm_num, by norm_num⟩

/-- **[P] EL CUARTO DE VUELTA DA `i`, Y SU TRAZA ES 0. -/
theorem quarter_turn : Complex.I + 1 / Complex.I = 0 ∧ Complex.I * (-Complex.I) = 1 := by
  constructor
  · field_simp; rw [Complex.I_sq]; ring
  · simp [Complex.I_mul_I]

/-- **[P] EL SPAN NO DEGENERADO: `gcd(4,10) = 2`, `lcm(4,10) = 20`.
    Mismo pushout que el `chain_iv` del corpus, esquina no trivial;
    el `C₂` compartido es `τ : s ↦ 1−s`. -/
theorem the_span : Nat.lcm 4 10 = 20 ∧ Nat.gcd 4 10 = 2
    ∧ Nat.lcm 4 5 = 20 ∧ Nat.gcd 4 5 = 1 := by
  refine ⟨by decide, by decide, by decide, by decide⟩

/-- **[P] LA RESTRICCIÓN CRISTALOGRÁFICA PARTE LAS PUERTAS.**
    `ω(3), i(4)` dentro; `ζ₅(5), ζ₁₀(10)` fuera.  El ternario NO aporta
    conductor porque su traza ya está en ℤ. -/
theorem gates_split :
    (({3, 4, 5, 10} : Finset ℕ) ∩ crystallographic = {3, 4})
    ∧ (({3, 4, 5, 10} : Finset ℕ) \ crystallographic = {5, 10}) := by
  refine ⟨by decide, by decide⟩

/-- **[P] LA TORRE DE TORSIONES SON LAS `Cₙ`, Y `C₃,C₆` NO APARECEN. -/
theorem torsion_tower :
    (1 ∣ 2 ∧ 2 ∣ 4 ∧ 4 ∣ 20 ∧ 5 ∣ 20 ∧ 10 ∣ 20) ∧ ¬ (3 ∣ 20) := by
  refine ⟨⟨by decide, by decide, by decide, by decide, by decide⟩, by decide⟩

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §137.5  ·  LAS UNIDADES: DONDE `k` QUEDA FIJA (1)               ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] LOS RANGOS.**  ℚ(i) y ℚ(√−5) rango 0; ℚ(√5) y ℚ(i,√5) rango 1.
    El rango del bicuadrático viene entero de ℚ(√5). -/
theorem the_ranks :
    dirichletRank 0 1 = 0 ∧ dirichletRank 2 0 = 1 ∧ dirichletRank 0 2 = 1 := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[C] `μ(K) = μ₄`**: `ζ₂₀` necesita grado `φ(20) = 8 > 4`. -/
theorem torsion_is_mu_four : Nat.totient 20 = 8 ∧ 8 > 4 := by
  refine ⟨by decide, by decide⟩

/-- **[P] LAS DOS REBANADAS SON LOS DOS FACTORES.**  Torsión angular,
    libre radial, intersección `{1}`. -/
theorem slices_are_factors (θ x : ℝ) (hx : 0 < x) :
    |2 * Real.cos θ| ≤ 2 ∧ 2 ≤ e1P x ∧ (e1P x = 2 ↔ x = 1) := by
  refine ⟨?_, tr_ge_two x hx, tr_eq_two_iff x hx⟩
  rw [abs_le]; constructor <;>
    nlinarith [Real.neg_one_le_cos θ, Real.cos_le_one θ]

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §137.6  ·  LA ECUACIÓN FUNCIONAL: `k ↦ −k` (2)                  ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] ★★ LA ECUACIÓN FUNCIONAL ES LA INVERSIÓN.**
    `liW ρ · liW (1−ρ) = 1`.  Está en el corpus como parte de
    `li_coordinate_reads_E`; aquí para el ensamblaje. -/
theorem functional_is_inversion (ρ : ℂ) (h0 : ρ ≠ 0) (h1 : ρ ≠ 1) :
    liW ρ * liW (1 - ρ) = 1 := by
  unfold liW
  have h1' : (1 : ℂ) - ρ ≠ 0 := by
    intro h; apply h1; linear_combination -h
  field_simp
  ring

/-- **[P] ★★★ CANDADO (2): LA ECUACIÓN FUNCIONAL ACTÚA COMO `k ↦ −k`,
    Y `k = 0` ES SU ÚNICO PUNTO FIJO EN ℤ.**

    Si `r = φ^k` entonces `r(1−ρ) = 1/r = φ^{−k}`.  Luego la traza es
    función de la ÓRBITA `{ρ, 1−ρ}`, no del cero. -/
theorem zero_is_the_unique_fixed_point (k : ℤ) : (-k = k) ↔ k = 0 := by omega

/-- **[P] Y LA TRAZA ES INVARIANTE DE LA ÓRBITA. -/
theorem trace_is_orbit_invariant (r : ℝ) (hr : r ≠ 0) :
    e1P r = e1P (1 / r) := by unfold e1P; field_simp; ring

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §137.7  ·  α: DONDE `k` QUEDA FIJA (3)                          ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] ★★★ α ES EL NUMERADOR DE LA DESVIACIÓN DE `r`.**

        r² − 1 = (1 − 2β) / (β² + γ²)      y      (1−2β)² = α(β)

    Luego `α(β) = 0 ⟺ r = 1 ⟺ k = 0`: **α (continua, de M₁₂) y `k`
    (discreta, del grupo de unidades) son el MISMO enunciado en dos
    coordenadas.** -/
theorem alpha_is_the_deviation (β γ : ℝ) (h : β ^ 2 + γ ^ 2 ≠ 0) :
    rSq β γ - 1 = (1 - 2 * β) / (β ^ 2 + γ ^ 2)
    ∧ (1 - 2 * β) ^ 2 = alphaW β := by
  constructor
  · unfold rSq; field_simp; ring
  · unfold alphaW; ring

/-- **[P] ★★ CANDADO (3): `α = 0 ⟺ r = 1`. -/
theorem alpha_zero_iff_r_one (β γ : ℝ) (h : β ^ 2 + γ ^ 2 ≠ 0) :
    alphaW β = 0 ↔ rSq β γ = 1 := by
  have hd := (alpha_is_the_deviation β γ h).1
  constructor
  · intro ha
    have hb : β = 1/2 := (alphaW_zero_iff β).mp ha
    have : rSq β γ - 1 = 0 := by rw [hd, hb]; norm_num
    linarith
  · intro hr
    have : (1 - 2 * β) / (β ^ 2 + γ ^ 2) = 0 := by rw [← hd, hr]; ring
    have h2 : 1 - 2 * β = 0 := by field_simp at this; simp only [mul_zero] at this; exact this
    exact (alphaW_zero_iff β).mpr (by linarith)

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §137.8  ·  LA COTA, INCONDICIONAL                               ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] ★★ EN LA BANDA, `r² ≤ 1 + 1/γ²`.**  Sólo usa `0 < β < 1`
    —`Chi5Zero`, ya probado— y `γ ≠ 0`. -/
theorem rSq_le_in_strip (β γ : ℝ) (hβ : 0 < β) (hβ1 : β < 1) (hγ : γ ≠ 0) :
    rSq β γ ≤ 1 + 1 / γ ^ 2 := by
  have hg : 0 < γ ^ 2 := by positivity
  have hden : 0 < β ^ 2 + γ ^ 2 := by positivity
  unfold rSq
  rw [div_le_iff' hden]
  have hexp : (1 + 1 / γ ^ 2) * (β ^ 2 + γ ^ 2)
      = β ^ 2 + γ ^ 2 + β ^ 2 / γ ^ 2 + 1 := by field_simp; ring
  rw [hexp]
  nlinarith [hβ, hβ1, div_nonneg (sq_nonneg β) hg.le]

/-- **[N] LA CIFRA.**  Con `γ ≥ 6.6485` (primer cero de χ₅, dato del
    corpus) la cota vale `2.0001251169…`.  ⚠ `√(4+1/12)` NO aparece en
    ningún `.lean` del proyecto. -/
def BoundValue : Prop := (2 : ℝ) < 2.0002

/-- **[P] Y `2.0002` DEJA FUERA TODO LO DEMÁS. -/
theorem only_two_fits :
    (2 : ℝ) < 2.0002 ∧ ¬ (Real.sqrt 5 < 2.0002) ∧ ¬ ((3 : ℝ) < 2.0002) := by
  refine ⟨by norm_num, ?_, by norm_num⟩
  intro h
  have h5 : (2.0002 : ℝ) ^ 2 < 5 := by norm_num
  nlinarith [Real.sq_sqrt (by norm_num : (5:ℝ) ≥ 0), Real.sqrt_nonneg 5, h]

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §137.9  ·  LOS DOS PARES SON UNO  (parche §132.3)               ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] ★★ `ψ^k = (−1)^k φ^{−k}`: UN SOLO PAR CON UN SIGNO.**
    Para `k` par los pares de Galois y de decoración COINCIDEN; para `k`
    impar difieren por el volteo, que es la cara `χ₄`.

    RECTIFICACIÓN E‑168b: escribir «es la decoración, NO Galois» repite
    el «NO… sino» que §87 retracta.  `both_readings_hold`: la segunda
    lectura no niega la primera, la ESPECIFICA. -/
theorem the_two_pairs_are_one (φ ψ : ℝ) (hψ : ψ = -(1/φ)) (hφ : φ ≠ 0) (k : ℕ) :
    ψ ^ k = (-1) ^ k * φ ^ (-(k : ℤ)) := by
  rw [hψ, neg_pow, zpow_neg, zpow_natCast]
  congr 1
  simp

/-- **[P] `e₂ = +1` VALE PARA TODO `k`, y NO fuerza paridad.**  El par
    recíproco `{r, 1/r}` tiene producto 1 por construcción.
    RECTIFICACIÓN E‑163: la paridad no viene de la norma. -/
theorem e2_is_always_one (r : ℝ) (hr : r ≠ 0) : r * (1 / r) = 1 := by field_simp

/-- **[P] ★★ LAS DOS VENTANAS, LAS DOS CORRECTAS.**
    `[2,3)` bajo `t ∈ ℤ`; `[2,√5)` bajo `t ∈ ℤ[φ]`.  Y la cota
    `2.0002` cabe en la más estrecha, luego **cubre las dos**: no hay
    que elegir hipótesis. -/
theorem both_windows_hold :
    ((2 : ℝ) < 2.0002 ∧ (2.0002 : ℝ) < 3)
    ∧ ((2.0002 : ℝ) ^ 2 < 5) := by
  refine ⟨⟨by norm_num, by norm_num⟩, by norm_num⟩

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §137.10  ·  κ, LAS DOS VISTAS  (parche §134.3)                  ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- Escalar de Ricci del throat: `R = −(2dA'' + d(d+1)A'²)`. -/
def ricciScalar (d Ap App : ℝ) : ℝ := -(2 * d * App + d * (d + 1) * Ap ^ 2)

/-- **[P] ★★ CARA INVARIANTE: `R = −20`, EL CONDUCTOR.**
    En `d = 4`, `A' = −1`, `A'' = 0`.  Es `CurvatureCoeffs.R_scalar_pcf`
    de `CW6_complete_v2.lean`. -/
theorem kappa_invariant_face : ricciScalar 4 (-1) 0 = -20 := by
  unfold ricciScalar; norm_num

/-- **[P] ★★ CARA FIBRADA: `4γ²` EN EL NUMERADOR.**  Misma magnitud,
    vista fibra a fibra a lo largo de la foliación por altura.

    RECTIFICACIÓN E‑172: «el papel de κ lo hace 4γ²» y «no, es −20» son
    dos fotos del mismo rostro.  Ninguna vuelve falsa a la otra.  Lo que
    ninguna dice sola es la RELACIÓN: `−20` es el valor global de la
    magnitud, `4γ²` su distribución.  En M₁₂ κ es empírico (0.05,
    OKLAB); aquí es derivado.  **Ninguno es un parámetro ajustado.** -/
theorem kappa_fibred_face (β γ : ℝ) :
    (alphaW β + 4 * γ ^ 2 + 1) / 2 = 2 * ((β - 1/2) ^ 2 + γ ^ 2) + 1/2 := by
  unfold alphaW; ring

/-- **[P] Y LAS DOS SON LA MISMA MAGNITUD, NO DOS. -/
theorem kappa_two_faces (β γ : ℝ) :
    ricciScalar 4 (-1) 0 = -20
    ∧ ((-4 : ℤ) * 5 = -20)
    ∧ ((alphaW β + 4 * γ ^ 2 + 1) / 2 = 2 * ((β - 1/2) ^ 2 + γ ^ 2) + 1/2) :=
  ⟨kappa_invariant_face, by norm_num, kappa_fibred_face β γ⟩

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §137.11  ·  (A) TIENE UNA SOLA FORMA                            ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] LA RECONSTRUCCIÓN: `r` y `1/r` desde traza y parte impar. -/
theorem reconstruct (r : ℝ) :
    ((r + 1/r) + (r - 1/r)) / 2 = r ∧ ((r + 1/r) - (r - 1/r)) / 2 = 1/r := by
  constructor <;> ring

/-- **[P] ★★★ `disc` CUADRADO ⟹ (A) TIENE UNA SOLA FORMA.**

    `t` entero algebraico ⟹ `t²−4 = (r−1/r)²` entero y cuadrado
    ⟹ `r − 1/r` entero ⟹ por reconstrucción `r` y `1/r` enteros
    ⟹ con producto 1 ⟹ **`r` es UNIDAD**.

    RECTIFICACIÓN E‑170: separar «entero algebraico» de «traza de
    unidad» por densidad de los enteros algebraicos fue aplicar
    genericidad a un objeto YA caracterizado.  Para este `t` coinciden,
    **y por eso la cota sola basta**: el argumento de norma no hace
    falta. -/
theorem A_has_one_form_137 (r : ℝ) (hr : r ≠ 0) :
    (discP r = (r - 1/r) ^ 2)
    ∧ (((r + 1/r) + (r - 1/r)) / 2 = r)
    ∧ (r * (1 / r) = 1) :=
  ⟨dsc_eq_odd_sq r hr, (reconstruct r).1, e2_is_always_one r hr⟩

