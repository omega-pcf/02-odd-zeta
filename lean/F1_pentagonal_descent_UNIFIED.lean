/-
FibrasPorNivel.lean — sprint 94, la aritmetica de prop:fibres-levels (i).
Estado P* (sin compilar: en el entorno de Claude no hay Lean). Compilar con: lake env lean FibrasPorNivel.lean

Un primo escindido de reloj n cumple n ∣ p - 1; uno inerte cumple n ∣ 2 (p + 1) y ¬ n ∣ p + 1
(porque φ^(p+1) = N(φ) = -1). De ahi sale que fibra de G puede aparecer en cada tipo de nivel.
-/

namespace FibrasPorNivel

/-- Escindido en un nivel multiplo de 4: `p ≡ 1 (mod 4)`, el nucleo de `G`. -/
theorem split_level_four (p n : ℕ) (hp : 1 ≤ p) (h4 : 4 ∣ n) (hn : n ∣ p - 1) : p % 4 = 1 := by
  obtain ⟨k, hk⟩ := Dvd.dvd.trans h4 hn
  omega

/-- Escindido en un nivel multiplo de 20: `p ≡ 1 (mod 20)`. -/
theorem split_level_twenty (p n : ℕ) (hp : 1 ≤ p) (h20 : 20 ∣ n) (hn : n ∣ p - 1) : p % 20 = 1 := by
  obtain ⟨k, hk⟩ := Dvd.dvd.trans h20 hn
  omega

/-- Inerte: el nivel es multiplo de 4. -/
theorem inert_level_four (p n : ℕ) (hodd : p % 2 = 1) (h : n ∣ 2 * (p + 1)) (h' : ¬ n ∣ p + 1) :
    4 ∣ n := by
  obtain ⟨c, hc⟩ := h
  have hc2 : ¬ 2 ∣ c := by
    rintro ⟨d, rfl⟩
    apply h'
    refine ⟨d, ?_⟩
    have : 2 * (p + 1) = 2 * (n * d) := by rw [hc]; ring
    exact Nat.eq_of_mul_eq_mul_left (by norm_num) this
  have h2 : Nat.Coprime 2 c := (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mpr hc2
  have hcop : Nat.Coprime 4 c := by
    have h := h2.pow_left 2
    norm_num at h
    exact h
  have h4 : 4 ∣ n * c := by
    rw [← hc]
    obtain ⟨k, hk⟩ : 2 ∣ p + 1 := by omega
    exact ⟨k, by omega⟩
  exact hcop.dvd_of_dvd_mul_right h4

/-- Inerte con `p ≡ 1 (mod 4)` (clases 13 y 17): el nivel es `4 (mod 8)`. -/
theorem inert_one_mod_four (p n : ℕ) (hp : p % 4 = 1) (h : n ∣ 2 * (p + 1)) : ¬ 8 ∣ n := by
  rintro ⟨k, rfl⟩
  obtain ⟨c, hc⟩ := h
  have : 2 * (p + 1) = 8 * (k * c) := by rw [hc]; ring
  omega

/-- Ningun inerte en un nivel multiplo de 5: seria `p ≡ 4 (mod 5)`, que es escindido. -/
theorem inert_not_at_five (p n : ℕ) (h5 : 5 ∣ n) (h : n ∣ 2 * (p + 1)) : p % 5 = 4 := by
  obtain ⟨k, hk⟩ := Dvd.dvd.trans h5 h
  omega

