/-- **`ζ(σ) · L(σ, χ) → 1` as `σ → +∞`:** the normalisation of the Dedekind zeta function. -/
theorem zetaK_tendsto_one {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N) :
    Tendsto (fun x : ℝ => riemannZeta x * L ↗χ x) atTop (𝓝 1) := by
  have hz : Tendsto (fun x : ℝ => LSeries 1 x) atTop (𝓝 ((1 : ℕ → ℂ) 1)) :=
    LSeries.tendsto_atTop (by
      rw [LSeries.abscissaOfAbsConv_one]; exact EReal.coe_lt_top 1)
  have hL : Tendsto (fun x : ℝ => L ↗χ x) atTop (𝓝 (χ (1 : ℕ))) :=
    LSeries.tendsto_atTop (by
      rw [DirichletCharacter.abscissaOfAbsConv_eq_one (NeZero.ne N) χ]; exact EReal.coe_lt_top 1)
  have hz' : Tendsto (fun x : ℝ => riemannZeta x) atTop (𝓝 1) := by
    refine (hz.congr' ?_).trans (by simp)
    filter_upwards [eventually_gt_atTop (1 : ℝ)] with x hx
    exact LSeries_one_eq_riemannZeta (by simpa using hx)
