theorem lucas_sq_sub_five_fib_sq (k : ℕ) :
    (lucasN k : ℤ) ^ 2 - 5 * (Nat.fib k : ℤ) ^ 2 = 4 * (-1) ^ k := by
  -- (Ola B3x, 2026-09-08): dosStepInduction roto aquí; Binet lo cierra sin
  -- split de paridad (binet_sum/binet_diff ya probados arriba).
  have hprod : (φ : ℝ) * (1 - φ) = -1 := by
    have h1 : (φ : ℝ) * (1 - φ) = -(φ * (φ - 1)) := by ring
    rw [h1, phi_mul_phi_sub_one]
  have hexpand : ∀ x y : ℝ, (x + y) ^ 2 - (x - y) ^ 2 = 4 * x * y := by
    intro x y; ring
  have hL := binet_sum k
  have hF := binet_diff k
  have hkey : (lucasN k : ℝ) ^ 2 - ((Nat.fib k : ℝ) * Real.sqrt 5) ^ 2
      = 4 * ((φ : ℝ) * (1 - φ)) ^ k := by
    rw [← hL, ← hF, hexpand, mul_pow]
    ring
  rw [hprod, mul_pow, Real.sq_sqrt (show (0:ℝ) ≤ 5 by norm_num)] at hkey
  have hr : (((lucasN k : ℤ) ^ 2 - 5 * (Nat.fib k : ℤ) ^ 2 : ℤ) : ℝ)
      = ((4 * (-1) ^ k : ℤ) : ℝ) := by
    push_cast
    linear_combination hkey
  exact_mod_cast hr

