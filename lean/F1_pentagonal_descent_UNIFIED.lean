-- ╔═══════════════════════════════════════════════════════════════════════╗
-- ║  §1  LAS DOS REDUCCIONES DEL CONDUCTOR                                ║
-- ╚═══════════════════════════════════════════════════════════════════════╝

/-- Reducción mod 4.  Morfismo de anillos, no una función ad hoc. -/
def red4 : ZMod 20 →+* ZMod 4 := ZMod.castHom (by decide) (ZMod 4)

/-- Reducción mod 5.  Morfismo de anillos. -/
def red5 : ZMod 20 →+* ZMod 5 := ZMod.castHom (by decide) (ZMod 5)

theorem red4_natCast (n : ℕ) : red4 ((n : ℕ) : ZMod 20) = ((n : ℕ) : ZMod 4) :=
  map_natCast red4 n

theorem red5_natCast (n : ℕ) : red5 ((n : ℕ) : ZMod 20) = ((n : ℕ) : ZMod 5) :=
  map_natCast red5 n

/-- **El conductor se separa.**  La pareja de reducciones es inyectiva:
    el teorema chino del resto en la forma que hace falta aquí, por
    decisión finita sobre las 400 parejas. -/
theorem conductor_splits (a b : ZMod 20)
    (h4 : red4 a = red4 b) (h5 : red5 a = red5 b) : a = b := by
  revert h5 h4; revert b a; decide


-- ╔═══════════════════════════════════════════════════════════════════════╗
-- ║  §2  ATRIBUCIÓN: QUÉ FACTOR GOBIERNA QUÉ CARÁCTER                     ║
-- ╚═══════════════════════════════════════════════════════════════════════╝

/-! ### §2.1  Las fibras de G son fibras de reducción, no listas -/

/-- {1,9,13,17} es exactamente la fibra de `red4` sobre 1: la condición que
    define χ₄ es una congruencia mod 4. -/
theorem Z20star_pi1_fiber_is_mod4 (a : ZMod 20) (ha : a ∈ ZtwentyStar) :
    red4 a = 1 ↔ (a = 1 ∨ a = 9 ∨ a = 13 ∨ a = 17) := by
  revert ha; revert a; decide   -- ⚠ NOTA 3

/-- {1,9,11,19} es exactamente el conjunto de elementos cuya reducción mod 5
    es un resto cuadrático (1 ó 4). -/
theorem Z20star_pi2_fiber_is_mod5 (a : ZMod 20) (ha : a ∈ ZtwentyStar) :
    (red5 a = 1 ∨ red5 a = 4) ↔ (a = 1 ∨ a = 9 ∨ a = 11 ∨ a = 19) := by
  revert ha; revert a; decide

/-! ### §2.2  Los dos caracteres, enunciados como congruencias -/

/-- **χ₄ ES la reducción mod 4.** -/
theorem chi4_is_the_mod4_component (a : ZMod 20) (ha : a ∈ ZtwentyStar) :
    (G a).1 = 0 ↔ red4 a = 1 :=
  (G_pi1_is_chi4 a ha).trans (Z20star_pi1_fiber_is_mod4 a ha).symm

/-- **χ₅ ES la reducción mod 5**, leída como carácter cuadrático. -/
theorem chi5_is_the_mod5_component (a : ZMod 20) (ha : a ∈ ZtwentyStar) :
    (G a).2 = 0 ↔ (red5 a = 1 ∨ red5 a = 4) :=
  (G_pi2_is_chi5 a ha).trans (Z20star_pi2_fiber_is_mod5 a ha).symm

/-! ### §2.3  «Gobierna» en sentido fuerte: determinación Y no-determinación -/

theorem mod4_determines_chi4 (a b : ZMod 20)
    (ha : a ∈ ZtwentyStar) (hb : b ∈ ZtwentyStar) (h : red4 a = red4 b) :
    (G a).1 = (G b).1 := by
  revert h hb ha; revert b a; decide

theorem mod5_determines_chi5 (a b : ZMod 20)
    (ha : a ∈ ZtwentyStar) (hb : b ∈ ZtwentyStar) (h : red5 a = red5 b) :
    (G a).2 = (G b).2 := by
  revert h hb ha; revert b a; decide

/-- **El factor 4 NO determina χ₅.**  Testigo: 1 y 13, ambos ≡ 1 (mod 4),
    con (G 1).2 = 0 ≠ 1 = (G 13).2.

    Sin este enunciado «el 4 gobierna el lado binario» sería vacuo:
    podría gobernarlo todo. -/
theorem mod4_does_not_determine_chi5 :
    ∃ a b : ZMod 20, a ∈ ZtwentyStar ∧ b ∈ ZtwentyStar ∧
      red4 a = red4 b ∧ (G a).2 ≠ (G b).2 :=
  ⟨1, 13, by decide, by decide, by decide, by decide⟩

/-- **El factor 5 NO determina χ₄.**  Testigo: 1 y 11, ambos ≡ 1 (mod 5). -/
theorem mod5_does_not_determine_chi4 :
    ∃ a b : ZMod 20, a ∈ ZtwentyStar ∧ b ∈ ZtwentyStar ∧
      red5 a = red5 b ∧ (G a).1 ≠ (G b).1 :=
  ⟨1, 11, by decide, by decide, by decide, by decide⟩

/-- **TEOREMA DE ATRIBUCIÓN.**  La factorización 20 = 4·5 del conductor
    coincide exactamente con la factorización G = (χ₄, χ₅), y la coincidencia
    es estricta en ambos sentidos. -/
theorem conductor_attribution :
    (∀ a b : ZMod 20, a ∈ ZtwentyStar → b ∈ ZtwentyStar →
       red4 a = red4 b → (G a).1 = (G b).1) ∧
    (∀ a b : ZMod 20, a ∈ ZtwentyStar → b ∈ ZtwentyStar →
       red5 a = red5 b → (G a).2 = (G b).2) ∧
    (∃ a b : ZMod 20, a ∈ ZtwentyStar ∧ b ∈ ZtwentyStar ∧
       red4 a = red4 b ∧ (G a).2 ≠ (G b).2) ∧
    (∃ a b : ZMod 20, a ∈ ZtwentyStar ∧ b ∈ ZtwentyStar ∧
       red5 a = red5 b ∧ (G a).1 ≠ (G b).1) ∧
    (∀ a b : ZMod 20, red4 a = red4 b → red5 a = red5 b → a = b) :=
  ⟨mod4_determines_chi4, mod5_determines_chi5,
   mod4_does_not_determine_chi5, mod5_does_not_determine_chi4,
   conductor_splits⟩


-- ╔═══════════════════════════════════════════════════════════════════════╗
-- ║  §3  F₁ ↔ GALOIS:  ψ_p ES G-EQUIVARIANTE                              ║
-- ╚═══════════════════════════════════════════════════════════════════════╝

/-- El Frobenius descendido preserva las unidades del conductor. -/
theorem psi_mod_preserves_Z20star (p : ℕ) (hp : p.Prime) (hp5 : 5 < p)
    (a : ZMod 20) (ha : a ∈ ZtwentyStar) :
    psi_mod 20 p a ∈ ZtwentyStar := by
  unfold psi_mod
  exact mul_preserved_Z20 _ _ (primes_land_in_ZtwentyStar p hp hp5) ha

/-- **ψ_p ES G-EQUIVARIANTE.**  El levantamiento de Frobenius de Borger,
    descendido al conductor, actúa sobre el funtor de Galois como
    TRASLACIÓN por G(p):

        G(ψ_p(a)) = G(p) + G(a).

    La maquinaria F₁ no perturba la estructura de Galois: se factoriza a
    través de ella. -/
theorem G_psi_equivariant (p : ℕ) (hp : p.Prime) (hp5 : 5 < p)
    (a : ZMod 20) (ha : a ∈ ZtwentyStar) :
    G (psi_mod 20 p a) = G ((p : ℕ) : ZMod 20) + G a := by
  unfold psi_mod
  exact G_hom _ _ (primes_land_in_ZtwentyStar p hp hp5) ha

/-- **EL CUADRADO CONMUTATIVO COMPLETO.**

        ℤ  ──── ψ_p ────▶  ℤ
        │                   │
      mod 20              mod 20
        ▼                   ▼
      Z₂₀* ─── ·p ──────▶ Z₂₀*
        │                   │
        G                   G
        ▼                   ▼
      Z₂×Z₂ ── +G(p) ───▶ Z₂×Z₂ -/
theorem F1_descends_to_Galois (p : ℕ) (hp : p.Prime) (hp5 : 5 < p) (n : ℤ)
    (ha : ((n : ℤ) : ZMod 20) ∈ ZtwentyStar) :
    G (((X_PCF.psi p n : ℤ)) : ZMod 20)
      = G ((p : ℕ) : ZMod 20) + G ((n : ℤ) : ZMod 20) := by
  rw [psi_descent_at_conductor]
  exact G_psi_equivariant p hp hp5 _ ha

/-- Corolario: un primo p ≡ 1 (mod 20) actúa trivialmente sobre G. -/
theorem G_psi_trivial_at_split_primes (p : ℕ) (hp : p.Prime) (hp5 : 5 < p)
    (hsplit : ((p : ℕ) : ZMod 20) = 1) (a : ZMod 20) (ha : a ∈ ZtwentyStar) :
    G (psi_mod 20 p a) = G a := by
  rw [G_psi_equivariant p hp hp5 a ha, hsplit, G_identity]
  simp


-- ╔═══════════════════════════════════════════════════════════════════════╗
-- ║  §4  ESPECTRO MULTIPLICATIVO: EL 4 ES EL PERIODO DEL REGISTRO BINARIO ║
-- ╚═══════════════════════════════════════════════════════════════════════╝

/-! No es i⁴ = 1.  El 4 gobierna el lado multiplicativo porque 2^m mod 20
    tiene periodo 4, vía la idempotencia de 16. -/

/-- Para m ≥ 2, la potencia 2^m es absorbida por 16 (base: 4·16 = 64 = 4). -/
theorem two_pow_absorbs_sixteen (m : ℕ) :
    (2 : ZMod 20) ^ (m + 2) * 16 = (2 : ZMod 20) ^ (m + 2) := by
  induction m with
  | zero => decide
  | succ k ih =>
      have hstep : (2 : ZMod 20) ^ (k + 1 + 2) = 2 * (2 : ZMod 20) ^ (k + 2) := by
        rw [show k + 1 + 2 = (k + 2) + 1 from by omega, pow_succ]; ring
      rw [hstep, mul_assoc, ih]

/-- **EL 4 ES EL PERIODO DEL REGISTRO BINARIO.**
    Para todo m ≥ 2:  2^(m+4) ≡ 2^m (mod 20). -/
theorem binary_register_has_period_four (m : ℕ) :
    (2 : ZMod 20) ^ (m + 2 + 4) = (2 : ZMod 20) ^ (m + 2) := by
  have h4 : (2 : ZMod 20) ^ 4 = 16 := by decide
  rw [pow_add, h4]
  exact two_pow_absorbs_sixteen m

/-- Forma iterada: la clase depende sólo del exponente mod 4. -/
theorem binary_class_depends_on_exponent_mod_four (m k : ℕ) :
    (2 : ZMod 20) ^ (m + 2 + 4 * k) = (2 : ZMod 20) ^ (m + 2) := by
  induction k with
  | zero => simp
  | succ j ih =>
      have hre  : m + 2 + 4 * (j + 1) = (m + 4 * j) + 2 + 4 := by omega
      have hre' : m + 2 + 4 * j = (m + 4 * j) + 2 := by omega
      rw [hre, binary_register_has_period_four, ← hre', ih]

/-- El registro binario es CIEGO a la componente pentagonal. -/
theorem binary_period_blind_to_pentagon :
    ∃ a b : ZMod 20, a ∈ ZtwentyStar ∧ b ∈ ZtwentyStar ∧
      red4 a = red4 b ∧ (G a).2 ≠ (G b).2 :=
  mod4_does_not_determine_chi5


-- ╔═══════════════════════════════════════════════════════════════════════╗
-- ║  §5  ESPECTRO ADITIVO: EL 5 GOBIERNA F_p VÍA χ₅                       ║
-- ╚═══════════════════════════════════════════════════════════════════════╝

/-! ### §5.1  El cambio de variable β = 2α − 1 -/

/-- 2 ≠ 0 en Z_p para p primo impar. -/
theorem two_ne_zero_zmod {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) :
    (2 : ZMod p) ≠ 0 := by
  have : Fact p.Prime := ⟨hp⟩
  change ((2 : ℕ) : ZMod p) ≠ 0
  rw [Ne, ZMod.natCast_eq_zero_iff]
  intro hdvd
  rcases (show Nat.Prime 2 from by norm_num).eq_one_or_self_of_dvd p hdvd with h1 | h2
  · have : 2 ≤ p := hp.two_le; omega
  · exact hp2 h2

/-- **X² − X − 1 TIENE RAÍZ MOD p  ⟺  5 ES CUADRADO MOD p.**

    Ida:    α² = α+1  ⟹  (2α−1)² = 4α²−4α+1 = 4(α+1)−4α+1 = 5.
    Vuelta: β² = 5  ⟹  α := (1+β)/2 cumple α² = (6+2β)/4 = (3+β)/2 = α+1.

    La ida ya estaba en el corpus, pero como `have` dentro del cuerpo de
    `fib_split_case`, no como declaración citable.  La vuelta es nueva y es
    la que da el sentido útil. -/
theorem root_x2mx1_iff_five_sq {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) :
    (∃ α : ZMod p, α ^ 2 = α + 1) ↔ (∃ β : ZMod p, β ^ 2 = 5) := by
  have : Fact p.Prime := ⟨hp⟩
  constructor
  · rintro ⟨α, hα⟩
    exact ⟨2 * α - 1, by linear_combination 4 * hα⟩
  · rintro ⟨β, hβ⟩
    have h2 : (2 : ZMod p) ≠ 0 := two_ne_zero_zmod hp hp2
    refine ⟨(1 + β) / 2, ?_⟩
    field_simp
    linear_combination hβ   -- ⚠ NOTA 4

/-! ### §5.2  Reciprocidad cuadrática -/

/-- Los cuadrados no nulos de Z₅ son exactamente {1, 4}. -/
theorem isSquare_zmod5_iff (x : ZMod 5) (hx : x ≠ 0) :
    IsSquare x ↔ (x = 1 ∨ x = 4) := by
  revert hx; revert x; decide

/-- **5 ES CUADRADO MOD p  ⟺  p ≡ ±1 (mod 5).**
    Como 5 ≡ 1 (mod 4), el símbolo es simétrico: (5/p) = (p/5). -/
theorem five_sq_iff_mod5 {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hp5 : p ≠ 5) :
    (∃ β : ZMod p, β ^ 2 = 5) ↔
      (((p : ℕ) : ZMod 5) = 1 ∨ ((p : ℕ) : ZMod 5) = 4) := by
  have : Fact p.Prime := ⟨hp⟩
  have : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  have hrec : IsSquare ((p : ℕ) : ZMod 5) ↔ IsSquare ((5 : ℕ) : ZMod p) :=
    ZMod.exists_sq_eq_prime_iff_of_mod_four_eq_one (by norm_num) hp2   -- ⚠ NOTA 1
  have hsq : (∃ β : ZMod p, β ^ 2 = 5) ↔ IsSquare ((5 : ℕ) : ZMod p) := by
    constructor
    · rintro ⟨β, hβ⟩; exact ⟨β, by push_cast; rw [← hβ]; ring⟩
    · rintro ⟨r, hr⟩; exact ⟨r, by push_cast at hr; rw [hr]; ring⟩
  have hne : ((p : ℕ) : ZMod 5) ≠ 0 := by
    rw [Ne, ZMod.natCast_eq_zero_iff]
    intro hdvd
    exact hp5 (((Nat.prime_dvd_prime_iff_eq (by norm_num) hp).mp hdvd).symm)
  rw [hsq, ← hrec]
  exact isSquare_zmod5_iff _ hne

/-! ### §5.3  El valor de Fibonacci, fijado por la clase mod 5 -/

/-- **VALOR SPLIT.**  Si p ≡ 1, 4 (mod 5) entonces F_p ≡ +1 (mod p). -/
theorem fib_eq_one_of_mod5_split {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hp5 : p ≠ 5)
    (h : ((p : ℕ) : ZMod 5) = 1 ∨ ((p : ℕ) : ZMod 5) = 4) :
    (Nat.fib p : ZMod p) = 1 := by
  have : Fact p.Prime := ⟨hp⟩
  obtain ⟨α, hα⟩ :=
    (root_x2mx1_iff_five_sq hp hp2).mpr ((five_sq_iff_mod5 hp hp2 hp5).mpr h)
  exact fib_split_case hp hp2 hp5 α hα

/-- **VALOR INERT.**  Si p ≡ 2, 3 (mod 5) entonces F_p ≡ −1 (mod p). -/
theorem fib_eq_neg_one_of_mod5_inert {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hp5 : p ≠ 5)
    (h : ((p : ℕ) : ZMod 5) = 2 ∨ ((p : ℕ) : ZMod 5) = 3) :
    (Nat.fib p : ZMod p) = -1 := by
  have : Fact p.Prime := ⟨hp⟩
  have hnroot : ¬ ∃ α : ZMod p, α ^ 2 = α + 1 := by
    intro hex
    have h14 := (five_sq_iff_mod5 hp hp2 hp5).mp ((root_x2mx1_iff_five_sq hp hp2).mp hex)
    rcases h with h | h <;> rcases h14 with h' | h' <;>
      rw [h] at h' <;> exact absurd h' (by decide)
  have hdeg : (X ^ 2 - X - 1 : (ZMod p)[X]).natDegree = 2 := by compute_degree!
  have hirr : Irreducible (X ^ 2 - X - 1 : (ZMod p)[X]) := by
    by_contra hc
    rw [not_irreducible_iff_exists_root_of_degree_two _ hdeg] at hc
    obtain ⟨x, hx⟩ := hc
    simp only [IsRoot.def, eval_sub, eval_pow, eval_X, eval_one] at hx
    exact hnroot ⟨x, by linear_combination hx⟩
  rw [fib_inert_case hp hp2 hp5 hirr, ZMod.natCast_self]; ring

/-- **LA DICOTOMÍA, CON LA CLASE ADJUNTA.**  Refuerza
    `fibonacci_splitting_general`: allí la disyunción F_p ≡ ±1 era libre;
    aquí cada rama queda seleccionada por p mod 5. -/
theorem fib_value_from_mod5 {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hp5 : p ≠ 5) :
    ((((p : ℕ) : ZMod 5) = 1 ∨ ((p : ℕ) : ZMod 5) = 4) → (Nat.fib p : ZMod p) = 1) ∧
    ((((p : ℕ) : ZMod 5) = 2 ∨ ((p : ℕ) : ZMod 5) = 3) → (Nat.fib p : ZMod p) = -1) :=
  ⟨fib_eq_one_of_mod5_split hp hp2 hp5, fib_eq_neg_one_of_mod5_inert hp hp2 hp5⟩

/-! ### §5.4  El remate: χ₅ gobierna el espectro aditivo -/

/-- **EL ESPECTRO ADITIVO ESTÁ GOBERNADO POR χ₅.**

    Para todo primo p > 5:

        χ₅(p mod 20) = 0  ⟹  F_p ≡ +1 (mod p)
        χ₅(p mod 20) = 1  ⟹  F_p ≡ −1 (mod p)

    Éste es el enunciado que faltaba: la clasificación del espectro aditivo
    de Fibonacci la hace un carácter de periodo 5, y ese carácter es
    exactamente la segunda componente de G — que por §2.2 es la reducción
    mod 5 del conductor.

    Cadena completa, cada eslabón un teorema de este archivo:

        χ₅(p) = 0
          ⟺ red5(p mod 20) ∈ {1,4}       [chi5_is_the_mod5_component]
          ⟺ p ≡ ±1 (mod 5)                [red5_natCast]
          ⟺ 5 es cuadrado mod p           [five_sq_iff_mod5]
          ⟺ X²−X−1 tiene raíz mod p       [root_x2mx1_iff_five_sq]
          ⟹ F_p ≡ +1 (mod p)              [fib_split_case] -/
theorem additive_spectrum_governed_by_chi5 (p : ℕ) (hp : p.Prime) (hp5 : 5 < p) :
    (chi5 ((p : ℕ) : ZMod 20) = 0 → (Nat.fib p : ZMod p) = 1) ∧
    (chi5 ((p : ℕ) : ZMod 20) = 1 → (Nat.fib p : ZMod p) = -1) := by
  have hp2  : p ≠ 2 := by omega
  have hp5' : p ≠ 5 := by omega
  have hmem : ((p : ℕ) : ZMod 20) ∈ ZtwentyStar :=
    primes_land_in_ZtwentyStar p hp hp5
  have hchar := chi5_is_the_mod5_component ((p : ℕ) : ZMod 20) hmem
  rw [red5_natCast] at hchar
  have hne : ((p : ℕ) : ZMod 5) ≠ 0 := by
    rw [Ne, ZMod.natCast_eq_zero_iff]
    intro hdvd
    exact hp5' (((Nat.prime_dvd_prime_iff_eq (by norm_num) hp).mp hdvd).symm)
  constructor
  · intro h0
    exact fib_eq_one_of_mod5_split hp hp2 hp5' (hchar.mp h0)
  · intro h1
    have hnot0 : (G ((p : ℕ) : ZMod 20)).2 ≠ 0 := by
      unfold chi5 at h1; rw [h1]; decide
    have hnot : ¬ (((p : ℕ) : ZMod 5) = 1 ∨ ((p : ℕ) : ZMod 5) = 4) :=
      fun hh => hnot0 (hchar.mpr hh)
    have h23 : ((p : ℕ) : ZMod 5) = 2 ∨ ((p : ℕ) : ZMod 5) = 3 := by
      revert hne hnot
      generalize ((p : ℕ) : ZMod 5) = x
      revert x
      decide   -- ⚠ NOTA 5
    exact fib_eq_neg_one_of_mod5_inert hp hp2 hp5' h23

/-- **LOS DOS ESPECTROS, SEPARADOS POR LOS DOS FACTORES DEL CONDUCTOR.**
    El 4 gobierna el registro binario y es ciego al pentágono; el 5 gobierna
    el registro aditivo vía χ₅.  Ninguno invade al otro. -/
theorem the_two_spectra_are_separated :
    (∀ m : ℕ, (2 : ZMod 20) ^ (m + 2 + 4) = (2 : ZMod 20) ^ (m + 2)) ∧
    (∀ p : ℕ, p.Prime → 5 < p →
       (chi5 ((p : ℕ) : ZMod 20) = 0 → (Nat.fib p : ZMod p) = 1) ∧
       (chi5 ((p : ℕ) : ZMod 20) = 1 → (Nat.fib p : ZMod p) = -1)) ∧
    (∃ a b : ZMod 20, a ∈ ZtwentyStar ∧ b ∈ ZtwentyStar ∧
       red4 a = red4 b ∧ (G a).2 ≠ (G b).2) ∧
    (∃ a b : ZMod 20, a ∈ ZtwentyStar ∧ b ∈ ZtwentyStar ∧
       red5 a = red5 b ∧ (G a).1 ≠ (G b).1) :=
  ⟨binary_register_has_period_four,
   fun p hp hp5 => additive_spectrum_governed_by_chi5 p hp hp5,
   mod4_does_not_determine_chi5, mod5_does_not_determine_chi4⟩


-- ╔═══════════════════════════════════════════════════════════════════════╗
-- ║  §6  EL ANCLA NO ES UN PUNTO DEL RETÍCULO F₁                          ║
-- ╚═══════════════════════════════════════════════════════════════════════╝

/-- φ < 2, pues √5 < 3. -/
theorem φ_lt_two : φ < 2 := by
  unfold φ
  have h : Real.sqrt 5 < 3 := by
    have h9 : (3 : ℝ) = Real.sqrt 9 := by
      rw [show (9 : ℝ) = 3 ^ 2 from by norm_num,
          Real.sqrt_sq (by norm_num : (0:ℝ) ≤ 3)]
    rw [h9]
    exact Real.sqrt_lt_sqrt (by norm_num) (by norm_num)
  linarith

/-- **EL 2 NO ESTÁ EN EL RETÍCULO DORADO.**  Para ningún entero n vale φ^n = 2:
    φ¹ = φ < 2 y φ² = φ+1 > 2, y n ↦ φ^n es estrictamente monótona.

    Consecuencia estructural: `realise : ℤ → ℝ`, la realización del objeto F₁
    X_PCF, NO alcanza el 2.  Por tanto el puente de Mersenne φ^λ = 2 no puede
    obtenerse por descenso F₁ — λ es exterior al retículo.  Eso es exactamente
    lo que hace de él un ANCLA y no un teorema del descenso. -/
theorem two_not_in_golden_lattice : ∀ n : ℤ, realise n ≠ 2 := by
  intro n hn
  unfold realise at hn
  rcases le_or_gt n 1 with hle | hgt
  · have hmono : φ ^ n ≤ φ ^ (1 : ℤ) :=
      zpow_le_zpow_right₀ (le_of_lt φ_gt_one) hle   -- ⚠ NOTA 2
    rw [zpow_one] at hmono
    have := φ_lt_two
    rw [hn] at hmono
    linarith
  · have hn2 : (2 : ℤ) ≤ n := hgt
    have hmono : φ ^ (2 : ℤ) ≤ φ ^ n :=
      zpow_le_zpow_right₀ (le_of_lt φ_gt_one) hn2   -- ⚠ NOTA 2
    have hsq : φ ^ (2 : ℤ) = φ + 1 := by
      rw [show ((2 : ℤ)) = ((2 : ℕ) : ℤ) from by norm_num, zpow_natCast]
      exact phi_sq
    rw [hsq, hn] at hmono
    have := φ_gt_one
    linarith

/-- El ancla, con su estatus correcto: φ^λ = 2 vale en ℝ y en ningún punto
    del retículo ℤ. -/
theorem anchor_is_exterior_to_F1_lattice :
    (φ ^ lambda_log = 2) ∧ (∀ n : ℤ, realise n ≠ 2) :=
  ⟨mersenne_bridge_via_lambda, two_not_in_golden_lattice⟩


-- ╔═══════════════════════════════════════════════════════════════════════╗
-- ║  §7  TEOREMA MAESTRO — LAS CINCO PIEZAS, CONECTADAS                   ║
-- ╚═══════════════════════════════════════════════════════════════════════╝

/-- **TEOREMA PUENTE F₁ / ESPECTROS / ANCLA / GALOIS.**

    (1)  F₁ ↔ G     : ψ_p descendido es G-equivariante (traslación por G(p)),
                      y el cuadrado ℤ→ℤ→Z₂₀*→Z₂×Z₂ conmuta.
    (2)  Atribución : mod 4 gobierna χ₄ y sólo χ₄; mod 5 gobierna χ₅ y sólo
                      χ₅; la pareja separa (CRT).
    (3)  Espectro M : el registro binario 2^m mod 20 tiene periodo 4.
    (4)  Espectro A : χ₅ selecciona el valor de F_p mod p para todo p > 5.
    (5)  Ancla      : φ^λ = 2 en ℝ, y en ningún punto de ℤ.

    NO se afirma nada más.  En particular no se afirma que esto complete
    ninguna cadena hacia E; sólo que los eslabones antes invocados y no
    probados quedan probados. -/
theorem F1_spectra_anchor_G_bridge :
    -- (1) F₁ ↔ Galois
    (∀ p : ℕ, p.Prime → 5 < p → ∀ a : ZMod 20, a ∈ ZtwentyStar →
       G (psi_mod 20 p a) = G ((p : ℕ) : ZMod 20) + G a) ∧
    (∀ p : ℕ, p.Prime → 5 < p → ∀ n : ℤ,
       ((n : ℤ) : ZMod 20) ∈ ZtwentyStar →
       G (((X_PCF.psi p n : ℤ)) : ZMod 20)
         = G ((p : ℕ) : ZMod 20) + G ((n : ℤ) : ZMod 20)) ∧
    -- (2) atribución estricta del conductor
    (∀ a b : ZMod 20, a ∈ ZtwentyStar → b ∈ ZtwentyStar →
       red4 a = red4 b → (G a).1 = (G b).1) ∧
    (∀ a b : ZMod 20, a ∈ ZtwentyStar → b ∈ ZtwentyStar →
       red5 a = red5 b → (G a).2 = (G b).2) ∧
    (∃ a b : ZMod 20, a ∈ ZtwentyStar ∧ b ∈ ZtwentyStar ∧
       red4 a = red4 b ∧ (G a).2 ≠ (G b).2) ∧
    (∃ a b : ZMod 20, a ∈ ZtwentyStar ∧ b ∈ ZtwentyStar ∧
       red5 a = red5 b ∧ (G a).1 ≠ (G b).1) ∧
    (∀ a b : ZMod 20, red4 a = red4 b → red5 a = red5 b → a = b) ∧
    -- (3) espectro multiplicativo
    (∀ m : ℕ, (2 : ZMod 20) ^ (m + 2 + 4) = (2 : ZMod 20) ^ (m + 2)) ∧
    -- (4) espectro aditivo
    (∀ p : ℕ, p.Prime → 5 < p →
       (chi5 ((p : ℕ) : ZMod 20) = 0 → (Nat.fib p : ZMod p) = 1) ∧
       (chi5 ((p : ℕ) : ZMod 20) = 1 → (Nat.fib p : ZMod p) = -1)) ∧
    -- (5) el ancla
    (φ ^ lambda_log = 2) ∧
    (∀ n : ℤ, realise n ≠ 2) :=
  ⟨fun p hp hp5 a ha => G_psi_equivariant p hp hp5 a ha,
   fun p hp hp5 n hn => F1_descends_to_Galois p hp hp5 n hn,
   mod4_determines_chi4, mod5_determines_chi5,
   mod4_does_not_determine_chi5, mod5_does_not_determine_chi4,
   conductor_splits,
   binary_register_has_period_four,
   fun p hp hp5 => additive_spectrum_governed_by_chi5 p hp hp5,
   mersenne_bridge_via_lambda, two_not_in_golden_lattice⟩

end

end F1SpectraAnchorG

