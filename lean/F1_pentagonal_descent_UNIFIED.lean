@[simp] lemma sub_b (x y : Q R) : (x - y).b = x.b - y.b := rfl
@[simp] lemma mul_a (x y : Q R) : (x * y).a = x.a * y.a + x.b * y.b := rfl
@[simp] lemma mul_b (x y : Q R) : (x * y).b = x.a * y.b + x.b * y.a + x.b * y.b := rfl
@[simp] lemma natCast_a (n : ℕ) : (n : Q R).a = n := rfl
@[simp] lemma natCast_b (n : ℕ) : (n : Q R).b = 0 := rfl
