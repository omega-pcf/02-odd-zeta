/-! ## §1.6 The continued-fraction sequence cf(0)=1, cf(n+1)=1+1/cf(n)
        and its convergence to φ -/

/-- The continued fraction sequence:  cf(0) = 1, cf(n+1) = 1 + 1/cf(n). -/
def cf : ℕ → ℝ
  | 0 => 1
  | n + 1 => 1 + 1 / cf n

/-- cf is positive at every level. -/
theorem cf_pos : ∀ n, 0 < cf n
  | 0 => by unfold cf; norm_num
  | n + 1 => by
    unfold cf
    have := cf_pos n
    have h_inv_pos : 0 < 1 / cf n := by positivity
    linarith

/-- cf is bounded below by 1. -/
theorem cf_ge_one : ∀ n, 1 ≤ cf n
  | 0 => by unfold cf; norm_num
  | n + 1 => by
    unfold cf
    have hp := cf_pos n
    have : 0 < 1 / cf n := by positivity
    linarith

/-- cf is bounded above by 2. -/
theorem cf_le_two : ∀ n, cf n ≤ 2 := by
  intro n
  induction n with
  | zero => unfold cf; norm_num
  | succ k ih =>
    have h1 : 1 ≤ cf k := cf_ge_one k
    have hp : 0 < cf k := cf_pos k
    unfold cf
    have : 1 / cf k ≤ 1 := by rw [div_le_one hp]; exact h1
    linarith

/-- KEY LEMMA — contraction estimate:
    |cf(n+1) - φ| = |cf n - φ| / (cf n · φ). -/
theorem cf_contraction (n : ℕ) :
    |cf (n+1) - φ| = |cf n - φ| / (cf n * φ) := by
  have hp : 0 < cf n := cf_pos n
  have hphi : 0 < φ := φ_pos
  have hself : φ = 1 + 1/φ := φ_self_ref
  have hkey : cf (n+1) - φ = (φ - cf n) / (cf n * φ) := by
    change (1 + 1 / cf n) - φ = (φ - cf n) / (cf n * φ)
    field_simp [ne_of_gt hp, ne_of_gt hphi]; nlinarith [phi_sq]
  rw [hkey, abs_div, abs_of_pos (mul_pos hp hphi), abs_sub_comm]

/-- Geometric decay: |cf n - φ| ≤ (1/φ)^n · |cf 0 - φ|. -/
theorem cf_geometric_decay (n : ℕ) :
    |cf n - φ| ≤ (1/φ)^n * |cf 0 - φ| := by
  induction n with
  | zero => simp
  | succ k ih =>
    have hcf_ge : 1 ≤ cf k := cf_ge_one k
    have hphi_pos : 0 < φ := φ_pos
    have hcfphi_pos : 0 < cf k * φ := mul_pos (cf_pos k) hphi_pos
    rw [cf_contraction]
    have h_recip : 1 / (cf k * φ) ≤ 1 / φ := by
      apply div_le_div_of_nonneg_left (by norm_num : (0:ℝ) ≤ 1) hphi_pos
      have : φ ≤ cf k * φ := by
        calc φ = 1 * φ := by ring
          _ ≤ cf k * φ := mul_le_mul_of_nonneg_right hcf_ge (le_of_lt hphi_pos)
      linarith
    calc |cf k - φ| / (cf k * φ)
        = |cf k - φ| * (1 / (cf k * φ)) := by rw [div_eq_mul_inv]; ring
      _ ≤ |cf k - φ| * (1 / φ) :=
          mul_le_mul_of_nonneg_left h_recip (abs_nonneg _)
      _ ≤ (1/φ)^k * |cf 0 - φ| * (1/φ) :=
          mul_le_mul_of_nonneg_right ih (by positivity)
      _ = (1/φ)^(k+1) * |cf 0 - φ| := by ring

/-- THEOREM (formerly axiom `phi_continued_fraction`):
    cf converges to φ as n → ∞.  Proved via geometric contraction. -/
theorem phi_continued_fraction :
    Filter.Tendsto cf Filter.atTop (nhds φ) := by
  rw [Metric.tendsto_atTop]
  intro ε hε
  have hphi_pos : 0 < φ := φ_pos
  have hphi_inv_lt : 1/φ < 1 := by
    rw [div_lt_one hphi_pos]; exact φ_gt_one
  have hphi_inv_pos : 0 < 1/φ := by positivity
  have hcf0 : cf 0 = 1 := rfl
  have hbound : |cf 0 - φ| = φ - 1 := by
    rw [hcf0, abs_of_neg (by linarith [φ_gt_one] : (1:ℝ) - φ < 0)]
    ring
  obtain ⟨N, hN⟩ : ∃ N, (1/φ)^N * (φ - 1) < ε := by
    have htend : Filter.Tendsto (fun n => (1/φ)^n * (φ - 1)) Filter.atTop (nhds 0) := by
      have h1 : Filter.Tendsto (fun n => (1/φ)^n) Filter.atTop (nhds 0) :=
        tendsto_pow_atTop_nhds_zero_of_lt_one
          (le_of_lt hphi_inv_pos) hphi_inv_lt
      simpa using h1.mul_const (φ - 1)
    rw [Metric.tendsto_atTop] at htend
    obtain ⟨N, hN⟩ := htend ε hε
    refine ⟨N, ?_⟩
    have := hN N (le_refl N)
    rw [Real.dist_eq, sub_zero,
        abs_of_nonneg (mul_nonneg (pow_nonneg (le_of_lt hphi_inv_pos) _)
          (by linarith [φ_gt_one]))] at this
    exact this
  refine ⟨N, fun n hn => ?_⟩
  rw [Real.dist_eq]
  have h_pow_decreasing : (1/φ)^n ≤ (1/φ)^N :=
    pow_le_pow_of_le_one (le_of_lt hphi_inv_pos) (le_of_lt hphi_inv_lt) hn
  calc |cf n - φ|
      ≤ (1/φ)^n * |cf 0 - φ| := cf_geometric_decay n
    _ = (1/φ)^n * (φ - 1) := by rw [hbound]
    _ ≤ (1/φ)^N * (φ - 1) := by
        apply mul_le_mul_of_nonneg_right h_pow_decreasing
        linarith [φ_gt_one]
    _ < ε := hN

/-! ## §1.7 The nested-radical sequence nr(0)=1, nr(n+1)=√(1+nr(n))
        and its convergence to φ -/

/-- The nested radical sequence:  nr(0) = 1, nr(n+1) = √(1 + nr n). -/
def nr : ℕ → ℝ
  | 0 => 1
  | n + 1 => Real.sqrt (1 + nr n)

theorem nr_nonneg : ∀ n, 0 ≤ nr n
  | 0 => by unfold nr; norm_num
  | n + 1 => by unfold nr; exact Real.sqrt_nonneg _

theorem nr_ge_one : ∀ n, 1 ≤ nr n
  | 0 => by unfold nr; norm_num
  | n + 1 => by
    unfold nr
    have hp := nr_ge_one n
    have h_one_le : (1:ℝ) ≤ 1 + nr n := by linarith
    have : Real.sqrt 1 ≤ Real.sqrt (1 + nr n) := Real.sqrt_le_sqrt h_one_le
    rwa [Real.sqrt_one] at this

theorem nr_le_two : ∀ n, nr n ≤ 2 := by
  intro n
  induction n with
  | zero => unfold nr; norm_num
  | succ k ih =>
    have h1 : 1 ≤ nr k := nr_ge_one k
    unfold nr
    have h_target : 1 + nr k ≤ 4 := by linarith
    have h_sqrt_4 : Real.sqrt (1 + nr k) ≤ Real.sqrt 4 :=
      Real.sqrt_le_sqrt h_target
    have h_sqrt_4_eq : Real.sqrt 4 = 2 := by
      rw [show (4:ℝ) = 2^2 from by norm_num,
          Real.sqrt_sq (by norm_num : (0:ℝ) ≤ 2)]
    linarith

/-- HELPER: For a, b ≥ 1: |√a - √b| ≤ (1/2) · |a - b|. -/
private lemma sqrt_diff_bound (a b : ℝ) (ha : 1 ≤ a) (hb : 1 ≤ b) :
    |Real.sqrt a - Real.sqrt b| ≤ (1/2) * |a - b| := by
  have ha_nonneg : (0:ℝ) ≤ a := by linarith
  have hb_nonneg : (0:ℝ) ≤ b := by linarith
  have h_sqrt_a_ge : 1 ≤ Real.sqrt a := by
    have h1 : Real.sqrt 1 ≤ Real.sqrt a := Real.sqrt_le_sqrt ha
    rwa [Real.sqrt_one] at h1
  have h_sqrt_b_ge : 1 ≤ Real.sqrt b := by
    have h1 : Real.sqrt 1 ≤ Real.sqrt b := Real.sqrt_le_sqrt hb
    rwa [Real.sqrt_one] at h1
  have h_sum_pos : 0 < Real.sqrt a + Real.sqrt b := by linarith
  have h_sum_ge_two : 2 ≤ Real.sqrt a + Real.sqrt b := by linarith
  have ha_sq : Real.sqrt a ^ 2 = a := Real.sq_sqrt ha_nonneg
  have hb_sq : Real.sqrt b ^ 2 = b := Real.sq_sqrt hb_nonneg
  have h_identity :
      (Real.sqrt a - Real.sqrt b) * (Real.sqrt a + Real.sqrt b) = a - b := by
    have : (Real.sqrt a - Real.sqrt b) * (Real.sqrt a + Real.sqrt b) =
           Real.sqrt a ^ 2 - Real.sqrt b ^ 2 := by ring
    rw [this, ha_sq, hb_sq]
  have h_abs_eq :
      |Real.sqrt a - Real.sqrt b| * (Real.sqrt a + Real.sqrt b) = |a - b| := by
    rw [show Real.sqrt a + Real.sqrt b = |Real.sqrt a + Real.sqrt b|
        from (abs_of_pos h_sum_pos).symm,
        ← abs_mul, h_identity]
  have h_div_eq :
      |Real.sqrt a - Real.sqrt b| = |a - b| / (Real.sqrt a + Real.sqrt b) := by
    rw [eq_div_iff (ne_of_gt h_sum_pos)]
    exact h_abs_eq
  rw [h_div_eq]
  rw [show (1/2 : ℝ) * |a - b| = |a - b| / 2 by ring]
  exact div_le_div_of_nonneg_left (abs_nonneg _) (by norm_num) h_sum_ge_two

/-- KEY LEMMA — contraction for nr:  |nr(n+1) - φ| ≤ (1/2) · |nr n - φ|. -/
theorem nr_contraction (n : ℕ) :
    |nr (n+1) - φ| ≤ (1/2) * |nr n - φ| := by
  have h_nr_ge : 1 ≤ nr n := nr_ge_one n
  have h_phi_pos : 0 < φ := φ_pos
  have h_phi_gt : 1 < φ := φ_gt_one
  have h_phi_self : φ = Real.sqrt (1 + φ) := φ_nested_ref
  have h_nr_succ : nr (n+1) = Real.sqrt (1 + nr n) := rfl
  rw [h_nr_succ]
  conv_lhs => rw [h_phi_self]
  have h_a_ge : (1:ℝ) ≤ 1 + nr n := by linarith
  have h_b_ge : (1:ℝ) ≤ 1 + φ := by linarith
  have h_diff : (1 + nr n) - (1 + φ) = nr n - φ := by ring
  calc |Real.sqrt (1 + nr n) - Real.sqrt (1 + φ)|
      ≤ (1/2) * |(1 + nr n) - (1 + φ)| :=
        sqrt_diff_bound (1 + nr n) (1 + φ) h_a_ge h_b_ge
    _ = (1/2) * |nr n - φ| := by rw [h_diff]

/-- THEOREM (formerly axiom `phi_nested_radical`):
    nr converges to φ as n → ∞.  Proved via (1/2)^n contraction. -/
theorem phi_nested_radical :
    Filter.Tendsto nr Filter.atTop (nhds φ) := by
  rw [Metric.tendsto_atTop]
  intro ε hε
  have h_decay : ∀ n, |nr n - φ| ≤ (1/2)^n * |nr 0 - φ| := by
    intro n
    induction n with
    | zero => simp
    | succ k ih =>
      calc |nr (k+1) - φ|
          ≤ (1/2) * |nr k - φ| := nr_contraction k
        _ ≤ (1/2) * ((1/2)^k * |nr 0 - φ|) :=
            mul_le_mul_of_nonneg_left ih (by norm_num : (0:ℝ) ≤ 1/2)
        _ = (1/2)^(k+1) * |nr 0 - φ| := by ring
  have h_nr_0 : nr 0 = 1 := rfl
  have h_phi_gt : 1 < φ := φ_gt_one
  have h_bound : |nr 0 - φ| = φ - 1 := by
    rw [h_nr_0, abs_of_neg (by linarith : (1:ℝ) - φ < 0)]
    ring
  obtain ⟨N, hN⟩ : ∃ N, ((1/2 : ℝ))^N * (φ - 1) < ε := by
    have htend : Filter.Tendsto (fun n => ((1/2 : ℝ))^n * (φ - 1))
                                Filter.atTop (nhds 0) := by
      have h1 : Filter.Tendsto (fun n => ((1/2 : ℝ))^n)
                               Filter.atTop (nhds 0) :=
        tendsto_pow_atTop_nhds_zero_of_lt_one
          (by norm_num : (0:ℝ) ≤ 1/2)
          (by norm_num : (1/2 : ℝ) < 1)
      simpa using h1.mul_const (φ - 1)
    rw [Metric.tendsto_atTop] at htend
    obtain ⟨N, hN⟩ := htend ε hε
    refine ⟨N, ?_⟩
    have := hN N (le_refl N)
    rw [Real.dist_eq, sub_zero,
        abs_of_nonneg (mul_nonneg (pow_nonneg (by norm_num : (0:ℝ) ≤ 1/2) _)
          (by linarith [h_phi_gt]))] at this
    exact this
  refine ⟨N, fun n hn => ?_⟩
  rw [Real.dist_eq]
  have h_pow_decreasing : ((1/2 : ℝ))^n ≤ ((1/2 : ℝ))^N :=
    pow_le_pow_of_le_one (by norm_num : (0:ℝ) ≤ 1/2)
      (by norm_num : (1/2 : ℝ) ≤ 1) hn
  calc |nr n - φ|
      ≤ (1/2)^n * |nr 0 - φ| := h_decay n
    _ = (1/2)^n * (φ - 1) := by rw [h_bound]
    _ ≤ (1/2)^N * (φ - 1) := by
        apply mul_le_mul_of_nonneg_right h_pow_decreasing
        linarith
    _ < ε := hN


/-! ## §1.8 The pentagon identity: φ = 2 cos(π/5) -/

/-- Helper: φ/2 satisfies 4x² - 2x - 1 = 0. -/
theorem phi_half_quadratic : 4 * (φ / 2) ^ 2 - 2 * (φ / 2) - 1 = 0 := by
  have h := phi_sq; field_simp; nlinarith [h]

/-- Chebyshev: cos(5θ) = 16cos⁵θ - 20cos³θ + 5cosθ. -/
theorem cos_five_mul (θ : ℝ) :
    Real.cos (5 * θ) = 16 * Real.cos θ ^ 5 - 20 * Real.cos θ ^ 3 + 5 * Real.cos θ := by
  have hs : Real.sin θ ^ 2 = 1 - Real.cos θ ^ 2 := by
    nlinarith [Real.sin_sq_add_cos_sq θ]
  have c2 : Real.cos (2 * θ) = 2 * Real.cos θ ^ 2 - 1 := Real.cos_two_mul θ
  have s2 : Real.sin (2 * θ) = 2 * Real.sin θ * Real.cos θ := Real.sin_two_mul θ
  have c3 : Real.cos (3 * θ) = 4 * Real.cos θ ^ 3 - 3 * Real.cos θ := by
    rw [show (3 : ℝ) * θ = 2 * θ + θ from by ring, Real.cos_add, c2, s2]
    linear_combination -2 * Real.cos θ * hs
  have s3 : Real.sin (3 * θ) = 3 * Real.sin θ - 4 * Real.sin θ ^ 3 := by
    rw [show (3 : ℝ) * θ = 2 * θ + θ from by ring, Real.sin_add, c2, s2]
    linear_combination 4 * Real.sin θ * hs
  rw [show (5 : ℝ) * θ = 3 * θ + 2 * θ from by ring, Real.cos_add, c2, c3, s2, s3]
  linear_combination Real.cos θ * (8 * Real.sin θ ^ 2 - 8 * Real.cos θ ^ 2 + 2) * hs

/-- cos(π/5) is positive. -/
theorem cos_pi_five_pos : 0 < Real.cos (Real.pi / 5) := by
  apply Real.cos_pos_of_mem_Ioo; constructor <;> linarith [Real.pi_pos]

/-- cos(π/5) satisfies the same quadratic 4x² - 2x - 1 = 0. -/
theorem cos_pi_five_quadratic :
    4 * Real.cos (Real.pi / 5) ^ 2 - 2 * Real.cos (Real.pi / 5) - 1 = 0 := by
  have hq : 16 * Real.cos (Real.pi/5)^5 - 20 * Real.cos (Real.pi/5)^3
              + 5 * Real.cos (Real.pi/5) + 1 = 0 := by
    have h : Real.cos (5 * (Real.pi / 5)) = Real.cos Real.pi := by ring_nf
    rw [cos_five_mul] at h; rw [Real.cos_pi] at h; linarith
  set c := Real.cos (Real.pi / 5)
  have h0 : (c + 1) * (4 * c ^ 2 - 2 * c - 1) ^ 2 = 0 := by nlinarith [hq]
  have : (4 * c ^ 2 - 2 * c - 1) ^ 2 = 0 := by
    rcases mul_eq_zero.mp h0 with h | h
    · linarith [cos_pi_five_pos]
    · exact h
  nlinarith

/-- Unique positive root of 4x² - 2x - 1 = 0. -/
theorem quadratic_unique_pos (x y : ℝ) (hx : 0 < x) (hy : 0 < y)
    (hxe : 4 * x ^ 2 - 2 * x - 1 = 0) (hye : 4 * y ^ 2 - 2 * y - 1 = 0) :
    x = y := by
  have h : (x - y) * (4 * (x + y) - 2) = 0 := by nlinarith
  rcases mul_eq_zero.mp h with h | h
  · linarith
  · exfalso; have : x < 1/2 := by linarith
    linarith [show 4 * x ^ 2 < 1 from by nlinarith]

/-- cos(π/5) = φ/2. -/
theorem cos_pi_div_five_eq : Real.cos (Real.pi / 5) = φ / 2 :=
  quadratic_unique_pos _ _ cos_pi_five_pos (by unfold φ; positivity)
    cos_pi_five_quadratic phi_half_quadratic

/-- THE PENTAGON IDENTITY: φ = 2 cos(π/5).
    This connects the algebraic generator φ (defined by φ² = φ + 1)
    with the geometry of the regular pentagon. -/
theorem pentagon_identity : 2 * Real.cos (Real.pi / 5) = φ := by
  linarith [cos_pi_div_five_eq]

/-! ## §1.9 The quadratic field arithmetic of ℚ(√5) -/

/-- The Galois conjugate of φ. -/
def phi_bar : ℝ := -1 / φ

/-- φ̄ = 1 - φ. -/
theorem phi_bar_eq : phi_bar = 1 - φ := by
  unfold phi_bar φ
  have h5 : (0 : ℝ) < Real.sqrt 5 := by positivity
  have hφ : (0 : ℝ) < (1 + Real.sqrt 5) / 2 := by positivity
  field_simp
  nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 5 by norm_num)]

/-- Trace: φ + φ̄ = 1. -/
theorem trace_one : φ + phi_bar = 1 := by
  rw [phi_bar_eq]; ring

/-- Norm: φ · φ̄ = -1. -/
theorem norm_neg_one : φ * phi_bar = -1 := by
  unfold phi_bar
  have hφ_pos : 0 < φ := φ_pos
  have hφ_ne : φ ≠ 0 := ne_of_gt hφ_pos
  field_simp [hφ_ne]

/-- Discriminant of ℚ(√5) is 5: (φ - φ̄)² = 5. -/
theorem discriminant_five : (φ - phi_bar) ^ 2 = 5 := by
  have htrace := trace_one
  have hnorm := norm_neg_one
  nlinarith [sq_nonneg (φ - phi_bar), sq_nonneg (φ + phi_bar)]

/-- Self-measurement identity: z = φy implies z² = zy + y². -/
theorem self_measurement (y : ℝ) : (φ * y) ^ 2 = (φ * y) * y + y ^ 2 := by
  have h := phi_sq
  have : φ ^ 2 * y ^ 2 = (φ + 1) * y ^ 2 := by nlinarith
  nlinarith [mul_pow φ y 2]


