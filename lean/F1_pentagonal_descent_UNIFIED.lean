/-! ## 1. La transformada del triángulo no se anula fuera del eje real -/

/-- **[P*, riesgo de nombres: `Complex.sin_eq_zero_iff`] sen z ≠ 0 si z no es real.**  Los
    ceros del seno complejo son los kπ, todos reales. -/
theorem sin_ne_zero_off_real (z : ℂ) (hz : z.im ≠ 0) : Complex.sin z ≠ 0 := by
  intro h
  obtain ⟨k, hk⟩ := Complex.sin_eq_zero_iff.mp h
  first
    | exact hz (by simpa using congrArg Complex.im hk)
    | exact hz (by simpa using (congrArg Complex.im hk).symm)

/-- **[P*] La transformada del triángulo de anchura a > 0,
    ĝ_a(z) = a·(sen(az/2)/(az/2))², no se anula en ningún z con Im z ≠ 0.**  Un cero ρ fuera de
    la recta entra en la fórmula explícita en γ_c = (ρ − ½)/i, cuya parte imaginaria es
    −(Re ρ − ½) ≠ 0; así que TODA anchura ve TODO cero fuera de la recta.  Es la razón por la que
    en el teorema de cierre basta una sola anchura (`the_line_from_W4_one_width`). -/
theorem triangle_transform_ne_zero (a : ℝ) (ha : 0 < a) (z : ℂ) (hz : z.im ≠ 0) :
    (a : ℂ) * (Complex.sin (((a / 2 : ℝ) : ℂ) * z) / (((a / 2 : ℝ) : ℂ) * z)) ^ 2 ≠ 0 := by
  have him : (((a / 2 : ℝ) : ℂ) * z).im ≠ 0 := by
    rw [Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, zero_mul, add_zero]
    exact mul_ne_zero (by positivity) hz
  have hu : ((a / 2 : ℝ) : ℂ) * z ≠ 0 := fun h => him (by rw [h, Complex.zero_im])
  have hsin := sin_ne_zero_off_real _ him
  have ha' : (a : ℂ) ≠ 0 := by exact_mod_cast ha.ne'
  exact mul_ne_zero ha' (pow_ne_zero 2 (div_ne_zero hsin hu))

/-- **[P*, riesgo de nombres: `Complex.div_I`, normalización de simp] La ordenada compleja de un
    cero fuera de la recta no es real:**
    γ_c = (ρ − ½)/i tiene Im γ_c = ½ − Re ρ. -/
theorem complex_ordinate_im (ρ : ℂ) : ((ρ - 1 / 2) / Complex.I).im = 1 / 2 - ρ.re := by
  rw [Complex.div_I]; simp [Complex.mul_im]; try ring

/-! ## 2. El teorema de cierre con una sola anchura -/

/-- **[P*] (W4) es monótona en la familia de anchuras:** pedirla en menos anchuras es pedir
    menos. -/
theorem W4Chi5_mono (O : OrbitData) {F F' : Set ℝ} (hsub : F' ⊆ F) (h : W4Chi5 O F) :
    W4Chi5 O F' :=
  fun a ha k => h a (hsub ha) k

/-- **[P*] La detección con una familia pequeña da la detección con cualquier familia mayor.** -/
theorem detects_mono (O : OrbitData) {F F' : Set ℝ} (hsub : F' ⊆ F)
    (h : OrbitDetectsOffLine O F') : OrbitDetectsOffLine O F := by
  intro z hz
  obtain ⟨a, ha, c, C, hc, hk⟩ := h z hz
  exact ⟨a, hsub ha, c, C, hc, hk⟩

/-- **[P*] EL TEOREMA DE CIERRE CON UNA SOLA ANCHURA.**  Para un primo p y una anchura a₀: si
    la órbita explícita de L(s, χ₅) cumple (W4) en a₀ para todo k, y la fórmula explícita en
    la órbita detecta con esa anchura los ceros fuera de la recta, todo cero tiene parte real ½.
    La hipótesis abierta, (W4), queda reducida a UNA anchura (`W4Chi5_mono`).  La entrada
    clásica con una anchura vale para a₀ fuera de un conjunto numerable: ĝ_{a₀} no se anula en la
    ordenada compleja de ningún cero fuera de la recta (`triangle_transform_ne_zero`,
    `complex_ordinate_im`), y la suma de coeficientes de ceros con el mismo λ = e^{iγ log p}
    (misma parte real y ordenadas congruentes módulo 2π/log p) es analítica en a y no idéntica a
    0, así que se anula solo en un conjunto numerable de anchuras [T].  Lo que la entrada clásica
    usa además, que el módulo máximo se alcance, está separado en `DominantResidue` (§6). -/
theorem the_line_from_W4_one_width (p : ℝ) (hp : 1 < p) (a₀ : ℝ)
    (hW4 : W4Chi5 (chi5WeilOrbit p hp) {a₀})
    (hEF : OrbitDetectsOffLine (chi5WeilOrbit p hp) {a₀}) :
    ∀ z : Chi5Zero, z.ρ.re = 1 / 2 :=
  the_line_from_W4 (chi5WeilOrbit p hp) {a₀} hW4 hEF

/-! ## 3. El teorema de cierre para todo carácter de Dirichlet (la torre, nivel por nivel) -/

/-- Un cero no trivial de L(s, χ) en la franja, para un carácter de Dirichlet χ de módulo N. -/
structure CharZero {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N) where
  ρ : ℂ
  in_strip_pos : 0 < ρ.re
  in_strip_lt : ρ.re < 1
  is_zero : DirichletCharacter.LFunction χ ρ = 0

/-- **[O] (W4) para una órbita:** |t_k| ≤ t₀ para toda anchura de la familia y toda k. -/
def W4 (O : OrbitData) (family : Set ℝ) : Prop :=
  ∀ a ∈ family, ∀ k : ℕ, |O.t a k| ≤ O.t a 0

/-- **[C] La órbita detecta los ceros fuera de la recta de L(s, χ)** (fórmula explícita en la
    órbita más la separación con fases), con la misma forma que `OrbitDetectsOffLine`. -/
def DetectsOffLine {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N) (O : OrbitData)
    (family : Set ℝ) :
    Prop :=
  ∀ z : CharZero χ, z.ρ.re ≠ 1 / 2 → ∃ a ∈ family, ∃ c C : ℝ, 0 < c ∧
    ∀ K : ℕ, ∃ k, K ≤ k ∧ c * (O.p ^ |z.ρ.re - 1 / 2|) ^ k ≤ |O.t a k| + C

/-- **[P*] EL TEOREMA DE CIERRE PARA TODO CARÁCTER.**  La prueba de `the_line_from_W4` no usa
    nada de χ₅: vale para cualquier carácter de Dirichlet, en particular para los de cada nivel
    de la torre (módulos 4·5ⁿ).  (Para la capa de Kummer, ρ de F₂₀, la función L no es de
    Dirichlet y no está en Mathlib; el enunciado sería el mismo.) -/
theorem the_line_from_W4_char {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N) (O : OrbitData)
    (family : Set ℝ) (hW4 : W4 O family) (hdet : DetectsOffLine χ O family) :
    ∀ z : CharZero χ, z.ρ.re = 1 / 2 := by
  intro z
  by_contra hne
  obtain ⟨a, ha, c, C, hc, hk⟩ := hdet z hne
  set R := O.p ^ |z.ρ.re - 1 / 2| with hRdef
  have hR : 1 < R := Real.one_lt_rpow O.hp (abs_pos.mpr (sub_ne_zero.mpr hne))
  obtain ⟨K, hK⟩ := pow_unbounded_of_one_lt ((O.t a 0 + C) / c) hR
  obtain ⟨k, hkK, hbound⟩ := hk K
  have h1 : R ^ K ≤ R ^ k := pow_le_pow_right₀ (le_of_lt hR) hkK
  have h2 := hW4 a ha k
  have hup : c * R ^ k ≤ O.t a 0 + C := by linarith
  have h3 : (O.t a 0 + C) / c < R ^ k := lt_of_lt_of_le hK h1
  have h4 : O.t a 0 + C < R ^ k * c := (div_lt_iff₀ hc).mp h3
  nlinarith [mul_comm c (R ^ k)]

/-- **[P*] Y con una sola anchura, para todo carácter.** -/
theorem the_line_from_W4_char_one_width {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N)
    (O : OrbitData)
    (a₀ : ℝ) (hW4 : W4 O {a₀}) (hdet : DetectsOffLine χ O {a₀}) :
    ∀ z : CharZero χ, z.ρ.re = 1 / 2 :=
  the_line_from_W4_char χ O {a₀} hW4 hdet

/-! ## 4. (W4) no tiene holgura: Dirichlet simultánea, sin independencia lineal -/

/-- **[P*, riesgo de nombres: `Finset.exists_ne_map_eq_of_card_lt_of_maps_to`,
    `Int.abs_sub_lt_one_of_floor_eq_floor`] Aproximación simultánea de Dirichlet (casillas).**
    Para N reales α_j y Q ≥ 1 hay un k con 1 ≤ k ≤ Q^N y, para cada j, un entero m_j con
    |k·α_j − m_j| < 1/Q.  No pide ninguna independencia entre los α_j. -/
theorem dirichlet_simultaneous (N Q : ℕ) (hQ : 0 < Q) (α : Fin N → ℝ) :
    ∃ k : ℕ, 0 < k ∧ k ≤ Q ^ N ∧ ∀ j, ∃ m : ℤ, |(k : ℝ) * α j - m| < 1 / Q := by
  classical
  have hQr : (0 : ℝ) < Q := by exact_mod_cast hQ
  -- la casilla de k en la coordenada j: ⌊fract(k α_j)·Q⌋ ∈ {0, …, Q−1}
  have hcell : ∀ (k : ℕ) (j : Fin N), (⌊Int.fract ((k : ℝ) * α j) * Q⌋).toNat < Q := by
    intro k j
    have h0 : 0 ≤ Int.fract ((k : ℝ) * α j) * Q := mul_nonneg (Int.fract_nonneg _) hQr.le
    have h1 : Int.fract ((k : ℝ) * α j) * Q < Q := by
      have := Int.fract_lt_one ((k : ℝ) * α j)
      nlinarith
    have hfl : ⌊Int.fract ((k : ℝ) * α j) * Q⌋ < (Q : ℤ) := by
      rw [Int.floor_lt]; exact_mod_cast h1
    have hfl0 : 0 ≤ ⌊Int.fract ((k : ℝ) * α j) * Q⌋ := Int.floor_nonneg.mpr h0
    omega
  let f : ℕ → (Fin N → Fin Q) := fun k j => ⟨_, hcell k j⟩
  have hcard : (Finset.univ : Finset (Fin N → Fin Q)).card < (Finset.range (Q ^ N + 1)).card := by
    simp [Finset.card_univ, Fintype.card_fun, Fintype.card_fin]
  obtain ⟨x, hx, y, hy, hxy, hfxy⟩ :=
    Finset.exists_ne_map_eq_of_card_lt_of_maps_to hcard (fun a _ => Finset.mem_univ (f a))
  -- sin pérdida de generalidad x < y
  have key : ∀ x y : ℕ, x < y → y ≤ Q ^ N → f x = f y →
      ∃ k : ℕ, 0 < k ∧ k ≤ Q ^ N ∧ ∀ j, ∃ m : ℤ, |(k : ℝ) * α j - m| < 1 / Q := by
    intro x y hlt hyle hf
    refine ⟨y - x, by omega, by omega, fun j => ?_⟩
    have hj := congrFun hf j
    simp only [f, Fin.mk.injEq] at hj
    have hfx0 : 0 ≤ ⌊Int.fract ((x : ℝ) * α j) * Q⌋ :=
      Int.floor_nonneg.mpr (mul_nonneg (Int.fract_nonneg _) hQr.le)
    have hfy0 : 0 ≤ ⌊Int.fract ((y : ℝ) * α j) * Q⌋ :=
      Int.floor_nonneg.mpr (mul_nonneg (Int.fract_nonneg _) hQr.le)
    have heq : ⌊Int.fract ((x : ℝ) * α j) * Q⌋ = ⌊Int.fract ((y : ℝ) * α j) * Q⌋ := by omega
    have hlt1 := Int.abs_sub_lt_one_of_floor_eq_floor heq
    refine ⟨⌊(y : ℝ) * α j⌋ - ⌊(x : ℝ) * α j⌋, ?_⟩
    have hcast : ((y - x : ℕ) : ℝ) = (y : ℝ) - x := by
      rw [Nat.cast_sub hlt.le]
    rw [hcast]
    have e : ((y : ℝ) - x) * α j - ((⌊(y : ℝ) * α j⌋ - ⌊(x : ℝ) * α j⌋ : ℤ) : ℝ)
        = Int.fract ((y : ℝ) * α j) - Int.fract ((x : ℝ) * α j) := by
      simp only [Int.fract, Int.cast_sub]; ring
    rw [e]
    have hQ1 : |Int.fract ((y : ℝ) * α j) - Int.fract ((x : ℝ) * α j)| * Q < 1 := by
      have : |Int.fract ((x : ℝ) * α j) * Q - Int.fract ((y : ℝ) * α j) * Q| < 1 := hlt1
      rw [← sub_mul, abs_mul, abs_of_pos hQr] at this
      rwa [abs_sub_comm] at this
    rw [lt_div_iff₀ hQr]; exact hQ1
  rcases lt_or_gt_of_ne hxy with h | h
  · exact key x y h (by simp at hy; omega) hfxy
  · exact key y x h (by simp at hx; omega) hfxy.symm

/-- **[P*, riesgo de nombres: `Real.one_sub_sq_div_two_le_cos`, `Real.cos_add_int_mul_two_pi`,
    `div_le_div_of_nonneg_left`] SIN HOLGURA UNIFORME.**  Si t_k = Σ_j w_j·cos(k·θ_j) con pesos w_j ≥ 0 (la forma de la
    órbita de (W4) cuando todos los ceros están en la recta, truncada a N ceros), entonces para
    todo ε > 0 hay k ≥ 1 con t_k ≥ t_0 − ε, donde t_0 = Σ w_j.  No hace falta ninguna
    independencia de las fases: es Dirichlet.  Con pesos sumables, la cola fuera de los N primeros
    es arbitrariamente pequeña, así que sup_{k≥1} t_k = t_0 [T].  Por eso (W4), si vale, vale sin
    margen uniforme en k, y su prueba tiene que ser exacta. -/
theorem no_uniform_slack (N : ℕ) (w θ : Fin N → ℝ) (hw : ∀ j, 0 ≤ w j) (ε : ℝ) (hε : 0 < ε) :
    ∃ k : ℕ, 0 < k ∧ ∑ j, w j - ε ≤ ∑ j, w j * Real.cos (k * θ j) := by
  classical
  set S := ∑ j, w j with hS
  have hS0 : 0 ≤ S := Finset.sum_nonneg (fun j _ => hw j)
  obtain ⟨Q, hQ⟩ := exists_nat_gt (2 * Real.pi ^ 2 * S / ε + 1)
  have hA : 0 ≤ 2 * Real.pi ^ 2 * S := by positivity
  have hQr : (1 : ℝ) ≤ Q := by
    have : 0 ≤ 2 * Real.pi ^ 2 * S / ε := div_nonneg hA hε.le
    linarith
  have hQpos : 0 < Q := by exact_mod_cast (lt_of_lt_of_le one_pos hQr)
  have hQreal : (0 : ℝ) < Q := by exact_mod_cast hQpos
  obtain ⟨k, hk0, -, hk⟩ := dirichlet_simultaneous N Q hQpos (fun j => θ j / (2 * Real.pi))
  refine ⟨k, hk0, ?_⟩
  have hcos : ∀ j, 1 - 2 * Real.pi ^ 2 / (Q : ℝ) ^ 2 ≤ Real.cos (k * θ j) := by
    intro j
    obtain ⟨m, hm⟩ := hk j
    set δ := (k : ℝ) * (θ j / (2 * Real.pi)) - m with hδ
    have hpi : Real.pi ≠ 0 := Real.pi_ne_zero
    have h1 : 2 * Real.pi * ((k : ℝ) * (θ j / (2 * Real.pi))) = k * θ j := by
      field_simp
      try ring
    have hθ : (k : ℝ) * θ j = 2 * Real.pi * δ + (m : ℝ) * (2 * Real.pi) := by
      rw [hδ]; linear_combination (-1 : ℝ) * h1
    rw [hθ, Real.cos_add_int_mul_two_pi]
    have hb := Real.one_sub_sq_div_two_le_cos (x := 2 * Real.pi * δ)
    have hδ2 : δ ^ 2 ≤ 1 / (Q : ℝ) ^ 2 := by
      have hlt : |δ| < 1 / Q := hm
      have h2 : δ ^ 2 = |δ| ^ 2 := (sq_abs δ).symm
      rw [h2, one_div, ← inv_pow]
      exact pow_le_pow_left₀ (abs_nonneg δ) (by rw [← one_div]; exact hlt.le) 2
    have hm2 := mul_le_mul_of_nonneg_left hδ2 (by positivity : (0 : ℝ) ≤ 2 * Real.pi ^ 2)
    calc 1 - 2 * Real.pi ^ 2 / (Q : ℝ) ^ 2 = 1 - 2 * Real.pi ^ 2 * (1 / (Q : ℝ) ^ 2) := by ring
      _ ≤ 1 - 2 * Real.pi ^ 2 * δ ^ 2 := by linarith
      _ = 1 - (2 * Real.pi * δ) ^ 2 / 2 := by ring
      _ ≤ Real.cos (2 * Real.pi * δ) := hb
  have hsum : ∑ j, w j * (1 - 2 * Real.pi ^ 2 / (Q : ℝ) ^ 2) ≤ ∑ j, w j * Real.cos (k * θ j) :=
    Finset.sum_le_sum (fun j _ => mul_le_mul_of_nonneg_left (hcos j) (hw j))
  have hfac : ∑ j, w j * (1 - 2 * Real.pi ^ 2 / (Q : ℝ) ^ 2)
      = S * (1 - 2 * Real.pi ^ 2 / (Q : ℝ) ^ 2) := by
    rw [← Finset.sum_mul]
  have hQQ : (Q : ℝ) ≤ (Q : ℝ) ^ 2 := by nlinarith
  have step1 : S * (2 * Real.pi ^ 2 / (Q : ℝ) ^ 2) = 2 * Real.pi ^ 2 * S / (Q : ℝ) ^ 2 := by ring
  have step2 : 2 * Real.pi ^ 2 * S / (Q : ℝ) ^ 2 ≤ 2 * Real.pi ^ 2 * S / Q :=
    div_le_div_of_nonneg_left hA hQreal hQQ
  have step3 : 2 * Real.pi ^ 2 * S / Q ≤ ε := by
    rw [div_le_iff₀ hQreal]
    have h4 : 2 * Real.pi ^ 2 * S / ε < Q := by linarith
    rw [div_lt_iff₀ hε] at h4
    linarith
  have hsmall : S * (2 * Real.pi ^ 2 / (Q : ℝ) ^ 2) ≤ ε := by linarith
  have hexp : S * (1 - 2 * Real.pi ^ 2 / (Q : ℝ) ^ 2) = S - S * (2 * Real.pi ^ 2 / (Q : ℝ) ^ 2) := by
    ring
  linarith [hsum, hfac, hexp]

/-! ## 5. La cadena de Weil sobre una órbita: índice de Hodge ⇒ Castelnuovo–Severi ⇒ recta -/

/-- **[O] El índice de Hodge sobre la órbita (W3 restringido a la órbita), en su forma mínima:**
    para cada anchura de la familia y cada k, los menores 2 × 2 de la matriz de Toeplitz de la
    órbita con los vectores (1, ±1) son ≥ 0: t₀ + t_k ≥ 0 y t₀ − t_k ≥ 0.  (La semidefinición
    de toda la matriz, para todo tamaño, lo implica; por Herglotz equivale a una realización
    unitaria [C].) -/
def OrbitHodgeIndex (O : OrbitData) (family : Set ℝ) : Prop :=
  ∀ a ∈ family, ∀ k : ℕ, 0 ≤ O.t a 0 + O.t a k ∧ 0 ≤ O.t a 0 - O.t a k

/-- **[P*] W3 ⇒ W4: el índice de Hodge sobre la órbita da Castelnuovo–Severi**
    (`toeplitz_bound` del corpus). -/
theorem W4_of_orbit_hodge (O : OrbitData) (family : Set ℝ) (h : OrbitHodgeIndex O family) :
    W4Chi5 O family :=
  fun a ha k => toeplitz_bound _ _ (h a ha k).1 (h a ha k).2

/-- **[P*] W4 ⇒ W3 en su forma mínima:** |t_k| ≤ t₀ da los menores 2 × 2.  Así, sobre una órbita,
    `OrbitHodgeIndex` y (W4) son la misma condición. -/
theorem orbit_hodge_of_W4 (O : OrbitData) (family : Set ℝ) (h : W4Chi5 O family) :
    OrbitHodgeIndex O family := by
  intro a ha k
  have := abs_le.mp (h a ha k)
  constructor <;> linarith [this.1, this.2]

/-- **[P*] LA CADENA DE WEIL COMPLETA SOBRE UNA ÓRBITA, CON UNA ANCHURA.**  W3 (índice de Hodge
    sobre la órbita de un primo, una anchura) ⇒ W4 (Castelnuovo–Severi) ⇒ W5 (la recta), dada la
    entrada clásica (la fórmula explícita en la órbita).  Lo único abierto es la fuente de W3:
    en Weil, la geometría de C × C; aquí, el objeto que el programa 𝔽₁ busca. -/
theorem the_line_from_orbit_hodge (p : ℝ) (hp : 1 < p) (a₀ : ℝ)
    (hH : OrbitHodgeIndex (chi5WeilOrbit p hp) {a₀})
    (hEF : OrbitDetectsOffLine (chi5WeilOrbit p hp) {a₀}) :
    ∀ z : Chi5Zero, z.ρ.re = 1 / 2 :=
  the_line_from_W4_one_width p hp a₀ (W4_of_orbit_hodge _ _ hH) hEF

/-! ## 6. La entrada clásica, reducida: de la expansión espectral de la órbita a la detección

  `OrbitDetectsOffLine` (corpus) entra como [C].  Aquí se separa en (a) la expansión de la órbita
  por los ceros —la fórmula explícita [C]— y (b) el argumento que de ella saca la detección, que
  queda DEMOSTRADO [P*] cuando el módulo máximo |λ| > 1 se alcanza y el residuo allí no es nulo.
  El residuo en λ₀ es la suma de los coeficientes ĝ_a(γ_c)² de los ceros con ese mismo λ₀; puede
  anularse solo para un conjunto numerable de anchuras a (analiticidad en a) [T]. -/

/-- **[C] La órbita como expansión espectral:** t_k = Σ_i c_i·λ_i^k, con Σ ‖c_i‖ < ∞ y
    ‖λ_i‖ ≤ B.  Para la órbita de Weil, i recorre los ceros, c_i = ĝ_a(γ_i)² y
    λ_i = e^{iγ_i log p} (‖λ_i‖ = p^{±(Re ρ − ½)} ≤ √p). -/
structure OrbitExpansion (t : ℕ → ℂ) where
  ι : Type
  c : ι → ℂ
  lam : ι → ℂ
  B : ℝ
  hc : Summable (fun i => ‖c i‖)
  hB : ∀ i, ‖lam i‖ ≤ B
  ht : ∀ k, t k = ∑' i, c i * lam i ^ k

/-- El promedio de Cesàro (1/K) Σ_{k<K} w^k. -/
noncomputable def cesaro (w : ℂ) (K : ℕ) : ℂ := (1 / (K : ℂ)) * ∑ k ∈ Finset.range K, w ^ k

/-- **[P*, riesgo: `pow_le_one₀`]** Si ‖w‖ ≤ 1, el promedio tiene norma ≤ 1. -/
theorem cesaro_norm_le_one (w : ℂ) (hw : ‖w‖ ≤ 1) (K : ℕ) : ‖cesaro w K‖ ≤ 1 := by
  unfold cesaro
  rcases Nat.eq_zero_or_pos K with hK | hK
  · subst hK; simp
  · have hKr : (0 : ℝ) < K := by exact_mod_cast hK
    have hs : ‖∑ k ∈ Finset.range K, w ^ k‖ ≤ K := by
      calc ‖∑ k ∈ Finset.range K, w ^ k‖ ≤ ∑ k ∈ Finset.range K, ‖w ^ k‖ := norm_sum_le _ _
        _ ≤ ∑ k ∈ Finset.range K, (1 : ℝ) :=
            Finset.sum_le_sum (fun k _ => by rw [norm_pow]; exact pow_le_one₀ (norm_nonneg _) hw)
        _ = K := by simp
    rw [norm_mul, norm_div, norm_one, Complex.norm_natCast]
    calc 1 / (K : ℝ) * ‖∑ k ∈ Finset.range K, w ^ k‖ ≤ 1 / (K : ℝ) * K := by gcongr
      _ = 1 := by field_simp

/-- **[P*]** Con w = 1 el promedio es 1 para K ≥ 1. -/
theorem cesaro_one_tendsto : Filter.Tendsto (cesaro 1) Filter.atTop (nhds 1) := by
  apply tendsto_const_nhds.congr'
  filter_upwards [Filter.eventually_ge_atTop 1] with K hK
  unfold cesaro
  have hK0 : (K : ℂ) ≠ 0 := by exact_mod_cast (show K ≠ 0 by omega)
  simp only [one_pow, Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one]
  field_simp

/-- **[P*, riesgo: `tendsto_const_div_atTop_nhds_zero_nat`]** Con ‖w‖ ≤ 1 y w ≠ 1 el promedio
    tiende a 0 (suma geométrica: ‖Σ w^k‖ ≤ 2/‖w − 1‖). -/
theorem cesaro_tendsto_zero (w : ℂ) (hw : ‖w‖ ≤ 1) (hne : w ≠ 1) :
    Filter.Tendsto (cesaro w) Filter.atTop (nhds 0) := by
  have hpos : 0 < ‖w - 1‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hne)
  have hbound : ∀ K : ℕ, ‖cesaro w K‖ ≤ (2 / ‖w - 1‖) / K := by
    intro K
    unfold cesaro
    rcases Nat.eq_zero_or_pos K with hK | hK
    · subst hK; simp
    · have hKr : (0 : ℝ) < K := by exact_mod_cast hK
      have hg : ‖∑ k ∈ Finset.range K, w ^ k‖ ≤ 2 / ‖w - 1‖ := by
        rw [geom_sum_eq hne, norm_div]
        apply div_le_div_of_nonneg_right _ hpos.le
        calc ‖w ^ K - 1‖ ≤ ‖w ^ K‖ + ‖(1 : ℂ)‖ := norm_sub_le _ _
          _ ≤ 1 + 1 := by
              rw [norm_pow, norm_one]
              exact add_le_add (pow_le_one₀ (norm_nonneg _) hw) le_rfl
          _ = 2 := by norm_num
      rw [norm_mul, norm_div, norm_one, Complex.norm_natCast]
      calc 1 / (K : ℝ) * ‖∑ k ∈ Finset.range K, w ^ k‖ ≤ 1 / (K : ℝ) * (2 / ‖w - 1‖) := by
            gcongr
        _ = (2 / ‖w - 1‖) / K := by ring
  exact squeeze_zero_norm hbound (tendsto_const_div_atTop_nhds_zero_nat _)

/-- **[P*, riesgo de nombres: `tendsto_tsum_of_dominated_convergence`, `tsum_sum`,
    `tsum_mul_left`, `tsum_mul_right`, `tsum_geometric_of_lt_one`, `sum_le_tsum`]
    EL RESIDUO DOMINANTE SE ANULA SI LA ÓRBITA ESTÁ ACOTADA.**  Si t_k = Σ_i c_i λ_i^k
    (`OrbitExpansion`), ‖t_k‖ ≤ M para toda k, y λ₀ tiene ‖λ₀‖ > 1 y módulo máximo
    (‖λ_i‖ ≤ ‖λ₀‖ para toda i), entonces Σ_{i : λ_i = λ₀} c_i = 0.
    Prueba: el promedio de Cesàro de t_k·λ₀^{−k} tiende a 0 (por la cota) y, término a término
    con convergencia dominada, tiende al residuo en λ₀. -/
theorem residue_vanishes_of_bounded {t : ℕ → ℂ} (E : OrbitExpansion t) (M : ℝ)
    (hM : ∀ k, ‖t k‖ ≤ M) (lam0 : ℂ) (h1 : 1 < ‖lam0‖) (hmax : ∀ i, ‖E.lam i‖ ≤ ‖lam0‖) :
    ∑' i, (if E.lam i = lam0 then E.c i else 0) = 0 := by
  have hl0 : 0 < ‖lam0‖ := lt_trans one_pos h1
  have h0 : lam0 ≠ 0 := norm_pos_iff.mp hl0
  have hratio : ∀ i, ‖E.lam i / lam0‖ ≤ 1 := by
    intro i; rw [norm_div, div_le_one hl0]; exact hmax i
  set S : ℕ → ℂ := fun K => (1 / (K : ℂ)) * ∑ k ∈ Finset.range K, t k * lam0⁻¹ ^ k with hS
  -- (A) S → 0, por la cota de la órbita
  have hA : Filter.Tendsto S Filter.atTop (nhds 0) := by
    set r := ‖lam0⁻¹‖ with hr
    have r0 : 0 ≤ r := norm_nonneg _
    have r1 : r < 1 := by rw [hr, norm_inv]; exact inv_lt_one_of_one_lt₀ h1
    have hM0 : 0 ≤ M := le_trans (norm_nonneg _) (hM 0)
    have hgeo : ∀ K : ℕ, ∑ k ∈ Finset.range K, r ^ k ≤ (1 - r)⁻¹ := by
      intro K
      rw [← tsum_geometric_of_lt_one r0 r1]
      exact (summable_geometric_of_lt_one r0 r1).sum_le_tsum _ (fun i _ => pow_nonneg r0 i)
    have hb : ∀ K : ℕ, ‖S K‖ ≤ (M * (1 - r)⁻¹) / K := by
      intro K
      simp only [hS]
      rcases Nat.eq_zero_or_pos K with hK | hK
      · subst hK; simp
      · have hKr : (0 : ℝ) < K := by exact_mod_cast hK
        have hsum : ‖∑ k ∈ Finset.range K, t k * lam0⁻¹ ^ k‖ ≤ M * (1 - r)⁻¹ := by
          calc ‖∑ k ∈ Finset.range K, t k * lam0⁻¹ ^ k‖
              ≤ ∑ k ∈ Finset.range K, ‖t k * lam0⁻¹ ^ k‖ := norm_sum_le _ _
            _ ≤ ∑ k ∈ Finset.range K, M * r ^ k := by
                apply Finset.sum_le_sum; intro k _
                rw [norm_mul, norm_pow]
                exact mul_le_mul_of_nonneg_right (hM k) (pow_nonneg r0 k)
            _ = M * ∑ k ∈ Finset.range K, r ^ k := by rw [Finset.mul_sum]
            _ ≤ M * (1 - r)⁻¹ := mul_le_mul_of_nonneg_left (hgeo K) hM0
        rw [norm_mul, norm_div, norm_one, Complex.norm_natCast]
        calc 1 / (K : ℝ) * ‖∑ k ∈ Finset.range K, t k * lam0⁻¹ ^ k‖
            ≤ 1 / (K : ℝ) * (M * (1 - r)⁻¹) := by gcongr
          _ = (M * (1 - r)⁻¹) / K := by ring
    exact squeeze_zero_norm hb (tendsto_const_div_atTop_nhds_zero_nat _)
  -- (B) S K = Σ_i c_i · cesaro(λ_i/λ₀, K)
  have hsumm : ∀ k : ℕ, Summable (fun i => E.c i * (E.lam i / lam0) ^ k) := by
    intro k
    refine Summable.of_norm_bounded E.hc (fun i => ?_)
    rw [norm_mul, norm_pow]
    calc ‖E.c i‖ * ‖E.lam i / lam0‖ ^ k ≤ ‖E.c i‖ * 1 :=
          mul_le_mul_of_nonneg_left (pow_le_one₀ (norm_nonneg _) (hratio i)) (norm_nonneg _)
      _ = ‖E.c i‖ := mul_one _
  have hB : ∀ K, S K = ∑' i, E.c i * cesaro (E.lam i / lam0) K := by
    intro K
    simp only [hS, cesaro]
    have e1 : ∀ k, t k * lam0⁻¹ ^ k = ∑' i, E.c i * (E.lam i / lam0) ^ k := by
      intro k
      rw [E.ht k, ← tsum_mul_right]
      congr 1; funext i
      rw [div_eq_mul_inv, mul_pow]; ring
    simp only [e1]
    rw [← Summable.tsum_finsetSum (fun k _ => hsumm k), ← tsum_mul_left]
    congr 1; funext i
    rw [← Finset.mul_sum]; ring
  -- (C) límites término a término
  have hC : ∀ i, Filter.Tendsto (fun K => E.c i * cesaro (E.lam i / lam0) K) Filter.atTop
      (nhds (if E.lam i = lam0 then E.c i else 0)) := by
    intro i
    by_cases h : E.lam i = lam0
    · rw [if_pos h]
      have : E.lam i / lam0 = 1 := by rw [h]; exact div_self h0
      rw [this]
      simpa using (cesaro_one_tendsto.const_mul (E.c i))
    · rw [if_neg h]
      have hne : E.lam i / lam0 ≠ 1 := by
        intro h'; apply h; rw [div_eq_one_iff_eq h0] at h'; exact h'
      simpa using ((cesaro_tendsto_zero _ (hratio i) hne).const_mul (E.c i))
  -- (D) convergencia dominada
  have hD : Filter.Tendsto (fun K => ∑' i, E.c i * cesaro (E.lam i / lam0) K) Filter.atTop
      (nhds (∑' i, if E.lam i = lam0 then E.c i else 0)) := by
    refine tendsto_tsum_of_dominated_convergence (bound := fun i => ‖E.c i‖) E.hc hC ?_
    refine Filter.Eventually.of_forall (fun K i => ?_)
    rw [norm_mul]
    calc ‖E.c i‖ * ‖cesaro (E.lam i / lam0) K‖ ≤ ‖E.c i‖ * 1 :=
          mul_le_mul_of_nonneg_left (cesaro_norm_le_one _ (hratio i) K) (norm_nonneg _)
      _ = ‖E.c i‖ := mul_one _
  have hA' : Filter.Tendsto (fun K => ∑' i, E.c i * cesaro (E.lam i / lam0) K) Filter.atTop
      (nhds 0) := by
    have hSeq : S = fun K => ∑' i, E.c i * cesaro (E.lam i / lam0) K := funext hB
    rw [hSeq] at hA; exact hA
  exact tendsto_nhds_unique hD hA'

/-- **[C + O] La entrada clásica en forma de residuo dominante, con una anchura a₀:** para cada
    cero fuera de la recta hay una expansión de la órbita con un λ₀ de módulo máximo > 1 y
    residuo no nulo.  Es clásica cuando el máximo de |Re ρ − ½| se alcanza (por ejemplo, si hay
    un número finito de ceros fuera de la recta con ese máximo) y a₀ está fuera de un conjunto
    numerable de anchuras; el caso general (máximo no alcanzado) queda abierto como enunciado. -/
def DominantResidue (O : OrbitData) (a₀ : ℝ) : Prop :=
  ∀ z : Chi5Zero, z.ρ.re ≠ 1 / 2 →
    ∃ (E : OrbitExpansion (fun k => (O.t a₀ k : ℂ))) (lam0 : ℂ), 1 < ‖lam0‖ ∧
      (∀ i, ‖E.lam i‖ ≤ ‖lam0‖) ∧ ∑' i, (if E.lam i = lam0 then E.c i else 0) ≠ 0

/-- **[P*] La recta desde (W4) con una anchura y el residuo dominante** (sin
    `OrbitDetectsOffLine`): la parte de la entrada clásica que es argumento queda demostrada. -/
theorem the_line_from_W4_dominant (p : ℝ) (hp : 1 < p) (a₀ : ℝ)
    (hW4 : W4Chi5 (chi5WeilOrbit p hp) {a₀})
    (hres : DominantResidue (chi5WeilOrbit p hp) a₀) :
    ∀ z : Chi5Zero, z.ρ.re = 1 / 2 := by
  intro z
  by_contra hne
  obtain ⟨E, lam0, h1, hmax, hres0⟩ := hres z hne
  apply hres0
  refine residue_vanishes_of_bounded E ((chi5WeilOrbit p hp).t a₀ 0) (fun k => ?_) lam0 h1 hmax
  rw [Complex.norm_real, Real.norm_eq_abs]
  exact hW4 a₀ (Set.mem_singleton a₀) k

/-! ## 7. Herglotz, en la forma que necesita la cadena: Toeplitz semidefinida ⇔ prerrealización

  Una prerrealización es un espacio con una forma bilineal simétrica semidefinida B, un operador
  V que la preserva y un vector g con t_k = B(g, V^k g).  Su completación separada es un espacio
  de Hilbert con V isométrico [C, construcción estándar]: es la «realización isométrica» del
  corpus.  Aquí: (i) la forma de Toeplitz de t, sobre las sucesiones de soporte finito; (ii)
  Toeplitz semidefinida ⇒ prerrealización (GNS, con el desplazamiento); (iii) prerrealización ⇒
  Toeplitz semidefinida; (iv) prerrealización ⇒ (W4); (v) realización isométrica ⇒
  prerrealización. -/

/-- La forma de Toeplitz de t sobre ℕ →₀ ℝ: B(e_j, e_k) = t_{|j−k|}. -/
noncomputable def toeplitzForm (t : ℕ → ℝ) : (ℕ →₀ ℝ) →ₗ[ℝ] (ℕ →₀ ℝ) →ₗ[ℝ] ℝ :=
  Finsupp.linearCombination ℝ (fun j => Finsupp.linearCombination ℝ (fun k => t (Nat.dist j k)))

theorem toeplitzForm_single (t : ℕ → ℝ) (j k : ℕ) (a b : ℝ) :
    toeplitzForm t (Finsupp.single j a) (Finsupp.single k b) = a * b * t (Nat.dist j k) := by
  simp only [toeplitzForm, Finsupp.linearCombination_single, LinearMap.smul_apply, smul_eq_mul]
  ring

/-- **[O, equivalente a W3 en la órbita para toda longitud] Toeplitz semidefinida.** -/
def ToeplitzPSD (t : ℕ → ℝ) : Prop := ∀ x : ℕ →₀ ℝ, 0 ≤ toeplitzForm t x x

/-- **Prerrealización** de la sucesión t. -/
def PreRealization (t : ℕ → ℝ) : Prop :=
  ∃ (E : Type) (_ : AddCommGroup E) (_ : Module ℝ E) (B : E →ₗ[ℝ] E →ₗ[ℝ] ℝ) (V : E →ₗ[ℝ] E)
    (g : E), (∀ x y, B x y = B y x) ∧ (∀ x, 0 ≤ B x x) ∧ (∀ x y, B (V x) (V y) = B x y) ∧
      ∀ k, t k = B g ((V ^ k) g)

/-- El desplazamiento en ℕ →₀ ℝ. -/
noncomputable def shiftFS : (ℕ →₀ ℝ) →ₗ[ℝ] (ℕ →₀ ℝ) := Finsupp.lmapDomain ℝ ℝ Nat.succ

theorem shiftFS_single (k : ℕ) (b : ℝ) : shiftFS (Finsupp.single k b) = Finsupp.single (k + 1) b := by
  simp [shiftFS, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]

theorem shiftFS_pow_single (k : ℕ) : (shiftFS ^ k) (Finsupp.single 0 (1 : ℝ)) = Finsupp.single k 1 := by
  induction k with
  | zero => simp
  | succ k ih => rw [pow_succ', mul_apply_eq_comp, ih, shiftFS_single]

/-- **[P*, riesgo: `Finsupp.lhom_ext`, `Nat.dist`] (ii) Toeplitz semidefinida ⇒ prerrealización**
    (GNS sobre las sucesiones de soporte finito, con el desplazamiento como Frobenius). -/
theorem prerealization_of_psd (t : ℕ → ℝ) (h : ToeplitzPSD t) : PreRealization t := by
  refine ⟨ℕ →₀ ℝ, inferInstance, inferInstance, toeplitzForm t, shiftFS, Finsupp.single 0 1,
    ?_, h, ?_, ?_⟩
  · -- simetría: basta en las bases
    intro x y
    have : toeplitzForm t = (toeplitzForm t).flip := by
      refine Finsupp.lhom_ext (fun j a => ?_)
      refine Finsupp.lhom_ext (fun k b => ?_)
      simp only [LinearMap.flip_apply, toeplitzForm_single, Nat.dist_comm j k]; ring
    conv_lhs => rw [this]
    rfl
  · -- invariancia bajo el desplazamiento
    intro x y
    have : (toeplitzForm t).compl₁₂ shiftFS shiftFS = toeplitzForm t := by
      refine Finsupp.lhom_ext (fun j a => ?_)
      refine Finsupp.lhom_ext (fun k b => ?_)
      simp only [LinearMap.compl₁₂_apply, shiftFS_single, toeplitzForm_single]
      congr 1
      simp [Nat.dist, Nat.succ_sub_succ]
    exact congrArg (fun F => F x y) this
  · intro k
    rw [shiftFS_pow_single, toeplitzForm_single]
    simp [Nat.dist]

/-- **[P*] (iii) Prerrealización ⇒ Toeplitz semidefinida.** -/
theorem psd_of_prerealization (t : ℕ → ℝ) (h : PreRealization t) : ToeplitzPSD t := by
  obtain ⟨E, _, _, B, V, g, hsym, hpos, hinv, ht⟩ := h
  -- B(V^j g, V^k g) = t_{|j−k|}
  have hshift : ∀ (n : ℕ) (x y : E), B ((V ^ n) x) ((V ^ n) y) = B x y := by
    intro n; induction n with
    | zero => intro x y; simp
    | succ n ih => intro x y; rw [pow_succ', mul_apply_eq_comp, mul_apply_eq_comp, hinv, ih]
  have hgram : ∀ j k : ℕ, B ((V ^ j) g) ((V ^ k) g) = t (Nat.dist j k) := by
    intro j k
    rcases le_total j k with hjk | hkj
    · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hjk
      rw [pow_add, mul_apply_eq_comp, hshift, ← ht d]
      congr 1; simp [Nat.dist]
    · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hkj
      rw [hsym, pow_add, mul_apply_eq_comp, hshift, ← ht d]
      congr 1; simp [Nat.dist]
  set Φ : (ℕ →₀ ℝ) →ₗ[ℝ] E := Finsupp.linearCombination ℝ (fun j => (V ^ j) g)
  have hcomp : toeplitzForm t = B.compl₁₂ Φ Φ := by
    refine Finsupp.lhom_ext (fun j a => ?_)
    refine Finsupp.lhom_ext (fun k b => ?_)
    simp only [LinearMap.compl₁₂_apply, toeplitzForm_single, Φ, Finsupp.linearCombination_single,
      map_smul, LinearMap.smul_apply, smul_eq_mul, hgram]
    ring
  intro x
  rw [hcomp, LinearMap.compl₁₂_apply]
  exact hpos _

/-- **[P*] (iv) Prerrealización ⇒ (W4):** |t_k| ≤ t₀ (con B(u ± v, u ± v) ≥ 0 y B(V^k g, V^k g) = t₀). -/
theorem abs_le_of_prerealization (t : ℕ → ℝ) (h : PreRealization t) (k : ℕ) : |t k| ≤ t 0 := by
  obtain ⟨E, _, _, B, V, g, hsym, hpos, hinv, ht⟩ := h
  have hshift : ∀ (n : ℕ) (x y : E), B ((V ^ n) x) ((V ^ n) y) = B x y := by
    intro n; induction n with
    | zero => intro x y; simp
    | succ n ih => intro x y; rw [pow_succ', mul_apply_eq_comp, mul_apply_eq_comp, hinv, ih]
  have huu : B g g = t 0 := by rw [ht 0]; simp
  have hvv : B ((V ^ k) g) ((V ^ k) g) = t 0 := by rw [hshift, huu]
  have huv : B g ((V ^ k) g) = t k := (ht k).symm
  have hp := hpos (g + (V ^ k) g)
  have hm := hpos (g - (V ^ k) g)
  simp only [map_add, map_sub, LinearMap.add_apply, LinearMap.sub_apply] at hp hm
  rw [hsym ((V ^ k) g) g] at hp hm
  rw [abs_le]; constructor <;> nlinarith [huu, hvv, huv]

/-- **[P*, riesgo: `bilinFormOfRealInner`, `LinearIsometry.mul_apply`] (v) Realización isométrica ⇒
    prerrealización.** -/
theorem prerealization_of_isometric (O : OrbitData) (a : ℝ) (h : IsometricRealization O {a}) :
    PreRealization (O.t a) := by
  obtain ⟨E, _, _, V, g, hg⟩ := h
  obtain ⟨h0, hk⟩ := hg a (Set.mem_singleton a)
  refine ⟨E, inferInstance, inferInstance, innerₗ E, V.toLinearMap, g a, ?_, ?_, ?_, ?_⟩
  · intro x y; simp [innerₗ_apply_apply, real_inner_comm]
  · intro x; simp [innerₗ_apply_apply]
  · intro x y; simp [innerₗ_apply_apply, LinearIsometry.inner_map_map]
  · intro k
    rw [hk k]
    simp only [innerₗ_apply_apply]
    congr 1
    induction k with
    | zero => simp
    | succ k ih =>
      rw [pow_succ' V k, LinearIsometry.coe_mul, Function.comp_apply, ih,
        pow_succ' V.toLinearMap k, mul_apply_eq_comp]
      rfl

end F1PaperSixtyWeil

