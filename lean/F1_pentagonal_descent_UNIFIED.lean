/-- **[P] `e₁² = 4c²`.**  La primera simétrica al cuadrado es el
    centro al cuadrado, por cuatro. -/
theorem e_one_sq_is_four_centre_sq (a b : ℝ) :
    (a + b) ^ 2 = 4 * (ctr a b) ^ 2 := by
  unfold ctr; ring

/-- **[P] `disc = 4r²`.**  El discriminante es el radio al cuadrado,
    por cuatro. -/
theorem disc_is_four_radius_sq_l818 (a b : ℝ) :
    (a + b) ^ 2 - 4 * (a * b) = 4 * (rad a b) ^ 2 := by
  unfold rad; ring

/-- **[P] LUEGO EL INTERCAMBIO DE §87 ES LA PERMUTACIÓN DE §77.**
    `e₁² ↔ disc` y `c ↔ r` son el mismo enunciado.

    **Ésta es la retracción E113 en forma de teorema.** -/
theorem swap_is_the_permutation (a b : ℝ) :
    ((a + b) ^ 2 = 4 * (ctr a b) ^ 2) ∧
    ((a + b) ^ 2 - 4 * (a * b) = 4 * (rad a b) ^ 2) ∧
    (ctr a (-b) = rad a b) ∧
    (rad a (-b) = ctr a b) := by
  refine ⟨e_one_sq_is_four_centre_sq a b, disc_is_four_radius_sq_l818 a b, ?_, ?_⟩
  · unfold ctr rad; ring
  · unfold ctr rad; ring

