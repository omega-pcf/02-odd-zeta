-- ╔══════════════════════════════════════════════════════════════════════════════╗
-- ║  §1  DECORACIÓN: CADA DÍGITO LLEVA UNA TRAZA DE G                          ║
-- ╚══════════════════════════════════════════════════════════════════════════════╝

/-- La decoración de un dígito: su imagen en la fibra del conductor vía el
    homomorfismo canónico de residuos, y la imagen de G sobre esa fibra. -/
structure DigitDecoration where
  fiber : ZMod 20
  gal_component : ZMod 2 × ZMod 2

/-- El functor de decoración: cada dígito de la representación en base b
    lleva consigo una traza de G, definida por la composición residuo → G. -/
noncomputable def digit_decoration (b : ℕ) (a : ZMod b) : DigitDecoration where
  fiber := (a.val : ZMod 20)
  gal_component := G ((a.val : ZMod 20))

/-- Los ocho dígitos de base 10 que son coprimos con 10. -/
def base10_units : Finset (ZMod 10) := {1, 3, 7, 9}

/-- Cada dígito unitario de base 10 mapea a un elemento de Z₂₀*. -/
theorem base10_units_in_Z20Star (a : ZMod 10) (ha : a ∈ base10_units) :
    (a.val : ZMod 20) ∈ ZtwentyStar := by
  simp only [base10_units, Finset.mem_insert, Finset.mem_singleton] at ha
  rcases ha with rfl | rfl | rfl | rfl <;> decide

-- ╔══════════════════════════════════════════════════════════════════════════════╗
-- ║  §2  TEOREMAS PRINCIPALES                                                    ║
-- ╚══════════════════════════════════════════════════════════════════════════════╝

/-- **COMPATIBILIDAD: la decoración reproduce G. -/
theorem decoration_matches_G :
    ∀ a : ZMod 10, a ∈ base10_units →
      (digit_decoration 10 a).gal_component = G ((a.val : ZMod 20)) := by
  intro a ha
  unfold digit_decoration
  simp only [base10_units, Finset.mem_insert, Finset.mem_singleton] at ha
  rcases ha with rfl | rfl | rfl | rfl <;> decide

/-- **VISIBILIDAD: ambas componentes de G son reveladas. -/
theorem both_components_visible :
    (∃ a : ZMod 10, a ∈ base10_units ∧
      (digit_decoration 10 a).gal_component.1 = 0) ∧
    (∃ a : ZMod 10, a ∈ base10_units ∧
      (digit_decoration 10 a).gal_component.1 = 1) ∧
    (∃ a : ZMod 10, a ∈ base10_units ∧
      (digit_decoration 10 a).gal_component.2 = 0) ∧
    (∃ a : ZMod 10, a ∈ base10_units ∧
      (digit_decoration 10 a).gal_component.2 = 1) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact ⟨1, by decide, by unfold digit_decoration DigitDecoration.gal_component; decide⟩
  · exact ⟨3, by decide, by unfold digit_decoration DigitDecoration.gal_component; decide⟩
  · exact ⟨1, by decide, by unfold digit_decoration DigitDecoration.gal_component; decide⟩
  · exact ⟨3, by decide, by unfold digit_decoration DigitDecoration.gal_component; decide⟩

/-- **IMAGEN DE LA DECORACIÓN.**
    La imagen de la decoración en base 10 es exactamente la fibra diagonal
    {(0,0), (1,1)} de Z₂×Z₂: las fibras donde χ₄ y χ₅ coinciden.
    Las fibras {(1,0), (0,1)} no son alcanzables por ningún dígito de base 10.
    En base 20, la decoración es biyectiva sobre las 4 fibras. -/
theorem decoration_image_is_diagonal :
    (∀ a ∈ base10_units,
      (digit_decoration 10 a).gal_component = (0, 0) ∨
      (digit_decoration 10 a).gal_component = (1, 1)) ∧
    (∃ a ∈ base10_units, (digit_decoration 10 a).gal_component = (0, 0)) ∧
    (∃ a ∈ base10_units, (digit_decoration 10 a).gal_component = (1, 1)) := by
  constructor
  · intro a ha
    simp only [base10_units, Finset.mem_insert, Finset.mem_singleton] at ha
    rcases ha with rfl | rfl | rfl | rfl <;>
      unfold digit_decoration DigitDecoration.gal_component <;> decide
  · refine ⟨?_, ?_⟩
    · use ⟨1, by decide⟩
      exact ⟨Finset.mem_insert.mpr (Or.inl rfl),
        by unfold digit_decoration DigitDecoration.gal_component; decide⟩
    · use ⟨3, by decide⟩
      exact ⟨Finset.mem_insert.mpr (Or.inr (Finset.mem_insert.mpr (Or.inl rfl))),
        by unfold digit_decoration DigitDecoration.gal_component; decide⟩

-- ╔══════════════════════════════════════════════════════════════════════════════╗
-- ║  §3  BASE 20: DECORACIÓN BIYECTIVA                                          ║
-- ╚══════════════════════════════════════════════════════════════════════════════╝

/-- **BASE 20: BIYECTIVIDAD. -/
theorem base20_bijection :
    ∀ a : ZMod 20, a ∈ ZtwentyStar →
      (digit_decoration 20 a).gal_component = G a := by
  intro a ha
  unfold digit_decoration DigitDecoration.gal_component
  simp only [ZtwentyStar, Finset.mem_insert, Finset.mem_singleton] at ha
  rcases ha with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;> decide

/-- **BASE 20: LAS FIBRAS SE CUBREN EXACTAMENTE. -/
theorem base20_covers_all_fibers :
    (∀ g : ZMod 2 × ZMod 2, ∃ a : ZMod 20, a ∈ ZtwentyStar ∧ G a = g) ∧
    (∀ a : ZMod 20, a ∈ ZtwentyStar →
      (digit_decoration 20 a).gal_component = G a) := by
  exact ⟨G_surj, base20_bijection⟩

-- ╔══════════════════════════════════════════════════════════════════════════════╗
-- ║  §4  LA OBSTRUCCIÓN: POR QUÉ BASE 10 SOLO VE LA DIAGONAL                  ║
-- ╚══════════════════════════════════════════════════════════════════════════════╝

/-- **LA OBSTRUCCIÓN ES ESTRUCTURAL (parte 1):** los dígitos unitarios
    de base 10 residen en la fibra {1,3,7,9} de Z₂₀*. -/
theorem base10_residue_class :
    ∀ a : ZMod 10, a ∈ base10_units →
      (a.val : ZMod 20) ∈ ({1, 3, 7, 9} : Finset (ZMod 20)) := by
  intro a ha
  simp only [base10_units, Finset.mem_insert, Finset.mem_singleton] at ha
  rcases ha with rfl | rfl | rfl | rfl <;> decide

/-- **LA OBSTRUCCIÓN ES ESTRUCTURAL (parte 2):** en la fibra 9 mod 20,
    χ₄ y χ₅ siempre coinciden: χ₄(1)=χ₅(1)=0, χ₄(3)=χ₅(3)=1,
    χ₄(7)=χ₅(7)=1, χ₄(9)=χ₅(9)=0.  Esto es porque 9 es cuadrado
    perfecto mod 4 (9≡1) y mod 5 (9≡4), por lo que ambos caracteres
    dan +1 (= 0 en Z₂). -/
theorem diagonal_from_residue :
    ∀ a : ZMod 20, a ∈ ({1, 3, 7, 9} : Finset (ZMod 20)) →
      (G a).1 = (G a).2 := by
  intro a ha
  simp only [Finset.mem_insert, Finset.mem_singleton] at ha
  rcases ha with rfl | rfl | rfl | rfl <;> unfold G <;> decide

/-- **LA OBSTRUCCIÓN ES ESTRUCTURAL (parte 3):** la fibra 9 mod 20
    es exactamente la intersección de {a ∈ Z₂₀* : a ≡ 9 (mod 10)}
    con Z₂₀*.  Los otros representantes (11,13,17,19) tienen
    χ₄ ≠ χ₅, pero no son alcanzables desde base 10. -/
theorem off_diagonal_inaccessible :
    ¬ ∃ a : ZMod 10, a ∈ base10_units ∧
      (digit_decoration 10 a).gal_component = (1, 0) := by
  intro ⟨a, ha, hval⟩
  unfold digit_decoration DigitDecoration.gal_component at hval
  simp only [base10_units, Finset.mem_insert, Finset.mem_singleton] at ha
  rcases ha with rfl | rfl | rfl | rfl <;> revert hval <;> decide

/-- **LA OBSTRUCCIÓN ES ESTRUCTURAL (parte 4):** análogo para (0,1). -/
theorem off_diagonal_inaccessible' :
    ¬ ∃ a : ZMod 10, a ∈ base10_units ∧
      (digit_decoration 10 a).gal_component = (0, 1) := by
  intro ⟨a, ha, hval⟩
  unfold digit_decoration DigitDecoration.gal_component at hval
  simp only [base10_units, Finset.mem_insert, Finset.mem_singleton] at ha
  rcases ha with rfl | rfl | rfl | rfl <;> revert hval <;> decide

/-- **LA OBSTRUCCIÓN COMO TEOREMA:** la imagen de base 10 está
    exactamente en la diagonal de Z₂×Z₂, y las dos fibras no
    diagonales son inaccesibles.  Este es el resultado que Gemini
    llama "principio de obstrucción geométrica". -/
theorem obstruction_is_structural :
    (∀ a ∈ base10_units,
      (digit_decoration 10 a).gal_component = (0, 0) ∨
      (digit_decoration 10 a).gal_component = (1, 1)) ∧
    (¬ ∃ a ∈ base10_units,
      (digit_decoration 10 a).gal_component = (1, 0)) ∧
    (¬ ∃ a ∈ base10_units,
      (digit_decoration 10 a).gal_component = (0, 1)) := by
  exact ⟨decoration_image_is_diagonal.1,
         off_diagonal_inaccessible,
         off_diagonal_inaccessible'⟩

-- ╔══════════════════════════════════════════════════════════════════════════════╗
-- ║  §5  INSCRIPCIÓN: φ COMO DÍGITO                                            ║
-- ╚══════════════════════════════════════════════════════════════════════════════╝

/-- **LA INSCRIPCIÓN ES UN DÍGITO. -/
theorem inscription_is_digit (a : ZMod 10) (ha : a ∈ base10_units) :
    ∃ g : ZMod 2 × ZMod 2, g = (digit_decoration 10 a).gal_component ∧
      (g.1 = 0 ∨ g.1 = 1) ∧ (g.2 = 0 ∨ g.2 = 1) := by
  refine ⟨_, rfl, ?_, ?_⟩ <;>
    unfold digit_decoration <;>
    simp only [base10_units, Finset.mem_insert, Finset.mem_singleton] at ha <;>
    rcases ha with rfl | rfl | rfl | rfl <;> decide

-- ╔══════════════════════════════════════════════════════════════════════════════╗
-- ║  §6  BASE ÁUREA: FIBONACCI Y DECORACIÓN PENTAGONAL                         ║
-- ╚══════════════════════════════════════════════════════════════════════════════╝

/-- Valores de Fibonacci para los primos de prueba. -/
theorem fib_values_ext :
    fib 0 = 0 ∧ fib 1 = 1 ∧ fib 2 = 1 ∧ fib 3 = 2 ∧
    fib 4 = 3 ∧ fib 5 = 5 ∧ fib 6 = 8 ∧ fib 7 = 13 :=
  ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

/-- **FIBONACCI Y EL CRITERIO DE ESCISIÓN.**  Para los primos de
    prueba, χ₅(p) ≡ F_p (mod p).  La base áurea clasifica primos
    sin residuo mod b: la clasificación viene del Criterio de
    Fibonacci, no del Teorema del Resto Chino. -/
theorem fib_chi5_connection :
    chi5_Z (3 : ZMod 5) = -1 ∧ fib 3 % 3 = 2 ∧
    chi5_Z (7 : ZMod 5) = -1 ∧ fib 7 % 7 = 6 ∧
    chi5_Z (11 : ZMod 5) = 1 ∧ fib 11 % 11 = 1 := by
  refine ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩

/-- **LA BASE ÁUREA VE LAS CUATRO FIBRAS.**  Los primos split
    e inert cubren ambas componentes de G. -/
theorem golden_base_covers_all_fibers :
    chi5_Z (11 : ZMod 5) = 1 ∧
    chi5_Z (19 : ZMod 5) = 1 ∧
    chi5_Z (3 : ZMod 5) = -1 ∧
    chi5_Z (7 : ZMod 5) = -1 :=
  ⟨rfl, rfl, rfl, rfl⟩

-- ╔══════════════════════════════════════════════════════════════════════════════╗
-- ║  §7  OBSTRUCCIÓN GENERAL: CONDUCTORES ARBITRARIOS                           ║
-- ╚══════════════════════════════════════════════════════════════════════════════╝

/-- **OBSTRUCCIÓN BASE 10: gcd(10, 20) = 10 > 1.**  La obstrucción
    diagonal es consecuencia de que la base comparte factores con
    el conductor. -/
theorem base10_obstruction_concrete :
    Nat.gcd 10 20 = 10 ∧ (10 : ℕ) > 1 :=
  ⟨rfl, by norm_num⟩

-- ╔══════════════════════════════════════════════════════════════════════════════╗
-- ║  §8  DESCENSO: BASE 10 COMO FUNCTOR DE OLVIDO                                ║
-- ╚══════════════════════════════════════════════════════════════════════════════╝

/-- **DESCENSO: la proyección Z₂₀* → Z₁₀* colapsa sobre la fibra
    diagonal.  Los 8 elementos de Z₂₀* se proyectan a residuos
    {1,3,7,9} mod 10. -/
theorem descent_projection :
    ∀ a : ZMod 20, a ∈ ZtwentyStar →
      (a.val : ℕ) % 10 = 1 ∨ (a.val : ℕ) % 10 = 3 ∨
      (a.val : ℕ) % 10 = 7 ∨ (a.val : ℕ) % 10 = 9 := by
  intro a ha
  simp only [ZtwentyStar, Finset.mem_insert, Finset.mem_singleton] at ha
  rcases ha with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;> decide

/-- **DESCENSO: la fibra diagonal es la imagen de Z₁₀* en Z₂₀*. -/
theorem descent_fiber_is_diagonal :
    ∀ a : ZMod 10, a ∈ ({1, 3, 7, 9} : Finset (ZMod 10)) →
      (a.val : ℕ) % 20 = 1 ∨ (a.val : ℕ) % 20 = 3 ∨
      (a.val : ℕ) % 20 = 7 ∨ (a.val : ℕ) % 20 = 9 := by
  intro a ha
  simp only [Finset.mem_insert, Finset.mem_singleton] at ha
  rcases ha with rfl|rfl|rfl|rfl <;> decide

/-- **DESCENSO: los 4 elementos de la fibra diagonal son
    alcanzables desde base 10. -/
theorem descent_fiber_complete :
    ((1 : ZMod 20).val % 10 = 1) ∧
    ((3 : ZMod 20).val % 10 = 3) ∧
    ((7 : ZMod 20).val % 10 = 7) ∧
    ((9 : ZMod 20).val % 10 = 9) :=
  ⟨by decide, by decide, by decide, by decide⟩

-- ╔══════════════════════════════════════════════════════════════════════════════╗
-- ║  §9  SÍNTESIS: EL TEOREMA FUNDAMENTAL PENTAGONAL DE LA NUMERACIÓN            ║
-- ╚══════════════════════════════════════════════════════════════════════════════╝

/-- **TEOREMA FUNDAMENTAL PENTAGONAL DE LA NUMERACIÓN. -/
theorem fundamental_pentagonal_numeration :
    -- (i) Functor de decoración bien definido
    (∀ b a : _, digit_decoration b a = ⟨(a.val : ZMod 20), G ((a.val : ZMod 20))⟩) ∧
    -- (ii) Base 20: biyectividad
    (∀ a : ZMod 20, a ∈ ZtwentyStar →
      (digit_decoration 20 a).gal_component = G a) ∧
    -- (iii) Ambas componentes visibles en base 10
    (∃ a ∈ base10_units, (digit_decoration 10 a).gal_component.1 = 0) ∧
    (∃ a ∈ base10_units, (digit_decoration 10 a).gal_component.1 = 1) ∧
    (∃ a ∈ base10_units, (digit_decoration 10 a).gal_component.2 = 0) ∧
    (∃ a ∈ base10_units, (digit_decoration 10 a).gal_component.2 = 1) ∧
    -- (iv) Imagen = diagonal {(0,0), (1,1)}
    (∀ a ∈ base10_units,
      (digit_decoration 10 a).gal_component = (0, 0) ∨
      (digit_decoration 10 a).gal_component = (1, 1)) ∧
    -- (v) Las fibras de G se cubren
    (∀ g : ZMod 2 × ZMod 2, ∃ a : ZMod 20, a ∈ ZtwentyStar ∧ G a = g) := by
  refine ⟨?_, base20_bijection, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro b a; rfl
  · exact ⟨1, by decide, by unfold digit_decoration DigitDecoration.gal_component; decide⟩
  · exact ⟨3, by decide, by unfold digit_decoration DigitDecoration.gal_component; decide⟩
  · exact ⟨1, by decide, by unfold digit_decoration DigitDecoration.gal_component; decide⟩
  · exact ⟨3, by decide, by unfold digit_decoration DigitDecoration.gal_component; decide⟩
  · exact decoration_image_is_diagonal.1
  · exact G_surj



