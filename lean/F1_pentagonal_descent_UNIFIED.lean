  constructor
  · intro hd
    apply h.mp
    have hge : 2 ≤ e1P r := trace_ge_two r hr
    unfold e1P at hge
    unfold discP e1P at hd
    nlinarith [hd, hge]
  · intro h1
    rw [h1]
    unfold discP e1P; norm_num

