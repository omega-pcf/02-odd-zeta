theorem phi_coordinate_forces_small_height (ρ : ℂ) (hρ : ρ ≠ 0)
    (hd : ρ.re ^ 2 + ρ.im ^ 2 ≠ 0) (hphi : zeroCoord ρ = (φ : ℝ))
    (h0 : 0 < ρ.re) :
    (φ : ℝ) * ρ.im ^ 2 < 1 := by
  have hid : 1 - 2 * ρ.re = (φ : ℝ) * (ρ.re ^ 2 + ρ.im ^ 2) := by
    have hdef := liMap_sq_defect ρ hρ
    have hz : Complex.abs (liMap ρ) = (φ : ℝ) := by exact hphi
    rw [hz] at hdef
    have hns : ρ.re ^ 2 + ρ.im ^ 2 ≠ 0 := by nlinarith [Complex.sq_abs ρ]
    field_simp [hns] at hdef
    nlinarith [hdef, Complex.sq_abs ρ, phi_sq]
  nlinarith [Complex.sq_abs ρ, h0]

theorem phi_coordinate_incompatible_with_NoLowZeros (ρ : ℂ) (hρ : ρ ≠ 0)
    (hd : ρ.re ^ 2 + ρ.im ^ 2 ≠ 0) (hphi : zeroCoord ρ = (φ : ℝ))
    (h0 : 0 < ρ.re) (hγ : 2 ≤ |ρ.im|) : False := by
  have hs := phi_coordinate_forces_small_height ρ hρ hd hphi h0
  have h4 : (4:ℝ) ≤ ρ.im ^ 2 := by
    have hsq : |ρ.im| ^ 2 = ρ.im ^ 2 := _root_.sq_abs ρ.im
    have hpow : (2:ℝ) ^ 2 ≤ |ρ.im| ^ 2 :=
      pow_le_pow_left₀ (by norm_num) hγ 2
    rw [hsq, show (2:ℝ) ^ 2 = 4 by norm_num] at hpow
    exact hpow
  have h1 : (1.61 : ℝ) < (φ : ℝ) := by
    have h5 : (2.23 : ℝ) < Real.sqrt 5 := by
      nlinarith [Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 5), Real.sqrt_nonneg 5]
    unfold φ; linarith
  nlinarith [hs, h4, h1]

