theorem the_hypothesis_is_membership_in_the_monoid (r : ℝ) (hr : 0 < r) :
    (∃ k : ℤ, r = (φ : ℝ) ^ k) ↔ IsMonomial r := Iff.rfl

theorem the_structural_side_is_the_monoid (r : ℝ) (hr : 0 < r)
    (hle : discP r ≤ 1/12) :
    IsMonomial r ↔ r = 1 :=
  monomial_iff_one_under_confinement r hr hle

theorem structure_to_zero_in_one_theorem (z : Chi5Zero)
    (hle : discP (zeroCoord z.ρ) ≤ 1/12) (hpos : 0 < zeroCoord z.ρ)
    (hmon : IsMonomial (zeroCoord z.ρ)) :
    z.ρ.re = 1/2 := by
  have h1 : zeroCoord z.ρ = 1 :=
    (monomial_iff_one_under_confinement (zeroCoord z.ρ) hpos hle).mp hmon
  exact (coord_eq_one_iff_re_half z.ρ z.in_strip_pos).mp h1

theorem the_monoid_is_the_F1_object (p q : ℕ) (n : ℤ) :
    (X_PCF.psi p (X_PCF.psi q n) = X_PCF.psi (p * q) n) ∧
    (IsMonomial (1 : ℝ)) ∧
    (∀ x y : ℝ, IsMonomial x → IsMonomial y → IsMonomial (x * y)) ∧
    (Function.Injective (fun k : ℤ => (φ : ℝ) ^ k)) :=
  ⟨frobenius_commutes p q n, isMonomial_one,
   fun _ _ hx hy => isMonomial_mul hx hy, phi_zpow_injective⟩

theorem the_direction_is_structure_to_zero (z : Chi5Zero) (p q : ℕ) (n : ℤ)
    (hle : discP (zeroCoord z.ρ) ≤ 1/12) (hpos : 0 < zeroCoord z.ρ)
    (hmon : IsMonomial (zeroCoord z.ρ)) :
    -- hipótesis ESTRUCTURALES: el monoide y su Frobenius
    ((X_PCF.psi p (X_PCF.psi q n) = X_PCF.psi (p * q) n) ∧
     (IsMonomial (1 : ℝ)) ∧
     ((φ : ℝ) ^ ((p : ℤ) * n) = ((φ : ℝ) ^ n) ^ p)) ∧
    -- conclusión SOBRE EL CERO
    (z.ρ.re = 1/2) :=
  ⟨⟨frobenius_commutes p q n, isMonomial_one, psi_is_exact_power p n⟩,
   structure_to_zero_in_one_theorem z hle hpos hmon⟩

theorem descent_data_is_the_lambda_structure (p q : ℕ) (m n : ℤ) :
    ((X_PCF.psi p (X_PCF.psi q n) = X_PCF.psi (p * q) n) ∧
    ((φ : ℝ) ^ ((p : ℤ) * n) = ((φ : ℝ) ^ n) ^ p) ∧
    ((φ : ℝ) ^ ((p : ℤ) * (m + n))
       = (φ : ℝ) ^ ((p : ℤ) * m) * (φ : ℝ) ^ ((p : ℤ) * n)) ∧
    ((φ : ℝ) ^ ((p : ℤ) * (-n)) = ((φ : ℝ) ^ ((p : ℤ) * n))⁻¹)) :=
  ⟨frobenius_commutes p q n, psi_is_exact_power p n,
   psi_multiplicative_on_the_monoid p m n, psi_respects_inverses p n⟩

theorem defined_over_F1_is_membership (r : ℝ) :
    IsMonomial r ↔ ∃ k : ℤ, r = (φ : ℝ) ^ k := Iff.rfl

theorem only_the_unit_survives_the_confinement (r : ℝ) (hr : 0 < r)
    (hle : discP r ≤ 1/12) :
    IsMonomial r ↔ r = 1 :=
