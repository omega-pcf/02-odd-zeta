/-! ### El parámetro `c(n)` del operador

Las nueve declaraciones que `PCF_unificado.lean` tomaba de
`PCF_OperatorConvergence.lean`, escritas aquí para que el módulo no dependa de
un fichero sin verificar.

`CW6_complete_v2.lean` —verificado— tiene la **misma fórmula** parametrizada:
`c_spectral α₀ β₀ n = (σ_PCF + μ_PCF) + α₀ * gSq β₀ n`, que con
`σ_PCF = 3/2`, `μ_PCF = 1/2` y `gSq β₀ n = (1 + β₀·log n)⁻¹` da
`2 + α₀/(1 + β₀·log n)`.  Aquí se fija `α₀` y `β₀`, que es la forma que el
módulo usa.

**Si se importa CW6, hay colisión en `c_spectral`.** Con este bloque, CW6 deja
de hacer falta para el operador. -/

/-- `α₀ = σ − μ/20`, el parámetro que viene del conductor. -/
def α₀ : ℝ := 59 / 40

/-- `β₀ = 1/|Z₂₀*| = ápice/|im G|`, el que viene del descenso de Galois. -/
def β₀ : ℝ := 1 / 8

theorem alpha0_pos : 0 < α₀ := by unfold α₀; norm_num

theorem beta0_pos : 0 < β₀ := by unfold β₀; norm_num

theorem denom_pos {n : ℝ} (hn : 1 ≤ n) : 0 < 1 + β₀ * Real.log n := by
  have h_log : 0 ≤ Real.log n := Real.log_nonneg hn
  have h_beta : 0 ≤ β₀ * Real.log n := mul_nonneg (le_of_lt beta0_pos) h_log
  linarith

-- `c_spectral` eliminado: ya existe en un fichero compilado.
/-- (2026-09-06, Ola 4) `σ_PCF`/`μ_PCF` de `CW6_complete_v2` (no importado):
    defs locales con los mismos valores. -/
noncomputable def σ_PCF : ℝ := 3/2
noncomputable def μ_PCF : ℝ := 1/2

/-- (2026-09-06, Ola 4) `sigma_plus_mu` de `CW6_complete_v2` (no importado):
    identidad local equivalente.
    (2026-09-08, Ola B4x) ROOT-FIX: movido DESPUÉS de las defs σ_PCF/μ_PCF; antes
    el enunciado elidía los literales bajo autoImplicit (`?a + ?b = 2`) y quedaba
    inaplicable en ~7 sitios downstream. -/
theorem sigma_plus_mu : σ_PCF + μ_PCF = 2 := by unfold σ_PCF μ_PCF; norm_num

/-- (2026-09-06, Ola 4) STATEMENT-FIX: `c_spectral` vive en
    `PCF_OperatorConvergence` (no importado por este archivo, y colisiona
    con CW6); se restaura local con su def original. -/
noncomputable def c_spectral (n : ℝ) : ℝ := 2 + α₀ / (1 + β₀ * Real.log n)

theorem c_gt_two {n : ℝ} (hn : 1 ≤ n) : 2 < c_spectral n := by
  unfold c_spectral
  have h_denom := denom_pos hn
  have h_frac : 0 < α₀ / (1 + β₀ * Real.log n) := div_pos alpha0_pos h_denom
  linarith

theorem c_bounded_above {n : ℝ} (hn : 1 ≤ n) : c_spectral n ≤ 2 + α₀ := by
  unfold c_spectral
  have h_denom := denom_pos hn
  have h1 : 1 ≤ 1 + β₀ * Real.log n := by
    have : 0 ≤ β₀ * Real.log n := mul_nonneg (le_of_lt beta0_pos) (Real.log_nonneg hn)
    linarith
  have h2 : α₀ / (1 + β₀ * Real.log n) ≤ α₀ / 1 :=
    div_le_div_of_nonneg_left alpha0_pos.le (by norm_num) h1
  simp at h2
  linarith

/-- La tasa, en forma cerrada: `c(n) − 2 = α₀/(1 + β₀ log n)`. -/
theorem c_minus_two_exact (n : ℝ) :
    c_spectral n - 2 = α₀ / (1 + β₀ * Real.log n) := by
  unfold c_spectral; ring

def bias_factor_I (n : ℝ) : ℝ := c_spectral n / 2

theorem bias_factor_I_gt_one {n : ℝ} (hn : 1 ≤ n) : 1 < bias_factor_I n := by
  unfold bias_factor_I
  linarith [c_gt_two hn]


theorem the_operator_exists_in_lean (n : ℝ) (hn : 1 ≤ n) :
    (2 < c_spectral n) ∧ (c_spectral n ≤ 2 + α₀) ∧ (σ_PCF + μ_PCF = 2) :=
  ⟨c_gt_two hn, c_bounded_above hn, sigma_plus_mu⟩

theorem the_operator_is_diagonal_in_its_own_basis (n : ℝ) :
    c_spectral n = 2 + α₀ / (1 + β₀ * Real.log n) := rfl

theorem the_operator_converges (n : ℝ) (hn : Real.exp 1 ≤ n) :
    c_spectral n - 2 = α₀ / (1 + β₀ * Real.log n) := by
  unfold c_spectral
  ring

theorem the_bias_factors_are_defined (n : ℝ) (hn : 1 ≤ n) :
    (bias_factor_I n = c_spectral n / 2) ∧ (1 < bias_factor_I n) :=
