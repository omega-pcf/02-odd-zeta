section ObservablesDelNivelBlock

/-
ObservablesDelNivel.lean — Sprint 104. Lo que un operador del nivel no separa, y el par que sí separa.
Sin compilar [P*]. Álgebra en un anillo cualquiera y en ℂ.
-/

namespace ObservablesDelNivel

/-- Si `U` conmuta con `H`, conmuta con toda combinación entera de potencias de `H`
(el álgebra generada por `H`). -/
theorem commute_poly {A : Type*} [Ring A] (U H : A) (h : Commute U H) (s : Finset ℕ) (c : ℕ → ℤ) :
    Commute U (∑ n ∈ s, (c n : A) * H ^ n) :=
  Commute.sum_right _ _ _ fun n _ => ((Int.cast_commute (c n) U).symm).mul_right (h.pow_right n)

/-- Relación de Weyl: si `D * X = q • (X * D)` con `D` invertible, entonces `D` y `X` no conmutan cuando
`q ≠ 1` y `X * D ≠ 0`. -/
theorem weyl_not_commute {A : Type*} [Ring A] [Algebra ℂ A] (D X : A) (q : ℂ) (hq : q ≠ 1)
    (hrel : D * X = q • (X * D)) (hne : X * D ≠ 0) : ¬ Commute D X := by
  intro hc
  have h1 : X * D = q • (X * D) := by rw [← hrel]; exact hc.eq.symm
  have h2 : (1 - q) • (X * D) = 0 := by rw [sub_smul, one_smul, ← h1, sub_self]
  rcases smul_eq_zero.mp h2 with h3 | h3
  · exact hq (by linear_combination -h3)
  · exact hne h3

/-- La raíz cúbica primitiva de la unidad no es real: el operador de color `½ diag(1, ζ₃, ζ₃²)` no es autoadjunto. -/
theorem zeta3_not_real : (Complex.exp (2 * Real.pi * Complex.I / 3)).im ≠ 0 := by
  have : (Complex.exp (2 * Real.pi * Complex.I / 3)).im = Real.sin (2 * Real.pi / 3) := by
    rw [show (2 * Real.pi * Complex.I / 3 : ℂ) = ((2 * Real.pi / 3 : ℝ) : ℂ) * Complex.I by push_cast; ring]
    rw [Complex.exp_ofReal_mul_I_im]
  rw [this]
  apply ne_of_gt
  apply Real.sin_pos_of_pos_of_lt_pi <;> nlinarith [Real.pi_pos]

end ObservablesDelNivel

end ObservablesDelNivelBlock

