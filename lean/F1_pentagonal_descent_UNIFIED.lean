theorem off_line_defeats_spacing (Z : Set ℂ) (hc : ClosedUnderMate Z)
    (ρ : ℂ) (hρ : ρ ∈ Z) (hδ : ρ.re ≠ 1/2) (m : ℝ) (hm : 0 < m) :
    ∃ a ∈ Z, ∃ b ∈ Z, a ≠ b ∧ a.im = b.im := by
  have hm' : (0:ℝ) ≤ m := le_of_lt hm
  have him : (kmate ρ).im = ρ.im := kmate_same_ordinate ρ
  refine ⟨ρ, hρ, kmate ρ, hc ρ hρ,
    fun h => hδ ((kmate_fixed_iff ρ).mp h.symm), ?_⟩
  linarith

theorem the_corrected_link_six (ρ : ℂ) (r : ℝ) (hr : 0 < r) (hγ : ρ.im ≠ 0) :
    ((1 - ρ).im = -ρ.im) ∧
    ((1 - (starRingEnd ℂ) ρ).im = ρ.im) ∧
    ((1 - ρ).im ≠ (1 - (starRingEnd ℂ) ρ).im) ∧
