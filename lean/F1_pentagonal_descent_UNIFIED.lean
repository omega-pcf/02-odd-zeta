/- ═══════════════════════════════════════════════════════════════════════════
   §1  φ, λ Y LA TORRE
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- La razón áurea. -/
def phi : ℝ := (1 + Real.sqrt 5) / 2

theorem phi_sq : phi ^ 2 = phi + 1 := by
  unfold phi
  have h5 := Real.sq_sqrt (show (0:ℝ) ≤ 5 by norm_num)
  linear_combination h5 / 4

theorem phi_pos : 0 < phi := by
  unfold phi; positivity

theorem one_lt_phi : 1 < phi := by
  unfold phi
  have h : (1:ℝ) < Real.sqrt 5 := by
    rw [show (1:ℝ) = Real.sqrt 1 by simp]
    exact Real.sqrt_lt_sqrt (by norm_num) (by norm_num)
  linarith

theorem log_phi_ne_zero : Real.log phi ≠ 0 :=
  ne_of_gt (Real.log_pos one_lt_phi)

/-- λ = log 2 / log φ: la posición del 2 en la torre de φ. -/
def lam : ℝ := Real.log 2 / Real.log phi

/-- φ^λ = 2. -/
theorem phi_rpow_lam : phi ^ lam = 2 := by
  unfold lam
  rw [Real.rpow_def_of_pos phi_pos]
  have hmul : Real.log phi * (Real.log 2 / Real.log phi) = Real.log 2 := by
    first
      | (field_simp [log_phi_ne_zero]; try exact div_self log_phi_ne_zero)
      | ((field_simp [log_phi_ne_zero]; try exact div_self log_phi_ne_zero); ring)
      | exact mul_div_cancel₀ _ log_phi_ne_zero
  rw [hmul, Real.exp_log (by norm_num)]

/-- **φ^{−λ} = ½**: el módulo del operador Ω̂. -/
theorem phi_rpow_neg_lam : phi ^ (-lam) = 1 / 2 := by
  rw [Real.rpow_neg phi_pos.le, phi_rpow_lam]; norm_num

/-- **La recursión de la torre:** φ^{k+2} = φ^{k+1} + φ^k. -/
theorem tower_recursion (k : ℕ) : phi ^ (k + 2) = phi ^ (k + 1) + phi ^ k := by
  calc phi ^ (k + 2) = phi ^ k * phi ^ 2 := by ring
    _ = phi ^ k * (phi + 1) := by rw [phi_sq]
    _ = phi ^ (k + 1) + phi ^ k := by ring

/- ═══════════════════════════════════════════════════════════════════════════
   §2  LA CELDA EN COORDENADAS DE FOURIER; Ω̂
   En todo este apartado ω es un número complejo con ω³ = 1, 1 + ω + ω² = 0 y
   conj ω = ω² (una raíz cúbica primitiva de la unidad).  Se pasa como
   parámetro con esas hipótesis.
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- La rotación de 120° de la celda alrededor de (1,1,1). -/
def cellRot (v : ℝ × ℝ × ℝ) : ℝ × ℝ × ℝ := (v.2.2, v.1, v.2.1)

/-- El espejo que fija la primera dirección e intercambia las otras dos. -/
def cellMirror (v : ℝ × ℝ × ℝ) : ℝ × ℝ × ℝ := (v.1, v.2.2, v.2.1)

/-- La complementariedad v ↦ (1,1,1) − v. -/
def cellComp (v : ℝ × ℝ × ℝ) : ℝ × ℝ × ℝ := (1 - v.1, 1 - v.2.1, 1 - v.2.2)

/-- Coordenada del plano: z(v₀, v₁, v₂) = v₀ + ω·v₁ + ω²·v₂. -/
def zc (ω : ℂ) (a b c : ℝ) : ℂ := (a : ℂ) + ω * (b : ℂ) + ω ^ 2 * (c : ℂ)

/-- Coordenada del eje: a(v) = (v₀ + v₁ + v₂)/3. -/
def axisCoord (a b c : ℝ) : ℝ := (a + b + c) / 3

/-- **La rotación multiplica z por ω.** -/
theorem zc_rotation (ω : ℂ) (h3 : ω ^ 3 = 1) (a b c : ℝ) :
    zc ω c a b = ω * zc ω a b c := by
  unfold zc
  linear_combination (-(c : ℂ)) * h3

/-- **La rotación no mueve el eje.** -/
theorem axis_rotation (a b c : ℝ) : axisCoord c a b = axisCoord a b c := by
  unfold axisCoord; ring

/-- **El eje es el núcleo de z.** -/
theorem zc_axis_kernel (ω : ℂ) (h1 : 1 + ω + ω ^ 2 = 0) (t : ℝ) : zc ω t t t = 0 := by
  unfold zc
  linear_combination (t : ℂ) * h1

/-- **La complementariedad es la media vuelta en el plano (z ↦ −z) y
    a ↦ 1 − a en el eje.** -/
theorem zc_complement (ω : ℂ) (h1 : 1 + ω + ω ^ 2 = 0) (a b c : ℝ) :
    zc ω (1 - a) (1 - b) (1 - c) = -zc ω a b c
    ∧ axisCoord (1 - a) (1 - b) (1 - c) = 1 - axisCoord a b c := by
  constructor
  · unfold zc
    push_cast
    linear_combination h1
  · unfold axisCoord; ring

/-- **El espejo conjuga z.** -/
theorem zc_mirror (ω : ℂ) (h3 : ω ^ 3 = 1) (hc : (starRingEnd ℂ) ω = ω ^ 2)
    (a b c : ℝ) :
    zc ω a c b = (starRingEnd ℂ) (zc ω a b c) := by
  unfold zc
  simp only [map_add, map_mul, map_pow, Complex.conj_ofReal, hc]
  linear_combination (-(c : ℂ) * ω) * h3

/-- **Las tres direcciones de la celda tienen z = 1, ω, ω².** -/
theorem triad_values (ω : ℂ) :
    zc ω 1 0 0 = 1 ∧ zc ω 0 1 0 = ω ∧ zc ω 0 0 1 = ω ^ 2 := by
  refine ⟨by simp [zc], by simp [zc], by simp [zc]⟩

/-- **Los autovalores de Ω̂ = ½·diag(1, ω, ω²) son φ^{−λ}·ω^k:** el módulo
    viene de la torre y la fase de la tríada. -/
theorem omega_hat_is_modulus_times_phase (ω : ℂ) (k : ℕ) :
    ((phi ^ (-lam) : ℝ) : ℂ) * ω ^ k = (1 / 2 : ℂ) * ω ^ k := by
  rw [phi_rpow_neg_lam]
  first | (push_cast; ring) | push_cast | norm_num

/- ═══════════════════════════════════════════════════════════════════════════
   §3  E³ Y LA TORRE DE CELDAS
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- E³: los puntos (x, y, φy). -/
def inE3 (v : ℝ × ℝ × ℝ) : Prop := v.2.2 = phi * v.2.1

/-- **El pliegue de E³ es la recursión entre tres celdas:** con z = φy, la
    autoedición z² = zy + y² es φ(φy) = φy + y. -/
theorem fold_back_is_cell_recursion (y : ℝ) : phi * (phi * y) = phi * y + y := by
  linear_combination y * phi_sq

/-- **E³ no es estable si se permutan sus coordenadas:** (1,0,0) está en E³ y
    su rotado (0,1,0) no.

    LECTURA.  Esto no es una ruptura de S₃.  Sobre la realización
    (x, y, φy) actúan las razones φ^k (`fold_back_is_cell_recursion`,
    `tower_recursion`), no las permutaciones de coordenadas.  La relación
    real entre φ y el S₃ de la celda se demuestra en §4 (conmutan), §5 (son
    independientes y compatibles) y §7 (coinciden en el primo 2). -/
theorem E3_not_stable_under_coordinate_rotation :
    inE3 (1, 0, 0) ∧ ¬ inE3 (cellRot (1, 0, 0)) := by
  refine ⟨by simp [inE3], ?_⟩
  simp only [inE3, cellRot]
  intro h
  have : phi * 1 = 0 := by linarith
  linarith [phi_pos]

/-- E³ corta el eje solo en el origen. -/
theorem E3_meets_axis_only_at_zero (t : ℝ) (h : inE3 (t, t, t)) : t = 0 := by
  simp only [inE3] at h
  have h1 : (phi - 1) * t = 0 := by linarith
  rcases mul_eq_zero.mp h1 with h2 | h2
  · linarith [one_lt_phi]
  · exact h2

/-- La complementariedad de la celda a escala φ^σ: v ↦ φ^σ(1,1,1) − v. -/
def iotaScaled (σ : ℝ) (v : ℝ × ℝ × ℝ) : ℝ × ℝ × ℝ :=
  (phi ^ σ - v.1, phi ^ σ - v.2.1, phi ^ σ - v.2.2)

/-- La dilatación por φ: el paso de la torre. -/
def dilate (v : ℝ × ℝ × ℝ) : ℝ × ℝ × ℝ := (phi * v.1, phi * v.2.1, phi * v.2.2)

/-- **La dilatación conmuta con la rotación de la celda.** -/
theorem dilate_comm_rot (v : ℝ × ℝ × ℝ) : dilate (cellRot v) = cellRot (dilate v) := rfl

/-- **La dilatación conmuta con el espejo.** -/
theorem dilate_comm_mirror (v : ℝ × ℝ × ℝ) :
    dilate (cellMirror v) = cellMirror (dilate v) := rfl

/-- **La dilatación entrelaza las complementariedades:**
    δ ∘ ι_σ = ι_{σ+1} ∘ δ. -/
theorem dilate_intertwines_iota (σ : ℝ) (v : ℝ × ℝ × ℝ) :
    dilate (iotaScaled σ v) = iotaScaled (σ + 1) (dilate v) := by
  have h : phi ^ (σ + 1) = phi * phi ^ σ := by
    rw [Real.rpow_add phi_pos, Real.rpow_one, mul_comm]
  simp only [dilate, iotaScaled, h, Prod.mk.injEq]
  refine ⟨by ring, by ring, by ring⟩

/-- **La dilatación escala por φ la coordenada del plano y la del eje, sin
    mezclarlas.** -/
theorem dilate_respects_fourier (ω : ℂ) (a b c : ℝ) :
    zc ω (phi * a) (phi * b) (phi * c) = (phi : ℂ) * zc ω a b c
    ∧ axisCoord (phi * a) (phi * b) (phi * c) = phi * axisCoord a b c := by
  constructor
  · unfold zc; push_cast; ring
  · unfold axisCoord; ring

/-- **E³ es la gráfica del paso de la torre:** la coordenada acoplada φy es la
    coordenada y dilatada. -/
theorem E3_is_graph_of_step (x y : ℝ) :
    inE3 (x, y, (dilate (0, y, 0)).2.1) := by
  simp [inE3, dilate]

/- ═══════════════════════════════════════════════════════════════════════════
   §4  CARA ARQUIMEDIANA: φ COMO ESCALAR
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- **Un escalar real conmuta con toda la simetría de la tríada:** con la
    rotación (×ω), con el espejo (conjugar) y con la media vuelta (−1).
    Con r = φ^{−λ} = ½ es el módulo de Ω̂; con r = φ^σ es la torre. -/
theorem real_scalar_commutes_with_cell (r : ℝ) (ω z : ℂ) :
    (r : ℂ) * (ω * z) = ω * ((r : ℂ) * z)
    ∧ (r : ℂ) * (starRingEnd ℂ) z = (starRingEnd ℂ) ((r : ℂ) * z)
    ∧ (r : ℂ) * (-z) = -((r : ℂ) * z) := by
  refine ⟨by ring, ?_, by ring⟩
  simp [map_mul, Complex.conj_ofReal]

/- ═══════════════════════════════════════════════════════════════════════════
   §5  CARA GLOBAL: EL NIVEL 60
   Los caracteres de las tres retículas: Gauss (χ₋₄, conductor 4),
   Eisenstein (χ₋₃, conductor 3) y áurea (χ₅, conductor 5).  Los tres
   dependen solo de la clase módulo 60.  El Frobenius en p fija o refleja la
   tríada según χ₋₃(p), y fija o conjuga φ según χ₅(p).
   En el círculo de 60 (ℤ/60 vía k ↦ e^{2πik/60}): el exponente 15 es i, el
   12 genera el pentágono y 20, 40 son la tríada.
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- χ₋₄ leído en ℤ/60: el carácter primitivo de conductor 4 (vale 0 solo en los pares). -/
def chiGauss (a : ZMod 60) : ℤ :=
  if a.val % 4 = 1 then 1 else if a.val % 4 = 3 then -1 else 0

/-- χ₋₃ leído en ℤ/60. -/
def chiEis (a : ZMod 60) : ℤ :=
  if a.val % 3 = 1 then 1 else if a.val % 3 = 2 then -1 else 0

/-- χ₅ leído en ℤ/60. -/
def chiGold (a : ZMod 60) : ℤ :=
  if a.val % 5 = 1 ∨ a.val % 5 = 4 then 1
  else if a.val % 5 = 2 ∨ a.val % 5 = 3 then -1 else 0

/-- **Las ocho combinaciones de signos de (χ₋₄, χ₋₃, χ₅) aparecen**, cada una
    con un testigo invertible módulo 60 (se da su inverso): los tres
    caracteres son independientes. -/
theorem eight_sign_patterns :
    ((1 : ZMod 60) * 1 = 1 ∧ chiGauss 1 = 1 ∧ chiEis 1 = 1 ∧ chiGold 1 = 1)
    ∧ ((13 : ZMod 60) * 37 = 1 ∧ chiGauss 13 = 1 ∧ chiEis 13 = 1 ∧ chiGold 13 = -1)
    ∧ ((41 : ZMod 60) * 41 = 1 ∧ chiGauss 41 = 1 ∧ chiEis 41 = -1 ∧ chiGold 41 = 1)
    ∧ ((17 : ZMod 60) * 53 = 1 ∧ chiGauss 17 = 1 ∧ chiEis 17 = -1 ∧ chiGold 17 = -1)
    ∧ ((19 : ZMod 60) * 19 = 1 ∧ chiGauss 19 = -1 ∧ chiEis 19 = 1 ∧ chiGold 19 = 1)
    ∧ ((7 : ZMod 60) * 43 = 1 ∧ chiGauss 7 = -1 ∧ chiEis 7 = 1 ∧ chiGold 7 = -1)
    ∧ ((11 : ZMod 60) * 11 = 1 ∧ chiGauss 11 = -1 ∧ chiEis 11 = -1 ∧ chiGold 11 = 1)
    ∧ ((23 : ZMod 60) * 47 = 1 ∧ chiGauss 23 = -1 ∧ chiEis 23 = -1 ∧ chiGold 23 = -1) := by
  decide

/-- **41 es el espejo puro de la tríada en el círculo de 60:** es una
    involución; fija el exponente 15 (i) y el 12 (el generador del pentágono,
    y con él φ); intercambia los exponentes de la tríada, 20 y 40. -/
theorem forty_one_is_the_pure_triad_mirror :
    (41 : ZMod 60) * 41 = 1
    ∧ (41 : ZMod 60) * 15 = 15 ∧ (41 : ZMod 60) * 12 = 12
    ∧ (41 : ZMod 60) * 20 = 40 ∧ (41 : ZMod 60) * 40 = 20 := by decide

/-- **Ninguna involución módulo 60 mueve φ:** si a² = 1 entonces χ₅(a) = +1.
    Conjugar φ exige a ≡ ±2 (mód 5), que tiene orden 4 sobre el pentágono. -/
theorem involutions_fix_phi : ∀ a : ZMod 60, a * a = 1 → chiGold a = 1 := by decide

/-- **En el primo 2:** χ₋₃(2) = χ₅(2) = −1 y χ₋₄(2) = 0.  (Lectura [C], no
    demostrada aquí: el 2 es inerte en ℚ(√−3) y en ℚ(√5), y ramifica en ℚ(i).) -/
theorem at_two_the_faces_meet :
    chiEis 2 = -1 ∧ chiGold 2 = -1 ∧ chiGauss 2 = 0 := by decide

/- ═══════════════════════════════════════════════════════════════════════════
   §6  LOS TRES C₂ MÓDULO 20
   (ℤ/20)^× actúa sobre μ₂₀ = μ₄ × μ₅ multiplicando exponentes.  Sus tres
   elementos de orden 2 son reflexiones parciales.  G = (χ₋₄, χ₅) en
   (ℤ/20)^× tiene núcleo {1, 9}, los cuadrados.
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- **Los tres C₂:** 9 refleja solo el pentágono (≡ 1 mód 4, ≡ −1 mód 5), 11
    solo el cuadrado, 19 = −1 los dos; 9·11 = 19; los cuadrados de las
    unidades son {1, 9}. -/
theorem three_C2_mod_20 :
    (∀ a : ZMod 20, (a * a = 1) ↔ a ∈ ({1, 9, 11, 19} : Finset (ZMod 20)))
    ∧ ((9 : ZMod 4) = 1 ∧ (9 : ZMod 5) = -1)
    ∧ ((11 : ZMod 4) = -1 ∧ (11 : ZMod 5) = 1)
    ∧ ((19 : ZMod 4) = -1 ∧ (19 : ZMod 5) = -1)
    ∧ (9 : ZMod 20) * 11 = 19
    ∧ (∀ a : ZMod 20, (∃ b, a * b = 1) → (a ^ 2 = 1 ∨ a ^ 2 = 9)) := by
  decide

/-- Los pares de la reflexión del pentágono: {a, −a} en ℤ/5.  φ es la traza
    de uno de ellos (2·cos(π/5)). -/
def pairOf (a : ZMod 5) : Finset (ZMod 5) := {a, -a}

/-- **ker G fija φ:** multiplicar por 9 ≡ −1 en ℤ/5 deja fijo cada par. -/
theorem kerG_fixes_pentagon_pairs :
    ∀ a : ZMod 5, pairOf ((9 : ZMod 5) * a) = pairOf a := by decide

/- ═══════════════════════════════════════════════════════════════════════════
   §7  CARA BINARIA: EL PRIMO 2
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- ℤ[φ]/2 y ℤ[ω]/2 como pares (a, b) = a + b·x con coeficientes en 𝔽₂. -/
abbrev G2 := ZMod 2 × ZMod 2

/-- Producto en ℤ[φ]/2, con φ² = φ + 1. -/
def gmul (x y : G2) : G2 := (x.1 * y.1 + x.2 * y.2, x.1 * y.2 + x.2 * y.1 + x.2 * y.2)

/-- Producto en ℤ[ω]/2, con ω² = −1 − ω. -/
def emul (x y : G2) : G2 := (x.1 * y.1 - x.2 * y.2, x.1 * y.2 + x.2 * y.1 - x.2 * y.2)

/-- La unidad (1, 0).  (No se usa `1 : G2`, que en un producto es (1, 1).) -/
def one2 : G2 := (1, 0)

/-- φ módulo 2. -/
def phi2 : G2 := (0, 1)

/-- La conjugación de Galois módulo 2: a + bφ ↦ a + b(1 − φ) = (a + b) − bφ. -/
def gconj (x : G2) : G2 := (x.1 + x.2, -x.2)

/-- **El polinomio áureo y el ciclotómico Φ₃ difieren en 2(x + 1).** -/
theorem golden_poly_eq_cyclotomic_three_mod_two (x : ℤ) :
    x ^ 2 - x - 1 = (x ^ 2 + x + 1) - 2 * (x + 1) := by ring

/-- **Por eso ℤ[φ]/2 y ℤ[ω]/2 tienen la misma tabla de multiplicar:** los dos
    son el cuerpo 𝔽₄. -/
theorem golden_eq_eisenstein_mod_two : ∀ x y : G2, gmul x y = emul x y := by decide

/-- **Los discriminantes 5 y −3 son congruentes módulo 8, y −15 ≡ 1 (mód 16).** -/
theorem discriminants_mod_eight : (5 : ZMod 8) = -3 ∧ (-15 : ZMod 16) = 1 := by decide

/-- **−15 es un cuadrado módulo 2¹⁰** (217² = −15 en ℤ/1024): sombra finita de
    que −15 es un cuadrado 2-ádico. -/
theorem minus_fifteen_square_mod_1024 : (217 : ZMod 1024) * 217 = -15 := by decide

/-- Lo clásico que este archivo NO demuestra: −15 es un cuadrado en ℤ₂, y
    por tanto ℚ₂(√5) = ℚ₂(√−3).  Se deja como proposición con nombre; ningún
    teorema de este archivo la usa. -/
def MinusFifteenTwoAdicSquare : Prop := ∃ x : PadicInt 2, x ^ 2 = -15

/-- **φ módulo 2 es una raíz cúbica primitiva de la unidad, y 1 + φ + φ² = 0:**
    el pliegue φ² = φ + 1, leído en 2, es la relación de la tríada. -/
theorem phi2_is_a_cube_root :
    gmul phi2 phi2 = phi2 + one2
    ∧ gmul (gmul phi2 phi2) phi2 = one2
    ∧ phi2 ≠ one2 ∧ gmul phi2 phi2 ≠ one2
    ∧ one2 + phi2 + gmul phi2 phi2 = 0 := by decide

/-- **El Frobenius de 2 (elevar al cuadrado) es aditivo y coincide con la
    conjugación de Galois φ ↦ φ̄.** -/
theorem frobenius_two_is_conjugation :
    (∀ x : G2, gmul x x = gconj x)
    ∧ (∀ x y : G2, gmul (x + y) (x + y) = gmul x x + gmul y y) := by decide

/-- Los vértices de la celda como 𝔽₂³ (cadenas de 3 bits). -/
abbrev Cell2 := ZMod 2 × ZMod 2 × ZMod 2

/-- Fourier módulo 2: v ↦ (v₀ + v₁ + v₂, v₀ + v₁φ + v₂φ²).  Es la versión
    binaria de (coordenada del eje, coordenada del plano). -/
def four2 (v : Cell2) : ZMod 2 × G2 :=
  (v.1 + v.2.1 + v.2.2,
   (v.1, 0) + gmul (v.2.1, 0) phi2 + gmul (v.2.2, 0) (gmul phi2 phi2))

/-- Rotación, espejo y complementariedad de la celda sobre 𝔽₂³ (mismas
    fórmulas que `cellRot`, `cellMirror`, `cellComp`; en 𝔽₂, 1 − v = 1 + v). -/
def rot2 (v : Cell2) : Cell2 := (v.2.2, v.1, v.2.1)
def mir2 (v : Cell2) : Cell2 := (v.1, v.2.2, v.2.1)
def comp2 (v : Cell2) : Cell2 := (v.1 + 1, v.2.1 + 1, v.2.2 + 1)

theorem four2_injective : ∀ v w : Cell2, four2 v = four2 w → v = w := by decide

theorem four2_surjective : ∀ y : ZMod 2 × G2, ∃ v : Cell2, four2 v = y := by decide

/-- **Los vértices de la celda son 𝔽₂ × ℤ[φ]/2.** -/
theorem four2_bijective : Function.Bijective four2 :=
  ⟨fun v w h => four2_injective v w h, four2_surjective⟩

/-- **En esas coordenadas:**
    · la rotación de la celda es multiplicar por φ;
    · el espejo es el Frobenius de 2 (la conjugación de φ);
    · la complementariedad cambia solo el bit del eje;
    · el eje (1,1,1) va a (1, 0);
    · las tres direcciones van a (1, 1), (1, φ), (1, φ²). -/
theorem cell_is_golden_ring_mod_two :
    (∀ v : Cell2, four2 (rot2 v) = ((four2 v).1, gmul phi2 (four2 v).2))
    ∧ (∀ v : Cell2, four2 (mir2 v) = ((four2 v).1, gconj (four2 v).2))
    ∧ (∀ v : Cell2, four2 (comp2 v) = ((four2 v).1 + 1, (four2 v).2))
    ∧ four2 ((1, 1, 1) : Cell2) = (1, 0)
    ∧ four2 ((1, 0, 0) : Cell2) = (1, one2)
    ∧ four2 ((0, 1, 0) : Cell2) = (1, phi2)
    ∧ four2 ((0, 0, 1) : Cell2) = (1, gmul phi2 phi2) := by decide

/-- Los vértices de peso par: uno de los dos tetraedros inscritos en el cubo. -/
def T1 : Finset Cell2 := Finset.univ.filter (fun v : Cell2 => v.1 + v.2.1 + v.2.2 = 0)

/-- **Los dos tetraedros:** el par es un grupo de Klein (cuatro elementos,
    cerrado por la suma, cada elemento su propio inverso); dos vértices
    distintos suyos difieren en un vector no nulo de peso par, es decir, en
    exactamente dos coordenadas (una arista del tetraedro); el impar es su
    complemento; `four2` los separa por el bit del eje.  Los tres vértices no
    nulos del tetraedro par van a 1, φ, φ²; φ los recorre en ciclo y la
    conjugación fija 1 e intercambia φ y φ².  Por tanto el S₃ de la celda es
    el grupo generado por ×φ y el Frobenius de 2. -/
theorem tetrahedra_are_klein_and_coset :
    T1.card = 4
    ∧ (∀ v ∈ T1, ∀ w ∈ T1, v + w ∈ T1)
    ∧ (∀ v : Cell2, v + v = 0)
    ∧ (∀ v ∈ T1, ∀ w ∈ T1, v ≠ w → v + w ≠ 0)
    ∧ (∀ v : Cell2, v ∉ T1 ↔ comp2 v ∈ T1)
    ∧ (∀ v : Cell2, v ∈ T1 ↔ (four2 v).1 = 0)
    ∧ four2 ((0, 1, 1) : Cell2) = (0, one2)
    ∧ four2 ((1, 0, 1) : Cell2) = (0, phi2)
    ∧ four2 ((1, 1, 0) : Cell2) = (0, gmul phi2 phi2)
    ∧ (gmul phi2 one2 = phi2 ∧ gmul phi2 phi2 = phi2 + one2
        ∧ gmul phi2 (gmul phi2 phi2) = one2)
    ∧ (gconj one2 = one2 ∧ gconj phi2 = gmul phi2 phi2
        ∧ gconj (gmul phi2 phi2) = phi2) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> decide

/- ═══════════════════════════════════════════════════════════════════════════
   §8  LOS ELEMENTOS DISTINGUIDOS DE LOS DOS GRUPOS DE KLEIN
   Del lado de la celda: el espejo fija una sola de las tres direcciones (la
   primera), que en 𝔽₄ es 1, y en ℂ es la dirección de z = 1, la del
   autovalor real ½ de Ω̂.
   Del lado del plano complejo: el grupo de Klein generado por ρ ↦ ρ̄ y
   ρ ↦ 1 − ρ; de sus tres involuciones, solo ρ ↦ 1 − ρ̄ fija la recta
   Re ρ = ½.
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- **El espejo fija exactamente la primera dirección** (en 𝔽₂³ y en ℝ³). -/
theorem mirror_fixes_first_direction :
    mir2 (1, 0, 0) = (1, 0, 0) ∧ mir2 (0, 1, 0) ≠ (0, 1, 0) ∧ mir2 (0, 0, 1) ≠ (0, 0, 1)
    ∧ cellMirror (1, 0, 0) = (1, 0, 0) := by
  refine ⟨by decide, by decide, by decide, rfl⟩

/-- Las tres involuciones del grupo de Klein sobre ℂ. -/
def kSigma (ρ : ℂ) : ℂ := (starRingEnd ℂ) ρ
def kTau (ρ : ℂ) : ℂ := 1 - ρ
def kSigmaTau (ρ : ℂ) : ℂ := 1 - (starRingEnd ℂ) ρ

/-- **Son involuciones y la tercera es la composición de las otras dos.** -/
theorem klein_on_C (ρ : ℂ) :
    kSigma (kSigma ρ) = ρ ∧ kTau (kTau ρ) = ρ ∧ kSigmaTau (kSigmaTau ρ) = ρ
    ∧ kSigma (kTau ρ) = kSigmaTau ρ ∧ kTau (kSigma ρ) = kSigmaTau ρ := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · simp [kSigma]
  · simp [kTau]
  · simp [kSigmaTau, map_sub, map_one]
  · simp [kSigma, kTau, kSigmaTau, map_sub, map_one]
  · simp [kSigma, kTau, kSigmaTau]

/-- **Conjugar fija exactamente el eje real.** -/
theorem kSigma_fixed (ρ : ℂ) : kSigma ρ = ρ ↔ ρ.im = 0 := by
  unfold kSigma
  constructor
  · intro h
    have h' := congrArg Complex.im h
    simp only [Complex.conj_im] at h'
    linarith
  · intro h
    apply Complex.ext
    · simp only [Complex.conj_re]
    · simp only [Complex.conj_im, h, neg_zero]

/-- **ρ ↦ 1 − ρ fija solo ½.** -/
theorem kTau_fixed (ρ : ℂ) : kTau ρ = ρ ↔ ρ = 1 / 2 := by
  unfold kTau
  constructor
  · intro h
    linear_combination (-1 / 2 : ℂ) * h
  · intro h
    rw [h]; norm_num

/-- **ρ ↦ 1 − ρ̄ fija exactamente la recta Re ρ = ½.** -/
theorem kSigmaTau_fixed (ρ : ℂ) : kSigmaTau ρ = ρ ↔ ρ.re = 1 / 2 := by
  unfold kSigmaTau
  constructor
  · intro h
    have h' := congrArg Complex.re h
    simp only [Complex.sub_re, Complex.one_re, Complex.conj_re] at h'
    linarith
  · intro h
    apply Complex.ext
    · simp only [Complex.sub_re, Complex.one_re, Complex.conj_re]
      linarith
    · simp only [Complex.sub_im, Complex.one_im, Complex.conj_im]
      ring

/- ═══════════════════════════════════════════════════════════════════════════
   §9  SÍNTESIS
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- **Un solo marco: φ y el S₃ de la celda en sus tres caras.**
    (A) Global, nivel 60: son independientes, el espejo puro de la tríada
        (41) fija φ, y toda involución fija φ.
    (B) Arquimediana: φ es escalar (la torre, y el módulo φ^{−λ} = ½ de Ω̂),
        y conmuta con la rotación y el espejo.
    (C) Binaria: la celda es 𝔽₂ × ℤ[φ]/2, la rotación es ×φ, el espejo es la
        conjugación de φ, la complementariedad es el bit del eje, y el
        pliegue es 1 + φ + φ² = 0.
    Más la torre de celdas y la recursión que ve E³. -/
theorem one_framework_three_faces (ω : ℂ) (h3 : ω ^ 3 = 1) (h1 : 1 + ω + ω ^ 2 = 0) :
    -- (A)
    ((41 : ZMod 60) * 41 = 1 ∧ chiGauss 41 = 1 ∧ chiEis 41 = -1 ∧ chiGold 41 = 1)
    ∧ (∀ a : ZMod 60, a * a = 1 → chiGold a = 1)
    ∧ (chiEis 2 = -1 ∧ chiGold 2 = -1 ∧ chiGauss 2 = 0)
    -- (B)
    ∧ phi ^ (-lam) = 1 / 2
    ∧ (∀ a b c : ℝ, zc ω (phi * a) (phi * b) (phi * c) = (phi : ℂ) * zc ω a b c)
    ∧ (∀ v : ℝ × ℝ × ℝ, dilate (cellRot v) = cellRot (dilate v))
    ∧ (∀ v : ℝ × ℝ × ℝ, dilate (cellMirror v) = cellMirror (dilate v))
    ∧ (∀ (σ : ℝ) (v : ℝ × ℝ × ℝ), dilate (iotaScaled σ v) = iotaScaled (σ + 1) (dilate v))
    ∧ (∀ (r : ℝ) (z : ℂ), (r : ℂ) * (ω * z) = ω * ((r : ℂ) * z))
    ∧ (∀ a b c : ℝ, zc ω c a b = ω * zc ω a b c)
    ∧ (∀ t : ℝ, zc ω t t t = 0)
    -- (C)
    ∧ (∀ x y : G2, gmul x y = emul x y)
    ∧ Function.Bijective four2
    ∧ (∀ v : Cell2, four2 (rot2 v) = ((four2 v).1, gmul phi2 (four2 v).2))
    ∧ (∀ v : Cell2, four2 (mir2 v) = ((four2 v).1, gconj (four2 v).2))
    ∧ (∀ v : Cell2, four2 (comp2 v) = ((four2 v).1 + 1, (four2 v).2))
    ∧ one2 + phi2 + gmul phi2 phi2 = 0
    -- la torre
    ∧ (∀ k : ℕ, phi ^ (k + 2) = phi ^ (k + 1) + phi ^ k)
    ∧ (∀ y : ℝ, phi * (phi * y) = phi * y + y) :=
  ⟨eight_sign_patterns.2.2.1,
   involutions_fix_phi,
   at_two_the_faces_meet,
   phi_rpow_neg_lam,
   fun a b c => (dilate_respects_fourier ω a b c).1,
   dilate_comm_rot,
   dilate_comm_mirror,
   dilate_intertwines_iota,
   fun r z => (real_scalar_commutes_with_cell r ω z).1,
   zc_rotation ω h3,
   zc_axis_kernel ω h1,
   golden_eq_eisenstein_mod_two,
   four2_bijective,
   cell_is_golden_ring_mod_two.1,
   cell_is_golden_ring_mod_two.2.1,
   cell_is_golden_ring_mod_two.2.2.1,
   phi2_is_a_cube_root.2.2.2.2,
   tower_recursion,
   fold_back_is_cell_recursion⟩

/- ═══════════════════════════════════════════════════════════════════════════
   §10  (INTEGRACIÓN) EL GRUPO DE KLEIN DE LA CELDA ES EL DEL PLANO
   La pregunta ABIERTA de la cabecera empareja tres direcciones con tres
   involuciones.  La celda tiene tres grupos de Klein, Vᵢ = ⟨espejoᵢ,
   complementariedad⟩, uno por dirección (conjugados por la rotación); aquí
   se usa el de la primera.  El espejo invierte la tríada (z ↦ z̄, es decir
   ω ↦ ω⁻¹) y la complementariedad la niega (z ↦ −z).  Leído así [T], es
   paralelo al diccionario de `prop:descent` del paper: la inversión va a la
   conjugación y la negación a ρ ↦ 1 − ρ.  Con la coordenada
   ρ(v) = a(v) + i·Im z(v) (una proyección: olvida Re z) ese paralelismo es
   literal, y la recta crítica es el plano medio a = ½ de la celda.  La
   dirección que fija el espejo cae en ρ = 1/3, sobre el eje real, no en la
   recta crítica.  La lectura alternativa ρ = ½ + i·z (z como la t de
   s = ½ + it) lleva el espejo a ρ ↦ 1 − ρ̄; con ella la lectura de la celda
   deja de ser paralela a `prop:descent`, que no cambia.  La elección es
   del autor.
   ═══════════════════════════════════════════════════════════════════════════ -/

/-- **El espejo y la complementariedad son involuciones que conmutan:** generan
    un grupo de Klein de la celda (el de la primera dirección). -/
theorem cell_klein (v : ℝ × ℝ × ℝ) :
    cellMirror (cellMirror v) = v ∧ cellComp (cellComp v) = v
    ∧ cellMirror (cellComp v) = cellComp (cellMirror v) := by
  obtain ⟨a, b, c⟩ := v
  refine ⟨rfl, ?_, rfl⟩
  first | simp only [cellComp, sub_sub_cancel] | simp [cellComp]

/-- La coordenada de la celda en el plano de s: la parte real es el eje, la
    imaginaria es la parte imaginaria de z. -/
def rhoCell (ω : ℂ) (a b c : ℝ) : ℂ :=
  ((axisCoord a b c : ℝ) : ℂ) + Complex.I * (((zc ω a b c).im : ℝ) : ℂ)

/-- **El espejo es la conjugación.** -/
theorem rhoCell_mirror (ω : ℂ) (h3 : ω ^ 3 = 1) (hc : (starRingEnd ℂ) ω = ω ^ 2)
    (a b c : ℝ) : rhoCell ω a c b = kSigma (rhoCell ω a b c) := by
  have hz := zc_mirror ω h3 hc a b c
  have hax : axisCoord a c b = axisCoord a b c := by unfold axisCoord; ring
  unfold rhoCell kSigma
  rw [hz, hax]
  first
    | (apply Complex.ext <;> simp <;> ring)
    | (apply Complex.ext <;> simp [Complex.conj_re, Complex.conj_im])

/-- **La complementariedad es ρ ↦ 1 − ρ.** -/
theorem rhoCell_comp (ω : ℂ) (h1 : 1 + ω + ω ^ 2 = 0) (a b c : ℝ) :
    rhoCell ω (1 - a) (1 - b) (1 - c) = kTau (rhoCell ω a b c) := by
  obtain ⟨hz, hax⟩ := zc_complement ω h1 a b c
  unfold rhoCell kTau
  rw [hz, hax]
  first
    | (apply Complex.ext <;> simp <;> ring)
    | (apply Complex.ext <;> simp [Complex.conj_re, Complex.conj_im])

/-- **Su composición es ρ ↦ 1 − ρ̄, la que fija la recta crítica.** -/
theorem rhoCell_mirror_comp (ω : ℂ) (h3 : ω ^ 3 = 1) (h1 : 1 + ω + ω ^ 2 = 0)
    (hc : (starRingEnd ℂ) ω = ω ^ 2) (a b c : ℝ) :
    rhoCell ω (1 - a) (1 - c) (1 - b) = kSigmaTau (rhoCell ω a b c) := by
  rw [rhoCell_mirror ω h3 hc (1 - a) (1 - b) (1 - c), rhoCell_comp ω h1 a b c]
  exact (klein_on_C _).2.2.2.1

/-- **La recta crítica es el plano medio de la celda:** Re ρ = ½ si y solo si
    a(v) = ½. -/
theorem rhoCell_critical_iff (ω : ℂ) (a b c : ℝ) :
    (rhoCell ω a b c).re = 1 / 2 ↔ axisCoord a b c = 1 / 2 := by
  unfold rhoCell
  simp

theorem rhoCell_critical_line (ω : ℂ) (a b c : ℝ) :
    kSigmaTau (rhoCell ω a b c) = rhoCell ω a b c ↔ axisCoord a b c = 1 / 2 :=
  (kSigmaTau_fixed _).trans (rhoCell_critical_iff ω a b c)

/-- **La dirección que fija el espejo va a 1/3, en el eje real:** la fija la
    conjugación y no está en la recta crítica. -/
theorem first_direction_on_real_axis (ω : ℂ) :
    rhoCell ω 1 0 0 = (1 / 3 : ℂ) ∧ axisCoord 1 0 0 ≠ 1 / 2 := by
  constructor
  · first
      | norm_num [rhoCell, zc, axisCoord]
      | (apply Complex.ext <;> simp [rhoCell, zc, axisCoord] <;> norm_num)
  · norm_num [axisCoord]

/-- La lectura alternativa: z como la t de s = ½ + it. -/
def rhoAlt (ω : ℂ) (a b c : ℝ) : ℂ := 1 / 2 + Complex.I * zc ω a b c

/-- **En la lectura alternativa el espejo va a ρ ↦ 1 − ρ̄** (y la
    complementariedad sigue yendo a ρ ↦ 1 − ρ). -/
theorem rhoAlt_mirror (ω : ℂ) (h3 : ω ^ 3 = 1) (hc : (starRingEnd ℂ) ω = ω ^ 2)
    (a b c : ℝ) : rhoAlt ω a c b = kSigmaTau (rhoAlt ω a b c) := by
  unfold rhoAlt kSigmaTau
  rw [zc_mirror ω h3 hc a b c]
  first
    | (simp only [map_add, map_mul, map_div₀, map_one, map_ofNat, Complex.conj_I]; ring)
    | (simp [Complex.conj_I, map_div₀]; ring)

theorem rhoAlt_comp (ω : ℂ) (h1 : 1 + ω + ω ^ 2 = 0) (a b c : ℝ) :
    rhoAlt ω (1 - a) (1 - b) (1 - c) = kTau (rhoAlt ω a b c) := by
  unfold rhoAlt kTau
  rw [(zc_complement ω h1 a b c).1]
  ring

end

end PhiCelda

end PhiCeldaBlock

/- F1Paper/W4Isometria.lean — W4 como isometría del círculo; la ley de los índices y las capas p-ádicas de φ (sesión del 13–16 de octubre) [P*] -/
section W4IsometriaBlock
/-!
═══════════════════════════════════════════════════════════════════════════════
  W4IsometriaCirculo.lean
  W4 como isometría del círculo: el espectro de la órbita, la recta, la
  ecuación funcional, el ½ en la fórmula del producto, Euler, B₂ y la celda.
═══════════════════════════════════════════════════════════════════════════════

  INDEPENDIENTE.  Solo Mathlib.  ESTADO [P*]: escrito, NO compilado.  Sin
  `sorry`, sin `native_decide`, sin axiomas.

  EL OBJETO.  Para un primo p > 1 y un cero ρ, el valor espectral de la
  órbita de p es λ(ρ) = exp((ρ − ½)·log p).  Si ρ = ½ + iγ es
  exp(iγ log p), la forma de la órbita de Weil t_k = Σ c_i λ_i^k.

  LO QUE SE DEMUESTRA.
  §1  ‖λ(ρ)‖ = p^{Re ρ − ½};  ‖λ(ρ)‖ = 1 ⇔ Re ρ = ½.
  §2  Isometría: si ‖λ‖ = 1, z ↦ λ^k z preserva distancias; si ‖λ‖ ≠ 1, no
      preserva la norma de ningún z ≠ 0.
  §3  W4 en el lado isométrico: con pesos ≥ 0 y todos los λ_j en el
      círculo, |t_k| ≤ t₀ para todo k.  Fuera del círculo (‖λ‖ > 1) un solo
      término ya rompe la cota.
  §4  La ecuación funcional: ‖λ(1 − ρ̄)‖·‖λ(ρ)‖ = 1.  Si los dos miembros
      del par cumplen la cota (‖λ‖ ≤ 1), entonces Re ρ = ½.
  §5  El ½ y el 1: |2|₂ = ½, |2|₂·|2|_∞ = 1, φ^{−λ} = ½ con λ = log_φ 2.
      Ω̂ = ½R contrae en el lugar real y la fórmula del producto lo compensa.
  §6  Euler: e^{iπ} = −1, e^{2πi} = 1, (e^{iπ/2})² = −1 (√−1 es el rotor en
      s = ½); en los enteros el rotor es ±1, las únicas isometrías
      multiplicativas.
  §7  Pares e impares: B₂(1 − x) = B₂(x), B₂(½) = −1/12, B₂(0) = 1/6;
      B₁ y B₃ son antisimétricos y se anulan en ½.  Por eso el círculo solo
      da los pares, y los impares piden torcer (χ₅, φ).
  §8  La celda como modelo finito: t_k = 1 + ω^k + ω^{2k} cumple
      |t_k| ≤ t₀ = 3; con Ω̂ = ½R, |t_k| ≤ 3·(½)^k.
  §9  60 y 360: 7 = M₃ tiene orden exactamente 12 módulo 360.
  §10 Síntesis.
  §11 La positividad la da la estructura (recta y círculo, sin ceros):
      forma de Toeplitz = suma de cuadrados con pesos ≥ 0 (W3), |t_k| ≤ t₀
      (W4), raíces de la unidad de todo nivel en el círculo, los dos
      pentágonos de ℤ/10, y `OrbitsMatch` [O] ⇒ W4 para la órbita de Weil.
  §12 La fila 7: ley por clases (8 clases) + forma estructural ⇒ empate ⇒
      W4; los pesos exactos del 2 y de los Mersenne.
  §13 El método de Weil (género 1) sobre las tres caras: positividad ⇒
      t² ≤ 4q ⇒ |α|² = q; Gauss y Eisenstein definidas, la áurea
      indefinida, congruente con Eisenstein mod 2; Lefschetz: los puntos
      fijos del Frobenius binario son las raíces M_n-ésimas.
  §14 La positividad de Weil clase por clase: en 14 de las 16 clases de
      (ℤ/60)^× alguna cara es anisótropa (definida); falla solo en {1, 49}.
  §15 El 120: el núcleo persiste en todo nivel abeliano; |SL₂(𝔽₅)| = 120;
      en la cubierta doble φ es traza de determinante +1 y cumple Weil.
  §16 Lo que G no ve: en p ≡ 1, 9 (mód 20), φ es cuadrado ⇔ p = a² + 20b²,
      y no lo es ⇔ p = 4a² + 5b² (formas definidas, disc −80).
  §17 Sin discontinuidades: la forma global es la suma de las de cada clase
      (sin términos cruzados); la positividad por clase da la global.
  §18 La ley sale del reloj: N(φⁿ − 1) = (−1)ⁿ − Lₙ + 1; ordenados por
      reloj, los pesos log p son la torre (n·log φ); lo abierto es el
      reparto de los índices.
  §19 La ley de los índices: la clase prohíbe (2, 3, 5 | índice solo en
      ciertas clases; inerte ⇒ índice impar) y lo permitido va con la
      frecuencia de Kummer, 1/n (Chebotarev [C] para cada n).
  §20 Las frecuencias estructurales de los índices (deltaIdx), sus
      prohibiciones, y la ley y su escala de error como Prop.
  §22 [N] La órbita de W3 del lado de los primos.
  §23 La fuente de W3 (índice de Hodge) en forma de correspondencias:
      M normalizada (como q^{−1/2}) la cumple; `HodgeSource`.
  §24 El reloj como conteo de 𝔽₁; los dos emparejamientos coinciden ⇔
      Re ρ = ½; el par (3/2, 1/2) es la coincidencia; `OperatorPairsByOrigin`.
  §25 Primos y ceros se emparejan igual; la recta es que coincidan en el
      centro ½; los datos locales 2, 5, 12, 60; `LocalToGlobalCenter`.
  §26 Lo local a lo global, intentado: la ecuación funcional local (centro ½)
      se transporta; el emparejamiento por origen no.  Se atora en que la
      órbita de Klein de cada cero sea degenerada (`KleinOrbitsDegenerate`).
  §27 El diccionario de Klein en las clases: la involución de la recta es
      a ↦ −a⁻¹, fija solo las inertes módulo 5 (que son ±i) y ninguna módulo
      4 o 20: la recta está en el pentágono y la rompe el factor de Gauss.
  §28 Donde i existe: el cuártico ψ₅; las clases fijas son las de valor en
      iℝ; la recta es el eje imaginario desplazado ½.
  §29 La órbita de ψ₅ del lado de los primos: W3 se cumple [N]; la parte
      imaginaria viene solo de las clases fijas; `Psi5ClassLaw`.
  §30 Lo abierto de ψ₅ reducido a las fluctuaciones de las clases (Parseval
      en μ₄); la media crece como p^{k/2} y la fluctuación no [N].
  §31 El paso de nodo sobre las fluctuaciones de clase es una rotación
      (|λ| ≈ 1.025 medido); no expandir basta, por el par de la ecuación
      funcional.
  §21 El 2 derivado de Kummer (grado 2^{2k+1}); la escala del error del
      núcleo es la recta de una forma de peso 1 y nivel 80.

  LO QUE NO SE DEMUESTRA.  W4 para los ceros reales (es la conjetura), ni
  la fuente de la positividad (W3).  Lo que aquí queda probado es qué
  significa W4: que el espectro sea isométrico.
═══════════════════════════════════════════════════════════════════════════════
-/

