-- =====================================================================
-- BLOCK S25. ComponentesInvoluciones (sprint 123): the three components P, C, F of Ω̂
-- are the three non-identity elements σ, τ, στ of the Klein group, each an involution.
-- Proves the identification that the corpus took as the hypothesis
-- `ComponentsAreInvolutions` of `operator_is_made_of_the_group`.
-- =====================================================================

section ComponentesInvolucionesBlock
/-! S25 · ComponentesInvoluciones
The Klein group generated by `σ s = 1 - s` and `τ s = conj s` on `ℂ` has exactly three
non-identity elements, each an involution; indexing the three components `P, C, F` of `Ω̂`
by `Fin 3`, the assignment `![σ, τ, σ ∘ τ]` is injective and lands on those three elements.
-/
namespace ComponentesInvoluciones

open Complex

def sig (s : ℂ) : ℂ := 1 - s
def tau (s : ℂ) : ℂ := (starRingEnd ℂ) s

theorem sig_invol : sig ∘ sig = id := by funext s; simp [sig]
theorem tau_invol : tau ∘ tau = id := by funext s; simp [tau]
theorem sig_tau_comm : sig ∘ tau = tau ∘ sig := by funext s; simp [sig, tau]
theorem sigtau_invol : (sig ∘ tau) ∘ (sig ∘ tau) = id := by
  funext s; simp [sig, tau]

theorem sig_ne_id : sig ≠ id := by
  intro h; have := congrFun h 0; simp [sig] at this
theorem tau_ne_id : tau ≠ id := by
  intro h; have := congrFun h I; simp [tau, Complex.ext_iff] at this; norm_num at this
theorem sigtau_ne_id : sig ∘ tau ≠ id := by
  intro h; have := congrFun h 0; simp [sig, tau] at this
theorem sig_ne_tau : sig ≠ tau := by
  intro h; have := congrFun h 0; simp [sig, tau] at this
theorem sig_ne_sigtau : sig ≠ sig ∘ tau := by
  intro h; have := congrFun h I
  simp [sig, tau, Complex.ext_iff] at this; norm_num at this
theorem tau_ne_sigtau : tau ≠ sig ∘ tau := by
  intro h; have := congrFun h 0; simp [sig, tau] at this

/-- The three components, indexed `0 = P`, `1 = C`, `2 = F`. -/
def comp : Fin 3 → (ℂ → ℂ) := ![sig, tau, sig ∘ tau]

theorem comp_injective : Function.Injective comp := by
  intro i j h
  fin_cases i <;> fin_cases j <;> simp [comp] at h ⊢
  all_goals first
    | exact absurd h sig_ne_tau | exact absurd h sig_ne_sigtau
    | exact absurd h.symm sig_ne_tau | exact absurd h.symm sig_ne_sigtau
    | exact absurd h tau_ne_sigtau | exact absurd h.symm tau_ne_sigtau

theorem comp_involution (i : Fin 3) : comp i ∘ comp i = id := by
  fin_cases i
  · exact sig_invol
  · exact tau_invol
  · exact sigtau_invol

theorem comp_ne_id (i : Fin 3) : comp i ≠ id := by
  fin_cases i
  · exact sig_ne_id
  · exact tau_ne_id
  · exact sigtau_ne_id

/-- Every element of the group `{id, σ, τ, στ}` other than the identity is a component. -/
theorem nonidentity_is_component (g : ℂ → ℂ)
    (hg : g = id ∨ g = sig ∨ g = tau ∨ g = sig ∘ tau) (hne : g ≠ id) :
    ∃ i, comp i = g := by
  rcases hg with h | h | h | h
  · exact absurd h hne
  · exact ⟨0, by simp [comp, h]⟩
  · exact ⟨1, by simp [comp, h]⟩
  · exact ⟨2, by simp [comp, h]⟩

/-- **The components are the involutions**: a bijection from the three components onto the
three non-identity elements of the Klein group, each of which is an involution. -/
theorem components_are_the_involutions :
    Function.Injective comp ∧ (∀ i, comp i ∘ comp i = id) ∧ (∀ i, comp i ≠ id) ∧
    (∀ g : ℂ → ℂ, (g = id ∨ g = sig ∨ g = tau ∨ g = sig ∘ tau) → g ≠ id → ∃ i, comp i = g) :=
  ⟨comp_injective, comp_involution, comp_ne_id, nonidentity_is_component⟩

end ComponentesInvoluciones
end ComponentesInvolucionesBlock


