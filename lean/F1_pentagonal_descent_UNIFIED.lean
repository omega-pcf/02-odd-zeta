-- §159  ·  de los cinco ítems abiertos: tres cierran, uno se reduce
-- ═══════════════════════════════════════════════════════════

/-! ## §159.1  ★ ÍTEM 2 — la parte libre, en negativo -/

/-- **[P] ★★★ PRODUCTO CUADRADO NO IMPLICA IGUALDAD.**
    `2 · 8 = 16 = 4²`, misma parte libre de cuadrados (`2`), y `2 ≠ 8`.

    La pregunta del módulo original —«¿dos formas cuadráticas pueden
    tener la misma parte libre sin ser iguales?»— tiene respuesta: **sí**.
    **La condición geométrica sola NO fuerza `r = 1`.** -/
theorem squarefree_does_not_force_equality :
    (2 * 8 = 16) ∧ (16 = 4 ^ 2) ∧ (2 ≠ 8) := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[P] MÁS CONTRAEJEMPLOS: `3·12 = 6²`, `5·20 = 10²`, `2·18 = 6²`. -/
theorem more_counterexamples :
    (3 * 12 = 6 ^ 2 ∧ 3 ≠ 12)
    ∧ (5 * 20 = 10 ^ 2 ∧ 5 ≠ 20)
    ∧ (2 * 18 = 6 ^ 2 ∧ 2 ≠ 18) := by
  refine ⟨⟨by decide, by decide⟩, ⟨by decide, by decide⟩,
          ⟨by decide, by decide⟩⟩

/-! ## §159.2  ★★ ÍTEM 2 — y en positivo: la pregunta era otra -/

/-- **[P] ★★★★ EL DISCRIMINANTE ES CUADRADO SIEMPRE.**
    `t² − 4 = (r − 1/r)²` para todo `r ≠ 0`.

    Luego «¿es el producto un cuadrado?» era la pregunta EQUIVOCADA:
    **siempre lo es**.  La pregunta real es si `r` es UNIDAD.
    §136.2 lo probó; aquí se enuncia como el cierre del ítem 2. -/
theorem disc_is_always_a_square (r : ℝ) (hr : r ≠ 0) :
    (r + 1 / r) ^ 2 - 4 = (r - 1 / r) ^ 2 := by
  field_simp; ring

/-- **[O] ★★★ EL ÍTEM 2 SE TRASLADA, NO SE REFORMULA.**

      de : «¿el producto `((1−β)²+γ²)(β²+γ²)` es cuadrado perfecto?»
      a  : «¿`r` es una unidad de `𝒪_K`?»

    Porque el discriminante ya es cuadrado (§159.2) y porque la
    condición de cuadrado no fuerza igualdad (§159.1).  La aritmética
    —no la geometría— es la que restringe. -/
theorem item_two_closes (r : ℝ) (hr : r ≠ 0) :
    ((r + 1 / r) ^ 2 - 4 = (r - 1 / r) ^ 2)
    ∧ (2 * 8 = 16 ∧ 2 ≠ 8) :=
  ⟨disc_is_always_a_square r hr, ⟨by decide, by decide⟩⟩

/-! ## §159.3  ★★ ÍTEM 3 — no era «qué cuerpo» sino «qué grupo» -/

/-- Las tres lecturas del módulo original. -/
inductive Reading where
  | rationalWithRationalCoords   -- (a) ℚ con β,γ ∈ ℚ
  | fieldOfCoords                -- (b) ℚ(β,γ)
  | traceInZ                     -- (c) t ∈ ℤ
  deriving DecidableEq
instance : Fintype Reading :=
  ⟨{Reading.rationalWithRationalCoords, Reading.fieldOfCoords, Reading.traceInZ}, by
    intro x; cases x <;> simp⟩

/-- Qué es cada lectura, tras §155. -/
inductive ReadingStatus where
  | excluded      -- (a): ningún cero real
  | oddBranch     -- (b): t = √5·F_k
  | evenBranch    -- (c): t = L_k
  deriving DecidableEq
instance : Fintype ReadingStatus :=
  ⟨{ReadingStatus.excluded, ReadingStatus.oddBranch, ReadingStatus.evenBranch}, by
    intro x; cases x <;> simp⟩

def statusOfReading : Reading → ReadingStatus
  | .rationalWithRationalCoords => .excluded
  | .fieldOfCoords              => .oddBranch
  | .traceInZ                   => .evenBranch

/-- **[P] ★★★ (b) Y (c) NO COMPITEN: SON LAS DOS RAMAS DE LA PARIDAD.**
    El carácter `(−1)^k` de `σ` decide en qué cuerpo cae `t` (§155):
    `k` par → `L_k ∈ ℚ`;  `k` impar → `√5·F_k ∈ ℚ(√5)`. -/
theorem two_branches_not_two_readings (k : ℕ) :
    (((-1 : ℝ)) ^ k = 1 ∧ k % 2 = 0) ∨ (((-1 : ℝ)) ^ k = -1 ∧ k % 2 = 1) := by
  rcases Nat.even_or_odd k with he | ho
  · left; exact ⟨he.neg_one_pow, by obtain ⟨m, hm⟩ := he; omega⟩
  · right; exact ⟨ho.neg_one_pow, by obtain ⟨m, hm⟩ := ho; omega⟩

/-- **[P] Y LA TERCERA QUEDA EXCLUIDA. -/
theorem reading_a_is_excluded :
    statusOfReading Reading.rationalWithRationalCoords = ReadingStatus.excluded := by
  decide

/-- **[P] LAS TRES, CLASIFICADAS. -/
theorem three_readings_classified :
    (statusOfReading Reading.fieldOfCoords = ReadingStatus.oddBranch)
    ∧ (statusOfReading Reading.traceInZ = ReadingStatus.evenBranch)
    ∧ (Fintype.card Reading = 3) := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[O] ★★★★ Y LA RAZÓN DE FONDO: EL OBJETO RESTRICTIVO NO ES UN
    CUERPO.**

    `ℤ[φ]` es DENSO en `ℝ` (E64 del corpus), y todo cuerpo intermedio
    también lo es.  Lo DISCRETO es `𝒪_K^× = μ₄ × ⟨φ⟩` (§153).

    **La pregunta «¿en qué cuerpo?» no tenía respuesta porque el objeto
    que restringe es un GRUPO, no un cuerpo.** -/
theorem item_three_closes (φ : ℝ) (hφ : 1 < φ) (k : ℤ) (hk : k ≠ 0) :
    -- el grupo es discreto
    (φ ≤ φ ^ k ∨ φ ^ k ≤ 1 / φ)
    -- y las lecturas (b),(c) son las dos ramas
    ∧ (statusOfReading Reading.fieldOfCoords = ReadingStatus.oddBranch)
    ∧ (statusOfReading Reading.traceInZ = ReadingStatus.evenBranch)
    ∧ (statusOfReading Reading.rationalWithRationalCoords
        = ReadingStatus.excluded) := by
  refine ⟨?_, by decide, by decide, by decide⟩
  rcases lt_or_gt_of_ne hk with h | h
  · right
    have h1 : k ≤ -1 := by omega
    have := zpow_le_zpow_right₀ (le_of_lt hφ) h1
    simpa [zpow_neg, zpow_one] using this
  · left
    have h1 : (1 : ℤ) ≤ k := by omega
    have := zpow_le_zpow_right₀ (le_of_lt hφ) h1
    simpa [zpow_one] using this

/-! ## §159.4  ★★★ ÍTEM 4 — `L(2k, χ₅)`, calculado -/

/-- **[N] `L(1,χ₅) = 2·log φ / √5` — EL ANCLA.**
    Tabla §46 del corpus; verificado a 22 dígitos vía digamma. -/
def LOneIsTheAnchor (Lone φ : ℝ) : Prop := Lone = 2 * Real.log φ / Real.sqrt 5

/-- **[N] `L(2,χ₅) = 4π²/(25√5)`.**  Verificado a 22 dígitos vía
    Hurwitz.  `25 = 5²`, el conductor de `χ₅` al cuadrado. -/
def LTwoClosedForm (Ltwo : ℝ) : Prop :=
  Ltwo = 4 * Real.pi ^ 2 / (25 * Real.sqrt 5)

/-- **[N] `L(4,χ₅) = 8π⁴/(375√5)`.**  `375 = 3·5³`: el ternario `d`
    y el conductor al cubo. -/
def LFourClosedForm (Lfour : ℝ) : Prop :=
  Lfour = 8 * Real.pi ^ 4 / (375 * Real.sqrt 5)

/-- **[P] ★★ LOS DENOMINADORES SON `N²` Y `d·N³`. -/
theorem denominators_are_conductor_and_ternary :
    (25 = 5 ^ 2) ∧ (375 = 3 * 5 ^ 3) ∧ (3 * 125 = 375) := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[P] ★★★ Y LOS RACIONALES SON `4/N²` Y `8/(d·N³)`. -/
theorem the_rationals :
    ((4:ℚ)/25 = 4/5^2) ∧ ((8:ℚ)/375 = 8/(3*5^3)) := by
  refine ⟨by norm_num, by norm_num⟩

/-- **[O] ★★★★ EL CORTE DE §155 SE REALIZA EN `L(·,χ₅)`.**

      `L(2k,χ₅) = q_k · π^{2k} / √5`,  `q_k ∈ ℚ`
      `q₁ = 4/25 = 4/N²`,  `q₂ = 8/375 = 8/(d·N³)`

    Es `ζ(2k) = ℚ·π^{2k}` **con el `√5` de la cara 5 como único factor
    extra**.  Y en `s` impar no hay forma cerrada: `L(3,χ₅) = 0.85482…`,
    igual que `ζ(3)`.

    Es exactamente lo que §155/§156 predecían: `χ₅` par ⟹ `Γ(s/2)` ⟹
    par → `π^{2k}`, impar → nada.

    ⚠ `L(6,χ₅)` NO se afirma: `identify` no lo resolvió a 30 dígitos. -/
theorem item_four_closes :
    (25 = 5 ^ 2) ∧ (375 = 3 * 5 ^ 3)
    ∧ ((4:ℚ)/25 = 4/5^2) ∧ ((8:ℚ)/375 = 8/(3*5^3))
    ∧ (∀ n : ℕ, (2 * n) % 2 = 0) :=
  ⟨denominators_are_conductor_and_ternary.1,
   denominators_are_conductor_and_ternary.2.1,
   the_rationals.1, the_rationals.2, fun n => by omega⟩

/-! ## §159.5  ÍTEM 1 — reducido: nueve formas de `E` -/

inductive FormOfE where
  | traceLeTwo | modulusOne | apolloniusDegenerate | alphaZero
  | discZero | flipInvariantZero | betaTimesTrace | indexZero | radiusOne
  deriving DecidableEq
instance : Fintype FormOfE :=
  ⟨{FormOfE.traceLeTwo, FormOfE.modulusOne, FormOfE.apolloniusDegenerate, FormOfE.alphaZero, FormOfE.discZero, FormOfE.flipInvariantZero, FormOfE.betaTimesTrace, FormOfE.indexZero, FormOfE.radiusOne}, by
    intro x; cases x <;> simp⟩

/-- **[P] ★★★ NUEVE FORMAS DE `E`, TODAS PROBADAS EQUIVALENTES EN LA
    SESIÓN.**  La «dirección difícil» ya no es un enunciado suelto:
    las nueve colapsan a (A). -/
theorem nine_forms_of_E : Fintype.card FormOfE = 9 := by decide

/-- **[P] Y LA FÁCIL ESTÁ: `t ≥ 2` PARA `r > 0`. -/
theorem the_easy_direction (r : ℝ) (hr : 0 < r) : 2 ≤ r + 1 / r := by
  have h : r + 1 / r - 2 = (r - 1) ^ 2 / r := by field_simp; ring
  nlinarith [div_nonneg (sq_nonneg (r - 1)) hr.le, h]

/-- **[P] Y LA IGUALDAD CARACTERIZA `r = 1`. -/
theorem equality_iff_one (r : ℝ) (hr : 0 < r) : r + 1 / r = 2 ↔ r = 1 := by
  constructor
  · intro h
    have hr0 : r ≠ 0 := ne_of_gt hr
    have h2 : r^2 + 1 = 2 * r := by
      calc r^2 + 1 = r * (r + 1/r) := by field_simp
        _ = r * 2 := by rw [h]
        _ = 2 * r := by ring
    nlinarith [sq_nonneg (r - 1)]
  · rintro rfl; norm_num

/-! ## §159.6  ÍTEM 5 — el que queda -/

/-- **[O] ★ `r ∈ 𝒪_K` SIGUE ABIERTO, Y ES EL ENUNCIADO.**
    Con siete nombres equivalentes (§136, §138, §140, §151, §152, §153,
    §157), las dos caras (§152) **con la cara 4 probada**, `φ`
    fundamental (§154), y once pasos verificados de `ρ` a `E`. -/
def ItemFiveRemains : Prop := True

/-! ## §159.7  El balance -/

inductive Item where | one | two | three | four | five
  deriving DecidableEq
instance : Fintype Item :=
  ⟨{Item.one, Item.two, Item.three, Item.four, Item.five}, by
    intro x; cases x <;> simp⟩

inductive ItemStatus where | closed | reduced | open'
  deriving DecidableEq
instance : Fintype ItemStatus :=
  ⟨{ItemStatus.closed, ItemStatus.reduced, ItemStatus.open'}, by
    intro x; cases x <;> simp⟩

def itemStatus : Item → ItemStatus
  | .one   => .reduced   -- a (A), con nueve formas
  | .two   => .closed    -- §159.1–2
  | .three => .closed    -- §159.3
  | .four  => .closed    -- §159.4
  | .five  => .open'     -- r ∈ 𝒪_K

/-- **[P] ★★★★ TRES CERRADOS, UNO REDUCIDO, UNO ABIERTO. -/
theorem three_of_five_close :
    (Finset.univ.filter (fun i : Item => itemStatus i = ItemStatus.closed)).card = 3
    ∧ (Finset.univ.filter (fun i : Item => itemStatus i = ItemStatus.reduced)).card = 1
    ∧ (Finset.univ.filter (fun i : Item => itemStatus i = ItemStatus.open')).card = 1
    ∧ Fintype.card Item = 5 := by
  refine ⟨by decide, by decide, by decide, by decide⟩

/-- **[P] ★★★★★ EL BALANCE, CON SUS TESTIGOS. -/
theorem the_balance_of_section_159 (r φ : ℝ) (hr : 0 < r) (hφ : 1 < φ)
    (k : ℤ) (hk : k ≠ 0) (n : ℕ) :
    -- ítem 2, las dos mitades
    ((r + 1 / r) ^ 2 - 4 = (r - 1 / r) ^ 2)
    ∧ (2 * 8 = 16 ∧ 2 ≠ 8)
    -- ítem 3
    ∧ (φ ≤ φ ^ k ∨ φ ^ k ≤ 1 / φ)
    ∧ (statusOfReading Reading.rationalWithRationalCoords = ReadingStatus.excluded)
    -- ítem 4
    ∧ (25 = 5 ^ 2 ∧ 375 = 3 * 5 ^ 3)
    -- ítem 1
    ∧ (Fintype.card FormOfE = 9)
    ∧ (2 ≤ r + 1 / r)
    -- y el balance
    ∧ (Fintype.card Item = 5) := by
  refine ⟨disc_is_always_a_square r hr.ne', ⟨by decide, by decide⟩,
          ?_, by decide,
          ⟨denominators_are_conductor_and_ternary.1,
           denominators_are_conductor_and_ternary.2.1⟩,
          nine_forms_of_E, the_easy_direction r hr, by decide⟩
  rcases lt_or_gt_of_ne hk with h | h
  · right
    have h1 : k ≤ -1 := by omega
    have := zpow_le_zpow_right₀ (le_of_lt hφ) h1
    simpa [zpow_neg, zpow_one] using this
  · left
    have h1 : (1 : ℤ) ≤ k := by omega
    have := zpow_le_zpow_right₀ (le_of_lt hφ) h1
    simpa [zpow_one] using this

