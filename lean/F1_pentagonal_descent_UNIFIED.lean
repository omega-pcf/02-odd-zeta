/-! ## §97.1  La primera igualdad, con sus cuatro nombres -/

/-- **[P] LAS TRES FORMAS SON UNA.**  Para `a, b > 0`:

        a·b = 1   ⟺   log a + log b = 0   ⟺   log b = −log a

    La primera es `moduli_product_is_one`, la segunda
    `pair_log_vanishes`, la tercera la τ-anti-invarianza de `u`.
    **Un enunciado, tres nombres en el corpus.** -/
theorem product_log_antisymmetry_are_one (a b : ℝ) (ha : 0 < a) (hb : 0 < b) :
    (a * b = 1 ↔ Real.log a + Real.log b = 0) ∧
    (Real.log a + Real.log b = 0 ↔ Real.log b = - Real.log a) := by
  constructor
  · constructor
    · intro h
      rw [← Real.log_mul (ne_of_gt ha) (ne_of_gt hb), h, Real.log_one]
    · intro h
      have hz : Real.log (a * b) = 0 := by
        rw [Real.log_mul (ne_of_gt ha) (ne_of_gt hb)]; exact h
      rcases Real.log_eq_zero.mp hz with h1 | h1 | h1
      · nlinarith
      · exact h1
      · nlinarith
  · constructor
    · intro h; linarith
    · intro h; linarith

/-- **[P] LUEGO CONTARLAS COMO DOS IGUALDADES ES CONTAR UNA DOS
    VECES.**  `e₂ = 1` y `Σ log|z| = 0` no son restricciones
    independientes sobre el conjunto de ceros. -/
theorem e_two_and_log_sum_are_one_equality (r : ℝ) (hr : 0 < r) :
    (r * (1 / r) = 1) ∧
    (Real.log r + Real.log (1 / r) = 0) ∧
    ((r * (1 / r) = 1) ↔ (Real.log r + Real.log (1 / r) = 0)) := by
  have hinv : (0 : ℝ) < 1 / r := by positivity
  have h := (product_log_antisymmetry_are_one r (1 / r) hr hinv).1
  refine ⟨by field_simp, ?_, h⟩
  exact h.mp (by field_simp)

/-! ## §97.2  El tipo no separa; el valor sí -/

/-- **[P] EL PAREO VALE PARA TODO `r > 0`.**  No distingue nada: es
    la ecuación funcional, un TIPO.

    Ésta es la razón de que `Σ log = 0` sea vacía ---y es
    identificación, no defecto. -/
theorem pairing_holds_for_every_r (r : ℝ) (hr : 0 < r) :
    Real.log r + Real.log (1 / r) = 0 :=
  (e_two_and_log_sum_are_one_equality r hr).2.1

/-- **[P] MIENTRAS QUE EL VALOR SÓLO EN `r = 1`.**  La otra mitad del
    reparto, y es `E`. -/
theorem value_only_at_one (r : ℝ) (hr : 0 < r) :
    (r - 1) + (1 / r - 1) = 0 ↔ r = 1 :=
  excess_zero_iff r hr

/-- **[P] EL REPARTO DE §43, EN LA COORDENADA DE §91.**  Los ceros
    tienen la mitad multiplicativa ---que es un tipo, universal--- y
    les falta la aditiva ---que es un valor, y es `E`. -/
theorem the_zeros_row (r : ℝ) (hr : 0 < r) :
    (Real.log r + Real.log (1 / r) = 0) ∧
    ((r - 1) + (1 / r - 1) = 0 ↔ r = 1) :=
  ⟨pairing_holds_for_every_r r hr, value_only_at_one r hr⟩

/-! ## §97.3  El cruce es asimétrico -/

/-- **[P] LA TRAZA DEL ESPECTRO SE ANULA, Y NO ES AUTOMÁTICA.**
    `1/2 − 1/4 − 1/4 = 0`, y viene de `Σ_k cos(2πk/3) = 0`: es un
    VALOR de la cara `π`, no una identidad universal. -/
theorem spectrum_trace_is_a_value :
    (1 : ℝ) / 2 + (-(1 / 4)) + (-(1 / 4)) = 0 := by norm_num

/-- **[O] EL CRUCE, ASIMÉTRICO.**

    | objeto | aditiva | multiplicativa |
    |---|---|---|
    | `spec Ω̂` | traza `= 0` — **VALOR** | det `= 2⁻⁵` — no |
    | `{z_ρ}` | `Σ(\|z\|−1) = E` | producto `= 1` — **TIPO** |

    Lo que el espectro tiene es de otra especie que lo que tienen los
    ceros: un valor frente a un tipo.  `E` pide a los ceros un valor,
    y lo que ya tienen es un tipo.

    **No es la otra mitad de un par simétrico.** -/
theorem the_crossing_is_asymmetric (r : ℝ) (hr : 0 < r) :
    -- espectro: valor, y se anula
    ((1 : ℝ) / 2 + (-(1 / 4)) + (-(1 / 4)) = 0) ∧
    -- ceros: tipo, universal en r
    (∀ s : ℝ, 0 < s → Real.log s + Real.log (1 / s) = 0) ∧
    -- y el valor de los ceros sólo en r = 1
    ((r - 1) + (1 / r - 1) = 0 ↔ r = 1) :=
  ⟨spectrum_trace_is_a_value, pairing_holds_for_every_r,
   value_only_at_one r hr⟩

