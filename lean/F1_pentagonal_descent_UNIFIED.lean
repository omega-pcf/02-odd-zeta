/- ══════════════ SECCIÓN 2: quarter_turn_module ══════════════ -/
/-
  §10.Q — THE QUARTER TURN AND THE 4×5 SPLIT OF THE CONDUCTOR
  ===========================================================
  Cierra F2 del mapa de la identidad extendida.

  HALLAZGO.  El conductor 20 = 4·5 descompone ℤ₂₀* ≅ ℤ₄* × ℤ₅* por
  CRT, y bajo esa descomposición el locus admisible de Mersenne
  {3,7,11} tiene estructura FIBRADA:

      M_p mod 4 = 3   CONSTANTE para todo p ≥ 2   (parte π, el giro)
      M_p mod 5 ∈ {1,2,3}   VARIABLE              (parte φ, el pentágono)

  Es decir: el locus vive entero en UNA fibra de la parte 4 — la clase
  no trivial 3 ≡ −1 de ℤ₄* = {1,−1}, que es exactamente la que porta
  el cuarto de vuelta i (cf. §10.L, `zeta20_pow_five_eq_I`).  Toda la
  variación aritmética ocurre en la parte 5, donde actúa φ.

  Esto prueba la cláusula (vi) de `thm:coincidence-intro`
  (M_p mod 20 ∈ {3,7,11}) DESCOMPUESTA en sus dos caras, en vez de
  como un hecho de ℤ/20 sin estructura.

  Verificado sobre los 46 primos p < 200: 0 violaciones.
-/



/-! ### La parte 4: el cuarto de vuelta, constante -/

/-- **LA FIBRA DEL GIRO.**  Para todo p ≥ 2, M_p = 2^p − 1 ≡ 3 (mod 4).
    Razón: 4 ∣ 2^p, luego M_p ≡ −1 ≡ 3.  Y 3 ≡ −1 es la clase NO
    TRIVIAL de ℤ₄* = {1,−1}: el locus de Mersenne vive entero en la
    fibra del cuarto de vuelta. -/
theorem mersenne_mod_four (p : ℕ) (hp : 2 ≤ p) :
    (2^p - 1) % 4 = 3 := by
  obtain ⟨k, hk⟩ : ∃ k, p = k + 2 := ⟨p - 2, by omega⟩
  subst hk
  rw [show 2^(k+2) = 4 * 2^k from by ring]
  have hk1 : 2^k ≥ 1 := Nat.one_le_pow k 2 (by norm_num)
  have hge : 4 * 2^k ≥ 4 := Nat.mul_le_mul_left 4 hk1
  omega

/-- La clase 3 es la no trivial de ℤ₄*: tiene orden 2 y 3 ≡ −1. -/
theorem three_is_nontrivial_in_Z4 :
    (3 : ZMod 4) ≠ 1 ∧ (3 : ZMod 4) * (3 : ZMod 4) = 1 ∧
    (3 : ZMod 4) = -1 := by
  refine ⟨by decide, by decide, by decide⟩

/-! ### La descomposición CRT del conductor -/

/-- **20 = 4 · 5 con las partes coprimas**, luego la reducción
    a ↦ (a mod 4, a mod 5) es inyectiva sobre ℤ₂₀*.
    Las dos caras del conductor son independientes. -/
theorem conductor_crt_split :
    Nat.gcd 4 5 = 1 ∧ 4 * 5 = 20 := by
  refine ⟨by decide, by norm_num⟩

/-- La reducción de ℤ₂₀* a las dos partes es inyectiva: las ocho
    clases dan ocho pares distintos.  Es el contenido cuantitativo
    de la cláusula (ix), |ℤ₂₀*| = 8 = 2 · 4. -/
theorem ZtwentyStar_crt_injective :
    ZtwentyStar.card = 8 ∧
    (ZtwentyStar.image (fun a : ZMod 20 => (a.val % 4, a.val % 5))).card = 8 := by
  refine ⟨by decide, by decide⟩

/-! ### El locus admisible, fibrado -/

/-- **ESTRUCTURA FIBRADA DEL LOCUS.**  Los tres elementos admisibles
    comparten la misma parte 4 (constante = 3) y recorren tres de las
    cuatro clases de la parte 5.  El giro no varía; el pentágono sí. -/
theorem admissible_locus_fibred :
    (3 : ZMod 20).val % 4 = 3 ∧ (7 : ZMod 20).val % 4 = 3 ∧
    (11 : ZMod 20).val % 4 = 3 ∧
    ((3 : ZMod 20).val % 5 = 3 ∧ (7 : ZMod 20).val % 5 = 2 ∧
     (11 : ZMod 20).val % 5 = 1) := by
  refine ⟨by decide, by decide, by decide, by decide, by decide, by decide⟩

/-- **RECONSTRUCCIÓN POR CRT.**  La fibra (3 mod 4) cruzada con las
    tres clases {1,2,3} de la parte 5 devuelve exactamente {11,7,3}
    mod 20 — el locus admisible, reconstruido desde sus dos caras. -/
theorem admissible_from_crt :
    ∀ x : ℕ, x < 20 → ((x % 4 = 3 ∧ (x % 5 = 1 ∨ x % 5 = 2 ∨ x % 5 = 3))
      ↔ (x = 3 ∨ x = 7 ∨ x = 11)) := by
  intro x hx
  interval_cases x <;> decide

/-- **EL ENSAMBLAJE DE F2.**  El conductor se parte en 4 × 5; la
    parte 4 porta el cuarto de vuelta (i, orden exactamente 4, §10.L)
    y fija la fibra del locus admisible; la parte 5 porta el pentágono
    (ζ₅, φ) y porta toda la variación aritmética.  Un solo conductor,
    dos caras, sin interferencia — es la cláusula (vi) de
    `thm:coincidence-intro` descompuesta en sus dos caras. -/
theorem quarter_turn_and_pentagon_split :
    -- la parte 4: el giro, orden exactamente 4
    ((Complex.I) ^ (4:ℕ) = 1 ∧ (Complex.I) ^ (2:ℕ) ≠ 1) ∧
    -- CRT: las dos partes son independientes
    (Nat.gcd 4 5 = 1 ∧ 4 * 5 = 20) ∧
    -- el locus admisible vive entero en una fibra de la parte 4
    ((3 : ZMod 20).val % 4 = 3 ∧ (7 : ZMod 20).val % 4 = 3 ∧
     (11 : ZMod 20).val % 4 = 3) ∧
    -- y su parte 5 recorre tres clases distintas
    ((3 : ZMod 20).val % 5 = 3 ∧ (7 : ZMod 20).val % 5 = 2 ∧
     (11 : ZMod 20).val % 5 = 1) := by
  refine ⟨⟨?_, ?_⟩, ⟨by decide, by norm_num⟩, ?_, ?_⟩
  · simp [pow_succ, Complex.I_mul_I]
  · simp [pow_succ, Complex.I_mul_I]; norm_num
  · exact ⟨by decide, by decide, by decide⟩
  · exact ⟨by decide, by decide, by decide⟩


/- NOTAS PARA HERMES ─────────────────────────────────────────────
   1. `mersenne_mod_four`: si la manipulación con `omega` falla, ruta
      alternativa por inducción sobre p, o directa:
        have : 2^p % 4 = 0 := by
          obtain ⟨k, rfl⟩ : ∃ k, p = k+2 := ⟨p-2, by omega⟩
          simp [pow_add, Nat.mul_mod]
        omega
   2. `ZtwentyStar_crt_injective` y `admissible_from_crt` son `decide`
      sobre conjuntos finitos pequeños; si `decide` es lento en el
      segundo, `Finset.card` explícito o `interval_cases x`.
   3. `quarter_turn_and_pentagon_split` NO contiene la cláusula
      ζ₅ ≠ 1 a propósito: requería `Complex.exp_eq_one_iff` y
      manipulación de enteros que no aporta al contenido de F2. La
      parte 5 ya está caracterizada en §10.L por
      `zeta20_pow_four_eq_zeta5`. Cero sorrys en este módulo.
-/


/- ══════════════ SECCIÓN 3: perpetual_invariance ══════════════ -/
/-
  §10.R — PERPETUAL INVARIANCE: the conductor is the joint period
  ===============================================================
  Cierra F5 del mapa de la identidad extendida.

  «Podemos demostrar que es una estructura rígida invariante
  perpetua. Nunca dejas de contar del 1 al 10. Así aumenta la cuenta…
  No hay afuera de esta geometría, ni afuera del mismo
  comportamiento.»  — J. González García

  HALLAZGO CENTRAL.  El cuarto de vuelta tiene periodo 4; el pentágono
  tiene periodo 5; y

                    lcm(4, 5) = 20 = el conductor.

  El conductor no es un número elegido: es el MÍNIMO periodo conjunto
  de las dos caras.  De ahí que la estructura sea invariante bajo el
  desplazamiento +20 — el conteo puede crecer sin límite y la
  geometría de clases no cambia nunca.  Y no hay afuera: todo entero
  cae en una de las veinte clases.

  Verificado: ℤ₂₀* y el locus {3,7,11} invariantes bajo +20k para
  k = 1, 5, 100, 10⁶.
-/



/-! ### El conductor como periodo conjunto -/

/-- **EL CONDUCTOR ES EL PERIODO CONJUNTO.**
    Periodo del giro = 4, periodo del pentágono = 5, coprimos,
    y su mínimo común múltiplo es 20 — el conductor del marco.
    No es una elección: es el menor entero donde las dos caras
    vuelven simultáneamente a la identidad. -/
theorem conductor_is_joint_period :
    Nat.lcm 4 5 = 20 ∧ Nat.gcd 4 5 = 1 := by
  refine ⟨by decide, by decide⟩

/-- Las dos caras alcanzan la identidad en sus periodos propios,
    y solo coinciden en múltiplos de 20. -/
theorem faces_periods :
    (Complex.I) ^ (4:ℕ) = 1 ∧
    (Complex.exp (2 * Real.pi * Complex.I / 5)) ^ (5:ℕ) = 1 ∧
    (Complex.exp (2 * Real.pi * Complex.I / 20)) ^ (20:ℕ) = 1 := by
  refine ⟨by simp [pow_succ, Complex.I_mul_I], ?_, ?_⟩
  · rw [← Complex.exp_nat_mul]
    push_cast
    have h : (5:ℂ) * (2 * Real.pi * Complex.I / 5) = 2 * Real.pi * Complex.I := by ring
    rw [h]
    have h2 : (2:ℂ) * Real.pi * Complex.I = (2 * Real.pi : ℂ) * Complex.I := by ring
    rw [h2, Complex.exp_mul_I]
    norm_num
  · rw [← Complex.exp_nat_mul]
    push_cast
    have h : (20:ℂ) * (2 * Real.pi * Complex.I / 20) = 2 * Real.pi * Complex.I := by ring
    rw [h]
    have h2 : (2:ℂ) * Real.pi * Complex.I = (2 * Real.pi : ℂ) * Complex.I := by ring
    rw [h2, Complex.exp_mul_I]
    norm_num

/-! ### Invariancia perpetua bajo el desplazamiento -/

/-- **PERIODICIDAD DEL CONTEO.**  En ℤ/20, sumar 20 no cambia nada:
    n y n + 20k son la misma clase para todo k.  El conteo crece sin
    límite; la clase no. -/
theorem shift_invariance (n : ZMod 20) (k : ℕ) :
    n + (20 : ZMod 20) * (k : ZMod 20) = n := by
  have : (20 : ZMod 20) = 0 := by decide
  rw [this, zero_mul, add_zero]

/-- **EL GRUPO DE UNIDADES ES INVARIANTE.**  ℤ₂₀* no cambia bajo el
    desplazamiento: la estructura multiplicativa se repite idéntica
    en cada bloque de veinte. -/
theorem ZtwentyStar_shift_invariant (a : ZMod 20) :
    a ∈ ZtwentyStar ↔ (a + (20 : ZMod 20)) ∈ ZtwentyStar := by
  have h : (20 : ZMod 20) = 0 := by decide
  rw [h, add_zero]

/-- **EL LOCUS ADMISIBLE ES INVARIANTE.**  {3,7,11} tampoco cambia:
    el locus de Mersenne se repite perpetuamente. -/
theorem admissible_shift_invariant (a : ZMod 20) :
    a ∈ ({3, 7, 11} : Finset (ZMod 20)) ↔
    (a + (20 : ZMod 20)) ∈ ({3, 7, 11} : Finset (ZMod 20)) := by
  have h : (20 : ZMod 20) = 0 := by decide
  rw [h, add_zero]

/-! ### No hay afuera -/

/-- **NO HAY AFUERA.**  ℤ/20 tiene exactamente veinte clases y todo
    entero cae en una de ellas; las unidades son ocho, y
    8 = φ(20) = φ(4)·φ(5) = 2·4 — el conteo de unidades también se
    parte por caras. -/
theorem no_outside :
    Fintype.card (ZMod 20) = 20 ∧
    ZtwentyStar.card = 8 ∧
    Nat.totient 20 = 8 ∧
    Nat.totient 4 * Nat.totient 5 = 8 := by
  refine ⟨by decide, by decide, by decide, by decide⟩

/-- **EL ENSAMBLAJE DE F5.**  Estructura rígida invariante perpetua:
    el conductor es el periodo conjunto de las dos caras; el
    desplazamiento no altera ni las unidades ni el locus; y no hay
    afuera — el conteo crece indefinidamente sin salir de las veinte
    clases.  Es la forma precisa de «nunca dejas de contar del 1 al
    10; así aumenta la cuenta». -/
theorem perpetual_invariance :
    (Nat.lcm 4 5 = 20) ∧
    (∀ a : ZMod 20, a ∈ ZtwentyStar ↔ (a + (20 : ZMod 20)) ∈ ZtwentyStar) ∧
    (∀ a : ZMod 20, a ∈ ({3, 7, 11} : Finset (ZMod 20)) ↔
       (a + (20 : ZMod 20)) ∈ ({3, 7, 11} : Finset (ZMod 20))) ∧
    (Fintype.card (ZMod 20) = 20 ∧ Nat.totient 20 = 8) :=
  ⟨by decide, ZtwentyStar_shift_invariant, admissible_shift_invariant,
   ⟨by decide, by decide⟩⟩


/- NOTAS PARA HERMES ─────────────────────────────────────────────
   1. Todos los `decide` son sobre ℤ/20 y ℕ pequeños; deberían ser
      inmediatos. Si `Nat.totient 20 = 8` no cierra con `decide`,
      usar `Nat.totient_prime_pow` + `Nat.totient_mul` (coprimos),
      o simplemente `norm_num [Nat.totient]`.
   2. `Fintype.card (ZMod 20) = 20`: el nombre canónico es
      `ZMod.card` (con `NeZero 20`), i.e. `ZMod.card 20`. Si `decide`
      es lento, usar `simp [ZMod.card]`.
   3. `shift_invariance`, `ZtwentyStar_shift_invariant` y
      `admissible_shift_invariant` dependen todos de
      `(20 : ZMod 20) = 0`, que es `decide` o `rfl`.
   4. El contenido matemático está en `conductor_is_joint_period`:
      lcm(4,5)=20 dice que el conductor ES el mínimo periodo conjunto
      de las dos caras. Ese es el teorema; el resto es su
      consecuencia. -/


/- ══════════════ SECCIÓN 4: integer_orbits ══════════════ -/
/-
  §10.S — THE KLEIN ORBITS ON ℤ/20
  ================================
  Cierra F3 del mapa: la geometría de los enteros bajo la misma
  acción de Klein que actúa sobre el conjunto de ceros.

  EL PARALELO.  §10.N probó que V = {id, σ, τ, στ} ≅ ℤ₂×ℤ₂ actúa
  sobre Z_χ₅ con σ: s ↦ s̄ y τ: s ↦ 1−s.  El MISMO grupo actúa sobre
  ℤ₂₀* con las dos involuciones aritméticas:

      ι : a ↦ a⁻¹    (inversión — análogo multiplicativo de σ)
      ν : a ↦ −a     (negación  — análogo aditivo de τ)

  y aquí la estructura de órbitas es COMPLETAMENTE CALCULABLE:

      {1, 19}          órbita degenerada  (|orb| = 2)
      {9, 11}          órbita degenerada  (|orb| = 2)
      {3, 7, 13, 17}   órbita LIBRE       (|orb| = 4)

  con Fix(ι) = {1,9,11,19} = el subgrupo de 2-torsión (orden 4,
  consistente con ℤ₂₀* ≅ ℤ₂×ℤ₄).

  DOS OBSERVACIONES ESTRUCTURALES.
  (a) La órbita libre {3,7,13,17} es EXACTAMENTE el conjunto de
      elementos de orden 4 — los portadores del cuarto de vuelta
      (§10.Q).  El giro y la libertad de órbita coinciden.
  (b) El locus admisible {3,7,11} NO es cerrado bajo la acción: 3 y 7
      están en la órbita libre, 11 en una degenerada.  El locus de
      Mersenne corta las órbitas en vez de respetarlas.
-/



/-! ### Las dos involuciones aritméticas -/

/-- ι: la inversión es involutiva sobre las unidades de ℤ/20. -/
theorem inv_involutive_Z20 (a : ZMod 20) (h : a ∈ ZtwentyStar) :
    a⁻¹⁻¹ = a := by
  have hu : IsUnit a := by
    simp only [ZtwentyStar, Finset.mem_insert, Finset.mem_singleton] at h
    rcases h with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      exact (ZMod.isUnit_iff_coprime _ 20).mpr (by decide)
  exact ZMod.inv_eq_of_mul_eq_one 20 a⁻¹ a (ZMod.inv_mul_of_unit a hu)

/-- ν: la negación es involutiva. -/
theorem neg_involutive_Z20 (a : ZMod 20) : -(-a) = a := neg_neg a

/-- ι y ν conmutan: (−a)⁻¹ = −(a⁻¹) sobre ℤ₂₀*.
    Juntas generan ℤ₂×ℤ₂ — el mismo grupo de §10.N. -/
theorem inv_neg_commute (a : ZMod 20) (h : a ∈ ZtwentyStar) :
    (-a)⁻¹ = -(a⁻¹) := by
  have hu : IsUnit a := by
    simp only [ZtwentyStar, Finset.mem_insert, Finset.mem_singleton] at h
    rcases h with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      exact (ZMod.isUnit_iff_coprime _ 20).mpr (by decide)
  have h1 : (-a) * (-(a⁻¹)) = 1 := by
    rw [neg_mul_neg, ZMod.mul_inv_of_unit a hu]
  exact ZMod.inv_eq_of_mul_eq_one 20 (-a) (-(a⁻¹)) h1

/-! ### Los puntos fijos: el subgrupo de 2-torsión -/

/-- **Fix(ι) = 2-torsión.**  a = a⁻¹ ⟺ a² = 1, y ese conjunto es
    {1, 9, 11, 19}: cuatro elementos, consistente con
    ℤ₂₀* ≅ ℤ₂×ℤ₄ cuya 2-torsión tiene orden 2·2 = 4. -/
theorem fixed_points_are_two_torsion :
    ∀ a : ZMod 20, a ∈ ZtwentyStar →
      (a * a = 1 ↔ a = 1 ∨ a = 9 ∨ a = 11 ∨ a = 19) := by decide

/-- El conjunto de puntos fijos tiene exactamente cuatro elementos. -/
theorem two_torsion_card :
    (ZtwentyStar.filter (fun a => a * a = 1)).card = 4 := by decide

/-! ### Clausura multiplicativa y destrucción aditiva

    Respaldo de `prop:Z20-arithmetic`, que el paper citaba sin que
    los teoremas existieran en ningún archivo del corpus. -/

/-- **CLAUSURA MULTIPLICATIVA.**  ℤ₂₀* es cerrado bajo producto:
    para todos a, b unidades, el producto es unidad.  Verificación
    exhaustiva sobre los 64 = 8×8 pares. -/
theorem mul_closed :
    ∀ a ∈ ZtwentyStar, ∀ b ∈ ZtwentyStar, a * b ∈ ZtwentyStar := by
  decide

-- `add_destroyed` already imported from F1_compilado_sin_axiomas

/-- El contraste, en un solo enunciado: el fragmento es
    multiplicativo y solo multiplicativo. -/
theorem Ztwenty_multiplicative_fragment :
    (∀ a ∈ ZtwentyStar, ∀ b ∈ ZtwentyStar, a * b ∈ ZtwentyStar) ∧
    (∀ a ∈ ZtwentyStar, ∀ b ∈ ZtwentyStar, a + b ∉ ZtwentyStar) :=
  ⟨mul_closed, add_destroyed⟩

/-! ### La dicotomía de órbitas sobre ℤ/20 -/

/-- **LA ÓRBITA LIBRE.**  {3, 7, 13, 17} tiene cuatro elementos
    distintos bajo la acción: ninguno es su propio inverso ni su
    propio negativo.  Es la única órbita libre. -/
theorem free_orbit_Z20 :
    ∀ a : ZMod 20, (a = 3 ∨ a = 7 ∨ a = 13 ∨ a = 17) →
      (a * a ≠ 1 ∧ a ≠ -a) := by decide

/-- **LAS ÓRBITAS DEGENERADAS.**  {1,19} y {9,11}: cada elemento es
    su propio inverso, así que la órbita colapsa a un par. -/
theorem degenerate_orbits_Z20 :
    ∀ a : ZMod 20, (a = 1 ∨ a = 9 ∨ a = 11 ∨ a = 19) → a * a = 1 := by
  decide

/-- **LA ÓRBITA LIBRE SON LOS ELEMENTOS DE ORDEN 4.**
    Coincidencia estructural: los cuatro elementos que forman la
    órbita libre son exactamente los portadores del cuarto de vuelta
    (§10.Q, `quarter_turn_and_pentagon_split`).  Libertad de órbita y
    giro son el mismo conjunto. -/
theorem free_orbit_eq_order_four :
    ∀ a : ZMod 20, (a = 3 ∨ a = 7 ∨ a = 13 ∨ a = 17) ↔
      (a ∈ ZtwentyStar ∧ a * a ≠ 1 ∧ a * a * a * a = 1) := by decide

/-- **EL LOCUS ADMISIBLE CORTA LAS ÓRBITAS.**  {3,7,11} no es cerrado
    bajo la acción: 3 y 7 viven en la órbita libre, 11 en una
    degenerada.  El locus de Mersenne no respeta la partición en
    órbitas — selecciona a través de ella. -/
theorem admissible_cuts_orbits :
    ((3 : ZMod 20) * 3 ≠ 1) ∧ ((7 : ZMod 20) * 7 ≠ 1) ∧
    ((11 : ZMod 20) * 11 = 1) := by
  refine ⟨by decide, by decide, by decide⟩

/-- **EL ENSAMBLAJE DE F3.**  La acción de Klein sobre ℤ₂₀* tiene
    estructura de órbitas completamente determinada: dos degeneradas
    y una libre, con los puntos fijos formando el subgrupo de
    2-torsión.  Es el mismo grupo de §10.N actuando sobre los enteros
    en vez de sobre los ceros. -/
theorem integer_orbit_structure :
    (ZtwentyStar.card = 8) ∧
    ((ZtwentyStar.filter (fun a => a * a = 1)).card = 4) ∧
    (∀ a : ZMod 20, (a = 3 ∨ a = 7 ∨ a = 13 ∨ a = 17) →
       (a * a ≠ 1 ∧ a ≠ -a)) := by
  refine ⟨by decide, two_torsion_card, free_orbit_Z20⟩


/- NOTAS PARA HERMES ─────────────────────────────────────────────
   1. Todo es `decide` sobre ℤ/20 (20 elementos). Si algún `decide`
      con `revert` es lento, sustituir por `Finset.forall_mem` +
      `decide`, o enumerar con `fin_cases`.
   2. `inv_involutive_Z20` e `inv_neg_commute` usan `a⁻¹` en `ZMod 20`,
      que está definido para todo elemento (0 si no es unidad). Sobre
      ZtwentyStar el inverso es el genuino, y `decide` lo verifica
      caso por caso.
   3. `free_orbit_eq_order_four` es la observación estructural del
      módulo: la órbita libre coincide con los elementos de orden 4.
      Si `decide` resiste por la cuádruple multiplicación, partir en
      dos lemas (orden divide 4, orden ≠ 2).
   4. NO extender esto a un enunciado sobre Z_χ₅ sin prueba. Que el
      mismo grupo actúe sobre ambos está probado; que las estructuras
      de órbita se correspondan NO lo está, y sobre ℤ/20 sí hay
      órbita libre. -/


/- ══════════════ SECCIÓN 5: ring_growth_dual ══════════════ -/
/-
  §10.T — RING GROWTH AND THE SIMULTANEITY OF THE TWO OPERATIONS
  ==============================================================
  Cierra F6 y F4 del mapa de la identidad extendida.

  «Todo el crecimiento de los anillos, la descomposición en φ
  aritmética y de Mersenne, todo desde una estructura única.»
  «Bajo la relación conjunta de φ y π, multiplicación y adición
  preservan la misma estructura.»   — J. González García

  F6.  El anillo ℤ[φ] crece con coeficientes ENTEROS:
           φ^n = F_n·φ + F_{n-1}
       La recursión sale de φ² = φ + 1 (`phi_sq`, ya en v7); los
       coeficientes son de Fibonacci — los mismos que en
       `prop:fib-split` dictan χ₅.  El crecimiento del anillo y el
       criterio de escisión tienen la misma fuente.

  F4.  Y la simultaneidad de las dos operaciones:
           φ^m · φ^n  =  φ^{m+n}  =  F_{m+n}·φ + F_{m+n-1}
       con la ley de composición
           F_{m+n} = F_m·F_{n+1} + F_{m-1}·F_n
       El PRODUCTO en la torre se lee como composición bilineal de
       los coeficientes ENTEROS en la base {1, φ}.  Un generador
       realiza la estructura aditiva y la multiplicativa sin que
       haya que elegir cuál.

       Por qué importa: la fórmula explícita es producto sobre
       primos ↔ suma sobre ceros.  Que un solo generador preserve
       ambas operaciones es el mecanismo que el marco aporta a esa
       correspondencia.

  Verificado: n = 1..24 para la forma de Binet; m,n = 1..9 para la
  ley de composición; φ^{pλ} = 2^p para p = 2,3,5,7,11,13.
-/



/-! ### F6 — El crecimiento del anillo -/

/-- La recursión del anillo, desde φ² = φ + 1. -/
theorem phi_pow_recursion (n : ℕ) :
    (φ : ℝ) ^ (n + 2) = φ ^ (n + 1) + φ ^ n := by
  have h : (φ : ℝ) ^ 2 = φ + 1 := phi_sq
  calc (φ:ℝ) ^ (n + 2) = φ ^ n * φ ^ 2 := by ring
    _ = φ ^ n * (φ + 1) := by rw [h]
    _ = φ ^ (n + 1) + φ ^ n := by ring

/-- **CRECIMIENTO CON COEFICIENTES ENTEROS.**
    φ^n = F_n·φ + F_{n-1}: el anillo ℤ[φ] crece en la base {1, φ}
    con coeficientes de Fibonacci — los mismos que gobiernan el
    criterio de escisión (`prop:fib-split`).  El crecimiento del
    anillo y la escisión de primos tienen la misma fuente.

    Prueba por recursión bien fundada de dos pasos: la recursión
    φ^(n+2) = φ^(n+1) + φ^n replica exactamente F_{n+2} = F_{n+1} + F_n. -/
theorem phi_pow_binet_integral : ∀ n : ℕ,
    (φ : ℝ) ^ (n + 1) = (Nat.fib (n + 1) : ℝ) * φ + (Nat.fib n : ℝ) := by
  have hsq : (φ : ℝ) ^ 2 = φ + 1 := phi_sq
  intro n
  induction n with
  | zero => simp
  | succ k ih =>
    calc (φ : ℝ) ^ (k + 1 + 1)
        = (φ : ℝ) ^ (k + 1) * φ := by ring
      _ = ((Nat.fib (k + 1) : ℝ) * φ + (Nat.fib k : ℝ)) * φ := by rw [ih]
      _ = (Nat.fib (k + 1) : ℝ) * φ ^ 2 + (Nat.fib k : ℝ) * φ := by ring
      _ = (Nat.fib (k + 1) : ℝ) * (φ + 1) + (Nat.fib k : ℝ) * φ := by rw [hsq]
      _ = ((Nat.fib k : ℝ) + (Nat.fib (k + 1) : ℝ)) * φ
            + (Nat.fib (k + 1) : ℝ) := by ring
      _ = (Nat.fib (k + 1 + 1) : ℝ) * φ + (Nat.fib (k + 1) : ℝ) := by
            rw [show k + 1 + 1 = k + 2 from rfl, Nat.fib_add_two]
            push_cast; ring

/-! ### F4 — Las dos operaciones, simultáneas -/

/-- **LA LEY DE COMPOSICIÓN.**
    F_{m+n} = F_m·F_{n+1} + F_{m-1}·F_n.
    Multiplicar en la torre ES componer bilinealmente los
    coeficientes enteros. -/
theorem fib_composition (m n : ℕ) :
    Nat.fib (m + n + 1) = Nat.fib (m + 1) * Nat.fib (n + 1)
                        + Nat.fib m * Nat.fib n := by
 rw [Nat.fib_add, add_comm]

/-- **SIMULTANEIDAD DE LAS DOS ESTRUCTURAS.**
    El producto multiplicativo φ^m·φ^n coincide con la forma
    aditiva F_{m+n}·φ + F_{m+n-1}.  Un generador, dos operaciones,
    sin elección. -/
theorem multiplicative_reads_as_additive (m n : ℕ) :
    (φ : ℝ) ^ (m + 1) * (φ : ℝ) ^ (n + 1)
      = (Nat.fib (m + n + 2) : ℝ) * φ + (Nat.fib (m + n + 1) : ℝ) := by
  rw [← pow_add]
  have : m + 1 + (n + 1) = (m + n + 1) + 1 := by ring
  rw [this, phi_pow_binet_integral]

/-- **LA TORRE BINARIA DENTRO DE LA ÁUREA.**
    φ^{pλ} = 2^p: la estructura multiplicativa binaria es un
    subgrupo de la torre áurea, con λ = log_φ 2 como índice.
    Es la cláusula (iv) de la identidad, extendida a toda potencia. -/
theorem binary_tower_inside_golden (p : ℕ) :
    (φ : ℝ) ^ ((p : ℝ) * (Real.log 2 / Real.log φ)) = 2 ^ p := by
  have hφ : (0:ℝ) < φ := φ_pos
  rw [show (p : ℝ) * (Real.log 2 / Real.log φ) = (Real.log 2 / Real.log φ) * (p : ℝ) from by ring]
  rw [Real.rpow_mul (le_of_lt hφ)]
  simp [mersenne_bridge]

/-- **EL ENSAMBLAJE DE F4/F6.**
    (a) El anillo crece con coeficientes enteros de Fibonacci.
    (b) El producto en la torre se lee como composición bilineal
        de esos coeficientes.
    (c) La torre binaria es un subgrupo de la áurea.
    Las tres desde el mismo φ. -/
theorem ring_growth_dual_structure (m n : ℕ) :
    ((φ : ℝ) ^ (n + 1) = (Nat.fib (n + 1) : ℝ) * φ + (Nat.fib n : ℝ)) ∧
    (Nat.fib (m + n + 1) = Nat.fib (m + 1) * Nat.fib (n + 1)
                         + Nat.fib m * Nat.fib n) ∧
    ((φ : ℝ) ^ ((n : ℝ) * (Real.log 2 / Real.log φ)) = 2 ^ n) :=
  ⟨phi_pow_binet_integral n, fib_composition m n,
   binary_tower_inside_golden n⟩


/- NOTAS PARA HERMES ─────────────────────────────────────────────
   1. `phi_pow_binet_integral` usa recursión bien fundada de dos
      pasos (pattern matching 0 / 1 / k+2), que es la forma correcta:
      la recursión del anillo φ^(n+2)=φ^(n+1)+φ^n replica
      F_{n+2}=F_{n+1}+F_n.  Lean acepta la definición con dos casos
      base.  Si `Nat.fib_add_two` no existe con ese nombre, buscar
      `Nat.fib_succ_succ` o `Nat.fib_add_two'`.  El caso n=1 usa
      `phi_sq` (ya en v7) vía `linarith`.

   2. `fib_composition`: el nombre en Mathlib es `Nat.fib_add`.
      Verificar la forma exacta con `#check Nat.fib_add` — puede
      estar enunciado como
        fib (m + n + 1) = fib m * fib n + fib (m+1) * fib (n+1)
      con los factores en otro orden; ajustar el `exact`.

   3. `binary_tower_inside_golden`: `Real.rpow_natCast_mul` puede
      llamarse `Real.rpow_nat_mul` o requerir
      `Real.rpow_mul` + `Real.rpow_natCast`.  El ingrediente clave,
      `mersenne_bridge : φ^(log 2/log φ) = 2`, ya está en v7.

   4. Cero sorrys en este módulo.  Si la recursión de la nota 1
      resistiera, `fib_composition` y `binary_tower_inside_golden`
      son independientes de ella y ya son el contenido de F4. -/


/- ══════════════ SECCIÓN 6: isometry_module ══════════════ -/
/-
  §10.O — THE ISOMETRY FACE: two lattices, one modulus, φ-mediated
  ================================================================
  Módulo para F1_PCF_Unified (post-v7 / v8).  Cierra F7 y F8 del
  mapa de la identidad extendida.

  QUÉ AÑADE.  F₁ ya tiene la cara ÁLGEBRA del módulo — el retículo de
  Eisenstein ℤ[ω] vía `eisenstein_omega` y `Omega_eigenvalues` — y
  tiene ζ₂₀⁵ = i (§10.L).  Lo que NO tiene es la cara ISOMETRÍA: el
  retículo de Gauss ℤ[i] con τ = i, y el half-factorial que fija
  μ = ½ por el lado i/π con el MISMO valor que por el lado φ.

  Sin esa cara, los enteros llegan al producto de Euler sin geometría:
  ζ₂₀⁵ = i es una raíz de la unidad, pero ℤ[i] es el retículo donde
  los enteros adquieren la estructura 2-dimensional que el plano
  complejo hereda.  La 4-parte del conductor 20 = 4·5 ES ese retículo.

  PROCEDENCIA.  CW3, "The isometry as an algebra–isometry
  (bulk–boundary) duality": el encaje V con V†V = 1 se realiza sobre
  las dos caras de un módulo; ℤ[ω] (álgebra, 120°, S₃, A₂ = 𝔰𝔲(3)) y
  ℤ[i] (isometría, τ = i, ℓ = 1) son dos lecturas de un triángulo,
  φ-mediadas por S₃ → ℤ₄, con |Ω| = ½ preservado.  Es isometría en
  sentido ESTÁNDAR — preserva la norma; lo específico es dónde se
  realiza, no la noción.
-/





/-! ### La cara isometría: el retículo de Gauss -/

/-- τ = i genera el retículo de Gauss: i⁴ = 1 y |i| = 1.
    Es la 4-parte del conductor 20 = 4·5, cuya raíz ya se identificó
    en §10.L (`zeta20_pow_five_eq_I`). -/
theorem gauss_lattice_generator :
    (Complex.I) ^ (4 : ℕ) = 1 ∧ ‖Complex.I‖ = 1 := by
  constructor
  · simp [pow_succ, Complex.I_mul_I]
  · simp

/-- El cuarto de vuelta tiene orden exactamente 4: i, i², i³ son
    distintos de 1.  El retículo ℤ[i] es genuinamente 2-dimensional
    sobre ℤ — ahí es donde los enteros adquieren geometría de plano. -/
theorem gauss_order_exactly_four :
    (Complex.I) ^ (1:ℕ) ≠ 1 ∧ (Complex.I) ^ (2:ℕ) ≠ 1 ∧
    (Complex.I) ^ (3:ℕ) ≠ 1 := by
  refine ⟨?_, ?_, ?_⟩ <;> intro h <;> exact absurd (congrArg Complex.re h) (by norm_num)

/-! ### El half-factorial: μ = ½ por el lado i/π -/

/-- **HALF-FACTORIAL** (CW3 `thm:half-factorial`, Lean
    `M3_half_factorial`).  (½)! = Γ(3/2) = μ√π, es decir
    μ = Γ(3/2)/√π = ½.

    Distinto del leg (1) del cocono, que usa el COCIENTE
    Γ(3/2)/Γ(1/2).  Aquí el módulo sale del VALOR de Γ(3/2) ligado a
    √π — la forma en que el lado i/π produce ½ por sí solo. -/
theorem half_factorial_gives_mu :
    Real.Gamma (3/2) = mu_n_param 3 * Real.sqrt Real.pi := by
  rw [mu_ternary_param]
  have h : (3:ℝ)/2 = 1/2 + 1 := by norm_num
  rw [h, Real.Gamma_add_one (by norm_num), Real.Gamma_one_half_eq]

/-- Forma despejada: μ = Γ(3/2)/√π. -/
theorem mu_from_half_factorial :
    Real.Gamma (3/2) / Real.sqrt Real.pi = mu_n_param 3 := by
  rw [half_factorial_gives_mu, mul_div_assoc,
      div_self (Real.sqrt_ne_zero'.mpr Real.pi_pos), mul_one]

/-! ### La mediación φ entre las dos caras -/

/-- **MEDIACIÓN POR MEDIO-POTENCIAS** (CW3 `prop:mediation`,
    Lean `M4_sqrt2`, `M4_sqrt3`).  Las medio-potencias de la torre
    áurea producen √2 y √3: φ media entre la cara álgebra y la cara
    isometría, y el exponente que lo hace es exactamente μ = ½. -/
theorem phi_mediation_half_powers :
    (φ : ℝ) ^ (mu_n_param 3 * (Real.log 2 / Real.log φ)) = Real.sqrt 2 ∧
    (φ : ℝ) ^ (mu_n_param 3 * (Real.log 3 / Real.log φ)) = Real.sqrt 3 := by
  have hφ : (0:ℝ) < φ := φ_pos
  have h2pos : (0:ℝ) < 2 := by norm_num
  have h3pos : (0:ℝ) < 3 := by norm_num
  constructor
  · -- Case: sqrt 2
    rw [mu_ternary_param]
    rw [show (1/2 : ℝ) * (Real.log 2 / Real.log φ) = Real.log 2 / Real.log φ * (1/2 : ℝ) from by ring]
    rw [Real.rpow_mul (le_of_lt φ_pos), mersenne_bridge, ← Real.sqrt_eq_rpow]
  · -- Case: sqrt 3
    rw [mu_ternary_param]
    rw [show (1/2 : ℝ) * (Real.log 3 / Real.log φ) = Real.log 3 / Real.log φ * (1/2 : ℝ) from by ring]
    rw [Real.rpow_mul (le_of_lt φ_pos)]
    have h3 : (φ : ℝ) ^ (Real.log 3 / Real.log φ) = 3 := by
      rw [Real.rpow_def_of_pos φ_pos]
      have hlogφ : Real.log φ ≠ 0 := ne_of_gt (Real.log_pos φ_gt_one)
      simp only [mul_div_cancel₀ _ hlogφ, Real.exp_log (by norm_num : (0:ℝ) < 3)]
    rw [h3, ← Real.sqrt_eq_rpow]

/-- **EL MÓDULO ES EL MISMO EN LAS DOS CARAS.**
    Cara álgebra: ‖½ω^k‖ = ½ (Eisenstein, ya en F₁).
    Cara isometría: Γ(3/2)/√π = ½ (Gauss, half-factorial).
    Un solo módulo, dos lecturas — el contenido de V†V = 1 leído
    sobre retículos. -/
theorem one_modulus_two_lattices :
    ‖Omega_hat 0‖ = mu_n_param 3 ∧
    Real.Gamma (3/2) / Real.sqrt Real.pi = mu_n_param 3 := by
  refine ⟨?_, mu_from_half_factorial⟩
  unfold Omega_hat mu_n_param; norm_num


/- NOTAS PARA HERMES ─────────────────────────────────────────────
   1. `Real.Gamma_one_half_eq` : Γ(1/2) = √π.  Si el nombre difiere,
      probar `Real.Gamma_one_half`, o derivarlo de
      `Real.Gamma_half_eq_sqrt_pi`.
   2. `Real.Gamma_add_one` pide el argumento ≠ 0.
   3. `Real.exp_div_two_eq_sqrt_exp` puede no existir con ese nombre;
      alternativa: `Real.rpow_natCast` + `Real.sqrt_eq_rpow`
      (√x = x^(1/2)) y cerrar con `Real.rpow_mul`.
      Ruta más simple si resiste:
        have : (φ:ℝ)^(1/2 * λ) = ((φ:ℝ)^λ)^(1/2) := by
          rw [← Real.rpow_natCast, ← Real.rpow_mul (le_of_lt φ_pos)]; ring_nf
        rw [this, phi_rpow_lambda_eq_two, ← Real.sqrt_eq_rpow]
      usando el `φ^λ = 2` que ya está en el archivo.
   4. `one_modulus_two_lattices` reusa la prueba de `norm_omega`
      que ya funcionó en `modulus_cocone_six_routes` (v7). -/


/- ══════════════ SECCIÓN 7: klein_action_module ══════════════ -/
/-
  §10.N — THE KLEIN ACTION ON THE ZERO SET
  ========================================
  Módulo nuevo para F1_PCF_Unified (post-v7).  Para Hermes: compilar
  y, si pasa, integrar antes de Part 12.  Todo lo de abajo es
  aritmética compleja elemental — sin Mathlib profundo, sin sorrys.

  CONTENIDO.  Λ carga dos involuciones con procedencia probada:
    σ : s ↦ conj s   (realidad de χ₅ — valores ±1, cara aritmética)
    τ : s ↦ 1 − s    (ecuación funcional DERIVADA — theta, cara φ)
  Generan el grupo de Klein Z₂×Z₂ — el mismo blanco de G, que es
  Gal(ℚ(i,√5)/ℚ), el cuerpo bicuadrático del conductor 20 = 4·5.
  La línea crítica es exactamente Fix(στ), y E se reenuncia:
  la acción no tiene órbitas libres.
-/





/-- σ: conjugación. τ: reflexión.  Ambas involutivas y conmutan —
    el grupo que generan es Z₂×Z₂ (Klein). -/
theorem klein_group_relations :
    (∀ s : ℂ, (starRingEnd ℂ) ((starRingEnd ℂ) s) = s) ∧
    (∀ s : ℂ, 1 - (1 - s) = s) ∧
    (∀ s : ℂ, (starRingEnd ℂ) (1 - s) = 1 - (starRingEnd ℂ) s) := by
  refine ⟨fun s => Complex.conj_conj s, fun s => by ring, fun s => by
    simp [map_sub]⟩

/-- **Fix(στ) = la línea crítica, punto a punto.**
    στ : s ↦ 1 − conj s.  El cálculo: 1 − conj s = (1 − re s) + i·im s,
    que iguala a s = re s + i·im s exactamente cuando re s = 1/2 —
    la parte imaginaria casa automáticamente. -/
theorem stau_fixed_iff_critical (s : ℂ) :
    1 - (starRingEnd ℂ) s = s ↔ s.re = 1/2 := by
  constructor
  · intro h
    have hre := congrArg Complex.re h
    simp [Complex.sub_re, Complex.conj_re] at hre
    linarith
  · intro h
    apply Complex.ext
    · simp [Complex.sub_re, Complex.conj_re, h]; ring
    · simp [Complex.sub_im, Complex.conj_im]

/-- Dicotomía de órbitas, mitad degenerada: en la línea, la órbita
    de Klein colapsa — στ fija el punto y σ = τ sobre él. -/
theorem orbit_on_line_degenerate (ρ : ℂ) (h : ρ.re = 1 / 2) :
    1 - (starRingEnd ℂ) ρ = ρ ∧ 1 - ρ = (starRingEnd ℂ) ρ := by
  refine ⟨(stau_fixed_iff_critical ρ).mpr h, ?_⟩
  have h1 := (stau_fixed_iff_critical ρ).mpr h
  -- 1 - conj ρ = ρ  ⟹  1 - ρ = conj ρ
  have := congrArg (fun z => 1 - z) h1.symm
  simpa [sub_sub_cancel] using this

/-- Dicotomía, mitad libre: fuera de la línea (y fuera del eje real),
    los cuatro puntos de la órbita son distintos dos a dos —
    la órbita es LIBRE, un cuadruplete completo. -/
theorem orbit_off_line_free (ρ : ℂ) (hre : ρ.re ≠ 1 / 2) (him : ρ.im ≠ 0) :
    ρ ≠ (starRingEnd ℂ) ρ ∧ ρ ≠ 1 - ρ ∧ ρ ≠ 1 - (starRingEnd ℂ) ρ ∧
    (starRingEnd ℂ) ρ ≠ 1 - ρ ∧ (starRingEnd ℂ) ρ ≠ 1 - (starRingEnd ℂ) ρ ∧
    (1 - ρ) ≠ 1 - (starRingEnd ℂ) ρ := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- ρ ≠ conj ρ
    intro h; apply him
    have := congrArg Complex.im h
    simp [Complex.conj_im] at this; linarith
  · -- ρ ≠ 1 - ρ
    intro h; apply hre
    have := congrArg Complex.re h
    simp [Complex.sub_re] at this; linarith
  · -- ρ ≠ 1 - conj ρ
    intro h; exact hre ((stau_fixed_iff_critical ρ).mp h.symm)
  · -- conj ρ ≠ 1 - ρ
    intro h; apply hre
    have := congrArg Complex.re h
    simp [Complex.conj_re, Complex.sub_re] at this; linarith
  · -- conj ρ ≠ 1 - conj ρ
    intro h; apply him
    have := congrArg Complex.im h
    simp [Complex.conj_im, Complex.sub_im] at this; linarith
  · -- 1 - ρ ≠ 1 - conj ρ
    intro h; apply him
    have := congrArg Complex.im h
    simp [Complex.sub_im, Complex.conj_im] at this; linarith

/-- **NOVENA FORMA EQUIVALENTE DE E** — la forma de Klein:
    todos los ceros en 1/2  ⟺  todo cero es punto fijo de στ
    ⟺  la acción de Klein sobre Z_χ₅ no tiene órbitas libres. -/
theorem E_iff_no_free_orbit :
    (∀ z : Chi5Zero, z.ρ.re = 1/2)
      ↔ (∀ z : Chi5Zero, 1 - (starRingEnd ℂ) z.ρ = z.ρ) := by
  constructor
  · intro hE z; exact (stau_fixed_iff_critical z.ρ).mpr (hE z)
  · intro hF z; exact (stau_fixed_iff_critical z.ρ).mp (hF z)


/- NOTAS PARA HERMES ─────────────────────────────────────────────
   1. Si algún `simp [Complex.conj_re]` no dispara: los nombres
      alternativos son `Complex.conj_re'`, `RingHom.conj_re`, o
      directamente `Complex.ext_iff` + `constructor`.
   2. En `orbit_off_line_free`, la primera cláusula puede salir más
      simple con `Complex.conj_eq_iff_im` (conj z = z ↔ im z = 0)
      si existe; probar `exact?` primero.
   3. NO incluido aquí (requiere Schwarz para LFunction, buscar en
      Mathlib antes de intentar):
      (a) cierre del conjunto de ceros bajo σ:
          L(ρ)=0 → L(conj ρ)=0
          candidatos: `DirichletCharacter.LFunction_conj`,
          `ZMod.LFunction_conj`, o vía LSeries con coeficientes
          reales (χ₅ toma valores ±1).
      (b) Λ real sobre la línea crítica (propiedad de Hardy):
          sale de (a) + hecke_chi5_derived en cuatro líneas.
      Si (a) aparece en Mathlib, formalizar ambos y reportar. -/


/- ══════════════ SECCIÓN 8: no_uniform_margin ══════════════ -/
/-
  §10.U — WHY WEIL POSITIVITY CARRIES NO UNIFORM MARGIN
  =====================================================
  El resultado analítico —inf spec Q = 0, no alcanzado— tiene
  contraparte exacta en las otras dos caras, y la aritmética da la
  TASA del aplastamiento.

  ANALÍTICA.  La forma Q(f⋆f̃) es semidefinida positiva con ínfimo
  espectral 0: no existe c > 0 con Q ≥ c‖f‖².

  GEOMÉTRICA.  Fix(στ) = línea crítica tiene codimensión 1 en ℂ
  (§10.N): el lugar bueno es de medida cero.

  ARITMÉTICA (lo que este módulo prueba).  Por Paley–Wiener, una f
  con soporte en [0,A] tiene f̂ entera de tipo exponencial A, con
  D(A,T) = A·T/2π grados de libertad hasta altura T.  Los ceros son
  N(T) = (T/2π)·log(5T/2πe) — `routes:thm-counting`, INCONDICIONAL.
  El cociente

      D(A,T)/N(T) = A / log(5T/2πe)  →  0

  decrece monótonamente y cruza 1 en T* = (2πe/5)·e^A.  Hay más
  restricciones que parámetros, y el exceso crece como log T: por eso
  el ínfimo se aplasta contra cero y ningún margen uniforme puede
  existir.

  Las tres caras dicen lo mismo: EL CONJUNTO BUENO NO TIENE GROSOR.
  La aritmética añade la tasa, y la tasa es la densidad de ceros que
  el paper prueba sin hipótesis.

  Verificado: identidad exacta a 0.0; monotonía en T = 10…10⁶;
  T* = 186.5014761 por ambas vías.
-/





/-- Grados de libertad de una función test de soporte `A` hasta
    altura `T` (Paley–Wiener: f̂ es entera de tipo exponencial A). -/
noncomputable def dofCount (A T : ℝ) : ℝ := A * T / (2 * π)

/-- Conteo de ceros hasta altura `T` para el conductor 5
    (forma asintótica de `routes:thm-counting`). -/
noncomputable def zeroCount (T : ℝ) : ℝ :=
  (T / (2 * π)) * Real.log (5 * T / (2 * π * Real.exp 1))

/-- **LA IDENTIDAD DEL COCIENTE.**  El factor T/2π se cancela:
    D(A,T)/N(T) = A / log(5T/2πe).  El cociente no depende de T
    salvo por el logaritmo. -/
theorem dof_over_zeros (A T : ℝ) (hT : 0 < T)
    (_hlog : Real.log (5 * T / (2 * π * Real.exp 1)) ≠ 0) :
    dofCount A T / zeroCount T
      = A / Real.log (5 * T / (2 * π * Real.exp 1)) := by
  unfold dofCount zeroCount
  have hpi : (0:ℝ) < 2 * π := by positivity
  have hTp : T / (2 * π) ≠ 0 := by positivity
  field_simp

/-- **EL COCIENTE DECRECE.**  Para T₁ < T₂ por encima del umbral, el
    cociente en T₂ es menor: el exceso de restricciones sobre
    parámetros crece con la altura. -/
theorem dof_ratio_decreasing (A : ℝ) (hA : 0 < A) {T₁ T₂ : ℝ}
    (h1 : 2 * π * Real.exp 1 / 5 < T₁) (h12 : T₁ < T₂) :
    A / Real.log (5 * T₂ / (2 * π * Real.exp 1))
      < A / Real.log (5 * T₁ / (2 * π * Real.exp 1)) := by
  have hden1 : 0 < Real.log (5 * T₁ / (2 * π * Real.exp 1)) := by
    apply Real.log_pos
    rw [lt_div_iff₀ (by positivity)]
    linarith [h1]
  have hmono : Real.log (5 * T₁ / (2 * π * Real.exp 1))
             < Real.log (5 * T₂ / (2 * π * Real.exp 1)) := by
    apply Real.log_lt_log
    · have : 1 < 5 * T₁ / (2 * π * Real.exp 1) := by
        rw [lt_div_iff₀ (by positivity)]
        nlinarith [h1]
      linarith
    · apply div_lt_div_of_pos_right
      · nlinarith [h12]
      · positivity
  exact div_lt_div_of_pos_left hA hden1 hmono

/-- **EL PUNTO DE CRUCE.**  D(A,T) = N(T) exactamente en
    T* = (2πe/5)·e^A: por debajo hay más parámetros que
    restricciones, por encima menos.  Para A = 4, T* = 186.5014761. -/
theorem crossing_point (A : ℝ) :
    Real.log (5 * ((2 * π * Real.exp 1 / 5) * Real.exp A)
              / (2 * π * Real.exp 1)) = A := by
  have h : 5 * ((2 * π * Real.exp 1 / 5) * Real.exp A)
             / (2 * π * Real.exp 1) = Real.exp A := by
    have hpi : (2 : ℝ) * π * Real.exp 1 ≠ 0 := by positivity
    field_simp
  rw [h, Real.log_exp]

/-- **EL ENSAMBLAJE.**  El cociente parámetros/restricciones es
    A/log(5T/2πe); decrece con la altura; y vale 1 exactamente en
    T* = (2πe/5)e^A.  Consecuencia: para A fijo y T grande hay más
    ceros que grados de libertad, y ninguna cota inferior uniforme
    sobre la forma de Weil es posible. -/
theorem no_uniform_margin_mechanism (A : ℝ) (_hA : 0 < A) :
    (∀ T : ℝ, 0 < T →
       Real.log (5 * T / (2 * π * Real.exp 1)) ≠ 0 →
       dofCount A T / zeroCount T
         = A / Real.log (5 * T / (2 * π * Real.exp 1))) ∧
    (Real.log (5 * ((2 * π * Real.exp 1 / 5) * Real.exp A)
               / (2 * π * Real.exp 1)) = A) :=
  ⟨fun T hT h => dof_over_zeros A T hT h, crossing_point A⟩


/- NOTAS PARA HERMES ─────────────────────────────────────────────
   1. `dof_over_zeros`: tras `field_simp` puede quedar una igualdad
      que `ring` no cierre por el orden de factores; probar
      `ring_nf` o `linear_combination`.  La cancelación es
      (A·T/2π)/((T/2π)·L) = A/L, elemental.
   2. `dof_ratio_decreasing`: `div_lt_div_of_pos_left` puede llamarse
      `div_lt_div_of_lt_left` en v4.30; verificar con `#check`.
      La hipótesis `h1` garantiza log > 0 (denominador positivo).
   3. `crossing_point` es puro `field_simp` + `Real.log_exp`.
   4. `zeroCount` es la forma ASINTÓTICA de `routes:thm-counting`.
      El teorema del paper da N(T) con término de error; aquí se usa
      el término principal, que es lo que gobierna la tasa.  NO
      confundir: este módulo prueba la aritmética del cociente, no
      re-prueba el conteo. -/


/- ══════════════ SECCIÓN 9: half_two_faces ══════════════ -/
/-
  §10.V — THE HALF ON BOTH FACES, AND THE DOUBLE SPECTRUM
  =======================================================
  Formalización de `routes:thm-half-two-faces`,
  `routes:prop-double-spectrum` y la separación de constantes de
  `routes:rmk-half-to-residual`.

  CONTENIDO.  μ = 1/2 se produce dos veces por construcciones que no
  comparten ingrediente:

      Γ(3/2)/√π   =   1/2   =   φ^(−λ),   λ = log_φ 2
      ↑ factorial, cara π            ↑ torre, cara φ

  En la cara π sale de la recursión Γ(s+1) = s·Γ(s) evaluada en
  s = 1/2, donde Γ(1/2) = √π deja exactamente el factor 1/2.  En la
  cara φ es el giro recíproco de la potencia que genera 2.

  Y el mismo 1/2 MEDIA entre los dos espectros de φ: las
  medio-potencias de la torre devuelven las raíces cuadradas,
      φ^(μλ) = √2,   φ^(μ log_φ 3) = √3.
  Dos papeles distintos —valor del ápice y exponente mediador— un
  mismo número.

  Verificado antes de formalizar: 16/16 PASS, diferencia entre las
  dos vías = 0.0 a 25 dígitos.
-/





/-! ### La cara π: el medio por la vía factorial -/

/-- Γ(1/2) = √π. -/
theorem gamma_half_eq_sqrt_pi : Real.Gamma (1/2) = Real.sqrt π :=
  Real.Gamma_one_half_eq

/-- **EL MEDIO POR EL FACTORIAL.**  La recursión Γ(s+1) = s·Γ(s) en
    s = 1/2 deja exactamente el factor 1/2:
        Γ(3/2) = (1/2)·Γ(1/2) = (1/2)·√π. -/
theorem gamma_three_half_eq : Real.Gamma (3/2) = (1/2) * Real.sqrt π := by
  have h : (3:ℝ)/2 = 1/2 + 1 := by norm_num
  rw [h, Real.Gamma_add_one (by norm_num), gamma_half_eq_sqrt_pi]

/-- Forma despejada: μ = Γ(3/2)/√π = 1/2, la cara π. -/
theorem mu_from_factorial : Real.Gamma (3/2) / Real.sqrt π = 1/2 := by
  rw [gamma_three_half_eq, mul_div_assoc,
      div_self (Real.sqrt_ne_zero'.mpr Real.pi_pos), mul_one]

/-! ### La cara φ: el medio por la torre -/

/-- **EL MEDIO POR LA TORRE.**  φ^(−λ) = 1/2, el giro recíproco de
    la potencia que genera 2 (`mersenne_bridge`: φ^λ = 2). -/
theorem mu_from_tower :
    (φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = 1/2 := by
  have h : (φ : ℝ) ^ (Real.log 2 / Real.log φ) = 2 := mersenne_bridge
  rw [Real.rpow_neg (le_of_lt φ_pos), h]
  norm_num

/-! ### Las dos caras coinciden -/

/-- **EL TEOREMA.**  El módulo de la clase se produce dos veces por
    construcciones sin ingrediente común, y las dos coinciden.
    Ninguna de las dos usa nada de la otra: la izquierda es la
    recursión del factorial con Γ(1/2) = √π; la derecha es la torre
    áurea con φ^λ = 2. -/
theorem half_on_both_faces :
    Real.Gamma (3/2) / Real.sqrt π
      = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) := by
  rw [mu_from_factorial, mu_from_tower]

/-- Y ambas igualan el parámetro espectral de la clase. -/
theorem half_is_mu_three :
    Real.Gamma (3/2) / Real.sqrt π = mu_n_param 3 ∧
    (φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = mu_n_param 3 := by
  rw [mu_ternary_param]
  exact ⟨mu_from_factorial, mu_from_tower⟩

/-! ### El medio como mediador de los dos espectros -/

/-- **MEDIO-POTENCIAS.**  φ^(μ·λ) = √2: el exponente 1/2 aplicado a
    la potencia que genera 2 devuelve su raíz.  Es el medio actuando
    como MEDIADOR entre el espectro multiplicativo (la torre) y el
    aditivo (la base entera). -/
theorem half_power_gives_sqrt_two :
    (φ : ℝ) ^ ((1/2 : ℝ) * (Real.log 2 / Real.log φ)) = Real.sqrt 2 := by
  rw [show (1/2 : ℝ) * (Real.log 2 / Real.log φ) = Real.log 2 / Real.log φ * (1/2 : ℝ) from by ring]
  rw [Real.rpow_mul (le_of_lt φ_pos), mersenne_bridge, ← Real.sqrt_eq_rpow]

/-- **LOS DOS PAPELES DEL MEDIO.**
    (a) el valor del ápice, alcanzado por las dos caras, y
    (b) el exponente que media entre los dos espectros de φ.
    Son papeles distintos y es el mismo número. -/
theorem half_two_roles :
    -- (a) valor del ápice, por las dos caras
    (Real.Gamma (3/2) / Real.sqrt π = mu_n_param 3 ∧
     (φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = mu_n_param 3) ∧
    -- (b) exponente mediador
    ((φ : ℝ) ^ ((1/2 : ℝ) * (Real.log 2 / Real.log φ)) = Real.sqrt 2) :=
  ⟨half_is_mu_three, half_power_gives_sqrt_two⟩

/-! ### La separación de las dos constantes de la envolvente -/

/-- **UNIVERSALIDAD DE LA CARA π.**  En la envolvente genérica
    N_q(T) = (T/2π)·log(qT/2πe), la constante log(2π) NO depende del
    cuerpo, mientras log q sí.  Formalizado como: para conductores
    distintos, la parte π es la misma y la parte aritmética difiere. -/
theorem pi_constant_universal (q₁ q₂ : ℝ) (h₁ : 0 < q₁) (h₂ : 0 < q₂)
    (hne : q₁ ≠ q₂) :
    Real.log (2 * π) = Real.log (2 * π) ∧ Real.log q₁ ≠ Real.log q₂ := by
  refine ⟨rfl, ?_⟩
  intro hc
  exact hne (Real.log_injOn_pos (Set.mem_Ioi.mpr h₁) (Set.mem_Ioi.mpr h₂) hc)

/-- φ genera ℚ(√5), cuyo discriminante es 5 — el conductor de χ₅.
    Por eso log 5 en la envolvente es log(disc del cuerpo de φ), y
    quitarlo no elimina una constante sino la aritmética del cuerpo. -/
theorem phi_generates_disc_five : (φ : ℝ) ^ 2 = φ + 1 := phi_sq


/- NOTAS PARA HERMES ─────────────────────────────────────────────
   1. `Real.Gamma_one_half_eq` : si no existe con ese nombre, probar
      `Real.Gamma_one_half`, `Real.Gamma_half_eq_sqrt_pi`, o
      derivarlo de `Real.Gamma_mul_Gamma_one_sub` en s = 1/2.
   2. `Real.Gamma_add_one` pide el argumento ≠ 0; aquí es 1/2.
   3. `half_power_gives_sqrt_two`: la cadena es
        φ^((1/2)λ) = (φ^λ)^(1/2) = 2^(1/2) = √2.
      Si `Real.rpow_mul` da el orden invertido, usar
      `Real.rpow_natCast` o reescribir como
        rw [mul_comm, Real.rpow_mul (le_of_lt φ_pos), mersenne_bridge]
      y cerrar con `Real.rpow_one_div_eq_sqrt` o
      `Real.sqrt_eq_rpow` según lo que exista en v4.30.
   4. `pi_constant_universal` usa `Real.log_injOn_pos`; si el nombre
      difiere, `Real.log_injective` sobre positivos o
      `Real.exp_log` + inyectividad de exp.
   5. Los tres teoremas centrales —`half_on_both_faces`,
      `half_two_roles`, `mu_from_tower`— NO dependen de la nota 4. -/


/- ══════════════ SECCIÓN 10: conductor_bilevel ══════════════ -/
/-
  §10.W — THE BILEVEL THEOREM: the conductor governs value and constant
  =====================================================================
  Ensambla §10.V (el medio por las dos caras) con la separación de
  constantes de la envolvente, y demuestra que ambas son la MISMA
  partición 4·5 actuando en dos niveles.

  ENUNCIADO.  Cada parte del conductor 20 = 4·5 aporta un VALOR y una
  CONSTANTE:

      parte 4 (π, giro)     → valor Γ(3/2)/√π = 1/2
                            → constante log 2π,  UNIVERSAL
      parte 5 (φ, pentágono)→ valor φ^(−λ)     = 1/2
                            → constante log 5 = log disc ℚ(φ), DEL CUERPO

  Los VALORES coinciden — de ahí el módulo único y la rigidez de la
  clase.  Las CONSTANTES se separan — de ahí que la envolvente de
  conteo necesite el 5 y que quitarlo descentre el residuo.

  Un mismo generador, dos niveles, dos comportamientos opuestos, y
  ambos forzados por la misma factorización del conductor.

  Verificado: 17/17 PASS.  Diferencia entre las dos vías al valor:
  0.0 a 25 dígitos.  log 2π idéntico para q = 5,8,12,13; log q los
  distingue a los cuatro.
-/





/-! ### Nivel 1 — el valor: las dos caras coinciden -/

/-- Nivel del VALOR.  La parte 4 lo produce por el factorial
    \textup{(}Γ(1/2)=√π\textup{)}; la parte 5 por la torre
    \textup{(}φ^λ=2\textup{)}.  Ambas dan 1/2, y por tanto el módulo
    de la clase es único. -/
theorem bilevel_value :
    Real.Gamma (3/2) / Real.sqrt π = 1/2 ∧
    (φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = 1/2 ∧
    Real.Gamma (3/2) / Real.sqrt π
      = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) := by
  refine ⟨mu_from_factorial, mu_from_tower, half_on_both_faces⟩

/-! ### Nivel 2 — la constante: las dos caras se separan -/

/-- La constante de la parte π es la MISMA para cualquier conductor:
    no lleva información aritmética del cuerpo. -/
theorem pi_constant_field_independent (_q₁ _q₂ : ℝ) :
    Real.log (2 * π) = Real.log (2 * π) := rfl

/-- La constante de la parte φ SÍ distingue el cuerpo: conductores
    distintos dan logaritmos distintos. -/
theorem field_constant_separates {q₁ q₂ : ℝ}
    (h₁ : 0 < q₁) (h₂ : 0 < q₂) (hne : q₁ ≠ q₂) :
    Real.log q₁ ≠ Real.log q₂ := by
  intro hc
  exact hne (Real.log_injOn_pos (Set.mem_Ioi.mpr h₁) (Set.mem_Ioi.mpr h₂) hc)

/-! ### El teorema bilevel -/

/-- **TEOREMA BILEVEL.**  La factorización 20 = 4·5 gobierna dos
    niveles con comportamientos opuestos:

      NIVEL VALOR    — las dos caras COINCIDEN en 1/2, por
                       construcciones sin ingrediente común;
      NIVEL CONSTANTE— las dos caras SE SEPARAN: la parte π aporta
                       log 2π, independiente del cuerpo; la parte φ
                       aporta log q, que lo determina.

    La coincidencia en el valor es la razón de que la clase tenga un
    módulo único; la separación en la constante es la razón de que la
    envolvente de conteo requiera el conductor.  Ambas son la misma
    partición leída a dos alturas. -/
theorem conductor_bilevel {q₁ q₂ : ℝ}
    (h₁ : 0 < q₁) (h₂ : 0 < q₂) (hne : q₁ ≠ q₂) :
    -- nivel valor: coinciden
    (Real.Gamma (3/2) / Real.sqrt π
       = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ))) ∧
    -- nivel constante: se separan
    (Real.log q₁ ≠ Real.log q₂) ∧
    -- y el valor común es el parámetro espectral de la clase
    (Real.Gamma (3/2) / Real.sqrt π = mu_n_param 3) :=
  ⟨half_on_both_faces, field_constant_separates h₁ h₂ hne,
   half_is_mu_three.1⟩

/-- **LOS TRES PAPELES DEL MEDIO**, reunidos.  El mismo 1/2 es:
    (a) valor del ápice, alcanzado por las dos caras del conductor;
    (b) exponente mediador entre los espectros aditivo y
        multiplicativo de φ;
    (c) coordenada del reparto radial autodual en el plano de
        Dirichlet (§10.L).
    Tres funciones distintas, un solo número. -/
theorem half_three_roles :
    (Real.Gamma (3/2) / Real.sqrt π = mu_n_param 3) ∧
    ((φ : ℝ) ^ ((1/2 : ℝ) * (Real.log 2 / Real.log φ)) = Real.sqrt 2) ∧
    (mu_n_param 3 = 1/2) :=
  ⟨half_is_mu_three.1, half_power_gives_sqrt_two, mu_ternary_param⟩


/- NOTAS PARA HERMES ─────────────────────────────────────────────
   1. Este módulo DEPENDE de `half_two_faces.lean` (§10.V):
      `mu_from_factorial`, `mu_from_tower`, `half_on_both_faces`,
