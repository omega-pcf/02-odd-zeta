section IndiceComoDegeneracionBlock

/-
IndiceComoDegeneracion.lean — sprint 84, el paso combinatorio de prop:index-degeneracy (ii)-(iii).
Estado P* (sin compilar). Compilar con: lake env lean IndiceComoDegeneracion.lean

Se restringe una representacion del grupo ciclico Z/q (el toro) al subgrupo de orden e, con q = e*m:
el caracter a de Z/q da la fase a mod e. Si todos los caracteres salen una vez, cada fase sale m veces;
si el de orden 2 (a = q/2) sale dos veces o ninguna, su fase (q/2) mod e sale m+1 o m-1 veces.
-/

namespace IndiceComoDegeneracion

/-- Cuantos `a < q` tienen `a % e = j`: exactamente `m` si `q = e*m` y `j < e`. -/
theorem count_residue (e m j : ℕ) (he : 0 < e) (hj : j < e) :
    ((Finset.range (e * m)).filter (fun a => a % e = j)).card = m := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [Nat.mul_succ, Finset.range_add_eq_union, Finset.filter_union,
      Finset.card_union_of_disjoint (Finset.disjoint_filter_filter
        (Finset.disjoint_range_addLeftEmbedding _ _)), ih]
    have : ((Finset.map (addLeftEmbedding (e * m)) (Finset.range e)).filter
        (fun a => a % e = j)) = {e * m + j} := by
      ext a
      simp only [Finset.mem_filter, Finset.mem_map, Finset.mem_range, addLeftEmbedding_apply,
        Finset.mem_singleton]
      constructor
      · rintro ⟨⟨b, hb, rfl⟩, h⟩
        have : (e * m + b) % e = b := by rw [Nat.mul_add_mod]; exact Nat.mod_eq_of_lt hb
        omega
      · rintro rfl
        exact ⟨⟨j, hj, rfl⟩, by rw [Nat.mul_add_mod]; exact Nat.mod_eq_of_lt hj⟩
    rw [this, Finset.card_singleton]

/-- La fase del caracter de orden 2: si `q = e*m` con `q` par, `(q/2) % e` es `0` si `m` es par
y `e/2` si `m` es impar (entonces `e` es par). Es el +1 o el −1 del enunciado. -/
theorem sigma_phase (e m : ℕ) (he : 0 < e) (hq : 2 ∣ e * m) :
    (2 ∣ m → (e * m / 2) % e = 0) ∧ (¬ 2 ∣ m → 2 ∣ e ∧ (e * m / 2) % e = e / 2) := by
  constructor
  · rintro ⟨k, rfl⟩
    rw [show e * (2 * k) / 2 = e * k by rw [← Nat.mul_assoc, Nat.mul_comm e 2, Nat.mul_assoc]; simp]
    exact Nat.mul_mod_right e k
  · intro hm
    have he2 : 2 ∣ e := by
      rcases (Nat.Prime.dvd_mul Nat.prime_two).mp hq with h | h
      · exact h
      · exact absurd h hm
    refine ⟨he2, ?_⟩
    obtain ⟨f, rfl⟩ := he2
    obtain ⟨k, rfl⟩ : ∃ k, m = 2 * k + 1 := ⟨m / 2, by omega⟩
    rw [show 2 * f * (2 * k + 1) / 2 = 2 * f * k + f by
          rw [show 2 * f * (2 * k + 1) = 2 * (2 * f * k + f) by ring]; simp]
    rw [show 2 * f * k + f = f + (2 * f) * k by ring, Nat.add_mul_mod_self_left,
        Nat.mod_eq_of_lt (by omega)]
    simp

end IndiceComoDegeneracion

end IndiceComoDegeneracionBlock

