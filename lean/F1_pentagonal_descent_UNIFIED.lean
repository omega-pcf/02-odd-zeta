/-! ## §87.6.1  El signo: dos valores  [R] §41 L4311 -/

/-- **[R] EL SIGNO LLEVA `χ₄`.**  Restatement de §41 L4308--4311,
    literal:

      «la MAGNITUD lleva `χ₅`, cara φ radial; el SIGNO lleva `χ₄`,
       cara π angular»

    Lo formalizable aquí es que el signo toma exactamente dos valores
    ---los de un carácter cuadrático--- y que cada uno da uno de los
    dos pares.  La identificación con `χ₄` es de §41, no se reprueba. -/
theorem sign_takes_exactly_two_values (ε : ℝ) (h : ε ^ 2 = 1) :
    ε = 1 ∨ ε = -1 := by
  have : (ε - 1) * (ε + 1) = 0 := by nlinarith [h]
  rcases mul_eq_zero.mp this with h1 | h1
  · left; linarith
  · right; linarith

/-- **[P] Y CADA SIGNO DA UNO DE LOS DOS PARES.**  Con `a = φ`,
    `b = φ⁻¹`: `ε = −1` es Galois (`e₂ = −1`), `ε = +1` es la
    decoración (`e₂ = +1`). -/
theorem each_sign_gives_one_pair :
    sym₂ (φ : ℝ) ((-1 : ℝ) * (1 / φ)) = -1 ∧
    sym₂ (φ : ℝ) ((1 : ℝ) * (1 / φ)) = 1 := by
  have hne : (φ : ℝ) ≠ 0 := ne_of_gt (lt_trans one_pos φ_gt_one)
  constructor <;> unfold sym₂ <;> field_simp

/-! ## §87.6.2  El invariante se anula exactamente en el colapso -/

/-- **[P] EL INVARIANTE DEL PAR RECÍPROCO.**  Para `{r, 1/r}` con
    `r > 0`, `e₁²·disc = (r² − r⁻²)²`.  Caso particular de
    `flip_invariant`. -/
theorem reciprocal_invariant (r : ℝ) (hr : 0 < r) :
    (sym₁ r (1 / r)) ^ 2 * discr r (1 / r) = (r ^ 2 - (1 / r) ^ 2) ^ 2 :=
  flip_invariant r (1 / r)

/-- **[P] Y SE ANULA SYSS `r = 1`.**  Para `r > 0`,
    `(r² − r⁻²)² = 0 ⟺ r⁴ = 1 ⟺ r = 1`. -/
theorem reciprocal_invariant_zero_iff (r : ℝ) (hr : 0 < r) :
    (r ^ 2 - (1 / r) ^ 2) ^ 2 = 0 ↔ r = 1 := by
  have hne : r ≠ 0 := ne_of_gt hr
  constructor
  · intro h
    have h1 : r ^ 2 - (1 / r) ^ 2 = 0 := by
      have := pow_eq_zero_iff (n := 2) (by norm_num) |>.mp h
      exact this
    have h2 : r ^ 4 = 1 := by
      field_simp at h1
      nlinarith [h1, hr]
    have h22 : (r ^ 2) ^ 2 = 1 := by
      have he : (r ^ 2) ^ 2 = r ^ 4 := by ring
      rw [he]; exact h2
    rcases sq_eq_one_iff.mp h22 with h3 | h3
    · rcases sq_eq_one_iff.mp h3 with h4 | h4
      · exact h4
      · linarith
    · have hs : 0 ≤ r ^ 2 := sq_nonneg r
      linarith
  · intro h; rw [h]; norm_num

/-- **[P] EL PENTÁGONO SOBREVIVE AL VOLTEO Y MUERE EN `E`.**

    | par | invariante |
    |---|---|
    | Galois `{φ, −φ⁻¹}` | `5` |
    | decoración `{φ, +φ⁻¹}` | `5` |
    | ceros `{r, +1/r}` | `0` syss `r = 1`, que es `E` |

    El `5` es invariante del desplazamiento `e₂: −1 → +1` ---la cara
    `χ₄`--- y lo único que lo anula es el colapso del par de los
    ceros.  **`E` es la muerte del invariante del pentágono, no su
    pérdida por descenso.** -/
theorem pentagon_survives_the_flip_dies_at_E (r : ℝ) (hr : 0 < r) :
    ((sym₁ (φ : ℝ) (1 / φ)) ^ 2 * discr (φ : ℝ) (1 / φ) = 5) ∧
    ((sym₁ (φ : ℝ) (1 / φ)) ^ 2 * discr (φ : ℝ) (1 / φ)
       = (sym₁ (φ : ℝ) (-(1 / φ))) ^ 2 * discr (φ : ℝ) (-(1 / φ))) ∧
    ((sym₁ r (1 / r)) ^ 2 * discr r (1 / r) = 0 ↔ r = 1) := by
  refine ⟨pentagon_is_the_flip_invariant.1,
          pentagon_is_the_flip_invariant.2, ?_⟩
  rw [reciprocal_invariant r hr]
  exact reciprocal_invariant_zero_iff r hr

/-- **[O] LA TABLA DE §87, AHORA COMPLETA EN LEAN.**  Las dos filas
    que estaban solo en Python:

    | fila | dónde |
    |---|---|
    | el signo lleva `χ₄` | `[R]` §41 L4311 + `sign_takes_exactly_two_values` |
    | invariante `= 0` en el colapso | `[P]` `reciprocal_invariant_zero_iff` |

    Nada de esto acerca `(I')`: la monomialidad sigue `[Conj]`. -/
theorem the_table_is_complete (r : ℝ) (hr : 0 < r) :
    (∀ ε : ℝ, ε ^ 2 = 1 → ε = 1 ∨ ε = -1) ∧
    (sym₂ (φ : ℝ) ((-1 : ℝ) * (1 / φ)) = -1) ∧
    (sym₂ (φ : ℝ) ((1 : ℝ) * (1 / φ)) = 1) ∧
    ((sym₁ r (1 / r)) ^ 2 * discr r (1 / r) = 0 ↔ r = 1) :=
  ⟨sign_takes_exactly_two_values,
   each_sign_gives_one_pair.1, each_sign_gives_one_pair.2,
   (pentagon_survives_the_flip_dies_at_E r hr).2.2⟩

