    (5 * (Nat.fib 0 : ℝ) ^ 2 = 0) ∧ (5 * (Nat.fib 2 : ℝ) ^ 2 = 5) := by
  refine ⟨by decide, by decide, by decide, by decide, by norm_num, by norm_num⟩

