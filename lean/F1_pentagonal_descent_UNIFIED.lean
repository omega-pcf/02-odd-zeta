/-! ## §108.2  Compartir un paso no descalifica: 5 y 6 -/

/-- **[P] LA PATA 5, EN `ℝ`.** -/
theorem leg_five (x : ℝ) : x = 1 - x ↔ x = 1 / 2 := by
  constructor <;> intro h <;> linarith

/-- **[P] LA PATA 6, EN `ℂ`.** -/
