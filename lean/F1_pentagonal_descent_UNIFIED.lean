/-! ## Connections (ontology, round 3b)

  Objects that the corpus defines separately and that no theorem related to the
  objects built from φ.  Each lemma below states the relation.  Tier [P*]. -/

/-- **[P*]** The χ₅ of the ideal machinery (`F1CW.chi5`, on ℕ) is the χ₅ of the
    structural chain (`chi5_Z`, on ℤ/5): they take the same value at every n. -/
theorem chi5_ideals_is_chi5_structural (n : ℕ) :
    F1CW.chi5 n = F1PCFUnified.chi5_Z (n : ZMod 5) := by
  have h : (n : ZMod 5) = ((n % 5 : ℕ) : ZMod 5) := (ZMod.natCast_mod n 5).symm
  rw [h]
  unfold F1CW.chi5
  generalize hm : n % 5 = m
  have hlt : m < 5 := hm ▸ Nat.mod_lt n (by norm_num)
  interval_cases m <;> first | decide | rfl | simp [F1PCFUnified.chi5_Z]

/-- **[P*]** The characters of conductor 20 are the two components of G: on the eight
    classes of (ℤ/20)^×, χ₄ is trivial exactly where the first component of G is 0,
    and χ₅ exactly where the second is. -/
theorem conductor20_characters_are_G :
    ∀ a ∈ ({1, 3, 7, 9, 11, 13, 17, 19} : Finset ℕ),
      (F1v2.chi4N a = 1 ↔ (F1PCFUnified.G (a : ZMod 20)).1 = 0) ∧
      (F1CW.chi5 a = 1 ↔ (F1PCFUnified.G (a : ZMod 20)).2 = 0) := by
  decide

/-- **[P*]** The norm form of ℤ[φ] factors through φ and its conjugate, and its
    discriminant is the conductor 5: x² + xy − y² = (x + φy)(x + ψy). -/
theorem norm_form_factors_through_phi (x y : ℝ) :
    F1v2.evalQ (1, 1, -1) x y = (x + F1v2.φ0 * y) * (x + F1v2.ψ0 * y) ∧
    F1v2.discQ (1, 1, -1) = 5 := by
  refine ⟨?_, by norm_num [F1v2.discQ]⟩
  have hsum : F1v2.φ0 + F1v2.ψ0 = 1 := by unfold F1v2.φ0 F1v2.ψ0; ring
  have hprod := F1v2.φ0_mul_ψ0
  simp only [F1v2.evalQ]
  linear_combination (-(x * y)) * hsum - y ^ 2 * hprod

/-- **[P*]** The two definitions of the eigenvalue triad of the first block coincide. -/
theorem omega_eigenvalues_are_omega_hat :
    F1PCFUnified.Omega_eigenvalues = F1PCFUnified.Omega_hat := by
  funext k
  rfl


/-- **[P*]** `PentagonCosines` at the pentagonal cosines:
    cos(π/5) = (1 + √5)/4 and cos(2π/5) = (√5 − 1)/4. -/
theorem pentagonCosines_holds :
    F1PCFUnified.PentagonCosines (Real.cos (Real.pi / 5)) (Real.cos (2 * Real.pi / 5)) := by
  refine ⟨?_, ?_⟩
  · rw [F1PCFUnified.cos_pi_div_five_eq]; unfold F1PCFUnified.φ; ring
  · rw [F1v2.cos_two_pi_div_five_eq]; unfold F1CW.phi; ring

/-- **[P*]** `BinetDifference` for the golden ratio:
    φ^(2k) − (1/φ)^(2k) = √5 · F_(2k). -/
theorem binetDifference_holds : BinetDifference F1PCFUnified.φ := by
  intro k
  have hφ : F1PCFUnified.φ = Real.goldenRatio := rfl
  have h5 : Real.sqrt 5 ≠ 0 := by positivity
  have hev : Even (2 * k) := ⟨k, by ring⟩
  rw [hφ, one_div]
  first
    | rw [Real.inv_goldenRatio]
    | rw [Real.inv_gold]
  rw [Even.neg_pow hev, Real.coe_fib_eq]
  field_simp


/-! ## Value hypotheses closed at the actual values (ontology, round 3b) -/

/-- **[P*]** "modulus = 1 exactly on the line", for every ρ, with the modulus
    |ρ − 1| / |ρ|.  (With the Li coordinate |1 − 1/ρ| it fails at ρ = 0, where Lean
    sets 1/0 = 0; this modulus takes the value 0 there, and the equivalence holds.) -/
theorem modulusOnLine_holds :
    F1PCFUnified.ModulusOnLine (fun ρ => Complex.abs (ρ - 1) / Complex.abs ρ) := by
  intro ρ
  by_cases h : ρ = 0
  · subst h; norm_num
  · have hk := F1PCFUnified.liMap_on_unit_circle_iff ρ h
    have e : F1PCFUnified.liMap ρ = (ρ - 1) / ρ := by
      unfold F1PCFUnified.liMap; field_simp
    rw [e, F1PCFUnified.Complex.abs_div] at hk
    exact hk
