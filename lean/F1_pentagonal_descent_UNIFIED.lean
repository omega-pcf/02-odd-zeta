/-! ## §96.1  La identidad del módulo -/

/-- **[P] EL CUADRADO DEL MÓDULO.**  Con `β = 1/2 + δ` y
    `D = β² + γ²`:

        r² = ((β−1)² + γ²)/D = 1 − 2δ/D

    porque `(β−1)² − β² = 1 − 2β = −2δ`. -/
theorem modulus_squared (δ γ : ℝ) (hD : (1 / 2 + δ) ^ 2 + γ ^ 2 ≠ 0) :
    ((1 / 2 + δ - 1) ^ 2 + γ ^ 2) / ((1 / 2 + δ) ^ 2 + γ ^ 2)
      = 1 - 2 * δ / ((1 / 2 + δ) ^ 2 + γ ^ 2) := by
  have hEq : ((1 / 2 + δ - 1) ^ 2 + γ ^ 2)
      = ((1 / 2 + δ) ^ 2 + γ ^ 2) - 2 * δ := by ring
  have hD' : ((1 + 2 * δ) ^ 2 + 2 ^ 2 * γ ^ 2 : ℝ) ≠ 0 := by
    intro hc
    have h1 : (1 + 2 * δ) ^ 2 = 0 := by
      have hle : (1 + 2 * δ) ^ 2 ≤ (1 + 2 * δ) ^ 2 + 2 ^ 2 * γ ^ 2 := by
        nlinarith [sq_nonneg ((2:ℝ) * γ)]
      rw [hc] at hle
      exact le_antisymm hle (sq_nonneg (1 + 2 * δ))
    have h2 : 1 + 2 * δ = 0 := by
      exact pow_eq_zero_iff (n := 2) (by norm_num) |>.mp h1
    have hγ : (2 : ℝ) ^ 2 * γ ^ 2 = 0 := by
      have hle : (2:ℝ) ^ 2 * γ ^ 2 ≤ (1 + 2 * δ) ^ 2 + 2 ^ 2 * γ ^ 2 := by
        nlinarith [sq_nonneg (1 + 2 * δ)]
      rw [hc] at hle
      have hnng : (0:ℝ) ≤ 2 ^ 2 * γ ^ 2 := by positivity
      exact le_antisymm hle hnng
    have hγ0 : γ = 0 := by
      have hγ2 : γ ^ 2 = 0 := by nlinarith [hγ]
      exact pow_eq_zero_iff (n := 2) (by norm_num) |>.mp hγ2
    have hδ : δ = -1 / 2 := by linarith
    exact hD (by rw [hδ, hγ0]; norm_num)
  rw [hEq]
  field_simp

/-! ## §96.2  La forma cerrada de la contribución -/

/-- **[P] LA CONTRIBUCIÓN, EXACTA.**  Para `r > 0` con
    `r² = 1 − 2δ/D`:

        (r−1)²/r  =  4δ² / ( D² · r · (r+1)² )

    Es identidad algebraica: `(r−1)² = (r²−1)²/(r+1)²` y
    `r²−1 = −2δ/D`. -/
theorem contribution_closed_form (r δ D : ℝ)
    (hr : 0 < r) (hD : D ≠ 0) (hsq : r ^ 2 = 1 - 2 * δ / D) :
    (r - 1) ^ 2 / r = 4 * δ ^ 2 / (D ^ 2 * r * (r + 1) ^ 2) := by
  have hr1 : r + 1 ≠ 0 := by positivity
  have hrne : r ≠ 0 := ne_of_gt hr
  have key : (r - 1) ^ 2 * (r + 1) ^ 2 = (r ^ 2 - 1) ^ 2 := by ring
  have h2 : r ^ 2 - 1 = -(2 * δ / D) := by rw [hsq]; ring
  have h3 : (r - 1) ^ 2 * (r + 1) ^ 2 = 4 * δ ^ 2 / D ^ 2 := by
    rw [key, h2]; field_simp; ring
  field_simp at h3 ⊢
  nlinarith [h3, sq_nonneg (r - 1), sq_nonneg (r + 1)]

/-! ## §96.3  La cota rigurosa, con constante explícita -/

/-- **[P] SI `r ≥ 1/2` ENTONCES `r(r+1)² ≥ 9/8`.**  El denominador
    está acotado por abajo, que es lo que hace falta para acotar la
    contribución por arriba. -/
theorem denominator_lower_bound (r : ℝ) (h : 1 / 2 ≤ r) :
    9 / 8 ≤ r * (r + 1) ^ 2 := by
  nlinarith [h, sq_nonneg (r - 1 / 2), sq_nonneg r]

/-- **[P] LA COTA, CON CONSTANTE `32/9`.**  Con `D ≥ γ² > 0` y
    `r ≥ 1/2`:

        contrib  ≤  32 δ² / (9 γ⁴)

    **No es asintótica ni ajustada: es una desigualdad con constante
    explícita.** -/
theorem contribution_decay_bound (r δ D γ : ℝ)
    (hr : 1 / 2 ≤ r) (hγ : 0 < γ) (hD : γ ^ 2 ≤ D)
    (hsq : r ^ 2 = 1 - 2 * δ / D) (hDpos : 0 < D) :
    (r - 1) ^ 2 / r ≤ 32 * δ ^ 2 / (9 * γ ^ 4) := by
  have hrpos : (0 : ℝ) < r := by linarith
  have hcf := contribution_closed_form r δ D hrpos (ne_of_gt hDpos) hsq
  rw [hcf]
  have hden : 9 / 8 ≤ r * (r + 1) ^ 2 := denominator_lower_bound r hr
  have hγ4 : (0 : ℝ) < γ ^ 4 := by positivity
  have hD2 : γ ^ 4 ≤ D ^ 2 := by nlinarith [hD, hγ, sq_nonneg γ]
