   §5  La pertenencia, demostrada: los primos por sus clases, los ceros por
       su centro, las tres puertas y el emparejamiento r·r′ = 1, las cinco
       patas que llegan al ½, y lo descargado.  Y lo que el corpus mismo dice
       que falta: el veredicto (la mitad aditiva r + r′ = 2).
   §6  LA CONJETURA: una ley por clases que da las DOS precisiones —el
       residuo de cada clase a escala ½ (que da el radio 0) y la corrección
       exacta de las alturas—.  Con ella: la línea, las alturas exactas y el
       aterrizaje en el espectro del operador.
   §7  Las dos vías a r = 1: alturas exactas e inyectivas ⟹ sin ordenadas
       compartidas ⟹ la línea (sin entrada clásica); modos de los ceros como
       autovectores de una isometría ⟹ módulo 1 ⟹ la línea.

  Nada nuevo se supone fuera de §6 (la conjetura).  Tiers: P* (escrito, sin compilar).
-/


noncomputable section
open F1PCFUnified F1PaperHyp F1PaperTorus

namespace F1PaperClosure

/-! ## §1  Las alturas: la estructura da la posición; falta sólo la corrección -/

/-- **[P*] La altura del cero n es la envolvente invertida en n − S(tₙ), y su
    distancia a la posición estructural E⁻¹(n) es sólo la corrección.**
    (Ley de conteo del corpus: N = env + S.) -/
theorem heights_from_structure (N S : ℝ → ℝ) (E : EnvelopeInv)
    (hlaw : CountingLaw N E.env S) (t : ℕ → ℝ) (ht : ∀ n, 0 < t n)
    (hcount : ∀ n, N (t n) = n) (n : ℕ) :
    t n = E.Einv ((n : ℝ) - S (t n)) ∧
    t n - E.Einv n = E.Einv ((n : ℝ) - S (t n)) - E.Einv n :=
  ⟨height_from_envelope N S E hlaw t ht hcount n,
   parametrisation_removable N S E hlaw t ht hcount n⟩

/-- **[P*] Sin corrección, la altura ES la posición estructural.** -/
theorem the_height_is_the_structure_up_to_the_correction (N S : ℝ → ℝ) (E : EnvelopeInv)
    (hlaw : CountingLaw N E.env S) (t : ℕ → ℝ) (ht : ∀ n, 0 < t n)
    (hcount : ∀ n, N (t n) = n) (n : ℕ) (h0 : S (t n) = 0) :
    t n = E.Einv n := by
  have h := height_from_envelope N S E hlaw t ht hcount n
  rw [h0, sub_zero] at h
  exact h

/-! ## §2  El operador del framework: estructural, y su error -/

/-- **[P*] El error del operador T* es corrección + parametrización.**
    [N] (ζ): T* ≈ 4.9 espaciados de error medio; con la envolvente exacta
    (lado π, sin circularidad) 0.20 espaciados (error relativo de 3·10⁻³ a
    5·10⁻⁵); lo que queda es la corrección. -/
theorem operator_error_is_correction_plus_parametrisation (N S : ℝ → ℝ) (E : EnvelopeInv)
    (hlaw : CountingLaw N E.env S) (t : ℕ → ℝ) (ht : ∀ n, 0 < t n)
    (hcount : ∀ n, N (t n) = n) (n : ℕ) :
    t n - TstarH n
      = (E.Einv ((n : ℝ) - S (t n)) - E.Einv n) + (E.Einv n - TstarH n) :=
  error_decomposition N S E hlaw t ht hcount (fun m => TstarH m) n

/-! ## §3  El ½, por todas sus rutas -/

/-- **[P] El ½ lo dan:** el centro de la órbita de todo cero, la cara π
    Γ(3/2)/√π, la cara φ φ^(−λ), la línea como conjunto fijo de s ↦ 1 − s̄, y
    el autovalor positivo del operador. -/
theorem the_half_is_given :
    (type_of% @the_orbit_embedding_is_unconditional) ∧
    (type_of% @mu_from_factorial) ∧
    (type_of% @mu_from_tower) ∧
    (type_of% @stau_fixed_iff_critical) ∧
    (type_of% @modulus_cocone_six_routes) :=
  ⟨@the_orbit_embedding_is_unconditional, @mu_from_factorial, @mu_from_tower,
   @stau_fixed_iff_critical, @modulus_cocone_six_routes⟩

/-! ## §4  El resto de la estructura -/

/-- **[P]/[P*] Lo demás:** el radio de todo cero confinado por la banda
    (r² ≤ 1 + 1/γ²); integralidad de la traza ⟺ ½; las ocho clases y su
    ortogonalidad; el Frobenius sobre las clases, periódico; el factor de
    Euler como polinomio característico del Frobenius. -/
theorem the_structure_gives_the_rest :
    (type_of% @rSq_le_in_strip) ∧
    (type_of% @the_two_labels_are_one_gap) ∧
    (type_of% @eight_classes_orthogonality) ∧
    (type_of% @frobenius_orbit_is_periodic) ∧
    (type_of% @F1FrobeniusEigen.euler_factor_is_char_poly) :=
  ⟨@rSq_le_in_strip, @the_two_labels_are_one_gap, @eight_classes_orthogonality,
   @frobenius_orbit_is_periodic, @F1FrobeniusEigen.euler_factor_is_char_poly⟩

/-! ## §5  La pertenencia, demostrada -/

/-- **[P] La pertenencia de los primos:** todo primo p > 5 cae en una de las ocho
    clases y G es homomorfismo sobre ellas; χ₅ separa inertes y descompuestos;
    los primos llegan al ½ por el conductor, (1/8)·4 = ½; y, para cada cero, la
    aritmética lo alcanza (clases, monoide, Ω̂, L(ρ) = L(1 − ρ) = 0). -/
theorem the_primes_belong :
    (type_of% @primes_reach_the_L_function) ∧
    (type_of% @every_prime_enters_the_same_orbit_structure) ∧
    (type_of% @primes_enter_the_cocone_by_the_arity_and_the_conductor) ∧
    (type_of% @the_arithmetic_reaches_the_zero) :=
  ⟨@primes_reach_the_L_function, @every_prime_enters_the_same_orbit_structure,
   @primes_enter_the_cocone_by_the_arity_and_the_conductor, @the_arithmetic_reaches_the_zero⟩

/-- **[P] La pertenencia de los ceros:** para todo cero, el centro de {ρ, 1 − ρ} es
    exactamente ½ y es el autovalor positivo de Ω̂; entra por tres puertas (centro
    en el espectro, valuaciones opuestas, r·r′ = 1: la mitad multiplicativa); el
    ápice ½ lo reciben cinco patas a la vez (primos, ceros, operador, monoide,
    lugar arquimediano); y el ápice es el CENTRO del cero, no la pertenencia
    del cero mismo. -/
theorem the_zeros_belong :
    (type_of% @zeros_enter_the_cocone_by_the_involution) ∧
    (type_of% @the_zero_enters_by_three_doors) ∧
    (type_of% @the_apex_receives_from_five_legs_including_the_zeros) ∧
    (type_of% @the_apex_is_the_centre_not_a_member) ∧
    (type_of% @klein_pairing) :=
  ⟨@zeros_enter_the_cocone_by_the_involution, @the_zero_enters_by_three_doors,
   @the_apex_receives_from_five_legs_including_the_zeros, @the_apex_is_the_centre_not_a_member,
   @klein_pairing⟩

/-- **[P] Lo descargado:** Hecke (ecuación funcional y compañero) es teorema, y la
    pertenencia se deriva del puente, la banda y el compañero. -/
theorem what_is_discharged :
    (type_of% @hecke_chi5_derived) ∧ (type_of% @the_membership_derived) :=
  ⟨@hecke_chi5_derived, @the_membership_derived⟩

/-- **[P] Lo que falta, dicho por el corpus:** todo desciende salvo el veredicto; y
    con la mitad multiplicativa (demostrada) la mitad aditiva r + r′ = 2 daría
    r = 1, es decir radio 0. -/
theorem what_remains_is_the_verdict :
    (type_of% @everything_descends_but_the_verdict) ∧ (type_of% @union_of_halves_is_E) :=
  ⟨@everything_descends_but_the_verdict, @union_of_halves_is_E⟩

/-! ## §6  La conjetura: las dos precisiones, por la ley de las clases -/

/-- La función de Chebyshev de la clase `a` módulo 20: Σ_{n ≤ x, n ≡ a} Λ(n). -/
def classChebyshev (a : ZMod 20) (x : ℝ) : ℝ :=
  ∑ n ∈ Finset.range (⌊x⌋₊ + 1), if ((n : ZMod 20) = a) then ArithmeticFunction.vonMangoldt n else 0

/-- El residuo verdadero de la clase `a`: lo que queda tras su parte estructural x/8. -/
def trueResidual (a : ZMod 20) (x : ℝ) : ℝ := classChebyshev a x - x / 8

/-- **La escala ½:** cada residuo es O(x^{1/2 + ε}) —el ½ que cada primo ya lleva
    como módulo p^{−1/2}—. -/
def HalfScale (r : ZMod 20 → ℝ → ℝ) : Prop :=
  ∀ a ∈ F1PCFUnified.ZtwentyStar, ∀ ε : ℝ, 0 < ε →
    ∃ C : ℝ, ∀ x : ℝ, 1 ≤ x → |r a x| ≤ C * x ^ ((1 : ℝ) / 2 + ε)

/-- **[C] La equivalencia clásica, como entrada con nombre:** si los residuos de
    las ocho clases están a escala ½, los ceros de `Lf` (ζ, o una L de carácter
    módulo 20) en la banda tienen parte real ½.  (Fórmula explícita; es la
    "sexta forma" del corpus, que allí sólo está como marcador.) -/
def ClassicalHalfScale (Lf : ℂ → ℂ) : Prop :=
  HalfScale trueResidual → ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 → Lf ρ = 0 → ρ.re = 1/2

/-- La ley por clases: el residuo que predice para cada clase (lado de los
    primos) y la corrección de las alturas que se sigue de ellos (lado de los
    ceros). -/
structure ClassResidualLaw where
  r : ZMod 20 → ℝ → ℝ
  corr : ℝ → ℝ

/-- Enumeración de los ceros de `Lf` en la banda, por altura: la versión para
    cualquier `Lf` de `F1PaperHyp.ZeroEnumeration`, que es la de χ₅. -/
structure LZeroEnumeration (Lf : ℂ → ℂ) where
  ρ : ℕ → ℂ
  covers : ∀ z : ℂ, 0 < z.re → z.re < 1 → Lf z = 0 → ∃ n, ρ n = z

/-- **[O] LA CONJETURA DE CIERRE: las dos precisiones.**  Existe una ley por clases,
    derivada de la estructura sin enumerar primos, que
    (i)  predice el residuo de cada clase respecto de su parte estructural,
    (ii) lo predice a escala ½ —la precisión de la parte real: radio 0—, y
    (iii) da la corrección con la que las alturas son exactamente E⁻¹(n − corrección)
         —la precisión de las alturas; E es la envolvente, del lado π—.
    [N] (ζ): la envolvente exacta deja 0.20 espaciados; una ley que resuelva el
    residuo a δ = 10⁻³ … 10⁻⁴ en log p deja 0.053 … 0.023 (`law_resolution.py`). -/
def ExactClosure (Lf : ℂ → ℂ) (Z : LZeroEnumeration Lf) (E : EnvelopeInv) : Prop :=
  ∃ law : ClassResidualLaw,
    (∀ a x, law.r a x = trueResidual a x) ∧
    HalfScale law.r ∧
    (∀ n : ℕ, (Z.ρ n).im = E.Einv ((n : ℝ) - law.corr (Z.ρ n).im))

/-- **[P*] Con la conjetura (y la equivalencia clásica), la línea.** -/
theorem the_line_from_exact_closure (Lf : ℂ → ℂ) (Z : LZeroEnumeration Lf) (E : EnvelopeInv)
    (h : ExactClosure Lf Z E) (hC : ClassicalHalfScale Lf) :
    ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 → Lf ρ = 0 → ρ.re = 1/2 := by
  obtain ⟨law, hr, hs, _⟩ := h
  apply hC
  unfold HalfScale at hs ⊢
  intro a ha ε hε
  obtain ⟨C, hCb⟩ := hs a ha ε hε
  exact ⟨C, fun x hx => by rw [← hr a x]; exact hCb x hx⟩

/-- **[P*] Con la conjetura, las alturas son exactamente la estructura corregida.** -/
theorem heights_exact_from_exact_closure (Lf : ℂ → ℂ) (Z : LZeroEnumeration Lf) (E : EnvelopeInv)
    (h : ExactClosure Lf Z E) :
    ∃ law : ClassResidualLaw, ∀ n : ℕ, (Z.ρ n).im = E.Einv ((n : ℝ) - law.corr (Z.ρ n).im) := by
  obtain ⟨law, _, _, hh⟩ := h
  exact ⟨law, hh⟩

/-- **[P*] Y el aterrizaje en el espectro del operador** (el último eslabón del puente). -/
theorem landing_from_exact_closure (Lf : ℂ → ℂ) (Z : LZeroEnumeration Lf) (E : EnvelopeInv)
    (h : ExactClosure Lf Z E) (hC : ClassicalHalfScale Lf) : LandsOnSpectrum Lf :=
  (landing_iff_E Lf).mpr (the_line_from_exact_closure Lf Z E h hC)

/-- **[P*] Para L(s, χ₅), en la estructura de ceros del corpus.** -/
theorem the_line_for_chi5 (Z : LZeroEnumeration (fun s => DirichletCharacter.LFunction chi5_D s))
    (E : EnvelopeInv) (h : ExactClosure _ Z E)
    (hC : ClassicalHalfScale (fun s => DirichletCharacter.LFunction chi5_D s)) :
    ∀ z : Chi5Zero, z.ρ.re = 1/2 := fun z =>
  the_line_from_exact_closure _ Z E h hC z.ρ z.in_strip_pos z.in_strip_lt z.is_zero

/-! ## §7  Las dos vías por las que la altura y la isometría dan r = 1

  (a) Klein: si las alturas de los ceros las da una fórmula estructural
      INYECTIVA (la corrección salta de 1 en 1), ningún par de ceros
      distintos comparte ordenada; y "no compartir ordenada" ⟺ la línea
      (corpus: `E_iff_no_shared_ordinate_chi5`, `…_of_fe_rc`).
  (b) Isometría: si el modo de cada cero es un autovector de una isometría
      (la de un operador autoadjunto), su módulo p^{−(β−½)} es 1, luego β = ½.
  La altura fija la fase; la isometría fija el módulo. -/

/-- **[P*] Vía de Klein.**  Alturas exactas dadas por una fórmula inyectiva en el
    índice ⟹ ningún par de ceros distintos comparte ordenada. -/
theorem no_shared_ordinate_of_injective_heights (Lf : ℂ → ℂ) (Z : LZeroEnumeration Lf)
    (hinj : Function.Injective (fun n => (Z.ρ n).im)) :
    ¬ SharesOrdinate (stripZeros Lf) := by
  rintro ⟨a, ha, b, hb, hne, him⟩
  obtain ⟨m, rfl⟩ := Z.covers a ha.1 ha.2.1 ha.2.2
  obtain ⟨n, rfl⟩ := Z.covers b hb.1 hb.2.1 hb.2.2
  have hmn : m = n := hinj him
  exact hne (by rw [hmn])

/-- **[P*] La línea para χ₅ por la vía de Klein:** alturas exactas e inyectivas
    ⟹ todo cero de la banda en la línea. -/
theorem the_line_from_injective_heights_chi5
    (Z : LZeroEnumeration (DirichletCharacter.LFunction chi5_D))
    (hinj : Function.Injective (fun n => (Z.ρ n).im)) :
    OnTheLine (stripZeros (DirichletCharacter.LFunction chi5_D)) :=
  E_iff_no_shared_ordinate_chi5.mpr (no_shared_ordinate_of_injective_heights _ Z hinj)

/-- **[P*] Y para cualquier L con ecuación funcional y coeficientes reales**
    (ζ incluida, que es la función del operador de [39]). -/
theorem the_line_from_injective_heights (Lf : ℂ → ℂ) (hfe : FunctionalEquation Lf)
    (hrc : RealCoefficients Lf) (Z : LZeroEnumeration Lf)
    (hinj : Function.Injective (fun n => (Z.ρ n).im)) :
    OnTheLine (stripZeros Lf) :=
  (E_iff_no_shared_ordinate_of_fe_rc Lf hfe hrc).mpr (no_shared_ordinate_of_injective_heights Lf Z hinj)

/-- **[P*] Con la conjetura: si las alturas que da la ley son inyectivas, la línea
    sale sin la entrada clásica de la escala ½.** -/
theorem the_line_from_exact_closure_by_heights (Lf : ℂ → ℂ) (hfe : FunctionalEquation Lf)
    (hrc : RealCoefficients Lf) (Z : LZeroEnumeration Lf) (E : EnvelopeInv)
    (_h : ExactClosure Lf Z E) (hinj : Function.Injective (fun n => (Z.ρ n).im)) :
    OnTheLine (stripZeros Lf) :=
  the_line_from_injective_heights Lf hfe hrc Z hinj

/-- **[P*] Un autovalor de una isometría tiene módulo 1.** -/
theorem eigenvalue_of_isometry_norm_one {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℂ F]
    (V : F →ₗᵢ[ℂ] F) (v : F) (hv : v ≠ 0) (μ : ℂ) (hVμ : V v = μ • v) : ‖μ‖ = 1 := by
  have h1 : ‖V v‖ = ‖v‖ := V.norm_map v
  rw [hVμ, norm_smul] at h1
  have hv' : ‖v‖ ≠ 0 := norm_ne_zero_iff.mpr hv
  exact mul_right_cancel₀ hv' (h1.trans (one_mul ‖v‖).symm)

/-- **[P*] Vía de la isometría:** si el modo de cada cero (factor de módulo
    p^{−(β−½)} bajo el Frobenius de p) es un autovector de una isometría,
    todo cero está en la línea. -/
theorem the_line_from_isometric_modes (Lf : ℂ → ℂ) (p : ℝ) (hp : 1 < p)
    {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℂ F] (V : F →ₗᵢ[ℂ] F)
    (hmodes : ∀ ρ ∈ stripZeros Lf, ∃ v : F, v ≠ 0 ∧ ∃ μ : ℂ, V v = μ • v ∧
      ‖μ‖ = p ^ (-(ρ.re - 1 / 2))) :
    OnTheLine (stripZeros Lf) := by
  intro ρ hρ
  obtain ⟨v, hv, μ, hVμ, hμ⟩ := hmodes ρ hρ
  have h1 := eigenvalue_of_isometry_norm_one V v hv μ hVμ
  rw [hμ] at h1
  by_contra hne
  have hs : -(ρ.re - 1 / 2) ≠ 0 := by
    intro h0; apply hne; linarith
  exact offline_orbit_factor_ne_one p _ hp hs h1

/-! ## §8  Apolonio y Pappus: la clasificación de los ceros por su cónica

  r(ρ) = |ρ − 1|/|ρ| es la razón apoloniana de los focos 0 y 1; bajo Joukowski el
  círculo |w| = r va a la elipse confocal de semiejes a = r + 1/r (la traza t) y
  b = |r − 1/r|, de focos ±2 (`confocal_always`: a² − b² = 4).  Su excentricidad
  es e = 2/a = 2/t: la clasificación de Pappus por un solo parámetro (HPPS §2.1;
  el módulo vitruviano, CR).
  DEMOSTRADO para todo cero: la clasificación (e = 1 ⟺ r = 1 ⟺ la línea), el
  piso e ≤ 1, que el par de Klein comparte su cónica, y el confinamiento
  e > 0.99993 (dada la cota t ≤ 2.00013 de la Prop. 20.8).
  ABIERTO: el último margen, e ≥ 1 (el techo, t ≤ 2).
  CONEXIÓN DEMOSTRABLE con la conjetura: cualquiera de sus dos vías da e = 1 en
  todo cero; y con alturas distintas el par de Klein —que comparte cónica con
  radios recíprocos— colapsa, lo que sólo ocurre en la cónica degenerada. -/

/-- La excentricidad de la cónica de razón apoloniana r: e = 2/(r + 1/r). -/
noncomputable def eccentricity (r : ℝ) : ℝ := 2 / ellAP r

theorem ellAP_pos (r : ℝ) (hr : 0 < r) : 0 < ellAP r := by
  unfold ellAP; positivity

/-- **[P*] El piso: e ≤ 1 para todo r > 0** (de `trR_ge_two`, t ≥ 2). -/
theorem eccentricity_le_one (r : ℝ) (hr : 0 < r) : eccentricity r ≤ 1 := by
  have h := trR_ge_two r hr
  have ha : ellAP r = trR r := rfl
  unfold eccentricity
  rw [div_le_one (ellAP_pos r hr)]
  linarith

/-- **[P*] La clasificación: e = 1 exactamente en la cónica degenerada, r = 1.** -/
theorem eccentricity_eq_one_iff (r : ℝ) (hr : 0 < r) : eccentricity r = 1 ↔ r = 1 := by
  constructor
  · intro h
    have ha : ellAP r = 2 := by
      unfold eccentricity at h
      have hp := ellAP_pos r hr
      field_simp at h
      linarith
    have hc := confocal_always r hr.ne'
    have hb : ellBP r ^ 2 = 0 := by rw [ha] at hc; linarith
    exact (degenerates_iff_one r hr).mp (pow_eq_zero_iff (by norm_num) |>.mp hb)
  · rintro rfl
    unfold eccentricity ellAP
    norm_num

/-- **[P*] Lo abierto es de un solo lado:** con el piso, e ≥ 1 ⟺ e = 1. -/
theorem eccentricity_one_sided (r : ℝ) (hr : 0 < r) : 1 ≤ eccentricity r ↔ eccentricity r = 1 :=
  ⟨fun h => le_antisymm (eccentricity_le_one r hr) h, fun h => h.ge⟩

/-- **[P*] El par de Klein comparte su cónica:** r y 1/r dan la misma excentricidad. -/
theorem eccentricity_inv (r : ℝ) : eccentricity (1 / r) = eccentricity r := by
  unfold eccentricity ellAP
  rw [one_div_one_div, add_comm]

/-- **[P*] Para los ceros:** el cero y su pareja 1 − ρ están en la misma cónica. -/
theorem klein_pair_shares_the_conic (z : Chi5Zero) :
    eccentricity (zeroCoord (1 - z.ρ)) = eccentricity (zeroCoord z.ρ) := by
  have h := (the_klein_action_on_the_coordinate z).2.1
  have hne : zeroCoord z.ρ ≠ 0 := by
    intro h0; rw [h0, zero_mul] at h; exact zero_ne_one h
  have hinv : zeroCoord (1 - z.ρ) = 1 / zeroCoord z.ρ := by
    field_simp; linarith [h]
  rw [hinv, eccentricity_inv]

/-- **[P*] El confinamiento:** si t ≤ 2.00013 (Prop. 20.8, con la altura del primer
    cero), la excentricidad está a menos de 7·10⁻⁵ de 1. -/
theorem eccentricity_confined (r : ℝ) (hr : 0 < r) (ht : ellAP r ≤ 2.00013) :
    0.99993 < eccentricity r := by
  unfold eccentricity
  rw [lt_div_iff₀ (ellAP_pos r hr)]
  nlinarith

/-- **[P*] El lado estructural es discreto:** una traza entera menor que 3 sólo deja la
    cónica degenerada (`trace_integer_plus_bound`). -/
theorem integral_trace_gives_degenerate (r : ℝ) (hr : 0 < r) (m : ℤ)
    (hm : (m : ℝ) = ellAP r) (hlt : ellAP r < 3) : eccentricity r = 1 :=
  (eccentricity_eq_one_iff r hr).mpr (trace_integer_plus_bound r hr m hm hlt).2

/-- **[P*] La cónica de un cero es la degenerada exactamente en la línea.** -/
theorem zero_conic_degenerate_iff_line (ρ : ℂ) (h0 : 0 < ρ.re) (h1 : ρ.re < 1) :
    eccentricity (zeroCoord ρ) = 1 ↔ ρ.re = 1 / 2 := by
  have hρ : ρ ≠ 0 := by intro h; rw [h] at h0; simp at h0
  have hl : liMap ρ ≠ 0 := by
    intro hl
    unfold liMap at hl
    have h1ρ : (1 : ℂ) / ρ = 1 := by linear_combination -hl
    have hρ1 : ρ = 1 := ((div_eq_one_iff_eq hρ).mp h1ρ).symm
    rw [hρ1] at h1; norm_num at h1
  have hpos : 0 < zeroCoord ρ := by
    unfold zeroCoord; exact Complex.abs.pos hl
  rw [eccentricity_eq_one_iff _ hpos]
  exact liMap_on_unit_circle_iff ρ hρ

/-- **[P*] Conexión con la conjetura, vía (ii):** la conjetura (con la equivalencia
    clásica) pone a todo cero en la cónica degenerada. -/
theorem conic_degenerates_from_exact_closure (Lf : ℂ → ℂ) (Z : LZeroEnumeration Lf)
    (E : EnvelopeInv) (h : ExactClosure Lf Z E) (hC : ClassicalHalfScale Lf) :
    ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 → Lf ρ = 0 → eccentricity (zeroCoord ρ) = 1 := by
  intro ρ h0 h1 hz
  exact (zero_conic_degenerate_iff_line ρ h0 h1).mpr (the_line_from_exact_closure Lf Z E h hC ρ h0 h1 hz)

/-- **[P*] Conexión con la conjetura, vía (iii):** alturas exactas y distintas (sin
    entrada clásica) ponen a todo cero en la cónica degenerada. -/
theorem conic_degenerates_from_exact_heights (Lf : ℂ → ℂ) (hfe : FunctionalEquation Lf)
    (hrc : RealCoefficients Lf) (Z : LZeroEnumeration Lf)
    (hinj : Function.Injective (fun n => (Z.ρ n).im)) :
    ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 → Lf ρ = 0 → eccentricity (zeroCoord ρ) = 1 := by
  intro ρ h0 h1 hz
  exact (zero_conic_degenerate_iff_line ρ h0 h1).mpr
    (the_line_from_injective_heights Lf hfe hrc Z hinj ρ ⟨h0, h1, hz⟩)

/-- **[P*] Por qué las alturas distintas cierran el margen:** un par que comparte cónica
    con radios recíprocos r y 1/r y que colapsa a un solo punto (r = 1/r) está en la
    cónica degenerada. -/
theorem collapsed_pair_is_degenerate (r : ℝ) (hr : 0 < r) (h : r = 1 / r) :
    eccentricity r = 1 := by
  have h2 : r * r = 1 := by
    have := h; field_simp at this; nlinarith
  have hr1 : r = 1 := by nlinarith
  exact (eccentricity_eq_one_iff r hr).mpr hr1

/-! ## §6b  Clause (iii): the correction, assembled from the residuals of the classes -/

/-- **The assembly of clause (iii).**  Each prime power `n` enters through its class `a`, the
    character `χ₅(a)`, the modulus `n^{-1/2}`, the angle `T log n` and the weight `1/log n`
    (that is `1/k` for `n = p^k`, against `Λ(n) = log p`).  The increment of the residual of its
    class at `n` stands for `Λ(n)`; the structural share `x/8` cancels in the sum over the classes,
    since `∑ₐ χ₅(a) = 0` on `(ℤ/20)ˣ`. -/
def assembledCorrection (r : ZMod 20 → ℝ → ℝ) (T : ℝ) : ℝ :=
  -(1 / Real.pi) * ∑' n : ℕ, ∑ a ∈ ZtwentyStar,
      ((chi5at a : ℤ) : ℝ) * (r a ((n : ℝ) + 2) - r a ((n : ℝ) + 1))
        * (((n : ℝ) + 2) ^ (-(1 / 2 : ℝ)) * Real.sin (T * Real.log ((n : ℝ) + 2))
            / Real.log ((n : ℝ) + 2))

/-- **[O] The closure conjecture with clause (iii) formalised:** the correction with which the
    heights are exact is the assembly of the residuals of the classes.  The derivation of the
    law from the structure, and its successive orders of resolution, are not formalised. -/
def ExactClosureAssembled (Lf : ℂ → ℂ) (Z : LZeroEnumeration Lf) (E : EnvelopeInv) : Prop :=
  ∃ law : ClassResidualLaw,
    (∀ a x, law.r a x = trueResidual a x) ∧
    HalfScale law.r ∧
    (∀ T, law.corr T = assembledCorrection law.r T) ∧
    (∀ n : ℕ, (Z.ρ n).im = E.Einv ((n : ℝ) - law.corr (Z.ρ n).im))

/-- **[P*] The assembled form implies the earlier one**, so every consequence proved from
    `ExactClosure` holds for it. -/
theorem exactClosure_of_assembled {Lf : ℂ → ℂ} {Z : LZeroEnumeration Lf} {E : EnvelopeInv}
    (h : ExactClosureAssembled Lf Z E) : ExactClosure Lf Z E := by
  obtain ⟨law, hr, hs, _, hh⟩ := h
  exact ⟨law, hr, hs, hh⟩

/-- **[P*] The line, from the assembled conjecture** (with the classical equivalence). -/
theorem the_line_from_assembled_closure (Lf : ℂ → ℂ) (Z : LZeroEnumeration Lf) (E : EnvelopeInv)
    (h : ExactClosureAssembled Lf Z E) (hC : ClassicalHalfScale Lf) :
    ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 → Lf ρ = 0 → ρ.re = 1/2 :=
  the_line_from_exact_closure Lf Z E (exactClosure_of_assembled h) hC

/-! ## §6c  La cláusula (iii) como límite (integración, 16 de octubre; nodo EM1)

  `assembledCorrection` es una `∑'`.  Con el residuo verdadero, sus términos sobre los
  primos son χ₅(p)·log p·p^{−1/2}·sen(T log p)/log p; la serie de valores absolutos
  diverge, y en ℝ ser sumable es serlo absolutamente: la `∑'` vale 0 para todo T, y la
  cláusula queda Im ρₙ = E⁻¹(n).  Aquí la corrección es el límite de las sumas
  parciales.  Que ese límite exista es parte del contenido de la conjetura. -/

/-- Sumas parciales de la corrección ensamblada. -/
def assembledPartial (r : ZMod 20 → ℝ → ℝ) (T : ℝ) (N : ℕ) : ℝ :=
  -(1 / Real.pi) * ∑ n ∈ Finset.range N, ∑ a ∈ ZtwentyStar,
      ((chi5at a : ℤ) : ℝ) * (r a ((n : ℝ) + 2) - r a ((n : ℝ) + 1))
        * (((n : ℝ) + 2) ^ (-(1 / 2 : ℝ)) * Real.sin (T * Real.log ((n : ℝ) + 2))
            / Real.log ((n : ℝ) + 2))

/-- **(iii), como límite:** la corrección es el límite de las parciales. -/
def CorrectionIsLimit (law : ClassResidualLaw) : Prop :=
  ∀ T, Filter.Tendsto (assembledPartial law.r T) Filter.atTop (nhds (law.corr T))

/-- **[O] La conjetura de cierre con la cláusula (iii) como límite.** -/
def ExactClosureAssembledLim (Lf : ℂ → ℂ) (Z : LZeroEnumeration Lf) (E : EnvelopeInv) : Prop :=
  ∃ law : ClassResidualLaw,
    (∀ a x, law.r a x = trueResidual a x) ∧
    HalfScale law.r ∧
    CorrectionIsLimit law ∧
    (∀ n : ℕ, (Z.ρ n).im = E.Einv ((n : ℝ) - law.corr (Z.ρ n).im))

/-- **[P*] La forma con límite implica la primera**, así que todo lo probado desde
    `ExactClosure` vale para ella. -/
theorem exactClosure_of_assembledLim {Lf : ℂ → ℂ} {Z : LZeroEnumeration Lf} {E : EnvelopeInv}
    (h : ExactClosureAssembledLim Lf Z E) : ExactClosure Lf Z E := by
  obtain ⟨law, hr, hs, _, hh⟩ := h
  exact ⟨law, hr, hs, hh⟩

end F1PaperClosure
end
end Block26

