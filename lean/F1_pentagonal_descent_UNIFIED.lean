section EstructuraEnGUEBlock

/-
EstructuraEnGUE.lean — Sprint 105. Autorreferencia y binario: dos problemas distintos; y lo que una simetría haría ver
en el espectro. Sin compilar [P*].
-/

namespace EstructuraEnGUE
open Matrix

/-! ### 1. El binario de Lawvere y el binario de la simetría -/

/-- En los dos valores de verdad, `α(x) = 1 - x` (la negación) no tiene punto fijo: es lo que el
argumento diagonal de Lawvere necesita. -/
theorem lawvere_alpha_no_fixed_point (b : Bool) : (!b) ≠ b := by cases b <;> decide

/-- En la recta real, la misma `α(x) = 1 - x` tiene un único punto fijo, `1/2`. -/
theorem alpha_fixed_real (x : ℝ) : 1 - x = x ↔ x = 1 / 2 := by
  constructor <;> intro h <;> linarith

/-- En el plano, el gemelo `ρ ↦ 1 - conj ρ` fija exactamente la recta `Re ρ = 1/2`. -/
theorem mate_fixed_iff (ρ : ℂ) : 1 - (starRingEnd ℂ) ρ = ρ ↔ ρ.re = 1 / 2 := by
  constructor
  · intro h; have := congrArg Complex.re h; simp at this; linarith
  · intro h; apply Complex.ext <;> simp [h]; norm_num

/-! ### 2. Una simetría unitaria se ve en el espectro: sectores -/

/-- Si `H` conmuta con `D` y `v` es vector propio de `D`, entonces `H v` también lo es, con el mismo valor:
`H` respeta cada sector de la simetría. -/
theorem sector_invariant {n : Type*} [Fintype n] [DecidableEq n] (D H : Matrix n n ℂ) (hc : D * H = H * D)
    (v : n → ℂ) (c : ℂ) (hv : D *ᵥ v = c • v) : D *ᵥ (H *ᵥ v) = c • (H *ᵥ v) := by
  rw [mulVec_mulVec, hc, ← mulVec_mulVec, hv, mulVec_smul]

/-! ### 3. Una simetría antiunitaria de cuadrado −1 fuerza dobletes (núcleo de Kramers) -/

/-- Para una matriz antisimétrica `A` (`Aᵀ = -A`) y cualquier vector `w`, `wᵀ A w = 0`. Con `A = U` la parte unitaria
de `T = U ∘ conj`, `T² = -1` da `Uᵀ = -U`, y esto dice que `⟨v, T v⟩ = 0`: `v` y `T v` son ortogonales y tienen el
mismo valor propio. -/
theorem skew_quadratic_zero {n : Type*} [Fintype n] (A : Matrix n n ℂ) (hA : Aᵀ = -A) (w : n → ℂ) :
    w ⬝ᵥ (A *ᵥ w) = 0 := by
  have h1 : w ⬝ᵥ (A *ᵥ w) = w ⬝ᵥ (Aᵀ *ᵥ w) := by
    rw [dotProduct_mulVec, ← mulVec_transpose, dotProduct_comm]
  rw [hA, neg_mulVec, dotProduct_neg] at h1
  have h2 : (2 : ℂ) * (w ⬝ᵥ (A *ᵥ w)) = 0 := by linear_combination h1
  simpa using h2


/-- Una simetría antiunitaria `T v = U * conj v` con `U * conj U = -1` no fija ningún rayo: si `T v = c • v`, entonces
`v = 0`. Es una involución sin punto fijo, como la que el argumento de Lawvere necesita; la de cuadrado `+1` sí fija
rayos (los vectores reales). -/
theorem antiunitary_sq_neg_one_no_fixed_ray {n : Type*} [Fintype n] [DecidableEq n] (U : Matrix n n ℂ)
    (hU : U * U.map (starRingEnd ℂ) = -1) (v : n → ℂ) (c : ℂ)
    (hT : U *ᵥ (fun i => (starRingEnd ℂ) (v i)) = c • v) : v = 0 := by
  -- aplicar T dos veces: T(Tv) = U conj(U conj v) = (U * conj U) v = -v, y también T(c v) = conj c • T v = |c|^2 v
  have h1 : U *ᵥ (fun i => (starRingEnd ℂ) ((U *ᵥ (fun j => (starRingEnd ℂ) (v j))) i)) = -v := by
    have : (fun i => (starRingEnd ℂ) ((U *ᵥ (fun j => (starRingEnd ℂ) (v j))) i)) = U.map (starRingEnd ℂ) *ᵥ v := by
      funext i; simp [Matrix.mulVec, dotProduct, map_sum, map_mul]
    rw [this, mulVec_mulVec, hU, neg_mulVec, one_mulVec]
  have h2 : U *ᵥ (fun i => (starRingEnd ℂ) ((c • v) i)) = ((starRingEnd ℂ) c * c) • v := by
    have : (fun i => (starRingEnd ℂ) ((c • v) i)) = (starRingEnd ℂ) c • (fun i => (starRingEnd ℂ) (v i)) := by
      funext i; simp
    rw [this, mulVec_smul, hT, smul_smul]
  rw [hT] at h1
  have h3 : ((starRingEnd ℂ) c * c + 1) • v = 0 := by rw [add_smul, one_smul, ← h2, h1, neg_add_cancel]
  have hne : (starRingEnd ℂ) c * c + 1 ≠ 0 := by
    have : ((starRingEnd ℂ) c * c).re = Complex.normSq c := by simp [Complex.normSq_apply]
    intro h; have := congrArg Complex.re h; simp at this; nlinarith [Complex.normSq_nonneg c]
  exact (smul_eq_zero.mp h3).resolve_left hne

end EstructuraEnGUE

