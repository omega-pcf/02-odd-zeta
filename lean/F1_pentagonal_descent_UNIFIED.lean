theorem component_four_action (n : ℤ) (p : ℕ) (r : ℝ) (hr : 0 < r) :
    ((φ : ℝ) ^ ((p : ℤ) * n) = ((φ : ℝ) ^ n) ^ p) ∧
    (valPhi (r ^ p) = (p : ℝ) * valPhi r) :=
  ⟨family_carries_power_action p n, valPhi_conjugates_power_with_psi r hr p⟩

theorem component_five_uniqueness (f : ℤ → ℤ)
    (hadd : ∀ m n : ℤ, f (m + n) = f m + f n) (n : ℤ) :
    f n = n * f 1 := by
  have h0 : f 0 = 0 := by
    have := hadd 0 0; simp at this; linarith
  -- (2026-09-06, Ola 4) nombres v4.30: zero/succ/pred (antes hz/hp/hn);
  -- paso pred vía have + simpa (probe /tmp/probe_wave4_intind4.lean)
  induction n using Int.induction_on with
  | zero => simpa using h0
  | succ k ih =>
      have := hadd (k : ℤ) 1
      rw [this, ih]; ring
  | pred k ih =>
      have hstep : f (-↑k - 1) = f (-↑k) + f (-1) := by
        have this := hadd (-(k : ℤ)) (-1)
        exact this
      have hneg : f (-1) = - f 1 := by
        have := hadd 1 (-1); simp [h0] at this; linarith
      rw [hstep, ih, hneg]; ring

theorem component_six_forced_value (r : ℝ) (hr : 0 < r)
    (hle : discP r ≤ 1/12) (k : ℤ) (hk : valPhi r = (k : ℝ)) :
    r = 1 :=
