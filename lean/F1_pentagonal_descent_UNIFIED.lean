section MedioPeriodoBlock

/-!
# Sprint 96. La cota de medio periodo.

Con una sola órbita libre (altura g, distancia δ) y la fórmula explícita sobre la órbita,
V(u) = W(τ_u f − f) = Σ_ρ f̂(γ)f̂(−γ)(2 − 2cos γu).  En u = π/g:
  · parte de la recta: cada término es ≥ 0 y su factor 2 − 2cos ≤ 4, así que aporta ≤ 4P;
  · parte de la órbita: cos(γ·π/g) = −cosh(πδ/g) para los cuatro γ, así que aporta (2 + 2cosh c)·Q.
Si W(f) = P + Q < 0, entonces V(π/g) < 0.  Aquí, el paso final, sobre números reales.

Estado: [P*] escrito, sin compilar.
-/

namespace MedioPeriodo

/-- **[P*] El cierre.**  P ≥ 0 (parte de la recta), Q la parte de la órbita, P + Q < 0,
    Vr ≤ 4P (la recta en u = π/g) y Vq = (2 + 2cosh c)·Q (la órbita en u = π/g). -/
theorem half_period_closes (P Q Vr Vq c : ℝ) (hP : 0 ≤ P) (hW : P + Q < 0)
    (hVr : Vr ≤ 4 * P) (hVq : Vq = (2 + 2 * Real.cosh c) * Q) : Vr + Vq < 0 := by
  have hc : 1 ≤ Real.cosh c := by
    nlinarith [Real.cosh_sq c, Real.cosh_pos c, sq_nonneg (Real.sinh c)]
  have hQ : Q < -P := by linarith
  have : (2 + 2 * Real.cosh c) * Q < (2 + 2 * Real.cosh c) * (-P) :=
    mul_lt_mul_of_pos_left hQ (by linarith)
  nlinarith

/-- **[P*] El factor de la recta está entre 0 y 4.** -/
theorem line_factor (θ : ℝ) : 0 ≤ 2 - 2 * Real.cos θ ∧ 2 - 2 * Real.cos θ ≤ 4 := by
  constructor <;> nlinarith [Real.cos_le_one θ, Real.neg_one_le_cos θ]

/-- **[P*] En u = π/g el factor de la órbita es real: cos(π ± iπδ/g) = −cosh(πδ/g).** -/
theorem orbit_factor (c : ℝ) : Complex.cos (Real.pi + c * Complex.I) = -Real.cosh c := by
  rw [Complex.cos_add, Complex.cos_pi, Complex.sin_pi, Complex.cos_mul_I]
  simp [Complex.ofReal_cosh]

end MedioPeriodo

end MedioPeriodoBlock

