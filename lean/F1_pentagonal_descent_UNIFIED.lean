section TodoEnLeanBlock

namespace TodoEnLean
open Matrix FibraYReloj UnOperador

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- **A diagonal operator is normal.** -/
theorem diagonal_normal (d : ι → ℂ) :
    diagonal d * diagonal (fun i => starRingEnd ℂ (d i)) =
      diagonal (fun i => starRingEnd ℂ (d i)) * diagonal d := by
  rw [diagonal_mul_diagonal, diagonal_mul_diagonal]
  congr 1; funext i; ring

/-- **Commutant of a diagonal with simple spectrum: off-diagonal entries vanish.** -/
theorem commute_diag_offdiag (d : ι → ℂ) (hd : Function.Injective d) (B : Matrix ι ι ℂ)
    (hB : B * diagonal d = diagonal d * B) (i j : ι) (hij : i ≠ j) : B i j = 0 := by
  have h := congrFun (congrFun hB i) j
  rw [mul_diagonal, diagonal_mul] at h
  have hne : d j - d i ≠ 0 := sub_ne_zero.mpr (fun e => hij (hd e).symm)
  have : (d j - d i) * B i j = 0 := by linear_combination h
  rcases mul_eq_zero.mp this with h1 | h1
  · exact absurd h1 hne
  · exact h1

/-- **Every bounded operator commuting with a simple-spectrum diagonal is a function of it.** -/
theorem commute_diag_is_function (d : ι → ℂ) (hd : Function.Injective d) (B : Matrix ι ι ℂ)
    (hB : B * diagonal d = diagonal d * B) :
    ∃ f : ℂ → ℂ, B = diagonal (fun i => f (d i)) := by
  classical
  by_cases hι : Nonempty ι
  · haveI := hι
    let g : ℂ → ι := Function.invFun d
    refine ⟨fun z => B (g z) (g z), ?_⟩
    ext i j
    by_cases hij : i = j
    · subst hij
      have : g (d i) = i := Function.leftInverse_invFun hd i
      simp [diagonal, this]
    · rw [commute_diag_offdiag d hd B hB i j hij]
      simp [diagonal, hij]
  · refine ⟨fun _ => 0, ?_⟩
    ext i; exact absurd ⟨i⟩ hι

/-- **The phase has order exactly six.**  With `ζ³ = 1`, `ζ ≠ 1`, the entry of `Y` at
    colour 2 and orientation 1 is `-ζ²`, a primitive sixth root of unity. -/
theorem yDiag_order_six (ζ : ℂ) (hζ : ζ ^ 3 = 1) (h1 : ζ ≠ 1) :
    yDiag ζ (2, 1) = -ζ ^ 2 ∧ (-ζ ^ 2) ^ 6 = 1 ∧
    (-ζ ^ 2) ^ 1 ≠ 1 ∧ (-ζ ^ 2) ^ 2 ≠ 1 ∧ (-ζ ^ 2) ^ 3 ≠ 1 ∧
    (-ζ ^ 2) ^ 4 ≠ 1 ∧ (-ζ ^ 2) ^ 5 ≠ 1 := by
  have hq : ζ ^ 2 + ζ + 1 = 0 := by
    have : (ζ - 1) * (ζ ^ 2 + ζ + 1) = 0 := by linear_combination hζ
    rcases mul_eq_zero.mp this with h | h
    · exact absurd (sub_eq_zero.mp h) h1
    · exact h
  have hz0 : ζ ≠ 0 := by intro h; rw [h] at hζ; norm_num at hζ
  refine ⟨by simp [yDiag, colour, sign], by linear_combination (ζ ^ 9 + ζ ^ 6 + ζ ^ 3 + 1) * hζ,
    ?_, ?_, ?_, ?_, ?_⟩
  · intro h
    -- -ζ² = 1 and ζ² = -ζ - 1 give ζ = 0
    have : ζ = 0 := by linear_combination h + hq
    exact hz0 this
  · intro h
    -- ζ⁴ = ζ
    have : ζ = 1 := by linear_combination h - ζ * hζ
    exact h1 this
  · intro h
    have : (-1 : ℂ) = 1 := by linear_combination h + (ζ ^ 3 + 1) * hζ
    norm_num at this
  · intro h
    -- ζ⁸ = ζ²,  so ζ² = 1, then ζ = ζ³/ζ² = 1
    have h2 : ζ ^ 2 = 1 := by linear_combination h - (ζ ^ 5 + ζ ^ 2) * hζ
    have : ζ = 1 := by linear_combination hζ - ζ * h2
    exact h1 this
  · intro h
    -- -ζ^10 = -ζ, so ζ = -1, then ζ³ = -1
    have h2 : ζ = -1 := by linear_combination -h - (ζ ^ 7 + ζ ^ 4 + ζ) * hζ
    rw [h2] at hζ; norm_num at hζ

/-- **The deck step multiplies the operator by `-ζ`, a sixth root of unity.** -/
theorem spec_deck (m₀ φ : ℝ) (ζ : ℂ) (hζ : ζ ^ 3 = 1) (σ : ℕ) (x : Fin 3 × Fin 2) :
    spec m₀ φ ζ (σ, deck x) = (-ζ) * spec m₀ φ ζ (σ, x) := by
  simp only [spec, yDiag_deck ζ hζ x]; ring

/-- **A function of the operator commutes with the deck exactly when it is invariant
    under the rotation by `-ζ` on the spectrum.** -/
theorem function_commutes_with_deck_iff (m₀ φ : ℝ) (ζ : ℂ) (hζ : ζ ^ 3 = 1) (f : ℂ → ℂ) :
    (∀ σ x, f (spec m₀ φ ζ (σ, deck x)) = f (spec m₀ φ ζ (σ, x))) ↔
      (∀ σ x, f ((-ζ) * spec m₀ φ ζ (σ, x)) = f (spec m₀ φ ζ (σ, x))) := by
  simp only [spec_deck m₀ φ ζ hζ]

/-- **The polar decomposition is unique.**  If an eigenvalue is `r·u` with `r > 0` real and
    `‖u‖ = 1`, then `r` is the tower value `m₀φ^σ` and `u` is the phase. -/
theorem polar_unique (m₀ φ : ℝ) (hm : 0 < m₀) (hφ : 0 < φ) (ζ : ℂ) (hζ : ζ ^ 3 = 1)
    (p : ℕ × (Fin 3 × Fin 2)) (r : ℝ) (u : ℂ) (hr : 0 < r) (hu : ‖u‖ = 1)
    (h : spec m₀ φ ζ p = (r : ℂ) * u) : r = m₀ * φ ^ p.1 ∧ u = yDiag ζ p.2 := by
  have hn := congrArg norm h
  rw [norm_spec m₀ φ hm hφ ζ hζ, Complex.norm_mul, Complex.norm_real, hu, mul_one,
    Real.norm_of_nonneg hr.le] at hn
  refine ⟨hn.symm, ?_⟩
  have hne : ((r : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hr.ne'
  have h2 : ((r : ℝ) : ℂ) * yDiag ζ p.2 = (r : ℂ) * u := by
    rw [← h, spec, ← hn]
  exact (mul_left_cancel₀ hne h2).symm

/-- The modulus `H = |𝒪|` does not depend on the fibre point, so it commutes with the deck. -/
theorem modulus_deck_invariant (m₀ φ : ℝ) (hm : 0 < m₀) (hφ : 0 < φ) (ζ : ℂ) (hζ : ζ ^ 3 = 1)
    (σ : ℕ) (x : Fin 3 × Fin 2) :
    ‖spec m₀ φ ζ (σ, deck x)‖ = ‖spec m₀ φ ζ (σ, x)‖ := by
  rw [norm_spec m₀ φ hm hφ ζ hζ, norm_spec m₀ φ hm hφ ζ hζ]

end TodoEnLean

