/-! ## 1. El anillo cuadrático R[ω], ω² = ω + 1, en coordenadas a + bω -/

@[ext] structure Q (R : Type*) where
  a : R
  b : R

namespace Q
variable {R : Type*} [CommRing R]

instance : Zero (Q R) := ⟨⟨0, 0⟩⟩
instance : One (Q R) := ⟨⟨1, 0⟩⟩
