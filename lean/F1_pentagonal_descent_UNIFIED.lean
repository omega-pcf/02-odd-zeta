theorem trace_integral_iff_even (k : ℕ) :
    (k % 2 = 0 → e1P ((φ : ℝ) ^ (k : ℤ)) = (lucasN k : ℝ)) ∧
    (k % 2 = 1 → e1P ((φ : ℝ) ^ (k : ℤ)) = Real.sqrt 5 * (Nat.fib k : ℝ)) := by
  constructor
  · intro hk
    unfold e1P
    have hs := binet_sum k
    have hp := phi_inv_pow k
    have hs1 : (-1 : ℝ) ^ k = 1 := by
      have : Even k := ⟨k / 2, by omega⟩
      exact this.neg_one_pow
    have h1 : (1 - φ : ℝ) ^ k = ((φ : ℝ) ^ k)⁻¹ := by
      rw [hp, hs1, one_mul]
    rw [h1] at hs
    rw [show ((φ : ℝ) ^ k)⁻¹ = 1 / (φ : ℝ) ^ k from by exact inv_eq_one_div _] at hs
    exact_mod_cast hs
  · intro hk
    unfold e1P
    have hd := binet_diff k
    have hp := phi_inv_pow k
    have hs1 : (-1 : ℝ) ^ k = -1 := by
      have : Odd k := ⟨k / 2, by omega⟩
      exact this.neg_one_pow
    have h1 : (1 - φ : ℝ) ^ k = -((φ : ℝ) ^ k)⁻¹ := by rw [hp, hs1]; ring
    rw [h1] at hd
    simp only [sub_neg_eq_add] at hd
    rw [show ((φ : ℝ) ^ k)⁻¹ = 1 / (φ : ℝ) ^ k from by exact inv_eq_one_div _] at hd
    rw [mul_comm]
    exact_mod_cast hd

theorem disc_survives_the_norm_sign (k : ℕ) (hk : k % 2 = 1) :
    5 * (Nat.fib k : ℤ) ^ 2 - 4 = (lucasN k : ℤ) ^ 2 := by
  have := lucas_fib_norm k
  have hodd : ((-1 : ℤ)) ^ k = -1 := Odd.neg_one_pow (Nat.odd_iff.mpr hk)
  rw [hodd] at this
  linarith

theorem coords_closed_under_inversion (z : Chi5Zero) :
    zeroCoord z.ρ * zeroCoord (1 - z.ρ) = 1 ∧
    DirichletCharacter.LFunction chi5_D (1 - z.ρ) = 0 := by
  refine ⟨?_, hecke_chi5_derived z.in_strip_pos z.in_strip_lt z.is_zero⟩
  unfold zeroCoord
  apply moduli_product_needs_no_zero
  · intro h; have := z.in_strip_pos; rw [h] at this; simp at this
  · intro h; have := z.in_strip_lt; rw [h] at this; simp at this

theorem inversion_closure_is_not_monomial :
    ((2:ℝ) * (2:ℝ)⁻¹ = 1) ∧ ¬ ∃ k : ℤ, (2:ℝ) = (φ : ℝ) ^ k := by
  refine ⟨by norm_num, ?_⟩
  rintro ⟨k, hk⟩
  -- two_not_in_golden_lattice inlined (forward reference not available here)
  have hφpos : (0:ℝ) < φ := φ_pos
  have h1 : (1:ℝ) < φ := one_lt_phi
  have hlt2 : (φ : ℝ) < 2 := by
    have hsq := phi_sq
    nlinarith [h1]
  have hone : (1:ℝ) ≤ φ := le_of_lt h1
  rcases lt_or_ge k 1 with hk1 | hk1
  · have hn0 : k ≤ 0 := by omega
    have hc : (φ : ℝ) ^ k ≤ (φ : ℝ) ^ (0:ℤ) := zpow_le_zpow_right₀ hone hn0
    rw [zpow_zero] at hc
    exact absurd hk (by linarith)
  · rcases lt_or_ge k 2 with hk2 | hk2
    · have hk11 : (k:ℤ) = 1 := by omega
      rw [hk11, zpow_one] at hk
      linarith
    · if hk22 : (k:ℤ) = 2 then
        rw [hk22, zpow_ofNat] at hk
        rw [phi_sq] at hk
        linarith
      else
        have hge2 : (2:ℤ) ≤ k := by omega
        have hc : (φ : ℝ) ^ 2 ≤ (φ : ℝ) ^ k := zpow_le_zpow_right₀ hone hge2
        rw [phi_sq] at hc
        linarith

theorem E_gives_trace_integral (zeros : Set ℝ) (hE : ∀ r ∈ zeros, r = 1) :
