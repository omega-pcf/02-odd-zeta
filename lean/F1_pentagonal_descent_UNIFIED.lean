theorem step_six_is_the_only_one_asking (reZero : ℂ → ℝ)
    (hemb : SpectralEmbedding reZero) (ρ : ℂ) (k : Fin 3)
    (hw : Complex.abs w_pcf = 1) (h0 : 0 < reZero ρ) (h1 : reZero ρ < 1) :
    -- pasos 1–5, todos probados
    ((∀ r : ℕ, r.Prime → 5 < r → (r : ZMod 20) ∈ ZtwentyStar) ∧
     (Real.cos (Real.pi / 3) = mu_n_param 3) ∧
     ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = 1/2) ∧
     (Complex.abs (Omega_hat k) = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ)))) ∧
    -- paso 6: la ÚNICA hipótesis, y lo que da es una COTA
    ((reZero ρ = 1/2 ∨ reZero ρ = -(1/4)) ∧
     (reZero ρ ≤ 1/2) ∧
     ((1:ℝ)/2 ≤ 1/2 ∧ -(1:ℝ)/4 ≤ 1/2)) := by
  refine ⟨⟨primes_land_in_ZtwentyStar, cos_pi_third_eq_mu3,
           anchor_is_the_spectral_scale, spectrum_modulus_is_the_anchor k hw⟩,
          hemb ρ h0 h1, premiseA_gives_upper_bound reZero hemb ρ h0 h1,
          both_spectral_values_satisfy_the_bound⟩

theorem what_the_embedding_delivers (reZero : ℂ → ℝ)
    (hemb : SpectralEmbedding reZero) (ρ σ : ℂ)
    (h0 : 0 < reZero ρ) (h1 : reZero ρ < 1)
    (g0 : 0 < reZero σ) (g1 : reZero σ < 1) :
    -- (a) la disyunción, que es la definición
    ((reZero ρ = 1/2 ∨ reZero ρ = -(1/4))) ∧
    -- (b) la cota superior: la Premisa A
    (reZero ρ ≤ 1/2) ∧
    -- (c) la igualdad, porque la banda excluye el negativo
    (reZero ρ = 1/2) ∧
    -- (d) y dos ceros cualesquiera comparten parte real
    (reZero ρ = reZero σ) := by
  have hr := the_strip_alone_excludes_the_other_root reZero hemb ρ h0 h1
  have hs := the_strip_alone_excludes_the_other_root reZero hemb σ g0 g1
  exact ⟨hemb ρ h0 h1, premiseA_gives_upper_bound reZero hemb ρ h0 h1, hr,
         by rw [hr, hs]⟩

theorem the_embedding_is_used_by_thirty_eight (reZero : ℂ → ℝ)
    (hemb : SpectralEmbedding reZero) (ρ : ℂ) (k : Fin 3)
