      ((F1PCFUnified.chi5_Z (p : ZMod 5) : ℤ) : ZMod p) = (Nat.fib p : ZMod p) := by
  intro p hp hp5
  by_cases hp2 : p = 2
  · subst hp2
    -- χ₅(2) = −1 y F₂ = 1; en ZMod 2, −1 = 1.
    decide   -- alternativa: `rw [show ((2:ℕ) : ZMod 5) = 2 from rfl, chi5_Z_two]; decide`
  · have hne : ((p : ℕ) : ZMod 5) ≠ 0 := by
      rw [Ne, ZMod.natCast_eq_zero_iff]
      intro hdvd
      exact hp5 (((Nat.prime_dvd_prime_iff_eq (by norm_num) hp).mp hdvd).symm)
    obtain ⟨hsplit, hinert⟩ := F1SpectraAnchorG.fib_value_from_mod5 hp hp2 hp5
    rcases zmod5_nonzero_cases _ hne with h | h | h | h
    · rw [hsplit (Or.inl h), h, chi5_Z_one]; simp
    · rw [hinert (Or.inl h), h, chi5_Z_two]; simp
    · rw [hinert (Or.inr h), h, chi5_Z_three]; simp
    · rw [hsplit (Or.inr h), h, chi5_Z_four]; simp

end S1Closure

end Block03

