/-- The norm form of Q(√5): N(a + bφ) = a² + ab - b². -/
def normForm (a b : ℤ) : ℤ := a^2 + a*b - b^2

theorem normForm_bound (a b : ℤ) :
    |normForm a b| ≤ 2 * a^2 + 2 * b^2 := by
  unfold normForm
  by_cases h : 0 ≤ a^2 + a*b - b^2
  · rw [abs_of_nonneg h]
    nlinarith [sq_nonneg (a - b), sq_nonneg (a + b), sq_nonneg a, sq_nonneg b]
  · push Not at h
    rw [abs_of_neg h]
    nlinarith [sq_nonneg (a - b), sq_nonneg (a + b), sq_nonneg a, sq_nonneg b]

theorem counting_quadratic_bound (u : ℕ) :
    ∀ a b : ℤ, |a| ≤ (u : ℤ) + 1 → |b| ≤ (u : ℤ) + 1 →
    |normForm a b| ≤ 4 * ((u : ℤ) + 1)^2 := by
  intro a b ha hb
  have h1 := normForm_bound a b
  have ha2 : a^2 ≤ ((u : ℤ) + 1)^2 := by
    have habs : (0 : ℤ) ≤ |a| := abs_nonneg _
    nlinarith [sq_abs a, abs_nonneg a]
  have hb2 : b^2 ≤ ((u : ℤ) + 1)^2 := by
    have habs : (0 : ℤ) ≤ |b| := abs_nonneg _
    nlinarith [sq_abs b, abs_nonneg b]
  linarith

def eulerFactor (p : ℕ) (s : ℝ) : ℝ :=
  if _h : (1 : ℝ) < (p : ℝ) ∧ 0 < s
  then 1 / (1 - (p : ℝ)^(-s))
  else 1

theorem geometric_partial_sum (x : ℝ) (hx : x ≠ 1) (N : ℕ) :
    (Finset.range N).sum (fun k => x^k) = (1 - x^N) / (1 - x) := by
  induction N with
  | zero => simp
  | succ M ih =>
    rw [Finset.sum_range_succ, ih]
    have hd : (1 : ℝ) - x ≠ 0 := sub_ne_zero.mpr (Ne.symm hx)
    field_simp; ring

/-- The archimedean correction κ_K for K = Q(√5). -/
def kappa_K (u : ℝ) : ℝ :=
  if u = 1 then 0
  else u^2 * (Real.log u + Real.log 5 / 2) / (u^2 - 1)

theorem kappa_K_pos (u : ℝ) (hu : 1 < u) : 0 < kappa_K u := by
  unfold kappa_K
  have hne : u ≠ 1 := ne_of_gt hu
  rw [if_neg hne]
  have h_u2 : 0 < u^2 := by positivity
  have h_log_u : 0 < Real.log u := Real.log_pos hu
  have h_log_5 : 0 < Real.log 5 := Real.log_pos (by norm_num : (1 : ℝ) < 5)
  have h_log_5_half : 0 < Real.log 5 / 2 := by linarith
  have h_num : 0 < Real.log u + Real.log 5 / 2 := by linarith
  have h_denom : 0 < u^2 - 1 := by nlinarith
  have h_factor : 0 < u^2 * (Real.log u + Real.log 5 / 2) := mul_pos h_u2 h_num
  exact div_pos h_factor h_denom

theorem kappa_K_at_one : kappa_K 1 = 0 := by unfold kappa_K; simp

theorem F1_analytic_data :
    (∀ u : ℕ, ∀ a b : ℤ,
       |a| ≤ (u : ℤ) + 1 → |b| ≤ (u : ℤ) + 1 →
       |normForm a b| ≤ 4 * ((u : ℤ) + 1)^2) ∧
    (∀ u : ℝ, 1 < u → 0 < kappa_K u) ∧
    kappa_K 1 = 0 :=
⟨counting_quadratic_bound, kappa_K_pos, kappa_K_at_one⟩


