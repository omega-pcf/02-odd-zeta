    (ρ : ℂ) (h0 : ρ ≠ 0) :
    ((starRingEnd ℂ) ρ = 1 - ρ ↔ ρ.re = 1 / 2) ∧
    ((ρ + (1 - ρ)).re / 2 = 1 / 2) ∧
    (m ρ = 1 ↔ ρ.re = 1 / 2) ∧
    (Real.cos (Real.pi / 3) = 1 / 2) :=
  ⟨fix_stau_is_the_line ρ, tau_centre_is_half ρ, hf ρ h0,
   li_fixed_point_is_on_the_line⟩

/-! ## §103.3  El locus no es todo el plano -/

