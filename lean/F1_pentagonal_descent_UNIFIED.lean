namespace CierrePorAltura

/-! ## §1 Huecos entre indices admisibles -/

/-- Indice admisible escindido: `p = n j + 1` impar y `p ≡ ±1 (mod 5)`. -/
def AdmSplit (n j : ℕ) : Prop := (n * j + 1) % 2 = 1 ∧ ((n * j + 1) % 5 = 1 ∨ (n * j + 1) % 5 = 4)

/-- Todo multiplo de 10 es admisible escindido. -/
theorem admSplit_of_ten (n k : ℕ) : AdmSplit n (10 * k) := by
  obtain ⟨m, hm⟩ : ∃ m, n * (10 * k) = 10 * m := ⟨n * k, by ring⟩
  unfold AdmSplit
  rw [hm]
  omega

/-- Hueco escindido: despues de cualquier `i` hay un admisible a distancia a lo mas 10. -/
theorem split_gap (n i : ℕ) : ∃ j, i < j ∧ j ≤ i + 10 ∧ AdmSplit n j :=
  ⟨10 * (i / 10 + 1), by omega, by omega, admSplit_of_ten n _⟩

/-- Tabla finita de residuos para el caso inerte: si `a ≢ 0 (mod 5)`, en cinco valores
consecutivos de `k` alguno da `2 a k ≡ 3 (mod 5)`. -/
theorem inert_residue_table :
    ∀ a b : Fin 5, a ≠ 0 → ∃ d : Fin 5, (2 * a.val * (b.val + d.val + 1)) % 5 = 3 := by
  decide

/-- Hueco inerte (forma `p = 2 n k - 1`, indice `j = 4 k`): si `5 ∤ n`, despues de cualquier
`k₀` hay un `k ≤ k₀ + 5` con `p ≡ 2 (mod 5)`, es decir indice admisible a distancia ≤ 20. -/
theorem inert_gap (n k₀ : ℕ) (h5 : n % 5 ≠ 0) :
    ∃ k, k₀ < k ∧ k ≤ k₀ + 5 ∧ (2 * n * k) % 5 = 3 := by
  have ha : (⟨n % 5, Nat.mod_lt _ (by norm_num)⟩ : Fin 5) ≠ 0 := by
    intro h; apply h5; simpa using congrArg Fin.val h
  obtain ⟨d, hd⟩ := inert_residue_table ⟨n % 5, Nat.mod_lt _ (by norm_num)⟩
    ⟨k₀ % 5, Nat.mod_lt _ (by norm_num)⟩ ha
  simp only at hd
  refine ⟨k₀ + d.val + 1, by omega, by have := d.isLt; omega, ?_⟩
  have hn : n = 5 * (n / 5) + n % 5 := (Nat.div_add_mod n 5).symm
  obtain ⟨m, hm⟩ : ∃ m, 2 * n * (k₀ + d.val + 1) = 10 * m + 2 * (n % 5) * (k₀ + d.val + 1) :=
    ⟨(n / 5) * (k₀ + d.val + 1), by conv_lhs => rw [hn]
                                    ring⟩
  rw [hm]
  have hr : n % 5 < 5 := Nat.mod_lt _ (by norm_num)
  generalize n % 5 = r at hd hr ⊢
  interval_cases r <;> omega

/-! ## §2 Cota de indice -/

/-- Escindido: con hueco `s ≤ 10 n` y `p = n i + 1`, se tiene `i s < 10 p`. -/
theorem split_index_bound (n i s p : ℕ) (hs : s ≤ 10 * n) (hp : p = n * i + 1) :
    i * s < 10 * p := by
  subst hp
  have : i * s ≤ i * (10 * n) := Nat.mul_le_mul_left i hs
  nlinarith

/-- Inerte: con hueco `s ≤ 10 n` y `2 (p + 1) = n i`, se tiene `i s ≤ 20 (p + 1)`. -/
theorem inert_index_bound (n i s p : ℕ) (hs : s ≤ 10 * n) (hp : 2 * (p + 1) = n * i) :
    i * s ≤ 20 * (p + 1) := by
  have : i * s ≤ i * (10 * n) := Nat.mul_le_mul_left i hs
  nlinarith

/-! ## §3 Cota logaritmica -/

/-- `log (1 + x) ≤ x` para `x > -1`; aqui `x = s/p > 0`. -/
theorem log_one_add_le (x : ℝ) (hx : 0 < x) : Real.log (1 + x) ≤ x := by
  have := Real.log_le_sub_one_of_pos (show (0:ℝ) < 1 + x by linarith)
  linarith

/-- La altura necesaria `c / log (1 + s/p)` es al menos `c p / s`. -/
theorem height_lower (c s p : ℝ) (hc : 0 < c) (hs : 0 < s) (hp : 0 < p) :
    c * p / s ≤ c / Real.log (1 + s / p) := by
  have hx : 0 < s / p := div_pos hs hp
  have hL : 0 < Real.log (1 + s / p) := Real.log_pos (by linarith)
  have hle : Real.log (1 + s / p) ≤ s / p := log_one_add_le _ hx
  rw [le_div_iff₀ hL]
  calc c * p / s * Real.log (1 + s / p) ≤ c * p / s * (s / p) :=
        mul_le_mul_of_nonneg_left hle (by positivity)
    _ = c := by field_simp [hs.ne', hp.ne']

/-! ## §4 Lema de la altura -/

/-- **Lema de la altura (escindido).** Si `p = n i + 1`, el hueco al siguiente admisible es
`s ≤ 10 n`, y `p` es resolvible a altura `T` con constante `c` (es decir `c / log (1 + s/p) ≤ T`),
entonces `i ≤ 10 T / c`. Por tanto la criba con `I ≥ 10 T / c` lo encuentra. -/
theorem height_lemma_split (c T : ℝ) (n i s p : ℕ) (hc : 0 < c) (hs0 : 0 < s)
    (hs : s ≤ 10 * n) (hp : p = n * i + 1)
    (hres : c / Real.log (1 + (s : ℝ) / p) ≤ T) :
    (i : ℝ) ≤ 10 * T / c := by
  have hp0 : (0 : ℝ) < p := by rw [hp]; exact_mod_cast Nat.succ_pos _
  have hsR : (0 : ℝ) < s := by exact_mod_cast hs0
  have h1 : c * p / s ≤ T := (height_lower c s p hc hsR hp0).trans hres
  have h2 : ((i * s : ℕ) : ℝ) < ((10 * p : ℕ) : ℝ) := by
    exact_mod_cast split_index_bound n i s p hs hp
  push_cast at h2
  rw [le_div_iff₀ hc]
  rw [div_le_iff₀ hsR] at h1
  nlinarith [mul_lt_mul_of_pos_left h2 hc, hsR, hc]

/-- **Lema de la altura (inerte).** Con `2 (p + 1) = n i` y `s ≤ 10 n`: `i s ≤ 20 (T/c) s + 20`,
es decir `i ≤ 20 T / c + 20 / s`. -/
theorem height_lemma_inert (c T : ℝ) (n i s p : ℕ) (hc : 0 < c) (hs0 : 0 < s) (hp0 : 0 < p)
    (hs : s ≤ 10 * n) (hp : 2 * (p + 1) = n * i)
    (hres : c / Real.log (1 + (s : ℝ) / p) ≤ T) :
    (i : ℝ) * s ≤ 20 * (T / c) * s + 20 := by
  have hpR : (0 : ℝ) < p := by exact_mod_cast hp0
  have hsR : (0 : ℝ) < s := by exact_mod_cast hs0
  have h1 : c * p / s ≤ T := (height_lower c s p hc hsR hpR).trans hres
  have h2 : ((i * s : ℕ) : ℝ) ≤ ((20 * (p + 1) : ℕ) : ℝ) := by
    exact_mod_cast inert_index_bound n i s p hs hp
  push_cast at h2
  have h3 : (p : ℝ) ≤ T / c * s := by
    rw [div_le_iff₀ hsR] at h1
    rw [div_mul_eq_mul_div, le_div_iff₀ hc]
    linarith
  linarith

/-! ## §5 La criba -/

/-- Candidatos del nivel `n` con indice `≤ I`: escindidos `n i + 1` e inertes `n i / 2 - 1`. -/
def cands (n I : ℕ) : List ℕ :=
  (List.range (I + 1)).map (fun i => n * i + 1) ++ (List.range (I + 1)).map (fun i => n * i / 2 - 1)

/-- La criba: candidatos `> 5`, primos, que dividen a `Q`. -/
def sieve (Q n I : ℕ) : List ℕ :=
  (cands n I).filter (fun p => decide (5 < p) && decide (p ∣ Q) && decide (Nat.Prime p))

/-- Sana: todo lo que devuelve la criba es primo y divide a `Q`. -/
theorem sieve_sound (Q n I p : ℕ) (h : p ∈ sieve Q n I) : Nat.Prime p ∧ p ∣ Q := by
  unfold sieve at h
  rw [List.mem_filter] at h
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h
  exact ⟨h.2.2, h.2.1.2⟩

/-- Completa: todo primo `> 5` que divide a `Q` y tiene la forma del nivel con indice `≤ I`
esta en la criba. -/
theorem sieve_complete (Q n I p i : ℕ) (hp : Nat.Prime p) (h5 : 5 < p) (hQ : p ∣ Q) (hi : i ≤ I)
    (hform : p = n * i + 1 ∨ p = n * i / 2 - 1) : p ∈ sieve Q n I := by
  unfold sieve cands
  rw [List.mem_filter]
  refine ⟨?_, by simp [h5, hQ, hp]⟩
  rw [List.mem_append, List.mem_map, List.mem_map]
  rcases hform with h | h
  · exact Or.inl ⟨i, List.mem_range.mpr (by omega), h.symm⟩
  · exact Or.inr ⟨i, List.mem_range.mpr (by omega), h.symm⟩

/-- **Cierre a altura T (escindido).** Un primo escindido del nivel, resolvible a altura `T`,
esta en la criba con cualquier `I` tal que `10 T / c ≤ I`. -/
theorem closure_split (Q n i s p I : ℕ) (c T : ℝ) (hc : 0 < c) (hs0 : 0 < s) (hs : s ≤ 10 * n)
    (hpr : Nat.Prime p) (h5 : 5 < p) (hQ : p ∣ Q) (hpf : p = n * i + 1)
    (hres : c / Real.log (1 + (s : ℝ) / p) ≤ T) (hI : 10 * T / c ≤ I) :
    p ∈ sieve Q n I := by
  have h := height_lemma_split c T n i s p hc hs0 hs hpf hres
  have hiI : i ≤ I := by exact_mod_cast h.trans hI
  exact sieve_complete Q n I p i hpr h5 hQ hiI (Or.inl hpf)

/-! ## §6 El resto exacto -/

/-- Al quitar a `R` toda la potencia de `p`, el producto se conserva: `p^v · R' = R`. -/
theorem strip_spec (R p : ℕ) : p ^ (R.factorization p) * (R / p ^ (R.factorization p)) = R :=
  Nat.ordProj_mul_ordCompl_eq_self R p

/-! ## §7 Cierre por soporte (sprint 66): sin hipotesis

Para `g` con soporte en `[-L, L]` (clase de Weil) solo entran ideales de norma `≤ X = e^L`.
En el nivel `n` esos tienen indice `≤ 2 (X + 1) / n`, y la criba con esa cota los da todos. -/

theorem split_index_le_of_norm (n i p X : ℕ) (hn : 0 < n) (hp : p = n * i + 1) (hX : p ≤ X) :
    i ≤ 2 * (X + 1) / n := by
  rw [Nat.le_div_iff_mul_le hn]
  subst hp
  nlinarith

theorem inert_index_le_of_norm (n i p X : ℕ) (hn : 0 < n) (hp : 2 * (p + 1) = n * i) (hX : p ≤ X) :
    i ≤ 2 * (X + 1) / n := by
  rw [Nat.le_div_iff_mul_le hn]
  nlinarith

/-- **Cierre por soporte.** Todo primo `> 5` del nivel `n` (escindido o inerte), que divide a `Q`
y es `≤ X`, esta en la criba con `I = 2 (X + 1) / n`. Sin hipotesis de resolucion. -/
theorem closure_support (Q n i p X : ℕ) (hn : 0 < n) (hpr : Nat.Prime p) (h5 : 5 < p) (hQ : p ∣ Q)
    (hform : p = n * i + 1 ∨ 2 * (p + 1) = n * i) (hX : p ≤ X) :
    p ∈ sieve Q n (2 * (X + 1) / n) := by
  rcases hform with h | h
  · exact sieve_complete Q n _ p i hpr h5 hQ (split_index_le_of_norm n i p X hn h hX) (Or.inl h)
  · refine sieve_complete Q n _ p i hpr h5 hQ (inert_index_le_of_norm n i p X hn h hX) (Or.inr ?_)
    obtain ⟨m, hm⟩ : ∃ m, n * i = m := ⟨_, rfl⟩
    rw [hm] at h ⊢
    omega

end CierrePorAltura

end CierrePorAlturaBlock

