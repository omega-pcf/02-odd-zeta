section Block20

/-
  F1_v2_formalizations.lean
  ────────────────────────────────────────────────────────────────────────
  Formalisation of the statements that version 2 of the paper listed as proved
  only in the text.  Tier [P*]: written against the corpus and F1_cw_equivalents, NOT compiled
  here.  No `sorry`, no `axiom`.

    §A  Theorem 17.9(b) — integrality of the trace inside ℤ[φ] ⟹ power of φ,
        without Dirichlet, by the corpus's own `unit_is_a_power_of_phi`.
    §B  Corollary 13.x — the Dedekind factorisation is natural in the quadratic
        character: one identity for the three fields of conductor dividing 20.
    §C  Proposition 14.x — Soulé's polynomial-count condition fails for ζ_{ℚ(√5)}.
    §D  Proposition 14.y — logarithmic derivative of the local factors of ζ_K,
        and their expansion as Σ_k log N𝔭 · N𝔭^{-ks}.
    §E  Theorem 14.z — the weights of the PCF counting function at the
        prime-power norms.

  What stays outside: the Weil window of Theorem 20.x needs the Gauss integral of
  the digamma function and Fourier analysis on L²(ℝ); those are recorded as the
  inputs of that theorem in the paper.
-/





namespace F1v2

open Real

/-! ## §A  Integrality of the trace inside ℤ[φ] -/

/-- φ, local copy (the corpus has several with the same definiens). -/
noncomputable def φ0 : ℝ := (1 + Real.sqrt 5) / 2

theorem sqrt5_sq : Real.sqrt 5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)

theorem φ0_sq : φ0 ^ 2 = φ0 + 1 := by
  unfold φ0; linear_combination (1/4 : ℝ) * sqrt5_sq

theorem one_lt_φ0 : 1 < φ0 := by
  unfold φ0
  have h : (1:ℝ) < Real.sqrt 5 := by
    nlinarith [sqrt5_sq, Real.sqrt_nonneg 5]
  linarith

theorem φ0_pos : 0 < φ0 := lt_trans one_pos one_lt_φ0

/-- The norm form of ℤ[φ]: N(a + bφ) = a² + ab − b². -/
def normZ (a b : ℤ) : ℤ := a ^ 2 + a * b - b ^ 2

/-- **[P*]** The conjugate multiplies to the norm: (a + bφ)((a+b) − bφ) = N(a,b). -/
theorem mul_conj_eq_norm (a b : ℤ) :
    ((a:ℝ) + b * φ0) * (((a + b : ℤ) : ℝ) - b * φ0) = (normZ a b : ℝ) := by
  have h := φ0_sq
  unfold normZ; push_cast
  linear_combination (-(b:ℝ) ^ 2) * h

/-- **[P*]** Coordinates in ℤ[φ] are unique: 1 and φ are ℚ-independent. -/
theorem coords_unique (x y : ℤ) (h : (x:ℝ) + y * φ0 = 0) : x = 0 ∧ y = 0 := by
  have hirr : Irrational (Real.sqrt 5) := (by norm_num : Nat.Prime 5).irrational_sqrt
  by_cases hy : y = 0
  · subst hy; simp at h; exact ⟨by exact_mod_cast h, rfl⟩
  · exfalso
    have hy' : (y:ℝ) ≠ 0 := by exact_mod_cast hy
    have h' : (2 * (x:ℝ) + y) + y * Real.sqrt 5 = 0 := by
      unfold φ0 at h; linear_combination 2 * h
    have hs : Real.sqrt 5 = (-(2 * (x:ℝ) + y)) / y := by
      field_simp; linear_combination h'
    exact hirr ⟨((-(2 * x + y) : ℤ) : ℚ) / (y : ℚ), by rw [hs]; push_cast; ring⟩

/-- **[P*]** Product in coordinates. -/
theorem mul_coords (a b c d : ℤ) :
    ((a:ℝ) + b * φ0) * ((c:ℝ) + d * φ0)
      = ((a * c + b * d : ℤ) : ℝ) + ((a * d + b * c + b * d : ℤ) : ℝ) * φ0 := by
  have h := φ0_sq
  push_cast; linear_combination ((b:ℝ) * d) * h

/-- **[P*]** The norm is multiplicative. -/
theorem normZ_mul (a b c d : ℤ) :
    normZ (a * c + b * d) (a * d + b * c + b * d) = normZ a b * normZ c d := by
  unfold normZ; ring

/-- Units of ℤ[φ], as a predicate on ℝ. -/
def IsUnitZφ (r : ℝ) : Prop :=
  ∃ a b : ℤ, r = (a:ℝ) + b * φ0 ∧ (normZ a b = 1 ∨ normZ a b = -1)

/-- **[P*]** They form a group (the corpus predicate `UnitsAreAGroup`). -/
theorem unitsZφ_group : UnitsAreAGroup IsUnitZφ := by
  refine ⟨⟨1, 0, by simp, Or.inl (by simp [normZ])⟩, ?_, ?_⟩
  · rintro u v ⟨a, b, rfl, ha⟩ ⟨c, d, rfl, hc⟩
    refine ⟨a * c + b * d, a * d + b * c + b * d, mul_coords a b c d, ?_⟩
    rw [normZ_mul]
    rcases ha with ha | ha <;> rcases hc with hc | hc <;> simp [ha, hc]
  · rintro u ⟨a, b, rfl, ha⟩ hu
    have hc := mul_conj_eq_norm a b
    have e1 : normZ (a + b) (-b) = normZ a b := by unfold normZ; ring
    have e2 : normZ (-(a + b)) b = normZ a b := by unfold normZ; ring
    rcases ha with ha | ha
    · refine ⟨a + b, -b, ?_, Or.inl (by rw [e1, ha])⟩
      rw [ha] at hc; push_cast at hc ⊢
      rw [div_eq_iff hu]; linear_combination (-1 : ℝ) * hc
    · refine ⟨-(a + b), b, ?_, Or.inr (by rw [e2, ha])⟩
      rw [ha] at hc; push_cast at hc ⊢
      rw [div_eq_iff hu]; linear_combination hc

theorem φ0_is_unit : IsUnitZφ φ0 := ⟨0, 1, by simp, Or.inr (by simp [normZ])⟩

/-- **[P*]** Powers of φ, for every integer exponent, are units. -/
theorem φ0_zpow_is_unit (m : ℤ) : IsUnitZφ (φ0 ^ m) := by
  obtain ⟨h1, hmul, hinv⟩ := unitsZφ_group
  have hnat : ∀ n : ℕ, IsUnitZφ (φ0 ^ n) := by
    intro n; induction n with
    | zero => simpa using h1
    | succ k ih => rw [pow_succ]; exact hmul _ _ ih φ0_is_unit
  rcases m with n | n
  · simpa using hnat n
  · rw [zpow_negSucc, inv_eq_one_div]
    exact hinv _ (hnat (n + 1)) (pow_ne_zero _ (ne_of_gt φ0_pos))

/-- **[P*]** Division by powers of φ stays in the group (`hquot` of the corpus). -/
theorem quotZφ (v : ℝ) (m : ℤ) (hv : IsUnitZφ v) : IsUnitZφ (v / φ0 ^ m) := by
  obtain ⟨_, hmul, hinv⟩ := unitsZφ_group
  rw [div_eq_mul_one_div]
  exact hmul _ _ hv (hinv _ (φ0_zpow_is_unit m) (zpow_ne_zero _ (ne_of_gt φ0_pos)))

/-- **[P*]** No unit strictly between 1 and φ (the corpus predicate `NoUnitBelowPhi`),
    from `no_unit_below_phi_universal`, which is proved without Dirichlet. -/
theorem noUnitBelowφ0 : NoUnitBelowPhi φ0 IsUnitZφ := by
  rintro u ⟨a, b, rfl, hN⟩ h1 hlt
  by_contra hne
  have hu1 : 1 < (a:ℝ) + b * φ0 := lt_of_le_of_ne h1 (Ne.symm hne)
  have hc := mul_conj_eq_norm a b
  refine no_unit_below_phi_universal ((a:ℝ) + b * φ0) (((a + b : ℤ) : ℝ) - b * φ0) φ0
    (2 * a + b) φ0_sq one_lt_φ0 hu1 hlt ?_ ?_
  · push_cast; ring
  · rcases hN with h | h
    · left; rw [hc, h]; simp
    · right; rw [hc, h]; simp

/-- **[P*]** ⌊log u / log φ⌋ exists (the corpus predicate `FloorLogExists`). -/
theorem floorLogφ0 : FloorLogExists φ0 := by
  intro u hu
  have hl : 0 < Real.log φ0 := Real.log_pos one_lt_φ0
  obtain ⟨k, hk⟩ : ∃ k : ℤ, k = ⌊Real.log u / Real.log φ0⌋ := ⟨_, rfl⟩
  have hlo : (k:ℝ) ≤ Real.log u / Real.log φ0 := by rw [hk]; exact Int.floor_le _
  have hhi : Real.log u / Real.log φ0 < (k:ℝ) + 1 := by rw [hk]; exact Int.lt_floor_add_one _
  rw [le_div_iff₀ hl] at hlo
  rw [div_lt_iff₀ hl] at hhi
  refine ⟨k, ?_, ?_⟩
  · rw [← Real.rpow_intCast, Real.rpow_def_of_pos φ0_pos]
    calc Real.exp (Real.log φ0 * (k:ℝ)) ≤ Real.exp (Real.log u) :=
          Real.exp_le_exp.mpr (by linarith [mul_comm (Real.log φ0) (k:ℝ)])
      _ = u := Real.exp_log hu
  · rw [← Real.rpow_intCast, Real.rpow_def_of_pos φ0_pos]
    push_cast
    calc u = Real.exp (Real.log u) := (Real.exp_log hu).symm
      _ < Real.exp (Real.log φ0 * ((k:ℝ) + 1)) :=
          Real.exp_lt_exp.mpr (by linarith [mul_comm (Real.log φ0) ((k:ℝ) + 1)])

/-- **[P*] Theorem 17.9(b).**  A positive element of ℤ[φ] whose trace r + 1/r is an
    integer is a power of φ.  No appeal to Dirichlet: the descent is the corpus's
    `unit_is_a_power_of_phi`, with its three structural inputs proved above.

    The hypothesis `r ∈ ℤ[φ]` is what the paper obtains from `r ∈ ℚ(√5)`: r is a
    root of x² − t x + 1, hence an algebraic integer of ℚ(√5), hence in 𝒪_K = ℤ[φ]
    (Proposition 7.x). -/
theorem arrowB (r : ℝ) (hr : 0 < r) (a b : ℤ) (hab : r = (a:ℝ) + b * φ0)
    (m : ℤ) (ht : r + 1 / r = (m:ℝ)) : ∃ k : ℤ, r = φ0 ^ k := by
  -- 1/r = m − r lies in ℤ[φ]
  have hinv : 1 / r = ((m - a : ℤ) : ℝ) + ((-b : ℤ) : ℝ) * φ0 := by
    rw [hab] at ht ⊢; push_cast; linear_combination ht
  -- so r · (1/r) = 1 in coordinates, and the norm is a unit of ℤ
  have hprod := mul_coords a b (m - a) (-b)
  rw [← hab, ← hinv, mul_one_div_cancel (ne_of_gt hr)] at hprod
  have hc := coords_unique (a * (m - a) + b * -b - 1) (a * -b + b * (m - a) + b * -b)
    (by push_cast at hprod ⊢; linear_combination (-1 : ℝ) * hprod)
  have hN : normZ a b * normZ (m - a) (-b) = 1 := by
    rw [← normZ_mul]
    have e1 : a * (m - a) + b * -b = 1 := by linarith [hc.1]
    have e2 : a * -b + b * (m - a) + b * -b = 0 := hc.2
    rw [e1, e2]; simp [normZ]
  have hunit : IsUnitZφ r := ⟨a, b, hab, by
    rcases Int.eq_one_or_neg_one_of_mul_eq_one hN with h | h
    · exact Or.inl h
    · exact Or.inr h⟩
  exact unit_is_a_power_of_phi φ0 r IsUnitZφ one_lt_φ0 hr hunit floorLogφ0
    noUnitBelowφ0 unitsZφ_group quotZφ

/-- **[P*] Theorem 17.9(c).**  Without the hypothesis r ∈ ℤ[φ] the arrow fails:
    2 + √3 has integer trace. -/
theorem arrow_needs_the_field :
    (2 + Real.sqrt 3) + 1 / (2 + Real.sqrt 3) = (4 : ℝ) := by
  have h3 : Real.sqrt 3 ^ 2 = 3 := Real.sq_sqrt (by norm_num)
  have hpos : (0:ℝ) < 2 + Real.sqrt 3 := by positivity
  field_simp; nlinarith [h3]

/-! ## §B  The factorisation is natural in the quadratic character -/

/-- **[P*]** For every value c ∈ {0, 1, −1} of a quadratic character, the local factor
    of the Dedekind zeta is the product of those of ζ and of L(·, χ).  One identity,
    uniform in the character. -/
theorem local_dedekind_uniform (c : ℤ) (hc : c = 0 ∨ c = 1 ∨ c = -1) (u : ℝ)
    (h1 : 1 - u ≠ 0) (h2 : 1 + u ≠ 0) :
    F1CW.eulerFactorK c u = F1CW.eulerFactorZ u * F1CW.eulerFactorL c u := by
  rcases hc with rfl | rfl | rfl
  · exact F1CW.local_dedekind_ramified_K u
  · exact F1CW.local_dedekind_split_K u
  · exact F1CW.local_dedekind_inert_K u h1 h2

/-- The character of conductor 4. -/
def chi4N (n : ℕ) : ℤ := if n % 4 = 1 then 1 else if n % 4 = 3 then -1 else 0

/-- The character of conductor 20, χ₄ χ₅ (field ℚ(√−5)). -/
def chi20N (n : ℕ) : ℤ := chi4N n * F1CW.chi5 n

theorem chi4N_vals (n : ℕ) : chi4N n = 0 ∨ chi4N n = 1 ∨ chi4N n = -1 := by
  unfold chi4N; split_ifs <;> simp

theorem chi5_vals (n : ℕ) : F1CW.chi5 n = 0 ∨ F1CW.chi5 n = 1 ∨ F1CW.chi5 n = -1 := by
  unfold F1CW.chi5
  have : n % 5 < 5 := Nat.mod_lt _ (by norm_num)
  interval_cases h : n % 5 <;> simp

theorem chi20N_vals (n : ℕ) : chi20N n = 0 ∨ chi20N n = 1 ∨ chi20N n = -1 := by
  unfold chi20N
  rcases chi4N_vals n with h | h | h <;> rcases chi5_vals n with k | k | k <;> simp [h, k]

/-- **[P*] Corollary 13.x (the factorisation is universal).**  The same local
    identity holds for the three quadratic fields of conductor dividing 20 —
    ℚ(i), ℚ(√5), ℚ(√−5) — at every n. -/
theorem factorisation_natural (n : ℕ) (u : ℝ) (h1 : 1 - u ≠ 0) (h2 : 1 + u ≠ 0) :
    F1CW.eulerFactorK (chi4N n) u = F1CW.eulerFactorZ u * F1CW.eulerFactorL (chi4N n) u ∧
    F1CW.eulerFactorK (F1CW.chi5 n) u = F1CW.eulerFactorZ u * F1CW.eulerFactorL (F1CW.chi5 n) u ∧
    F1CW.eulerFactorK (chi20N n) u = F1CW.eulerFactorZ u * F1CW.eulerFactorL (chi20N n) u :=
  ⟨local_dedekind_uniform _ (chi4N_vals n) u h1 h2,
   local_dedekind_uniform _ (chi5_vals n) u h1 h2,
   local_dedekind_uniform _ (chi20N_vals n) u h1 h2⟩

/-- **[P*]** The four fibres of G are the four sign pairs (χ₄, χ₅). -/
theorem four_fibres_are_sign_pairs :
    (chi4N 1, F1CW.chi5 1) = (1, 1) ∧ (chi4N 3, F1CW.chi5 3) = (-1, -1) ∧
    (chi4N 11, F1CW.chi5 11) = (-1, 1) ∧ (chi4N 13, F1CW.chi5 13) = (1, -1) := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> decide

/-! ## §C  Soulé's condition fails for ζ_{ℚ(√5)} -/

/-- **[P*]** The number of degree-one points of Spec ℤ[φ] over 𝔽_p is 1 + χ₅(p):
    two above a split prime, none above an inert one. -/
theorem degree_one_count :
    (F1CW.numAboveK F1CW.SplitTypeK.split = 2 ∧ F1CW.resDegreeK F1CW.SplitTypeK.split = 1) ∧
    (F1CW.resDegreeK F1CW.SplitTypeK.inert = 2) := ⟨⟨rfl, rfl⟩, rfl⟩

/-- **[P*] Proposition 14.x.**  No polynomial with integer coefficients counts the
    degree-one points: there is no N ∈ ℤ[X] with N(p) = 1 + χ₅(p) for every prime
    p ≠ 5.  Hence ζ_{ℚ(√5)} is not the zeta function of a scheme satisfying
    Soulé's polynomial-count condition. -/
theorem not_soule :
    ¬ ∃ N : Polynomial ℤ, ∀ p : ℕ, p.Prime → p ≠ 5 →
        N.eval (p : ℤ) = 1 + F1CW.chi5 p := by
  rintro ⟨N, hN⟩
  have hroot : ∀ p : ℕ, p.Prime → p ≠ 5 → (N * (N - 2)).IsRoot (p : ℤ) := by
    intro p hp h5
    have hv := hN p hp h5
    have hmod : p % 5 ≠ 0 := by
      intro h0
      have hdvd : 5 ∣ p := Nat.dvd_of_mod_eq_zero h0
      exact h5 ((Nat.prime_dvd_prime_iff_eq (by norm_num) hp).mp hdvd).symm
    have hc : F1CW.chi5 p = 1 ∨ F1CW.chi5 p = -1 := by
      unfold F1CW.chi5
      have : p % 5 < 5 := Nat.mod_lt _ (by norm_num)
      interval_cases h : p % 5 <;> simp_all
    simp only [Polynomial.IsRoot.def, Polynomial.eval_mul, Polynomial.eval_sub,
      Polynomial.eval_ofNat, hv]
    rcases hc with h | h <;> rw [h] <;> norm_num
  have hprimes : Set.Infinite {p : ℕ | p.Prime ∧ p ≠ 5} := by
    refine (Nat.infinite_setOf_prime.diff (Set.finite_singleton 5)).mono ?_
    rintro p ⟨hp, h5⟩
    exact ⟨hp, by simpa using h5⟩
  have himg : Set.Infinite ((fun n : ℕ => (n : ℤ)) '' {p : ℕ | p.Prime ∧ p ≠ 5}) :=
    Set.Infinite.image (fun a _ b _ h => by exact_mod_cast h) hprimes
  have hinf : Set.Infinite {x : ℤ | (N * (N - 2)).IsRoot x} :=
    himg.mono (by rintro x ⟨p, ⟨hp, h5⟩, rfl⟩; exact hroot p hp h5)
  have hQ0 : N * (N - 2) = 0 := Polynomial.eq_zero_of_infinite_isRoot _ hinf
  have h11 := hN 11 (by norm_num) (by norm_num)
  have h2 := hN 2 Nat.prime_two (by norm_num)
  rcases mul_eq_zero.mp hQ0 with h | h
  · rw [h] at h11; norm_num [F1CW.chi5] at h11
  · have hN2 : N = 2 := sub_eq_zero.mp h
    rw [hN2] at h2; norm_num [F1CW.chi5] at h2

/-! ## §D  Logarithmic derivative of the local factors of ζ_K -/

/-- **[P*]** For a prime ideal of norm N𝔭 = p^f, the local term −log(1 − N𝔭^{−s}) has
    derivative −f log p · N𝔭^{−s}/(1 − N𝔭^{−s}); i.e. −ζ_K'/ζ_K receives
    log N𝔭 · N𝔭^{−s}/(1 − N𝔭^{−s}) from 𝔭. -/
theorem local_log_deriv (p f s : ℝ) (hp : 1 < p) (hx : p ^ (-(f * s)) < 1) :
    HasDerivAt (fun s => -Real.log (1 - p ^ (-(f * s))))
      (-(f * Real.log p) * (p ^ (-(f * s)) / (1 - p ^ (-(f * s))))) s := by
  have hp0 : 0 < p := lt_trans one_pos hp
  have hlin : HasDerivAt (fun s : ℝ => -(f * s)) (-f) s := by
    have h : HasDerivAt (fun t : ℝ => f * t) f s := by
      simpa [mul_comm] using (hasDerivAt_id s).const_mul f
    exact h.neg
  have hx' : HasDerivAt (fun s : ℝ => p ^ (-(f * s)))
      (p ^ (-(f * s)) * Real.log p * (-f)) s :=
    (Real.hasStrictDerivAt_const_rpow hp0 (-(f * s))).hasDerivAt.comp s hlin
  have hne : 1 - p ^ (-(f * s)) ≠ 0 := by linarith
  have hlog := ((hasDerivAt_const s (1:ℝ)).sub hx').log hne
  have hfin := hlog.neg
  convert hfin using 1
  have hterm : ((fun x : ℝ => (1:ℝ)) - fun s : ℝ => p ^ (-(f * s))) s
      = 1 - p ^ (-(f * s)) := rfl
  rw [hterm]
  field_simp
  ring

/-- **[P*]** The Dirichlet expansion of the local term:
    x/(1 − x) = Σ_{k ≥ 1} x^k for 0 ≤ x < 1, with x = N𝔭^{−s}. -/
theorem local_dirichlet_expansion (x : ℝ) (h0 : 0 ≤ x) (h1 : x < 1) :
    HasSum (fun k : ℕ => x ^ (k + 1)) (x / (1 - x)) := by
  have h := (hasSum_geometric_of_lt_one h0 h1).mul_left x
  have e : (fun k : ℕ => x * x ^ k) = fun k => x ^ (k + 1) := by
    funext k; ring
  rw [e] at h
  simpa [div_eq_mul_inv] using h

/-! ## §E  Weights of the PCF counting function -/

/-- **[P*] Theorem 14.z, the weights.**  At the prime-power norms the counting function
    carries the mass (number of primes above p) × log N𝔭: 2 log p at a split prime
    (two primes of norm p), 2 log p at an inert prime (one prime of norm p²), and
    log p at the ramified prime. -/
theorem pcf_counting_weights (p : ℝ) (hp : 0 < p) :
    (F1CW.numAboveK F1CW.SplitTypeK.split : ℝ) * F1CW.vonMangoldtK F1CW.SplitTypeK.split p = 2 * Real.log p ∧
    (F1CW.numAboveK F1CW.SplitTypeK.inert : ℝ) * F1CW.vonMangoldtK F1CW.SplitTypeK.inert p = 2 * Real.log p ∧
    (F1CW.numAboveK F1CW.SplitTypeK.ramified : ℝ) * F1CW.vonMangoldtK F1CW.SplitTypeK.ramified p = Real.log p := by
  obtain ⟨hs, hi⟩ := F1CW.von_mangoldt_k_values p hp
  refine ⟨?_, ?_, ?_⟩
  · rw [hs]; norm_num [F1CW.numAboveK]
  · rw [hi]; norm_num [F1CW.numAboveK]
  · simp [F1CW.numAboveK, F1CW.vonMangoldtK, F1CW.ideal_norm_k, F1CW.resDegreeK]

/-! ## §G  From ℚ(√5) to ℤ[φ]: the arrow of Theorem 17.9(b) in full -/

/-- **[P*]** 1 and √5 are linearly independent over ℚ. -/
theorem rat_sqrt5_indep (x y : ℚ) (h : (x:ℝ) + y * Real.sqrt 5 = 0) : x = 0 ∧ y = 0 := by
  have hirr : Irrational (Real.sqrt 5) := (by norm_num : Nat.Prime 5).irrational_sqrt
  by_cases hy : y = 0
  · subst hy; simp at h; exact ⟨by exact_mod_cast h, rfl⟩
  · exfalso
    have hy' : (y:ℝ) ≠ 0 := by exact_mod_cast hy
    exact hirr ⟨-x / y, by push_cast; rw [div_eq_iff hy']; linear_combination -h⟩

/-- **[P*]** A rational root of a monic integer quadratic is an integer
    (rational root theorem, Mathlib's `isInteger_of_is_root_of_monic`). -/
theorem int_of_monic_quadratic_root (c d : ℤ) (a : ℚ)
    (h : a ^ 2 + (c:ℚ) * a + (d:ℚ) = 0) : ∃ z : ℤ, (z:ℚ) = a := by
  have hmon : (Polynomial.X ^ 2 + Polynomial.C c * Polynomial.X + Polynomial.C d :
      Polynomial ℤ).Monic := by monicity!
  have hr : Polynomial.aeval a
      (Polynomial.X ^ 2 + Polynomial.C c * Polynomial.X + Polynomial.C d : Polynomial ℤ) = 0 := by
    simp only [map_add, map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
    exact h
  obtain ⟨z, hz⟩ := isInteger_of_is_root_of_monic hmon hr
  exact ⟨z, by simpa using hz⟩

/-- **[P*] The integrality step.**  A positive real of ℚ(√5) whose trace r + 1/r is an
    integer lies in ℤ[φ].  Proof: r is a root of x² − m x + 1; comparing rational and
    irrational parts, either r is rational (then an integer, by the rational root
    theorem) or r = (m + S√5)/2 with m² − 5S² = 4, where S is an integer because 5
    is prime, and m ≡ S (mod 2) because (m − S)(m + S) = 4(1 + S²). -/
theorem arrowB_Q (r : ℝ) (hr : 0 < r) (x y : ℚ) (hxy : r = x + y * Real.sqrt 5)
    (m : ℤ) (ht : r + 1 / r = m) : ∃ a b : ℤ, r = (a:ℝ) + b * φ0 := by
  have hr0 : r ≠ 0 := ne_of_gt hr
  have hq : r ^ 2 - m * r + 1 = 0 := by
    have e : r ^ 2 - m * r + 1 = r * ((r + 1 / r) - m) := by field_simp; ring
    rw [e, ht, sub_self, mul_zero]
  have hsq := sqrt5_sq
  have hsplit : ((x ^ 2 + 5 * y ^ 2 - m * x + 1 : ℚ) : ℝ)
      + ((2 * x * y - m * y : ℚ) : ℝ) * Real.sqrt 5 = 0 := by
    rw [hxy] at hq; push_cast; linear_combination hq - (y:ℝ) ^ 2 * hsq
  obtain ⟨E1, E2⟩ := rat_sqrt5_indep _ _ hsplit
  by_cases hy : y = 0
  · -- rational case
    subst hy
    obtain ⟨z, hz⟩ := int_of_monic_quadratic_root (-m) 1 x (by push_cast; linear_combination E1)
    refine ⟨z, 0, ?_⟩
    rw [hxy, ← hz]; push_cast; ring
  · -- irrational case
    have hx2 : 2 * x = m := by
      have h0 : y * (2 * x - m) = 0 := by linear_combination E2
      rcases mul_eq_zero.mp h0 with h | h
      · exact absurd h hy
      · linarith
    have h5 : 5 * (2 * y) ^ 2 = (m:ℚ) ^ 2 - 4 := by
      linear_combination 4 * E1 - (2 * x - m) * hx2
    obtain ⟨W, hW⟩ := int_of_monic_quadratic_root 0 (-5 * (m ^ 2 - 4)) (5 * (2 * y))
      (by push_cast; linear_combination 5 * h5)
    have hW2 : W ^ 2 = 5 * (m ^ 2 - 4) := by
      have h' : ((W ^ 2 : ℤ) : ℚ) = ((5 * (m ^ 2 - 4) : ℤ) : ℚ) := by
        push_cast; rw [hW]; linear_combination 5 * h5
      exact_mod_cast h'
    have hp5 : Prime (5:ℤ) := Int.prime_iff_natAbs_prime.mpr (by norm_num)
    obtain ⟨S, hS⟩ := hp5.dvd_of_dvd_pow (show (5:ℤ) ∣ W ^ 2 from ⟨_, hW2⟩)
    have hSy : (S:ℚ) = 2 * y := by
      have h' := hW; rw [hS] at h'; push_cast at h'; linarith
    have hMS : m ^ 2 - 5 * S ^ 2 = 4 := by
      have h' : 5 * (5 * S ^ 2) = 5 * (m ^ 2 - 4) := by rw [← hW2, hS]; ring
      linarith
    have h4 : (m - S) * (m + S) = 2 * (2 * (1 + S ^ 2)) := by linear_combination hMS
    have hev : Even (m - S) := by
      have he : Even ((m - S) * (m + S)) := ⟨2 * (1 + S ^ 2), by rw [h4]; ring⟩
      rcases Int.even_mul.mp he with h | h
      · exact h
      · obtain ⟨c, hc⟩ := h; exact ⟨c - S, by linarith⟩
    obtain ⟨A, hA⟩ := hev
    refine ⟨A, S, ?_⟩
    have hxr : (x:ℝ) = (m:ℝ) / 2 := by
      have h' := congrArg (fun q : ℚ => (q:ℝ)) hx2; push_cast at h'; linarith
    have hyr : (y:ℝ) = (S:ℝ) / 2 := by
      have h' := congrArg (fun q : ℚ => (q:ℝ)) hSy; push_cast at h'; linarith
    have hAr : (A:ℝ) = ((m:ℝ) - S) / 2 := by
      have h' := congrArg (fun z : ℤ => (z:ℝ)) hA; push_cast at h'; linarith
    rw [hxy, hxr, hyr, hAr]; unfold φ0; ring

/-- **[P*] Theorem 17.9(b), in the paper's form.**  A positive real of ℚ(√5) with integer
    trace is a power of φ. -/
theorem arrowB_full (r : ℝ) (hr : 0 < r) (x y : ℚ) (hxy : r = x + y * Real.sqrt 5)
    (m : ℤ) (ht : r + 1 / r = m) : ∃ k : ℤ, r = φ0 ^ k := by
  obtain ⟨a, b, hab⟩ := arrowB_Q r hr x y hxy m ht
  exact arrowB r hr a b hab m ht

/-! ## §H  The PCF counting function, assembled locally -/

/-- **[P*] Theorem 14.z, local assembly.**  The contribution of a rational prime to
    −ζ_K'/ζ_K is a Dirichlet series supported on the prime-power norms, with weight
    (number of primes above p) × log N𝔭 at each power: for 0 ≤ x < 1 (x = N𝔭^{−s}),
    Σ_k w · x^{k+1} = w · x/(1 − x). -/
theorem pcf_counting_local (w x : ℝ) (h0 : 0 ≤ x) (h1 : x < 1) :
    HasSum (fun k : ℕ => w * x ^ (k + 1)) (w * (x / (1 - x))) :=
  (local_dirichlet_expansion x h0 h1).mul_left w

/-! ## §F  The first window of Weil positivity (Theorem 20.x)

  The four steps of the paper's proof are proved here:
    `dirichlet_localisation`   the Dirichlet form dominates its restriction to I × Iᶜ
                               (Tonelli, in lintegral form);
    `midpoint_bound`           the potential of a convex tail is smallest at the midpoint;
    `potential_integral_bound` integrating the potential against f²;
    `absorption`, `first_window`, `first_window_integral`  the prime term absorbed by the
                               end strips, and the assembly.
  Two inputs remain, both declared in the paper and neither a gap in the argument:
    the Gauss integral of the digamma function, which identifies the archimedean
    term of Weil's functional with κ‖f‖² plus the Dirichlet form — part of the
    explicit formula, classical [C];
    the numerical values of the potential, κ + K(L/2) ≥ m and the strip excess,
    certified with rigorous error bounds by `weil_window_rigorous_check.py` [N].
-/

/-- **[P*] The localisation of the Dirichlet form (Tonelli).**  For f vanishing off I
    and a non-negative kernel k, the double integral of k(|x − y|)(f(x) − f(y))² over ℝ²
    dominates its restriction to I × Iᶜ, which is ∫_I f(x)² ∫_{Iᶜ} k(|x − y|) dy dx.
    (Counting I × Iᶜ once; the symmetric Iᶜ × I gives the same again, which is the
    factor 2 of the paper.)  Stated in `lintegral` form, so no integrability is needed. -/
theorem dirichlet_localisation (k : ℝ → ENNReal) (f : ℝ → ℝ) (I : Set ℝ)
    (hI : MeasurableSet I) (hf0 : ∀ y, y ∉ I → f y = 0)
    (hmeas : AEMeasurable (fun p : ℝ × ℝ => k |p.1 - p.2| * ENNReal.ofReal ((f p.1 - f p.2) ^ 2))
      ((MeasureTheory.volume.restrict I).prod (MeasureTheory.volume.restrict Iᶜ))) :
    ∫⁻ x in I, ENNReal.ofReal (f x ^ 2) * ∫⁻ y in Iᶜ, k |x - y|
      ≤ ∫⁻ p : ℝ × ℝ, k |p.1 - p.2| * ENNReal.ofReal ((f p.1 - f p.2) ^ 2) := by
  have hin : ∀ x, ENNReal.ofReal (f x ^ 2) * ∫⁻ y in Iᶜ, k |x - y|
      = ∫⁻ y in Iᶜ, k |x - y| * ENNReal.ofReal ((f x - f y) ^ 2) := by
    intro x
    rw [← MeasureTheory.lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
      ← MeasureTheory.lintegral_indicator hI.compl, ← MeasureTheory.lintegral_indicator hI.compl]
    congr 1; funext y
    by_cases hy : y ∈ Iᶜ
    · have h0 : f y = 0 := hf0 y hy
      simp [Set.indicator, hy, h0, mul_comm]
    · simp [Set.indicator, hy]
  calc ∫⁻ x in I, ENNReal.ofReal (f x ^ 2) * ∫⁻ y in Iᶜ, k |x - y|
      = ∫⁻ x in I, ∫⁻ y in Iᶜ, k |x - y| * ENNReal.ofReal ((f x - f y) ^ 2) := by
        simp_rw [hin]
    _ = ∫⁻ p in I ×ˢ Iᶜ, k |p.1 - p.2| * ENNReal.ofReal ((f p.1 - f p.2) ^ 2) := by
        rw [MeasureTheory.Measure.volume_eq_prod, ← MeasureTheory.Measure.prod_restrict,
          MeasureTheory.lintegral_prod _ hmeas]
    _ ≤ _ := MeasureTheory.setLIntegral_le_lintegral _ _

/-- **[P*]** For a convex tail K, the potential is smallest at the midpoint:
    ½(K(c − x) + K(c + x)) ≥ K(c). -/
theorem midpoint_bound (K : ℝ → ℝ) (D : Set ℝ) (hK : ConvexOn ℝ D K)
    (c x : ℝ) (h1 : c - x ∈ D) (h2 : c + x ∈ D) :
    K c ≤ (K (c - x) + K (c + x)) / 2 := by
  have h := hK.2 h1 h2 (by norm_num : (0:ℝ) ≤ 1/2) (by norm_num : (0:ℝ) ≤ 1/2) (by norm_num)
  have e : (1/2 : ℝ) • (c - x) + (1/2 : ℝ) • (c + x) = c := by simp [smul_eq_mul]; ring
  rw [e] at h
  simp [smul_eq_mul] at h
  linarith

/-- **[P*]** The absorption inequality: |a b| ≤ (a² + b²)/2, the pointwise form of
    |g(log 2)| ≤ ½ ∫_S f² on the end strips. -/
theorem absorption (a b : ℝ) : |a * b| ≤ (a ^ 2 + b ^ 2) / 2 := by
  rw [abs_le]; constructor <;> nlinarith [sq_nonneg (a + b), sq_nonneg (a - b)]

/-- **[P*]** Integrating the potential: if V ≥ m on I and V ≥ m + c₂ on the strips
    S ⊆ I, then ∫_I f² V ≥ m ∫_I f² + c₂ ∫_S f². -/
theorem potential_integral_bound (f V : ℝ → ℝ) (I S : Set ℝ) (hI : MeasurableSet I)
    (hS : MeasurableSet S) (hSI : S ⊆ I) (m c2 : ℝ)
    (hVI : ∀ x ∈ I, m ≤ V x) (hVS : ∀ x ∈ S, m + c2 ≤ V x)
    (hint1 : MeasureTheory.IntegrableOn (fun x => f x ^ 2 * V x) I)
    (hint2 : MeasureTheory.IntegrableOn (fun x => f x ^ 2) I) :
    m * (∫ x in I, f x ^ 2) + c2 * (∫ x in S, f x ^ 2) ≤ ∫ x in I, f x ^ 2 * V x := by
  have e : (fun x => f x ^ 2 * (m + c2 * S.indicator (fun _ => (1:ℝ)) x))
      = fun x => m * f x ^ 2 + c2 * S.indicator (fun x => f x ^ 2) x := by
    funext x; by_cases hx : x ∈ S <;> simp [Set.indicator, hx] <;> ring
  have hi2 : MeasureTheory.IntegrableOn (fun x => m * f x ^ 2 + c2 * S.indicator (fun x => f x ^ 2) x) I :=
    (hint2.const_mul m).add ((hint2.indicator hS).const_mul c2)
  have hind : MeasureTheory.IntegrableOn
      (fun x => f x ^ 2 * (m + c2 * S.indicator (fun _ => (1:ℝ)) x)) I := by rw [e]; exact hi2
  have hmono : ∫ x in I, f x ^ 2 * (m + c2 * S.indicator (fun _ => (1:ℝ)) x)
      ≤ ∫ x in I, f x ^ 2 * V x := by
    refine MeasureTheory.setIntegral_mono_on hind hint1 hI ?_
    intro x hx
    apply mul_le_mul_of_nonneg_left _ (sq_nonneg _)
    by_cases hxS : x ∈ S
    · simp only [Set.indicator, hxS, if_true]; linarith [hVS x hxS]
    · simp only [Set.indicator, hxS, if_false]; linarith [hVI x hx]
  have hcalc : ∫ x in I, f x ^ 2 * (m + c2 * S.indicator (fun _ => (1:ℝ)) x)
      = m * (∫ x in I, f x ^ 2) + c2 * (∫ x in S, f x ^ 2) := by
    rw [e, MeasureTheory.integral_add (hint2.const_mul m) ((hint2.indicator hS).const_mul c2),
      MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul,
      MeasureTheory.integral_indicator hS, MeasureTheory.Measure.restrict_restrict hS,
      Set.inter_eq_left.mpr hSI]
  linarith [hmono, hcalc]

/-- **[P*] Theorem 20.x (the first window), assembled.**  With `A` the archimedean term,
    `Anorm = ‖f‖²`, `Pstrip = ∫_S f²`, `g2 = g(log 2)`: if the archimedean term dominates
    the localised form with potential bounded as in `potential_integral_bound`, and the
    prime term is absorbed by the strips, then Q = A + √2 log 2 · g(log 2) ≥ m ‖f‖². -/
theorem first_window (A Aloc Anorm Pstrip g2 m c2 : ℝ)
    (hDir : Aloc ≤ A)
    (hpot : m * Anorm + c2 * Pstrip ≤ Aloc)
    (hg2 : |g2| ≤ Pstrip / 2)
    (hstrip : Real.sqrt 2 * Real.log 2 ≤ 2 * c2)
    (hPs : 0 ≤ Pstrip) :
    m * Anorm ≤ A + Real.sqrt 2 * Real.log 2 * g2 := by
  have hl : 0 ≤ Real.sqrt 2 * Real.log 2 :=
    mul_nonneg (Real.sqrt_nonneg 2) (Real.log_nonneg (by norm_num))
  have hg : -(Pstrip / 2) ≤ g2 := by linarith [neg_abs_le g2, hg2]
  have hprime : -(Real.sqrt 2 * Real.log 2) * (Pstrip / 2) ≤ Real.sqrt 2 * Real.log 2 * g2 := by
    nlinarith [hg, hl]
  nlinarith [hDir, hpot, hstrip, hPs, hprime]

/-- **[P*] The first window, in integral form.**  Everything but the two named inputs is
    proved: `hDir` (the Tonelli localisation of the Dirichlet form) and `hNumI`, `hNumS`
    (the numerical potential bounds, [N]). -/
theorem first_window_integral (f V : ℝ → ℝ) (I S : Set ℝ) (hI : MeasurableSet I)
    (hS : MeasurableSet S) (hSI : S ⊆ I) (A g2 m c2 : ℝ)
    (hNumI : ∀ x ∈ I, m ≤ V x) (hNumS : ∀ x ∈ S, m + c2 ≤ V x)
    (hint1 : MeasureTheory.IntegrableOn (fun x => f x ^ 2 * V x) I)
    (hint2 : MeasureTheory.IntegrableOn (fun x => f x ^ 2) I)
    (hDir : (∫ x in I, f x ^ 2 * V x) ≤ A)
    (hg2 : |g2| ≤ (∫ x in S, f x ^ 2) / 2)
    (hstrip : Real.sqrt 2 * Real.log 2 ≤ 2 * c2) :
    m * (∫ x in I, f x ^ 2) ≤ A + Real.sqrt 2 * Real.log 2 * g2 := by
  have hPs : 0 ≤ ∫ x in S, f x ^ 2 :=
    MeasureTheory.setIntegral_nonneg hS (fun x _ => sq_nonneg (f x))
  exact first_window A _ _ _ g2 m c2 hDir
    (potential_integral_bound f V I S hI hS hSI m c2 hNumI hNumS hint1 hint2) hg2 hstrip hPs

/-! ## §I  The dimensional chain ℝ → ℂ → E³

  Following the discussion of the odd-zeta paper: the dimensions are classes under
  equivalence, each realised in several domains.

  · d = 1, the line.  φ^σ : (ℝ, +) → (ℝ_{>0}, ×) is an isomorphism, so the tower is the
    real line; the Frobenius lifts act on it as multiplication by p and compose as
    the primes multiply; carried over all primes they give the Euler product.
  · d = 2, the plane.  ℂ = ℝ[x]/(x² + 1); the line winds onto the circle with period
    2π, and the Euler products converge on the plane.
  · d = 3, E³ = {(x, y, φy)}.  The golden coupling z = φy; the self-measurement
    z² = zy + y²; and the operator's ratios φ^{i−j} act on E³, folding back onto
    (y, z) with Fibonacci coefficients and determinant (−1)^{i−j}. -/

/-- **[P*] d = 1.**  φ^σ is an isomorphism (ℝ, +) ≅ (ℝ_{>0}, ×): it turns sums into
    products, it is injective, and every positive real is reached. -/
theorem line_is_the_tower :
    (∀ s t : ℝ, φ0 ^ (s + t) = φ0 ^ s * φ0 ^ t) ∧
    (∀ s t : ℝ, φ0 ^ s = φ0 ^ t → s = t) ∧
    (∀ u : ℝ, 0 < u → ∃ s : ℝ, φ0 ^ s = u) := by
  have hl : Real.log φ0 ≠ 0 := ne_of_gt (Real.log_pos one_lt_φ0)
  refine ⟨fun s t => Real.rpow_add φ0_pos s t, ?_, ?_⟩
  · intro s t h
    have h' := congrArg Real.log h
    rw [Real.log_rpow φ0_pos, Real.log_rpow φ0_pos] at h'
    exact mul_right_cancel₀ hl h'
  · intro u hu
    refine ⟨Real.log u / Real.log φ0, ?_⟩
    rw [Real.rpow_def_of_pos φ0_pos]
    have e : Real.log φ0 * (Real.log u / Real.log φ0) = Real.log u := by field_simp
    rw [e, Real.exp_log hu]

/-- **[P*] d = 1, the Frobenius on the line.**  The lift ψ_p(φ^σ) = φ^{pσ} is
    multiplication by p on the line, and ψ_q ∘ ψ_p = ψ_{pq}. -/
theorem frobenius_on_the_line (p q : ℕ) (σ : ℝ) :
    (φ0 ^ σ) ^ (p:ℝ) = φ0 ^ ((p:ℝ) * σ) ∧
    ((φ0 ^ σ) ^ (p:ℝ)) ^ (q:ℝ) = φ0 ^ (((p * q : ℕ) : ℝ) * σ) := by
  constructor
  · rw [← Real.rpow_mul (le_of_lt φ0_pos), mul_comm]
  · rw [← Real.rpow_mul (le_of_lt φ0_pos), ← Real.rpow_mul (le_of_lt φ0_pos)]
    congr 1; push_cast; ring

/-- **[P*] d = 1 → the Euler product.**  The lifts act on the line as the
    multiplicative monoid of the integers; the Dirichlet series over its levels is the
    Euler product (unique factorisation). -/
theorem euler_product_from_the_line (s : ℂ) (hs : 1 < s.re) :
    (∀ (p q : ℕ) (σ : ℝ), ((φ0 ^ σ) ^ (p:ℝ)) ^ (q:ℝ) = φ0 ^ (((p * q : ℕ) : ℝ) * σ)) ∧
    (∑' n : ℕ, 1 / (n : ℂ) ^ s = ∏' p : Nat.Primes, (1 - (p : ℂ) ^ (-s))⁻¹) :=
  ⟨fun p q σ => (frobenius_on_the_line p q σ).2, F1CW.dirichlet_is_euler hs⟩

/-- **[P*] d = 2.**  The plane: i² = −1, and the line winds onto the circle with
    period 2π. -/
theorem plane_from_the_line :
    Complex.I ^ 2 = -1 ∧
    ∀ θ : ℝ, Complex.exp (((θ + 2 * Real.pi : ℝ) : ℂ) * Complex.I)
      = Complex.exp ((θ : ℂ) * Complex.I) := by
  refine ⟨Complex.I_sq, fun θ => ?_⟩
  push_cast
  rw [add_mul, Complex.exp_add, Complex.exp_two_pi_mul_I, mul_one]

/-- The golden extension E³ = {(x, y, φy)}. -/
def E3 : Set (ℝ × ℝ × ℝ) := {v | v.2.2 = φ0 * v.2.1}

/-- **[P*] d = 3, self-measurement.**  On E³, z² = z y + y²: the square of the third
    coordinate folds back onto the second. -/
theorem self_measurement_E3 (v : ℝ × ℝ × ℝ) (hv : v ∈ E3) :
    v.2.2 ^ 2 = v.2.2 * v.2.1 + v.2.1 ^ 2 := by
  have h : v.2.2 = φ0 * v.2.1 := hv
  rw [h]; linear_combination v.2.1 ^ 2 * φ0_sq

/-- **[P*] d = 3, the operator's ratios fold back.**  The ratio φ^{k} of the operator
    (k = i − j) sends the coupled coordinate to an integer combination of z = φy and y
    with Fibonacci coefficients: φ^{k+1} y = F_{k+1} z + F_k y. -/
theorem ratio_folds_back (k : ℕ) (y : ℝ) :
    φ0 ^ (k + 1) * y = (Nat.fib (k + 1) : ℝ) * (φ0 * y) + (Nat.fib k : ℝ) * y := by
  rw [F1CW.binet_general φ0 φ0_sq k]; ring

/-- **[P*] d = 3, E³ is invariant under the ratios.** -/
theorem E3_closed_under_ratios (k : ℕ) (v : ℝ × ℝ × ℝ) (hv : v ∈ E3) :
    (v.1, φ0 ^ k * v.2.1, φ0 ^ k * v.2.2) ∈ E3 := by
  have h : v.2.2 = φ0 * v.2.1 := hv
  show φ0 ^ k * v.2.2 = φ0 * (φ0 ^ k * v.2.1)
  rw [h]; ring

/-- The Galois conjugate φ̄ = (1 − √5)/2. -/
noncomputable def ψ0 : ℝ := (1 - Real.sqrt 5) / 2

theorem φ0_mul_ψ0 : φ0 * ψ0 = -1 := by
  unfold φ0 ψ0; linear_combination (-1/4 : ℝ) * sqrt5_sq

/-- **[P*] d = 3, the determinant of the ratio.**  The ratio at distance k has norm
    φ^k φ̄^k = (−1)^k: the parity of the index distance. -/
theorem ratio_norm (k : ℕ) : φ0 ^ k * ψ0 ^ k = (-1) ^ k := by
  rw [← mul_pow, φ0_mul_ψ0]

/-- **[P*] The dimensional chain, assembled.** -/
theorem dimensional_chain (s : ℂ) (hs : 1 < s.re) :
    -- d = 1: the line is the tower, and the Euler product emerges from it
    ((∀ s t : ℝ, φ0 ^ (s + t) = φ0 ^ s * φ0 ^ t) ∧
      (∑' n : ℕ, 1 / (n : ℂ) ^ s = ∏' p : Nat.Primes, (1 - (p : ℂ) ^ (-s))⁻¹)) ∧
    -- d = 2: the plane, and the winding of the line
    (Complex.I ^ 2 = -1) ∧
    -- d = 3: self-measurement on E³ and the fold-back of the operator's ratios
    (∀ v ∈ E3, v.2.2 ^ 2 = v.2.2 * v.2.1 + v.2.1 ^ 2) ∧
    (∀ (k : ℕ) (y : ℝ),
      φ0 ^ (k + 1) * y = (Nat.fib (k + 1) : ℝ) * (φ0 * y) + (Nat.fib k : ℝ) * y) ∧
    (∀ k : ℕ, φ0 ^ k * ψ0 ^ k = (-1) ^ k) :=
  ⟨⟨line_is_the_tower.1, F1CW.dirichlet_is_euler hs⟩,
   plane_from_the_line.1, self_measurement_E3, ratio_folds_back, ratio_norm⟩

/-! ## §J  S₃, E³ and c = 3 from the Euler product (the odd-zeta paper, Cor. "S₃ from Euler")

  Euler product → |ker G| = 2 → μ₃ = ½ → S₃ → E³, c = 3. -/

/-- **[P*]** The chain of the odd-zeta paper, each arrow a declaration of the corpus:
    the Euler product; the kernel of G has two classes; the contraction 1/μ₃ = 2;
    the spectral constraints force (σ, μ) = (3/2, 1/2); the tripartite norms multiply
    to ½; S-duality fixes τ = i and ℓ = 1/ℓ forces ℓ = 1; and c = 3ℓ/(2G) equals 3
    exactly when G = ½. -/
theorem S3_E3_c3_from_the_euler_product (s : ℂ) (hs : 1 < s.re) :
    (∑' n : ℕ, 1 / (n : ℂ) ^ s = ∏' p : Nat.Primes, (1 - (p : ℂ) ^ (-s))⁻¹) ∧
    (∀ a : ZMod 20, a ∈ F1PCFUnified.ZtwentyStar →
        (F1PCFUnified.G a = (0, 0) ↔ a = 1 ∨ a = 9)) ∧
    ((1 : ℝ) / F1PCFUnified.mu3 = 2) ∧
    (∀ σ μ : ℝ, σ + μ = 2 → σ * μ = 3 / 4 → μ < 1 → 0 < μ → σ = 3 / 2 ∧ μ = 1 / 2) ∧
    (F1PCFUnified.norm_P * F1PCFUnified.norm_C * F1PCFUnified.norm_F = (1:ℝ) / 2) ∧
    (F1CW.sDuality Complex.I = Complex.I) ∧
    (∀ t : ℝ, 0 < t → (1 / t = t ↔ t = 1)) ∧
    (∀ G : ℝ, 0 < G → (3 / (2 * G) = 3 ↔ G = 1 / 2)) :=
  ⟨F1CW.dirichlet_is_euler hs, F1PCFUnified.G_kernel,
   F1PCFUnified.contraction_is_kernel,
   fun σ μ h1 h2 h3 h4 => F1PCFUnified.spectral_uniqueness σ μ h1 h2 h3 h4,
   F1PCFUnified.norm_Omega_is_half, F1CW.s_duality_fixes_i,
   selfdual_fixed_point, F1CW.hinge_central_charge⟩

/-! ## §K  A further domain of the three-dimensional class: the binary forms on ℤ[φ]

  The two-dimensional lattice ℤ[φ] carries a three-dimensional space, its binary
  quadratic forms, with the discriminant b² − 4ac of signature (2,1): the isometry
  group is SO(2,1) ≅ PSL₂(ℝ).  Multiplication by φ acts as an integral Lorentz
  transformation: it reverses the norm form (discriminant 5) and boosts the null forms
  (x + φy)², (x + φ̄y)² by φ^{±2}, rapidity 2 log φ = 2R_K. -/

def evalQ (v : ℝ × ℝ × ℝ) (x y : ℝ) : ℝ := v.1 * x ^ 2 + v.2.1 * x * y + v.2.2 * y ^ 2
def discQ (v : ℝ × ℝ × ℝ) : ℝ := v.2.1 ^ 2 - 4 * v.1 * v.2.2
def symF (v : ℝ × ℝ × ℝ) : ℝ × ℝ × ℝ := (v.2.2, v.2.1 + 2 * v.2.2, v.1 + v.2.1 + v.2.2)

theorem symF_is_pullback (v : ℝ × ℝ × ℝ) (x y : ℝ) :
    evalQ (symF v) x y = evalQ v y (x + y) := by
  simp only [evalQ, symF]; ring

theorem discQ_signature (v : ℝ × ℝ × ℝ) :
    discQ v = v.2.1 ^ 2 + (v.1 - v.2.2) ^ 2 - (v.1 + v.2.2) ^ 2 := by
  simp only [discQ]; ring

theorem symF_preserves_disc (v : ℝ × ℝ × ℝ) : discQ (symF v) = discQ v := by
  simp only [discQ, symF]; ring

theorem norm_form_disc_and_reversed :
    discQ (1, 1, -1) = 5 ∧ symF (1, 1, -1) = (-1, -1, 1) := by
  refine ⟨by simp only [discQ]; norm_num, by simp only [symF]; norm_num⟩

theorem symF_charpoly (l : ℝ) :
    -l ^ 3 + 2 * l ^ 2 + 2 * l - 1 = -(l + 1) * (l ^ 2 - 3 * l + 1) := by ring

theorem ψ0_sq : ψ0 ^ 2 = ψ0 + 1 := by
  unfold ψ0; linear_combination (1/4 : ℝ) * sqrt5_sq

theorem null_boost_plus :
    symF (1, 2 * φ0, φ0 ^ 2) = (φ0 ^ 2 * 1, φ0 ^ 2 * (2 * φ0), φ0 ^ 2 * φ0 ^ 2) := by
  have h := φ0_sq
  simp only [symF, Prod.mk.injEq]
  refine ⟨by ring, ?_, ?_⟩
  · linear_combination (-2 * φ0) * h
  · linear_combination (-(φ0 ^ 2 + φ0 + 1)) * h

theorem null_boost_minus :
    symF (1, 2 * ψ0, ψ0 ^ 2) = (ψ0 ^ 2 * 1, ψ0 ^ 2 * (2 * ψ0), ψ0 ^ 2 * ψ0 ^ 2) := by
  have h := ψ0_sq
  simp only [symF, Prod.mk.injEq]
  refine ⟨by ring, ?_, ?_⟩
  · linear_combination (-2 * ψ0) * h
  · linear_combination (-(ψ0 ^ 2 + ψ0 + 1)) * h

theorem null_forms_and_rapidity :
    discQ (1, 2 * φ0, φ0 ^ 2) = 0 ∧ discQ (1, 2 * ψ0, ψ0 ^ 2) = 0 ∧
    φ0 ^ 2 * ψ0 ^ 2 = 1 := by
  refine ⟨by simp only [discQ]; ring, by simp only [discQ]; ring, ?_⟩
  calc φ0 ^ 2 * ψ0 ^ 2 = (φ0 * ψ0) ^ 2 := by ring
    _ = 1 := by rw [φ0_mul_ψ0]; norm_num

theorem iterate_eigen (v : ℝ × ℝ × ℝ) (l : ℝ)
    (h : symF v = (l * v.1, l * v.2.1, l * v.2.2)) (k : ℕ) :
    symF^[k] v = (l ^ k * v.1, l ^ k * v.2.1, l ^ k * v.2.2) := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [Function.iterate_succ_apply', ih]
    have h1 := congrArg (fun w : ℝ × ℝ × ℝ => w.1) h
    have h2 := congrArg (fun w : ℝ × ℝ × ℝ => w.2.1) h
    have h3 := congrArg (fun w : ℝ × ℝ × ℝ => w.2.2) h
    simp only [symF] at h1 h2 h3 ⊢
    simp only [Prod.mk.injEq]
    refine ⟨?_, ?_, ?_⟩
    · linear_combination l ^ k * h1
    · linear_combination l ^ k * h2
    · linear_combination l ^ k * h3

/-- **[P*]** The operator's ratio at distance k boosts the null form by φ^{2k}. -/
theorem ratio_boost (k : ℕ) :
    symF^[k] (1, 2 * φ0, φ0 ^ 2)
      = ((φ0 ^ 2) ^ k * 1, (φ0 ^ 2) ^ k * (2 * φ0), (φ0 ^ 2) ^ k * φ0 ^ 2) :=
  iterate_eigen _ _ null_boost_plus k

/-! ## §L  The regulator measures the chain

  R = log φ is the same invariant at every step: the circumference of the second
  dimension (T = 2πR), the size of the plane over the line (L(1, χ₅) = 2R/√5), the
  information of the projection (S_BH/k_B = λ_log R = log 2), and the rapidity of the
  third dimension's boost (φ² = e^{2R}). -/

/-- **[P*]** -/
theorem regulator_measures_the_chain :
    (F1CW.periodK = 2 * Real.pi * F1CW.regulatorK) ∧
    (∀ L1 : ℝ, L1 = (2 ^ 2 * 1 * F1CW.regulatorK) / (2 * Real.sqrt 5) →
        L1 = 2 * Real.log F1CW.phi / Real.sqrt 5) ∧
    (F1CW.lambdaLog * F1CW.regulatorK = Real.log 2) ∧
    (φ0 ^ 2 = Real.exp (2 * Real.log φ0)) := by
  refine ⟨F1CW.period_eq_two_pi_regulator, F1CW.L1_from_class_number_formula,
    F1CW.lambda_log_mul_regulator, ?_⟩
  have e : (2:ℝ) * Real.log φ0 = Real.log (φ0 ^ 2) := by
    rw [Real.log_pow]; norm_num
  rw [e, Real.exp_log (pow_pos φ0_pos 2)]

/-! ## §M  The zeta values in base φ, from the anchor

  The corpus anchors the L-function at s = 0 and s = 1:  Λ(0) = Λ(1) = 2 log φ and
  L(1, χ₅)·√5 = 2 log φ (`LOneIsTheAnchor`, `anchor_is_a_crossed_identity`).  From
  there every constant of the classical formulas is a function of φ:
     √5 = 2φ − 1,    π = 5·arccos(φ/2),    2 = φ^λ,    ½ = φ^{−λ}.
  So the even values, the values of L at even integers, ζ(0), and — through ζ_K/L at
  the pentagonal points, where |2cos(πa/5)| = φ^{±1} — the odd values, are written in
  base φ.  The mathematical content is the classical one; what changes is the base. -/

/-- **[P*]** √5 = 2φ − 1. -/
theorem sqrt5_in_phi : Real.sqrt 5 = 2 * φ0 - 1 := by unfold φ0; ring

/-- **[P*] The anchor, in base φ.**  2 log φ = log(φ + 1), and from the class-number
    formula L(1,χ₅)·√5 = 2 log φ, L(1,χ₅) = 2 log φ/(2φ − 1). -/
theorem anchor_in_phi (L1 : ℝ) (hCNF : L1 * Real.sqrt 5 = 2 * Real.log φ0) :
    2 * Real.log φ0 = Real.log (φ0 + 1) ∧ L1 = 2 * Real.log φ0 / (2 * φ0 - 1) := by
  refine ⟨?_, ?_⟩
  · rw [← φ0_sq, Real.log_pow]; norm_num
  · have hs : Real.sqrt 5 ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr (by norm_num))
    rw [← sqrt5_in_phi, eq_div_iff hs]; exact hCNF

/-- **[P*]** π = 5 arccos(φ/2) and 2 = φ^λ (the pentagon and the Mersenne anchor). -/
theorem pi_and_two_in_phi :
    5 * Real.arccos (φ0 / 2) = Real.pi ∧ φ0 ^ F1CW.lambdaLog = 2 :=
  ⟨F1CW.pi_eq_five_arccos, F1CW.mersenne_bridge⟩

/-- **[P*] Even zeta in base φ.**  ζ(2k) = (−1)^{k+1} B_{2k} (φ^λ · 5 arccos(φ/2))^{2k} / (2 (2k)!):
    the 2π of Euler's formula is φ^λ · 5 arccos(φ/2). -/
theorem even_zeta_in_phi (k : ℕ) (hk : k ≠ 0) :
    riemannZeta (2 * k) = (-1) ^ (k + 1) * (((φ0 ^ F1CW.lambdaLog : ℝ) : ℂ)) ^ (2 * k - 1)
      * (((5 * Real.arccos (φ0 / 2) : ℝ) : ℂ)) ^ (2 * k)
      * bernoulli (2 * k) / ((2 * k).factorial : ℂ) := by
  have h2 : ((φ0 ^ F1CW.lambdaLog : ℝ) : ℂ) = 2 := by
    rw [pi_and_two_in_phi.2]; norm_num
  have hπ : ((5 * Real.arccos (φ0 / 2) : ℝ) : ℂ) = (Real.pi : ℂ) := by
    rw [pi_and_two_in_phi.1]
  rw [h2, hπ]; exact F1CW.even_zeta_bernoulli hk

/-- **[P*] Even L-values in base φ.**  If L(2k, χ₅) = √5 π^{2k} r with r rational (the
    generalised Bernoulli formula, `even_L_rationality`), then
    L(2k, χ₅) = (2φ − 1)(5 arccos(φ/2))^{2k} r. -/
theorem even_L_in_phi (k : ℕ) (Lv : ℝ) (r : ℚ)
    (hB : Lv = Real.sqrt 5 * Real.pi ^ (2 * k) * (r : ℝ)) :
    Lv = (2 * φ0 - 1) * (5 * Real.arccos (φ0 / 2)) ^ (2 * k) * (r : ℝ) := by
  rw [hB, ← sqrt5_in_phi, pi_and_two_in_phi.1]

/-- **[P*]** The first two: L(2, χ₅) = 4π²/(25√5) = 4 arccos(φ/2)²/(2φ − 1) and
    L(4, χ₅) = 8π⁴/(375√5) = 40 arccos(φ/2)⁴/(3(2φ − 1)). -/
theorem L2_L4_in_phi (Ltwo Lfour : ℝ)
    (h2 : Ltwo = 4 * Real.pi ^ 2 / (25 * Real.sqrt 5))
    (h4 : Lfour = 8 * Real.pi ^ 4 / (375 * Real.sqrt 5)) :
    Ltwo = 4 * Real.arccos (φ0 / 2) ^ 2 / (2 * φ0 - 1) ∧
    Lfour = 40 * Real.arccos (φ0 / 2) ^ 4 / (3 * (2 * φ0 - 1)) := by
  constructor
  · rw [h2, ← pi_and_two_in_phi.1, sqrt5_in_phi]; field_simp; ring
  · rw [h4, ← pi_and_two_in_phi.1, sqrt5_in_phi]; field_simp; ring

/-- **[P*] ζ(0) in base φ.**  ζ(0) = −½ = −φ^{−λ}. -/
theorem zeta_zero_in_phi :
    riemannZeta 0 = -((φ0 ^ (-F1CW.lambdaLog) : ℝ) : ℂ) := by
  have h : φ0 ^ (-F1CW.lambdaLog) = 1 / 2 := F1CW.face_apex
  rw [h, riemannZeta_zero]; norm_num

/-- **[P*] The values in base φ, assembled.**  The anchor at s = 1; ζ(0); every even
    value of ζ; the odd values as ζ_K/L, with the pentagonal points in base φ. -/
theorem zeta_values_in_base_phi (L1 : ℝ) (hCNF : L1 * Real.sqrt 5 = 2 * Real.log φ0) :
    (L1 = 2 * Real.log φ0 / (2 * φ0 - 1)) ∧
    (riemannZeta 0 = -((φ0 ^ (-F1CW.lambdaLog) : ℝ) : ℂ)) ∧
    (∀ k : ℕ, k ≠ 0 → riemannZeta (2 * k) = (-1) ^ (k + 1)
      * (((φ0 ^ F1CW.lambdaLog : ℝ) : ℂ)) ^ (2 * k - 1)
      * (((5 * Real.arccos (φ0 / 2) : ℝ) : ℂ)) ^ (2 * k)
      * bernoulli (2 * k) / ((2 * k).factorial : ℂ)) ∧
    (∀ zK zv Lv : ℝ, zK = zv * Lv → Lv ≠ 0 → zv = zK / Lv) ∧
    (|2 * Real.cos (Real.pi / 5)| = F1CW.phi ∧
      |2 * Real.cos (2 * (Real.pi / 5))| = F1CW.phi⁻¹) :=
  ⟨(anchor_in_phi L1 hCNF).2, zeta_zero_in_phi, even_zeta_in_phi,
   fun zK zv Lv h hL => F1CW.odd_zeta_ratio zK zv Lv h hL,
   ⟨F1CW.norm_cosine_phi.1, F1CW.norm_cosine_phi.2.1⟩⟩

theorem zeta_zero_in_phi_aux : φ0 ^ (-(lamP φ0)) = 1 / 2 := F1CW.face_apex

/-! ## §N  The Hilbert–Pólya operator, read by dimension

  T*(n) = c(n)·πn / log(μn + σ), the operator of the Hilbert–Pólya paper, is identical
  to its rewriting with every parameter a power of φ (`Tstar_rewritten_in_phi`).  With
  π = 5 arccos(φ/2) (the pentagon) it is written in φ alone, and its three factors are
  the three dimensions of the chain of §I:
     radial   φ^{−λ}, φ^{−3λ}   — the tower, the line;
     angular  5 arccos(φ/2)·n   — the circle, the plane;
     ternary  n + 3 inside the logarithm, σ = 3μ   — the three directions, E³. -/

/-- **[P*] The Hilbert–Pólya operator in φ alone.** -/
theorem hp_operator_in_phi_alone (n : ℝ) :
    TstarQ n
      = (2 + (φ0 ^ (-(lamP φ0)) * (3 - 1 / 20)) / (1 + (φ0 ^ (-(lamP φ0))) ^ 3 * Real.log n))
        * ((5 * Real.arccos (φ0 / 2)) * n)
        / Real.log (φ0 ^ (-(lamP φ0)) * (n + 3)) := by
  rw [Tstar_rewritten_in_phi φ0 n one_lt_φ0]
  unfold TstarPhi
  rw [← pi_and_two_in_phi.1]
  have e : φ0 ^ (-(lamP φ0)) * n + 3 * φ0 ^ (-(lamP φ0)) = φ0 ^ (-(lamP φ0)) * (n + 3) := by
    ring
  rw [e]

/-- **[P*] The three dimensions in the operator.**  The radial factor is the apex
    φ^{−λ} = ½ of the tower; the angular factor is π = 5 arccos(φ/2); and the ternary
    d = 3 sits inside the logarithm, μn + σ = φ^{−λ}(n + 3). -/
theorem hp_operator_carries_three_dimensions (n : ℝ) :
    (φ0 ^ (-(lamP φ0)) = 1 / 2) ∧
    (5 * Real.arccos (φ0 / 2) = Real.pi) ∧
    (muQ * n + sigQ = φ0 ^ (-(lamP φ0)) * (n + 3)) :=
  ⟨zeta_zero_in_phi_aux, pi_and_two_in_phi.1, mu_n_plus_sigma_factors φ0 n one_lt_φ0⟩


/-! ## §O  Discharging the hypotheses of corpus lemmas

  Several compiled lemmas of the corpus take, as hypotheses, facts that are provable:
  the cosine values of the crystallographic restriction (`CosineWindow`, the five
  integer traces, the three minimal failures), the cosine values of the pentagonal
  nodes (`PentagonNodes`), and the general form of the diagonal contraction.  This
  section proves those inputs and instantiates the lemmas, so that the statements the
  paper cites hold without hypotheses.  It also proves the logarithmic signature of
  the pentagon in full, of which `F1CW.pentagon_log_signature` is the sine ratio. -/

/-- **[P*]** The diagonal contraction on the whole unit interval: `t² < t` for `0 < t < 1`. -/
theorem sq_lt_self_on_unit_interval (t : ℝ) (h0 : 0 < t) (h1 : t < 1) : t ^ 2 < t := by
  nlinarith

/-- **[P*]** `CosineWindow`, the one analytic input of the crystallographic restriction:
    for `n ≥ 7`, `1/2 < cos(2π/n) < 1`. -/
theorem cosineWindow_holds : CosineWindow := by
  intro n hn
  have hn0 : (0:ℝ) < n := by exact_mod_cast (show 0 < n by omega)
  have h7 : (7:ℝ) ≤ n := by exact_mod_cast hn
  have hpos : 0 < 2 * Real.pi / n := by positivity
  have hlt : 2 * Real.pi / n < Real.pi / 3 := by
    rw [div_lt_div_iff₀ hn0 (by norm_num)]
    nlinarith [mul_pos (show (0:ℝ) < n - 6 by linarith) Real.pi_pos]
  constructor
  · have h := Real.cos_lt_cos_of_nonneg_of_le_pi (le_of_lt hpos)
      (by linarith [Real.pi_pos]) hlt
    rw [Real.cos_pi_div_three] at h
    exact h
  · have h := Real.cos_lt_cos_of_nonneg_of_le_pi (le_refl 0)
      (by linarith [Real.pi_pos]) hpos
    rw [Real.cos_zero] at h
    exact h

/-- **[P*]** The crystallographic restriction, with no hypothesis: for `n ≥ 7` the trace
    `2cos(2π/n)` is not an integer. -/
theorem trZeta_not_integer_unconditional (n : ℕ) (hn : 7 ≤ n) :
    ¬ ∃ m : ℤ, (m : ℝ) = trZeta n :=
  trZeta_not_integer_of_ge_seven cosineWindow_holds n hn

/-- **[P*]** The five integer traces, with no hypothesis. -/
theorem trZeta_crystallographic_unconditional :
    trZeta 1 = 2 ∧ trZeta 2 = -2 ∧ trZeta 3 = -1 ∧ trZeta 4 = 0 ∧ trZeta 6 = 1 := by
  apply trZeta_crystallographic_values
  · simp
  · rw [show 2 * Real.pi / 2 = Real.pi by ring]; exact Real.cos_pi
  · rw [show 2 * Real.pi / 3 = Real.pi - Real.pi / 3 by ring, Real.cos_pi_sub,
      Real.cos_pi_div_three]
  · rw [show 2 * Real.pi / 4 = Real.pi / 2 by ring]; exact Real.cos_pi_div_two
  · rw [show 2 * Real.pi / 6 = Real.pi / 3 by ring]; exact Real.cos_pi_div_three

/-- **[P*]** `cos(2π/5) = 2cos²(π/5) − 1 = (φ − 1)/2`. -/
theorem cos_two_pi_div_five_eq : Real.cos (2 * Real.pi / 5) = (F1CW.phi - 1) / 2 := by
  have hc : Real.cos (2 * Real.pi / 5) = 2 * Real.cos (Real.pi / 5) ^ 2 - 1 := by
    rw [← Real.cos_two_mul]; congr 1; ring
  rw [hc, F1CW.cos_pi_div_five_eq]
  linear_combination (1/2 : ℝ) * F1CW.phi_sq

/-- **[P*]** The three minimal failures, with no hypothesis. -/
theorem three_conductors_unconditional :
    (traceDegree 5 = 2 ∧ traceDegree 8 = 2 ∧ traceDegree 12 = 2)
    ∧ (5 < 8 ∧ 8 < 12)
    ∧ (trZeta 8 = Real.sqrt 2 ∧ trZeta 12 = Real.sqrt 3) := by
  apply three_conductors_are_the_minimal_failure
  · unfold trZeta
    have h := cos_two_pi_div_five_eq
    have e : (2 * Real.pi / ((5:ℕ):ℝ)) = 2 * Real.pi / 5 := by push_cast; ring
    rw [e, h]
    unfold F1CW.phi
    ring
  · unfold trZeta
    rw [show 2 * Real.pi / ((8:ℕ):ℝ) = Real.pi / 4 by push_cast; ring, Real.cos_pi_div_four]
    ring
  · unfold trZeta
    rw [show 2 * Real.pi / ((12:ℕ):ℝ) = Real.pi / 6 by push_cast; ring, Real.cos_pi_div_six]
    ring

/-- **[P*]** `PentagonNodes φ` holds for the golden ratio. -/
theorem pentagonNodes_holds : PentagonNodes F1CW.phi := by
  refine ⟨cos_two_pi_div_five_eq, F1CW.cos_pi_div_five_eq, ?_, F1CW.phi_sq⟩
  rw [show 4 * Real.pi / 5 = Real.pi - Real.pi / 5 by ring, Real.cos_pi_sub,
    F1CW.cos_pi_div_five_eq]
  ring

/-- **[P*]** The pentagonal nodes, with no hypothesis: `2cos(2π/5) = 1/φ`,
    `2cos(π/5) = φ`, `2cos(4π/5) = −φ`, and `2cos(3π/5) = −1/φ`. -/
theorem pentagon_nodes_unconditional :
    2 * Real.cos (2 * Real.pi / 5) = 1 / F1CW.phi ∧
    2 * Real.cos (Real.pi / 5) = F1CW.phi ∧
    2 * Real.cos (4 * Real.pi / 5) = -F1CW.phi ∧
    2 * Real.cos (3 * Real.pi / 5) = -(1 / F1CW.phi) := by
  obtain ⟨h1, h2, h3⟩ := pentagon_nodes_are_golden F1CW.phi pentagonNodes_holds
    (ne_of_gt F1CW.phi_pos)
  refine ⟨h1, h2, h3, ?_⟩
  rw [show 3 * Real.pi / 5 = Real.pi - 2 * Real.pi / 5 by ring, Real.cos_pi_sub]
  linarith [h1]

/-- **[P*]** The logarithmic signature of the pentagon, in full:
    `Σ_{a=1}^{4} χ₅(a) log(2 sin(πa/5)) = −2 log φ`, with χ₅ = (+1, −1, −1, +1). -/
theorem pentagon_log_signature_full :
    Real.log (2 * Real.sin (Real.pi / 5)) - Real.log (2 * Real.sin (2 * Real.pi / 5))
      - Real.log (2 * Real.sin (3 * Real.pi / 5)) + Real.log (2 * Real.sin (4 * Real.pi / 5))
      = -2 * Real.log F1CW.phi := by
  have s1 : 0 < Real.sin (Real.pi / 5) :=
    Real.sin_pos_of_pos_of_lt_pi (by positivity) (by linarith [Real.pi_pos])
  have e3 : Real.sin (3 * Real.pi / 5) = Real.sin (2 * Real.pi / 5) := by
    rw [show 3 * Real.pi / 5 = Real.pi - 2 * Real.pi / 5 by ring, Real.sin_pi_sub]
  have e4 : Real.sin (4 * Real.pi / 5) = Real.sin (Real.pi / 5) := by
    rw [show 4 * Real.pi / 5 = Real.pi - Real.pi / 5 by ring, Real.sin_pi_sub]
  have hr : Real.sin (2 * Real.pi / 5) = F1CW.phi * Real.sin (Real.pi / 5) := by
    have h := F1CW.pentagon_log_signature
    rw [div_eq_iff (ne_of_gt s1)] at h
    rw [show 2 * Real.pi / 5 = 2 * (Real.pi / 5) by ring]
    exact h
  rw [e3, e4, hr]
  have h2a : (2:ℝ) * (F1CW.phi * Real.sin (Real.pi / 5))
      = F1CW.phi * (2 * Real.sin (Real.pi / 5)) := by ring
  rw [h2a, Real.log_mul (ne_of_gt F1CW.phi_pos) (mul_pos two_pos s1).ne']
  ring

end F1v2

