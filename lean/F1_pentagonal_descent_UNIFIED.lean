    **Nada de esto prueba `(I)`.**  La ruta de la brecha sigue
    condicional a la pertenencia, como §85 decía desde el principio. -/
theorem the_balance_of_section_90 (ε : ℝ) (hε : 0 < ε) (k : ℕ) :
    (∃ r : ℝ, r ≠ 1 ∧ |r - 1| < ε ∧ orbitCard r = 4) ∧
    (∀ r : ℝ, 1 / 2 ≤ r → r ≤ 2 → (r - 1 / r) ^ 2 ≤ 36 * (r - 1) ^ 2) ∧
    (((φ : ℝ) - 1 / φ) ^ 2 = 1) ∧
    (((φ : ℝ) ^ 2 - (1 / φ) ^ 2) ^ 2 = 5) ∧
    (5 ∣ 5 * (Nat.fib (2 * k)) ^ 2) :=
  ⟨orbit_card_jumps ε hε, disc_controlled_by_deviation,
   gap_one_is_the_k_one_element.2.1, gap_five_is_the_k_two_element.1,
   invariant_divisible_by_five k⟩

