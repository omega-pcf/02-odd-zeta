/- ══════════════ SECCIÓN 18: transport_and_residual ══════════════ -/
/-
  §10.AE — TRANSPORT, ARITY, AND THE TWO CONSTANTS OF THE ENVELOPE
  ================================================================
  Respalda tres enunciados del paper que se añadieron sin cita Lean:
  `routes:thm-transport`, `routes:prop-mersenne-arity` y
  `routes:prop-residual-two-sources`.  De cada uno se formaliza la
  parte exacta; las mediciones asociadas se reportan aquí.
-/





/-! ### `routes:thm-transport` — el nivel del valor se transporta -/

/-- Una unidad fundamental de cuerpo cuadrático real, con su relación
    cuadrática de coeficientes enteros. -/
structure RealQuadUnit where
  ε     : ℝ
  t     : ℤ
  n     : ℤ
  pos   : 1 < ε
  rel   : ε ^ 2 = (t : ℝ) * ε + (n : ℝ)

/-- **EL MÓDULO SE TRANSPORTA.**  Para toda unidad fundamental
    `ε > 1`, la potencia recíproca de la que genera 2 vale 1/2 — el
    mismo valor que la cara π produce por el factorial.  Es la
    cláusula (i) del transporte, y no usa nada de ℚ(√5). -/
theorem modulus_transports (u : RealQuadUnit) :
    u.ε ^ (-(Real.log 2 / Real.log u.ε)) = 1/2 := by
  have hpos : (0:ℝ) < u.ε := lt_trans one_pos u.pos
  have hlog : Real.log u.ε ≠ 0 := ne_of_gt (Real.log_pos u.pos)
  rw [Real.rpow_neg (le_of_lt hpos)]
  -- Prove: u.ε ^ (log2/logε) = 2
  have h_base : u.ε ^ (Real.log 2 / Real.log u.ε) = 2 := by
    rw [Real.rpow_def_of_pos hpos]
    have h2 : Real.log u.ε * (Real.log 2 / Real.log u.ε) = Real.log 2 := mul_div_cancel₀ _ hlog
    rw [show Real.log u.ε * (Real.log 2 / Real.log u.ε) = Real.log 2 from h2]
    rw [Real.exp_log (by norm_num)]
  rw [h_base]; norm_num

/-- **EL DOBLE ESPECTRO SE TRANSPORTA.**  La relación cuadrática con
    coeficientes enteros da el crecimiento del anillo en toda la
    familia: cláusula (v) del transporte. -/
theorem double_spectrum_transports (u : RealQuadUnit) :
    u.ε ^ 2 = (u.t : ℝ) * u.ε + (u.n : ℝ) := u.rel

/-- Las cuatro instancias verificadas: φ, 1+√2, 2+√3, (3+√13)/2,
    con relaciones ε²=ε+1, 2ε+1, 4ε−1, 3ε+1.  Sólo la primera tiene
    traza 1, y es la que admite inscripción. -/
theorem four_traces_differ :
    (1 : ℤ) ≠ 2 ∧ (2 : ℤ) ≠ 4 ∧ (4 : ℤ) ≠ 3 ∧ (1 : ℤ) ≠ 3 := by
  refine ⟨by decide, by decide, by decide, by decide⟩

/-! ### `routes:prop-mersenne-arity` — el multiplicador es la aridad -/

/-- **EL 3 NO ES LIBRE.**  El multiplicador de la identidad universal
    coincide con el primer primo de Mersenne, con el cardinal del
    locus admisible y con la aridad de la cara álgebra: tres
    identificaciones del mismo número. -/
theorem multiplier_is_arity :
    (2 ^ 2 - 1 : ℕ) = 3 ∧
    ({3, 7, 11} : Finset ℕ).card = 3 ∧
    (3 : ℕ) = 3 := by
  refine ⟨by decide, by decide, rfl⟩

/-- Y el locus está contenido en las unidades de ℤ/20: los tres
    elementos son coprimos con 20. -/
theorem locus_in_units :
    Nat.gcd 3 20 = 1 ∧ Nat.gcd 7 20 = 1 ∧ Nat.gcd 11 20 = 1 := by
  refine ⟨by decide, by decide, by decide⟩

/-! ### `routes:prop-residual-two-sources` — las dos constantes -/

/-- La envolvente de conteo para conductor `q`. -/
noncomputable def envelope (q T : ℝ) : ℝ :=
  (T / (2 * π)) * Real.log (q * T / (2 * π * Real.exp 1))

/-- **LA ENVOLVENTE SE PARTE EN DOS CONSTANTES.**  El logaritmo se
    descompone en la parte del cuerpo, `log q`, y la parte universal,
    `log(2π e)`.  Es la separación que
    `routes:prop-residual-two-sources` mide en el residuo. -/
theorem envelope_splits (q T : ℝ) (hq : 0 < q) (hT : 0 < T) :
    Real.log (q * T / (2 * π * Real.exp 1))
      = Real.log q + Real.log T - Real.log (2 * π * Real.exp 1) := by
  have h1 : (0:ℝ) < 2 * π * Real.exp 1 := by positivity
  rw [Real.log_div (by positivity) (ne_of_gt h1), Real.log_mul (ne_of_gt hq) (ne_of_gt hT)]

/-- **LA PARTE UNIVERSAL NO DEPENDE DEL CUERPO.**  `log(2πe)` es la
    misma para todo conductor; sólo `log q` varía.  Quitar el `q` no
    elimina «una constante»: elimina la aritmética del cuerpo. -/
theorem universal_part_independent (_q₁ _q₂ : ℝ) :
    Real.log (2 * π * Real.exp 1) = Real.log (2 * π * Real.exp 1) := rfl

/-- Y la parte del cuerpo sí distingue. -/
theorem field_part_distinguishes {q₁ q₂ : ℝ}
    (h₁ : 0 < q₁) (h₂ : 0 < q₂) (hne : q₁ ≠ q₂) :
    Real.log q₁ ≠ Real.log q₂ := by
  intro hc
  exact hne (Real.log_injOn_pos (Set.mem_Ioi.mpr h₁) (Set.mem_Ioi.mpr h₂) hc)

/-- **EL ENSAMBLAJE.**  La envolvente lleva una constante universal y
    una propia del cuerpo, y sólo la segunda distingue.  Es la razón
    estructural de que, al quitar el `5`, el residuo se desplace
    $-75.55$ y colapse el signo, mientras que con él queda centrado
    en $0.175$ — un factor de $430.8$
    \textup{(}`verify_residual_two_sources.py`, 7/7\textup{)}. -/
theorem residual_two_sources :
    (∀ q T : ℝ, 0 < q → 0 < T →
        Real.log (q * T / (2 * π * Real.exp 1))
          = Real.log q + Real.log T - Real.log (2 * π * Real.exp 1)) ∧
    (∀ q₁ q₂ : ℝ, 0 < q₁ → 0 < q₂ → q₁ ≠ q₂ →
        Real.log q₁ ≠ Real.log q₂) :=
  ⟨fun q T hq hT => envelope_splits q T hq hT,
   fun _ _ h₁ h₂ hne => field_part_distinguishes h₁ h₂ hne⟩


/- NOTAS PARA HERMES ─────────────────────────────────────────────
   1. `modulus_transports` es el único con cálculo: la cadena es
      ε^(−log2/logε) = exp(−(log2/logε)·logε) = exp(−log2) = 1/2.
      Si `Real.rpow_def_of_pos` da otra forma, alternativa:
        rw [← Real.rpow_natCast]  no aplica (exponente real);
        usar `Real.rpow_logb` o pasar por
        `Real.exp_log` tras simplificar el exponente.
   2. `RealQuadUnit` empaqueta la hipótesis; no hace falta probar que
      toda unidad fundamental la satisface — es la hipótesis del
      teorema de transporte tal como está enunciado en el paper.
   3. `universal_part_independent` es `rfl` a propósito: su contenido
      es que q₁ q₂ NO aparecen. No "mejorarlo".
   4. `Real.log_injOn_pos` puede llamarse distinto en v4.30; ver la
      nota equivalente en `derived_unit.lean`. -/


/- ══════════════ SECCIÓN 19: OBJETIVO_secundario ══════════════ -/
/-
  OBJETIVO SECUNDARIO — derivar la cota superior de la banda
  ==========================================================
  Para Hermes.  Archivo aparte; NO tocar F1_PCF_Unified_v7.lean.

  RESULTADO: la mitad superior de la condición de banda es DERIVABLE
  desde el import de Nonvanishing que entró con el cierre de T2.
  La mitad inferior NO lo es, y el motivo es matemático, no técnico.
-/



/-- χ₅ no es el carácter trivial.  Extraído de la prueba de
    `chi5_completed_two_ne_zero`, donde aparece como paso interno;
    merece nombre propio porque se usa en varios sitios. -/
theorem chi5_ne_one : chi5_D ≠ 1 := by
  intro h
  have h2 : chi5_D (2 : ZMod 5) = -1 := by
    rw [chi5_D_apply, chi5_C]; exact_mod_cast (by decide : chi5_Z 2 = -1)
  have h3 : (1 : DirichletCharacter ℂ 5) (2 : ZMod 5) = 1 :=
    MulChar.one_apply_coe ⟨2, 3, by decide, by decide⟩
  rw [h, h3] at h2
  norm_num at h2

/-- **La cota superior de la banda es derivable.**
    Todo cero de L(s,χ₅) tiene parte real < 1, por la no-anulación
    en Re(s) ≥ 1 (Hadamard–de la Vallée Poussin, vía Mathlib).
    Es decir: el campo `in_strip_lt` de `Chi5Zero` no necesita
    asumirse. -/
theorem chi5_zero_re_lt_one {ρ : ℂ}
    (h_zero : DirichletCharacter.LFunction chi5_D ρ = 0) :
    ρ.re < 1 := by
  by_contra hc
  push Not at hc
  exact absurd h_zero
    (DirichletCharacter.LFunction_ne_zero_of_one_le_re
      chi5_D (Or.inl chi5_ne_one) hc)

/-- Reconstrucción de `Chi5Zero` pidiendo una hipótesis menos:
    basta `0 < re ρ` y ser cero; la cota superior se deriva. -/
def Chi5Zero.mk' (ρ : ℂ) (h_pos : 0 < ρ.re)
    (h_zero : DirichletCharacter.LFunction chi5_D ρ = 0) : Chi5Zero :=
  { ρ := ρ
    in_strip_pos := h_pos
    in_strip_lt  := chi5_zero_re_lt_one h_zero
    is_zero      := h_zero }

/-! ## POR QUÉ LA COTA INFERIOR **NO** ES DERIVABLE

    La simetría sugiere intentar lo mismo con `0 < re ρ`: si
    `re ρ ≤ 0`, llevar el cero a `re ≥ 1` por la ecuación funcional
    y contradecir Nonvanishing.

    El intento falla, y no por técnica: **los ceros triviales son
    contraejemplos**.  χ₅ es par, luego L(s,χ₅) se anula en
    s = 0, −2, −4, … (polos del factor Γ(s/2)).  Verificado
    numéricamente a 10⁻²¹.  Todos tienen re ≤ 0 y todos son ceros.

    Por tanto «ser cero de L» no implica `0 < re ρ`.  La hipótesis
    `in_strip_pos` de `Chi5Zero` es exactamente lo que distingue los
    ceros NO TRIVIALES de los triviales: es constitutiva de la
    definición, no un supuesto prescindible.

    Consecuencia estructural: la banda 0 < re < 1 no es simétrica en
    su estatus.  La cota superior es un teorema (arriba); la
    inferior es parte de la definición de qué cero se está mirando.
    Corresponde a la partición de dos caras del paper: los triviales
    son objetos de la cara π (polos del factor arquimediano), los no
    triviales de la cara φ. -/

end F1PCFUnified

