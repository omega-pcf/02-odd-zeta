theorem borger_to_E (k : Fin 3) (hpos : 0 < (Omega_hat k).re)
    (reZero : ℂ → ℝ) (hemb : SpectralEmbedding reZero) (ρ : ℂ)
    (h0 : 0 < reZero ρ) (h1 : reZero ρ < 1)
    (S : Set ℂ) (hc : ClosedUnderMate S) (σ : ℂ) (hσ : σ ∈ S)
    (m : ℝ) (hm : MinSpacing S m) (p q : ℕ) (a b : ℤ) :
    (X_PCF.psi p (X_PCF.psi q a) = X_PCF.psi (p * q) a) ∧
    ((φ : ℝ) ^ ((p : ℤ) * a) = ((φ : ℝ) ^ a) ^ p) ∧
    (Omega_hat k = ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) : ℝ) * w_pcf ^ (k : ℕ)) ∧
    ((Omega_hat k).re = 1/2) ∧
    (reZero ρ ≤ 1/2) ∧
    ((0:ℝ) < 3/4) ∧
    ((rad₉ σ (1 - σ)).re = 0) ∧
    (σ.re = 1/2) := by
  have hr := minSpacing_forces_the_contraction S hc σ hσ m hm
  exact ⟨X_PCF.psi_comp p q a,
         psi_is_exact_power p a,
         spectrum_is_anchor_times_orbit k,
         operator_spectrum_positivity_forces_half k hpos,
         premiseA_gives_upper_bound reZero hemb ρ h0 h1,
         by norm_num,
         hr,
         (orbit_radius_vanishes_iff_E σ).mp hr⟩

