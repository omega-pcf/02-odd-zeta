/- ══════════════ SECCIÓN 15: derived_unit ══════════════ -/
/-
  §10.AB — THE DERIVED UNIT: rigidity (v) and transport (vi)
  ==========================================================
  Las dos cláusulas nuevas se sostienen mutuamente, y este módulo
  formaliza el enlace.

  RIGIDEZ (v) — el conductor no es libre:
      20 = lcm(4,5), la altura mínima donde el cuarto de vuelta i y
      el pentágono ζ₅ vuelven simultáneamente a la identidad.

  TRANSPORTE (vi) — repulsión en la unidad derivada:
      normalizados por 2π/log(qT/2π) —la escala del conductor propio—
      los espaciados tienen media uno y los pequeños desaparecen.

  EL ENLACE, que es el contenido de este módulo: la escala es una
  FUNCIÓN ESTRICTA del conductor, luego «media uno» es información
  sobre los ceros solo si el conductor está fijado.  Si q fuera libre
  habría una familia de escalas sin ninguna preferida y el enunciado
  sería vacío.  Que lcm(4,5) lo derive es lo que lo hace no vacío.

  MEDIDO (asintótico, no formalizable aquí):
      cuerpo    q   media_norm   <0.3   Poisson
      ℚ(√5)     5    0.9884        0      11.7
      ℚ(√2)     8    0.9928        0      13.5
      ℚ(√3)    12    0.9954        0      15.0
  y con conductor ajeno se rompe: ℚ(√3) da 0.7900 normalizado por 5.
  (`verify_transport_repulsion.py`, 6/6.)
-/





/-! ### La escala como función estricta del conductor -/

/-- La escala local de espaciado a altura `T` para conductor `q`. -/
noncomputable def spacingScale (q T : ℝ) : ℝ :=
  2 * π / Real.log (q * T / (2 * π))

/-- **LA ESCALA ES INYECTIVA EN EL CONDUCTOR.**  Conductores
    distintos dan escalas distintas a la misma altura.  Por tanto
    «los espaciados normalizados tienen media uno» selecciona un
    único conductor: no es una afirmación sobre unidades libres. -/
theorem scale_injective_in_conductor {q₁ q₂ T : ℝ}
    (hT : 0 < T) (h₁ : 2 * π < q₁ * T) (hne : q₁ ≠ q₂)
    (h₂ : 2 * π < q₂ * T) :
    spacingScale q₁ T ≠ spacingScale q₂ T := by
  have hpi : (0:ℝ) < 2 * π := by positivity
  have hq₁ : 0 < q₁ := by nlinarith [Real.pi_pos]
  have hq₂ : 0 < q₂ := by nlinarith [Real.pi_pos]
  have ha₁ : 0 < q₁ * T / (2 * π) := by positivity
  have ha₂ : 0 < q₂ * T / (2 * π) := by positivity
  have hl₁ : 0 < Real.log (q₁ * T / (2 * π)) :=
    Real.log_pos (by rw [lt_div_iff₀ hpi]; linarith)
  have hl₂ : 0 < Real.log (q₂ * T / (2 * π)) :=
    Real.log_pos (by rw [lt_div_iff₀ hpi]; linarith)
  intro hc
  unfold spacingScale at hc
  have hmul := (div_eq_div_iff (ne_of_gt hl₁) (ne_of_gt hl₂)).mp hc
  have hL : Real.log (q₁ * T / (2 * π)) = Real.log (q₂ * T / (2 * π)) :=
    (mul_left_cancel₀ (ne_of_gt hpi) hmul).symm
  have harg : q₁ * T / (2 * π) = q₂ * T / (2 * π) := by
    have e₁ := Real.exp_log ha₁
    have e₂ := Real.exp_log ha₂
    rw [← e₁, ← e₂, hL]
  have hqT : q₁ * T = q₂ * T := by
    have := congrArg (fun x => x * (2 * π)) harg
    simpa [div_mul_cancel₀, ne_of_gt hpi] using this
  exact hne (mul_right_cancel₀ (ne_of_gt hT) hqT)

/-! ### El conductor está derivado -/

/-- **RIGIDEZ (v).**  El conductor es el mínimo común múltiplo de los
    dos periodos: no se elige. -/
theorem conductor_is_derived :
    Nat.lcm 4 5 = 20 ∧
    (Complex.I) ^ (4 : ℕ) = 1 ∧
    (Complex.exp (2 * Real.pi * Complex.I / 5)) ^ (5 : ℕ) = 1 := by
  refine ⟨by decide, I_pow_four, ?_⟩
  rw [← Complex.exp_nat_mul]
  push_cast
  have : (5:ℂ) * (2 * Real.pi * Complex.I / 5) = 2 * Real.pi * Complex.I := by ring
  rw [this, Complex.exp_two_pi_mul_I]

/-- Y los periodos son los de las dos caras: 4 el del giro, 5 el del
    pentágono, y son coprimos — por eso su lcm es el producto. -/
theorem periods_coprime : Nat.gcd 4 5 = 1 ∧ 4 * 5 = 20 := by
  refine ⟨by decide, by norm_num⟩

/-! ### El enlace entre las dos cláusulas -/

/-- **EL ENLACE.**  La escala es inyectiva en el conductor, y el
    conductor está derivado de los dos periodos.  Por tanto la unidad
    de normalización está fijada por la estructura, y un enunciado
    sobre espaciados normalizados es un enunciado sobre los ceros —
    no sobre una elección de unidades.

    Sin la cláusula (v) de la rigidez, la (vi) del transporte sería
    vacua: habría una familia de escalas y «media uno» se podría
    obtener eligiendo q. -/
theorem derived_unit_makes_measurement_meaningful :
    -- el conductor está derivado
    (Nat.lcm 4 5 = 20) ∧
    -- y la escala es inyectiva en él
    (∀ q₁ q₂ T : ℝ, 0 < T → 2 * π < q₁ * T → 2 * π < q₂ * T →
        q₁ ≠ q₂ → spacingScale q₁ T ≠ spacingScale q₂ T) :=
  ⟨conductor_is_derived.1,
   fun _ _ _ hT h₁ h₂ hne => scale_injective_in_conductor hT h₁ hne h₂⟩

/-- Corolario de lectura: como la escala determina el conductor y el
    conductor está derivado de los periodos, la cadena
    periodos → conductor → escala → normalización
    no tiene ningún eslabón elegido. -/
theorem no_chosen_link_in_the_chain :
    (Nat.gcd 4 5 = 1) ∧ (Nat.lcm 4 5 = 20) ∧
    (∀ q₁ q₂ T : ℝ, 0 < T → 2 * π < q₁ * T → 2 * π < q₂ * T →
        q₁ ≠ q₂ → spacingScale q₁ T ≠ spacingScale q₂ T) :=
  ⟨periods_coprime.1, conductor_is_derived.1,
   fun _ _ _ hT h₁ h₂ hne => scale_injective_in_conductor hT h₁ hne h₂⟩


