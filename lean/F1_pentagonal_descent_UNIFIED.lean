theorem spectral_values_are_separated (a b : ℝ)
    (ha : a = 1/2 ∨ a = -(1/4)) (hb : b = 1/2 ∨ b = -(1/4)) (hne : a ≠ b) :
    (3:ℝ)/4 ≤ |a - b| := by
  rcases ha with ha | ha <;> rcases hb with hb | hb <;> subst ha <;> subst hb
  · exact absurd rfl hne
  · refine le_abs.mpr (Or.inl ?_); norm_num
  · refine le_abs.mpr (Or.inr ?_); norm_num
  · exact absurd rfl hne

