  constructor
  · intro h; linarith
  · intro h; linarith

/-- **[P] Y LAS DOS SON LA MISMA PATA, EN `ℝ` Y EN `ℂ`.** -/
theorem legs_five_and_six_agree (s : ℂ) (x : ℝ) :
