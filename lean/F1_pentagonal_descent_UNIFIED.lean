/-! ## §92.1  El par de Galois lleva los cuatro discriminantes -/

/-- **[P] LAS DOS FUNCIONES SIMÉTRICAS DEL PAR DE GALOIS.**
    `e₁ = 1`, `e₂ = −1`: el polinomio es `x² − x − 1`, que ES
    `φ² = φ + 1`.  Restatement de `galois_pair_symmetric` (§44). -/
theorem galois_symmetric_functions :
    sym₁ (φ : ℝ) (1 - φ) = 1 ∧ sym₂ (φ : ℝ) (1 - φ) = -1 := by
  constructor
  · unfold sym₁; ring
  · unfold sym₂; have h := phi_sq; nlinarith [h]

/-- **[P] LOS CUATRO DISCRIMINANTES, CON SIGNO, EN UN SOLO PAR.**

        e₁²        =   1  = disc ℚ            trivial
        4e₂        =  −4  = disc ℚ(i)         χ₄
        disc       =   5  = disc ℚ(√5)        χ₅
        4e₂·disc   = −20  = disc ℚ(√−5)       χ₄χ₅

    Los cuatro caracteres de `G` están en el origen, no repartidos
    por la cadena. -/
theorem galois_pair_four_discriminants :
    (sym₁ (φ : ℝ) (1 - φ)) ^ 2 = 1 ∧
    4 * (sym₂ (φ : ℝ) (1 - φ)) = -4 ∧
    discr (φ : ℝ) (1 - φ) = 5 ∧
    (4 * (sym₂ (φ : ℝ) (1 - φ))) * (discr (φ : ℝ) (1 - φ)) = -20 := by
  obtain ⟨h1, h2⟩ := galois_symmetric_functions
  have hd : discr (φ : ℝ) (1 - φ) = 5 := by
    unfold discr; rw [h1, h2]; norm_num
  refine ⟨by rw [h1]; norm_num, by rw [h2]; norm_num, hd, ?_⟩
  rw [h2, hd]; norm_num

/-- **[P] Y LA RELACIÓN CONDUCTOR--DISCRIMINANTE.**
    `disc(χ₄χ₅) = disc(χ₄)·disc(χ₅)`, con signo; y en módulo,
    `|−4|·|5| = 20`, el conductor. -/
theorem conductor_discriminant_composite :
    ((-4 : ℤ) * 5 = -20) ∧ (Int.natAbs (-4) * Int.natAbs 5 = 20) := by
  refine ⟨by decide, by decide⟩

/-! ## §92.2  Ningún par recíproco puede llevar el discriminante de ℚ(i) -/

/-- **[P] TODO PAR RECÍPROCO DA `4e₂ = +4`.**  Nunca `−4`. -/
theorem reciprocal_pairs_give_plus_four (a : ℝ) (ha : a ≠ 0) :
    4 * (sym₂ a (1 / a)) = 4 := by
  unfold sym₂; field_simp

/-- **[P] LUEGO NINGUNO LLEVA `disc ℚ(i)`.**  El par de la decoración
    y el de los ceros son recíprocos: el discriminante gaussiano no
    aparece en ellos con su signo.

    **Ésta es la razón (a) de E105.** -/
theorem reciprocal_never_carries_chi_four (a : ℝ) (ha : a ≠ 0) :
    4 * (sym₂ a (1 / a)) ≠ -4 := by
  rw [reciprocal_pairs_give_plus_four a ha]; norm_num

/-! ## §92.3  El `5` cambia de hueco: la razón (b) -/

/-- **[P] EL `5` ESTÁ EN `disc` EN GALOIS Y EN `e₁²` EN LA DECORACIÓN.**
    Es el intercambio de `sign_flip_swaps` (§87), aquí en su instancia
    concreta.

    Escoger de qué hueco tomar el `5` es lo que fabricaba la
    coincidencia `4·5 = 20`. -/
theorem the_five_changes_slot :
    ((sym₁ (φ : ℝ) (1 - φ)) ^ 2 = 1 ∧ discr (φ : ℝ) (1 - φ) = 5) ∧
    ((sym₁ (φ : ℝ) (1 / φ)) ^ 2 = 5 ∧ discr (φ : ℝ) (1 / φ) = 1) := by
  obtain ⟨_, _, hd, _⟩ := galois_pair_four_discriminants
  obtain ⟨h1, _⟩ := galois_symmetric_functions
  refine ⟨⟨by rw [h1]; norm_num, hd⟩, ?_, ?_⟩
  · unfold sym₁
    rw [decoration_pair_symmetric.2.1]
    exact Real.sq_sqrt (by norm_num)
  · unfold discr sym₁ sym₂
    exact decoration_pair_symmetric.2.2

/-- **[P] Y EN `E` ESE HUECO TIENE `4`, NO `5`.**  Por eso el
    «compuesto» salía `0`: `4e₂·disc = 4·0 = 0`.

    **No era ruptura del conductor: era el hueco equivocado.** -/
theorem at_E_the_slot_holds_four :
    (sym₁ (1 : ℝ) 1) ^ 2 = 4 ∧
    discr (1 : ℝ) 1 = 0 ∧
    (4 * (sym₂ (1 : ℝ) 1)) * (discr (1 : ℝ) 1) = 0 := by
  unfold discr sym₂
  refine ⟨by norm_num [sym₁], by norm_num [sym₁], by norm_num [sym₁]⟩

/-! ## §92.4  El balance -/

