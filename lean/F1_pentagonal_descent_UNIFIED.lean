section PasosDelTextoBlock

/-
PasosDelTexto.lean — Sprint 112. Pasos que el artículo daba como probados en el texto (nivel T).
-/

namespace PasosDelTexto

/-! ## Lo que la clase fija de la parte angular -/

/-- Si `d ∣ 2m` y `d ∤ m`, entonces `2m = d k` con `k` impar: `d` y `2m` tienen la misma parte 2-ádica. -/
theorem two_part_of_dvd_not_dvd (d m : ℕ) (h2 : d ∣ 2 * m) (h1 : ¬ d ∣ m) :
    ∃ k, 2 * m = d * k ∧ ¬ 2 ∣ k := by
  obtain ⟨k, hk⟩ := h2
  refine ⟨k, hk, ?_⟩
  rintro ⟨j, rfl⟩
  exact h1 ⟨j, by linarith⟩

/-- En un primo inerte la conjugación es el Frobenius: de `φ² = φ + 1` y `φ^p = 1 - φ` sale `φ^(p+1) = -1`. -/
theorem inert_pow_succ {R : Type*} [CommRing R] (φ : R) (p : ℕ) (h2 : φ ^ 2 = φ + 1) (hp : φ ^ p = 1 - φ) :
    φ ^ (p + 1) = -1 := by
  rw [pow_succ, hp]; linear_combination (-1 : R) * h2

/-- (i) En un primo inerte, el orden de `φ` tiene la parte 2-ádica de `2(p+1)`. -/
theorem inert_two_part {F : Type*} [Field F] (u : Fˣ) (m : ℕ)
    (hneg : (-1 : F) ≠ 1) (h : ((u : F)) ^ m = -1) :
    ∃ k, 2 * m = orderOf u * k ∧ ¬ 2 ∣ k := by
  apply two_part_of_dvd_not_dvd
  · apply orderOf_dvd_of_pow_eq_one
    ext; push_cast; rw [pow_mul', h]; norm_num
  · intro hd
    have : u ^ m = 1 := orderOf_dvd_iff_pow_eq_one.mp hd
    have h' : ((u : F)) ^ m = 1 := by
      have := congrArg (fun z : Fˣ => (z : F)) this; simpa using this
    exact hneg (h ▸ h')

/-- En las clases 13 y 17, `p ≡ 1 (mód 4)`: la parte 2-ádica de `2(p+1)` es `4`. -/
theorem two_part_inert_one_mod_four (p : ℕ) (hp : p % 4 = 1) :
    4 ∣ 2 * (p + 1) ∧ ¬ 8 ∣ 2 * (p + 1) := by
  omega

/-- (ii) En un primo escindido `p ≡ 3 (mód 4)`, con las dos raíces `x` y `y = 1 - x` de `X² - X - 1`
(producto `-1`), el mínimo común múltiplo de sus órdenes tiene valuación 2-ádica `1`. -/
theorem split_three_mod_four {F : Type*} [Field F] [Fintype F] [DecidableEq F] (x y : Fˣ)
    (hxy : (x : F) * y = -1) (hneg : (-1 : F) ≠ 1) (hcard : Fintype.card F % 4 = 3) :
    2 ∣ Nat.lcm (orderOf x) (orderOf y) ∧ ¬ 4 ∣ Nat.lcm (orderOf x) (orderOf y) := by
  have hc : Fintype.card Fˣ = Fintype.card F - 1 := Fintype.card_units F
  constructor
  · by_contra hodd
    have hx : ¬ 2 ∣ orderOf x := fun h => hodd (h.trans (Nat.dvd_lcm_left _ _))
    have hy : ¬ 2 ∣ orderOf y := fun h => hodd (h.trans (Nat.dvd_lcm_right _ _))
    set n := orderOf x * orderOf y
    have hn : ¬ 2 ∣ n := by
      intro h; rcases (Nat.Prime.dvd_mul Nat.prime_two).mp h with h | h
      · exact hx h
      · exact hy h
    have h1 : (x * y) ^ n = 1 := by
      rw [mul_pow, show n = orderOf x * orderOf y from rfl, pow_mul, pow_orderOf_eq_one, one_pow,
        mul_comm (orderOf x), pow_mul, pow_orderOf_eq_one, one_pow, one_mul]
    have h2 : ((x : F) * y) ^ n = 1 := by
      have := congrArg (fun z : Fˣ => (z : F)) h1; simpa using this
    rw [hxy, Odd.neg_one_pow (Nat.odd_iff.mpr (by omega))] at h2
    exact hneg h2
  · intro h4
    have hl : Nat.lcm (orderOf x) (orderOf y) ∣ Fintype.card Fˣ :=
      Nat.lcm_dvd (orderOf_dvd_card) (orderOf_dvd_card)
    rw [hc] at hl
    have := h4.trans hl
    omega

/-! ## Las fibras por nivel: la norma en los niveles impares y sus dobles -/

/-- Para `P` palindrómico de grado par `d` (`y^d P(1/y) = P(y)`) y `α β = -1`:
`P(α) P(β) = P(-α) P(-β)`.  Con `P = Φ_m`, `m ≥ 3` impar, y `Φ_{2m}(x) = Φ_m(-x)`, da
`|N(Φ_m(φ))| = |N(Φ_{2m}(φ))|`. -/
theorem palindromic_norm {F : Type*} [Field F] (P : F → F) (d : ℕ) (hd : Even d)
    (hP : ∀ y : F, y ≠ 0 → y ^ d * P y⁻¹ = P y) (α β : F) (hαβ : α * β = -1) :
    P α * P β = P (-α) * P (-β) := by
  have hα : α ≠ 0 := by rintro rfl; simp at hαβ
  have hβ : β = (-α)⁻¹ := by
    rw [inv_neg]; field_simp; linear_combination hαβ
  have hβ' : -β = α⁻¹ := by rw [hβ, inv_neg, neg_neg]
  have h1 : α ^ d * P β = P (-α) := by
    rw [hβ, ← hd.neg_pow]; exact hP (-α) (neg_ne_zero.mpr hα)
  have h2 : α ^ d * P (-β) = P α := by rw [hβ']; exact hP α hα
  apply mul_left_cancel₀ (pow_ne_zero d hα)
  linear_combination P α * h1 - P (-α) * h2

/-- Con `Φ_{2m}(x) = Φ_m(-x)`: la norma de `Φ_{2m}` en `α`, `β` es la de `Φ_m`. -/
theorem norm_odd_level_doubled {F : Type*} [Field F] (Φm Φ2m : F → F) (d : ℕ) (hd : Even d)
    (hP : ∀ y : F, y ≠ 0 → y ^ d * Φm y⁻¹ = Φm y) (hdbl : ∀ x, Φ2m x = Φm (-x))
    (α β : F) (hαβ : α * β = -1) :
    Φm α * Φm β = Φ2m α * Φ2m β := by
  rw [hdbl, hdbl]; exact palindromic_norm Φm d hd hP α β hαβ

/-! ## El número de oro nombra las raíces quintas de la unidad -/

/-- (i) Si `z^5 = 1` y `z ≠ 1`, `w = z + z⁻¹` es raíz de `X² + X - 1`. -/
theorem fifth_root_trace {F : Type*} [Field F] (z : F) (h5 : z ^ 5 = 1) (h1 : z ≠ 1) :
    (z + z⁻¹) ^ 2 + (z + z⁻¹) - 1 = 0 := by
  have hz : z ≠ 0 := by rintro rfl; norm_num at h5
  have hsum : z ^ 4 + z ^ 3 + z ^ 2 + z + 1 = 0 := by
    have : (z - 1) * (z ^ 4 + z ^ 3 + z ^ 2 + z + 1) = 0 := by linear_combination h5
    rcases mul_eq_zero.mp this with h | h
    · exact absurd (sub_eq_zero.mp h) h1
    · exact h
  field_simp
  linear_combination hsum

/-- (i) Si `z + z⁻¹ = r - 1` con `r² = r + 1`, entonces `z² + z⁻² = -r`. -/
theorem second_trace {F : Type*} [Field F] (z r : F) (hz : z ≠ 0) (hr : r ^ 2 = r + 1)
    (hw : z + z⁻¹ = r - 1) : z ^ 2 + z⁻¹ ^ 2 = -r := by
  have : z ^ 2 + z⁻¹ ^ 2 = (z + z⁻¹) ^ 2 - 2 := by field_simp; ring
  rw [this, hw]; linear_combination hr

/-- (i) La traza fija el par: si `z + z⁻¹ = z' + z'⁻¹`, entonces `z' = z` o `z' = z⁻¹`. -/
theorem pair_from_trace {F : Type*} [Field F] (z z' : F) (hz : z ≠ 0) (hz' : z' ≠ 0)
    (h : z + z⁻¹ = z' + z'⁻¹) : z' = z ∨ z' = z⁻¹ := by
  have : (z' - z) * (z' - z⁻¹) = 0 := by
    have e : (z' - z) * (z' - z⁻¹) = z' * ((z' + z'⁻¹) - (z + z⁻¹)) := by field_simp; ring
    rw [e, h, sub_self, mul_zero]
  rcases mul_eq_zero.mp this with h | h
  · exact Or.inl (sub_eq_zero.mp h)
  · exact Or.inr (sub_eq_zero.mp h)

/-- (iii) La conjugación `r ↦ 1 - r` lleva `r - 1` a `-r`: intercambia las dos clases `{ζ^{±1}}`, `{ζ^{±2}}`. -/
theorem conjugation_swaps {R : Type*} [CommRing R] (r : R) : (1 - r) - 1 = -r := by ring

/-! ## El índice en el n-gono: la hipérbola -/

/-- (ii) Si `e_p i_p = N_p ≤ 2(p+1)`, `p ≤ X` e `i_p > j`, entonces `e_p j < 2(X+1)`. -/
theorem hyperbola (e i N p X j : ℕ) (he : 0 < e) (hN : e * i = N) (hNp : N ≤ 2 * (p + 1))
    (hpX : p ≤ X) (hij : j < i) : e * j < 2 * (X + 1) := by
  have : e * j < e * i := Nat.mul_lt_mul_of_pos_left hij he
  omega

/-- (ii) Con `j = X^{3/4}` (escribiendo `X = s⁴`, `s ≥ 1`), el reloj queda acotado por `y = 2(X+1)/j ≤ 4s`, y la
cota de (i), `y(y+3)/2`, es a lo más `14 s² = 14 √X`. -/
theorem hyperbola_sqrt (s : ℝ) (hs : 1 ≤ s) :
    2 * (s ^ 4 + 1) / s ^ 3 ≤ 4 * s ∧
    (2 * (s ^ 4 + 1) / s ^ 3) * (2 * (s ^ 4 + 1) / s ^ 3 + 3) / 2 ≤ 14 * s ^ 2 := by
  have hs0 : 0 < s := by linarith
  have hs3 : 0 < s ^ 3 := by positivity
  have hy : 2 * (s ^ 4 + 1) / s ^ 3 ≤ 4 * s := by
    rw [div_le_iff₀ hs3]; nlinarith [pow_le_pow_left₀ (by norm_num) hs 4]
  have hy0 : 0 ≤ 2 * (s ^ 4 + 1) / s ^ 3 := by positivity
  refine ⟨hy, ?_⟩
  have : (2 * (s ^ 4 + 1) / s ^ 3) * (2 * (s ^ 4 + 1) / s ^ 3 + 3) ≤ (4 * s) * (4 * s + 3) :=
    mul_le_mul hy (by linarith) (by linarith) (by linarith)
  nlinarith

/-! ## La ventana y el reloj -/

/-- Un ideal sobre un primo escindido tiene norma `p = n i + 1`; si `p ≤ X`, `n i ≤ 2(X+1)`. -/
theorem window_split (n i p X : ℕ) (hp : p = n * i + 1) (hX : p ≤ X) : n * i ≤ 2 * (X + 1) := by
  omega

/-- Un ideal sobre un primo inerte tiene norma `p²` con `n i = 2(p+1)`; si `p² ≤ X`, `n i ≤ 2(X+1)`. -/
theorem window_inert (n i p X : ℕ) (hp : n * i = 2 * (p + 1)) (hX : p ^ 2 ≤ X) :
    n * i ≤ 2 * (X + 1) := by
  have : p ≤ p ^ 2 := by nlinarith
  omega

/-! ## La naturaleza aritmética de L(s, χ₅): el factor algebraico -/

/-- Multiplicar por un algebraico no nulo no cambia ser algebraico (sobre `ℚ`, en un cuerpo de
característica cero como `ℂ`). -/
theorem algebraic_scale {K : Type*} [Field K] [CharZero K] (c x : K) (hc : IsAlgebraic ℚ c) (hc0 : c ≠ 0) :
    IsAlgebraic ℚ x ↔ IsAlgebraic ℚ (c * x) := by
  constructor
  · intro hx; exact IsAlgebraic.mul hc hx
  · intro h
    have : x = c⁻¹ * (c * x) := by field_simp
    rw [this]; exact IsAlgebraic.mul (IsAlgebraic.inv_iff.mpr hc) h

/-! ## Los caracteres de las clases módulo 20 -/

/-- Todo elemento de `(ℤ/20)ˣ` es `3^a 11^b`. -/
theorem units_twenty_gen : ∀ u : (ZMod 20)ˣ, ∃ a : Fin 4, ∃ b : Fin 2,
    u = (ZMod.unitOfCoprime 3 (by decide)) ^ (a : ℕ) * (ZMod.unitOfCoprime 11 (by decide)) ^ (b : ℕ) := by
  decide

/-- Un carácter de `(ℤ/20)ˣ` de orden que no divide a `2` vale `-1` en `9`; los que valen `1` en `9`
(los que factorizan por `G`, cuyo núcleo es `{1, 9}`) son los cuadráticos. -/
theorem character_at_nine (χ : (ZMod 20)ˣ →* ℂˣ) :
    (χ (ZMod.unitOfCoprime 9 (by decide)) = 1 ↔ ∀ u, χ u ^ 2 = 1) ∧
    ((χ (ZMod.unitOfCoprime 9 (by decide)) : ℂ) = 1 ∨ (χ (ZMod.unitOfCoprime 9 (by decide)) : ℂ) = -1) := by
  set g3 := ZMod.unitOfCoprime 3 (by decide : Nat.Coprime 3 20)
  set g11 := ZMod.unitOfCoprime 11 (by decide : Nat.Coprime 11 20)
  have h9 : ZMod.unitOfCoprime 9 (by decide : Nat.Coprime 9 20) = g3 ^ 2 := by decide
  have h11 : g11 ^ 2 = 1 := by decide
  have h81 : (ZMod.unitOfCoprime 9 (by decide : Nat.Coprime 9 20)) ^ 2 = 1 := by decide
  have c11 : χ g11 ^ 2 = 1 := by rw [← map_pow, h11, map_one]
  have c9 : χ (ZMod.unitOfCoprime 9 (by decide)) ^ 2 = 1 := by rw [← map_pow, h81, map_one]
  refine ⟨⟨fun h u => ?_, fun h => ?_⟩, ?_⟩
  · obtain ⟨a, b, rfl⟩ := units_twenty_gen u
    rw [map_mul, map_pow, map_pow, mul_pow, ← pow_mul, ← pow_mul, mul_comm (a : ℕ), mul_comm (b : ℕ),
      pow_mul, pow_mul]
    have : χ g3 ^ 2 = 1 := by rw [← map_pow, ← h9]; exact h
    rw [this, c11, one_pow, one_pow, one_mul]
  · rw [h9, map_pow]; exact h g3
  · have : ((χ (ZMod.unitOfCoprime 9 (by decide)) : ℂ)) ^ 2 = 1 := by
      have := congrArg (fun z : ℂˣ => (z : ℂ)) c9; simpa using this
    exact sq_eq_one_iff.mp this

/-! ## Las trazas en `5^k`: las identidades de Fibonacci -/

open Matrix in
/-- La matriz de Fibonacci sobre `ℤ`. -/
def Mz : Matrix (Fin 2) (Fin 2) ℤ := !![0, 1; 1, 1]

/-- Cassini, en la forma `F_{n+1}² - F_{n+1} F_n - F_n² = (-1)^n`. -/
theorem cassini' (n : ℕ) :
    (Nat.fib (n + 1) : ℤ) ^ 2 - Nat.fib (n + 1) * Nat.fib n - (Nat.fib n : ℤ) ^ 2 = (-1) ^ n := by
  induction n with
  | zero => simp
  | succ k ih =>
    have h : (Nat.fib (k + 2) : ℤ) = Nat.fib k + Nat.fib (k + 1) := by
      rw [Nat.fib_add_two]; push_cast; ring
    rw [show k + 1 + 1 = k + 2 from rfl, h, pow_succ]
    linear_combination (-1 : ℤ) * ih

open Matrix in
/-- `M^n = (F_{n+1} - F_n, F_n; F_n, F_{n+1})`. -/
theorem Mz_pow (n : ℕ) :
    Mz ^ n = !![(Nat.fib (n + 1) : ℤ) - Nat.fib n, (Nat.fib n : ℤ); (Nat.fib n : ℤ), (Nat.fib (n + 1) : ℤ)] := by
  induction n with
  | zero => ext i j; fin_cases i <;> fin_cases j <;> simp
  | succ k ih =>
    rw [pow_succ, ih]
    have h : (Nat.fib (k + 2) : ℤ) = Nat.fib k + Nat.fib (k + 1) := by
      rw [Nat.fib_add_two]; push_cast; ring
    ext i j
    fin_cases i <;> fin_cases j <;> simp [Mz, Matrix.mul_apply, Fin.sum_univ_two, h] <;> ring

open Matrix in
/-- La traza de `M^{2n}` en términos de `a = F_n`, `b = F_{n+1}`. -/
theorem trace_Mz_two_mul (n : ℕ) :
    (Mz ^ (2 * n)).trace = 3 * (Nat.fib n : ℤ) ^ 2 - 2 * Nat.fib n * Nat.fib (n + 1) + 2 * (Nat.fib (n + 1) : ℤ) ^ 2 := by
  rw [pow_mul', Mz_pow]
  simp [Matrix.trace, Fin.sum_univ_two, sq, Matrix.mul_apply]
  ring

/-- Con `t = tr M^{2n}` y `L_n = F_{n-1} + F_{n+1} = 2F_{n+1} - F_n`: `t - 2 = L_n²` si `n` es impar. -/
theorem trace_sub_two_odd (n : ℕ) (hn : Odd n) :
    (Mz ^ (2 * n)).trace - 2 = (2 * (Nat.fib (n + 1) : ℤ) - Nat.fib n) ^ 2 := by
  rw [trace_Mz_two_mul]
  have hc := cassini' n
  rw [hn.neg_one_pow] at hc
  linear_combination (-2 : ℤ) * hc

/-- `t - 2 = 5 F_n²` si `n` es par. -/
theorem trace_sub_two_even (n : ℕ) (hn : Even n) :
    (Mz ^ (2 * n)).trace - 2 = 5 * (Nat.fib n : ℤ) ^ 2 := by
  rw [trace_Mz_two_mul]
  have hc := cassini' n
  rw [hn.neg_one_pow] at hc
  linear_combination (2 : ℤ) * hc

open Matrix in
/-- `F_{5n} = 5 F_n (5 F_n⁴ + 5 (-1)^n F_n² + 1)`; en particular `F_{5n} / (5 F_n) ≡ 1 (mód 5)`. -/
theorem fib_five_mul (n : ℕ) :
    (Nat.fib (5 * n) : ℤ) = 5 * Nat.fib n * (5 * (Nat.fib n : ℤ) ^ 4 + 5 * (-1) ^ n * (Nat.fib n : ℤ) ^ 2 + 1) := by
  have h1 : (Mz ^ (5 * n)) 0 1 = Nat.fib (5 * n) := by rw [Mz_pow]; simp
  have h2 : Mz ^ (5 * n) = (Mz ^ n) ^ 5 := by rw [pow_mul']
  rw [← h1, h2, Mz_pow]
  set a : ℤ := (Nat.fib n : ℤ)
  set b : ℤ := (Nat.fib (n + 1) : ℤ)
  have hc : b ^ 2 - b * a - a ^ 2 = (-1) ^ n := cassini' n
  have he : ((-1 : ℤ) ^ n) ^ 2 = 1 := by rw [← pow_mul, mul_comm, pow_mul]; simp
  simp [pow_succ, Matrix.mul_apply, Fin.sum_univ_two]
  linear_combination (20 * a ^ 3 - 5 * a ^ 2 * b + 5 * a * b ^ 2 + 5 * a * (-1) ^ n) * hc + 5 * a * he

/-- `F_{4m} ≡ 3m` y `F_{4m+1} ≡ 1 - m (mód 5)`. -/
theorem fib_four_mul_mod_five (m : ℕ) :
    ((Nat.fib (4 * m) : ZMod 5) = 3 * m) ∧ ((Nat.fib (4 * m + 1) : ZMod 5) = 1 - m) := by
  induction m with
  | zero => simp
  | succ k ih =>
    obtain ⟨h0, h1⟩ := ih
    have e4 : ∀ n, (Nat.fib (n + 4) : ZMod 5) = 3 * Nat.fib (n + 1) + 2 * Nat.fib n := by
      intro n
      have a2 := Nat.fib_add_two (n := n); have a3 := Nat.fib_add_two (n := n + 1)
      have a4 := Nat.fib_add_two (n := n + 2)
      rw [show n + 4 = n + 2 + 2 from rfl, a4, show n + 2 + 1 = n + 1 + 2 from rfl, a3, a2]
      push_cast; ring
    have e5 : ∀ n, (Nat.fib (n + 5) : ZMod 5) = 5 * Nat.fib (n + 1) + 3 * Nat.fib n := by
      intro n
      rw [show n + 5 = (n + 1) + 4 from rfl, e4 (n + 1), show n + 1 + 1 = n + 2 from rfl, Nat.fib_add_two]
      push_cast; ring
    refine ⟨?_, ?_⟩
    · rw [show 4 * (k + 1) = 4 * k + 4 from by ring, e4, h1, h0]; push_cast; ring
    · rw [show 4 * (k + 1) + 1 = 4 * k + 5 from by ring, e5, h1, h0]
      push_cast
      have : (5 : ZMod 5) = 0 := by decide
      rw [this]; ring_nf
      have : (9 : ZMod 5) = -1 := by decide
      rw [this]; ring

