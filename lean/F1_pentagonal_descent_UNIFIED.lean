theorem the_numerator_that_must_land (ρ : ℂ) (h0 : ρ ≠ 0) (h1 : ρ ≠ 1) :
    valPhi (zeroCoord ρ) =
      (Real.log (Complex.abs (ρ - 1)) - Real.log (Complex.abs ρ)) / Real.log (φ : ℝ) := by
  have hform : liMap ρ = (ρ - 1) / ρ := by unfold liMap; field_simp
  have ha : (0:ℝ) < Complex.abs ρ := Complex.abs.pos h0
  have hb : (0:ℝ) < Complex.abs (ρ - 1) := by
    apply Complex.abs.pos
    intro h
    exact h1 (by linear_combination h)
  unfold valPhi zeroCoord
  rw [hform]
  simp only [Complex.abs, norm_div]
  rw [Real.log_div (ne_of_gt hb) (ne_of_gt ha)]

