/-! ## §94.1  Las coincidencias posibles en la órbita de Klein -/

/-- **[P] `σ` FIJA `ρ` SYSS `ρ` ES REAL.**  `ρ = ρ̄ ⟺ Im ρ = 0`. -/
theorem sigma_fixes_iff_real (ρ : ℂ) :
    (starRingEnd ℂ) ρ = ρ ↔ ρ.im = 0 := by
  rw [Complex.ext_iff]
  simp only [Complex.conj_re, Complex.conj_im, true_and]
  constructor
  · intro h; linarith
  · intro h; linarith

/-- **[P] `τ` FIJA `ρ` SYSS `ρ = 1/2`.**  `ρ = 1 − ρ ⟺ 2ρ = 1`, y eso
    obliga a `Im ρ = 0`. -/
theorem tau_fixes_iff_half (ρ : ℂ) :
    1 - ρ = ρ ↔ (ρ.re = 1 / 2 ∧ ρ.im = 0) := by
  rw [Complex.ext_iff]
  simp only [Complex.sub_re, Complex.one_re, Complex.sub_im, Complex.one_im,
    zero_sub, one_div]
  constructor
  · rintro ⟨h1, h2⟩; exact ⟨by linarith, by linarith⟩
  · rintro ⟨h1, h2⟩; exact ⟨by linarith, by linarith⟩

/-- **[P] `στ` FIJA `ρ` SYSS `Re ρ = 1/2`.**  `ρ̄ = 1 − ρ`: la parte
    imaginaria se cumple sola, y la real da la línea crítica.

    **Ésta es la única coincidencia disponible para un cero.** -/
theorem stau_fixes_iff_critical (ρ : ℂ) :
    (starRingEnd ℂ) ρ = 1 - ρ ↔ ρ.re = 1 / 2 := by
  rw [Complex.ext_iff]
  simp only [Complex.conj_re, Complex.sub_re, Complex.one_re,
             Complex.conj_im, Complex.sub_im, Complex.one_im]
  constructor
  · rintro ⟨h1, -⟩; linarith
  · intro h
    exact ⟨by linarith, by ring⟩

/-! ## §94.2  Ningún cero es punto fijo total -/

/-- **[P] NO HAY PUNTO FIJO TOTAL CON `Im ρ ≠ 0`.**  Serlo exigiría
    `ρ` real: `|órbita| = 1` está descartado para los ceros. -/
theorem no_total_fixed_point (ρ : ℂ) (him : ρ.im ≠ 0) :
    ¬ ((starRingEnd ℂ) ρ = ρ ∧ 1 - ρ = ρ) := by
  rintro ⟨h1, _⟩
  exact him ((sigma_fixes_iff_real ρ).mp h1)

/-! ## §94.3  Los cardinales posibles, y la única razón -/

/-- **[P] LOS DIVISORES DE `4`.**  Todo cardinal de órbita bajo un
    grupo de orden `4` es `1`, `2` o `4`. -/
theorem divisors_of_four (n : ℕ) (h : n ∣ 4) : n = 1 ∨ n = 2 ∨ n = 4 := by
  have h4 : n ≤ 4 := Nat.le_of_dvd (by norm_num) h
  interval_cases n <;> simp_all

/-- **[P] CON EL `1` DESCARTADO, LA ÚNICA RAZÓN ES `1/2`.**
    `|órbita| ∈ {2,4}` y `2/4 = 1/2`. -/
theorem only_ratio_is_one_half :
    (∀ n : ℕ, n ∣ 4 → n = 1 ∨ n = 2 ∨ n = 4) ∧
    ((2 : ℝ) / 4 = 1 / 2) := by
  refine ⟨divisors_of_four, by norm_num⟩

/-- **[P] EL ÁPICE ESTÁ FORZADO.**  Para un cero (`Im ρ ≠ 0`):

    (i)   `|órbita| = 1` es imposible;
    (ii)  la única coincidencia posible es `στ`, y equivale a
          `Re ρ = 1/2`;
    (iii) luego el cardinal cae de `4` a `2`, razón `1/2`.

    **`1/2` no se elige: es el único cociente que el grupo admite.** -/
theorem the_apex_is_forced (ρ : ℂ) (him : ρ.im ≠ 0) :
    (¬ ((starRingEnd ℂ) ρ = ρ ∧ 1 - ρ = ρ)) ∧
    ((starRingEnd ℂ) ρ = 1 - ρ ↔ ρ.re = 1 / 2) ∧
    ((2 : ℝ) / 4 = 1 / 2) :=
  ⟨no_total_fixed_point ρ him, stau_fixes_iff_critical ρ, by norm_num⟩

/-! ## §94.4  Tres rutas al mismo `1/2` -/

/-- **[P] LA RAZÓN DE COLAPSO ES LA TERCERA RUTA.**
    `half_on_both_faces` daba `Γ(3/2)/√π = φ^{−λ}`; aquí se añade
    `2/4`, que es la que explica por qué el valor es ése.

    Tres construcciones, un número. -/
theorem three_routes_to_one_half :
    (Real.Gamma (3 / 2) / Real.sqrt Real.pi
      = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ))) ∧
    ((2 : ℝ) / 4 = 1 / 2) ∧
    (Real.Gamma (3 / 2) / Real.sqrt Real.pi = 1 / 2) := by
  refine ⟨half_on_both_faces, by norm_num, ?_⟩
  rw [half_is_mu_three.1, mu_ternary_param]

/-! ## §94.5  El balance -/

/-- **[O] EL BALANCE DE §94.**

    | pregunta | antes | ahora |
    |---|---|---|
    | ¿por qué `1/2`? | coincidencia de dos caras `[P]` | **forzado por `\|V\| = 4`** |
    | ¿por qué colapsa? | `Fix(στ)` `[P]` | y es la ÚNICA coincidencia posible |
    | ¿qué lo desencadena? | --- | `u = 0`, la coordenada `χ₄` sobre `Z_{χ₅}` |

    Y por eso las dos caras dejan de verse por separado justo ahí:
