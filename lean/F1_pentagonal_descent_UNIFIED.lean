-/

namespace F1PaperNew

noncomputable def φ : ℝ := (1 + Real.sqrt 5) / 2

/-- `r ∈ ℚ(√5)`. -/
def InQSqrt5 (r : ℝ) : Prop := ∃ a b : ℚ, r = (a : ℝ) + (b : ℝ) * Real.sqrt 5

/-- **[P*] The corrected input.**  Positive reals of ℚ(√5) with integer trace are
    powers of φ.  This is `UnitStructure` with the missing hypothesis. -/
def UnitStructureK : Prop :=
  ∀ r : ℝ, 0 < r → InQSqrt5 r → (∃ m : ℤ, r + 1 / r = (m : ℝ)) → ∃ k : ℤ, r = φ ^ k

-- Part (a) of Theorem 17.9 is `trace_integer_plus_bound` of the corpus, used as is.
/-- **[P*] Part (b) of Theorem 17.9** is now proved in `F1_v2_formalizations`:
    `F1v2.arrowB` (from r ∈ ℤ[φ]); re-exported here. -/
alias arrowB := F1v2.arrowB
alias arrowB_full := F1v2.arrowB_full


/-! ## Reconnections (ontology, round 2)

  Hypotheses that compiled lemmas take on an abstract φ, or on an abstract map, and
  that the corpus already proves for the real objects.  Each lemma below closes one of
