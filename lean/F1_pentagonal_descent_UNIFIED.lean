section OZTraidosBlock
namespace F1OZ

open Real

/-! ### 1. Self-duality of a monic quadratic under `x ↦ -1/x` -/

/-- `x² + a x + b` satisfies `q(-1/x) = -q(x)/x²` for every `x ≠ 0` exactly when `b = -1`,
whatever `a` is. -/
theorem selfdual_iff (a b : ℝ) :
    (∀ x : ℝ, x ≠ 0 → (-1 / x) ^ 2 + a * (-1 / x) + b = -(x ^ 2 + a * x + b) / x ^ 2) ↔
      b = -1 := by
  constructor
  · intro h
    have h1 := h 1 one_ne_zero
    norm_num at h1
    linarith
  · rintro rfl x hx
    field_simp
    ring

/-- For `a ≠ 0` the self-dual quadratic `x² + a x - 1` has discriminant `a² + 4`, which is not
a square: the polynomial is irreducible over `ℚ`.  For `a = 0` it is `(x-1)(x+1)`. -/
theorem selfdual_disc_not_square (a : ℤ) (ha : a ≠ 0) (m : ℤ) : m ^ 2 ≠ a ^ 2 + 4 := by
  intro h
  have hu : 1 ≤ |a| := Int.one_le_abs ha
  have hv : |m| ^ 2 = |a| ^ 2 + 4 := by rw [sq_abs, sq_abs]; exact h
  have hm0 : 0 ≤ |m| := abs_nonneg m
  generalize |a| = u at hu hv
  generalize |m| = v at hv hm0
  have h1 : u < v := by
    by_contra hc
    have hc' := not_lt.mp hc
    nlinarith
  have h2 : v < u + 2 := by
    by_contra hc
    have hc' := not_lt.mp hc
    nlinarith
  have h3 : v = u + 1 := by omega
  subst h3
  have : 2 * u = 3 := by nlinarith
  omega

/-! ### 2. The local factors at `s = 3` of the case study -/

theorem local_factors_at_three :
    (1 - (1 : ℚ) / 2 ^ 6)⁻¹ = 64 / 63 ∧ (1 - (1 : ℚ) / 3 ^ 6)⁻¹ = 729 / 728 ∧
    (1 - (1 : ℚ) / 5 ^ 3)⁻¹ = 125 / 124 ∧ ((1 - (1 : ℚ) / 11 ^ 3)⁻¹) ^ 2 = (1331 / 1330) ^ 2 := by
  norm_num

/-! ### 3. The two pentagonal derivations of `L(1, χ₅)` : arithmetic steps -/

/-- Gauss–Lerch: with the logarithmic signature `S = -2 log φ`,
`-(√5/5) S = 2 log φ / √5`. -/
theorem lerch_arith (S l : ℝ) (hS : S = -2 * l) : -(√5 / 5) * S = 2 * l / √5 := by
  have h5 : √5 * √5 = 5 := Real.mul_self_sqrt (by norm_num)
  have hpos : (0 : ℝ) < √5 := by positivity
  subst hS
  field_simp
  linear_combination l * h5

/-- Digamma: from `L = -(1/5) Σ χ₅(a) ψ(a/5)` and `L = 2 log φ / √5`,
`Σ χ₅(a) ψ(a/5) = -2 √5 log φ`. -/
theorem digamma_sum (Ψ l L : ℝ) (h1 : L = -(1 / 5) * Ψ) (h2 : L = 2 * l / √5) :
    Ψ = -2 * √5 * l := by
  have h5 : √5 * √5 = 5 := Real.mul_self_sqrt (by norm_num)
  have hpos : (0 : ℝ) < √5 := by positivity
  have hΨ : Ψ = -5 * L := by linarith
  rw [hΨ, h2]
  field_simp
  linear_combination l * h5

/-! ### 4. The distances from `1` to the fifth roots of unity -/

theorem normSq_one_sub_exp (θ : ℝ) :
    Complex.normSq (1 - Complex.exp (θ * Complex.I)) = 2 - 2 * Real.cos θ := by
  rw [Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin, Complex.normSq_apply]
  simp only [Complex.sub_re, Complex.one_re, Complex.add_re, Complex.ofReal_re, Complex.mul_re,
    Complex.I_re, Complex.I_im, Complex.ofReal_im, Complex.sub_im, Complex.one_im,
    Complex.add_im, Complex.mul_im]
  nlinarith [Real.sin_sq_add_cos_sq θ]

/-- Private helper: the corpus states this as `F1CW.cos_two_pi_div_five_eq` (in an uncompiled
module); restated here only to compile this block on its own. -/
private theorem cos_two_pi_div_five : Real.cos (2 * π / 5) = (√5 - 1) / 4 := by
  have h5 : √5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  rw [show 2 * π / 5 = 2 * (π / 5) by ring, Real.cos_two_mul, Real.cos_pi_div_five]
  nlinarith [h5]

/-- Private helper: in the corpus, a clause of `pentagon_nodes_unconditional`. -/
private theorem cos_four_pi_div_five : Real.cos (4 * π / 5) = -(1 + √5) / 4 := by
  rw [show 4 * π / 5 = π - π / 5 by ring, Real.cos_pi_sub, Real.cos_pi_div_five]
  ring

theorem normSq_one_sub_zeta5 :
    Complex.normSq (1 - Complex.exp (((2 * π / 5 : ℝ) : ℂ) * Complex.I)) = (5 - √5) / 2 := by
  rw [normSq_one_sub_exp, cos_two_pi_div_five]
  ring

theorem normSq_one_sub_zeta5_sq :
    Complex.normSq (1 - Complex.exp (((4 * π / 5 : ℝ) : ℂ) * Complex.I)) = (5 + √5) / 2 := by
  rw [normSq_one_sub_exp, cos_four_pi_div_five]
  ring

/-- `|1 - ζ₅²|² / |1 - ζ₅|² = φ²`. -/
theorem baker_ratio : ((5 + √5) / 2) / ((5 - √5) / 2) = ((1 + √5) / 2) ^ 2 := by
  have h5 : √5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  have hlt : √5 < 5 := by nlinarith [Real.sqrt_nonneg 5]
  have hne : (5 - √5) / 2 ≠ 0 := by
    intro h; linarith
  rw [div_eq_iff hne]
  nlinarith [h5]

/-! ### 5. The Fourier projection of the pentagon onto `χ₅` -/

/-- Private helper: `χ₅` on the naturals, with value `0` on multiples of `5`; the corpus has the
same function as `chiFive` (in an uncompiled module), with values in `ℤ`. -/
private noncomputable def chi5n (n : ℕ) : ℝ :=
  if n % 5 = 1 ∨ n % 5 = 4 then 1 else if n % 5 = 2 ∨ n % 5 = 3 then -1 else 0

private theorem cos_six_pi_div_five : Real.cos (6 * π / 5) = -(1 + √5) / 4 := by
  rw [show 6 * π / 5 = π / 5 + π by ring, Real.cos_add_pi, Real.cos_pi_div_five]
  ring

private theorem cos_eight_pi_div_five : Real.cos (8 * π / 5) = (√5 - 1) / 4 := by
  rw [show 8 * π / 5 = 2 * π - 2 * π / 5 by ring, Real.cos_two_pi_sub, cos_two_pi_div_five]

private theorem cos_twelve_pi_div_five : Real.cos (12 * π / 5) = (√5 - 1) / 4 := by
  have := Real.cos_add_nat_mul_two_pi (2 * π / 5) 1
  rw [show 2 * π / 5 + ((1 : ℕ) : ℝ) * (2 * π) = 12 * π / 5 by push_cast; ring] at this
  rw [this, cos_two_pi_div_five]

private theorem cos_sixteen_pi_div_five : Real.cos (16 * π / 5) = -(1 + √5) / 4 := by
  have := Real.cos_add_nat_mul_two_pi (6 * π / 5) 1
  rw [show 6 * π / 5 + ((1 : ℕ) : ℝ) * (2 * π) = 16 * π / 5 by push_cast; ring] at this
  rw [this, cos_six_pi_div_five]

/-- `cos(2πn/5) - cos(4πn/5) = (√5/2) χ₅(n)` for every natural `n`. -/
theorem fourier_projection (n : ℕ) :
    Real.cos (2 * π * n / 5) - Real.cos (4 * π * n / 5) = √5 / 2 * chi5n n := by
  have hn : n = 5 * (n / 5) + n % 5 := (Nat.div_add_mod n 5).symm
  set q := n / 5
  set r := n % 5 with hr
  have hr5 : r < 5 := Nat.mod_lt n (by norm_num)
  have e1 : 2 * π * (n : ℝ) / 5 = 2 * π * r / 5 + (q : ℕ) * (2 * π) := by
    rw [hn]; push_cast; ring
  have e2 : 4 * π * (n : ℝ) / 5 = 4 * π * r / 5 + ((2 * q : ℕ) : ℝ) * (2 * π) := by
    rw [hn]; push_cast; ring
  rw [e1, e2, Real.cos_add_nat_mul_two_pi, Real.cos_add_nat_mul_two_pi]
  unfold chi5n
  rw [← hr]
  interval_cases r
  · norm_num
  · norm_num
    rw [cos_two_pi_div_five, cos_four_pi_div_five]; ring
  · norm_num
    rw [show 2 * π * 2 / 5 = 4 * π / 5 by ring, show 4 * π * 2 / 5 = 8 * π / 5 by ring,
      cos_four_pi_div_five, cos_eight_pi_div_five]; ring
  · norm_num
    rw [show 2 * π * 3 / 5 = 6 * π / 5 by ring, show 4 * π * 3 / 5 = 12 * π / 5 by ring,
      cos_six_pi_div_five, cos_twelve_pi_div_five]; ring
  · norm_num
    rw [show 2 * π * 4 / 5 = 8 * π / 5 by ring, show 4 * π * 4 / 5 = 16 * π / 5 by ring,
      cos_eight_pi_div_five, cos_sixteen_pi_div_five]; ring

end F1OZ

