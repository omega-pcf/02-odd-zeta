theorem unconditional_facts_about_a_zero (z : Chi5Zero) (hγ : 2 ≤ |z.ρ.im|) :
    (DirichletCharacter.LFunction chi5_D (1 - z.ρ) = 0) ∧
    (discP (zeroCoord z.ρ) ≤ 1/12) ∧
    (Real.sqrt 3 / 2 ≤ zeroCoord z.ρ ∧ zeroCoord z.ρ ≤ 2 / Real.sqrt 3) ∧
