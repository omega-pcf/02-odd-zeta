def stripZeros (L : ℂ → ℂ) : Set ℂ :=
  {ρ : ℂ | 0 < ρ.re ∧ ρ.re < 1 ∧ L ρ = 0}

@[simp] theorem mem_stripZeros {L : ℂ → ℂ} {ρ : ℂ} :
    ρ ∈ stripZeros L ↔ 0 < ρ.re ∧ ρ.re < 1 ∧ L ρ = 0 :=
  Iff.rfl

theorem closed_under_mate_of_fe_rc (L : ℂ → ℂ)
    (hfe : FunctionalEquation L) (hreal : RealCoefficients L) :
    ClosedUnderMate (stripZeros L) := by
  intro ρ hρ
  obtain ⟨h0, h1, hz⟩ := mem_stripZeros.mp hρ
  have hcz : L ((starRingEnd ℂ) ρ) = 0 := hreal ρ hz
  have hc0 : 0 < ((starRingEnd ℂ) ρ).re := by
    rw [Complex.conj_re]; exact h0
  have hc1 : ((starRingEnd ℂ) ρ).re < 1 := by
    rw [Complex.conj_re]; exact h1
  have hkz : L (kmate ρ) = 0 := hfe ((starRingEnd ℂ) ρ) hc0 hc1 hcz
  refine mem_stripZeros.mpr ⟨?_, ?_, hkz⟩
  · rw [kmate_reflects_abscissa]; linarith
  · rw [kmate_reflects_abscissa]; linarith

theorem E_from_fe_rc_and_min_spacing (L : ℂ → ℂ) (m : ℝ)
    (hfe : FunctionalEquation L) (hreal : RealCoefficients L)
    (hmin : MinSpacing (stripZeros L) m) :
    OnTheLine (stripZeros L) :=
  min_spacing_positive_gives_E (stripZeros L) m
    (closed_under_mate_of_fe_rc L hfe hreal) hmin

theorem E_iff_no_shared_ordinate_of_fe_rc (L : ℂ → ℂ)
    (hfe : FunctionalEquation L) (hreal : RealCoefficients L) :
    OnTheLine (stripZeros L) ↔ ¬ SharesOrdinate (stripZeros L) :=
  E_iff_no_shared_ordinate (stripZeros L)
    (closed_under_mate_of_fe_rc L hfe hreal)

theorem realCoefficients_of_conj_comm (L : ℂ → ℂ)
    (hconj : ∀ s : ℂ, L ((starRingEnd ℂ) s) = (starRingEnd ℂ) (L s)) :
    RealCoefficients L := by
  intro ρ hz
  rw [hconj ρ, hz, map_zero]

theorem functionalEquation_chi5 :
    FunctionalEquation (DirichletCharacter.LFunction chi5_D) :=
  fun _ρ h0 h1 hz => hecke_chi5_derived h0 h1 hz

def e2c (ρ : ℂ) : ℂ := ρ * (1 - ρ)

theorem e2c_im (ρ : ℂ) : (e2c ρ).im = ρ.im * (1 - 2 * ρ.re) := by
  unfold e2c
  simp [Complex.mul_im, Complex.sub_re, Complex.sub_im,
        Complex.one_re, Complex.one_im]
  ring

theorem e2c_im_zero_iff (ρ : ℂ) (hγ : ρ.im ≠ 0) :
    (e2c ρ).im = 0 ↔ ρ.re = 1 / 2 := by
  rw [e2c_im]
  constructor
  · intro h
    rcases mul_eq_zero.mp h with h1 | h2
    · exact absurd h1 hγ
    · linarith
  · intro h; rw [h]; ring

theorem no_shared_ordinate_iff_e2_real (Z : Set ℂ)
    (hc : ClosedUnderMate Z) (hγ : ∀ ρ ∈ Z, ρ.im ≠ 0) :
    ¬ SharesOrdinate Z ↔ ∀ ρ ∈ Z, (e2c ρ).im = 0 := by
  constructor
  · intro h ρ hρ
    have hline : ρ.re = 1 / 2 := no_shared_ordinate_gives_E Z hc h ρ hρ
    rw [e2c_im, hline]; ring
  · intro h
    apply on_the_line_no_shared_ordinate
    intro ρ hρ
    exact (e2c_im_zero_iff ρ (hγ ρ hρ)).mp (h ρ hρ)

theorem minSpacingBound_iff_minSpacing (Z : Set ℂ) (m : ℝ) :
    MinSpacingBound Z m ↔ MinSpacing Z m := by
  unfold MinSpacingBound MinSpacing spacing
  rfl

theorem kmate_e2c_conj (ρ : ℂ) :
    e2c (kmate ρ) = (starRingEnd ℂ) (e2c ρ) := by
  unfold e2c kmate
  simp only [map_mul, map_sub, map_one]
  ring

theorem violation_is_invisible_to_sums (ρ : ℂ) (hδ : ρ.re ≠ 1 / 2) :
    kmate ρ ≠ ρ ∧
    (kmate ρ).im - ρ.im = 0 ∧
    (e2c ρ).im + (e2c (kmate ρ)).im = 0 := by
  refine ⟨?_, ?_, ?_⟩
  · intro h; exact hδ ((kmate_fixed_iff ρ).mp h)
  · rw [kmate_same_ordinate]; ring
  · rw [kmate_e2c_conj]; simp [Complex.conj_im]

theorem off_line_zero_defeats_every_m (Z : Set ℂ)
    (hc : ClosedUnderMate Z) (ρ : ℂ) (hρ : ρ ∈ Z) (hδ : ρ.re ≠ 1 / 2) :
    ∀ m : ℝ, ¬ MinSpacing Z m := by
  rintro m ⟨hm, hall⟩
  have hk : kmate ρ ∈ Z := hc ρ hρ
  have hne : ρ ≠ kmate ρ := fun h => hδ ((kmate_fixed_iff ρ).mp h.symm)
  have hle := hall ρ hρ (kmate ρ) hk hne
  rw [kmate_same_ordinate] at hle
  simp at hle
  linarith

theorem no_uniform_m_of_vanishing_spacing (Z : Set ℂ)
    (hdecay : ∀ ε : ℝ, 0 < ε →
      ∃ ρ ∈ Z, ∃ σ ∈ Z, ρ ≠ σ ∧ |σ.im - ρ.im| < ε) :
    ∀ m : ℝ, ¬ MinSpacing Z m := by
  rintro m ⟨hm, hall⟩
  obtain ⟨ρ, hρ, σ, hσ, hne, hlt⟩ := hdecay m hm
  exact absurd (hall ρ hρ σ hσ hne) (not_le.mpr hlt)

theorem violator_below_resolution (δ γ : ℝ)
    (hδ : |δ| < 1 / 2) (hγ : 4 ≤ γ) (hπ : (3.14 : ℝ) < Real.pi) :
    |2 * δ / γ| < 2 * Real.pi / 20 ∧
    |2 * δ * γ| < γ ^ 2 * (2 * Real.pi / 20) := by
  have hγ0 : (0 : ℝ) < γ := by linarith
  have hγa : |γ| = γ := abs_of_pos hγ0
  constructor
  · rw [_root_.abs_div, abs_mul, hγa, div_lt_iff₀ hγ0]
    have h2 : |(2 : ℝ)| = 2 := by norm_num
    rw [h2]
    nlinarith [abs_nonneg δ]
  · rw [abs_mul, abs_mul, hγa]
    have h2 : |(2 : ℝ)| = 2 := by norm_num
    rw [h2]
    nlinarith [abs_nonneg δ]

theorem structural_route_gives_E (Z : Set ℂ) (c : ℂ → ℝ) (B : ℝ)
    (hI : IntegralityConjecture (c '' Z))
    (hB : DiscBound (c '' Z) B)
    (hcoord : ∀ ρ ∈ Z, (c ρ = 1 ↔ ρ.re = 1 / 2))
    (hpos : ∀ ρ ∈ Z, 0 < c ρ) :
    OnTheLine Z := by
  intro ρ hρ
  have hmem : c ρ ∈ c '' Z := Set.mem_image_of_mem c hρ
  have hone : c ρ = 1 :=
    integrality_implies_E (c '' Z) B hI hB (c ρ) hmem (hpos ρ hρ)
  exact (hcoord ρ hρ).mp hone

theorem two_routes_one_E (Z : Set ℂ) (L : ℂ → ℂ) (c : ℂ → ℝ)
    (m B : ℝ)
    (hfe : FunctionalEquation L) (hreal : RealCoefficients L)
    (hmin : MinSpacing (stripZeros L) m)
    (hI : IntegralityConjecture (c '' Z)) (hB : DiscBound (c '' Z) B)
    (hcoord : ∀ ρ ∈ Z, (c ρ = 1 ↔ ρ.re = 1 / 2))
    (hpos : ∀ ρ ∈ Z, 0 < c ρ) :
    OnTheLine (stripZeros L) ∧ OnTheLine Z :=
  ⟨E_from_fe_rc_and_min_spacing L m hfe hreal hmin,
   structural_route_gives_E Z c B hI hB hcoord hpos⟩

theorem sqrt_five_lower : (2.2360679 : ℝ) < Real.sqrt 5 := by
  nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 5 by norm_num),
             Real.sqrt_nonneg 5,
             sq_nonneg (Real.sqrt 5 - 2.2360679)]

theorem gap_beats_composite_bound :
    (3472359 : ℝ) / 10000000000000 < Real.sqrt 5 - 2 := by
  have h := sqrt_five_lower
  norm_num
  linarith

theorem gap_margin_factor :
    (670000 : ℝ) * ((3472359 : ℝ) / 10000000000000) < Real.sqrt 5 - 2 := by
  have h := sqrt_five_lower
  norm_num
  linarith

theorem gap_independent_of_height (γ₁ γ₂ : ℝ) :
    (Real.sqrt 5 - 2 : ℝ) = Real.sqrt 5 - 2 ∧
    (0 : ℝ) < Real.sqrt 5 - 2 := by
  refine ⟨rfl, ?_⟩
  have h := sqrt_five_lower
  linarith

-- `phi_pos` eliminado: ya existe en un fichero compilado.

theorem phi_ne_zero : (φ : ℝ) ≠ 0 := ne_of_gt φ_pos

theorem one_lt_phi : (1 : ℝ) < φ := by
  unfold φ
  have h : (1:ℝ) < Real.sqrt 5 := by
    nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 5 by norm_num),
               Real.sqrt_nonneg 5]
  linarith

theorem phi_mul_phi_sub_one : (φ : ℝ) * (φ - 1) = 1 := by
  have h := phi_sq
  nlinarith [h]

theorem phi_inv_eq : (φ : ℝ)⁻¹ = φ - 1 := by
  have hx0 : (φ : ℝ) ≠ 0 := ne_of_gt φ_pos
  field_simp
  ring_nf
  nlinarith [phi_sq]

theorem two_phi_sub_one : 2 * (φ : ℝ) - 1 = Real.sqrt 5 := by
  unfold φ; ring

theorem psi_sq : (1 - (φ : ℝ)) ^ 2 = (1 - φ) + 1 := by
  nlinarith [phi_sq]

theorem disc_mate_invariant (r : ℝ) (hr : r ≠ 0) :
    discP (1 / r) = discP r := by
  unfold discP e1P
  field_simp
  ring

theorem membership_mate_invariant (r : ℝ) (hr : r ≠ 0) :
    inChain (discP (1 / r)) ↔ inChain (discP r) := by
  rw [disc_mate_invariant r hr]

theorem E_gives_integrality (zeros : Set ℝ)
    (hE : ∀ r ∈ zeros, r = 1) : IntegralityConjecture zeros := by
  intro r hr
  refine ⟨0, ?_⟩
  rw [hE r hr]
  unfold discP e1P
  norm_num

theorem integrality_iff_E (zeros : Set ℝ) (B : ℝ)
    (hB : DiscBound zeros B) (hpos : ∀ r ∈ zeros, 0 < r) :
    IntegralityConjecture zeros ↔ ∀ r ∈ zeros, r = 1 := by
  constructor
  · intro hI r hr
    exact integrality_implies_E zeros B hI hB r hr (hpos r hr)
  · exact E_gives_integrality zeros

def lucasN : ℕ → ℕ
  | 0 => 2
  | 1 => 1
  | (k + 2) => lucasN (k + 1) + lucasN k

theorem lucasN_pos : ∀ k, 1 ≤ lucasN k
  | 0 => by simp [lucasN]
  | 1 => by simp [lucasN]
  | (k + 2) => by
      have h1 := lucasN_pos (k + 1)
      have h2 := lucasN_pos k
      simp [lucasN]; omega

theorem lucasN_even_ge_two (k : ℕ) (hk : Even k) : 2 ≤ lucasN k := by
  match k with
  | 0 => simp [lucasN]
  | 1 => exact absurd hk (by decide)
  | (m + 2) =>
      have h1 := lucasN_pos (m + 1)
      have h2 := lucasN_pos m
      simp [lucasN]; omega

theorem binet_diff : ∀ k : ℕ,
    (φ : ℝ) ^ k - (1 - φ) ^ k = (Nat.fib k : ℝ) * Real.sqrt 5 := by
  have step : ∀ (x : ℝ), x ^ 2 = x + 1 → ∀ k, x ^ (k + 2) = x ^ (k + 1) + x ^ k := by
    intro x hx k
    have : x ^ (k + 2) = x ^ k * x ^ 2 := by ring
    rw [this, hx]; ring
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    match k with
    | 0 => simp
    | 1 =>
        simp only [Nat.fib_one, Nat.cast_one, one_mul]
        rw [← two_phi_sub_one]; ring
    | (m + 2) =>
        have h1 := ih (m + 1) (by omega)
        have h2 := ih m (by omega)
        rw [step φ phi_sq m, step (1 - φ) psi_sq m,
            Nat.fib_add_two]
        push_cast
        nlinarith [h1, h2]

theorem binet_sum : ∀ k : ℕ,
    (φ : ℝ) ^ k + (1 - φ) ^ k = (lucasN k : ℝ) := by
  have step : ∀ (x : ℝ), x ^ 2 = x + 1 → ∀ k, x ^ (k + 2) = x ^ (k + 1) + x ^ k := by
    intro x hx k
    have : x ^ (k + 2) = x ^ k * x ^ 2 := by ring
    rw [this, hx]; ring
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    match k with
    | 0 => norm_num [lucasN]
    | 1 => norm_num [lucasN]
    | (m + 2) =>
        have h1 := ih (m + 1) (by omega)
        have h2 := ih m (by omega)
        rw [step φ phi_sq m, step (1 - φ) psi_sq m]
        simp [lucasN]
        linarith [h1, h2]

theorem phi_inv_pow (k : ℕ) :
    ((φ : ℝ) ^ k)⁻¹ = (-1) ^ k * (1 - φ) ^ k := by
  rw [← inv_pow, phi_inv_eq]
  rw [← mul_pow]
  congr 1
  ring

theorem family_membership_nat (k : ℕ) :
    inChain (discP ((φ : ℝ) ^ k)) := by
  have hφk : (φ : ℝ) ^ k ≠ 0 := pow_ne_zero k phi_ne_zero
  have he1 : e1P ((φ : ℝ) ^ k)
      = (φ : ℝ) ^ k + (-1) ^ k * (1 - φ) ^ k := by
    unfold e1P
    rw [one_div, phi_inv_pow]
  rcases Nat.even_or_odd k with hk | hk
  · -- k par: e1 = φᵏ + ψᵏ = L_k;  disc = L_k² − 4, y L_k ≥ 2
    have hsgn : ((-1 : ℝ)) ^ k = 1 := hk.neg_one_pow
    refine ⟨lucasN k ^ 2 - 4, ?_⟩
    have hL2 : 2 ≤ lucasN k := lucasN_even_ge_two k hk
    have h4 : 4 ≤ lucasN k ^ 2 := by nlinarith
    unfold discP
    rw [he1, hsgn, one_mul, binet_sum k]
    push_cast [Nat.cast_sub h4]
    ring
  · -- k impar: e1 = φᵏ − ψᵏ = F_k·√5;  disc = 5F_k² − 4, y F_k ≥ 1
    have hsgn : ((-1 : ℝ)) ^ k = -1 := hk.neg_one_pow
    refine ⟨5 * Nat.fib k ^ 2 - 4, ?_⟩
    have hF : 1 ≤ Nat.fib k := by
      have : k ≠ 0 := by rintro rfl; exact absurd hk (by decide)
      exact Nat.fib_pos.mpr (Nat.pos_of_ne_zero this)
    have h4 : 4 ≤ 5 * Nat.fib k ^ 2 := by nlinarith
    unfold discP
    rw [he1, hsgn]
    have h5 : Real.sqrt 5 ^ 2 = 5 :=
      Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 5)
    have hsq : (φ ^ k - (1 - φ) ^ k) ^ 2 = 5 * Nat.fib k ^ 2 := by
      rw [binet_diff k, mul_pow, h5]
      ring
    push_cast [Nat.cast_sub h4]
    linear_combination hsq

theorem family_membership (k : ℤ) :
    inChain (discP ((φ : ℝ) ^ k)) := by
  rcases k with n | n
  · -- k = n ≥ 0
    simpa using family_membership_nat n
  · -- k = −(n+1): φ^k = 1/φ^(n+1), y disc(1/r) = disc(r)
    have hφ : (φ : ℝ) ^ (n + 1) ≠ 0 := pow_ne_zero _ phi_ne_zero
    have hz : (φ : ℝ) ^ (Int.negSucc n) = 1 / (φ : ℝ) ^ (n + 1) := by
      rw [zpow_negSucc, one_div]
    rw [hz, disc_mate_invariant _ hφ]
    exact family_membership_nat (n + 1)

theorem family_disc_ge_one_of_ne_zero (k : ℤ) (hk : k ≠ 0) :
    1 ≤ discP ((φ : ℝ) ^ k) := by
  have main : ∀ n : ℕ, 1 ≤ discP ((φ : ℝ) ^ (n + 1)) := by
    intro n
    have hφ1 : (1 : ℝ) < φ := one_lt_phi
    have hpow : (φ : ℝ) ≤ φ ^ (n + 1) := by
      calc (φ : ℝ) = φ ^ 1 := (pow_one φ).symm
        _ ≤ φ ^ (n + 1) :=
          pow_le_pow_right₀ (le_of_lt hφ1) (by omega)
    have hinv : ((φ : ℝ) ^ (n + 1))⁻¹ ≤ φ⁻¹ := by
      have h2 : (1:ℝ) ≤ φ ^ (n + 1) := le_trans (le_of_lt hφ1) hpow
      exact (inv_le_inv₀ (lt_of_lt_of_le (by norm_num) h2)
        (lt_of_lt_of_le (by norm_num) (le_of_lt hφ1))).mpr hpow
    have hgap : (1 : ℝ) ≤ φ ^ (n + 1) - (φ ^ (n + 1))⁻¹ := by
      have h1 : (φ : ℝ) - φ⁻¹ = 1 := by
        rw [phi_inv_eq]; ring
      linarith
    have hd : discP ((φ : ℝ) ^ (n + 1))
        = ((φ : ℝ) ^ (n + 1) - (φ ^ (n + 1))⁻¹) ^ 2 := by
      have := disc_is_a_square ((φ : ℝ) ^ (n + 1))
        (pow_pos φ_pos (n + 1))
      rw [this, one_div]
    rw [hd]
    nlinarith [hgap]
  rcases k with n | n
  · match n, hk with
    | 0, hk => exact absurd rfl hk
    | (m + 1), _ => exact main m
  · have hφ : (φ : ℝ) ^ (n + 1) ≠ 0 := pow_ne_zero _ phi_ne_zero
    have hz : (φ : ℝ) ^ (Int.negSucc n) = 1 / (φ : ℝ) ^ (n + 1) := by
      rw [zpow_negSucc, one_div]
    rw [hz, disc_mate_invariant _ hφ]
    simpa using main n

theorem monomial_and_bound_give_E (zeros : Set ℝ) (B : ℝ)
    (hM : ∀ r ∈ zeros, ∃ k : ℤ, r = (φ : ℝ) ^ k)
    (hB : DiscBound zeros B) :
    ∀ r ∈ zeros, r = 1 := by
  intro r hr
  obtain ⟨k, hk⟩ := hM r hr
  by_cases h0 : k = 0
  · rw [hk, h0, zpow_zero]
  · exfalso
    have h1 : 1 ≤ discP r := by
      rw [hk]; exact family_disc_ge_one_of_ne_zero k h0
    have h2 : discP r ≤ B := hB.2 r hr
    have h3 : B < 1 := hB.1
    linarith

theorem monomial_gives_integrality (zeros : Set ℝ)
    (hM : ∀ r ∈ zeros, ∃ k : ℤ, r = (φ : ℝ) ^ k) :
    IntegralityConjecture zeros := by
  intro r hr
  obtain ⟨k, hk⟩ := hM r hr
  rw [hk]
  exact family_membership k

theorem trace_sub_two (r : ℝ) (hr : 0 < r) :
    r + 1 / r - 2 = (r - 1) ^ 2 / r := by
  field_simp
  ring

theorem trace_ge_two (r : ℝ) (hr : 0 < r) : 2 ≤ r + 1 / r := by
  have h := trace_sub_two r hr
  have h2 : 0 ≤ (r - 1) ^ 2 / r := div_nonneg (sq_nonneg _) (le_of_lt hr)
  linarith

theorem trace_eq_two_iff (r : ℝ) (hr : 0 < r) :
    r + 1 / r = 2 ↔ r = 1 := by
  constructor
  · intro h
    have hs := trace_sub_two r hr
    rw [h] at hs
    have hz : (r - 1) ^ 2 / r = 0 := by linarith
    have hnum : (r - 1) ^ 2 = 0 := by
      by_contra hne
      have hpos : 0 < (r - 1) ^ 2 :=
        lt_of_le_of_ne (sq_nonneg _) (Ne.symm hne)
      have : 0 < (r - 1) ^ 2 / r := div_pos hpos hr
      linarith
    have : r - 1 = 0 := by
      exact pow_eq_zero_iff (n := 2) (by norm_num) |>.mp hnum
    linarith
  · intro h; rw [h]; norm_num

theorem trace_integral_and_bound_give_E (zeros : Set ℝ) (B : ℝ)
    (hT : ∀ r ∈ zeros, ∃ t : ℤ, (t : ℝ) = r + 1 / r)
    (hB : DiscBound zeros B)
    (hpos : ∀ r ∈ zeros, 0 < r) :
    ∀ r ∈ zeros, r = 1 := by
  intro r hr
  obtain ⟨t, ht⟩ := hT r hr
  have hr0 := hpos r hr
  have ht2 : (2 : ℤ) ≤ t := by
    have := trace_ge_two r hr0
    exact_mod_cast (ht ▸ this : (2:ℝ) ≤ (t:ℝ))
  have hdisc : discP r = (t : ℝ) ^ 2 - 4 := by
    unfold discP e1P
    rw [← ht]
  have hle : (t : ℝ) ^ 2 - 4 ≤ B := hdisc ▸ hB.2 r hr
  have hB1 : B < 1 := hB.1
  have ht5 : t ^ 2 < 5 := by
    have : ((t ^ 2 : ℤ) : ℝ) < 5 := by push_cast; nlinarith
    exact_mod_cast this
  have hteq : t = 2 := by nlinarith [ht2, ht5]
  have : r + 1 / r = 2 := by
    rw [← ht, hteq]; norm_num
  exact (trace_eq_two_iff r hr0).mp this

theorem trace_integral_gives_integrality (zeros : Set ℝ)
    (hT : ∀ r ∈ zeros, ∃ t : ℤ, (t : ℝ) = r + 1 / r)
    (hpos : ∀ r ∈ zeros, 0 < r) :
    IntegralityConjecture zeros := by
  intro r hr
  obtain ⟨t, ht⟩ := hT r hr
  have ht2 : (2 : ℤ) ≤ t := by
    have := trace_ge_two r (hpos r hr)
    exact_mod_cast (ht ▸ this : (2:ℝ) ≤ (t:ℝ))
  have hnn : (0 : ℤ) ≤ t ^ 2 - 4 := by nlinarith
  refine ⟨(t ^ 2 - 4).toNat, ?_⟩
  have hdisc : discP r = (t : ℝ) ^ 2 - 4 := by
    unfold discP e1P
    rw [← ht]
  rw [hdisc]
  have hnn2 : (t ^ 2 - 4 : ℤ).toNat = t ^ 2 - 4 := Int.toNat_of_nonneg hnn
  have hc : ((t ^ 2 - 4 : ℤ).toNat : ℝ) = ((t ^ 2 - 4 : ℤ) : ℝ) :=
    congrArg ((↑) : ℤ → ℝ) hnn2
  rw [hc]
  push_cast
  ring

theorem phi_trace_is_sqrt_five : e1P (φ : ℝ) = Real.sqrt 5 := by
  unfold e1P
  rw [one_div, phi_inv_eq, ← two_phi_sub_one]
  ring

theorem trace_not_integral_at_phi :
    ¬ ∃ t : ℤ, (t : ℝ) = e1P (φ : ℝ) := by
  rintro ⟨t, ht⟩
  have h5 : Irrational (Real.sqrt 5) :=
    (Nat.prime_iff.mpr (by decide)).irrational_sqrt
  rw [phi_trace_is_sqrt_five] at ht
  exact h5 ⟨(t : ℚ), by exact_mod_cast ht⟩

def phiUnit : RealQuadUnit where
  ε := φ
  t := 1
  n := 1
  pos := one_lt_phi
  rel := by push_cast; nlinarith [phi_sq]

def zeroModulusUnit (r : ℝ) (hr : 1 < r) (t : ℤ)
    (ht : (t : ℝ) = r + 1 / r) : RealQuadUnit where
  ε := r
  t := t
  n := -1
  pos := hr
  rel := by
    have hr0 : r ≠ 0 := ne_of_gt (lt_trans one_pos hr)
    push_cast
    rw [ht]
    field_simp
    ring

theorem both_sides_on_norm_one_locus (ρ : ℂ) (h₀ : ρ ≠ 0) (h₁ : ρ ≠ 1) :
    (Complex.abs (liMap ρ) * Complex.abs (liMap (1 - ρ)) = 1) ∧
    (∀ k : ℤ, (φ : ℝ) ^ k * (φ : ℝ) ^ (-k) = 1) :=
  ⟨moduli_product_is_one ρ h₀ h₁, family_e_two_is_one⟩

theorem inChain_iff_zero_of_lt_one (d : ℝ) (h1 : d < 1) :
    inChain d ↔ d = 0 := by
  constructor
  · intro hc; exact chain_gap_is_unity d hc h1
  · intro h; exact ⟨0, by rw [h]; norm_num⟩

theorem sqrt_five_lt_three : Real.sqrt 5 < 3 := by
  nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 5 by norm_num),
             Real.sqrt_nonneg 5]

theorem window_has_one_integer (t : ℤ)
    (h2 : (2 : ℝ) ≤ (t : ℝ)) (h5 : (t : ℝ) < Real.sqrt 5) : t = 2 := by
  have h3 : (t : ℝ) < 3 := lt_trans h5 sqrt_five_lt_three
  have ht2 : (2 : ℤ) ≤ t := by exact_mod_cast h2
  have ht3 : t < 3 := by exact_mod_cast h3
  omega

theorem disc_nonneg (r : ℝ) (hr : 0 < r) : 0 ≤ discP r := by
  rw [disc_is_a_square r hr]
  exact sq_nonneg _

theorem trace_sq_eq_disc_add_four (r : ℝ) :
    e1P r ^ 2 = discP r + 4 := by
  unfold discP
  ring

theorem trace_confined (zeros : Set ℝ) (B : ℝ)
    (hB : DiscBound zeros B) (hpos : ∀ r ∈ zeros, 0 < r) :
    ∀ r ∈ zeros, 2 ≤ e1P r ∧ e1P r < Real.sqrt 5 := by
  intro r hr
  have hr0 := hpos r hr
  have hlow : 2 ≤ e1P r := by
    have := trace_ge_two r hr0
    unfold e1P
    linarith
  refine ⟨hlow, ?_⟩
  have hsq : e1P r ^ 2 < 5 := by
    have h1 := hB.2 r hr
    have h2 := hB.1
    have h3 := trace_sq_eq_disc_add_four r
    linarith
  have h0 : (0 : ℝ) ≤ e1P r := by linarith
  nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 5 by norm_num),
             Real.sqrt_nonneg 5, hsq, h0]

theorem disc_confined (zeros : Set ℝ) (B : ℝ)
    (hB : DiscBound zeros B) (hpos : ∀ r ∈ zeros, 0 < r) :
    ∀ r ∈ zeros, 0 ≤ discP r ∧ discP r < 1 := by
  intro r hr
  exact ⟨disc_nonneg r (hpos r hr),
         lt_of_le_of_lt (hB.2 r hr) hB.1⟩

theorem integrality_iff_vanishing (zeros : Set ℝ) (B : ℝ)
    (hB : DiscBound zeros B) (hpos : ∀ r ∈ zeros, 0 < r) :
    IntegralityConjecture zeros ↔ ∀ r ∈ zeros, discP r = 0 := by
  constructor
  · intro hI r hr
    exact chain_gap_is_unity (discP r) (hI r hr)
      (lt_of_le_of_lt (hB.2 r hr) hB.1)
  · intro h r hr
    exact ⟨0, by rw [h r hr]; norm_num⟩

theorem vanishing_iff_fixed (r : ℝ) (hr : 0 < r) :
    discP r = 0 ↔ 1 / r = r := by
  rw [disc_is_a_square r hr]
  constructor
  · intro h
    have : r - 1 / r = 0 :=
      pow_eq_zero_iff (n := 2) (by norm_num) |>.mp h
    linarith
  · intro h
    have : r - 1 / r = 0 := by linarith
    rw [this]
    ring

theorem four_faces_of_the_obligation (zeros : Set ℝ) (B : ℝ)
    (hB : DiscBound zeros B) (hpos : ∀ r ∈ zeros, 0 < r) :
    (IntegralityConjecture zeros ↔ ∀ r ∈ zeros, discP r = 0) ∧
    ((∀ r ∈ zeros, discP r = 0) ↔ ∀ r ∈ zeros, 1 / r = r) ∧
    ((∀ r ∈ zeros, 1 / r = r) ↔ ∀ r ∈ zeros, e1P r = 2) ∧
    ((∀ r ∈ zeros, e1P r = 2) ↔ ∀ r ∈ zeros, r = 1) := by
  refine ⟨integrality_iff_vanishing zeros B hB hpos, ?_, ?_, ?_⟩
  · constructor
    · intro h r hr
      exact (vanishing_iff_fixed r (hpos r hr)).mp (h r hr)
    · intro h r hr
      exact (vanishing_iff_fixed r (hpos r hr)).mpr (h r hr)
  · constructor
    · intro h r hr
      have hlt : 0 < r := hpos r hr
      have h' := h r hr
      have hsq : r * r = 1 := by
        have hm : (1:ℝ) / r * r = 1 := div_mul_cancel₀ 1 hlt.ne'
        rwa [h'] at hm
      have htri : (r - 1) * (r + 1) = 0 := by linear_combination hsq
      have hr1 : r = 1 := by
        rcases mul_eq_zero.mp htri with heq | heq
        · linarith
        · exact absurd heq (by linarith)
      unfold e1P
      rw [hr1]
      norm_num
    · intro h r hr
      have hlt : 0 < r := hpos r hr
      have key : r + 1 / r = 2 := h r hr
      have hd : discP r = 0 := by
        unfold discP e1P at *
        rw [key]
        ring
      rw [disc_is_a_square r hlt] at hd
      have hzero : r - 1 / r = 0 := by
        exact pow_eq_zero_iff (n := 2) (by norm_num) |>.mp hd
      linarith
  · constructor
    · intro h r hr
      have h2 : r + 1 / r = 2 := by
        have := h r hr
        unfold e1P at this
        linarith
      exact (trace_eq_two_iff r (hpos r hr)).mp h2
    · intro h r hr
      unfold e1P
      rw [h r hr]
      norm_num

theorem same_fixed_point_both_routes (ρ : ℂ) (r : ℝ) (hr : 0 < r) :
    (kmate ρ = ρ ↔ ρ.re = 1 / 2) ∧
    (1 / r = r ↔ r = 1) := by
  refine ⟨kmate_fixed_iff ρ, ?_⟩
  constructor
  · intro h
    have hd : discP r = 0 := (vanishing_iff_fixed r hr).mpr h
    have h2 : e1P r = 2 := by
      have hs := trace_sq_eq_disc_add_four r
      rw [hd] at hs
      have hge : 2 ≤ e1P r := by
        have := trace_ge_two r hr
        unfold e1P
        linarith
      nlinarith [hs, hge]
    have : r + 1 / r = 2 := by unfold e1P at h2; linarith
    exact (trace_eq_two_iff r hr).mp this
  · intro h
    rw [h]
    norm_num

theorem quadratic_factor_upper (r : ℝ) :
    r ^ 2 - r - 1 = (r - φ) * (r + φ⁻¹) := by
  have h1 : (φ : ℝ) - φ⁻¹ = 1 := by rw [phi_inv_eq]; ring
  have h2 : (φ : ℝ) * φ⁻¹ = 1 := mul_inv_cancel₀ phi_ne_zero
  linear_combination r * h1 + h2

theorem quadratic_factor_lower (r : ℝ) :
    r ^ 2 + r - 1 = (r - φ⁻¹) * (r + φ) := by
  have h1 : (φ : ℝ) - φ⁻¹ = 1 := by rw [phi_inv_eq]; ring
  have h2 : (φ : ℝ) * φ⁻¹ = 1 := mul_inv_cancel₀ phi_ne_zero
  linear_combination h2 - r * h1

theorem disc_lt_one_iff_phi_window (r : ℝ) (hr : 0 < r) :
    discP r < 1 ↔ φ⁻¹ < r ∧ r < φ := by
  have hinvpos : (0 : ℝ) < φ⁻¹ := inv_pos.mpr φ_pos
  have hd : discP r = (r - 1 / r) ^ 2 := disc_is_a_square r hr
  constructor
  · intro h
    rw [hd] at h
    have habs : |r - 1 / r| < 1 := by
      nlinarith [_root_.sq_abs (r - 1 / r), abs_nonneg (r - 1 / r)]
    rw [abs_lt] at habs
    constructor
    · -- −1 < r − 1/r  ⟹  r² + r − 1 > 0  ⟹  r > 1/φ
      have hq : 0 < r ^ 2 + r - 1 := by
        have := habs.1
        have hmul : -r < r * r - 1 := by
          have h1 : (-1 : ℝ) * r < (r - 1 / r) * r := by
            apply mul_lt_mul_of_pos_right habs.1 hr
          field_simp at h1
          nlinarith [h1]
        nlinarith [hmul]
      have hf := quadratic_factor_lower r
      have hsum : (0 : ℝ) < r + φ := by linarith [φ_pos]
      nlinarith [hq, hf, hsum]
    · -- r − 1/r < 1  ⟹  r² − r − 1 < 0  ⟹  r < φ
      have hq : r ^ 2 - r - 1 < 0 := by
        have := habs.2
        have hmul : (r - 1 / r) * r < 1 * r :=
          mul_lt_mul_of_pos_right habs.2 hr
        field_simp at hmul
        nlinarith [hmul]
      have hf := quadratic_factor_upper r
      have hsum : (0 : ℝ) < r + φ⁻¹ := by linarith
      nlinarith [hq, hf, hsum]
  · rintro ⟨hlo, hhi⟩
    rw [hd]
    have h1 : r ^ 2 - r - 1 < 0 := by
      have hf := quadratic_factor_upper r
      have : r - φ < 0 := by linarith
      have hsum : (0 : ℝ) < r + φ⁻¹ := by linarith
      nlinarith
    have h2 : 0 < r ^ 2 + r - 1 := by
      have hf := quadratic_factor_lower r
      have : 0 < r - φ⁻¹ := by linarith
      have hsum : (0 : ℝ) < r + φ := by linarith [φ_pos]
      nlinarith
    have hup : r - 1 / r < 1 := by
      have hkey : r * r - 1 < r := by nlinarith [h1]
      have hnum : r - 1 / r = (r * r - 1) / r := by
        field_simp
      rw [hnum, div_lt_iff₀ hr]
      linarith
    have hlo2 : -1 < r - 1 / r := by
      have : -r < r * r - 1 := by nlinarith [h2]
      field_simp
      nlinarith [this]
    nlinarith [hup, hlo2]

theorem moduli_confined_to_phi_window (zeros : Set ℝ) (B : ℝ)
    (hB : DiscBound zeros B) (hpos : ∀ r ∈ zeros, 0 < r) :
    ∀ r ∈ zeros, φ⁻¹ < r ∧ r < φ := by
  intro r hr
  have h1 : discP r < 1 := lt_of_le_of_lt (hB.2 r hr) hB.1
  exact (disc_lt_one_iff_phi_window r (hpos r hr)).mp h1

theorem only_family_point_in_window (k : ℤ)
    (h : discP ((φ : ℝ) ^ k) < 1) : k = 0 := by
  by_contra hk
  have := family_disc_ge_one_of_ne_zero k hk
  linarith

theorem the_equation_is_not_coordinate_general :
    ∃ r : ℝ, 0 < r ∧
      0 ≤ discP r ∧
      discP (1 / r) = discP r ∧
      discP r < 1 ∧
      1 / r ≠ r := by
  refine ⟨5 / 4, by norm_num, ?_, ?_, ?_, by norm_num⟩
  · exact disc_nonneg (5 / 4) (by norm_num)
  · exact disc_mate_invariant (5 / 4) (by norm_num)
  · unfold discP e1P
    norm_num

theorem window_plus_family_gives_the_equation (r : ℝ) (hr : 0 < r)
    (hwin : discP r < 1) (hfam : ∃ k : ℤ, r = (φ : ℝ) ^ k) :
    1 / r = r := by
  obtain ⟨k, hk⟩ := hfam
  have hk0 : k = 0 := by
    apply only_family_point_in_window k
    rw [← hk]; exact hwin
  rw [hk, hk0]
  norm_num

theorem chi5_D_is_phi_free : (chi5_D 1 : ℂ) = 1 := by
  simp [chi5_D_apply, chi5_C, chi5_Z]

theorem liMap_abs_eq_one_iff_half (ρ : ℂ) (hρ : ρ ≠ 0) :
    Complex.abs (liMap ρ) = 1 ↔ ρ.re = 1 / 2 := by
  have hform : liMap ρ = (ρ - 1) / ρ := by
    unfold liMap; field_simp
  rw [hform, Complex.abs_div]
  constructor
  · intro h
    rw [div_eq_one_iff_eq (by simpa using hρ)] at h
    have e1 : Complex.abs (ρ - 1) ^ 2 = Complex.abs ρ ^ 2 := by rw [h]
    rw [Complex.sq_abs, Complex.sq_abs, Complex.normSq_apply,
        Complex.normSq_apply] at e1
    have e3 : (ρ.re - 1) ^ 2 + ρ.im ^ 2 = ρ.re ^ 2 + ρ.im ^ 2 := by
      simpa only [Complex.sub_re, Complex.sub_im, Complex.one_re,
                  Complex.one_im, sub_zero, ← pow_two] using e1
    have e4 : ρ.re ^ 2 - 2 * ρ.re + 1 = ρ.re ^ 2 := by linear_combination e3
    linarith
  · intro h
    have hne0 : Complex.abs ρ ≠ 0 := fun h0 => hρ (Complex.abs.eq_zero h0)
    have e1 : Complex.abs (ρ - 1) ^ 2 = Complex.abs ρ ^ 2 := by
      rw [Complex.sq_abs, Complex.sq_abs, Complex.normSq_apply,
          Complex.normSq_apply, Complex.sub_re, Complex.sub_im,
          Complex.one_re, Complex.one_im, h]
      ring
    rcases (sq_eq_sq_iff_eq_or_eq_neg).mp e1 with e | e
    · rw [e, div_self hne0]
    · exfalso
      have n1 : (0:ℝ) ≤ Complex.abs (ρ - 1) := Complex.abs.nonneg _
      rw [e] at n1
      have hz0 : Complex.abs ρ = 0 := by linarith [Complex.abs.nonneg ρ]
      exact hρ (Complex.abs.eq_zero hz0)

def chi5ZeroRealParts : Set ℂ := {ρ : ℂ | ∃ z : Chi5Zero, z.ρ = ρ}

def zeroCoord (ρ : ℂ) : ℝ := Complex.abs (liMap ρ)

theorem hcoord_discharged (ρ : ℂ) (h0 : 0 < ρ.re) :
    zeroCoord ρ = 1 ↔ ρ.re = 1 / 2 :=
  liMap_abs_eq_one_iff_half ρ (fun h => by rw [h] at h0; simp at h0)

theorem route_B_equals_GRH (B : ℝ) (hB : DiscBound (zeroCoord '' chi5ZeroRealParts) B) :
    IntegralityConjecture (zeroCoord '' chi5ZeroRealParts) ↔
      ∀ z : Chi5Zero, z.ρ.re = 1 / 2 := by
  have hpos : ∀ r ∈ zeroCoord '' chi5ZeroRealParts, 0 < r := by
    rintro r ⟨ρ, ⟨z, hz⟩, hr⟩
    rw [← hr, ← hz]
    unfold zeroCoord
    exact Complex.abs.pos (fun h => by
      have hpos := z.in_strip_pos
      have hne : z.ρ ≠ 0 := fun hc => by
        have h00re := congrArg Complex.re hc
        simp only [Complex.zero_re] at h00re
        rw [h00re] at hpos
        simp at hpos
      have hform : liMap z.ρ = (z.ρ - 1) / z.ρ := by
        unfold liMap
        field_simp
      rw [hform] at h
      rw [div_eq_zero_iff] at h
      rcases h with h1 | h00
      · have hone : z.ρ = 1 := sub_eq_zero.mp h1
        have hre : z.ρ.re = 1 := by rw [hone]; simp
        have hlt := z.in_strip_lt
        linarith
      · exact absurd h00 hne)
  constructor
  · intro hI z
    have hmem : zeroCoord z.ρ ∈ zeroCoord '' chi5ZeroRealParts :=
      ⟨z.ρ, ⟨z, rfl⟩, rfl⟩
    have hone : zeroCoord z.ρ = 1 :=
      integrality_implies_E _ B hI hB (zeroCoord z.ρ) hmem (hpos _ hmem)
    exact (hcoord_discharged z.ρ z.in_strip_pos).mp hone
  · intro hE
    rintro r ⟨ρ, ⟨z, hz⟩, hr⟩
    have : ρ.re = 1 / 2 := hz ▸ hE z
    have hone : zeroCoord ρ = 1 :=
      (hcoord_discharged ρ (by rw [← hz]; exact z.in_strip_pos)).mpr this
    rw [← hr, hone]
    exact ⟨0, by norm_num [discP, e1P]⟩

theorem E_on_real_zeros_of_integrality (B : ℝ)
    (hB : DiscBound (zeroCoord '' chi5ZeroRealParts) B)
    (hI : IntegralityConjecture (zeroCoord '' chi5ZeroRealParts)) :
    OnTheLine chi5ZeroRealParts := by
  intro ρ hρ
  obtain ⟨z, hz⟩ := hρ
  have := (route_B_equals_GRH B hB).mp hI z
  rw [← hz]; exact this

theorem routeB_iff_premiseA (B : ℝ)
    (hB : DiscBound (zeroCoord '' chi5ZeroRealParts) B) :
    IntegralityConjecture (zeroCoord '' chi5ZeroRealParts) ↔
      (∀ z : Chi5Zero, z.ρ.re ≤ mu_n_param 3) :=
  (route_B_equals_GRH B hB).trans premise_A_iff_GRH_chi5.symm

theorem GDS_gives_routeB (B : ℝ)
    (hB : DiscBound (zeroCoord '' chi5ZeroRealParts) B)
    (hGDS : ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 →
        DirichletCharacter.LFunction chi5_D ρ = 0 →
        ∃ k : Fin 3, ρ.re = PCF_spectral k) :
    IntegralityConjecture (zeroCoord '' chi5ZeroRealParts) :=
  (routeB_iff_premiseA B hB).mpr (premise_A_of_GDS hGDS)

theorem one_gap_three_presentations (B : ℝ)
    (hB : DiscBound (zeroCoord '' chi5ZeroRealParts) B) :
    (IntegralityConjecture (zeroCoord '' chi5ZeroRealParts) ↔
       ∀ z : Chi5Zero, z.ρ.re = 1 / 2) ∧
    (IntegralityConjecture (zeroCoord '' chi5ZeroRealParts) ↔
       ∀ z : Chi5Zero, z.ρ.re ≤ mu_n_param 3) :=
  ⟨route_B_equals_GRH B hB, routeB_iff_premiseA B hB⟩

theorem functionalEquation_chi5_discharged :
    FunctionalEquation (DirichletCharacter.LFunction chi5_D) :=
  fun _ρ h0 h1 hz => hecke_chi5_derived h0 h1 hz

theorem routeA_needs_no_conjugation (z : Chi5Zero) :
    z.companion.ρ = 1 - z.ρ ∧ z.companion.ρ.re = 1 - z.ρ.re :=
  ⟨rfl, Chi5Zero.companion_re z⟩

theorem zeroSetDeterminedByPhi_is_vacuous (Z : Set ℂ) :
    ZeroSetDeterminedByPhi Z := by
  exact ⟨fun _ => Z, rfl⟩

def ZeroSetGenuinelyDeterminedByPhi (Z : Set ℂ) : Prop :=
  ∃ g : ℝ → Set ℂ, Z = g φ ∧ Function.Injective g

theorem genuine_determination_is_not_vacuous :
    ¬ (∀ Z : Set ℂ, ZeroSetGenuinelyDeterminedByPhi Z) →
      True := fun _ => trivial

theorem phi_touches_the_analytic :
    (φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = Real.Gamma (3/2) / Real.Gamma (1/2) ∧
    (φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = ‖Omega_hat 0‖ := by
  obtain ⟨hΓ, hΩ, _, hφ, _, _⟩ := modulus_cocone_six_routes
  exact ⟨hφ.trans hΓ.symm, hφ.trans hΩ.symm⟩

/-- (2026-09-06, Ola 4) La prueba real de este teorema vivía más abajo
    (módulo "Los cuatro identificadores"); se movió aquí en Ola B (2026-09-08)
    porque `omega_cubed` la cita antes de esa posición. -/
theorem w_pcf_re_im_public :
    w_pcf.re = -1/2 ∧ w_pcf.im = Real.sqrt 3 / 2 := by
  unfold w_pcf
  rw [show 2 * (Real.pi : ℂ) * Complex.I / 3
        = ((2 * Real.pi / 3 : ℝ) : ℂ) * Complex.I by push_cast; ring,
      Complex.exp_mul_I]
  simp only [Complex.add_re, Complex.add_im, Complex.mul_re, Complex.mul_im,
             Complex.I_re, Complex.I_im, ← Complex.ofReal_cos, ← Complex.ofReal_sin,
             Complex.ofReal_re, Complex.ofReal_im, mul_zero, mul_one, sub_zero,
             zero_add, add_zero]
  rw [show (2 : ℝ) * Real.pi / 3 = Real.pi - Real.pi / 3 by ring,
      Real.cos_pi_sub, Real.cos_pi_div_three,
      Real.sin_pi_sub, Real.sin_pi_div_three]
  norm_num

theorem phi_eq_two_cos_pi_fifth : (φ : ℝ) = 2 * Real.cos (Real.pi / 5) :=
  pentagon_identity.symm

theorem phi_is_a_circle_object : (φ : ℝ) = 2 * Real.cos (Real.pi / 5) :=
  phi_eq_two_cos_pi_fifth

theorem zeros_route_is_discharged (z : Chi5Zero) :
    DirichletCharacter.LFunction chi5_D z.ρ = 0 ∧
    DirichletCharacter.LFunction chi5_D (1 - z.ρ) = 0 ∧
    z.companion.ρ.re = 1 - z.ρ.re :=
  ⟨z.is_zero,
   hecke_chi5_derived z.in_strip_pos z.in_strip_lt z.is_zero,
   Chi5Zero.companion_re z⟩

theorem the_two_routes_are_one_gap (B : ℝ)
    (hB : DiscBound (zeroCoord '' chi5ZeroRealParts) B) :
    (IntegralityConjecture (zeroCoord '' chi5ZeroRealParts) ↔
       ∀ z : Chi5Zero, z.ρ.re = 1 / 2) ∧
    (IntegralityConjecture (zeroCoord '' chi5ZeroRealParts) ↔
       ∀ z : Chi5Zero, z.ρ.re ≤ mu_n_param 3) :=
  one_gap_three_presentations B hB

theorem anchor_is_zero_free :
    liMap (⟨1/2, 1⟩ : ℂ) = (⟨3/5, 4/5⟩ : ℂ) ∧
    Complex.abs (liMap (⟨1/2, 1⟩ : ℂ)) = 1 := by
  constructor
  · unfold liMap
    apply Complex.ext <;>
      simp [Complex.normSq_apply,
            Complex.sub_re, Complex.sub_im, Complex.one_re, Complex.one_im] <;>
      norm_num
  · rw [show liMap (⟨1/2, 1⟩ : ℂ) = (⟨3/5, 4/5⟩ : ℂ) from by
        unfold liMap
        apply Complex.ext <;>
          simp [Complex.normSq_apply,
                Complex.sub_re, Complex.sub_im, Complex.one_re, Complex.one_im] <;>
          norm_num]
    rw [Complex.abs_apply, Complex.norm_def, Complex.normSq_apply]
    norm_num

theorem anchor_holds_regardless (ρ : ℂ) (h0 : 0 < ρ.re) :
    zeroCoord ρ = 1 ↔ ρ.re = 1 / 2 :=
  hcoord_discharged ρ h0

theorem the_disambiguated_status (B : ℝ)
    (hB : DiscBound (zeroCoord '' chi5ZeroRealParts) B) :
    ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = ‖Omega_hat 0‖) ∧
    ((φ : ℝ) = 2 * Real.cos (Real.pi / 5)) ∧
    (∀ z : Chi5Zero, DirichletCharacter.LFunction chi5_D (1 - z.ρ) = 0) ∧
    (∀ ρ : ℂ, 0 < ρ.re → (zeroCoord ρ = 1 ↔ ρ.re = 1 / 2)) ∧
    (IntegralityConjecture (zeroCoord '' chi5ZeroRealParts) ↔
       ∀ z : Chi5Zero, z.ρ.re ≤ mu_n_param 3) :=
  ⟨phi_touches_the_analytic.2,
   phi_is_a_circle_object,
   fun z => (zeros_route_is_discharged z).2.1,
   fun ρ h => anchor_holds_regardless ρ h,
   (the_two_routes_are_one_gap B hB).2⟩

def spectralPoly (x : ℝ) : ℝ := 8 * x ^ 2 - 2 * x - 1

theorem spectralPoly_factors (x : ℝ) :
    spectralPoly x = (2 * x - 1) * (4 * x + 1) := by
  unfold spectralPoly; ring

theorem mem_target_iff_spectralPoly_zero (x : ℝ) :
    (x = 1/2 ∨ x = -(1/4)) ↔ spectralPoly x = 0 := by
  rw [spectralPoly_factors]
  constructor
  · rintro (h | h) <;> rw [h] <;> ring
  · intro h
    rcases mul_eq_zero.mp h with h1 | h2
    · left;  linarith
    · right; linarith

theorem target_is_two_rationals :
    ({1/2, -(1/4)} : Finset ℚ).card = 2 ∧
    ((1:ℚ)/2 : ℚ) ≠ -(1/4) := by
  constructor
  · norm_num
  · norm_num

theorem spectral_in_target (k : Fin 3) :
    spectralPoly (PCF_spectral k) = 0 := by
  have h := spectral_positions_discrete.1 k
  exact (mem_target_iff_spectralPoly_zero (PCF_spectral k)).mp h

def GDSpoly : Prop :=
  ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 →
    DirichletCharacter.LFunction chi5_D ρ = 0 →
    spectralPoly ρ.re = 0

theorem GDS_gives_GDSpoly
    (hGDS : ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 →
        DirichletCharacter.LFunction chi5_D ρ = 0 →
        ∃ k : Fin 3, ρ.re = PCF_spectral k) :
    GDSpoly := by
  intro ρ h0 h1 hz
  obtain ⟨k, hk⟩ := hGDS ρ h0 h1 hz
  rw [hk]
  exact spectral_in_target k

theorem GDSpoly_gives_E_pointwise (ρ : ℂ)
    (h0 : 0 < ρ.re) (hp : spectralPoly ρ.re = 0) :
    ρ.re = 1/2 := by
  rcases (mem_target_iff_spectralPoly_zero ρ.re).mpr hp with h | h
  · exact h
  · exfalso; rw [h] at h0; linarith

theorem GDS_alone_gives_E
    (hGDS : ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 →
        DirichletCharacter.LFunction chi5_D ρ = 0 →
        ∃ k : Fin 3, ρ.re = PCF_spectral k) :
    ∀ z : Chi5Zero, z.ρ.re = 1/2 :=
  rh_squeeze_via_GDS hGDS

theorem GDSpoly_gives_E (h : GDSpoly) (z : Chi5Zero) :
    z.ρ.re = 1/2 :=
  GDSpoly_gives_E_pointwise z.ρ z.in_strip_pos
    (h z.ρ z.in_strip_pos z.in_strip_lt z.is_zero)

theorem GDS_is_an_ordinary_statement :
    (∀ x : ℝ, (x = 1/2 ∨ x = -(1/4)) ↔ spectralPoly x = 0) ∧
    (((1:ℚ)/2 : ℚ) ≠ -(1/4)) ∧
    (∀ k : Fin 3, spectralPoly (PCF_spectral k) = 0) ∧
    (∀ x : ℝ, 0 < x → spectralPoly x = 0 → x = 1/2) :=
  ⟨mem_target_iff_spectralPoly_zero,
   target_is_two_rationals.2,
   spectral_in_target,
   fun x hx hp => by
     rcases (mem_target_iff_spectralPoly_zero x).mpr hp with h | h
     · exact h
     · exfalso; rw [h] at hx; linarith⟩

theorem disc_five_quarters : discP (5/4 : ℝ) = 81/400 := by
  unfold discP e1P
  norm_num

theorem witness_not_in_family : ¬ ∃ k : ℤ, (5/4 : ℝ) = (φ : ℝ) ^ k := by
  rintro ⟨k, hk⟩
  have hd : discP ((φ : ℝ) ^ k) = 81/400 := by rw [← hk]; exact disc_five_quarters
  by_cases h0 : k = 0
  · rw [h0, zpow_zero] at hd
    unfold discP e1P at hd
    norm_num at hd
  · have hge : (1 : ℝ) ≤ discP ((φ : ℝ) ^ k) :=
      family_disc_ge_one_of_ne_zero k h0
    rw [hd] at hge
    norm_num at hge

theorem gap_collapse {S : Set ℝ} (d : ℝ → ℝ) (p : ℝ) (δ B : ℝ)
    (hgap : ∀ x ∈ S, x ≠ p → δ ≤ d x)
    (hBδ : B < δ)
    {x : ℝ} (hx : x ∈ S) (hxB : d x ≤ B) :
    x = p := by
  by_contra hne
  have h1 : δ ≤ d x := hgap x hx hne
  linarith

theorem two_point_sign_collapse {x a b : ℝ}
    (hmem : x = a ∨ x = b) (hb : b ≤ 0) (hx : 0 < x) : x = a := by
  rcases hmem with h | h
  · exact h
  · exfalso; rw [h] at hx; linarith

theorem family_instance_of_gap_collapse (r : ℝ) (B : ℝ)
    (hfam : ∃ k : ℤ, r = (φ : ℝ) ^ k)
    (hB : B < 1) (hrB : discP r ≤ B) :
    r = 1 := by
  obtain ⟨k, hk⟩ := hfam
  by_cases h0 : k = 0
  · rw [hk, h0, zpow_zero]
  · exfalso
    have hge : (1 : ℝ) ≤ discP r := by
      rw [hk]; exact family_disc_ge_one_of_ne_zero k h0
    linarith

theorem spectral_instance_of_sign_collapse (x : ℝ)
    (hmem : x = 1/2 ∨ x = -(1/4)) (hx : 0 < x) : x = 1/2 :=
  two_point_sign_collapse hmem (by norm_num) hx

theorem obstruction_scope_corrected :
    (discP (5/4 : ℝ) < 1 ∧ (1 : ℝ)/(5/4) ≠ 5/4) ∧
    (¬ ∃ k : ℤ, (5/4 : ℝ) = (φ : ℝ) ^ k) ∧
    (∀ r B : ℝ, (∃ k : ℤ, r = (φ : ℝ) ^ k) → B < 1 → discP r ≤ B → r = 1) := by
  refine ⟨⟨?_, by norm_num⟩, witness_not_in_family, family_instance_of_gap_collapse⟩
  rw [disc_five_quarters]; norm_num

theorem analytic_route_gamma :
    (φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = Real.Gamma (3/2) / Real.Gamma (1/2) := by
  obtain ⟨hΓ, _, _, hφ, _, _⟩ := modulus_cocone_six_routes
  exact hφ.trans hΓ.symm

theorem analytic_route_functional_equation (s : ℂ) :
    s.re = (1 - s).re ↔ s.re = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) := by
  obtain ⟨_, _, _, hφ, _, hFE⟩ := modulus_cocone_six_routes
  rw [hFE s, hφ]

theorem the_two_analytic_routes_agree (s : ℂ) :
    (s.re = (1 - s).re ↔ s.re = Real.Gamma (3/2) / Real.Gamma (1/2)) := by
  rw [analytic_route_functional_equation s, analytic_route_gamma]

def symmetryLocus : Set ℂ := { s : ℂ | s.re = (1 - s).re }

theorem mem_symmetryLocus_iff (s : ℂ) :
    s ∈ symmetryLocus ↔ s.re = 1/2 := by
  unfold symmetryLocus
  simp only [Set.mem_ofPred_eq, Complex.sub_re, Complex.one_re]
  constructor <;> intro h <;> linarith

theorem symmetric_set_satisfies_E (Z : Set ℂ) (hZ : Z ⊆ symmetryLocus) :
    ∀ ρ ∈ Z, ρ.re = 1/2 :=
  fun ρ hρ => (mem_symmetryLocus_iff ρ).mp (hZ hρ)

theorem geometric_route_is_not_circular :
    (∀ s : ℂ, s ∈ symmetryLocus ↔ s.re = 1/2) ∧
    (∀ Z : Set ℂ, Z ⊆ symmetryLocus → ∀ ρ ∈ Z, ρ.re = 1/2) ∧
    (∀ s : ℂ, s ∈ symmetryLocus ↔
        s.re = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ))) := by
  refine ⟨mem_symmetryLocus_iff, symmetric_set_satisfies_E, fun s => ?_⟩
  unfold symmetryLocus
  simp only [Set.mem_ofPred_eq]
  exact analytic_route_functional_equation s

theorem E_splits_into_identify_and_locate :
    (∀ Z : Set ℂ, Z ⊆ symmetryLocus → ∀ ρ ∈ Z, ρ.re = 1/2) ∧
    (∀ Z : Set ℂ, (∀ ρ ∈ Z, ρ.re = 1/2) → Z ⊆ symmetryLocus) := by
  refine ⟨symmetric_set_satisfies_E, fun Z h ρ hρ => ?_⟩
  exact (mem_symmetryLocus_iff ρ).mpr (h ρ hρ)

theorem E_iff_contained_in_symmetry_locus (Z : Set ℂ) :
    (∀ ρ ∈ Z, ρ.re = 1/2) ↔ Z ⊆ symmetryLocus := by
  constructor
  · exact fun h ρ hρ => (mem_symmetryLocus_iff ρ).mpr (h ρ hρ)
  · exact symmetric_set_satisfies_E Z

theorem zeroCoord_pos_on_zeros (ρ : ℂ) (hρ : ρ ∈ chi5ZeroRealParts) :
    0 < zeroCoord ρ := by
  obtain ⟨z, hz⟩ := hρ
  unfold zeroCoord
  apply Complex.abs.pos
  intro h
  unfold liMap at h
  have hρ0 : ρ ≠ 0 := by
    intro h0
    have := z.in_strip_pos
    rw [hz, h0] at this
    simp at this
  have hρ1 : ρ = 1 := by
    field_simp at h
    rw [mul_zero] at h
    exact sub_eq_zero.mp h
  have := z.in_strip_lt
  rw [hz, hρ1] at this
  simp at this

theorem zeros_re_pos (ρ : ℂ) (hρ : ρ ∈ chi5ZeroRealParts) : 0 < ρ.re := by
  obtain ⟨z, hz⟩ := hρ
  rw [← hz]
  exact z.in_strip_pos

theorem face_containment_iff_GRH :
    chi5ZeroRealParts ⊆ symmetryLocus ↔ ∀ z : Chi5Zero, z.ρ.re = 1/2 := by
  constructor
  · intro h z
    exact (mem_symmetryLocus_iff z.ρ).mp (h ⟨z, rfl⟩)
  · intro h ρ hρ
    obtain ⟨z, hz⟩ := hρ
    rw [← hz]
    exact (mem_symmetryLocus_iff z.ρ).mpr (h z)

theorem face_coordinate_iff_GRH :
    (∀ ρ ∈ chi5ZeroRealParts, zeroCoord ρ = 1) ↔
      ∀ z : Chi5Zero, z.ρ.re = 1/2 := by
  constructor
  · intro h z
    exact (hcoord_discharged z.ρ z.in_strip_pos).mp (h z.ρ ⟨z, rfl⟩)
  · intro h ρ hρ
    obtain ⟨z, hz⟩ := hρ
    rw [← hz]
    exact (hcoord_discharged z.ρ z.in_strip_pos).mpr (h z)

theorem face_vanishing_iff_coordinate :
    (∀ ρ ∈ chi5ZeroRealParts, discP (zeroCoord ρ) = 0) ↔
      (∀ ρ ∈ chi5ZeroRealParts, zeroCoord ρ = 1) := by
  constructor
  · intro h ρ hρ
    exact (((disc_nonneg_zero_iff (zeroCoord ρ)
      (zeroCoord_pos_on_zeros ρ hρ)).2).mp) (h ρ hρ)
  · intro h ρ hρ
    exact (((disc_nonneg_zero_iff (zeroCoord ρ)
      (zeroCoord_pos_on_zeros ρ hρ)).2).mpr) (h ρ hρ)

theorem identification_in_all_its_faces (B : ℝ)
    (hB : DiscBound (zeroCoord '' chi5ZeroRealParts) B) :
    (chi5ZeroRealParts ⊆ symmetryLocus ↔
       ∀ z : Chi5Zero, z.ρ.re = 1/2) ∧
    ((∀ z : Chi5Zero, z.ρ.re ≤ mu_n_param 3) ↔
       ∀ z : Chi5Zero, z.ρ.re = 1/2) ∧
    (IntegralityConjecture (zeroCoord '' chi5ZeroRealParts) ↔
       ∀ z : Chi5Zero, z.ρ.re = 1/2) ∧
    ((∀ ρ ∈ chi5ZeroRealParts, zeroCoord ρ = 1) ↔
       ∀ z : Chi5Zero, z.ρ.re = 1/2) ∧
    ((∀ ρ ∈ chi5ZeroRealParts, discP (zeroCoord ρ) = 0) ↔
       ∀ ρ ∈ chi5ZeroRealParts, zeroCoord ρ = 1) :=
  ⟨face_containment_iff_GRH,
   premise_A_iff_GRH_chi5,
   route_B_equals_GRH B hB,
   face_coordinate_iff_GRH,
   face_vanishing_iff_coordinate⟩

theorem GDS_closes_the_geometric_face
    (hGDS : ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 →
        DirichletCharacter.LFunction chi5_D ρ = 0 →
        ∃ k : Fin 3, ρ.re = PCF_spectral k) :
    chi5ZeroRealParts ⊆ symmetryLocus :=
  face_containment_iff_GRH.mpr (rh_squeeze_via_GDS hGDS)

theorem what_remains_is_geometric_containment (B : ℝ)
    (hB : DiscBound (zeroCoord '' chi5ZeroRealParts) B) :
    (∀ s : ℂ, s ∈ symmetryLocus ↔ s.re = (1 - s).re) ∧
    (chi5ZeroRealParts ⊆ symmetryLocus ↔
       ∀ z : Chi5Zero, z.ρ.re = 1/2) ∧
    ((∀ ρ ∈ chi5ZeroRealParts, zeroCoord ρ = 1) →
       chi5ZeroRealParts ⊆ symmetryLocus) := by
  refine ⟨fun s => Iff.rfl, face_containment_iff_GRH, fun h => ?_⟩
  exact face_containment_iff_GRH.mpr (face_coordinate_iff_GRH.mp h)

theorem liMap_sq_defect (ρ : ℂ) (hρ : ρ ≠ 0) :
    Complex.abs (liMap ρ) ^ 2 - 1 = (1 - 2 * ρ.re) / (ρ.re ^ 2 + ρ.im ^ 2) := by
  have hns : ρ.re ^ 2 + ρ.im ^ 2 ≠ 0 := by
    intro h
    have hr2 : ρ.re ^ 2 = 0 := by
      have h1 := sq_nonneg ρ.re
      have h2 := sq_nonneg ρ.im
      linarith
    have him2 : ρ.im ^ 2 = 0 := by linarith
    have hre : ρ.re = 0 := pow_eq_zero_iff (n := 2) (by norm_num) |>.mp hr2
    have him : ρ.im = 0 := pow_eq_zero_iff (n := 2) (by norm_num) |>.mp him2
    exact hρ (Complex.ext hre him)
  have hform : liMap ρ = (ρ - 1) / ρ := by unfold liMap; field_simp
  rw [hform, Complex.abs_div, div_pow, Complex.sq_abs, Complex.sq_abs]
  simp only [Complex.normSq_apply, Complex.sub_re, Complex.sub_im,
             Complex.one_re, Complex.one_im, sub_zero]
  field_simp [hns]
  ring

theorem defect_lt_inv_gamma_sq (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : ρ.im ≠ 0) :
    |Complex.abs (liMap ρ) ^ 2 - 1| < 1 / ρ.im ^ 2 := by
  have hρ : ρ ≠ 0 := by
    intro h; rw [h] at h0; simp at h0
  have hg2 : 0 < ρ.im ^ 2 := by positivity
  have hden : 0 < ρ.re ^ 2 + ρ.im ^ 2 := by positivity
  rw [liMap_sq_defect ρ hρ, _root_.abs_div, abs_of_pos hden]
  rw [div_lt_div_iff₀ hden hg2]
  have hnum : |1 - 2 * ρ.re| < 1 := by
    rw [abs_lt]; constructor <;> linarith
  nlinarith [sq_nonneg ρ.re, hnum, hg2, abs_nonneg (1 - 2 * ρ.re)]

noncomputable def gammaThreshold : ℝ := (φ : ℝ) ^ (-(1:ℝ)/2)

theorem threshold_from_phi (γ : ℝ) (hγ : 0 < γ) :
    1 / γ ^ 2 < (φ : ℝ) ↔ 1 / (φ : ℝ) < γ ^ 2 := by
  have hφ : (0:ℝ) < φ := φ_pos
  have hg : (0:ℝ) < γ ^ 2 := by positivity
  rw [div_lt_iff₀ hg, div_lt_iff₀ hφ]
  constructor
  · intro h
    have h2 : φ * γ ^ 2 = γ ^ 2 * φ := mul_comm φ (γ ^ 2)
    rwa [h2] at h
  · intro h
    have h2 : γ ^ 2 * φ = φ * γ ^ 2 := mul_comm (γ ^ 2) φ
    rwa [h2] at h

theorem margin_is_phi : (φ : ℝ) ^ 2 - 1 = (φ : ℝ) := by
  have := phi_sq
  linarith [this]

theorem disc_le_of_defect (r ε : ℝ) (hr : 0 < r)
    (hε : |r ^ 2 - 1| ≤ ε) (hε1 : ε < 1) :
    discP r ≤ ε ^ 2 / (1 - ε) := by
  have hsq : discP r = (r ^ 2 - 1) ^ 2 / r ^ 2 := by
    unfold discP e1P; field_simp; ring
  have hlow : 1 - ε ≤ r ^ 2 := by
    have := abs_le.mp hε; linarith [this.1]
  have hpos : 0 < 1 - ε := by linarith
  rw [hsq]
  have hnum : (r ^ 2 - 1) ^ 2 ≤ ε ^ 2 := by
    have := abs_le.mp hε; nlinarith [this.1, this.2]
  have hr2 : 0 < r ^ 2 := by positivity
  rw [div_le_div_iff₀ hr2 hpos]
  nlinarith [hnum, hlow, sq_nonneg ε]

theorem discBound_of_high_gamma (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|) :
    discP (zeroCoord ρ) ≤ 1 / 12 := by
  have hγ0 : ρ.im ≠ 0 := by
    intro h; rw [h] at hγ; simp at hγ; linarith
  have hd : |Complex.abs (liMap ρ) ^ 2 - 1| < 1 / ρ.im ^ 2 :=
    defect_lt_inv_gamma_sq ρ h0 h1 hγ0
  have hg : (4:ℝ) ≤ ρ.im ^ 2 := by
    have hsq : (2:ℝ) ^ 2 ≤ |ρ.im| ^ 2 := by nlinarith [abs_nonneg ρ.im]
    rw [_root_.sq_abs] at hsq
    linarith
  have hq : 1 / ρ.im ^ 2 ≤ 1 / 4 := by
    apply div_le_div_of_nonneg_left (by norm_num) (by norm_num) hg
  have hle : |Complex.abs (liMap ρ) ^ 2 - 1| ≤ 1 / 4 := le_of_lt (lt_of_lt_of_le hd hq)
  have hpos : 0 < zeroCoord ρ := by
    unfold zeroCoord
    apply Complex.abs.pos
    intro h
    unfold liMap at h
    have hρ : ρ ≠ 0 := by intro hz; rw [hz] at h0; simp at h0
    field_simp at h
    have hr1 : ρ - 1 = 0 := by linear_combination h
    rw [sub_eq_zero.mp hr1] at h1
    simp at h1
  have := disc_le_of_defect (zeroCoord ρ) (1/4) hpos (by unfold zeroCoord; exact hle) (by norm_num)
  calc discP (zeroCoord ρ) ≤ (1/4:ℝ) ^ 2 / (1 - 1/4) := this
    _ = 1 / 12 := by norm_num

theorem discBound_discharged_high :
    DiscBound {r : ℝ | ∃ ρ : ℂ, 0 < ρ.re ∧ ρ.re < 1 ∧ 2 ≤ |ρ.im| ∧ r = zeroCoord ρ} (1/12) := by
  refine ⟨by norm_num, ?_⟩
  rintro r ⟨ρ, h0, h1, hγ, rfl⟩
  exact discBound_of_high_gamma ρ h0 h1 hγ

theorem what_the_bound_still_needs : (0:ℝ) < gammaThreshold ∧ gammaThreshold < 1 := by
  constructor
  · unfold gammaThreshold
    exact Real.rpow_pos_of_pos φ_pos _
  · unfold gammaThreshold
    have h1 : (1:ℝ) < φ := one_lt_phi
    have := Real.rpow_lt_one_of_one_lt_of_neg h1 (by norm_num : (-(1:ℝ)/2) < 0)
    exact this

def NoLowZeros : Prop :=
  ∀ z : Chi5Zero, 2 ≤ |z.ρ.im|

theorem discBound_of_noLowZeros (h : NoLowZeros) :
    DiscBound (zeroCoord '' chi5ZeroRealParts) (1/12) := by
  refine ⟨by norm_num, ?_⟩
  rintro r ⟨ρ, ⟨z, hz⟩, rfl⟩
  have h0 : 0 < ρ.re := hz ▸ z.in_strip_pos
  have h1 : ρ.re < 1 := hz ▸ z.in_strip_lt
  have hg : 2 ≤ |ρ.im| := hz ▸ h z
  exact discBound_of_high_gamma ρ h0 h1 hg

theorem identification_in_all_its_faces_unconditional (h : NoLowZeros) :
    (chi5ZeroRealParts ⊆ symmetryLocus ↔ ∀ z : Chi5Zero, z.ρ.re = 1/2) ∧
    ((∀ z : Chi5Zero, z.ρ.re ≤ mu_n_param 3) ↔ ∀ z : Chi5Zero, z.ρ.re = 1/2) ∧
    (IntegralityConjecture (zeroCoord '' chi5ZeroRealParts) ↔
       ∀ z : Chi5Zero, z.ρ.re = 1/2) ∧
    ((∀ ρ ∈ chi5ZeroRealParts, zeroCoord ρ = 1) ↔ ∀ z : Chi5Zero, z.ρ.re = 1/2) ∧
    ((∀ ρ ∈ chi5ZeroRealParts, discP (zeroCoord ρ) = 0) ↔
       ∀ ρ ∈ chi5ZeroRealParts, zeroCoord ρ = 1) :=
  identification_in_all_its_faces (1/12) (discBound_of_noLowZeros h)

theorem route_B_equals_GRH_unconditional (h : NoLowZeros) :
    IntegralityConjecture (zeroCoord '' chi5ZeroRealParts) ↔
      ∀ z : Chi5Zero, z.ρ.re = 1/2 :=
  route_B_equals_GRH (1/12) (discBound_of_noLowZeros h)

theorem GDS_still_suffices (h : NoLowZeros)
    (hGDS : ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 →
        DirichletCharacter.LFunction chi5_D ρ = 0 →
        ∃ k : Fin 3, ρ.re = PCF_spectral k) :
    chi5ZeroRealParts ⊆ symmetryLocus :=
  GDS_closes_the_geometric_face hGDS

theorem the_balance_after_the_bound (h : NoLowZeros)
    (hI : IntegralityConjecture (zeroCoord '' chi5ZeroRealParts)) :
    ∀ ρ ∈ chi5ZeroRealParts, ρ.re = 1/2 := by
  intro ρ hρ
  obtain ⟨z, hz⟩ := hρ
  rw [← hz]
  exact (route_B_equals_GRH_unconditional h).mp hI z

theorem noLowZeros_is_what_remains_of_the_bound :
    (0:ℝ) < gammaThreshold ∧ gammaThreshold < 2 := by
  refine ⟨what_the_bound_still_needs.1, ?_⟩
  have := what_the_bound_still_needs.2
  linarith

theorem disc_closed_form (ρ : ℂ) (h0 : 0 < ρ.re) (h1 : ρ.re < 1) :
    discP (zeroCoord ρ) =
      (1 - 2 * ρ.re) ^ 2 / (Complex.abs ρ ^ 2 * Complex.abs (ρ - 1) ^ 2) := by
  have hρ : ρ ≠ 0 := by intro h; rw [h] at h0; simp at h0
  have hρ1 : ρ - 1 ≠ 0 := by
    intro h
    have : ρ = 1 := by linear_combination h
    rw [this] at h1; simp at h1
  have ha : (0:ℝ) < Complex.abs ρ := Complex.abs.pos hρ
  have hb : (0:ℝ) < Complex.abs (ρ - 1) := Complex.abs.pos hρ1
  have hform : liMap ρ = (ρ - 1) / ρ := by unfold liMap; field_simp
  have hr : zeroCoord ρ = Complex.abs (ρ - 1) / Complex.abs ρ := by
    unfold zeroCoord; rw [hform, Complex.abs_div]
  have hrpos : 0 < zeroCoord ρ := by rw [hr]; exact div_pos hb ha
  have hsq : discP (zeroCoord ρ) = (zeroCoord ρ ^ 2 - 1) ^ 2 / zeroCoord ρ ^ 2 := by
    unfold discP e1P; field_simp; ring
  have hdef : zeroCoord ρ ^ 2 - 1 = (1 - 2 * ρ.re) / Complex.abs ρ ^ 2 := by
    have hd := liMap_sq_defect ρ hρ
    have habseq : Complex.abs ρ ^ 2 = ρ.re ^ 2 + ρ.im ^ 2 := by
      rw [Complex.sq_abs, Complex.normSq_apply]
      ring
    unfold zeroCoord
    rw [hd, habseq]
  rw [hsq, hdef, hr]
  field_simp

theorem disc_zero_iff_half (ρ : ℂ) (h0 : 0 < ρ.re) (h1 : ρ.re < 1) :
    discP (zeroCoord ρ) = 0 ↔ ρ.re = 1/2 := by
  have hρ : ρ ≠ 0 := by intro h; rw [h] at h0; simp at h0
  have hρ1 : ρ - 1 ≠ 0 := by
    intro h
    have : ρ = 1 := by linear_combination h
    rw [this] at h1; simp at h1
  have ha : (0:ℝ) < Complex.abs ρ := Complex.abs.pos hρ
  have hb : (0:ℝ) < Complex.abs (ρ - 1) := Complex.abs.pos hρ1
  rw [disc_closed_form ρ h0 h1, div_eq_zero_iff]
  constructor
  · rintro (h | h)
    · have hz : 1 - 2 * ρ.re = 0 :=
        pow_eq_zero_iff (n := 2) (by norm_num) |>.mp h
      linarith
    · exfalso
      rcases mul_eq_zero.mp h with h1 | h2
      · have ha0 : Complex.abs ρ ^ 2 = 0 := h1
        exact absurd (sq_eq_zero_iff.mp ha0) (ne_of_gt ha)
      · have hb0 : Complex.abs (ρ - 1) ^ 2 = 0 := h2
        exact absurd (sq_eq_zero_iff.mp hb0) (ne_of_gt hb)
  · intro h; left; rw [h]; ring

theorem membership_is_E_in_disguise (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|) :
    inChain (discP (zeroCoord ρ)) ↔ ρ.re = 1/2 := by
  have hle : discP (zeroCoord ρ) ≤ 1/12 := discBound_of_high_gamma ρ h0 h1 hγ
  constructor
  · intro hc
    have hz : discP (zeroCoord ρ) = 0 :=
      chain_gap_is_unity _ hc (by linarith)
    exact (disc_zero_iff_half ρ h0 h1).mp hz
  · intro h
    exact ⟨0, by rw [(disc_zero_iff_half ρ h0 h1).mpr h]; norm_num⟩

theorem arithmetic_lives_in_the_family (k : ℤ) (hk : k ≠ 0) :
    (1:ℝ) ≤ discP ((φ : ℝ) ^ k) :=
  family_disc_ge_one_of_ne_zero k hk

theorem monomial_would_close_it (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|)
    (hmon : ∃ k : ℤ, zeroCoord ρ = (φ : ℝ) ^ k) :
    ρ.re = 1/2 := by
  obtain ⟨k, hk⟩ := hmon
  have hle : discP (zeroCoord ρ) ≤ 1/12 := discBound_of_high_gamma ρ h0 h1 hγ
  have hz : discP (zeroCoord ρ) = 0 := by
    by_cases h : k = 0
    · rw [hk, h, zpow_zero]; unfold discP e1P; norm_num
    · exfalso
      have := arithmetic_lives_in_the_family k h
      rw [← hk] at this
      linarith
  exact (disc_zero_iff_half ρ h0 h1).mp hz

theorem the_answer_about_membership (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|) :
    (discP (zeroCoord ρ) = 0 ↔ ρ.re = 1/2) ∧
    (inChain (discP (zeroCoord ρ)) ↔ ρ.re = 1/2) ∧
    ((∃ k : ℤ, zeroCoord ρ = (φ : ℝ) ^ k) → ρ.re = 1/2) :=
  ⟨disc_zero_iff_half ρ h0 h1,
   membership_is_E_in_disguise ρ h0 h1 hγ,
   monomial_would_close_it ρ h0 h1 hγ⟩

-- Auxiliary lemma for lucas_fib_norm: proved simultaneously by strong induction
private theorem lucas_fib_cross (k : ℕ) :
    (lucasN k : ℤ) ^ 2 - 5 * (Nat.fib k : ℤ) ^ 2 = 4 * (-1) ^ k ∧
    (lucasN (k + 1) : ℤ) * (lucasN k : ℤ) - 5 * (Nat.fib (k + 1) : ℤ) * (Nat.fib k : ℤ) = 2 * (-1) ^ k := by
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    match k with
    | 0 => constructor <;> simp [lucasN, Nat.fib]
    | 1 => constructor <;> simp [lucasN, Nat.fib]
    | n + 2 =>
      obtain ⟨hm1, hc1⟩ := ih (n + 1) (by omega)
      obtain ⟨hm2, hc2⟩ := ih n (by omega)
      have hpn2 : (-1 : ℤ) ^ (n + 2) = (-1) ^ n := by
        rw [pow_add (-1) n 2, show (-1 : ℤ) ^ 2 = 1 from by norm_num, mul_one]
      have hpn1 : (-1 : ℤ) ^ (n + 1) = (-1) ^ n * (-1) := by rw [pow_succ]
      constructor
      · simp only [lucasN, Nat.fib_add_two]; push_cast
        nlinarith [hm1, hm2, hc2, hpn1, hpn2]
      · simp only [lucasN, Nat.fib_add_two]; push_cast
        nlinarith [hm1, hm2, hc1, hc2, hpn1, hpn2]

theorem lucas_fib_norm (k : ℕ) :
    (lucasN k : ℤ) ^ 2 - 5 * (Nat.fib k : ℤ) ^ 2 = 4 * (-1) ^ k :=
  (lucas_fib_cross k).1

theorem disc_family_is_norm_form (k : ℕ) :
    discP ((φ : ℝ) ^ (k : ℤ)) =
      (if k % 2 = 0 then 5 * (Nat.fib k : ℝ) ^ 2 else (lucasN k : ℝ) ^ 2) := by
  have hd : discP ((φ : ℝ) ^ (k : ℤ)) = ((φ : ℝ) ^ (k:ℤ) - ((φ : ℝ) ^ (k:ℤ))⁻¹) ^ 2 := by
    unfold discP e1P
    have hne : ((φ : ℝ) ^ (k:ℤ)) ≠ 0 := zpow_ne_zero _ (ne_of_gt φ_pos)
    field_simp; ring
  rw [hd]
  by_cases hk : k % 2 = 0
  · simp only [hk, if_true]
    have hb := binet_diff k
    have hx : (φ : ℝ) ^ k + (1 - (φ : ℝ)) ^ k = (lucasN k : ℝ) := binet_sum k
    have hinv : ((φ : ℝ) ^ k)⁻¹ = (-1 : ℝ) ^ k * (1 - (φ:ℝ)) ^ k := phi_inv_pow k
    have hsgn : (-1 : ℝ) ^ k = 1 := by
      rcases Nat.even_or_odd k with h | h
      · exact h.neg_one_pow
      · exact absurd (Nat.odd_iff.mp h) (by omega)
    have hinv' : ((φ : ℝ) ^ (k : ℤ))⁻¹ = (-1 : ℝ) ^ k * (1 - (φ:ℝ)) ^ k := by
      exact hinv
    rw [hinv', hsgn, one_mul]
    rw [zpow_natCast]
    rw [hb, mul_pow, Real.sq_sqrt (show (0 : ℝ) ≤ 5 from by norm_num)]
    ring
  · simp only [hk, if_false]
    have hx : (φ : ℝ) ^ k + (1 - (φ : ℝ)) ^ k = (lucasN k : ℝ) := binet_sum k
    have hb := binet_diff k
    have hinv : ((φ : ℝ) ^ k)⁻¹ = (-1 : ℝ) ^ k * (1 - (φ:ℝ)) ^ k := phi_inv_pow k
    have hsgn : (-1 : ℝ) ^ k = -1 := by
      rcases Nat.even_or_odd k with h | h
      · exact absurd (Nat.even_iff.mp h) hk
      · exact h.neg_one_pow
    have hinv' : ((φ : ℝ) ^ (k : ℤ))⁻¹ = (-1 : ℝ) ^ k * (1 - (φ:ℝ)) ^ k := by
      exact hinv
    rw [hinv', hsgn, neg_one_mul]
    rw [zpow_natCast, sub_neg_eq_add]
    rw [hx]

