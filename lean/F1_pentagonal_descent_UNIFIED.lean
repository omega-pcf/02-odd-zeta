theorem the_six_components_and_the_single_gap
    (ρ : ℂ) (h₀ : ρ ≠ 0) (h₁ : ρ ≠ 1) (r : ℝ) (hr : 0 < r) (n : ℤ) (p : ℕ) :
    (Real.log (φ : ℝ) = 6 * Real.sqrt 3 * epsilon_0) ∧
    ((∃ k : ℤ, r = (φ : ℝ) ^ k) ↔ (∃ k : ℤ, valPhi r = (k : ℝ))) ∧
    (valPhi ((φ : ℝ) ^ n) = (n : ℝ)) ∧
    ((φ : ℝ) ^ ((p : ℤ) * n) = ((φ : ℝ) ^ n) ^ p) ∧
    (valPhi (r ^ p) = (p : ℝ) * valPhi r) ∧
    (∀ f : ℤ → ℤ, (∀ a b : ℤ, f (a + b) = f a + f b) → ∀ m : ℤ, f m = m * f 1) ∧
    (∀ x : ℝ, 0 < x → discP x ≤ 1/12 → ∀ j : ℤ, valPhi x = (j : ℝ) → x = 1) ∧
    (valPhi (zeroCoord ρ) =
      (Real.log (Complex.abs (ρ - 1)) - Real.log (Complex.abs ρ)) / Real.log (φ : ℝ)) :=
  ⟨eps0_relates_log_and_geometry,
   component_two_lattice r hr,
   component_two_faithful n,
   (component_four_action n p r hr).1,
   (component_four_action n p r hr).2,
   fun f hf m => component_five_uniqueness f hf m,
   fun x hx hd j hj => component_six_forced_value x hx hd j hj,
   the_numerator_that_must_land ρ h₀ h₁⟩

noncomputable def realDegree (z : Chi5Zero) : ℝ := valPhi (zeroCoord z.ρ)

theorem realDegree_explicit (z : Chi5Zero) :
    realDegree z =
      (Real.log (Complex.abs (z.ρ - 1)) - Real.log (Complex.abs z.ρ)) /
        Real.log (φ : ℝ) := by
  unfold realDegree
  apply the_numerator_that_must_land
  · intro h; have := z.in_strip_pos; rw [h] at this; simp at this
  · intro h; have := z.in_strip_lt; rw [h] at this; simp at this

def RealDegreeIsIntegral : Prop :=
  ∀ z : Chi5Zero, ∃ k : ℤ, realDegree z = (k : ℝ)

theorem hasDegree_iff_integral : HasDegree ↔ RealDegreeIsIntegral := by
  constructor
  · rintro ⟨deg, hdeg⟩ z
    refine ⟨deg z, ?_⟩
    unfold realDegree
    rw [← hdeg z, valPhi_realise]
  · intro h
    choose k hk using h
    refine ⟨k, fun z => ?_⟩
    have hpos : 0 < zeroCoord z.ρ := zeroCoord_pos_on_zeros z.ρ ⟨z, rfl⟩
    have := (monomial_iff_valPhi_int (zeroCoord z.ρ) hpos).mpr ⟨k z, hk z⟩
    obtain ⟨j, hj⟩ := this
    have hjk : (j : ℝ) = (k z : ℝ) := by
      rw [← valPhi_realise j, ← hj]; exact hk z
    have : j = k z := by exact_mod_cast hjk
    rw [← this, ← hj]

theorem integrality_means_identically_zero (z : Chi5Zero) (hγ : 2 ≤ |z.ρ.im|)
    (k : ℤ) (hk : realDegree z = (k : ℝ)) :
    realDegree z = 0 := by
  have hpos : 0 < zeroCoord z.ρ := zeroCoord_pos_on_zeros z.ρ ⟨z, rfl⟩
  have hle : discP (zeroCoord z.ρ) ≤ 1/12 :=
    discBound_of_high_gamma z.ρ z.in_strip_pos z.in_strip_lt hγ
  have h1 : zeroCoord z.ρ = 1 :=
    integrality_of_valuation_is_E (zeroCoord z.ρ) hpos hle k hk
  unfold realDegree
  rw [h1]
  unfold valPhi; simp

