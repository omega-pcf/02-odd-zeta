def LineCircleIdentity (m : ℂ → ℝ) : Prop :=
  ∀ ρ : ℂ, ρ ≠ 0 → (m ρ = 1 ↔ ρ.re = 1 / 2)

/-- **[P] LA IDENTIDAD VALE DENTRO Y FUERA.**  De ella se sigue tanto
