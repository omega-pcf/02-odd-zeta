  ⟨(unconditional_facts_about_a_zero z hγ).1,
   (unconditional_facts_about_a_zero z hγ).2.1,
   (unconditional_involution_facts z).1,
   (unconditional_involution_facts z).2.2,
   unconditional_valPhi_bound z hγ⟩

