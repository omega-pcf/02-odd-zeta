   BLOQUE 5 de 16 - PCF_golden_transform
   el dual, y que ve cada componente
   ===================================================================== -/


/-! ## 1.  El dual de la fibra -/

/-- La fibra, como exponente de `ζ₆`.  Por `the_deck_group_is_the_eisenstein_unit_group`
    ésta es la fibra `Colour × Orient` del paper. -/
abbrev Fib := Nat

/-- El carácter `k` del dual de `μ₆`, escrito por exponentes:
    `χ_k(n) = ζ₆^{k n}`, aquí `k·n mod 6`. -/
def chr (k n : Fib) : Nat := (k * n) % 6

/-- Los seis caracteres. -/
def dual6 : List Nat := [0, 1, 2, 3, 4, 5]

/-- Los seis puntos de la fibra. -/
def fib6 : List Nat := [0, 1, 2, 3, 4, 5]

/-! ## 2.  El hueco, en su forma más desnuda -/

/-- **[P] EL CARÁCTER TRIVIAL NO SEPARA NADA.**  `χ₀ ≡ 1`: los seis puntos
    de la fibra tienen el mismo valor.

    Ése es exactamente el contenido de `deck_invariant_is_level_function`
    escrito sobre el dual: un observable invariante de cubierta es el
    coeficiente `k = 0`, y el coeficiente `k = 0` es constante en la
    fibra. -/
theorem trivial_character_is_blind :
    fib6.all (fun n => chr 0 n == chr 0 0) = true := by decide

/-- **[P] Y NO ES QUE LA INFORMACIÓN NO ESTÉ: ESTÁ EN LOS OTROS CINCO.** -/
theorem the_other_five_are_not_blind :
    chr 1 0 ≠ chr 1 1 ∧ chr 2 0 ≠ chr 2 1 ∧ chr 3 0 ≠ chr 3 1 ∧
    chr 4 0 ≠ chr 4 1 ∧ chr 5 0 ≠ chr 5 1 := by decide

/-! ## 3.  El relleno: el dual completo SÍ separa -/

/-- **[P] EL DUAL DE `μ₆` SEPARA LA FIBRA.**  Para cualesquiera dos puntos
    distintos de la fibra hay un carácter que los distingue —de hecho
    `χ₁` los distingue siempre.

    **Ésta es la transformada que lee lo que Fourier no lee.**  No es un
    objeto exótico: es la transformada de Fourier del grupo correcto. -/
theorem dual_separates_the_fibre :
    ∀ a ∈ fib6, ∀ b ∈ fib6, a ≠ b → ∃ k ∈ dual6, chr k a ≠ chr k b := by
  decide

/-- **[P] E INVERSIÓN: EL CARÁCTER `χ₁` ES POR SÍ SOLO UN ISOMORFISMO.**
    `χ₁ = id` sobre la fibra, luego el punto se recupera de sus
    coeficientes.  (En la escritura compleja: `ζ₆` genera `μ₆`.) -/
theorem chi_one_is_the_identity : fib6.all (fun n => chr 1 n == n) = true := by
  decide

/-- **[P] LA CUENTA CUADRA.**  Seis caracteres, seis puntos: la
    transformada es cuadrada y sin pérdida. -/
theorem dual_and_fibre_have_the_same_size :
    dual6.length = 6 ∧ fib6.length = 6 ∧ dual6.length = fib6.length := by
  decide

/-! ## 4.  Las dos componentes, como observables

  Escrito por exponentes, el carácter `k` manda el punto `n` de la fibra a
  `ζ₆^{kn}`; aquí al exponente `k·n mod 6`.  Un observable construido con
  la componente `k` es una función de ese exponente.
-/

/-- **[P] LA COMPONENTE `k = 0` ES CIEGA.**  Cualquier observable
    construido únicamente con el carácter trivial toma el mismo valor en
    los seis puntos de la fibra, sea cual sea su tipo de llegada.

    Esto es `deck_invariant_is_level_function` escrito sobre el dual: el
    observable invariante de cubierta **es** el coeficiente `k = 0`. -/
theorem component_zero_is_blind {A : Type} (g : Nat → A) (a b : Fib) :
    g (chr 0 a) = g (chr 0 b) := by
  simp [chr]

/-- **[P] Y LA COMPONENTE `k = 1` LOS SEPARA A TODOS.**  `χ₁` es la
    identidad sobre la fibra, luego un observable inyectivo compuesto con
    `χ₁` distingue los seis puntos.

    **Ésta es la transformada que lee lo que la clásica no lee**, y no es
    otra maquinaria: es la misma, con el grupo correcto. -/
theorem component_one_separates {A : Type} (g : Nat → A)
    (hg : ∀ x y : Nat, g x = g y → x = y)
    (a b : Fib) (ha : a < 6) (hb : b < 6)
    (h : g (chr 1 a) = g (chr 1 b)) : a = b := by
  have hx := hg _ _ h
  unfold chr at hx
  rw [Nat.one_mul, Nat.one_mul, Nat.mod_eq_of_lt ha, Nat.mod_eq_of_lt hb] at hx
  exact hx

/-- **[P⊕] EL ENUNCIADO COMPLETO: HUECO Y RELLENO, EN UNA FIRMA.**

    (a) el carácter trivial —lo que Fourier clásico ve— es constante en la
        fibra: el hueco;
    (b) el dual completo separa la fibra: el relleno;
    (c) `χ₁` es la identidad, luego la inversión es exacta;
    (d) y la cuenta cuadra: seis y seis.

    El valor no es (a).  Es que (a) y (b) son la MISMA maquinaria con dos
    grupos distintos, y el grupo correcto está exhibido. -/
theorem the_gap_and_its_filling :
    (fib6.all (fun n => chr 0 n == chr 0 0) = true) ∧
    (∀ a ∈ fib6, ∀ b ∈ fib6, a ≠ b → ∃ k ∈ dual6, chr k a ≠ chr k b) ∧
    (fib6.all (fun n => chr 1 n == n) = true) ∧
    (dual6.length = fib6.length) :=
  ⟨trivial_character_is_blind, dual_separates_the_fibre,
   chi_one_is_the_identity, dual_and_fibre_have_the_same_size.2.2⟩



/- =====================================================================
   BLOQUE 6 de 16 - PCF_isotypic_dynamics
   los bloques, invariantes bajo la dinamica
   ===================================================================== -/


/-! ## 1.  Simetría y dinámica conmutan -/

/-- **[P] EL PASO DE CUBIERTA Y EL PASO DE TORRE CONMUTAN.**  El primero
    actúa en la fibra y deja el nivel; el segundo sube el nivel y deja la
    fibra.  Conmutan por construcción, y ésa es toda la hipótesis que hace
    falta. -/
theorem raise_deck_commute (i : JointIdx) :
    raise (deckStep i) = deckStep (raise i) := rfl

/-- **[P] Y ES GENUINO, NO VACÍO: LOS DOS PASOS HACEN COSAS DISTINTAS.**
    El de cubierta preserva el nivel; el de torre lo cambia. -/
theorem the_two_steps_are_different (i : JointIdx) :
    (deckStep i).1 = i.1 ∧ (raise i).1 = i.1 + 1 := ⟨rfl, rfl⟩

/-- Iterar la dinámica sigue conmutando con la simetría. -/
def raiseIter : Nat → JointIdx → JointIdx
  | 0,     i => i
  | n + 1, i => raise (raiseIter n i)

theorem raiseIter_deck_commute :
    ∀ (n : Nat) (i : JointIdx),
      raiseIter n (deckStep i) = deckStep (raiseIter n i)
  | 0,     _ => rfl
  | n + 1, i => by
      show raise (raiseIter n (deckStep i)) = deckStep (raise (raiseIter n i))
      rw [raiseIter_deck_commute n i, raise_deck_commute]

/-! ## 2.  Los seis tipos, y que la dinámica los preserva -/

/-- «`f` es de tipo `χ_k`»: bajo un paso de cubierta, `f` gana `k` en el
    exponente.  En escritura compleja, `f ∘ D = ζ₆^k · f`. -/
def IsIsotypic (k : Nat) (f : JointIdx → Nat) : Prop :=
  ∀ i : JointIdx, f (deckStep i) = (f i + k) % 6

/-- **[P] EL TIPO ESTÁ DETERMINADO.**  Una misma `f` no puede ser de dos
    tipos distintos: los seis bloques son disjuntos. -/
theorem isotypic_type_is_unique (k k' : Nat) (hk : k < 6) (hk' : k' < 6)
    (f : JointIdx → Nat) (h : IsIsotypic k f) (h' : IsIsotypic k' f) :
    k = k' := by
  have e := (h (0, Colour.c0, Orient.pos)).symm.trans (h' (0, Colour.c0, Orient.pos))
  omega

/-- **[P] EL TEOREMA.  LA DINÁMICA PRESERVA CADA BLOQUE ISOTÍPICO.**

    Si `f` es de tipo `χ_k`, entonces `f ∘ R` también lo es.  La prueba es
    la conmutación y nada más:

        (f∘R)(D i) = f(R(D i)) = f(D(R i)) = f(R i) + k = (f∘R)(i) + k.

    Luego las seis componentes no son sólo un reparto estático del espacio:
    son **subespacios invariantes de la evolución**.  La transformada de
    `μ₆` diagonaliza la dinámica por bloques. -/
theorem isotypic_invariant_under_dynamics (k : Nat) (f : JointIdx → Nat)
    (hf : IsIsotypic k f) : IsIsotypic k (fun i => f (raise i)) := by
  intro i
  show f (raise (deckStep i)) = (f (raise i) + k) % 6
  rw [raise_deck_commute]
  exact hf (raise i)

/-- **[P] Y BAJO LA DINÁMICA ITERADA.** -/
theorem isotypic_invariant_under_iterated_dynamics
    (k n : Nat) (f : JointIdx → Nat) (hf : IsIsotypic k f) :
    IsIsotypic k (fun i => f (raiseIter n i)) := by
  intro i
  show f (raiseIter n (deckStep i)) = (f (raiseIter n i) + k) % 6
  rw [raiseIter_deck_commute]
  exact hf (raiseIter n i)

/-! ## 3.  El bloque `k = 0` es exactamente el clásico -/

/-- **[P] TIPO `χ₀` ES INVARIANCIA DE CUBIERTA.**  Para observables con
    valores en el rango de la fibra, ser de tipo `0` es ser invariante bajo
    el paso de cubierta. -/
theorem type_zero_is_deck_invariant (f : JointIdx → Nat)
    (hrange : ∀ i, f i < 6) (hf : IsIsotypic 0 f) :
    ∀ i, f (deckStep i) = f i := by
  intro i
  have h := hf i
  have : (f i + 0) % 6 = f i := by
    have := hrange i
    omega
  omega

/-- **[P] LUEGO EL BLOQUE `k = 0` ES FUNCIÓN DEL NIVEL SOLA.**  Composición
    con `deck_invariant_is_level_function` del kernel: el bloque trivial es
    exactamente la clase de observables de Fourier. -/
theorem type_zero_is_a_level_function (f : JointIdx → Nat)
    (hrange : ∀ i, f i < 6) (hf : IsIsotypic 0 f)
    (i j : JointIdx) (hij : i.1 = j.1) : f i = f j :=
  deck_invariant_is_level_function f (type_zero_is_deck_invariant f hrange hf) i j hij

/-- **[P] Y LOS OTROS CINCO NO LO SON.**  Un observable de tipo `k ≠ 0` con
    valores en el rango de la fibra NO es invariante de cubierta: el paso
    lo mueve. -/
theorem nonzero_type_is_not_deck_invariant (k : Nat) (hk0 : 0 < k) (hk : k < 6)
    (f : JointIdx → Nat) (hrange : ∀ i, f i < 6) (hf : IsIsotypic k f) :
    ∃ i, f (deckStep i) ≠ f i := by
  refine ⟨(0, Colour.c0, Orient.pos), ?_⟩
  have h := hf (0, Colour.c0, Orient.pos)
  have hr := hrange (0, Colour.c0, Orient.pos)
  omega

/-! ## 4.  La conjunción: D1′ dinámico -/

/-- **[P⊕] D1′, PARTE DINÁMICA.**

    (a) simetría y dinámica conmutan, y no vacuamente —hacen cosas
        distintas al nivel—;
    (b) por tanto cada bloque isotípico es invariante bajo la dinámica, y
        bajo la dinámica iterada;
    (c) el tipo es único, luego los seis bloques son disjuntos;
    (d) el bloque `k = 0` es exactamente la clase de Fourier —invariante de
        cubierta, luego función del nivel— y
    (e) ningún otro bloque lo es.

    **La transformada de `μ₆` no sólo separa la fibra: bloquea-diagonaliza
    la evolución, y Fourier clásico es uno de los seis bloques.**

    ALCANCE: esto es sobre subespacios invariantes. No dice nada sobre el
    espectro del operador de transferencia, que sigue fuera del paper. -/
theorem D1prime_dynamical (k : Nat) (hk0 : 0 < k) (hk : k < 6)
    (f g : JointIdx → Nat)
    (hrange : ∀ i, f i < 6) (hgrange : ∀ i, g i < 6)
    (h0 : IsIsotypic 0 f) (hk' : IsIsotypic k g) :
    (∀ i, raise (deckStep i) = deckStep (raise i)) ∧
    (∀ i, (deckStep i).1 = i.1 ∧ (raise i).1 = i.1 + 1) ∧
    (IsIsotypic 0 (fun i => f (raise i))) ∧
    (IsIsotypic k (fun i => g (raise i))) ∧
    (∀ i j : JointIdx, i.1 = j.1 → f i = f j) ∧
    (∃ i, g (deckStep i) ≠ g i) :=
  ⟨raise_deck_commute, the_two_steps_are_different,
   isotypic_invariant_under_dynamics 0 f h0,
   isotypic_invariant_under_dynamics k g hk',
   fun i j hij => type_zero_is_a_level_function f hrange h0 i j hij,
   nonzero_type_is_not_deck_invariant k hk0 hk g hgrange hk'⟩



/- =====================================================================
   BLOQUE 7 de 16 - PCF_eisenstein_dft
   Z[w], ortogonalidad, inversion
   ===================================================================== -/


/-! ## 1.  El anillo `ℤ[ω]` -/

/-- `a + b·ω` con `ω² = −1 − ω`, es decir `ω = e^{2πi/3}`. -/
structure Eis where
  a : Int
  b : Int
deriving DecidableEq, Repr

namespace Eis

def zero : Eis := ⟨0, 0⟩
def one  : Eis := ⟨1, 0⟩
def w    : Eis := ⟨0, 1⟩

def add (x y : Eis) : Eis := ⟨x.a + y.a, x.b + y.b⟩
def neg (x : Eis)   : Eis := ⟨-x.a, -x.b⟩
def sub (x y : Eis) : Eis := add x (neg y)

/-- `(a+bω)(c+dω) = (ac−bd) + (ad+bc−bd)ω`, usando `ω² = −1−ω`. -/
def mul (x y : Eis) : Eis :=
  ⟨x.a * y.a - x.b * y.b, x.a * y.b + x.b * y.a - x.b * y.b⟩

/-- `ω̄ = ω² = −1−ω`, luego `conj(a+bω) = (a−b) − bω`. -/
def conj (x : Eis) : Eis := ⟨x.a - x.b, -x.b⟩

/-- La norma de cuerpo: `N(a+bω) = a² − ab + b²`. -/
def norm (x : Eis) : Int := x.a * x.a - x.a * x.b + x.b * x.b

def smul (k : Int) (x : Eis) : Eis := ⟨k * x.a, k * x.b⟩

theorem add_comm (x y : Eis) : add x y = add y x := by
  simp [add, Eis.mk.injEq]; refine ⟨?_, ?_⟩ <;> omega

theorem add_assoc (x y z : Eis) : add (add x y) z = add x (add y z) := by
  simp [add, Eis.mk.injEq]; refine ⟨?_, ?_⟩ <;> omega

theorem add_zero (x : Eis) : add x zero = x := by
  simp [add, zero]

theorem mul_comm (x y : Eis) : mul x y = mul y x := by
  obtain ⟨xa, xb⟩ := x
  obtain ⟨ya, yb⟩ := y
  have c1 : xa * ya = ya * xa := Int.mul_comm _ _
  have c2 : xb * yb = yb * xb := Int.mul_comm _ _
  have c3 : xa * yb = yb * xa := Int.mul_comm _ _
  have c4 : xb * ya = ya * xb := Int.mul_comm _ _
  simp [mul, Eis.mk.injEq]
  refine ⟨?_, ?_⟩ <;> omega

theorem mul_one (x : Eis) : mul x one = x := by
  simp [mul, one]

/-- La conjugación es una involución. -/
theorem conj_conj (x : Eis) : conj (conj x) = x := by
  simp [conj]

/-- `ω³ = 1`: `ω` es raíz cúbica primitiva de la unidad. -/
theorem w_cubed : mul (mul w w) w = one := by decide
theorem w_order_three : w ≠ one ∧ mul w w ≠ one := by decide

end Eis

/-! ## 2.  `ζ₆ = 1 + ω` y los seis caracteres -/

/-- `ζ₆ = −ω² = 1 + ω = e^{iπ/3}`, el generador de `μ₆`. -/
def z6 : Eis := ⟨1, 1⟩

def epow : Nat → Eis
  | 0     => Eis.one
  | n + 1 => Eis.mul (epow n) z6

/-- **[P] `ζ₆` TIENE ORDEN EXACTAMENTE 6.**  Es el generador de
    `μ₆ = ℤ[ω]ˣ`, el grupo de cubierta. -/
theorem z6_order_six :
    epow 6 = Eis.one ∧
    epow 1 ≠ Eis.one ∧ epow 2 ≠ Eis.one ∧ epow 3 ≠ Eis.one ∧
    epow 4 ≠ Eis.one ∧ epow 5 ≠ Eis.one := by decide

/-- **[P] Y `ζ₆ = −ω²`, o sea `ζ₆` vive en el mismo anillo. -/
theorem z6_is_minus_w_squared : z6 = Eis.neg (Eis.mul Eis.w Eis.w) := by decide

/-- El carácter `k`-ésimo, evaluado en el punto `n` de la fibra:
    `χ_k(n) = ζ₆^{kn}`. -/
def chi (k n : Nat) : Eis := epow ((k * n) % 6)

/-- **[P] `χ₀ ≡ 1`: el carácter trivial.** -/
theorem chi_zero_is_one : ∀ n ∈ [0,1,2,3,4,5], chi 0 n = Eis.one := by decide

/-- **[P] Y `χ₁` GENERA: sus valores son las seis unidades, distintas. -/
theorem chi_one_is_faithful :
    chi 1 0 ≠ chi 1 1 ∧ chi 1 1 ≠ chi 1 2 ∧ chi 1 2 ≠ chi 1 3 ∧
    chi 1 3 ≠ chi 1 4 ∧ chi 1 4 ≠ chi 1 5 ∧ chi 1 5 ≠ chi 1 0 := by decide

/-! ## 3.  Ortogonalidad: las 36 entradas -/

/-- `Σ_{n<6} x n`, escrita sin `Finset`. -/
def sum6 (f : Nat → Eis) : Eis :=
  Eis.add (Eis.add (Eis.add (Eis.add (Eis.add (f 0) (f 1)) (f 2)) (f 3)) (f 4)) (f 5)

/-- **[P] LA RELACIÓN DE ORTOGONALIDAD.**

        `Σₙ χₖ(n)·conj(χₗ(n))  =  6`  si `k = l`,  `0` si no.

    Las 36 entradas, verificadas.  Ésta es la única propiedad que una
    transformada de Fourier finita necesita: de ella sale la inversión, y
    de la inversión todo lo demás. -/
theorem orthogonality :
    ∀ k ∈ [0,1,2,3,4,5], ∀ l ∈ [0,1,2,3,4,5],
      sum6 (fun n => Eis.mul (chi k n) (Eis.conj (chi l n)))
        = (if k = l then Eis.smul 6 Eis.one else Eis.zero) := by
  decide

/-! ## 4.  Análisis, síntesis, inversión -/

/-- **ANÁLISIS.**  `f̂(k) = Σₙ f(n)·conj(χ_k(n))`. -/
def analysis (f : Nat → Eis) (k : Nat) : Eis :=
  sum6 (fun n => Eis.mul (f n) (Eis.conj (chi k n)))

/-- **SÍNTESIS.**  `(Ǧ)(n) = Σ_k g(k)·χ_k(n)`. -/
def synthesis (g : Nat → Eis) (n : Nat) : Eis :=
  sum6 (fun k => Eis.mul (g k) (chi k n))

/-- **[P] LA INVERSIÓN.  `síntesis ∘ análisis = 6 · id` sobre la fibra.**

    Para toda `f` y cada uno de los seis puntos.  Sin división: `ℤ[ω]` es
    libre de torsión, luego `6·x = 6·y ⟹ x = y` y la reconstrucción es
    exacta.

    **Con esto la transformada está completa: analiza, sintetiza y
    reconstruye, y todo con coeficientes en el anillo del propio
    objeto.** -/
theorem inversion (f : Nat → Eis) (n : Nat) (hn : n < 6) :
    synthesis (analysis f) n = Eis.smul 6 (f n) := by
  match n, hn with
  | 0, _ =>
      simp [synthesis, analysis, sum6, chi, epow, z6, Eis.mul, Eis.add,
            Eis.conj, Eis.smul, Eis.one, Eis.mk.injEq]
      refine ⟨?_, ?_⟩ <;> omega
  | 1, _ =>
      simp [synthesis, analysis, sum6, chi, epow, z6, Eis.mul, Eis.add,
            Eis.conj, Eis.smul, Eis.one, Eis.mk.injEq]
      refine ⟨?_, ?_⟩ <;> omega
  | 2, _ =>
      simp [synthesis, analysis, sum6, chi, epow, z6, Eis.mul, Eis.add,
            Eis.conj, Eis.smul, Eis.one, Eis.mk.injEq]
      refine ⟨?_, ?_⟩ <;> omega
  | 3, _ =>
      simp [synthesis, analysis, sum6, chi, epow, z6, Eis.mul, Eis.add,
            Eis.conj, Eis.smul, Eis.one, Eis.mk.injEq]
      refine ⟨?_, ?_⟩ <;> omega
  | 4, _ =>
      simp [synthesis, analysis, sum6, chi, epow, z6, Eis.mul, Eis.add,
            Eis.conj, Eis.smul, Eis.one, Eis.mk.injEq]
      refine ⟨?_, ?_⟩ <;> omega
  | 5, _ =>
      simp [synthesis, analysis, sum6, chi, epow, z6, Eis.mul, Eis.add,
            Eis.conj, Eis.smul, Eis.one, Eis.mk.injEq]
      refine ⟨?_, ?_⟩ <;> omega
  | m + 6, h => exact absurd h (by omega)

/-- **[P] Y LA TORSIÓN NO ESTORBA: `6·x = 6·y ⟹ x = y`.** -/
theorem smul_six_injective (x y : Eis) (h : Eis.smul 6 x = Eis.smul 6 y) : x = y := by
  obtain ⟨xa, xb⟩ := x
  obtain ⟨ya, yb⟩ := y
  simp [Eis.smul, Eis.mk.injEq] at h
  simp [Eis.mk.injEq]
  refine ⟨?_, ?_⟩ <;> omega

/-! ## 5.  Lo que esto da, junto -/

/-- **[P⊕] LA TRANSFORMADA FINITA, COMPLETA.**

    (a) `ζ₆` tiene orden 6 y genera `μ₆ = ℤ[ω]ˣ`, el grupo de cubierta;
    (b) los seis caracteres son ortogonales, `Σ χₖ conj(χₗ) = 6δₖₗ`;
    (c) análisis y síntesis se componen a `6·id`;
    (d) y `6·` es inyectiva, luego la reconstrucción es exacta.

    Eso es una transformada de Fourier finita en el sentido completo de la
    palabra: operador de análisis, operador de síntesis, fórmula de
    inversión.  **Ejecutable**, porque `analysis` y `synthesis` son
    funciones computables, y **verificada**, porque (b), (c) y (d) son
    teoremas y no comprobaciones numéricas. -/
theorem the_transform_is_complete (f : Nat → Eis) :
    (epow 6 = Eis.one ∧ epow 3 ≠ Eis.one ∧ epow 2 ≠ Eis.one) ∧
    (sum6 (fun n => Eis.mul (chi 1 n) (Eis.conj (chi 1 n))) = Eis.smul 6 Eis.one) ∧
    (sum6 (fun n => Eis.mul (chi 1 n) (Eis.conj (chi 2 n))) = Eis.zero) ∧
    (∀ n : Nat, n < 6 → synthesis (analysis f) n = Eis.smul 6 (f n)) ∧
    (∀ x y : Eis, Eis.smul 6 x = Eis.smul 6 y → x = y) :=
  ⟨⟨z6_order_six.1, z6_order_six.2.2.2.1, z6_order_six.2.2.1⟩,
   by decide, by decide, inversion f, smul_six_injective⟩



