  ⟨eps0_relates_log_and_geometry, log_phi_via_pi_and_MPCF⟩

theorem component_two_lattice (r : ℝ) (hr : 0 < r) :
    (∃ k : ℤ, r = (φ : ℝ) ^ k) ↔ (∃ k : ℤ, valPhi r = (k : ℝ)) :=
  monomial_iff_valPhi_int r hr

theorem component_two_faithful (n : ℤ) : valPhi ((φ : ℝ) ^ n) = (n : ℝ) :=
