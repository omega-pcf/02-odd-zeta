theorem C1_audited (d r B : ℝ) (hc : ∃ n : ℕ, d = (n : ℝ)) (hlt : d < 1)
    (hfam : ∃ k : ℤ, r = (φ : ℝ) ^ k) (hB : B < 1) (hrB : discP r ≤ B)
    (k : Fin 3) (h_strip : 0 < PCF_spectral k ∧ PCF_spectral k < 1) :
    (d = 0) ∧ (r = 1) ∧ (PCF_spectral k = 1/2) :=
  ⟨chain_gap_via_collapse d hc hlt,
   family_gap_via_collapse r B hfam hB hrB,
   no_intermediate_is_a_citation k h_strip⟩

theorem fibre_model_presupposes_the_degree (deg : Chi5Zero → ℤ) (z : Chi5Zero) :
    degreeModThree deg z = ((deg z : ℤ) : ZMod 3) := rfl

theorem hasDegree_gives_the_fibre_model (h : HasDegree) :
    ∃ f : Chi5Zero → ZMod 3, ∀ z : Chi5Zero, ∃ k : ℤ,
      f z = ((k : ℤ) : ZMod 3) ∧ (φ : ℝ) ^ k = zeroCoord z.ρ := by
  obtain ⟨deg, hdeg⟩ := h
  exact ⟨fun z => degreeModThree deg z, fun z => ⟨deg z, rfl, hdeg z⟩⟩

theorem B_mechanism (r C : ℝ) (hr1 : 1 < r) (hC : 0 < C)
    (hbound : ∀ p : ℕ, r ^ p ≤ C) : False :=
  the_action_would_close_it r C hr1 hC hbound

theorem B_easy_direction (hE : ∀ z : Chi5Zero, z.ρ.re = 1/2) :
    ZeroCoordsCarryPowerAction :=
  E_constructs_the_power_action hE

theorem what_remains_of_membership (deg : Chi5Zero → ℤ) (z : Chi5Zero)
    (r C : ℝ) (hr1 : 1 < r) (hC : 0 < C) (hbound : ∀ p : ℕ, r ^ p ≤ C) :
    (degreeModThree deg z = ((deg z : ℤ) : ZMod 3)) ∧ False :=
  ⟨fibre_model_presupposes_the_degree deg z, B_mechanism r C hr1 hC hbound⟩

theorem li_term_is_liMap (ρ : ℂ) : liMap ρ = 1 - 1/ρ := rfl

theorem li_modulus_is_the_coordinate (ρ : ℂ) :
    Complex.abs (liMap ρ) = zeroCoord ρ := rfl

theorem li_index_is_the_orbit_power (ρ : ℂ) (n : ℕ) :
    Complex.abs (liMap ρ ^ n) = (zeroCoord ρ) ^ n := by
  unfold Complex.abs
  rw [norm_pow]; rfl

theorem on_the_line_powers_stay (ρ : ℂ) (h0 : 0 < ρ.re) (hE : ρ.re = 1/2)
    (n : ℕ) : Complex.abs (liMap ρ ^ n) = 1 := by
  rw [li_index_is_the_orbit_power ρ n, (hcoord_discharged ρ h0).mpr hE, one_pow]

theorem off_the_line_powers_escape (ρ : ℂ) (h1 : 1 < zeroCoord ρ) (C : ℝ)
    (hC : 0 < C) : ∃ n : ℕ, C < Complex.abs (liMap ρ ^ n) := by
  obtain ⟨n, hn⟩ := powers_escape_any_bound (zeroCoord ρ) C h1 hC
  exact ⟨n, by rw [li_index_is_the_orbit_power ρ n]; exact hn⟩

theorem the_fifth_alias_with_the_right_index (ρ : ℂ) (n : ℕ)
    (h0 : 0 < ρ.re) (hE : ρ.re = 1/2) :
    (liMap ρ = 1 - 1/ρ) ∧
    (Complex.abs (liMap ρ) = zeroCoord ρ) ∧
    (Complex.abs (liMap ρ ^ n) = (zeroCoord ρ) ^ n) ∧
    (Complex.abs (liMap ρ ^ n) = 1) :=
  ⟨li_term_is_liMap ρ, li_modulus_is_the_coordinate ρ,
   li_index_is_the_orbit_power ρ n, on_the_line_powers_stay ρ h0 hE n⟩

-- `liTerm` eliminado: el nombre importado (`liTerm : ℝ → ℝ → ℕ → ℝ`) choca;
-- la versión que este bloque necesita vive solo como teorema puntual más abajo.
-- noncomputable def liTerm (z : Chi5Zero) (n : ℕ) : ℂ := 1 - liMap z.ρ ^ n

noncomputable def liCoeffZ (S : Finset Chi5Zero) (n : ℕ) : ℂ :=
  ∑ z ∈ S, (1 - (liMap z.ρ) ^ n)

theorem liCoeffZ_is_indexed_by_zeros (S : Finset Chi5Zero) (n : ℕ) :
    liCoeffZ S n = ∑ z ∈ S, (1 - (liMap z.ρ) ^ n) := rfl

theorem re_one_sub_nonneg_of_abs_one (w : ℂ) (hw : Complex.abs w = 1) :
    0 ≤ (1 - w).re := by
  have h : w.re ≤ Complex.abs w := Complex.re_le_norm w
  rw [hw] at h
  simp only [Complex.sub_re, Complex.one_re]
  linarith

-- (Ola B3x, 2026-09-08) `liTermChi` (renamed to avoid clash with imported liTerm : ℝ → ℝ → ℕ → ℝ):
-- el import trae `liTerm : ℝ → ℝ → ℕ → ℝ` (renamed local version to liTermChi).
noncomputable def liTermChi (z : Chi5Zero) (n : ℕ) : ℂ := 1 - liMap z.ρ ^ n

theorem liTerm_re_nonneg_on_line (z : Chi5Zero) (hE : z.ρ.re = 1/2) (n : ℕ) :
    0 ≤ (liTermChi z n).re := by
  have h1 : Complex.abs (liMap z.ρ) = 1 :=
    (hcoord_discharged z.ρ z.in_strip_pos).mpr hE
  have hn : Complex.abs ((liMap z.ρ) ^ n) = 1 := by
    unfold Complex.abs at h1 ⊢
    rw [norm_pow, h1, one_pow]
  exact re_one_sub_nonneg_of_abs_one _ hn

theorem liCoeffZ_re_nonneg_of_E (S : Finset Chi5Zero)
    (hE : ∀ z ∈ S, z.ρ.re = 1/2) (n : ℕ) :
    0 ≤ (liCoeffZ S n).re := by
  unfold liCoeffZ
  rw [Complex.re_sum]
  refine Finset.sum_nonneg (fun z hz => ?_)
  have h1 : Complex.abs (liMap z.ρ) = 1 :=
    (hcoord_discharged z.ρ z.in_strip_pos).mpr (hE z hz)
  have hn : Complex.abs ((liMap z.ρ) ^ n) = 1 := by
    unfold Complex.abs at h1 ⊢
    rw [norm_pow, h1, one_pow]
  exact re_one_sub_nonneg_of_abs_one _ hn

theorem liTerm_modulus_escapes (z : Chi5Zero) (h1 : 1 < zeroCoord z.ρ)
    (C : ℝ) (hC : 0 < C) :
    ∃ n : ℕ, C < Complex.abs ((liMap z.ρ) ^ n) :=
  off_the_line_powers_escape z.ρ h1 C hC

theorem liCoeffZ_is_liCoeff_on_the_image (S : Finset Chi5Zero) (n : ℕ) :
    liCoeffZ S n = ∑ z ∈ S, (1 - (1 - 1/z.ρ) ^ n) :=
  Finset.sum_congr rfl (fun _ _ => rfl)

theorem what_was_already_stated (S : Finset Chi5Zero) (n : ℕ) :
    liCoeffZ S n = ∑ z ∈ S, (1 - (1 - 1/z.ρ) ^ n) :=
  liCoeffZ_is_liCoeff_on_the_image S n

theorem lambda_n_over_Chi5Zero (S : Finset Chi5Zero)
    (hE : ∀ z ∈ S, z.ρ.re = 1/2) (n : ℕ) (z : Chi5Zero) (hz : z.ρ.re = 1/2) :
    (liCoeffZ S n = ∑ w ∈ S, (1 - (liMap w.ρ) ^ n)) ∧
    (0 ≤ (liTermChi z n).re) ∧
    (0 ≤ (liCoeffZ S n).re) :=
  ⟨liCoeffZ_is_indexed_by_zeros S n,
   liTerm_re_nonneg_on_line z hz n,
   liCoeffZ_re_nonneg_of_E S hE n⟩

theorem every_zero_coord_bounded (h : NoLowZeros) (z : Chi5Zero) :
    zeroCoord z.ρ ≤ 2 / Real.sqrt 3 := by
  have hpos : 0 < zeroCoord z.ρ := zeroCoord_pos_on_zeros z.ρ ⟨z, rfl⟩
  have hle : discP (zeroCoord z.ρ) ≤ 1/12 :=
    discBound_of_high_gamma z.ρ z.in_strip_pos z.in_strip_lt (h z)
  exact (disc_le_confines (zeroCoord z.ρ) hpos hle).2

theorem action_forbids_coord_gt_one (h : NoLowZeros)
    (hB : ZeroCoordsCarryPowerAction) (z : Chi5Zero) :
    ¬ (1 < zeroCoord z.ρ) := by
  intro hgt
  have hC : (0:ℝ) < 2 / Real.sqrt 3 := by
    have : (0:ℝ) < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
    positivity
  obtain ⟨p, hp⟩ := powers_escape_any_bound (zeroCoord z.ρ) (2 / Real.sqrt 3) hgt hC
  obtain ⟨q, hq, hqp⟩ := Nat.exists_infinite_primes p
  obtain ⟨w, hw⟩ := hB q hqp z
  have hmono : zeroCoord z.ρ ^ p ≤ zeroCoord z.ρ ^ q :=
    pow_le_pow_right₀ (le_of_lt hgt) hq
  have hbound : zeroCoord w.ρ ≤ 2 / Real.sqrt 3 := every_zero_coord_bounded h w
  rw [hw] at hbound
  linarith [hp, hmono, hbound]

theorem B_gives_E (h : NoLowZeros) (hB : ZeroCoordsCarryPowerAction)
    (hmate : ∀ z : Chi5Zero, ∃ w : Chi5Zero, zeroCoord w.ρ = (zeroCoord z.ρ)⁻¹)
    (z : Chi5Zero) : z.ρ.re = 1/2 := by
  have hpos : 0 < zeroCoord z.ρ := zeroCoord_pos_on_zeros z.ρ ⟨z, rfl⟩
  have hnot_gt : ¬ (1 < zeroCoord z.ρ) := action_forbids_coord_gt_one h hB z
  have hnot_lt : ¬ (zeroCoord z.ρ < 1) := by
    intro hlt
    obtain ⟨w, hw⟩ := hmate z
    have : 1 < zeroCoord w.ρ := by
      rw [hw]; exact (one_lt_inv₀ (zeroCoord_pos_on_zeros z.ρ ⟨z, rfl⟩)).mpr hlt
    exact action_forbids_coord_gt_one h hB w this
  have h1 : zeroCoord z.ρ = 1 := le_antisymm (not_lt.mp hnot_gt) (not_lt.mp hnot_lt)
  exact (hcoord_discharged z.ρ z.in_strip_pos).mp h1

theorem B_iff_E (h : NoLowZeros)
    (hmate : ∀ z : Chi5Zero, ∃ w : Chi5Zero, zeroCoord w.ρ = (zeroCoord z.ρ)⁻¹) :
    ZeroCoordsCarryPowerAction ↔ (∀ z : Chi5Zero, z.ρ.re = 1/2) :=
  ⟨fun hB z => B_gives_E h hB hmate z, E_constructs_the_power_action⟩

theorem companion_is_a_zero (z : Chi5Zero) :
    (Chi5Zero.companion z).ρ = 1 - z.ρ := rfl

theorem companion_re_is_one_sub (z : Chi5Zero) :
    (Chi5Zero.companion z).ρ.re = 1 - z.ρ.re :=
  Chi5Zero.companion_re z

theorem chi5_is_order_two : chi5_D * chi5_D = 1 := chi5_D_sq

theorem kmate_is_conj_of_companion (ρ : ℂ) :
    1 - (starRingEnd ℂ) ρ = (starRingEnd ℂ) (1 - ρ) := by
  simp [map_sub, map_one]

theorem conj_closure_would_give_kmate_closure
    (hconj : ∀ z : Chi5Zero, DirichletCharacter.LFunction chi5_D
              ((starRingEnd ℂ) z.ρ) = 0)
    (z : Chi5Zero) :
    DirichletCharacter.LFunction chi5_D
      ((starRingEnd ℂ) (Chi5Zero.companion z).ρ) = 0 :=
  hconj (Chi5Zero.companion z)

theorem the_two_hypotheses_audited (z : Chi5Zero) (ρ : ℂ) :
    ((Chi5Zero.companion z).ρ = 1 - z.ρ) ∧
    ((Chi5Zero.companion z).ρ.re = 1 - z.ρ.re) ∧
    (chi5_D * chi5_D = 1) ∧
    (1 - (starRingEnd ℂ) ρ = (starRingEnd ℂ) (1 - ρ)) :=
  ⟨companion_is_a_zero z, companion_re_is_one_sub z,
   chi5_is_order_two, kmate_is_conj_of_companion ρ⟩

theorem mate_hypothesis_discharged (z : Chi5Zero) :
    ∃ w : Chi5Zero, zeroCoord w.ρ = (zeroCoord z.ρ)⁻¹ := by
  refine ⟨Chi5Zero.companion z, ?_⟩
  have h0 : z.ρ ≠ 0 := by
    intro h; have := z.in_strip_pos; rw [h] at this; simp at this
  have h1 : z.ρ ≠ 1 := by
    intro h; have := z.in_strip_lt; rw [h] at this; simp at this
  rw [companion_is_a_zero z]
  exact coordinate_is_equivariant z.ρ h0 h1

theorem B_gives_E_one_hypothesis (h : NoLowZeros)
    (hB : ZeroCoordsCarryPowerAction) (z : Chi5Zero) :
    z.ρ.re = 1/2 :=
  B_gives_E h hB mate_hypothesis_discharged z

theorem B_iff_E_one_hypothesis (h : NoLowZeros) :
    ZeroCoordsCarryPowerAction ↔ (∀ z : Chi5Zero, z.ρ.re = 1/2) :=
  ⟨fun hB z => B_gives_E_one_hypothesis h hB z, E_constructs_the_power_action⟩

theorem what_remains_of_the_hypotheses (h : NoLowZeros) (z : Chi5Zero) :
    (∃ w : Chi5Zero, zeroCoord w.ρ = (zeroCoord z.ρ)⁻¹) ∧
    (ZeroCoordsCarryPowerAction ↔ (∀ w : Chi5Zero, w.ρ.re = 1/2)) :=
  ⟨mate_hypothesis_discharged z, B_iff_E_one_hypothesis h⟩

theorem abs_ge_abs_im (ρ : ℂ) : |ρ.im| ≤ Complex.abs ρ :=
  Complex.abs_im_le_norm ρ

theorem coord_le_one_add_inv_im (ρ : ℂ) (hγ : ρ.im ≠ 0) :
    zeroCoord ρ ≤ 1 + 1 / |ρ.im| := by
  have habs : (0:ℝ) < |ρ.im| := abs_pos.mpr hγ
  have hρ : (0:ℝ) < Complex.abs ρ := lt_of_lt_of_le habs (abs_ge_abs_im ρ)
  have hne : ρ ≠ 0 := by
    intro h; rw [h] at hρ; simp at hρ
  have h1 : zeroCoord ρ ≤ 1 + 1 / Complex.abs ρ := by
    unfold zeroCoord liMap
    calc Complex.abs (1 - 1/ρ) ≤ Complex.abs 1 + Complex.abs (1/ρ) :=
          norm_sub_le 1 (1/ρ)
      _ = 1 + 1 / Complex.abs ρ := by
        simp [Complex.abs]
  have h2 : 1 / Complex.abs ρ ≤ 1 / |ρ.im| :=
    one_div_le_one_div_of_le habs (abs_ge_abs_im ρ)
  linarith

theorem uniform_bound_from_any_epsilon (ε : ℝ) (hε : 0 < ε)
    (h : ∀ z : Chi5Zero, ε ≤ |z.ρ.im|) (z : Chi5Zero) :
    zeroCoord z.ρ ≤ 1 + 1/ε := by
  have hγ : z.ρ.im ≠ 0 := by
    intro h0
    have := h z; rw [h0] at this; simp at this; linarith
  have h1 := coord_le_one_add_inv_im z.ρ hγ
  have h2 : 1 / |z.ρ.im| ≤ 1 / ε := one_div_le_one_div_of_le hε (h z)
  linarith

theorem the_hypotheses_at_the_end (ε : ℝ) (hε : 0 < ε)
    (h : ∀ z : Chi5Zero, ε ≤ |z.ρ.im|) (z : Chi5Zero) :
    (zeroCoord z.ρ ≤ 1 + 1/ε) ∧
    (∃ w : Chi5Zero, zeroCoord w.ρ = (zeroCoord z.ρ)⁻¹) :=
  ⟨uniform_bound_from_any_epsilon ε hε h z, mate_hypothesis_discharged z⟩

def OrdinatesBoundedAway : Prop :=
  ∃ ε : ℝ, 0 < ε ∧ ∀ z : Chi5Zero, ε ≤ |z.ρ.im|

def NoRealZero : Prop := ∀ z : Chi5Zero, z.ρ.im ≠ 0

theorem real_zero_coordinate (β : ℝ) (h0 : 0 < β) (h1 : β < 1) :
    zeroCoord (β : ℂ) = (1 - β) / β := by
  have hne : (β : ℂ) ≠ 0 := by
    simp only [ne_eq, Complex.ofReal_eq_zero]; linarith
  rw [zeroCoord_is_a_distance_ratio (β : ℂ) hne]
  rw [show ((β : ℂ) - 1) = ((β - 1 : ℝ) : ℂ) by push_cast; ring]
  rw [Complex.abs_ofReal, Complex.abs_ofReal, abs_of_pos h0,
      abs_of_neg (by linarith : β - 1 < 0)]
  ring

theorem real_zero_at_half : ((1:ℝ) - 1/2) / (1/2 : ℝ) = 1 := by norm_num

def OrdinatesDiscreteAtZero : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ z : Chi5Zero, |z.ρ.im| < ε → False

theorem epsilon_from_the_two_pieces
    (hbridge : NoRealZero → OrdinatesDiscreteAtZero → OrdinatesBoundedAway)
    (h1 : NoRealZero) (h2 : OrdinatesDiscreteAtZero) :
    OrdinatesBoundedAway := hbridge h1 h2

theorem epsilon_gives_the_bound (h : OrdinatesBoundedAway) :
    ∃ C : ℝ, ∀ z : Chi5Zero, zeroCoord z.ρ ≤ C := by
  obtain ⟨ε, hε, hz⟩ := h
  exact ⟨1 + 1/ε, fun z => uniform_bound_from_any_epsilon ε hε hz z⟩

theorem phi_is_the_fundamental_unit :
    (φ : ℝ) * ((φ : ℝ) - 1) = 1 ∧ (φ : ℝ) - 1 = ((φ : ℝ))⁻¹ :=
  golden_pair_is_a_unit_pair

def ClassNumberFormulaChi5 : Prop :=
  DirichletCharacter.LFunction chi5_D 1 = (2 * Real.log (φ : ℝ) / Real.sqrt 5 : ℝ)

theorem classNumber_gives_nonvanishing (h : ClassNumberFormulaChi5) :
    DirichletCharacter.LFunction chi5_D 1 ≠ 0 := by
  rw [h]
  have hlog : 0 < Real.log (φ : ℝ) := Real.log_pos one_lt_phi
  have h5 : (0:ℝ) < Real.sqrt 5 := Real.sqrt_pos.mpr (by norm_num)
  have : (0:ℝ) < 2 * Real.log (φ : ℝ) / Real.sqrt 5 := by positivity
  simpa using ne_of_gt this

theorem classNumber_is_the_phi_face (h : ClassNumberFormulaChi5) :
    DirichletCharacter.LFunction chi5_D 1
      = (2 * Real.log (φ : ℝ) / Real.sqrt 5 : ℝ) := h

theorem the_same_log_phi_appears (x : ℝ) (hx : 0 < x) :
    valPhi x * Real.log (φ : ℝ) = Real.log x := by
  unfold valPhi
  have hne : Real.log (φ : ℝ) ≠ 0 := ne_of_gt (Real.log_pos one_lt_phi)
  field_simp

theorem same_log_phi (x : ℝ) :
    valPhi x = Real.log x / Real.log (φ : ℝ) := rfl

theorem what_I_cannot_and_what_appeared (h : OrdinatesBoundedAway) (x : ℝ) :
    (∃ C : ℝ, ∀ z : Chi5Zero, zeroCoord z.ρ ≤ C) ∧
    ((φ : ℝ) * ((φ : ℝ) - 1) = 1) ∧
    (valPhi x = Real.log x / Real.log (φ : ℝ)) :=
  ⟨epsilon_gives_the_bound h, phi_is_the_fundamental_unit.1, same_log_phi x⟩

theorem real_coord_closed_form (β : ℝ) (h0 : 0 < β) (h1 : β < 1) :
    zeroCoord (β : ℂ) = 1/β - 1 := by
  have hb : β ≠ 0 := ne_of_gt h0
  rw [real_zero_coordinate β h0 h1]
  field_simp

theorem witness_in_strip (k : ℤ) :
    0 < 1/(1 + (φ : ℝ)^k) ∧ 1/(1 + (φ : ℝ)^k) < 1 := by
  have hpos : (0:ℝ) < (φ : ℝ)^k := zpow_pos φ_pos k
  constructor
  · positivity
  · rw [div_lt_one (by linarith)]; linarith

theorem witness_coord_is_phi_pow (k : ℤ) :
    (1 : ℝ)/(1/(1 + (φ : ℝ)^k)) - 1 = (φ : ℝ)^k := by
  have hpos : (0:ℝ) < (φ : ℝ)^k := zpow_pos φ_pos k
  have hne : (1 : ℝ) + (φ : ℝ)^k ≠ 0 := by linarith
  rw [one_div_one_div]
  ring

theorem witness_off_line_iff (k : ℤ) :
    1/(1 + (φ : ℝ)^k) = 1/2 ↔ (φ : ℝ)^k = 1 := by
  have hpos : (0:ℝ) < (φ : ℝ)^k := zpow_pos φ_pos k
  have hne : (1 : ℝ) + (φ : ℝ)^k ≠ 0 := by linarith
  constructor
  · intro h
    have h2 : (1 : ℝ) + (φ : ℝ)^k = 2 := by
      field_simp at h; linarith
    linarith
  · intro h
    rw [h]; norm_num

theorem ninth_witness (k : ℤ) (hk : (φ : ℝ)^k ≠ 1) :
    (0 < 1/(1 + (φ : ℝ)^k)) ∧
    (1/(1 + (φ : ℝ)^k) < 1) ∧
    ((1 : ℝ)/(1/(1 + (φ : ℝ)^k)) - 1 = (φ : ℝ)^k) ∧
    (1/(1 + (φ : ℝ)^k) ≠ 1/2) :=
  ⟨(witness_in_strip k).1, (witness_in_strip k).2,
   witness_coord_is_phi_pow k,
   fun h => hk ((witness_off_line_iff k).mp h)⟩

theorem real_pair_still_inverts (β : ℝ) (h0 : 0 < β) (h1 : β < 1) :
    ((1 - β) / β) * (β / (1 - β)) = 1 := by
  have hb : β ≠ 0 := ne_of_gt h0
  have h1b : (1:ℝ) - β ≠ 0 := by linarith
  field_simp

theorem what_a_real_zero_would_imply (k : ℤ) (hk : (φ : ℝ)^k ≠ 1)
    (β : ℝ) (h0 : 0 < β) (h1 : β < 1) :
    ((1 : ℝ)/(1/(1 + (φ : ℝ)^k)) - 1 = (φ : ℝ)^k) ∧
    (1/(1 + (φ : ℝ)^k) ≠ 1/2) ∧
    (((1 - β) / β) * (β / (1 - β)) = 1) :=
  ⟨witness_coord_is_phi_pow k,
   fun h => hk ((witness_off_line_iff k).mp h),
   real_pair_still_inverts β h0 h1⟩

def ConjectureE : Prop :=
  OnTheLine (stripZeros (DirichletCharacter.LFunction chi5_D))

theorem conjectureE_unfolds :
    ConjectureE ↔ ∀ ρ : ℂ, (0 < ρ.re ∧ ρ.re < 1 ∧
      DirichletCharacter.LFunction chi5_D ρ = 0) → ρ.re = 1/2 :=
  Iff.rfl

theorem E1_iff_E2 (ρ : ℂ) (r : ℝ) (hr : 0 < r) :
    kmate ρ = ρ ↔ ρ.re = 1/2 :=
  link_six_correct ρ r hr

theorem E3_gives_E1 (h : ∀ z : Chi5Zero, z.ρ.re = 1/2) (z : Chi5Zero) :
    z.ρ.re = 1/2 := h z

theorem E4_gives_E1 (h : ConjectureE) (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1)
    (hz : DirichletCharacter.LFunction chi5_D ρ = 0) :
    ρ.re = 1/2 :=
  h ρ ⟨h0, h1, hz⟩

theorem chi5Zero_mem_stripZeros (z : Chi5Zero) :
    z.ρ ∈ stripZeros (DirichletCharacter.LFunction chi5_D) :=
  ⟨z.in_strip_pos, z.in_strip_lt, z.is_zero⟩

theorem E4_gives_E3 (h : ConjectureE) : ∀ z : Chi5Zero, z.ρ.re = 1/2 :=
  fun z => h z.ρ (chi5Zero_mem_stripZeros z)

theorem E3_gives_E4 (h : ∀ z : Chi5Zero, z.ρ.re = 1/2) : ConjectureE := by
  intro ρ hρ
  obtain ⟨h0, h1, hz⟩ := hρ
  exact h ⟨ρ, h0, h1, hz⟩

theorem E3_iff_E4 : (∀ z : Chi5Zero, z.ρ.re = 1/2) ↔ ConjectureE :=
  ⟨E3_gives_E4, E4_gives_E3⟩

theorem E_defined_and_levelled :
    ((∀ z : Chi5Zero, z.ρ.re = 1/2) ↔ ConjectureE) ∧
