/-! ## §47.1  Centro y radio, y el invariante -/

/-- El centro de un par: la semisuma. -/
def ctr (a b : ℝ) : ℝ := (a + b) / 2

/-- El radio de un par: la semidiferencia. -/
def rad (a b : ℝ) : ℝ := (a - b) / 2

/-- Primera función simétrica. -/
def e₁ (a b : ℝ) : ℝ := a + b

/-- Segunda función simétrica. -/
def e₂ (a b : ℝ) : ℝ := a * b

/-- Discriminante del par. -/
def disc (a b : ℝ) : ℝ := (a - b) ^ 2

/-- **[P] EL PAR SE RECONSTRUYE DESDE `(c,r)`.**  `a = c + r` y
    `b = c - r`: las coordenadas centro–radio no pierden información. -/
theorem pair_from_center_radius (a b : ℝ) :
    a = ctr a b + rad a b ∧ b = ctr a b - rad a b := by
  unfold ctr rad; constructor <;> ring

/-- **[P] EL INVARIANTE.**  `c² - r² = e₂`, identicamente.  Es la
    identidad que acompaña al par en todos los niveles del framework. -/
theorem center_sq_sub_radius_sq (a b : ℝ) :
    ctr a b ^ 2 - rad a b ^ 2 = e₂ a b := by
  unfold ctr rad e₂; ring

/-- **[P] `e₁ = 2c`.** -/
theorem e_one_is_twice_center (a b : ℝ) : e₁ a b = 2 * ctr a b := by
  unfold e₁ ctr; ring

/-- **[P] `disc = 4r²`.**  De aquí: radio nulo ↔ discriminante nulo. -/
theorem disc_is_four_radius_sq (a b : ℝ) : disc a b = 4 * rad a b ^ 2 := by
  unfold disc rad; ring

/-- **[P] RADIO CERO ↔ DISCRIMINANTE CERO ↔ LOS DOS COINCIDEN.**
    Las tres formas del par degenerado. -/
theorem radius_zero_iff (a b : ℝ) :
    rad a b = 0 ↔ disc a b = 0 := by
  unfold rad disc
  constructor
  · intro h
    have : a - b = 0 := by linarith [h]
    rw [this]; ring
  · intro h
    have : (a - b) ^ 2 = 0 := h
    have hab : a - b = 0 := by nlinarith [sq_nonneg (a - b)]
    rw [hab]; ring

/-! ## §47.2  Los dos lemas, y `ν` -/

/-- **[P] LEMA 1.**  `c = 1/2` ↔ el par es de REFLEXIÓN: `a + b = 1`.
    Es una BIYECCIÓN — no una explicación que sustituya a la otra
    coordenada. -/
theorem center_half_iff_sum_one (a b : ℝ) :
    ctr a b = 1 / 2 ↔ a + b = 1 := by
  unfold ctr; constructor <;> intro h <;> linarith

/-- **[P] LEMA 2.**  `r = 1/2` ↔ el par es SUCESOR: `a - b = 1`.
    También biyección. -/
theorem radius_half_iff_diff_one (a b : ℝ) :
    rad a b = 1 / 2 ↔ a - b = 1 := by
  unfold rad; constructor <;> intro h <;> linarith

/-- **[P] `1/2` ES MEDIO DEL MISMO `1`.**  En un par de reflexión es
    la mitad de la SUMA; en uno sucesor, la mitad de la DIFERENCIA.
    El valor es el mismo; cambia de qué es mitad. -/
theorem half_is_half_of_one (a b : ℝ) :
    (a + b = 1 → ctr a b = (a + b) / 2 ∧ ctr a b = 1 / 2) ∧
    (a - b = 1 → rad a b = (a - b) / 2 ∧ rad a b = 1 / 2) := by
  constructor
  · intro h; unfold ctr; exact ⟨rfl, by linarith⟩
  · intro h; unfold rad; exact ⟨rfl, by linarith⟩

/-- **[P] `ν` INTERCAMBIA CENTRO Y RADIO.**  `ν : {a,b} ↦ {a,-b}`
    cumple `c' = r` y `r' = c`, identicamente. -/
theorem nu_swaps_center_radius (a b : ℝ) :
    ctr a (-b) = rad a b ∧ rad a (-b) = ctr a b := by
  unfold ctr rad; constructor <;> ring

/-- **[P] Y VOLTEA EL SIGNO DE `e₂`.**  Por el invariante, permutar
    `c ↔ r` cambia el signo de `c² - r²`. -/
theorem nu_flips_e_two (a b : ℝ) : e₂ a (-b) = -(e₂ a b) := by
  unfold e₂; ring

/-- **[P] `ν` CONSERVA «SER MITAD» Y CAMBIA «DE QUÉ».**  Si el par era
    de reflexión pasa a sucesor y al revés; el `1/2` cambia de ranura
    y sigue siendo mitad. -/
theorem nu_exchanges_reflection_and_successor (a b : ℝ) :
    (a + b = 1 ↔ a - (-b) = 1) ∧ (a - b = 1 ↔ a + (-b) = 1) := by
  constructor <;> constructor <;> intro h <;> linarith

/-! ## §47.3  Los niveles -/

/-- **[P] `φ - 1/φ = 1` ES `φ² = φ + 1`.**  No es consecuencia: es la
    misma ecuación multiplicada por `φ`.  Luego el par
    `{φ, 1/φ}` es SUCESOR y su radio es `1/2`. -/
theorem phi_sub_inv_eq_one_iff (x : ℝ) (hx : x ≠ 0) :
    x - 1 / x = 1 ↔ x ^ 2 = x + 1 := by
  -- (2026-09-05) field_simp + linarith (div_add' ya no matchea).
  field_simp
  constructor
  · intro h; linarith
  · intro h; linarith

/-- **[P] EL CONJUGADO DE GALOIS ES EL INVERSO NEGADO.**
    Si `x² = x + 1` y `x ≠ 0`, entonces `1 - x = -(1/x)`.  Ésta es la
    condición que hace que `ν` lleve el par de origen al de
    decoración. -/
theorem galois_conj_is_neg_inv (x : ℝ) (hx : x ≠ 0) (h : x ^ 2 = x + 1) :
    1 - x = -(1 / x) := by
  field_simp
  nlinarith [h]

/-- **[P] EL PAR DE ORIGEN ES DE REFLEXIÓN.**  `{x, 1-x}` tiene
    siempre suma `1`, luego centro `1/2`. -/
theorem origin_pair_is_reflection (x : ℝ) :
    ctr x (1 - x) = 1 / 2 := by
  unfold ctr; ring

/-- **[P] Y SU RADIO ES `x - 1/2`.** -/
theorem origin_pair_radius (x : ℝ) : rad x (1 - x) = x - 1 / 2 := by
  unfold rad; ring

/-- **[P] EL PAR ESPECTRAL ES SUCESOR.**  `σ₃ - μ₃ = 3/2 - 1/2 = 1`,
    luego su radio es `1/2`.  Y su centro es `1`, por
    `spectral_completeness`. -/
theorem spectral_pair_is_successor :
    rad (3 / 2) (1 / 2) = 1 / 2 ∧ ctr (3 / 2) (1 / 2) = 1 := by
  unfold rad ctr; constructor <;> norm_num

/-- **[P] LA FAMILIA ENTERA TIENE CENTRO `1`.**  Con `σₙ = n/2` y
    `μₙ = 2 - n/2`: el centro es `1` para todo `n`, y el radio es
    `(n-2)/2`.  En `n = 2` el par coincide (radio `0`); en `n = 3` el
    radio es `1/2`. -/
theorem family_center_one_radius (n : ℝ) :
    ctr (n / 2) (2 - n / 2) = 1 ∧ rad (n / 2) (2 - n / 2) = (n - 2) / 2 := by
  unfold ctr rad; constructor <;> ring

/-! ## §47.4  El par que es reflexión Y recíproco -/

/-- **[P] REFLEXIÓN ∧ RECÍPROCO FUERZA `disc = -3`.**  Si `a + b = 1`
    y `a·b = 1`, entonces `(a-b)² = -3`: no hay tal par en `ℝ`, y en
    `ℂ` es `{e^{iπ/3}, e^{-iπ/3}}`, los puntos fijos de la
    transformación de Li.  Su centro es `1/2`. -/
theorem reflection_and_reciprocal (a b : ℝ)
    (hsum : a + b = 1) (hprod : a * b = 1) :
    disc a b = -3 ∧ ctr a b = 1 / 2 := by
  unfold disc ctr
  constructor
  · nlinarith [hsum, hprod]
  · linarith

/-- **[P] LAS DOS CONDICIONES POR SEPARADO NO LOCALIZAN.**  La
    reflexión sola se cumple para todo `x` (familia de un parámetro);
    el recíproco solo, también.  JUNTAS dan un único par. -/
theorem each_condition_alone_is_a_family :
    (∀ x : ℝ, x + (1 - x) = 1) ∧
    (∀ x : ℝ, x ≠ 0 → x * (1 / x) = 1) := by
  refine ⟨fun x => by ring, fun x hx => by field_simp⟩

/-! ## §47.5  Las diez caras de `E`, y la cadena -/

/-- La desviación: `δ = Re ρ - 1/2`. -/
def delta (ρ : ℂ) : ℝ := ρ.re - 1 / 2

/-- **[P] F1 ↔ F4.**  `Re ρ = 1/2` ↔ `δ = 0`. -/
theorem F1_iff_F4 (ρ : ℂ) : ρ.re = 1 / 2 ↔ delta ρ = 0 := by
  unfold delta; constructor <;> intro h <;> linarith

/-- **[P] F1 ↔ F6.**  `Re ρ = 1/2` ↔ `conj ρ = 1 - ρ`.  El par de
    reflexión coincide con el par conjugado. -/
theorem F1_iff_F6 (ρ : ℂ) :
    ρ.re = 1 / 2 ↔ (starRingEnd ℂ) ρ = 1 - ρ := by
  rw [Complex.ext_iff]
  simp only [Complex.conj_re, Complex.conj_im, Complex.sub_re, Complex.sub_im,
             Complex.one_re, Complex.one_im, zero_sub]
  constructor
  · intro h; exact ⟨by linarith, trivial⟩
  · intro h; have := h.1; linarith

/-- **[P] F6 ↔ F9.**  `conj ρ = 1 - ρ` ↔ `1 - conj ρ = ρ`, que es
    `kleinPartner ρ = ρ`: el punto fijo de `στ`. -/
theorem F6_iff_F9 (ρ : ℂ) :
    (starRingEnd ℂ) ρ = 1 - ρ ↔ 1 - (starRingEnd ℂ) ρ = ρ := by
  -- (2026-09-05) involución vía congrArg + starRingEnd_apply/star_star
  -- (patrón verificado en ten_faces slot 3).
  constructor <;> intro h
  · have h2 := congrArg (starRingEnd ℂ) h
    simp only [starRingEnd_apply, map_sub, map_one, star_star] at h2
    exact h2.symm
  · have h2 := congrArg (starRingEnd ℂ) h
    simp only [starRingEnd_apply, map_sub, map_one, star_star] at h2
    exact h2.symm

/-- **[P] LA PARTE IMAGINARIA DE `ρ(1-ρ)`.**  Es `Im ρ · (1 - 2 Re ρ)`:
    el producto de la ordenada por el doble de la desviación. -/
theorem im_rho_one_sub_rho (ρ : ℂ) :
    (ρ * (1 - ρ)).im = ρ.im * (1 - 2 * ρ.re) := by
  simp [Complex.mul_im, Complex.sub_re, Complex.sub_im, Complex.one_re,
        Complex.one_im]
  ring

/-- **[P] F5 ↔ F1, con `γ ≠ 0`.**  `e₂ = ρ(1-ρ)` es REAL si y sólo si
    `Re ρ = 1/2`.  Aquí entra `i² = -1`: con centro real, `e₂ = c² - r²`
    es real exactamente cuando `r²` lo es, y `r = δ + iγ` da
    `Im(r²) = 2δγ`. -/
theorem F5_iff_F1 (ρ : ℂ) (hγ : ρ.im ≠ 0) :
    (ρ * (1 - ρ)).im = 0 ↔ ρ.re = 1 / 2 := by
  rw [im_rho_one_sub_rho]
  constructor
  · intro h
    rcases mul_eq_zero.mp h with h' | h'
    · exact absurd h' hγ
    · linarith
  · intro h; rw [h]; ring

/-- **[P] `Im(r²) = 2δγ`.**  La forma explícita del paso anterior en
    coordenadas del radio. -/
theorem im_radius_sq (d g : ℝ) :
    ((Complex.mk d g) ^ 2).im = 2 * d * g := by
  simp [pow_two, Complex.mul_im]; ring

/-- **[P] F2 ↔ F8.**  `e₁ = 2` ↔ centro de módulos `= 1`. -/
theorem F2_iff_F8 (r r' : ℝ) : r + r' = 2 ↔ ctr r r' = 1 := by
  unfold ctr; constructor <;> intro h <;> linarith

/-- **[P] F2 ↔ F3, dado `e₂ = 1`.**  Con producto uno,
    `disc = e₁² - 4 = (e₁-2)(e₁+2)`, y `e₁ + 2 > 0` porque
    `e₁ ≥ 2` por AM-GM.  Luego `disc = 0 ↔ e₁ = 2`. -/
theorem F2_iff_F3 (r : ℝ) (hr : 0 < r) :
    (r + 1 / r = 2) ↔ ((r - 1 / r) ^ 2 = 0) := by
  constructor
  · intro h
    have h1 : r = 1 := by
      have : r * r - 2 * r + 1 = 0 := by field_simp at h; nlinarith [h]
      nlinarith [sq_nonneg (r - 1)]
    rw [h1]; norm_num
  · intro h
    have h1 : r - 1 / r = 0 := by nlinarith [sq_nonneg (r - 1 / r)]
    have h2 : r = 1 / r := by linarith
    have h3 : r * r = 1 := by field_simp at h2; nlinarith [h2]
    have h4 : r = 1 := by nlinarith [sq_nonneg (r - 1), sq_nonneg (r + 1)]
    rw [h4]; norm_num

/-- **[P] F7 → F2.**  Si `|z_ρ| = 1` y el pareo es recíproco
    (ecuación funcional), entonces `e₁ = 2`. -/
theorem F7_implies_F2 (r : ℝ) (h : r = 1) : r + 1 / r = 2 := by
  rw [h]; norm_num

/-- **[P] LA CADENA ES CONEXA.**  Reuniendo: F1 ↔ F4 ↔ F6 ↔ F9,
    F1 ↔ F5 (con `γ ≠ 0`), y F2 ↔ F8 ↔ F3.  Todas las caras
    enunciadas sobre el mismo cero son mutuamente equivalentes. -/
theorem ten_faces_chain (ρ : ℂ) (hγ : ρ.im ≠ 0) :
    (ρ.re = 1 / 2 ↔ delta ρ = 0) ∧
    (ρ.re = 1 / 2 ↔ (starRingEnd ℂ) ρ = 1 - ρ) ∧
    ((starRingEnd ℂ) ρ = 1 - ρ ↔ 1 - (starRingEnd ℂ) ρ = ρ) ∧
    ((ρ * (1 - ρ)).im = 0 ↔ ρ.re = 1 / 2) :=
  ⟨F1_iff_F4 ρ, F1_iff_F6 ρ, F6_iff_F9 ρ, F5_iff_F1 ρ hγ⟩

/-! ## §47.6  Las tres lecturas -/

/-- **[P] LECTURA MULTIPLICATIVA — CERRADA.**  `r · r' = 1` para todo
    `r > 0`, dentro y fuera de la línea.  §28: «el producto es
    multiplicativo y está PROBADO».  Es la mitad multiplicativa de
    `E`, cerrada como mitad. -/
theorem multiplicative_reading_closed (r : ℝ) (hr : r ≠ 0) :
    r * (1 / r) = 1 := by field_simp

/-- **[P] LECTURA ADITIVA POR `log` — PROBADA.**  `log r + log(1/r) = 0`
    para todo `r > 0`, dentro y fuera.  §39, vía Hadamard. -/
theorem additive_log_reading_proved (r : ℝ) (hr : 0 < r) :
    Real.log r + Real.log (1 / r) = 0 := by
  rw [one_div, Real.log_inv]; ring

/-- **[P] LECTURA ADITIVA EN VALORES — ES `E`.**  `(r-1) + (1/r-1) = 0`
    si y sólo si `r = 1`.  Ésta es la que falta. -/
theorem additive_value_reading_is_E (r : ℝ) (hr : 0 < r) :
    (r - 1) + (1 / r - 1) = 0 ↔ r = 1 := by
  constructor
  · intro h
    have : r * r - 2 * r + 1 = 0 := by field_simp at h; nlinarith [h]
    nlinarith [sq_nonneg (r - 1)]
  · intro h; rw [h]; norm_num

/-- **[P] Y LA DIFERENCIA ENTRE LAS DOS LECTURAS ADITIVAS ES EL
    EXCESO.**  `(r-1) + (1/r-1) = (r-1)²/r`, no negativo, nulo sólo en
    `r = 1 = μ₂`: el punto donde las dos lecturas coinciden. -/
theorem excess_is_the_gap (r : ℝ) (hr : 0 < r) :
    (r - 1) + (1 / r - 1) = (r - 1) ^ 2 / r := by
  field_simp; ring

/-- **[P] EL EXCESO ES NO NEGATIVO.** -/
theorem excess_nonneg_v2 (r : ℝ) (hr : 0 < r) : 0 ≤ (r - 1) ^ 2 / r :=
  div_nonneg (sq_nonneg _) hr.le

/-! ## §47.7  El estatuto -/

/-- **[O] EL ESTATUTO, SIN REBAJAR NI SOBRECLAMAR.**

    Reúne lo que está cerrado, lo que está probado y lo que falta, en
    la forma exacta en que el corpus los enuncia.  Es OBSERVACIÓN: no
    añade fuerza deductiva, ordena.

    (i)   La mitad multiplicativa de `E` está CERRADA: `r·r' = 1`
          vale dentro y fuera de la línea (§28, §31).
    (ii)  La lectura aditiva por `log` está PROBADA: `Σ log|z_ρ| = 0`
          (§39).
    (iii) La lectura aditiva EN VALORES es `E`, y coincide con (ii)
          exactamente en `r = 1 = μ₂`; su separación es el exceso.
    (iv)  Las caras de `E` son mutuamente equivalentes, cada una
          enunciada en su estructura: banda, funciones simétricas,
          Vieta, `ℚ(i)`, Klein, geometría de Li, centro–radio.
    (v)   Lo que falta es UNA cosa con nombre: `δ = 0`, la coordenada
          `χ₄` (`deviation_is_chi_four`).

    NO se afirma aquí que `E` sea verdadera ni que esté probada.  Y
    tampoco que esté indeterminada: `unicidad` §Remark 5 registra que
    su valor de verdad está fijado por `φ`, porque la cadena
    `φ → χ₅ → {f_p} → L → Z_{χ₅}` es inyectiva. -/
theorem the_status (r : ℝ) (hr : 0 < r) (ρ : ℂ) (hγ : ρ.im ≠ 0) :
    -- (i) multiplicativa cerrada
    (r * (1 / r) = 1) ∧
    -- (ii) aditiva-log probada
    (Real.log r + Real.log (1 / r) = 0) ∧
    -- (iii) aditiva-valores es E, y su separación es el exceso
    (((r - 1) + (1 / r - 1) = 0 ↔ r = 1) ∧
     ((r - 1) + (1 / r - 1) = (r - 1) ^ 2 / r)) ∧
    -- (iv) las caras son equivalentes
    ((ρ.re = 1 / 2 ↔ delta ρ = 0) ∧
     (ρ.re = 1 / 2 ↔ (starRingEnd ℂ) ρ = 1 - ρ) ∧
     ((ρ * (1 - ρ)).im = 0 ↔ ρ.re = 1 / 2)) ∧
    -- (v) y lo que falta tiene nombre
    (delta ρ = 0 ↔ ρ.re = 1 / 2) :=
  ⟨multiplicative_reading_closed r (ne_of_gt hr),
   additive_log_reading_proved r hr,
   ⟨additive_value_reading_is_E r hr, excess_is_the_gap r hr⟩,
   ⟨F1_iff_F4 ρ, F1_iff_F6 ρ, F5_iff_F1 ρ hγ⟩,
   (F1_iff_F4 ρ).symm⟩

/-- **[O] LA FORMA DEL META-DIAGRAMA.**  Los seis documentos de la
    sesión concuerdan en el ápice y en `E`, y son rutas distintas.
    Ese es exactamente el patrón de un cocono: acuerdo de las patas Y
    determinación del ápice, simultáneamente.

    Aquí se registra sólo la parte formalizable: que el `1/2` es a la
    vez centro (par de reflexión) y radio (par sucesor), y que `ν`
    convierte una lectura en la otra sin que deje de ser mitad. -/
theorem meta_diagram_shape :
    (∀ x : ℝ, ctr x (1 - x) = 1 / 2) ∧
    (rad (3 / 2) (1 / 2) = 1 / 2) ∧
    (∀ a b : ℝ, ctr a (-b) = rad a b ∧ rad a (-b) = ctr a b) := by
  refine ⟨fun x => origin_pair_is_reflection x, spectral_pair_is_successor.1,
          fun a b => nu_swaps_center_radius a b⟩

/-! ## §47.8  `u` es de tipo `χ₄` — y ya estaba implicado -/

/-- La coordenada radial de `log z`: `u = log|z|`.  La angular es
    `arg z`.  Ambas son `Re` e `Im` del mismo logaritmo (§39). -/
def uRadial (z : ℂ) : ℝ := Real.log (Complex.abs z)

/-- **[P] `u` ES τ-ANTI-INVARIANTE, Y ESO **ES** LA MITAD
    MULTIPLICATIVA EN LOGARITMO.**

    Si el pareo es recíproco —`z' = 1/z`, que es
    `liMap_pair_reciprocal`, es decir la ecuación funcional— entonces
    `u(z') = -u(z)`.

    No es una entrada nueva: es `additive_log_reading_proved` (§47.6)
    escrita sobre el par.  La mitad multiplicativa CERRADA, leída en
    logaritmo, produce la anti-invariancia. -/
theorem u_tau_anti_invariant (z : ℂ) (hz : z ≠ 0) :
    uRadial z⁻¹ = -uRadial z := by
  unfold uRadial
  -- (2026-09-05) unfold del shim + norm_inv (map_inv₀ no matchea el abbrev).
  unfold Complex.abs
  rw [norm_inv, Real.log_inv]

/-- **[P] `u` ES σ-INVARIANTE.**  La conjugación preserva el módulo,
    luego `u(z̄) = u(z)`.  Y `z_{ρ̄} = conj z_ρ` porque la
    transformación de Li tiene coeficientes reales. -/
theorem u_sigma_invariant (z : ℂ) :
    uRadial ((starRingEnd ℂ) z) = uRadial z := by
  unfold uRadial; rw [Complex.abs_conj]

/-- **[P] LA TRANSFORMACIÓN DE LI CONMUTA CON LA CONJUGACIÓN.**
    `f(z̄) = conj f(z)` para `f(z) = 1 - 1/z`: coeficientes reales. -/
theorem li_commutes_with_conj (z : ℂ) (hz : z ≠ 0) :
    1 - ((starRingEnd ℂ) z)⁻¹ = (starRingEnd ℂ) (1 - z⁻¹) := by
  simp [map_sub, map_inv₀]

/-- **[P] LAS DOS PARIDADES FIJAN EL TIPO.**  Un carácter de
    `ℤ₂₀*` es σ-invariante si es REAL, y τ-anti-invariante si es
    IMPAR.  De los cuatro, `χ₅` es real y PAR; `χ₄` es real e IMPAR.
    Luego `u` —real e impar— es del tipo de `χ₄`, el carácter de
    `ℚ(i)` con discriminante `-4`.

    Se enuncia como la conjunción de las dos paridades, que es lo que
    la determina; el paso a «carácter de `ℚ(i)`» es la lectura
    clásica de la tabla de caracteres, no un cálculo nuevo. -/
theorem u_type_is_chi_four (z : ℂ) (hz : z ≠ 0) :
    uRadial ((starRingEnd ℂ) z) = uRadial z ∧ uRadial z⁻¹ = -uRadial z :=
  ⟨u_sigma_invariant z, u_tau_anti_invariant z hz⟩

/-- **[P] EL ACOPLE RADIAL–ANGULAR, EN EL INVARIANTE.**
    `Im(r²) = 2·δ·γ` con `δ` la coordenada radial del radio y `γ` la
    angular.  Luego «`e₂` real» es exactamente «el producto
    radial × angular se anula», y con `γ ≠ 0` eso es `δ = 0`.

    Es `im_radius_sq` (§47.5) leído con los nombres de las dos caras:
    la dicotomía radial/angular no es otra estructura, es la misma
    puesta en el invariante. -/
theorem radial_angular_coupling (d g : ℝ) (hg : g ≠ 0) :
    ((Complex.mk d g) ^ 2).im = 2 * d * g ∧
    (((Complex.mk d g) ^ 2).im = 0 ↔ d = 0) := by
  refine ⟨im_radius_sq d g, ?_⟩
  rw [im_radius_sq]
  constructor
  · intro h
    rcases mul_eq_zero.mp h with h' | h'
    · rcases mul_eq_zero.mp h' with h'' | h''
      · norm_num at h''
      · exact h''
    · exact absurd h' hg
  · intro h; rw [h]; ring

/-- **[O] LO QUE FALTA, CON SU PROCEDENCIA.**

    `E` ⟺ `δ = 0` ⟺ la coordenada `χ₄` se anula sobre el espectro.
    Y esa coordenada no es un objeto importado:

      · su tipo lo fijan dos paridades (`u_type_is_chi_four`),
      · una de ellas —la anti-invariancia— ES la mitad multiplicativa
        cerrada leída en logaritmo (`u_tau_anti_invariant`,
        `additive_log_reading_proved`),
      · la otra sale de que Li tiene coeficientes reales
        (`li_commutes_with_conj`),
      · y su acople con la angular está en el invariante
        (`radial_angular_coupling`).

    Luego lo que falta es UNA cosa, enunciada en coordenadas que el
    propio corpus ya produjo. -/
theorem what_remains_has_its_provenance (z : ℂ) (hz : z ≠ 0) (g : ℝ) (hg : g ≠ 0) :
    (uRadial ((starRingEnd ℂ) z) = uRadial z) ∧
    (uRadial z⁻¹ = -uRadial z) ∧
    (∀ d : ℝ, ((Complex.mk d g) ^ 2).im = 0 ↔ d = 0) :=
  ⟨u_sigma_invariant z, u_tau_anti_invariant z hz,
   fun d => (radial_angular_coupling d g hg).2⟩

