theorem the_two_halves_squeeze (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|)
    (hchain : inChain (discP (zeroCoord ρ))) :
    ρ.re = 1/2 := by
  have hle : discP (zeroCoord ρ) ≤ 1/12 := discBound_of_high_gamma ρ h0 h1 hγ
  have hz : discP (zeroCoord ρ) = 0 :=
    chain_gap_is_unity _ hchain (by linarith)
  exact (disc_zero_iff_half ρ h0 h1).mp hz

theorem the_squeeze_gives_the_embedding (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|)
    (hchain : inChain (discP (zeroCoord ρ))) :
    (ρ.re = 1/2 ∨ ρ.re = -(1/4)) := by
  left
  exact the_two_halves_squeeze ρ h0 h1 hγ hchain

theorem the_hypothesis_reduces_to_integrality (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|) :
    -- la mitad de la COTA, incondicional, de la altura
    (discP (zeroCoord ρ) ≤ 1/12) ∧
    -- la mitad de la BRECHA, incondicional, de ℕ
    (∀ d : ℝ, inChain d → d < 1 → d = 0) ∧
    -- y el squeeze, que sólo pide integralidad
    ((inChain (discP (zeroCoord ρ))) → ρ.re = 1/2) ∧
    -- que es la MISMA condición de descenso en otra coordenada
    ((inChain (discP (zeroCoord ρ))) ↔ ρ.re = 1/2) ∧
    ((∃ k : ℤ, zeroCoord ρ = (φ : ℝ) ^ k) → ρ.re = 1/2) :=
  ⟨discBound_of_high_gamma ρ h0 h1 hγ,
   fun d hc hlt => chain_gap_is_unity d hc hlt,
   fun hc => the_two_halves_squeeze ρ h0 h1 hγ hc,
   membership_is_E_in_disguise ρ h0 h1 hγ,
   monomial_would_close_it ρ h0 h1 hγ⟩

theorem discP_is_the_quadratic_discriminant (r : ℝ) (hr : r ≠ 0) :
