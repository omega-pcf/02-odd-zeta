/-! ## §126.1  El centro de toda órbita -/

/-- El centro del par de reflexión. -/
def ctr₉ (a b : ℂ) : ℂ := (a + b) / 2

/-- El radio del par de reflexión. -/
def rad₉ (a b : ℂ) : ℂ := (a - b) / 2

/-- **[P] EL CENTRO ES `1/2`, PARA TODO `ρ`.**  Sin hipótesis: es la
    simetría `τ`.  Restatement de `center_is_half_always` (§77). -/
theorem centre_is_half_always (ρ : ℂ) : ctr₉ ρ (1 - ρ) = 1 / 2 := by
  unfold ctr₉; ring

/-- **[P] Y EL RADIO ES `ρ − 1/2`.**  Sobre los ceros,
    `radio = δ + iγ`. -/
theorem radius_is_rho_minus_half (ρ : ℂ) : rad₉ ρ (1 - ρ) = ρ - 1 / 2 := by
  unfold rad₉; ring

/-! ## §126.2  Y coincide con la posición espectral -/

/-- **[C] LA POSICIÓN ESPECTRAL POSITIVA.**  `specPos 0 = 1/2`
    ---pata 2 del cocono, §79. -/
def PositiveSpectralPosition (p : ℝ) : Prop := p = 1 / 2

/-- **[P] EL CENTRO DE TODA ÓRBITA **ES** LA POSICIÓN ESPECTRAL.**

    **Éste es el embedding, a nivel de órbita, y está probado para
    todo cero sin hipótesis.** -/
theorem orbit_centre_is_the_spectral_position (ρ : ℂ) (p : ℝ)
    (hp : PositiveSpectralPosition p) :
    (ctr₉ ρ (1 - ρ)).re = p := by
  unfold PositiveSpectralPosition at hp
  rw [centre_is_half_always ρ, hp]
  simp

/-- **[P] Y NO DEPENDE DEL CERO.**  Dos ceros cualesquiera tienen el
    centro de órbita en el mismo punto. -/
theorem centre_independent_of_the_zero (ρ σ : ℂ) :
    ctr₉ ρ (1 - ρ) = ctr₉ σ (1 - σ) := by
  rw [centre_is_half_always ρ, centre_is_half_always σ]

/-! ## §126.3  Y `E` es que el radio tenga parte real nula -/

/-- **[P] `E` ⟺ `Re(radio) = 0`.**  Con el centro ya en el espectro,
    lo que falta es que la órbita se contraiga a él. -/
theorem E_iff_radius_real_part_zero (ρ : ℂ) :
    (rad₉ ρ (1 - ρ)).re = 0 ↔ ρ.re = 1 / 2 := by
  rw [radius_is_rho_minus_half]
  simp only [one_div, Complex.sub_re, Complex.inv_re, Complex.re_ofNat,
    Complex.normSq_ofNat, div_self_mul_self']
  constructor
  · intro h; linarith
  · intro h; rw [h]; ring

/-- **[P] LA COMPOSICIÓN.**  El centro está en el espectro ---probado
    para todo cero--- y `E` es la anulación de la parte real del
    radio.

    **Cinco pasos probados, uno abierto, y el abierto tiene forma
    geométrica: la contracción de la órbita a su centro.** -/
theorem cocone_gives_the_orbit_embedding (ρ : ℂ) (p : ℝ)
    (hp : PositiveSpectralPosition p) :
    ((ctr₉ ρ (1 - ρ)).re = p) ∧
    (rad₉ ρ (1 - ρ) = ρ - 1 / 2) ∧
    ((rad₉ ρ (1 - ρ)).re = 0 ↔ ρ.re = 1 / 2) :=
  ⟨orbit_centre_is_the_spectral_position ρ p hp,
   radius_is_rho_minus_half ρ, E_iff_radius_real_part_zero ρ⟩

/-! ## §126.4  El balance -/

/-- **[O] EL BALANCE DE §126.**

    | nivel | enunciado | estatuto |
    |---|---|---|
    | ÓRBITA | `ctr(órbita) = specPos 0` | **PROBADO, ∀ cero** |
    | PUNTO | `Re ρ = specPos 0` | **es `E`** |
    | la diferencia | `Re(radio)` | `0` o no |

    **El cocono SÍ genera el embedding** ---de la órbita---, vía el
    ancla: `Λ(0)=Λ(1)` cierra `Z` bajo `τ`, y entonces el centro de
    cada órbita cae exactamente en la posición espectral.

    Decir «no lo genera» era mirar el nivel de punto ignorando el de
    órbita, que es donde `V` actúa y donde el cocono opera. -/
theorem the_balance_of_section_126 (ρ σ : ℂ) (p : ℝ)
    (hp : PositiveSpectralPosition p) :
    ((ctr₉ ρ (1 - ρ)).re = p) ∧
    (ctr₉ ρ (1 - ρ) = ctr₉ σ (1 - σ)) ∧
    ((rad₉ ρ (1 - ρ)).re = 0 ↔ ρ.re = 1 / 2) :=
  ⟨orbit_centre_is_the_spectral_position ρ p hp,
   centre_independent_of_the_zero ρ σ,
   E_iff_radius_real_part_zero ρ⟩

