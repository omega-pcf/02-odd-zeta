  zero_mul x := by ext <;> simp
  mul_zero x := by ext <;> simp
  left_distrib x y z := by ext <;> simp <;> ring
  right_distrib x y z := by ext <;> simp <;> ring
  mul_comm x y := by ext <;> simp <;> ring
  neg_add_cancel x := by ext <;> simp
  sub_eq_add_neg x y := by ext <;> simp [sub_eq_add_neg]
  nsmul := nsmulRec
  zsmul := zsmulRec
  natCast_zero := by ext <;> simp
  natCast_succ n := by ext <;> simp
  intCast_ofNat n := by ext <;> simp
  intCast_negSucc n := by ext <;> simp [Int.negSucc_eq] <;> ring

/-- La raíz ω. -/
def ω : Q R := ⟨0, 1⟩
@[simp] lemma ω_a : (ω : Q R).a = 0 := rfl
@[simp] lemma ω_b : (ω : Q R).b = 1 := rfl

theorem ω_sq : (ω : Q R) ^ 2 = ω + 1 := by ext <;> simp [pow_two]

/-- La inclusión de los escalares. -/
def sc : R →+* Q R where
  toFun r := ⟨r, 0⟩
  map_one' := rfl
  map_mul' x y := by ext <;> simp
  map_zero' := rfl
  map_add' x y := by ext <;> simp
@[simp] lemma sc_a (r : R) : (sc r : Q R).a = r := rfl
@[simp] lemma sc_b (r : R) : (sc r : Q R).b = 0 := rfl

theorem eq_coord (x : Q R) : x = sc x.a + sc x.b * ω := by ext <;> simp

/-- La conjugación σ : ω ↦ 1 − ω. -/
def σ : Q R →+* Q R where
  toFun x := ⟨x.a + x.b, -x.b⟩
  map_one' := by ext <;> simp
  map_mul' x y := by ext <;> simp <;> ring
  map_zero' := by ext <;> simp
  map_add' x y := by ext <;> simp <;> ring

theorem σ_ω : σ (ω : Q R) = 1 - ω := by ext <;> simp [σ]
theorem σ_C (r : R) : σ (sc r) = sc r := by ext <;> simp [σ]

end Q

open Q

/-- ℤ[φ] en coordenadas. -/
abbrev Zφ := Q ℤ

theorem sc_int (n : ℤ) : (sc n : Zφ) = (n : Zφ) := by ext <;> simp

/-- Un morfismo de anillos desde ℤ[φ] queda fijado por la imagen de ω. -/
theorem hom_ext {S : Type*} [CommRing S] (f g : Zφ →+* S) (h : f ω = g ω) : f = g := by
  ext x
  rw [eq_coord x, sc_int, sc_int]
  simp only [map_add, map_mul, map_intCast, h]

/-- **Solo dos endomorfismos.**  Todo endomorfismo de ℤ[φ] manda ω a ω o a 1 − ω. -/
theorem endo_dichotomy (f : Zφ →+* Zφ) : f ω = ω ∨ f ω = 1 - ω := by
  set u := f ω with hu
  have hsq : u * u = u + 1 := by
    have := congrArg f (show (ω : Zφ) * ω = ω + 1 by rw [← pow_two]; exact ω_sq)
    simpa [map_mul, map_add, map_one] using this
  have ha : u.a * u.a + u.b * u.b = u.a + 1 := by
    have := congrArg Q.a hsq; simpa using this
  have hb : u.a * u.b + u.b * u.a + u.b * u.b = u.b := by
    have := congrArg Q.b hsq; simpa using this
  have hfac : u.b * (2 * u.a + u.b - 1) = 0 := by linear_combination hb
  rcases mul_eq_zero.mp hfac with h0 | h1
  · exfalso
    rw [h0] at ha
    have hlo : 0 ≤ u.a := by nlinarith
    have hhi : u.a ≤ 1 := by nlinarith
    interval_cases (u.a) <;> omega
  · have hbv : u.b = 1 - 2 * u.a := by linear_combination h1
    rw [hbv] at ha
    have : u.a * (u.a - 1) = 0 := by nlinarith
    rcases mul_eq_zero.mp this with h | h
    · left; ext <;> simp [hbv, h]
    · right
      have h' : u.a = 1 := by linarith
      ext <;> simp [hbv, h']

/-! ## 2. Reducción módulo p -/

/-- La reducción ℤ[φ] → (ℤ/p)[φ]. -/
def red (p : ℕ) : Zφ →+* Q (ZMod p) where
  toFun x := ⟨x.a, x.b⟩
  map_one' := by ext <;> simp
  map_mul' x y := by ext <;> simp
  map_zero' := by ext <;> simp
  map_add' x y := by ext <;> simp

@[simp] lemma red_a (p : ℕ) (x : Zφ) : (red p x).a = (x.a : ZMod p) := rfl
@[simp] lemma red_b (p : ℕ) (x : Zφ) : (red p x).b = (x.b : ZMod p) := rfl

theorem red_ω (p : ℕ) : red p (ω : Zφ) = ω := by ext <;> simp

/-- Ser cero módulo p es estar en el ideal p·ℤ[φ]. -/
theorem red_eq_zero_iff (p : ℕ) (x : Zφ) :
    red p x = 0 ↔ x ∈ Ideal.span {((p : ℤ) : Zφ)} := by
  rw [Ideal.mem_span_singleton]
  constructor
  · intro h
    have ha := congrArg Q.a h; have hb := congrArg Q.b h
    simp only [red_a, red_b, zero_a, zero_b, ZMod.intCast_zmod_eq_zero_iff_dvd] at ha hb
    obtain ⟨u, hu⟩ := ha; obtain ⟨v, hv⟩ := hb
    exact ⟨⟨u, v⟩, by ext <;> simp [hu, hv]⟩
  · rintro ⟨y, rfl⟩
    ext <;> simp

instance (p : ℕ) : CharP (Q (ZMod p)) p :=
  ⟨fun n => by
    constructor
    · intro h
      have := congrArg Q.a h
      simpa [ZMod.natCast_eq_zero_iff] using this
    · intro h
      ext
      · simpa [ZMod.natCast_eq_zero_iff] using h
      · simp⟩

/-- Identidad de Binet en cualquier anillo conmutativo con α² = α + 1. -/
theorem fib_pow_aux {R : Type*} [CommRing R] (α : R) (hα : α ^ 2 = α + 1) :
    ∀ n : ℕ, α ^ (n + 1) = (Nat.fib (n + 1) : R) * α + (Nat.fib n : R) := by
  intro n
  induction n with
  | zero => simp [Nat.fib_one, Nat.fib_zero]
  | succ k ih =>
    calc α ^ (k + 2)
        = α ^ (k + 1) * α := by ring
      _ = ((Nat.fib (k + 1) : R) * α + (Nat.fib k : R)) * α := by rw [ih]
      _ = (Nat.fib (k + 1) : R) * α ^ 2 + (Nat.fib k : R) * α := by ring
      _ = (Nat.fib (k + 1) : R) * (α + 1) + (Nat.fib k : R) * α := by rw [hα]
      _ = ((Nat.fib (k + 1) + Nat.fib k : ℕ) : R) * α + (Nat.fib (k + 1) : R) := by
            push_cast; ring
      _ = (Nat.fib (k + 2) : R) * α + (Nat.fib (k + 1) : R) := by
            rw [add_comm (Nat.fib (k + 1)) (Nat.fib k), ← Nat.fib_add_two]

theorem fib_pow_prime {p : ℕ} (hp : p.Prime) {R : Type*} [CommRing R]
    (α : R) (hα : α ^ 2 = α + 1) :
    α ^ p = (Nat.fib p : R) * α + (Nat.fib (p - 1) : R) := by
  have hp_gt : 1 ≤ p := hp.pos
  have hp1 : p = (p - 1) + 1 := by omega
  conv_lhs => rw [hp1]
  have hidx : Nat.fib ((p - 1) + 1) = Nat.fib p := by congr 1; omega
  calc α ^ ((p - 1) + 1)
      = (Nat.fib ((p - 1) + 1) : R) * α + (Nat.fib (p - 1) : R) :=
        fib_pow_aux α hα (p - 1)
    _ = (Nat.fib p : R) * α + (Nat.fib (p - 1) : R) := by rw [hidx]

theorem five_ne_zero_zmod {p : ℕ} (hp : p.Prime) (hp5 : p ≠ 5) :
    (5 : ZMod p) ≠ 0 := by
  have : Fact p.Prime := ⟨hp⟩
  change ((5 : ℕ) : ZMod p) ≠ 0
  rw [Ne, ZMod.natCast_eq_zero_iff]
  intro hdvd
  rcases (show Nat.Prime 5 from by norm_num).eq_one_or_self_of_dvd p hdvd with h1 | h5
  · have : 2 ≤ p := hp.two_le
    omega
  · exact hp5 h5

/-- **Caso split.**  Si X² − X − 1 tiene raíz α ∈ Z_p, entonces F_p ≡ 1 (mod p). -/
theorem fib_split_case {p : ℕ} (hp : p.Prime) (_hp2 : p ≠ 2) (hp5 : p ≠ 5)
    (α : ZMod p) (hα : α ^ 2 = α + 1) :
    (Nat.fib p : ZMod p) = 1 := by
  have : Fact p.Prime := ⟨hp⟩
  have hβ  : (1 - α) ^ 2 = (1 - α) + 1 := by linear_combination hα
  have hfα : α ^ p = (Nat.fib p : ZMod p) * α + (Nat.fib (p-1) : ZMod p) :=
    fib_pow_prime hp α hα
  have hfβ : (1-α) ^ p = (Nat.fib p : ZMod p) * (1-α) + (Nat.fib (p-1) : ZMod p) :=
    fib_pow_prime hp (1 - α) hβ
  have heqα : (Nat.fib p : ZMod p) * α + (Nat.fib (p-1) : ZMod p) = α := by
    rw [← hfα]; exact ZMod.pow_card α
  have heqβ : (Nat.fib p : ZMod p) * (1-α) + (Nat.fib (p-1) : ZMod p) = 1 - α := by
    rw [← hfβ]; exact ZMod.pow_card (1 - α)
  have hdiff : ((Nat.fib p : ZMod p) - 1) * (2 * α - 1) = 0 := by
    linear_combination heqα - heqβ
  have h2α1_sq : (2 * α - 1) ^ 2 = (5 : ZMod p) := by linear_combination 4 * hα
  have h2α1_ne : 2 * α - 1 ≠ 0 := by
    intro h
    have : ((2 : ZMod p) * α - 1) ^ 2 = 0 := by rw [h]; ring
    rw [h2α1_sq] at this
    exact five_ne_zero_zmod hp hp5 this
  rcases mul_eq_zero.mp hdiff with hfp | h2
  · exact sub_eq_zero.mp hfp
  · exact absurd h2 h2α1_ne

set_option maxHeartbeats 1000000 in -- el Frobenius sobre GF(p²) dispara el límite
/-- **Caso inert.**  Si X² − X − 1 es irreducible en Z_p[X], F_p ≡ −1 (mod p).
    Vía GF(p²) = AdjoinRoot(X²−X−1) y el Frobenius. -/
theorem fib_inert_case {p : ℕ} (hp : p.Prime) (_hp2 : p ≠ 2) (_hp5 : p ≠ 5)
    (hirr : Irreducible (X ^ 2 - X - 1 : (ZMod p)[X])) :
    (Nat.fib p : ZMod p) = p - 1 := by
  have hFact : Fact p.Prime := ⟨hp⟩
  let K := AdjoinRoot (X ^ 2 - X - 1 : (ZMod p)[X])
  have : Fact (Irreducible (X ^ 2 - X - 1 : (ZMod p)[X])) := ⟨hirr⟩
  have hKChar : CharP K p :=
    charP_of_injective_algebraMap (algebraMap (ZMod p) K).injective p
  let α : K := AdjoinRoot.root _
  have hα_sq : α ^ 2 = α + 1 := by
    have h : Polynomial.aeval α (X ^ 2 - X - 1 : (ZMod p)[X]) = 0 :=
      AdjoinRoot.eval₂_root _
    simp only [map_sub, map_pow, map_one, Polynomial.aeval_X] at h
    linear_combination h
  -- Paso 1: (α^p)² = α^p + 1  (freshman's dream)
  have hαp_root : (α ^ p) ^ 2 = α ^ p + 1 := by
    calc (α ^ p) ^ 2
        = (α ^ 2) ^ p := by ring
      _ = (α + 1) ^ p := by rw [hα_sq]
      _ = α ^ p + 1 ^ p := add_pow_char (p := p) α 1
      _ = α ^ p + 1 := by ring
  -- Paso 2: X² − X − 1 no tiene raíces en Z_p
  have hirr_no_root : ∀ c : ZMod p, c ^ 2 ≠ c + 1 := by
    intro c hc
    have hkey : c - c ^ 2 = -1 := by linear_combination -hc
    have hfact : (X ^ 2 - X - 1 : (ZMod p)[X]) = (X - C c) * (X - C (1 - c)) := by
      have hrw : (X - C c) * (X - C (1 - c)) = X ^ 2 - X + C (c - c ^ 2) := by
        simp only [map_sub, map_pow, map_one]
        ring
      rw [hrw, hkey]
      simp only [map_neg, map_one]
      ring
    have hnu : ∀ d : ZMod p, ¬ IsUnit (X - C d : (ZMod p)[X]) := by
      intro d hu
      obtain ⟨u, _, hu_eq⟩ := Polynomial.isUnit_iff.mp hu
      have h1 : natDegree (C u) = natDegree (X - C d) := congr_arg natDegree hu_eq
      rw [natDegree_C, natDegree_X_sub_C] at h1
      contradiction
    rcases hirr.isUnit_or_isUnit hfact with h | h
    · exact hnu c h
    · exact hnu (1 - c) h
  have hinj : Function.Injective (algebraMap (ZMod p) K) :=
    (algebraMap (ZMod p) K).injective
  -- Paso 3: α^p ≠ α
  have hαp_ne : α ^ p ≠ α := by
    intro heq
    have hXpX : (X ^ p - X : (ZMod p)[X]) = ∏ a : ZMod p, (X - C a) := by
      have hdeg : degree (X ^ p - X : (ZMod p)[X]) = p := by
        have h1 : degree (X : (ZMod p)[X]) < degree ((X ^ p : (ZMod p)[X])) := by
          rw [degree_X_pow, degree_X]
          exact_mod_cast hp.one_lt
        rw [degree_sub_eq_left_of_degree_lt h1, degree_X_pow]
      have hnat : natDegree (X ^ p - X : (ZMod p)[X]) = p :=
        natDegree_eq_of_degree_eq_some hdeg
      have hmonic : Monic (X ^ p - X : (ZMod p)[X]) := by
        rw [Monic, leadingCoeff, hnat]
        have hcs := coeff_sub (X ^ p : (ZMod p)[X]) (X : (ZMod p)[X]) p
        have hcp := coeff_X_pow (R := ZMod p) p p
        have hcx := coeff_X (R := ZMod p) (n := p)
        rw [hcs, hcp, hcx, if_pos (rfl : p = p),
            if_neg (Nat.ne_of_lt hp.one_lt), sub_zero]
      have hroots : roots (X ^ p - X : (ZMod p)[X]) = (Finset.univ : Finset (ZMod p)).val := by
        have h := FiniteField.roots_X_pow_card_sub_X (ZMod p)
        simpa [ZMod.card] using h
      have hcard : (Finset.univ : Finset (ZMod p)).val.card = p := by
        have h := Finset.card_univ (α := ZMod p)
        rwa [Finset.card_def, ZMod.card] at h
      have hsplits : Splits (X ^ p - X : (ZMod p)[X]) := by
        rw [splits_iff_card_roots, hroots, hcard]
        exact hnat.symm
      rw [hsplits.eq_prod_roots_of_monic hmonic, hroots]
      rfl
    have haeval : (Polynomial.aeval (R := (ZMod p)) α) (X ^ p - X : (ZMod p)[X]) = 0 := by
      rw [map_sub, map_pow, Polynomial.aeval_X]
      rw [heq]; ring
    rw [hXpX, map_prod (g := (Polynomial.aeval α : (ZMod p)[X] →ₐ[(ZMod p)] K))] at haeval
    obtain ⟨c, _, hc⟩ := (Finset.prod_eq_zero_iff).mp haeval
    rw [map_sub, Polynomial.aeval_X, Polynomial.aeval_C] at hc
    have hα_eq : α = algebraMap (ZMod p) K c := eq_of_sub_eq_zero hc
    have hc_sq : c ^ 2 = c + 1 := by
      apply hinj
      rw [map_pow, map_add, map_one, ← hα_eq]
      exact hα_sq
    exact hirr_no_root c hc_sq
  -- Paso 4: α^p = 1 − α
  have hfrob : α ^ p = 1 - α := by
    have hprod : (α ^ p - α) * (α ^ p - (1 - α)) = 0 := by
      linear_combination hαp_root - hα_sq
    rcases mul_eq_zero.mp hprod with h | h
    · exact absurd (sub_eq_zero.mp h) hαp_ne
    · exact sub_eq_zero.mp h
  have hfib_K : (Nat.fib p : K) * α + (Nat.fib (p - 1) : K) = 1 - α :=
    (fib_pow_prime hp α hα_sq).symm ▸ hfrob
  -- Paso 5: F_p ≡ −1 (mod p)
  have hFp : (Nat.fib p : ZMod p) = -1 := by
    by_contra hne
    have hFp1_ne : (Nat.fib p : ZMod p) + 1 ≠ 0 := fun h => hne (by linear_combination h)
    have hFp1_K : (Nat.fib p : K) + 1 ≠ 0 := by
      intro h; apply hFp1_ne; apply hinj
      push_cast [map_add, map_one]; exact h
    have hlin : ((Nat.fib p : K) + 1) * α = 1 - (Nat.fib (p - 1) : K) := by
      linear_combination hfib_K
    set c : ZMod p := (1 - (Nat.fib (p - 1) : ZMod p)) / ((Nat.fib p : ZMod p) + 1)
    have hα_c : α = algebraMap (ZMod p) K c := by
      rw [show c = (1 - (Nat.fib (p - 1) : ZMod p)) / ((Nat.fib p : ZMod p) + 1)
            from rfl]
      rw [map_div₀, map_sub, map_one, map_add, map_one, map_natCast, map_natCast]
      exact eq_div_of_mul_eq hFp1_K (by rw [mul_comm]; exact hlin)
    have hc_sq : c ^ 2 = c + 1 := by
      apply hinj
      rw [map_pow, map_add, map_one, ← hα_c]
      exact hα_sq
    exact hirr_no_root c hc_sq
  have hp_two : 2 ≤ p := hp.two_le
  rw [hFp, ZMod.natCast_self, zero_sub]


/-! ## 3. ω^p módulo p, sin el carácter -/

/-- Raíz de X² − X − 1 en ℤ/p. -/
def HasRoot (p : ℕ) : Prop := ∃ α : ZMod p, α ^ 2 = α + 1

theorem coords_of_root {p : ℕ} (hp2 : p ≠ 2) [Fact p.Prime] (x : Q (ZMod p))
    (hx : x ^ 2 = x + 1) (hd : x.b = 1 ∨ x.b = -1) :
    x = ω ∨ x = 1 - ω := by
  have h2 : (2 : ZMod p) ≠ 0 := by
    intro h
    have : ((2 : ℕ) : ZMod p) = 0 := by exact_mod_cast h
    rw [ZMod.natCast_eq_zero_iff] at this
    exact hp2 ((Nat.prime_dvd_prime_iff_eq (Fact.out) Nat.prime_two).mp this)
  have hb := congrArg Q.b hx
  simp [pow_two] at hb
  rcases hd with hd | hd
  · left
    rw [hd] at hb
    have : 2 * x.a = 0 := by linear_combination hb
    have ha : x.a = 0 := by
      rcases mul_eq_zero.mp this with h | h
      · exact absurd h h2
      · exact h
    ext <;> simp [ha, hd]
  · right
    rw [hd] at hb
    have : 2 * (x.a - 1) = 0 := by linear_combination -hb
    have ha : x.a = 1 := by
      rcases mul_eq_zero.mp this with h | h
      · exact absurd h h2
      · exact sub_eq_zero.mp h
    ext <;> simp [ha, hd]

/-- **ω^p módulo p, por la raíz.**  Para p primo, p ≠ 5:
    si X² − X − 1 tiene raíz en ℤ/p, ω^p ≡ ω; si no, ω^p ≡ 1 − ω. -/
theorem omega_pow_mod {p : ℕ} (hp : p.Prime) (hp5 : p ≠ 5) :
    (HasRoot p → (ω : Q (ZMod p)) ^ p = ω) ∧
    (¬ HasRoot p → (ω : Q (ZMod p)) ^ p = 1 - ω) := by
  have hF : Fact p.Prime := ⟨hp⟩
  by_cases hp2 : p = 2
  · subst hp2
    refine ⟨fun ⟨α, hα⟩ => ?_, fun _ => ?_⟩
    · exfalso; revert α; decide
    · ext <;> simp [pow_two] <;> decide
  have hbin : (ω : Q (ZMod p)) ^ p = (Nat.fib p : Q (ZMod p)) * ω + (Nat.fib (p - 1) : Q (ZMod p)) :=
    fib_pow_prime hp ω ω_sq
  have hroot : ((ω : Q (ZMod p)) ^ p) ^ 2 = (ω : Q (ZMod p)) ^ p + 1 := by
    calc ((ω : Q (ZMod p)) ^ p) ^ 2 = ((ω : Q (ZMod p)) ^ 2) ^ p := by ring
      _ = (ω + 1) ^ p := by rw [ω_sq]
      _ = ω ^ p + 1 ^ p := add_pow_char (p := p) ω 1
      _ = ω ^ p + 1 := by rw [one_pow]
  have hbcoord : ((ω : Q (ZMod p)) ^ p).b = (Nat.fib p : ZMod p) := by
    rw [hbin]; simp
  refine ⟨fun ⟨α, hα⟩ => ?_, fun hno => ?_⟩
  · have hFp : (Nat.fib p : ZMod p) = 1 := fib_split_case hp hp2 hp5 α hα
    rcases coords_of_root hp2 _ hroot (Or.inl (by rw [hbcoord, hFp])) with h | h
    · exact h
    · exfalso
      have := congrArg Q.b h
      rw [hbcoord, hFp] at this
      simp at this
      have h2 : (2 : ZMod p) = 0 := by linear_combination this
      have : ((2 : ℕ) : ZMod p) = 0 := by exact_mod_cast h2
      rw [ZMod.natCast_eq_zero_iff] at this
      exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp this)
  · have hirr : Irreducible (X ^ 2 - X - 1 : (ZMod p)[X]) := by
      have hdeg : (X ^ 2 - X - 1 : (ZMod p)[X]).natDegree = 2 := by
        compute_degree!
      rw [irreducible_iff_roots_eq_zero_of_degree_le_three (by omega) (by omega)]
      refine Multiset.eq_zero_of_forall_notMem fun c hc => hno ⟨c, ?_⟩
      have hne : (X ^ 2 - X - 1 : (ZMod p)[X]) ≠ 0 := by
        intro h; rw [h] at hdeg; simp at hdeg
      rw [mem_roots hne] at hc
      simp [IsRoot] at hc
      linear_combination hc
    have hFp : (Nat.fib p : ZMod p) = p - 1 := fib_inert_case hp hp2 hp5 hirr
    rw [ZMod.natCast_self, zero_sub] at hFp
    rcases coords_of_root hp2 _ hroot (Or.inr (by rw [hbcoord, hFp])) with h | h
    · exfalso
      have := congrArg Q.b h
      rw [hbcoord, hFp] at this
      simp at this
      have h2 : (2 : ZMod p) = 0 := by linear_combination -this
      have : ((2 : ℕ) : ZMod p) = 0 := by exact_mod_cast h2
      rw [ZMod.natCast_eq_zero_iff] at this
      exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp this)
    · exact h

/-! ## 4. El levantamiento: existencia, unicidad, signo -/

open Classical in
/-- El levantamiento de Frobenius en p: la identidad si hay raíz, σ si no. -/
noncomputable def frob (p : ℕ) : Zφ →+* Zφ := if HasRoot p then RingHom.id Zφ else σ

/-- El signo del levantamiento: +1 si es la identidad, −1 si es la conjugación. -/
noncomputable def sign (p : ℕ) : ℤ := by classical exact if HasRoot p then 1 else -1

open Classical in
theorem frob_ω (p : ℕ) : frob p ω = if HasRoot p then (ω : Zφ) else 1 - ω := by
  classical
  unfold frob; split_ifs <;> simp [σ_ω]

theorem red_frob_ω {p : ℕ} (hp : p.Prime) (hp5 : p ≠ 5) :
    red p (frob p ω) = (ω : Q (ZMod p)) ^ p := by
  classical
  obtain ⟨h1, h2⟩ := omega_pow_mod hp hp5
  rw [frob_ω]
  split_ifs with h
  · rw [red_ω, h1 h]
  · rw [map_sub, map_one, red_ω, h2 h]

/-- **Congruencia de Frobenius.**  frob p (a) ≡ a^p (mod p) para todo a. -/
theorem frob_congruence {p : ℕ} (hp : p.Prime) (hp5 : p ≠ 5) (a : Zφ) :
    red p (frob p a) = red p (a ^ p) := by
  have hF : Fact p.Prime := ⟨hp⟩
  have hfC : ∀ n : ℤ, frob p (sc n) = sc n := fun n => by rw [sc_int, map_intCast]
  conv_lhs => rw [eq_coord a]
  conv_rhs => rw [eq_coord a]
  rw [map_add, map_mul, hfC, hfC, map_add, map_mul, red_frob_ω hp hp5, map_pow, map_add,
    map_mul, add_pow_char, mul_pow, red_ω]
  have hc : ∀ n : ℤ, (red p (sc n)) ^ p = red p (sc n) := by
    intro n
    have : red p (sc n) = sc (n : ZMod p) := by ext <;> simp
    rw [this, ← map_pow, ZMod.pow_card]
  rw [hc, hc]

/-- **No hay dos.**  Si dos endomorfismos son congruentes con a ↦ a^p, coinciden. -/
theorem frob_unique {p : ℕ} (hp : p.Prime) (f : Zφ →+* Zφ)
    (hf : ∀ a, red p (f a) = red p (a ^ p)) (g : Zφ →+* Zφ)
    (hg : ∀ a, red p (g a) = red p (a ^ p)) : f = g := by
  apply hom_ext
  have hfg : red p (f ω) = red p (g ω) := by rw [hf, hg]
  rcases endo_dichotomy f with h1 | h1 <;> rcases endo_dichotomy g with h2 | h2
  · rw [h1, h2]
  · exfalso
    rw [h1, h2] at hfg
    have := congrArg Q.a hfg
    simp at this
    have h1' : ((1 : ℤ) : ZMod p) = 0 := by simpa using this.symm
    rw [ZMod.intCast_zmod_eq_zero_iff_dvd] at h1'
    exact hp.one_lt.ne' (by exact_mod_cast Int.eq_one_of_dvd_one (by positivity) h1')
  · exfalso
    rw [h1, h2] at hfg
    have := congrArg Q.a hfg
    simp at this
    have h1' : ((1 : ℤ) : ZMod p) = 0 := by simpa using this
    rw [ZMod.intCast_zmod_eq_zero_iff_dvd] at h1'
    exact hp.one_lt.ne' (by exact_mod_cast Int.eq_one_of_dvd_one (by positivity) h1')
  · rw [h1, h2]

/-- **Existencia y unicidad.**  Para p primo, p ≠ 5, hay exactamente un endomorfismo
    de anillos de ℤ[φ] congruente con a ↦ a^p módulo p, y es `frob p`. -/
theorem frobenius_exists_unique {p : ℕ} (hp : p.Prime) (hp5 : p ≠ 5) :
    ∃! f : Zφ →+* Zφ, ∀ a, red p (f a) = red p (a ^ p) :=
  ⟨frob p, frob_congruence hp hp5, fun g hg => frob_unique hp g hg _ (frob_congruence hp hp5)⟩

/-- **El signo se lee en las coordenadas.**  F_p ≡ ε_p (mod p). -/
theorem fib_eq_sign {p : ℕ} (hp : p.Prime) (hp5 : p ≠ 5) :
    (Nat.fib p : ZMod p) = (sign p : ZMod p) := by
  classical
  have hF : Fact p.Prime := ⟨hp⟩
  have hcong := frob_congruence hp hp5 ω
  have hbin : red p ((ω : Zφ) ^ p) = (Nat.fib p : Q (ZMod p)) * ω + (Nat.fib (p - 1) : Q (ZMod p)) := by
    rw [map_pow, red_ω]; exact fib_pow_prime hp ω ω_sq
  have := congrArg Q.b (hcong.trans hbin)
  rw [frob_ω] at this
  unfold sign
  split_ifs at this ⊢ with h
  · simpa [red_ω] using this.symm
  · simp [red_ω] at this
    simpa using this.symm

open Classical in
/-- **La otra coordenada.**  F_{p−1} ≡ (1 − ε_p)/2 (mod p): 0 si hay raíz, 1 si no. -/
theorem fib_pred_eq_sign {p : ℕ} (hp : p.Prime) (hp5 : p ≠ 5) :
    (Nat.fib (p - 1) : ZMod p) = if HasRoot p then 0 else 1 := by
  classical
  have hF : Fact p.Prime := ⟨hp⟩
  have hcong := frob_congruence hp hp5 ω
  have hbin : red p ((ω : Zφ) ^ p) = (Nat.fib p : Q (ZMod p)) * ω + (Nat.fib (p - 1) : Q (ZMod p)) := by
    rw [map_pow, red_ω]; exact fib_pow_prime hp ω ω_sq
  have := congrArg Q.a (hcong.trans hbin)
  rw [frob_ω] at this
  split_ifs at this ⊢ with h
  · simpa [red_ω] using this.symm
  · simpa [red_ω] using this.symm

/-! ## 5. El signo es χ₅: aquí, y solo aquí, entra la reciprocidad -/

theorem hasRoot_iff_sq {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) :
    HasRoot p ↔ IsSquare (5 : ZMod p) := by
  have hF : Fact p.Prime := ⟨hp⟩
  have h2 : (2 : ZMod p) ≠ 0 := by
    intro h
    have : ((2 : ℕ) : ZMod p) = 0 := by exact_mod_cast h
    rw [ZMod.natCast_eq_zero_iff] at this
    exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp this)
  constructor
  · rintro ⟨α, hα⟩
    exact ⟨2 * α - 1, by linear_combination (-4 : ZMod p) * hα⟩
  · rintro ⟨β, hβ⟩
    refine ⟨(β + 1) / 2, ?_⟩
    field_simp
    linear_combination (-1 : ZMod p) * hβ

theorem sq_mod5 : ∀ x : ZMod 5, x ≠ 0 → ((∃ r, x = r * r) ↔ x = 1 ∨ x = 4) := by decide

theorem hasRoot_iff_mod5 {p : ℕ} (hp : p.Prime) (hp5 : p ≠ 5) :
    HasRoot p ↔ ((p : ZMod 5) = 1 ∨ (p : ZMod 5) = 4) := by
  by_cases hp2 : p = 2
  · subst hp2
    constructor
    · rintro ⟨α, hα⟩; exfalso; revert α; decide
    · intro h; exfalso; revert h; decide
  have hF : Fact p.Prime := ⟨hp⟩
  have h5 : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  rw [hasRoot_iff_sq hp hp2]
  have key := ZMod.exists_sq_eq_prime_iff_of_mod_four_eq_one (p := 5) (q := p) (by norm_num) hp2
  rw [show (5 : ZMod p) = ((5 : ℕ) : ZMod p) by norm_cast, ← key]
  have hx0 : ((p : ℕ) : ZMod 5) ≠ 0 := by
    rw [Ne, ZMod.natCast_eq_zero_iff]
    intro hd
    exact hp5 ((Nat.prime_dvd_prime_iff_eq (by norm_num) hp).mp hd).symm
  generalize ((p : ℕ) : ZMod 5) = x at hx0 ⊢
  exact sq_mod5 x hx0

/-- **El signo del levantamiento es el carácter módulo 5.** -/
theorem sign_eq_chi5 {p : ℕ} (hp : p.Prime) (hp5 : p ≠ 5) :
    sign p = if ((p : ZMod 5) = 1 ∨ (p : ZMod 5) = 4) then 1 else -1 := by
  classical
  unfold sign
  simp only [hasRoot_iff_mod5 hp hp5]

/-! ## 6. La estructura Λ fuera de 5, como un solo enunciado -/

/-- Los levantamientos conmutan. -/
theorem frob_commute (p q : ℕ) : (frob p).comp (frob q) = (frob q).comp (frob p) := by
  classical
  apply hom_ext
  unfold frob
  split_ifs <;> simp

/-- **La estructura Λ_{ℤ,E} de ℤ[φ], E = primos ≠ 5, existe y es única.**
    Para cada primo p ≠ 5 hay exactamente un endomorfismo congruente con a ↦ a^p
    módulo p; la familia `frob` los da todos, y conmutan. -/
theorem lambda_structure_away_from_five :
    (∀ p, p.Prime → p ≠ 5 → ∀ a, red p (frob p a) = red p (a ^ p)) ∧
    (∀ p q, (frob p).comp (frob q) = (frob q).comp (frob p)) ∧
    (∀ (ψ : ℕ → Zφ →+* Zφ), (∀ p, p.Prime → p ≠ 5 → ∀ a, red p (ψ p a) = red p (a ^ p)) →
        ∀ p, p.Prime → p ≠ 5 → ψ p = frob p) :=
  ⟨fun _ hp hp5 a => frob_congruence hp hp5 a, frob_commute,
   fun ψ hψ p hp hp5 => frob_unique hp _ (hψ p hp hp5) _ (frob_congruence hp hp5)⟩

end FrobeniusUnico

end FrobeniusUnicoBlock

