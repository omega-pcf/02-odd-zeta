-- BLOCK S27. OZCierres  (sprints 127 and 128): closures of open problems of OZ.
-- Compiled standalone with Lean 4.36.0-rc2 and Mathlib a8754b18; no sorry, no axiom,
-- no native_decide; axioms [propext, Classical.choice, Quot.sound].
-- Uses PasosDelTexto.algebraic_scale (block S17 of this file); pi transcendental is a hypothesis.
-- ════════════════════════════════════════════════════════════════════════════

section OZCierresBlock
namespace F1OZ

open Real

/-- `√5` is algebraic over `ℚ`. -/
theorem sqrt5_isAlgebraic : IsAlgebraic ℚ (√5 : ℝ) := by
  apply IsAlgebraic.of_pow (n := 2) (by norm_num)
  rw [Real.sq_sqrt (by norm_num)]
  have h := isAlgebraic_ratCast (A := ℝ) ℚ (5 : ℚ)
  simpa using h

/-- **The even values.**  If `L = √5 π^{2k} r` with `r ∈ ℚ` and `L ≠ 0` (the form of
`L(2k, χ₅)`), and `π` is transcendental, then `L` is transcendental, and so is the
polylogarithmic sum `S = √5 L = Σ χ₅(a) Li_{2k}(ζ₅^a)`.  The algebraic factor is removed by
the corpus lemma `PasosDelTexto.algebraic_scale`. -/
theorem even_value_transcendental (L S : ℝ) (k : ℕ) (hk : 0 < k) (r : ℚ)
    (hL : L = √5 * π ^ (2 * k) * r) (hL0 : L ≠ 0) (hS : S = √5 * L)
    (hπ : Transcendental ℚ π) : Transcendental ℚ L ∧ Transcendental ℚ S := by
  have h5 : (√5 : ℝ) * √5 = 5 := Real.mul_self_sqrt (by norm_num)
  have hr : (r : ℝ) ≠ 0 := by
    intro h; apply hL0; rw [hL, h]; ring
  have hs : (√5 : ℝ) ≠ 0 := by positivity
  have hpow : Transcendental ℚ (π ^ (2 * k)) := hπ.pow (by omega)
  have hrA : IsAlgebraic ℚ ((r : ℝ)) := isAlgebraic_ratCast (A := ℝ) ℚ r
  have hc1 : IsAlgebraic ℚ ((√5 : ℝ) * r) := sqrt5_isAlgebraic.mul hrA
  have h5A : IsAlgebraic ℚ (5 : ℝ) := by
    have h := isAlgebraic_ratCast (A := ℝ) ℚ (5 : ℚ)
    simpa using h
  have hc2 : IsAlgebraic ℚ ((5 : ℝ) * r) := h5A.mul hrA
  refine ⟨?_, ?_⟩
  · have hform : L = ((√5 : ℝ) * r) * π ^ (2 * k) := by rw [hL]; ring
    rw [hform]
    intro hA
    exact hpow ((PasosDelTexto.algebraic_scale _ _ hc1 (mul_ne_zero hs hr)).mpr hA)
  · have hform : S = ((5 : ℝ) * r) * π ^ (2 * k) := by
      rw [hS, hL]
      linear_combination (π ^ (2 * k) * (r : ℝ)) * h5
    rw [hform]
    intro hA
    exact hpow ((PasosDelTexto.algebraic_scale _ _ hc2 (mul_ne_zero (by norm_num) hr)).mpr hA)

/-- **The period from the `χ₅`-fibre of `G`.**  With `L₁ √5 = 2 log φ` (the anchor, `L(1, χ₅)`)
and `L₋₂₀ √5 = π` (`L(1, χ₄χ₅) = π/√5`, the class-number formula of `ℚ(√-5)`),
`T_K = 2π log φ = 5 L₁ L₋₂₀`. -/
theorem period_from_the_chi5_fibre (l L1 Lm : ℝ) (h1 : L1 * √5 = 2 * l) (hm : Lm * √5 = π) :
    2 * π * l = 5 * L1 * Lm := by
  have h5 : (√5 : ℝ) * √5 = 5 := Real.mul_self_sqrt (by norm_num)
  have e : (L1 * √5) * (Lm * √5) = 2 * l * π := by rw [h1, hm]
  linear_combination -e + (L1 * Lm) * h5

end F1OZ

end OZCierresBlock
