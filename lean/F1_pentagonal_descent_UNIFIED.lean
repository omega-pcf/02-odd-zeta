/-! ## §0.1  φ y sus identidades   (F1_PCF_Unified.lean PART 1) -/

/-- La razón áurea φ = (1 + √5)/2. -/
def φ : ℝ := (1 + Real.sqrt 5) / 2

theorem φ_pos : 0 < φ := by
  unfold φ
  have h5 : 0 ≤ Real.sqrt 5 := Real.sqrt_nonneg 5
  linarith

theorem φ_ne_zero : φ ≠ 0 := ne_of_gt φ_pos

theorem φ_gt_one : 1 < φ := by
  unfold φ
  have h5 : 2 < Real.sqrt 5 := by
    have := Real.sqrt_lt_sqrt (by norm_num : (0:ℝ) ≤ 4) (by norm_num : (4:ℝ) < 5)
    rw [show (4:ℝ) = 2^2 from by norm_num,
        Real.sqrt_sq (by norm_num : (0:ℝ) ≤ 2)] at this
    exact this
  linarith

theorem phi_sq : φ ^ 2 = φ + 1 := by
  unfold φ
  have h5 : Real.sqrt 5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  nlinarith [h5, Real.sqrt_nonneg 5]

/-! ## §0.2  λ y el puente de Mersenne   (F1_PCF_Unified.lean L530, L555) -/

/-- λ = log 2 / log φ. -/
def lambda_log : ℝ := Real.log 2 / Real.log φ

/-- **Puente de Mersenne**: φ^(log 2 / log φ) = 2. -/
theorem mersenne_bridge : φ ^ (Real.log 2 / Real.log φ) = 2 := by
  have hlogφ : Real.log φ ≠ 0 := ne_of_gt (Real.log_pos φ_gt_one)
  rw [Real.rpow_def_of_pos φ_pos]
  have hmul : Real.log φ * (Real.log 2 / Real.log φ) = Real.log 2 := by
    field_simp
  rw [hmul, Real.exp_log (by norm_num)]

theorem mersenne_bridge_via_lambda : φ ^ lambda_log = 2 := by
  unfold lambda_log; exact mersenne_bridge

/-! ## §0.3  realise, ψ_p, X_PCF   (F1_PCF_Unified.lean PART 7, PART 9) -/

/-- La realización del retículo F₁: n ↦ φⁿ. -/
def realise (n : ℤ) : ℝ := φ ^ n

theorem realise_pos (n : ℤ) : 0 < realise n := by
  unfold realise; exact zpow_pos φ_pos _

/-- El levantamiento de Frobenius ψ_p sobre el monoide de exponentes (ℤ, +). -/
def psi (p : ℕ) : ℤ → ℤ := fun n => (p : ℤ) * n

theorem psi_zero (p : ℕ) : psi p 0 = 0 := by unfold psi; ring

theorem psi_add (p : ℕ) (m n : ℤ) : psi p (m + n) = psi p m + psi p n := by
  unfold psi; ring

/-- Axioma B1 de Borger: ψ_p ∘ ψ_q = ψ_{pq}. -/
theorem psi_comp (p q : ℕ) (n : ℤ) : psi p (psi q n) = psi (p * q) n := by
  unfold psi; push_cast; ring

/-- Axioma B3 de Borger: realise(ψ_p n) = realise(n)^p. -/
theorem psi_realise_pow (p : ℕ) (n : ℤ) : realise (psi p n) = realise n ^ p := by
  unfold realise psi
  rw [show (p : ℤ) * n = n * (p : ℤ) from mul_comm _ _]
  rw [zpow_mul φ n (p : ℤ)]
  exact zpow_natCast (φ ^ n) p

/-- Un objeto-monoide F₁ con descenso de Frobenius. -/
structure F1MonoidObject where
  carrier : Type
  addCommMonoid : AddCommMonoid carrier
  psi : ℕ → carrier → carrier
  psi_add : ∀ (p : ℕ) (m n : carrier), psi p (m + n) = psi p m + psi p n
  psi_zero : ∀ (p : ℕ), psi p 0 = 0
  psi_comp : ∀ (p q : ℕ) (n : carrier), psi p (psi q n) = psi (p * q) n

/-- El objeto F₁ X_PCF: el grupo aditivo ℤ con los levantamientos ψ_p. -/
abbrev X_PCF : F1MonoidObject where
  carrier := ℤ
  addCommMonoid := inferInstance
  psi := fun p n => (p : ℤ) * n
  psi_add := fun _ _ _ => by ring
  psi_zero := fun _ => by ring
  psi_comp := fun _ _ _ => by push_cast; ring

theorem X_PCF_carrier_eq : X_PCF.carrier = ℤ := rfl

/-- El Frobenius descendido a ZMod N. -/
def psi_mod (N : ℕ) (p : ℕ) : ZMod N → ZMod N := fun a => (p : ZMod N) * a

theorem psi_descent_general (N : ℕ) (p : ℕ) (n : ℤ) :
    ((X_PCF.psi p n : ℤ) : ZMod N) = psi_mod N p ((n : ZMod N)) := by
  unfold X_PCF psi_mod
  push_cast; ring

theorem psi_descent_at_conductor (p : ℕ) (n : ℤ) :
    ((X_PCF.psi p n : ℤ) : ZMod 20) = psi_mod 20 p ((n : ZMod 20)) :=
  psi_descent_general 20 p n

/-! ## §0.4  Z₂₀* y sus primos   (F1_PCF_Unified.lean PART 5) -/

def ZtwentyStar : Finset (ZMod 20) := {1, 3, 7, 9, 11, 13, 17, 19}

theorem ZtwentyStar_card : ZtwentyStar.card = 8 := by decide

theorem mul_preserved_Z20 (a b : ZMod 20)
    (ha : a ∈ ZtwentyStar) (hb : b ∈ ZtwentyStar) :
    a * b ∈ ZtwentyStar := by
  revert hb ha b a; decide

theorem add_destroyed :
    ∀ a ∈ ZtwentyStar, ∀ b ∈ ZtwentyStar, (a + b) ∉ ZtwentyStar := by
  intro a ha b hb; revert hb ha b a; decide

/-- Todo primo p > 5 cae en Z₂₀* módulo 20. -/
theorem primes_land_in_ZtwentyStar (p : ℕ) (hp : p.Prime) (hp5 : 5 < p) :
    ((p : ℕ) : ZMod 20) ∈ ZtwentyStar := by
  have h2 : ¬ 2 ∣ p := fun h => absurd (hp.eq_one_or_self_of_dvd 2 h) (by omega)
  have h5 : ¬ 5 ∣ p := fun h => absurd (hp.eq_one_or_self_of_dvd 5 h) (by omega)
  have h2m : p % 2 ≠ 0 := fun h => h2 (Nat.dvd_of_mod_eq_zero h)
  have h5m : p % 5 ≠ 0 := fun h => h5 (Nat.dvd_of_mod_eq_zero h)
  have hlt : p % 20 < 20 := Nat.mod_lt p (by norm_num)
  have hmod : p % 20 = 1 ∨ p % 20 = 3 ∨ p % 20 = 7 ∨ p % 20 = 9 ∨
              p % 20 = 11 ∨ p % 20 = 13 ∨ p % 20 = 17 ∨ p % 20 = 19 := by
    omega
  have cast_eq : ((p : ℕ) : ZMod 20) = ((p % 20 : ℕ) : ZMod 20) := by
    conv_lhs => rw [← Nat.mod_add_div p 20]
    push_cast
    simp [show (20 : ZMod 20) = 0 from by decide]
  rw [cast_eq]
  rcases hmod with h|h|h|h|h|h|h|h <;> rw [h] <;> decide

/-! ## §0.5  El funtor de Galois G   (F1_PCF_Unified.lean PART 6) -/

/-- G : Z₂₀* → Z₂ × Z₂. -/
def G : ZMod 20 → ZMod 2 × ZMod 2 := fun a =>
  if a = 1 ∨ a = 9 then (0, 0)
  else if a = 11 ∨ a = 19 then (1, 0)
  else if a = 13 ∨ a = 17 then (0, 1)
  else (1, 1)

theorem G_identity : G 1 = (0, 0) := by simp [G]

theorem G_hom (a b : ZMod 20) (ha : a ∈ ZtwentyStar) (hb : b ∈ ZtwentyStar) :
    G (a * b) = G a + G b := by
  revert hb ha b a; decide

theorem G_surj : ∀ y : ZMod 2 × ZMod 2, ∃ a : ZMod 20,
    a ∈ ZtwentyStar ∧ G a = y := by decide

theorem G_kernel : ∀ a : ZMod 20, a ∈ ZtwentyStar →
    (G a = (0, 0) ↔ a = 1 ∨ a = 9) := by decide

/-- La primera proyección de G es el carácter χ₄. -/
theorem G_pi1_is_chi4 (a : ZMod 20) (ha : a ∈ ZtwentyStar) :
    (G a).1 = 0 ↔ a = 1 ∨ a = 9 ∨ a = 13 ∨ a = 17 := by
  revert ha; revert a; decide

/-- La segunda proyección de G es el carácter χ₅. -/
theorem G_pi2_is_chi5 (a : ZMod 20) (ha : a ∈ ZtwentyStar) :
    (G a).2 = 0 ↔ a = 1 ∨ a = 9 ∨ a = 11 ∨ a = 19 := by
  revert ha; revert a; decide

/-- χ₅ como función: la segunda componente de G. -/
def chi5 (a : ZMod 20) : ZMod 2 := (G a).2

theorem chi5_from_G : ∀ a ∈ ZtwentyStar, chi5 a = (G a).2 := fun _ _ => rfl

theorem chi5_values :
    chi5 1 = 0 ∧ chi5 9 = 0 ∧ chi5 11 = 0 ∧ chi5 19 = 0 ∧
    chi5 3 = 1 ∧ chi5 7 = 1 ∧ chi5 13 = 1 ∧ chi5 17 = 1 := by
  unfold chi5 G; decide

/-! ## §0.6  Binet, caso split, caso inert   (mersenne_unified.lean §5.2)

    Las cinco declaraciones que en `mersenne_unified.lean` son `private`
    y que por eso obligaban a anexar en vez de importar.  Aquí públicas. -/

/-- Identidad de Binet en cualquier anillo conmutativo con α² = α + 1. -/
theorem fib_pow_aux {R : Type*} [CommRing R] (α : R) (hα : α ^ 2 = α + 1) :
    ∀ n : ℕ, α ^ (n + 1) = (Nat.fib (n + 1) : R) * α + (Nat.fib n : R) := by
  intro n
  induction n with
  | zero => simp [Nat.fib_one, Nat.fib_zero]
  | succ k ih =>
    calc α ^ (k + 2)
        = α ^ (k + 1) * α := by ring
      _ = ((Nat.fib (k + 1) : R) * α + (Nat.fib k : R)) * α := by rw [ih]
      _ = (Nat.fib (k + 1) : R) * α ^ 2 + (Nat.fib k : R) * α := by ring
      _ = (Nat.fib (k + 1) : R) * (α + 1) + (Nat.fib k : R) * α := by rw [hα]
      _ = ((Nat.fib (k + 1) + Nat.fib k : ℕ) : R) * α + (Nat.fib (k + 1) : R) := by
            push_cast; ring
      _ = (Nat.fib (k + 2) : R) * α + (Nat.fib (k + 1) : R) := by
            rw [add_comm (Nat.fib (k + 1)) (Nat.fib k), ← Nat.fib_add_two]

theorem fib_pow_prime {p : ℕ} (hp : p.Prime) {R : Type*} [CommRing R]
    (α : R) (hα : α ^ 2 = α + 1) :
    α ^ p = (Nat.fib p : R) * α + (Nat.fib (p - 1) : R) := by
  have hp_gt : 1 ≤ p := hp.pos
  have hp1 : p = (p - 1) + 1 := by omega
  conv_lhs => rw [hp1]
  have hidx : Nat.fib ((p - 1) + 1) = Nat.fib p := by congr 1; omega
  calc α ^ ((p - 1) + 1)
      = (Nat.fib ((p - 1) + 1) : R) * α + (Nat.fib (p - 1) : R) :=
        fib_pow_aux α hα (p - 1)
    _ = (Nat.fib p : R) * α + (Nat.fib (p - 1) : R) := by rw [hidx]

theorem five_ne_zero_zmod {p : ℕ} (hp : p.Prime) (hp5 : p ≠ 5) :
    (5 : ZMod p) ≠ 0 := by
  have : Fact p.Prime := ⟨hp⟩
  change ((5 : ℕ) : ZMod p) ≠ 0
  rw [Ne, ZMod.natCast_eq_zero_iff]
  intro hdvd
  rcases (show Nat.Prime 5 from by norm_num).eq_one_or_self_of_dvd p hdvd with h1 | h5
  · have : 2 ≤ p := hp.two_le
    omega
  · exact hp5 h5

/-- **Caso split.**  Si X² − X − 1 tiene raíz α ∈ Z_p, entonces F_p ≡ 1 (mod p). -/
theorem fib_split_case {p : ℕ} (hp : p.Prime) (_hp2 : p ≠ 2) (hp5 : p ≠ 5)
    (α : ZMod p) (hα : α ^ 2 = α + 1) :
    (Nat.fib p : ZMod p) = 1 := by
  have : Fact p.Prime := ⟨hp⟩
  have hβ  : (1 - α) ^ 2 = (1 - α) + 1 := by linear_combination hα
  have hfα : α ^ p = (Nat.fib p : ZMod p) * α + (Nat.fib (p-1) : ZMod p) :=
    fib_pow_prime hp α hα
  have hfβ : (1-α) ^ p = (Nat.fib p : ZMod p) * (1-α) + (Nat.fib (p-1) : ZMod p) :=
    fib_pow_prime hp (1 - α) hβ
  have heqα : (Nat.fib p : ZMod p) * α + (Nat.fib (p-1) : ZMod p) = α := by
    rw [← hfα]; exact ZMod.pow_card α
  have heqβ : (Nat.fib p : ZMod p) * (1-α) + (Nat.fib (p-1) : ZMod p) = 1 - α := by
    rw [← hfβ]; exact ZMod.pow_card (1 - α)
  have hdiff : ((Nat.fib p : ZMod p) - 1) * (2 * α - 1) = 0 := by
    linear_combination heqα - heqβ
  have h2α1_sq : (2 * α - 1) ^ 2 = (5 : ZMod p) := by linear_combination 4 * hα
  have h2α1_ne : 2 * α - 1 ≠ 0 := by
    intro h
    have : ((2 : ZMod p) * α - 1) ^ 2 = 0 := by rw [h]; ring
    rw [h2α1_sq] at this
    exact five_ne_zero_zmod hp hp5 this
  rcases mul_eq_zero.mp hdiff with hfp | h2
  · exact sub_eq_zero.mp hfp
  · exact absurd h2 h2α1_ne

set_option maxHeartbeats 1000000 in -- el Frobenius sobre GF(p²) dispara el límite
/-- **Caso inert.**  Si X² − X − 1 es irreducible en Z_p[X], F_p ≡ −1 (mod p).
    Vía GF(p²) = AdjoinRoot(X²−X−1) y el Frobenius. -/
theorem fib_inert_case {p : ℕ} (hp : p.Prime) (_hp2 : p ≠ 2) (_hp5 : p ≠ 5)
    (hirr : Irreducible (X ^ 2 - X - 1 : (ZMod p)[X])) :
    (Nat.fib p : ZMod p) = p - 1 := by
  have hFact : Fact p.Prime := ⟨hp⟩
  let K := AdjoinRoot (X ^ 2 - X - 1 : (ZMod p)[X])
  have : Fact (Irreducible (X ^ 2 - X - 1 : (ZMod p)[X])) := ⟨hirr⟩
  have hKChar : CharP K p :=
    charP_of_injective_algebraMap (algebraMap (ZMod p) K).injective p
  let α : K := AdjoinRoot.root _
  have hα_sq : α ^ 2 = α + 1 := by
    have h : Polynomial.aeval α (X ^ 2 - X - 1 : (ZMod p)[X]) = 0 :=
      AdjoinRoot.eval₂_root _
    simp only [map_sub, map_pow, map_one, Polynomial.aeval_X] at h
    linear_combination h
  -- Paso 1: (α^p)² = α^p + 1  (freshman's dream)
  have hαp_root : (α ^ p) ^ 2 = α ^ p + 1 := by
    calc (α ^ p) ^ 2
        = (α ^ 2) ^ p := by ring
      _ = (α + 1) ^ p := by rw [hα_sq]
      _ = α ^ p + 1 ^ p := add_pow_char (p := p) α 1
      _ = α ^ p + 1 := by ring
  -- Paso 2: X² − X − 1 no tiene raíces en Z_p
  have hirr_no_root : ∀ c : ZMod p, c ^ 2 ≠ c + 1 := by
    intro c hc
    have hkey : c - c ^ 2 = -1 := by linear_combination -hc
    have hfact : (X ^ 2 - X - 1 : (ZMod p)[X]) = (X - C c) * (X - C (1 - c)) := by
      have hrw : (X - C c) * (X - C (1 - c)) = X ^ 2 - X + C (c - c ^ 2) := by
        simp only [map_sub, map_pow, map_one]
        ring
      rw [hrw, hkey]
      simp only [map_neg, map_one]
      ring
    have hnu : ∀ d : ZMod p, ¬ IsUnit (X - C d : (ZMod p)[X]) := by
      intro d hu
      obtain ⟨u, _, hu_eq⟩ := Polynomial.isUnit_iff.mp hu
      have h1 : natDegree (C u) = natDegree (X - C d) := congr_arg natDegree hu_eq
      rw [natDegree_C, natDegree_X_sub_C] at h1
      contradiction
    rcases hirr.isUnit_or_isUnit hfact with h | h
    · exact hnu c h
    · exact hnu (1 - c) h
  have hinj : Function.Injective (algebraMap (ZMod p) K) :=
    (algebraMap (ZMod p) K).injective
  -- Paso 3: α^p ≠ α
  have hαp_ne : α ^ p ≠ α := by
    intro heq
    have hXpX : (X ^ p - X : (ZMod p)[X]) = ∏ a : ZMod p, (X - C a) := by
      have hdeg : degree (X ^ p - X : (ZMod p)[X]) = p := by
        have h1 : degree (X : (ZMod p)[X]) < degree ((X ^ p : (ZMod p)[X])) := by
          rw [degree_X_pow, degree_X]
          exact_mod_cast hp.one_lt
        rw [degree_sub_eq_left_of_degree_lt h1, degree_X_pow]
      have hnat : natDegree (X ^ p - X : (ZMod p)[X]) = p :=
        natDegree_eq_of_degree_eq_some hdeg
      have hmonic : Monic (X ^ p - X : (ZMod p)[X]) := by
        rw [Monic, leadingCoeff, hnat]
        have hcs := coeff_sub (X ^ p : (ZMod p)[X]) (X : (ZMod p)[X]) p
        have hcp := coeff_X_pow (R := ZMod p) p p
        have hcx := coeff_X (R := ZMod p) (n := p)
        rw [hcs, hcp, hcx, if_pos (rfl : p = p),
            if_neg (Nat.ne_of_lt hp.one_lt), sub_zero]
      have hroots : roots (X ^ p - X : (ZMod p)[X]) = (Finset.univ : Finset (ZMod p)).val := by
        have h := FiniteField.roots_X_pow_card_sub_X (ZMod p)
        simpa [ZMod.card] using h
      have hcard : (Finset.univ : Finset (ZMod p)).val.card = p := by
        have h := Finset.card_univ (α := ZMod p)
        rwa [Finset.card_def, ZMod.card] at h
      have hsplits : Splits (X ^ p - X : (ZMod p)[X]) := by
        rw [splits_iff_card_roots, hroots, hcard]
        exact hnat.symm
      rw [hsplits.eq_prod_roots_of_monic hmonic, hroots]
      rfl
    have haeval : (Polynomial.aeval (R := (ZMod p)) α) (X ^ p - X : (ZMod p)[X]) = 0 := by
      rw [map_sub, map_pow, Polynomial.aeval_X]
      rw [heq]; ring
    rw [hXpX, map_prod (g := (Polynomial.aeval α : (ZMod p)[X] →ₐ[(ZMod p)] K))] at haeval
    obtain ⟨c, _, hc⟩ := (Finset.prod_eq_zero_iff).mp haeval
    rw [map_sub, Polynomial.aeval_X, Polynomial.aeval_C] at hc
    have hα_eq : α = algebraMap (ZMod p) K c := eq_of_sub_eq_zero hc
    have hc_sq : c ^ 2 = c + 1 := by
      apply hinj
      rw [map_pow, map_add, map_one, ← hα_eq]
      exact hα_sq
    exact hirr_no_root c hc_sq
  -- Paso 4: α^p = 1 − α
  have hfrob : α ^ p = 1 - α := by
    have hprod : (α ^ p - α) * (α ^ p - (1 - α)) = 0 := by
      linear_combination hαp_root - hα_sq
    rcases mul_eq_zero.mp hprod with h | h
    · exact absurd (sub_eq_zero.mp h) hαp_ne
    · exact sub_eq_zero.mp h
  have hfib_K : (Nat.fib p : K) * α + (Nat.fib (p - 1) : K) = 1 - α :=
    (fib_pow_prime hp α hα_sq).symm ▸ hfrob
  -- Paso 5: F_p ≡ −1 (mod p)
  have hFp : (Nat.fib p : ZMod p) = -1 := by
    by_contra hne
    have hFp1_ne : (Nat.fib p : ZMod p) + 1 ≠ 0 := fun h => hne (by linear_combination h)
    have hFp1_K : (Nat.fib p : K) + 1 ≠ 0 := by
      intro h; apply hFp1_ne; apply hinj
      push_cast [map_add, map_one]; exact h
    have hlin : ((Nat.fib p : K) + 1) * α = 1 - (Nat.fib (p - 1) : K) := by
      linear_combination hfib_K
    set c : ZMod p := (1 - (Nat.fib (p - 1) : ZMod p)) / ((Nat.fib p : ZMod p) + 1)
    have hα_c : α = algebraMap (ZMod p) K c := by
      rw [show c = (1 - (Nat.fib (p - 1) : ZMod p)) / ((Nat.fib p : ZMod p) + 1)
            from rfl]
      rw [map_div₀, map_sub, map_one, map_add, map_one, map_natCast, map_natCast]
      exact eq_div_of_mul_eq hFp1_K (by rw [mul_comm]; exact hlin)
    have hc_sq : c ^ 2 = c + 1 := by
      apply hinj
      rw [map_pow, map_add, map_one, ← hα_c]
      exact hα_sq
    exact hirr_no_root c hc_sq
  have hp_two : 2 ≤ p := hp.two_le
  rw [hFp, ZMod.natCast_self, zero_sub]

/-- Grado dos: no irreducible ⟺ tiene raíz. -/
theorem not_irreducible_iff_exists_root_of_degree_two {F : Type*} [Field F]
    (f : F[X]) (hdeg : f.natDegree = 2) :
    ¬ Irreducible f ↔ ∃ x : F, IsRoot f x := by
  have hd2 : 2 ≤ f.natDegree := by omega
  have hd3 : f.natDegree ≤ 3 := by omega
  rw [irreducible_iff_roots_eq_zero_of_degree_le_three hd2 hd3]
  have hne : f ≠ 0 := by
    intro h
    rw [h, natDegree_zero] at hdeg
    omega
  rw [not_iff_comm, Multiset.eq_zero_iff_forall_notMem]
  push Not           -- ⚠ el corpus escribe `push Not` aquí; ver NOTA 6
  simp [mem_roots hne, IsRoot]

/-- **Escisión Fibonacci general** (reproducida): F_p ≡ ±1 (mod p). -/
theorem fibonacci_splitting_general (p : ℕ) (hp : p.Prime)
    (hp2 : p ≠ 2) (hp5 : p ≠ 5) :
    (Nat.fib p : ZMod p) = 1 ∨ (Nat.fib p : ZMod p) = p - 1 := by
  have : Fact p.Prime := ⟨hp⟩
  by_cases hirr : Irreducible (X ^ 2 - X - 1 : (ZMod p)[X])
  · right; exact fib_inert_case hp hp2 hp5 hirr
  · left
    have hdeg : (X ^ 2 - X - 1 : (ZMod p)[X]).natDegree = 2 := by compute_degree!
    rw [not_irreducible_iff_exists_root_of_degree_two
        (X ^ 2 - X - 1 : (ZMod p)[X]) hdeg] at hirr
    obtain ⟨α, hα⟩ := hirr
    have he : Polynomial.eval α (X ^ 2 - X - 1 : (ZMod p)[X]) = 0 := hα
    simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
               Polynomial.eval_one] at he
    have hα_sq : α ^ 2 = α + 1 := by linear_combination he
    exact fib_split_case hp hp2 hp5 α hα_sq


