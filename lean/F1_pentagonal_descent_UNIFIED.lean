/-- An F₁-monoid object with Frobenius descent. -/
structure F1MonoidObject where
  carrier : Type
  addCommMonoid : AddCommMonoid carrier
  psi : ℕ → carrier → carrier
  psi_add : ∀ (p : ℕ) (m n : carrier),
              psi p (m + n) = psi p m + psi p n
  psi_zero : ∀ (p : ℕ), psi p 0 = 0
  psi_comp : ∀ (p q : ℕ) (n : carrier),
              psi p (psi q n) = psi (p * q) n

/-- The F₁-object X_PCF: the additive group ℤ with Frobenius lifts ψ_p. -/
def X_PCF : F1MonoidObject where
  carrier := ℤ
  addCommMonoid := inferInstance
  psi := fun p n => (p : ℤ) * n
  psi_add := fun _ _ _ => by ring
  psi_zero := fun _ => by ring
  psi_comp := fun _ _ _ => by push_cast; ring

theorem X_PCF_carrier_eq : X_PCF.carrier = ℤ := rfl

def psi_mod (N : ℕ) (p : ℕ) : ZMod N → ZMod N :=
  fun a => (p : ZMod N) * a

theorem psi_descent_general (N : ℕ) (p : ℕ) (n : ℤ) :
    (psi p n : ZMod N) = psi_mod N p (n : ZMod N) := by
  unfold psi psi_mod
  push_cast; ring

theorem psi_descent_at_conductor (p : ℕ) (n : ℤ) :
    (psi p n : ZMod 20) = psi_mod 20 p (n : ZMod 20) :=
  psi_descent_general 20 p n

theorem psi_mod_self (p : ℕ) (_hp : 0 < p) (n : ℤ) :
    (psi p n : ZMod p) = 0 := by
  unfold psi
  simp [Int.cast_mul, Int.cast_natCast]

theorem F1_structural_data :
    X_PCF.carrier = ℤ ∧
    (∀ N : ℕ, ∀ p : ℕ, ∀ n : ℤ,
      (psi p n : ZMod N) = psi_mod N p (n : ZMod N)) ∧
    (∀ p : ℕ, ∀ n : ℤ,
      (psi p n : ZMod 20) = psi_mod 20 p (n : ZMod 20)) ∧
    (∀ p : ℕ, 0 < p → ∀ n : ℤ,
      (psi p n : ZMod p) = 0) :=
⟨X_PCF_carrier_eq, psi_descent_general,
 psi_descent_at_conductor, psi_mod_self⟩


