theorem reciprocal_centres_are_mirror (k : ℝ) (hk : 0 < k) (h1 : k ≠ 1) :
    1 / (1 - k ^ 2) + 1 / (1 - (k⁻¹) ^ 2) = 1 := by
  have hk0 : k ≠ 0 := ne_of_gt hk
  have hd1 : 1 - k ^ 2 ≠ 0 := by
    intro h
    have hfac : (k - 1) * (k + 1) = 0 := by nlinarith [h]
    rcases mul_eq_zero.mp hfac with h' | h'
    · exact h1 (by linarith)
    · linarith
  have hd2 : 1 - (k⁻¹) ^ 2 ≠ 0 := by
    intro h
    apply hd1
    have hk2 : (0:ℝ) < k ^ 2 := by positivity
    field_simp at h
    nlinarith [h]
  have hkey : (1 : ℝ) - (k⁻¹) ^ 2 = -((1 - k ^ 2) / k ^ 2) := by
    field_simp; ring
  rw [hkey, div_neg, one_div_div, ← sub_eq_add_neg, ← sub_div, div_self hd1]

theorem reciprocal_radii_agree (k : ℝ) (hk : 0 < k) (hne : 1 - k ^ 2 ≠ 0) :
    k⁻¹ * |1 - k ^ 2| = k * |1 - (k⁻¹) ^ 2| := by
  have hk0 : k ≠ 0 := ne_of_gt hk
  have hk2 : (0:ℝ) < k ^ 2 := by positivity
  have hrw : (1 : ℝ) - (k⁻¹) ^ 2 = -((1 - k ^ 2) / k ^ 2) := by
    field_simp; ring
  rw [hrw, abs_neg, _root_.abs_div, abs_of_pos hk2]
  field_simp

theorem the_framework_does_restrict (z : Chi5Zero) (ρ : ℂ) (hδ : ρ.re ≠ 1/2)
    (k : ℝ) (hk : 0 < k) (h1 : k ≠ 1) :
    (DirichletCharacter.LFunction chi5_D (1 - z.ρ) = 0) ∧
    (kmate ρ ≠ ρ ∧ (kmate ρ).im = ρ.im) ∧
    (1 / (1 - k ^ 2) + 1 / (1 - (k⁻¹) ^ 2) = 1) :=
  ⟨the_set_is_closed z, off_line_comes_in_pairs ρ hδ,
   reciprocal_centres_are_mirror k hk h1⟩

theorem pair_degenerates_iff_on_line (ρ : ℂ) (r : ℝ) (hr : 0 < r) :
    kmate ρ = ρ ↔ ρ.re = 1 / 2 :=
  link_six_correct ρ r hr

theorem degenerate_iff_valuation_zero (ρ : ℂ) (h0 : 0 < ρ.re) (h1 : ρ.re < 1) :
    valPhi (zeroCoord ρ) = 0 ↔ ρ.re = 1/2 := by
  constructor
  · intro hv
    exact (E_iff_the_pair_collapses ρ h0 h1).mp (by rw [hv]; ring)
  · intro hE
    exact E_coordinate_exponent_is_zero ρ h0 hE

theorem A1_sees_the_pair_by_coordinate (ρ : ℂ) (h₀ : ρ ≠ 0) (h₁ : ρ ≠ 1)
    (hpos : 0 < zeroCoord ρ) :
    valPhi (zeroCoord ρ) + valPhi (zeroCoord (1 - (starRingEnd ℂ) ρ)) = 0 :=
  the_pair_sums_to_zero ρ h₀ h₁ hpos

theorem A2_sees_the_pair_by_ordinate (ρ : ℂ) (hδ : ρ.re ≠ 1/2) :
    kmate ρ ≠ ρ ∧ (kmate ρ).im = ρ.im :=
  off_line_comes_in_pairs ρ hδ

theorem A1_iff_A2_under_confinement (ρ : ℂ) (h0 : 0 < ρ.re) (h1 : ρ.re < 1)
    (hle : discP (zeroCoord ρ) ≤ 1/12) (r : ℝ) (hr : 0 < r) :
    (∃ k : ℤ, valPhi (zeroCoord ρ) = (k : ℝ)) ↔ kmate ρ = ρ := by
  have hne1 : ρ ≠ 1 := by intro h; rw [h] at h1; simp at h1
  have hne0 : ρ ≠ 0 := by intro h; rw [h] at h0; simp at h0
  have hpos : 0 < zeroCoord ρ := by
    unfold zeroCoord
    refine Complex.abs.pos ?_
    intro hz
    unfold liMap at hz
    have hq : (ρ - 1) / ρ = 0 := by rw [← hz]; field_simp
    have hnum : ρ - 1 = 0 := by field_simp at hq; rw [mul_zero] at hq; exact hq
    exact hne1 (by linear_combination hnum)
  constructor
  · rintro ⟨k, hk⟩
    have hcoord : zeroCoord ρ = 1 :=
      integrality_of_valuation_is_E (zeroCoord ρ) hpos hle k hk
    have hE : ρ.re = 1/2 := (hcoord_discharged ρ h0).mp hcoord
    exact (pair_degenerates_iff_on_line ρ r hr).mpr hE
  · intro hd
    have hE := (pair_degenerates_iff_on_line ρ r hr).mp hd
    exact ⟨0, by rw [E_coordinate_exponent_is_zero ρ h0 hE]; norm_num⟩

theorem A1_and_A2_are_one (ρ : ℂ) (h0 : 0 < ρ.re) (h1 : ρ.re < 1)
    (hδ : ρ.re ≠ 1/2) (r : ℝ) (hr : 0 < r) :
    (kmate ρ = ρ ↔ ρ.re = 1 / 2) ∧
    (valPhi (zeroCoord ρ) = 0 ↔ ρ.re = 1/2) ∧
    (kmate ρ ≠ ρ ∧ (kmate ρ).im = ρ.im) :=
  ⟨pair_degenerates_iff_on_line ρ r hr,
   degenerate_iff_valuation_zero ρ h0 h1,
   A2_sees_the_pair_by_ordinate ρ hδ⟩

theorem chain_gap_via_collapse (d : ℝ) (hc : ∃ n : ℕ, d = (n : ℝ)) (hlt : d < 1) :
    d = 0 := by
  refine gap_collapse (S := {x : ℝ | ∃ n : ℕ, x = (n : ℝ)}) id 0 1 d ?_ hlt hc ?_
  · rintro x ⟨n, rfl⟩ hne
    have hn : n ≠ 0 := by
      intro h; rw [h] at hne; simp at hne
    have : 1 ≤ n := Nat.one_le_iff_ne_zero.mpr hn
    simpa using (by exact_mod_cast this : (1:ℝ) ≤ (n : ℝ))
  · exact le_refl d

theorem family_gap_via_collapse (r : ℝ) (B : ℝ)
    (hfam : ∃ k : ℤ, r = (φ : ℝ) ^ k) (hB : B < 1) (hrB : discP r ≤ B) :
    r = 1 := by
  refine gap_collapse (S := {x : ℝ | ∃ k : ℤ, x = (φ : ℝ) ^ k})
    discP 1 1 B ?_ hB hfam hrB
  · rintro x ⟨k, rfl⟩ hne
    have hk : k ≠ 0 := by
      intro h; rw [h] at hne; simp at hne
    exact family_disc_ge_one_of_ne_zero k hk

