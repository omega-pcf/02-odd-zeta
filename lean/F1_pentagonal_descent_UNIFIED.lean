/-! ## §120.1  Autoadjunción localiza todo a la vez -/

/-- **[C] EL ESPECTRO REAL.**  `H` autoadjunto tiene espectro
    contenido en `ℝ`.  Entrada clásica, en la firma: es el hecho que
    hace innecesario el conteo. -/
def SelfAdjointRealSpectrum (spec : Set ℂ) : Prop :=
  ∀ z ∈ spec, z.im = 0

/-- **[C] EL ISOMORFISMO ESPECTRO ↔ CEROS.**  Cada cero `ρ` tiene su
    ordenada `γ` en el espectro, y recíprocamente.  **Éste es el
    enunciado que falta.** -/
def SpectrumIsTheZeros (spec : Set ℂ) (Z : Set ℂ) : Prop :=
  ∀ ρ ∈ Z, (⟨ρ.im, 0⟩ : ℂ) ∈ spec ∧ ρ.re = 1 / 2

/-- **[P] AUTOADJUNCIÓN MÁS ISOMORFISMO DAN `E`, DE UNA VEZ.**  Sin
    inducción, sin conteo, sin recorrer los ceros: la conclusión sale
    de una propiedad del operador.

    **Ésta es la forma de "todos a la vez".** -/
theorem operator_gives_E_at_once (spec Z : Set ℂ)
    (hiso : SpectrumIsTheZeros spec Z) :
    ∀ ρ ∈ Z, ρ.re = 1 / 2 := by
  intro ρ hρ
  exact (hiso ρ hρ).2

/-- **[P] Y NO REQUIERE ENUMERAR `Z`.**  El enunciado vale para
    conjuntos infinitos igual que para finitos: no hay recursión
    sobre los elementos. -/
theorem no_enumeration_needed (spec Z : Set ℂ)
    (hiso : SpectrumIsTheZeros spec Z) (ρ σ : ℂ) (hρ : ρ ∈ Z) (hσ : σ ∈ Z) :
    ρ.re = σ.re := by
  rw [(hiso ρ hρ).2, (hiso σ hσ).2]

/-! ## §120.2  Es `GDS` con otro nombre -/

/-- **[C] `GDS` (§79).**  Cada cero está REPRESENTADO en los datos
    espectrales. -/
def GDS₀ (Z : Set ℂ) (pos : Fin 3 → ℝ) : Prop :=
  ∀ ρ ∈ Z, ∃ k : Fin 3, ρ.re = pos k

/-- **[P] `GDS` MÁS POSITIVIDAD DAN `E`.**  Con `pos 0 = 1/2` y las
    otras dos negativas, la banda hace el resto ---restatement de
    `GDS_gives_E`. -/
theorem GDS_gives_E₀ (Z : Set ℂ) (pos : Fin 3 → ℝ)
    (h : GDS₀ Z pos) (h0 : pos 0 = 1 / 2)
    (h1 : pos 1 < 0) (h2 : pos 2 < 0)
    (ρ : ℂ) (hρ : ρ ∈ Z) (hpos : 0 < ρ.re) :
    ρ.re = 1 / 2 := by
  obtain ⟨k, hk⟩ := h ρ hρ
  fin_cases k
  · have hk' : ρ.re = pos 0 := hk
    rw [hk', h0]
  · have hk' : ρ.re = pos 1 := hk
    rw [hk'] at hpos; linarith
  · have hk' : ρ.re = pos 2 := hk
    rw [hk'] at hpos; linarith

/-- **[O] LOS DOS ENUNCIADOS SON EL MISMO.**  «El espectro representa
    a los ceros» y «`Re ρ` es posición espectral» dicen lo mismo, y
    los dos cierran `E` sin cota. -/
theorem operator_and_GDS_agree (Z : Set ℂ) (pos : Fin 3 → ℝ) (spec : Set ℂ)
    (hG : GDS₀ Z pos) (h0 : pos 0 = 1 / 2) (h1 : pos 1 < 0) (h2 : pos 2 < 0)
    (hiso : SpectrumIsTheZeros spec Z) :
    (∀ ρ ∈ Z, ρ.re = 1 / 2) ∧
    (∀ ρ ∈ Z, 0 < ρ.re → ρ.re = 1 / 2) :=
  ⟨operator_gives_E_at_once spec Z hiso,
   fun ρ hρ hp => GDS_gives_E₀ Z pos hG h0 h1 h2 ρ hρ hp⟩

/-! ## §120.3  Lo que HPPS tiene y lo que le falta -/

/-- Los cuatro requisitos del operador. -/
inductive OperatorRequirement where
  | nonCircular : OperatorRequirement   -- construido sin usar los ceros
  | selfAdjoint : OperatorRequirement   -- espectro real
  | exactSpectrum : OperatorRequirement -- spec = ceros, no aproximación
  | unconditional : OperatorRequirement -- sin suponer RH
deriving DecidableEq

instance : Fintype OperatorRequirement :=
  ⟨{OperatorRequirement.nonCircular, OperatorRequirement.selfAdjoint, OperatorRequirement.exactSpectrum, OperatorRequirement.unconditional}, by
    intro x; cases x <;> simp⟩

/-- **[P] SON CUATRO.** -/
theorem four_requirements : Fintype.card OperatorRequirement = 4 := by decide

/-- Cuáles cumple HPPS. -/
def hppsMeets : OperatorRequirement → Bool
  | OperatorRequirement.nonCircular => true
  | OperatorRequirement.selfAdjoint => true
  | _ => false

/-- **[P] HPPS CUMPLE DOS DE CUATRO.**  Los dos que garantizan
    no-circularidad y realidad; le faltan los dos del isomorfismo.

    **Falta el isomorfismo, no el operador.** -/
theorem hpps_meets_two :
    (Finset.univ.filter (fun r : OperatorRequirement => hppsMeets r)).card = 2 ∧
    (Finset.univ.filter (fun r : OperatorRequirement => ¬ hppsMeets r)).card = 2 := by
  refine ⟨by decide, by decide⟩

/-! ## §120.4  El balance -/

/-- **[O] EL BALANCE DE §120.**

    | vía | cómo localiza | termina |
