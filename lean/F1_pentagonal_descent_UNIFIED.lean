-- `omega_cubed` eliminado: ya existe en un fichero compilado.
-- (2026-09-06, Ola 4) NOTA: `omega_cubed` y `w_pcf_re_im` NO existen en los
-- imports (el de F1_compilado es `private`). Restaurados abajo como locales.

theorem omega_cubed : w_pcf ^ 3 = 1 := by
  unfold w_pcf
  rw [← Complex.exp_nat_mul (2 * (Real.pi : ℂ) * Complex.I / 3) 3]
  have h : (↑3 : ℂ) * (2 * (Real.pi : ℂ) * Complex.I / 3) = 2 * (Real.pi : ℂ) * Complex.I := by
    ring
  simp [h, Complex.exp_two_pi_mul_I]

theorem w_pcf_re_im : w_pcf.re = -1/2 ∧ w_pcf.im = Real.sqrt 3 / 2 :=
  w_pcf_re_im_public

theorem omega_order_is_exactly_three :
    w_pcf ≠ 1 ∧ w_pcf ^ 2 ≠ 1 := by
  constructor
  · intro h
    have := congrArg Complex.re h
    rw [w_pcf_re_im.1] at this
    norm_num at this
  · intro h2
    have h3 := omega_cubed
    have hw1 : w_pcf = 1 := by
      have : w_pcf ^ 3 = w_pcf ^ 2 * w_pcf := by ring
      rw [h3, h2] at this
      simp only [one_mul] at this
      exact this.symm
    have := congrArg Complex.re hw1
    rw [w_pcf_re_im.1] at this
    norm_num at this

theorem three_is_one_number :
    (w_pcf ^ 3 = 1 ∧ w_pcf ≠ 1 ∧ w_pcf ^ 2 ≠ 1) ∧
    ((3:ℝ) ^ 2 / 6 = 3 / 2) ∧
    (Nat.Prime 3) :=
  ⟨⟨omega_cubed, omega_order_is_exactly_three.1, omega_order_is_exactly_three.2⟩,
   by norm_num, by norm_num⟩


/-! ### Los cuatro identificadores que faltaban

Citados por `orbit_is_free_in_C`, `real_projection_collapses`,
`embedding_target_is_the_orbit_shadow` y `the_orbital_bridge` como si
estuvieran probados en otro sitio; **no existían en ningún fichero**.
Probados aquí, sólo desde `w_pcf`, `Omega_hat` y `orbitCardOf`. -/

/- (2026-09-06, Ola 4) La copia temprana de este teorema (con sorry) fue
    reemplazada en Ola B (2026-09-08) por la prueba real movida a L923;
    el nombre único que sobrevive sirve a todos los usos posteriores. -/

/-- **Fantasma 1 de 4.**  Los tres valores concretos de la parte real del
espectro.

Se usa 9 veces en `PCF_unificado.lean` vía `.1`, `.2.1`, `.2.2`, dentro de
`orbit_is_free_in_C`, `real_projection_collapses` y
`embedding_target_is_the_orbit_shadow`. -/
theorem spectral_positions_values :
    (Omega_hat 0).re = 1/2 ∧
    (Omega_hat 1).re = -(1/4) ∧
    (Omega_hat 2).re = -(1/4) := by
  obtain ⟨hre, him⟩ := w_pcf_re_im_public
  refine ⟨?_, ?_, ?_⟩
  · unfold Omega_hat; norm_num
  · unfold Omega_hat
    simp only [Fin.isValue, Fin.val_one, pow_one, Complex.mul_re,
               Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero, hre]
    norm_num
  · unfold Omega_hat
    simp only [Fin.isValue, Fin.val_two, pow_two, Complex.mul_re, Complex.mul_im,
               Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero]
    rw [hre, him]
    nlinarith [Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 3), Real.sqrt_nonneg 3]

/-- **Fantasma 2 de 4.**  Parte imaginaria del segundo autovalor.

`Ω̂₁ = (1/2)·w`, luego su parte imaginaria es `(1/2)·(√3/2) = √3/4`.
Se usa dentro de un `rw` en `orbit_is_free_in_C`. -/
theorem omega_hat_im_one : (Omega_hat 1).im = Real.sqrt 3 / 4 := by
  obtain ⟨hre, him⟩ := w_pcf_re_im_public
  unfold Omega_hat
  simp only [Fin.isValue, Fin.val_one, pow_one, Complex.mul_im,
             Complex.ofReal_re, Complex.ofReal_im, zero_mul, add_zero, him]
  ring

/-- **Fantasma 3 de 4.**  Parte imaginaria del tercer autovalor.

`Ω̂₂ = (1/2)·w²`, y `w² = w̄` por ser `w` raíz cúbica de la unidad, luego la
parte imaginaria cambia de signo: `-√3/4`. -/
theorem omega_hat_im_two : (Omega_hat 2).im = -(Real.sqrt 3 / 4) := by
  obtain ⟨hre, him⟩ := w_pcf_re_im_public
  unfold Omega_hat
  simp only [Fin.isValue, Fin.val_two, pow_two, Complex.mul_im, Complex.mul_re,
             Complex.ofReal_re, Complex.ofReal_im, zero_mul, add_zero,
             hre, him]
  ring

/-- **Fantasma 4 de 4.**  El cardinal de la órbita vale `2` exactamente sobre
la línea crítica.

Se usa en `the_orbital_bridge`.  `orbitCardOf` está definido por un `if` sobre
`ρ.re = 1/2`, así que el enunciado sale por análisis de casos; la hipótesis
`hγ : ρ.im ≠ 0` no se necesita, pero se conserva porque los llamantes la pasan. -/
theorem the_cardinal_is_the_spectral_position (ρ : ℂ) (_hγ : ρ.im ≠ 0) :
    orbitCardOf ρ = 2 ↔ ρ.re = 1/2 := by
  unfold orbitCardOf
  by_cases h : ρ.re = 1/2
  · simp [h]
  · simp

theorem orbit_is_free_in_C :
    Omega_hat 0 ≠ Omega_hat 1 ∧ Omega_hat 0 ≠ Omega_hat 2 ∧
    Omega_hat 1 ≠ Omega_hat 2 := by
  refine ⟨?_, ?_, ?_⟩
  · intro h
    have := congrArg Complex.re h
    rw [spectral_positions_values.1, spectral_positions_values.2.1] at this
    norm_num at this
  · intro h
    have := congrArg Complex.re h
    rw [spectral_positions_values.1, spectral_positions_values.2.2] at this
    norm_num at this
  · intro h
    have := congrArg Complex.im h
    rw [omega_hat_im_one, omega_hat_im_two] at this
    have h3 : Real.sqrt 3 > 0 := Real.sqrt_pos.mpr (by norm_num)
    linarith

theorem real_projection_collapses :
    (Omega_hat 1).re = (Omega_hat 2).re := by
  rw [spectral_positions_values.2.1, spectral_positions_values.2.2]

theorem band_leaves_one :
    (0 < (1:ℝ)/2 ∧ (1:ℝ)/2 < 1) ∧ ¬ (0 < -(1:ℝ)/4) := by
