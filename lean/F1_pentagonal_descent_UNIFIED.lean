/-! ## 1.  El hueco -/

/-- **[P⊕] EL HUECO, Y QUE NO SE REPARA.**  §5 del paper.

    (a) `thm:blind` — un observable invariante de cubierta es función del
        nivel, y recíprocamente;
    (b) `cor:claim1` — dos índices conjuntos sobre un mismo nivel no se
        separan;
    (c) `prop:notabsorbable` — y no se repara eligiendo mejor coordenada de
        nivel, porque `Hom(μ₆, ℤ) = 0`;
    (d) `thm:ccso` + `cor:ccso-uncond` — la terna sí separa, sin hipótesis. -/
theorem el_hueco :
    (∀ E : Nat → Nat, (∀ i, E (deckStep i).1 = E i.1) →
       ∀ i j : JointIdx, i.1 = j.1 → symH E i = symH E j) ∧
    (∀ f : Nat → Int, IsLevelHom f →
       ¬ (∀ a b : Nat, a < 6 → b < 6 → f a = f b → a = b)) ∧
    (∀ i j : JointIdx,
       symH realE i = symH realE j →
       symC realC i = symC realC j →
       symO realO i = symO realO j → i = j) :=
  ⟨fun E _ i j hij => congrArg E hij,
   no_faithful_level_hom,
   fun i j h1 h2 h3 => ccso_unconditional i j h1 h2 h3⟩

/-! ## 2.  El relleno -/

/-- **[P⊕] EL RELLENO.**  §7 del paper.

    (a) `thm:k0` — el carácter trivial es ciego;
    (b) `thm:k1` — el dual completo separa la fibra;
    (c) `thm:blocks-invariant` — y la dinámica preserva cada bloque, luego la
        transformada bloquea-diagonaliza la evolución;
    (d) `cor:blocks-split` — el bloque `k = 0` es exactamente la clase de
        Fourier, y ningún otro lo es. -/
theorem el_relleno :
    (fib6.all (fun n => chr 0 n == chr 0 0) = true) ∧
    (∀ a ∈ fib6, ∀ b ∈ fib6, a ≠ b → ∃ k ∈ dual6, chr k a ≠ chr k b) ∧
    (∀ k : Nat, ∀ f : JointIdx → Nat, IsIsotypic k f →
       IsIsotypic k (fun i => f (raise i))) ∧
    (∀ k : Nat, 0 < k → k < 6 → ∀ g : JointIdx → Nat, (∀ i, g i < 6) →
       IsIsotypic k g → ∃ i, g (deckStep i) ≠ g i) :=
  ⟨trivial_character_is_blind, dual_separates_the_fibre,
   fun k f hf => isotypic_invariant_under_dynamics k f hf,
   fun k hk0 hk g hr hg => nonzero_type_is_not_deck_invariant k hk0 hk g hr hg⟩

/-! ## 3.  Una sola causa -/

/-- **[P⊕] UNA FORMA, DOS LUGARES.**  §6 del paper, `prop:blind-is-irr`.

    La irracionalidad de `φ` y la aperiodicidad de toda frecuencia son `N`
    evaluada en dos argumentos, y la imposibilidad de fondo es que `N` sólo
    representa `0` en el origen. -/
theorem una_sola_causa :
    (∀ a b : Int, normFormMul a (-b) = a * a - a * b - b * b) ∧
    (∀ m f : Nat, 0 < f → normFormMul (m : Int) (-(f : Int)) ≠ 0) ∧
    (∀ n : Nat, Mat2.det (Mat2.sub (Mat2.npow M n) Mat2.one)
        = normFormMul ((coef n).2 - 1) (coef n).1) ∧
    (∀ a b : Int, normFormMul a b = 0 → a = 0 ∧ b = 0) :=
  ⟨normFormMul_neg_snd, irrationality_is_the_form_at_neg,
   aperiodicity_is_the_form_at_coef, fun _ _ h => normFormMul_eq_zero h⟩

/-! ## 4.  El aparato de la transformada -/

/-- **[P⊕] EL APARATO.**  §7.4 del paper.

    (a) ortogonalidad: los seis caracteres son independientes;
    (b) completitud: y bastan;
    (c) inversión exacta, sin división, dentro de `ℤ[ω]`;
    (d) incertidumbre: una delta de la fibra tiene transformada de soporte
        pleno —el caso de igualdad de Donoho–Stark—. -/
theorem el_aparato :
    (∀ k ∈ [0,1,2,3,4,5], ∀ l ∈ [0,1,2,3,4,5],
      sum6 (fun n => Eis.mul (chi k n) (Eis.conj (chi l n)))
        = (if k = l then Eis.smul 6 Eis.one else Eis.zero)) ∧
    (∀ m ∈ [0,1,2,3,4,5], ∀ n ∈ [0,1,2,3,4,5],
      sum6 (fun k => Eis.mul (chi k m) (Eis.conj (chi k n)))
        = (if m = n then Eis.smul 6 Eis.one else Eis.zero)) ∧
    (∀ f : Nat → Eis, ∀ n : Nat, n < 6 →
      synthesis (analysis f) n = Eis.smul 6 (f n)) ∧
    (∀ j ∈ [0,1,2,3,4,5], ∀ k ∈ [0,1,2,3,4,5],
      analysis (delta j) k ≠ Eis.zero) ∧
    (∀ f g : Nat → Eis, sesq f g = Eis.smul 6 (inner f g)) :=
  ⟨orthogonality, completeness, inversion, delta_needs_all_six,
   parseval_sesquilinear⟩

/-! ## 5.  El teorema -/

/-- **★ EL TEOREMA DEL DESARROLLO ★**

    Lo que el paper afirma, en una firma, ensamblado de los quince módulos:

      el hueco  ∧  el relleno  ∧  una sola causa  ∧  el aparato

    Y con ellos: **Fourier clásico es el bloque trivial de seis; los otros
    cinco llevan la fibra; ningún reetiquetado del nivel los recupera; y la
    transformada emparejada con `μ₆ = ℤ[ω]ˣ` los lee, con inversión exacta
    dentro del mismo anillo.**

    ALCANCE.  Todo esto es aritmética, combinatoria e índices.  La capa
    topológica —toros de aplicación, `H₁`, clases características, el reparto
    isotípico de `L²`— se cita en el paper y no se formaliza aquí; §9.2 del
    paper marca la división. -/
theorem main_theorem :
    (∀ f : Nat → Int, IsLevelHom f →
       ¬ (∀ a b : Nat, a < 6 → b < 6 → f a = f b → a = b)) ∧
    (∀ a ∈ fib6, ∀ b ∈ fib6, a ≠ b → ∃ k ∈ dual6, chr k a ≠ chr k b) ∧
    (∀ a b : Int, normFormMul a b = 0 → a = 0 ∧ b = 0) ∧
    (∀ f : Nat → Eis, ∀ n : Nat, n < 6 →
       synthesis (analysis f) n = Eis.smul 6 (f n)) :=
  ⟨el_hueco.2.1, el_relleno.2.1, una_sola_causa.2.2.2, el_aparato.2.2.1⟩

/- =====================================================================
   PARTE II - EL PUENTE REAL (los nueve nombres con daga)
   ===================================================================== -/

noncomputable section
open Real goldenRatio

/-! ### Standing facts about `φ`, restated for convenience. -/

theorem golden_pos : (0 : ℝ) < φ := Real.goldenRatio_pos

theorem golden_ne_one : (φ : ℝ) ≠ 1 := ne_of_gt Real.one_lt_goldenRatio

theorem golden_ne_zero : (φ : ℝ) ≠ 0 := ne_of_gt golden_pos

/-! ### 1.  The norm form is the product of the two conjugates.

    Cited in the Proposition *The determinant is the norm*, alongside the
    compiled names `det_M_eq_normFormMul`, `znorm_eq_normFormMul`,
    `normFormMul_phi` and `znorm_one`.  Those four are integer identities
    and are already proved in Part I above; what needs `ℝ` is the
    statement that the integer quadratic form `a² + ab − b²` really is the
    field norm, i.e. the product over the two embeddings of `ℚ(φ)`. -/

/-- `N(a + bφ) = (a + bφ)(a + bψ) = a² + ab − b²`, with `ψ = 1 − φ` the
    conjugate.  This is the daggered name `normForm_eq_product`. -/
theorem normForm_eq_product (a b : ℝ) :
    (a + b * φ) * (a + b * ψ) = a ^ 2 + a * b - b ^ 2 := by
  have hsum : (φ : ℝ) + ψ = 1 := Real.goldenRatio_add_goldenConj
  have hprod : (φ : ℝ) * ψ = -1 := Real.goldenRatio_mul_goldenConj
  have expand :
      (a + b * φ) * (a + b * ψ)
        = a ^ 2 + a * b * (φ + ψ) + b ^ 2 * (φ * ψ) := by ring
  rw [expand, hsum, hprod]
  ring

/-- The same statement in the spelling the note uses, `φ̄ = 1 − φ`. -/
theorem normForm_eq_product' (a b : ℝ) :
    (a + b * φ) * (a + b * (1 - φ)) = a ^ 2 + a * b - b ^ 2 := by
  have h := normForm_eq_product a b
  have h1ψ : (1 : ℝ) - ψ = φ := Real.one_sub_goldenRatio
  have h1φ : (1 : ℝ) - φ = ψ := by linarith
  rw [h1φ]
  exact h

/-- Specialising to `a = 0`, `b = 1` recovers `N(φ) = −1`, the arithmetic
    fact behind the non-orientability of `X`. -/
theorem normForm_golden : (0 + 1 * φ) * (0 + 1 * ψ) = -1 := by
  rw [normForm_eq_product]; ring

/-! ### 2.  Adjacent closure, with a real exponent.

    Cited in the Theorem *Adjacent closure*.  Part I proves
    `adjacent_closure` in the `ℤ[φ]` coordinates, i.e. for integer
    exponents, by the Fibonacci recursion.  The real-exponent version is
    what the note actually asserts ("for all σ ∈ ℝ") and it needs `rpow`. -/

/-- `φ^σ + φ^(σ+1) = φ^(σ+2)` for every real `σ`.  This is the daggered
    name `adjacent_closure_real`. -/
theorem adjacent_closure_real (σ : ℝ) :
    (φ : ℝ) ^ σ + (φ : ℝ) ^ (σ + 1) = (φ : ℝ) ^ (σ + 2) := by
  have hφ : (0 : ℝ) < φ := golden_pos
  have hsq : (φ : ℝ) ^ (2 : ℝ) = φ + 1 := by
    rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, Real.rpow_natCast,
        Real.goldenRatio_sq]
  rw [Real.rpow_add hφ σ 1, Real.rpow_add hφ σ 2, Real.rpow_one, hsq]
  ring

/-- Among positive reals, `φ` is the only ratio with the closure property.
    Testing the property at `σ = 0` already forces `r² = r + 1`, and that
    equation has exactly one positive root.  This is the daggered name
    `golden_unique_closure`. -/
theorem golden_unique_closure {r : ℝ} (hr : 0 < r)
    (h : ∀ σ : ℝ, r ^ σ + r ^ (σ + 1) = r ^ (σ + 2)) : r = φ := by
  -- Step 1: evaluate the hypothesis at σ = 0 to get r² = r + 1.
  have h0 := h 0
  simp only [Real.rpow_zero, zero_add, Real.rpow_one] at h0
  -- h0 : 1 + r = r ^ (2 : ℝ)
  rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, Real.rpow_natCast] at h0
  have hsq : r ^ 2 = r + 1 := by linarith
  -- Step 2: r² = r + 1 and φ² = φ + 1 give (r − φ)(r + φ − 1) = 0 exactly.
  have hφsq : (φ : ℝ) ^ 2 = φ + 1 := Real.goldenRatio_sq
  have hfac : (r - φ) * (r + φ - 1) = 0 := by
    linear_combination hsq - hφsq   -- fallback: nlinarith [hsq, hφsq]
  -- Step 3: r + φ − 1 > 0, because r > 0 and φ > 1.
  have hpos : 0 < r + φ - 1 := by
    have := Real.one_lt_goldenRatio
    linarith
  rcases mul_eq_zero.mp hfac with h1 | h2
  · linarith
  · linarith

/-! ### 3.  The density constant.

    `Λ` is defined exactly as the note defines it: `Λ = log 2 / log φ`,
    which is `Real.logb φ 2` unfolded.  Cited in the Propositions
    *Sampling density* and *Density, exactly*. -/

/-- The sampling density of the `φ`-tower: levels per octave. -/
def Lambda : ℝ := Real.logb φ 2

/-- `Λ = log 2 / log φ`, the note's own definition.  True by `rfl`,
    since `Real.logb b x` is *defined* as `log x / log b`. -/
theorem Lambda_eq_div : Lambda = Real.log 2 / Real.log φ := rfl

/-- `Λ · log₂ φ = 1`: the density constant and the octave fraction are
    reciprocal.  This is the daggered name `lambda_logb_inv`. -/
theorem lambda_logb_inv : Lambda * Real.logb 2 φ = 1 := by
  unfold Lambda
  rw [Real.mul_logb (by norm_num : (2 : ℝ) ≠ 0) (by norm_num : (2 : ℝ) ≠ 1)
        (by norm_num : (2 : ℝ) ≠ -1)]
  exact Real.logb_self_eq_one Real.one_lt_goldenRatio

/-- The reciprocal spelling: `log₂ φ = 1 / Λ`. -/
theorem logb_two_golden_eq_inv : Real.logb 2 φ = 1 / Lambda := by
  have h := lambda_logb_inv
  have hΛ : Lambda ≠ 0 := by
    intro h0; rw [h0, zero_mul] at h; norm_num at h
  field_simp
  linear_combination h

/-- `φ^Λ = 2`: raising the golden ratio to the density constant lands
    exactly on the octave.  This is the daggered name `mersenne_bridge`. -/
theorem mersenne_bridge : (φ : ℝ) ^ Lambda = 2 := by
  unfold Lambda
  exact Real.rpow_logb golden_pos golden_ne_one (by norm_num)

/-! ### 4.  Density, stated exactly.

    Cited in the Proposition *Density, exactly*.  The content is that the
    ratio of `φ`-levels to dyadic levels is the constant `Λ` in *every*
    interval, before flooring -- an identity, not an asymptotic estimate. -/

/-- `log_φ T = Λ · log₂ T` for every `T`.  This is the daggered name
    `density_exact`.

    No positivity hypothesis is needed: both sides are `log T` divided by
    a nonzero constant, so the identity is pure field arithmetic and holds
    for every real `T` at which `Real.log` is defined (which, in Mathlib's
    total convention, is all of them).  The note states it for `T > 0`,
    which this implies; see `density_exact_of_pos`. -/
theorem density_exact (T : ℝ) : Real.logb φ T = Lambda * Real.logb 2 T := by
  have h2 : Real.log 2 ≠ 0 :=
    Real.log_ne_zero_of_pos_of_ne_one (by norm_num) (by norm_num)
  have hφ : Real.log φ ≠ 0 :=
    Real.log_ne_zero_of_pos_of_ne_one golden_pos golden_ne_one
  unfold Lambda Real.logb
  field_simp

/-- The note's own shape of the statement. -/
theorem density_exact_of_pos {T : ℝ} (_hT : 0 < T) :
    Real.logb φ T = Lambda * Real.logb 2 T := density_exact T

/-! ### 5.  The multiresolution obstruction.

    Cited in the Proposition *No multiresolution analysis has dilation φ*.
    The arithmetic half -- that no integer, natural or rational `r` has
    `r² = r + 1` -- is block 14 of Part I and is already
    compiled.  What lives here is the passage from the lattice condition
    to `a ∈ ℤ`, and the fact that `φ` is not an integer, which needs the
    irrationality of `√5`. -/

/-- `φ` is not a natural number.  This is the daggered name
    `golden_not_nat`. -/
theorem golden_not_nat : ∀ n : ℕ, ((n : ℝ)) ≠ φ :=
  fun n h => Real.goldenRatio_irrational.ne_nat n h.symm

/-- `φ` is not an integer either. -/
theorem golden_not_int : ∀ m : ℤ, ((m : ℝ)) ≠ φ :=
  fun m h => Real.goldenRatio_irrational.ne_int m h.symm

/-- The lattice condition: if the dilation `a` carries `ℤ` into `ℤ`, then
    `a` is itself an integer.  Taking the generator is the whole proof.
    This is the daggered name `lattice_condition`. -/
theorem lattice_condition {a : ℝ}
    (h : ∀ n : ℤ, ∃ m : ℤ, a * (n : ℝ) = (m : ℝ)) :
    ∃ m : ℤ, a = (m : ℝ) := by
  obtain ⟨m, hm⟩ := h 1
  exact ⟨m, by simpa using hm⟩

/-- The same condition written as an inclusion of subsets of `ℝ`, which is
    how the multiresolution axiom is usually stated: `a · ℤ ⊆ ℤ`. -/
theorem lattice_condition_set {a : ℝ}
    (h : (fun x : ℝ => a * x) '' (Set.range ((↑) : ℤ → ℝ))
           ⊆ Set.range ((↑) : ℤ → ℝ)) :
    ∃ m : ℤ, a = (m : ℝ) := by
  have hmem : a * ((1 : ℤ) : ℝ) ∈ Set.range ((↑) : ℤ → ℝ) :=
    h ⟨((1 : ℤ) : ℝ), ⟨1, rfl⟩, rfl⟩
  obtain ⟨m, hm⟩ := hmem
  exact ⟨m, by simpa using hm.symm⟩

/-- No multiresolution ladder has dilation `φ`: the lattice condition
    would make `φ` an integer, and it is not.  This is the daggered name
    `no_MRA_golden_dilation`. -/
theorem no_MRA_golden_dilation :
    ¬ (∀ n : ℤ, ∃ m : ℤ, (φ : ℝ) * (n : ℝ) = (m : ℝ)) := by
  intro h
  obtain ⟨m, hm⟩ := lattice_condition h
  exact golden_not_int m hm.symm

/-- The set-theoretic spelling of the same obstruction. -/
theorem no_MRA_golden_dilation_set :
    ¬ ((fun x : ℝ => φ * x) '' (Set.range ((↑) : ℤ → ℝ))
         ⊆ Set.range ((↑) : ℤ → ℝ)) := by
  intro h
  obtain ⟨m, hm⟩ := lattice_condition_set h
  exact golden_not_int m hm.symm


/-!
  ### What this file does NOT prove, and why.

  The note quotes two decimal expansions to thirty places:

      log_2 phi = 0.694241913630617301738790266898...
      Lambda    = 1.440420090412556479017551499587...

  Those digits are *not* established here, and cannot reasonably be.
  Mathlib's `norm_num` has no extension that certifies thirty significant
  figures of a quotient of logarithms; producing them would require
  interval arithmetic on `Real.log` at a precision the library does not
  currently support as a decision procedure.  What this file proves is the
  structural content in which those digits sit -- that the two constants
  are reciprocal (`lambda_logb_inv`), that `phi` raised to one of them is
  exactly `2` (`mersenne_bridge`), and that the density ratio is that same
  constant in every interval (`density_exact`).  The digits themselves
  remain a numerical assertion, checked to thirty places by
  `PCF_granularity_verify_v1.py`.

  That is the honest division of labour, and the note should say so.
-/

end
end PCFGranularity


