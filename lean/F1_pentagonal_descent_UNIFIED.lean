theorem valPhi_is_the_morphism (r s : ℝ) (hr : 0 < r) (hs : 0 < s) :
    valPhi (r * s) = valPhi r + valPhi s :=
  valPhi_mul r s hr hs

theorem valPhi_inversion_is_negation (r : ℝ) (hr : 0 < r) :
    valPhi (1 / r) = - valPhi r := by
  have h : valPhi (r * (1/r)) = valPhi r + valPhi (1/r) :=
    valPhi_mul r (1/r) hr (by positivity)
  rw [mul_one_div_cancel (ne_of_gt hr)] at h
  have h1 : valPhi (1:ℝ) = 0 := by unfold valPhi; simp
  rw [h1] at h
  linarith

theorem kmate_negates_the_valuation (ρ : ℂ) (h₀ : ρ ≠ 0) (h₁ : ρ ≠ 1)
    (hpos : 0 < zeroCoord ρ) :
    valPhi (zeroCoord (1 - (starRingEnd ℂ) ρ)) = - valPhi (zeroCoord ρ) := by
  rw [kmate_inverts_the_coordinate ρ h₀ h₁, inv_eq_one_div]
  exact valPhi_inversion_is_negation (zeroCoord ρ) hpos

theorem the_pair_sums_to_zero (ρ : ℂ) (h₀ : ρ ≠ 0) (h₁ : ρ ≠ 1)
    (hpos : 0 < zeroCoord ρ) :
    valPhi (zeroCoord ρ) + valPhi (zeroCoord (1 - (starRingEnd ℂ) ρ)) = 0 := by
  rw [kmate_negates_the_valuation ρ h₀ h₁ hpos]; ring

theorem E_iff_the_pair_collapses (ρ : ℂ) (h0 : 0 < ρ.re) (h1 : ρ.re < 1) :
    (valPhi (zeroCoord ρ) = - valPhi (zeroCoord ρ)) ↔ ρ.re = 1/2 := by
  have hne0 : ρ ≠ 0 := by intro h; rw [h] at h0; simp at h0
  have hne1 : ρ ≠ 1 := by intro h; rw [h] at h1; simp at h1
  have hpos : 0 < zeroCoord ρ := by
    unfold zeroCoord
    refine Complex.abs.pos ?_
    intro hz
    unfold liMap at hz
    have : (ρ - 1) / ρ = 0 := by
      rw [← hz]; field_simp
    have hnum : ρ - 1 = 0 := by
      field_simp at this; rw [mul_zero] at this; exact this
    exact hne1 (by linear_combination hnum)
  constructor
  · intro h
    have hv : valPhi (zeroCoord ρ) = 0 := by linarith
    have hlogphi : Real.log (φ : ℝ) ≠ 0 := ne_of_gt (Real.log_pos one_lt_phi)
    have hlog : Real.log (zeroCoord ρ) = 0 := by
      unfold valPhi at hv
      field_simp at hv
      rw [mul_zero] at hv
      exact hv
    have hcoord : zeroCoord ρ = 1 := by
      have he := Real.exp_log hpos
      rw [hlog, Real.exp_zero] at he
      exact he.symm
    exact (hcoord_discharged ρ h0).mp hcoord
  · intro hE
    rw [E_coordinate_exponent_is_zero ρ h0 hE]; ring

theorem the_multiplicative_reading (ρ : ℂ) (h₀ : ρ ≠ 0) (h₁ : ρ ≠ 1)
    (hpos : 0 < zeroCoord ρ) (r s : ℝ) (hr : 0 < r) (hs : 0 < s) :
    (valPhi (r * s) = valPhi r + valPhi s) ∧
    (valPhi (1 / r) = - valPhi r) ∧
    (valPhi (zeroCoord (1 - (starRingEnd ℂ) ρ)) = - valPhi (zeroCoord ρ)) ∧
    (valPhi (zeroCoord ρ) + valPhi (zeroCoord (1 - (starRingEnd ℂ) ρ)) = 0) :=
  ⟨valPhi_is_the_morphism r s hr hs,
   valPhi_inversion_is_negation r hr,
   kmate_negates_the_valuation ρ h₀ h₁ hpos,
   the_pair_sums_to_zero ρ h₀ h₁ hpos⟩

theorem golden_pair_is_a_unit_pair :
    (φ : ℝ) * ((φ : ℝ) - 1) = 1 ∧ (φ : ℝ) - 1 = ((φ : ℝ))⁻¹ := by
  refine ⟨phi_mul_phi_sub_one, ?_⟩
  have hp : (φ : ℝ) ≠ 0 := ne_of_gt φ_pos
  field_simp
  linear_combination phi_mul_phi_sub_one

theorem golden_pair_valuations :
    valPhi (φ : ℝ) = 1 ∧ valPhi (((φ : ℝ))⁻¹) = -1 := by
  constructor
  · have h := valPhi_realise 1
    rw [zpow_one] at h
    simpa using h
  · have h := valPhi_realise (-1)
    rw [zpow_neg_one] at h
    simpa using h

theorem unit_maps_to_origin : valPhi (1:ℝ) = 0 := by
