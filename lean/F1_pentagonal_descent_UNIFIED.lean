/-! ## Discharges found by the readback of the audited core (Ronda 7)

  Two statements of the paper were proved in the corpus only under a hypothesis that
  nothing discharged, or only on finitely many instances.  These close them. -/

open scoped LSeries.notation in
/-- **[P*] Theorem 14.1, unconditional.**  The corpus proves the pentagonal determination of
    `ζ(2k+1)` under the hypothesis `L(2k+1, χ₅) ≠ 0`.  That hypothesis holds: for `Re s > 1`
    the L-series is the L-function (`LFunction_eq_LSeries`), which does not vanish on
    `Re s ≥ 1` for `χ₅ ≠ 1` (`LFunction_ne_zero_of_one_le_re`, as in `nonvanishing_from_one`). -/
theorem zeta_odd_pentagonal_determination_unconditional (k : ℕ) (hk : 1 ≤ k) :
    riemannZeta ((2 * k + 1 : ℕ) : ℂ) =
      F1PCFUnified.zeta_K ((2 * k + 1 : ℕ) : ℂ) / L ↗F1PCFUnified.chi5_D ((2 * k + 1 : ℕ) : ℂ) := by
  have hs : 1 < ((2 * k + 1 : ℕ) : ℂ).re := by
    rw [Complex.natCast_re]
    exact_mod_cast (show 1 < 2 * k + 1 by omega)
  refine F1PCFUnified.zeta_odd_pentagonal_determination k hk ?_
  rw [← DirichletCharacter.LFunction_eq_LSeries F1PCFUnified.chi5_D hs]
  exact DirichletCharacter.LFunction_ne_zero_of_one_le_re F1PCFUnified.chi5_D
    (Or.inl F1PCFUnified.chi5_ne_one) hs.le

/-- **[P*] Every Lucas number from the index 2 on is at least 3**, by the recurrence. -/
theorem lucasS_ge_three_from_two : ∀ n : ℕ, 3 ≤ _root_.lucasS (n + 2) ∧ 3 ≤ _root_.lucasS (n + 3)
  | 0 => by refine ⟨by norm_num [_root_.lucasS], by norm_num [_root_.lucasS]⟩
  | (n + 1) => by
      obtain ⟨h1, h2⟩ := lucasS_ge_three_from_two n
      refine ⟨h2, ?_⟩
      have e : _root_.lucasS (n + 1 + 3) = _root_.lucasS (n + 3) + _root_.lucasS (n + 2) := by
        show _root_.lucasS ((n + 2) + 2) = _root_.lucasS ((n + 2) + 1) + _root_.lucasS (n + 2)
        rfl
      rw [e]; omega

/-- **[P*] Proposition 20.21 for the whole spectrum.**  The even-index traces `L_{2m}` are all
    at least 3 for `m ≥ 1`, so `L₀ = 2` is the only structural value below 3 — for every `m`,
    not only for the first five. -/
theorem even_lucas_below_three_iff (m : ℕ) : _root_.lucasS (2 * m) < 3 ↔ m = 0 := by
  constructor
  · intro h
    by_contra hm
    obtain ⟨j, rfl⟩ : ∃ j, m = j + 1 := ⟨m - 1, by omega⟩
    have := (lucasS_ge_three_from_two (2 * j)).1
    rw [show 2 * (j + 1) = 2 * j + 2 by ring] at h
    omega
  · rintro rfl
    norm_num [_root_.lucasS]

/-- **[P*] The normalised triad is an isometry.**  Each eigenvalue `½·ζ₃ᵏ` of the operator has
    modulus `½`, so `‖v‖² = 3/4`; normalised by `‖v‖ = √3/2`, the three squared moduli are `1/3`
    each and sum to `1`: the column `V : ℂ → ℂ³` satisfies `V†V = 1`.  (The Crystalline
    Worldsheet proves the same statement as `bulkBoundary_isometry`.) -/
theorem triad_isometry :
    ∑ k : Fin 3, (‖(1/2 : ℂ) * Complex.exp (2 * Real.pi * Complex.I / 3) ^ (k : ℕ)‖
      / (Real.sqrt 3 / 2)) ^ 2 = 1 := by
  have hz : ‖Complex.exp (2 * Real.pi * Complex.I / 3)‖ = 1 := by
    rw [show (2 * Real.pi * Complex.I / 3 : ℂ) = ((2 * Real.pi / 3 : ℝ) : ℂ) * Complex.I by
      push_cast; ring]
    exact Complex.norm_exp_ofReal_mul_I _
  have h : ∀ k : Fin 3,
      ‖(1/2 : ℂ) * Complex.exp (2 * Real.pi * Complex.I / 3) ^ (k : ℕ)‖ = 1/2 := by
    intro k
    rw [norm_mul, norm_pow, hz, one_pow, mul_one]
    norm_num
  simp_rw [h]
  rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  have h3 : (Real.sqrt 3) ^ 2 = 3 := Real.sq_sqrt (by norm_num)
  simp only [div_pow, h3]
  norm_num

/-! ## The quotient by squares, and the residue symbol of φ as the angle of its polar form

  Two exact statements behind §5.3.5 (the ladder of angles on the circle of each prime).

  (1) `G` is the quotient of `(ℤ/20)^×` by its squares: its kernel `{1, 9}` is exactly the set of
      squares, so the characters that factor through `G` are the quadratic ones.
  (2) At a prime `p` where `φ` splits (`r² = r + 1` in `ZMod p`), `φ` is an `n`-th power modulo `p`
      iff `r^((p−1)/n) = 1` (Euler's criterion in the cyclic group `(ZMod p)ˣ`).  Since `r` is the
      reduction of the Teichmüller representative `[φ̄]` of the polar form `φ = [φ̄]·⟨φ⟩`, and the
      principal-unit part `⟨φ⟩ ≡ 1` contributes nothing to `(p−1)/n`-th powers, the `n`-th power
      residue symbol of `φ` is the image in `μ_n` of the angular part of `φ` at `p`. -/

/-- **[P*] `G` is the quotient by squares.**  On the units mod 20, `G a = 0` iff `a` is a square. -/
theorem G_kernel_eq_squares : ∀ a : ZMod 20, a ∈ F1SpectraAnchorG.ZtwentyStar →
    (F1SpectraAnchorG.G a = (0, 0) ↔ ∃ b ∈ F1SpectraAnchorG.ZtwentyStar, b * b = a) := by
  decide

/-- **[P*]** The squares of `(ℤ/20)^×` are `{1, 9}`. -/
theorem squares_of_units_twenty :
    F1SpectraAnchorG.ZtwentyStar.image (fun b : ZMod 20 => b * b) = {1, 9} := by
  decide

/-- **[P*] Euler's criterion for `n`-th powers in `(ZMod p)ˣ`.**  For `n ∣ p − 1`, a unit is an
    `n`-th power iff its `(p − 1)/n`-th power is `1`. -/
theorem units_pow_iff {p : ℕ} [hp : Fact p.Prime] {n : ℕ} (hn : n ∣ p - 1) (x : (ZMod p)ˣ) :
    (∃ b : (ZMod p)ˣ, b ^ n = x) ↔ x ^ ((p - 1) / n) = 1 := by
  have hcard : Fintype.card (ZMod p)ˣ = p - 1 := ZMod.card_units p
  have hp1 : 0 < p - 1 := Nat.sub_pos_of_lt hp.out.one_lt
  constructor
  · rintro ⟨b, rfl⟩
    rw [← pow_mul, Nat.mul_div_cancel' hn, ← hcard, pow_card_eq_one]
  · intro hx
    obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := (ZMod p)ˣ)
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hg x)
    have hord : orderOf g = p - 1 := by
      rw [orderOf_eq_card_of_forall_mem_zpowers hg, Nat.card_eq_fintype_card, hcard]
    have hpm : p - 1 = n * ((p - 1) / n) := (Nat.mul_div_cancel' hn).symm
    have hmpos : 0 < (p - 1) / n :=
      Nat.div_pos (Nat.le_of_dvd hp1 hn) (Nat.pos_of_dvd_of_pos hn hp1)
    rw [← zpow_natCast, ← zpow_mul] at hx
    rw [← hord] at hx
    have hdvd : ((p - 1 : ℕ) : ℤ) ∣ k * (((p - 1) / n : ℕ) : ℤ) := by
      rw [← hord]; exact orderOf_dvd_iff_zpow_eq_one.mpr hx
    have hpm' : ((p - 1 : ℕ) : ℤ) = (n : ℤ) * (((p - 1) / n : ℕ) : ℤ) := by exact_mod_cast hpm
    rw [hpm'] at hdvd
    have hnk : (n : ℤ) ∣ k :=
      Int.dvd_of_mul_dvd_mul_right (Int.ofNat_ne_zero.mpr hmpos.ne') hdvd
    obtain ⟨j, rfl⟩ := hnk
    exact ⟨g ^ j, by rw [← zpow_natCast, ← zpow_mul, mul_comm]⟩

/-- **[P*] The residue symbol of `φ` is the angle of its polar form.**  If `φ` splits at `p`
    (`r² = r + 1` in `ZMod p`) and `n ∣ p − 1`, then `φ ≡ r` is an `n`-th power modulo `p` iff
    `r^((p−1)/n) = 1`. -/
theorem phi_residue_symbol {p : ℕ} [hp : Fact p.Prime] {n : ℕ} (hn : n ∣ p - 1)
    (r : ZMod p) (hr : r ^ 2 = r + 1) :
    (∃ b : ZMod p, b ^ n = r) ↔ r ^ ((p - 1) / n) = 1 := by
  have hr0 : r ≠ 0 := by
    rintro rfl; simp at hr
  have hp1 : 0 < p - 1 := Nat.sub_pos_of_lt hp.out.one_lt
  have hn0 : n ≠ 0 := by rintro rfl; simp at hn; omega
  constructor
  · rintro ⟨b, hb⟩
    have hb0 : b ≠ 0 := by
      rintro rfl; rw [zero_pow hn0] at hb; exact hr0 hb.symm
    rw [← hb, ← pow_mul, Nat.mul_div_cancel' hn]
    exact ZMod.pow_card_sub_one_eq_one hb0
  · intro h
    obtain ⟨u, hu⟩ := (units_pow_iff hn (Units.mk0 r hr0)).mpr
      (Units.ext (by simpa using h))
    exact ⟨u, by simpa using congrArg Units.val hu⟩

/-- **[P*] Two instances.**  At `p = 11`, `φ ≡ 4` is not a fifth power (`4² = 5 ≠ 1`); at
    `p = 211`, `φ ≡ 33` is one: `94⁵ = 33`. -/
theorem phi_fifth_power_instances :
    ((4 : ZMod 11) ^ 2 = 4 + 1 ∧ (4 : ZMod 11) ^ ((11 - 1) / 5) ≠ 1) ∧
      ((33 : ZMod 211) ^ 2 = 33 + 1 ∧ (94 : ZMod 211) ^ 5 = 33 ∧
        (33 : ZMod 211) ^ ((211 - 1) / 5) = 1) := by
  decide

/-- **[P*] The fifth-power residue symbol of `φ` is not a function of the class mod 20.**
    `11` and `211` lie in the same class (`≡ 11 mod 20`).  At `p = 11` neither root of `x² − x − 1`
    (`4` and `8`) has `r² = 1`, so by `phi_residue_symbol` `φ` is not a fifth power; at `p = 211` both
    roots (`33` and `179`) have `r⁴² = 1`, so `φ` is one.  No digit in base 20 decides it. -/
theorem phi_residue_not_class_function :
    (211 % 20 = 11 % 20) ∧
      ((4 : ZMod 11) ^ 2 = 4 + 1 ∧ (8 : ZMod 11) ^ 2 = 8 + 1 ∧
        (4 : ZMod 11) ^ ((11 - 1) / 5) ≠ 1 ∧ (8 : ZMod 11) ^ ((11 - 1) / 5) ≠ 1) ∧
      ((33 : ZMod 211) ^ 2 = 33 + 1 ∧ (179 : ZMod 211) ^ 2 = 179 + 1 ∧
        (33 : ZMod 211) ^ ((211 - 1) / 5) = 1 ∧ (179 : ZMod 211) ^ ((211 - 1) / 5) = 1) := by
  decide

end F1PaperNew
end Block22

