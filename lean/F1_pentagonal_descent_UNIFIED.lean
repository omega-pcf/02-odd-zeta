/-- Traza de un real positivo: `r + 1/r`.  Corpus §129. -/
noncomputable def e1P (r : ℝ) : ℝ := r + 1 / r

/-- Discriminante: `(r + 1/r)² − 4`.  Corpus §129. -/
noncomputable def discP (r : ℝ) : ℝ := (e1P r) ^ 2 - 4

/-- compat: `Complex.abs` fue eliminado en v4.29; hoy es la norma (ℝ-valued). -/
noncomputable abbrev Complex.abs (z : ℂ) : ℝ := ‖z‖

theorem Complex.abs_apply (z : ℂ) : Complex.abs z = ‖z‖ := rfl

theorem Complex.abs_conj (z : ℂ) :
    Complex.abs ((starRingEnd ℂ) z) = Complex.abs z :=
  RCLike.norm_conj z

theorem Complex.abs_exp (z : ℂ) : Complex.abs (Complex.exp z) = Real.exp z.re :=
  Complex.norm_exp z

theorem Complex.abs_exp_ofReal_mul_I (r : ℝ) :
    Complex.abs (Complex.exp (r * Complex.I)) = 1 :=
  Complex.norm_exp_ofReal_mul_I r

theorem Complex.abs_ofReal (r : ℝ) : Complex.abs (r : ℂ) = |r| := by
  unfold Complex.abs
  exact RCLike.norm_ofReal r

theorem Complex.abs.pos {z : ℂ} (hz : z ≠ 0) : 0 < Complex.abs z := by
  apply lt_of_le_of_ne (norm_nonneg _)
  intro hc
  have h0 : (0:ℝ) = ‖z‖ := hc
  exact hz (norm_eq_zero.mp h0.symm)

theorem Complex.sq_abs (z : ℂ) : Complex.abs z ^ 2 = Complex.normSq z :=
  Complex.sq_norm z

theorem Complex.abs.eq_zero {z : ℂ} (h : Complex.abs z = 0) : z = 0 := by
  rw [Complex.abs, norm_eq_zero] at h
  exact h

theorem Complex.abs.nonneg (z : ℂ) : 0 ≤ Complex.abs z := norm_nonneg z

theorem Complex.abs.sub_le' (a b : ℂ) :
    Complex.abs a - Complex.abs b ≤ Complex.abs (a - b) := by
  unfold Complex.abs
  have hn := norm_add_le (a - b) b
  have heq : ‖a - b + b‖ = ‖a‖ := by
    congr 1
    ring
  rw [heq] at hn
  linarith

/-- compat: `Complex.ofNat_re` — cast de nat re -/
