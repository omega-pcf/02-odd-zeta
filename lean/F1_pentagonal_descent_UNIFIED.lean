section DosCarasFibonacciBlock

/-
DosCarasFibonacci.lean — Sprint 109/111. Las dos caras de la dinámica de Fibonacci:
periódica en la torsión del toro, sin periodo en los caracteres.
-/

namespace DosCarasFibonacci
open Matrix

/-- La matriz de Fibonacci sobre un anillo conmutativo. -/
def M (R : Type*) [CommRing R] : Matrix (Fin 2) (Fin 2) R := !![0, 1; 1, 1]

/-- Las potencias de `M` llevan los números de Fibonacci. -/
theorem M_pow (R : Type*) [CommRing R] (n : ℕ) :
    M R ^ (n + 1) = !![(Nat.fib n : R), (Nat.fib (n + 1) : R); (Nat.fib (n + 1) : R), (Nat.fib (n + 2) : R)] := by
  induction n with
  | zero => simp [M]
  | succ k ih =>
    rw [pow_succ, ih]
    have h : (Nat.fib (k + 3) : R) = Nat.fib (k + 1) + Nat.fib (k + 2) := by
      rw [show k + 3 = (k + 1) + 2 from rfl, Nat.fib_add_two]; push_cast; ring
    have h2 : (Nat.fib (k + 2) : R) = Nat.fib k + Nat.fib (k + 1) := by
      rw [Nat.fib_add_two]; push_cast; ring
    ext i j
    fin_cases i <;> fin_cases j <;> simp [M, Matrix.mul_apply, Fin.sum_univ_two, h, h2] <;> ring

/-- En cada primo (en cualquier anillo): `M^(n+1) = 1` exactamente cuando `F_{n+1} = 0` y `F_n = 1`,
es decir, cuando `φ^(n+1) = F_n + F_{n+1} φ = 1`: el periodo de `M` es el orden de `φ`. -/
theorem period_iff (R : Type*) [CommRing R] (n : ℕ) :
    M R ^ (n + 1) = 1 ↔ (Nat.fib (n + 1) : R) = 0 ∧ (Nat.fib n : R) = 1 := by
  rw [M_pow]
  constructor
  · intro h
    have h01 := congrFun (congrFun h 0) 1
    have h00 := congrFun (congrFun h 0) 0
    simp at h01 h00
    exact ⟨h01, h00⟩
  · rintro ⟨h1, h0⟩
    have h2 : (Nat.fib (n + 2) : R) = 1 := by
      rw [Nat.fib_add_two]; push_cast; rw [h0, h1]; ring
    ext i j
    fin_cases i <;> fin_cases j <;> simp [h0, h1, h2]

/-- Todo punto de torsión es periódico: sobre `ℤ/N`, alguna potencia positiva de `M` es la identidad. -/
theorem torsion_is_periodic (N : ℕ) [NeZero N] : ∃ n : ℕ, 0 < n ∧ M (ZMod N) ^ n = 1 := by
  have hdet : IsUnit (M (ZMod N)).det := by
    have : (M (ZMod N)).det = -1 := by simp [M, Matrix.det_fin_two]
    rw [this]; exact isUnit_one.neg
  obtain ⟨u, hu⟩ := (Matrix.isUnit_iff_isUnit_det _).mpr hdet
  obtain ⟨n, hn, hpow⟩ := (isOfFinOrder_iff_pow_eq_one).mp (isOfFinOrder_of_finite u)
  refine ⟨n, hn, ?_⟩
  have := congrArg (fun x : (Matrix (Fin 2) (Fin 2) (ZMod N))ˣ => (x : Matrix (Fin 2) (Fin 2) (ZMod N))) hpow
  simpa [hu] using this

/-- Cassini, con signo: `F_n F_{n+2} - F_{n+1}^2 = (-1)^(n+1)`. -/
theorem cassini (n : ℕ) :
    (Nat.fib n : ℤ) * Nat.fib (n + 2) - (Nat.fib (n + 1) : ℤ) ^ 2 = (-1) ^ (n + 1) := by
  induction n with
  | zero => simp
  | succ k ih =>
    have h : (Nat.fib (k + 3) : ℤ) = Nat.fib (k + 1) + Nat.fib (k + 2) := by
      rw [show k + 3 = (k + 1) + 2 from rfl, Nat.fib_add_two]; push_cast; ring
    have h2 : (Nat.fib (k + 2) : ℤ) = Nat.fib k + Nat.fib (k + 1) := by
      rw [Nat.fib_add_two]; push_cast; ring
    rw [show k + 1 + 2 = k + 3 from rfl, h, pow_succ]
    linear_combination (-1 : ℤ) * ih + (-(Nat.fib (k + 2) : ℤ)) * h2

/-- `det (M^(n+1) - 1) ≠ 0` sobre `ℤ`: `M` no tiene vector periódico. -/
theorem det_pow_sub_one_ne_zero (n : ℕ) : (M ℤ ^ (n + 1) - 1).det ≠ 0 := by
  rw [M_pow]
  have hdet : (!![(Nat.fib n : ℤ), (Nat.fib (n + 1) : ℤ); (Nat.fib (n + 1) : ℤ), (Nat.fib (n + 2) : ℤ)] - 1).det
      = ((Nat.fib n : ℤ) * Nat.fib (n + 2) - (Nat.fib (n + 1) : ℤ) ^ 2) - Nat.fib n - Nat.fib (n + 2) + 1 := by
    simp [Matrix.det_fin_two]; ring
  rw [hdet, cassini]
  have hc : ((-1 : ℤ) ^ (n + 1) = 1) ∨ ((-1 : ℤ) ^ (n + 1) = -1) := neg_one_pow_eq_or ℤ (n + 1)
  rcases n with _ | _ | k
  · simp
  · simp [show Nat.fib 3 = 2 from rfl]
  · have h1 : 1 ≤ Nat.fib (k + 2) := Nat.fib_pos.mpr (by omega)
    have h2 : 3 ≤ Nat.fib (k + 2 + 2) := by
      calc 3 = Nat.fib 4 := by decide
        _ ≤ Nat.fib (k + 2 + 2) := Nat.fib_mono (by omega)
    have h1' : (1 : ℤ) ≤ Nat.fib (k + 2) := by exact_mod_cast h1
    have h2' : (3 : ℤ) ≤ Nat.fib (k + 2 + 2) := by exact_mod_cast h2
    rcases hc with hc | hc <;> rw [hc] <;> intro h <;> linarith

/-- Sin vector periódico: si `M^(n+1) v = v` con `v` entero, entonces `v = 0`. -/
theorem no_periodic_vector (n : ℕ) (v : Fin 2 → ℤ) (h : (M ℤ ^ (n + 1)) *ᵥ v = v) : v = 0 := by
  have h0 : (M ℤ ^ (n + 1) - 1) *ᵥ v = 0 := by rw [Matrix.sub_mulVec, h, Matrix.one_mulVec, sub_self]
  exact Matrix.eq_zero_of_mulVec_eq_zero (det_pow_sub_one_ne_zero n) h0

/-- En los caracteres: para `m ≠ 0` los vectores `M^k m` son todos distintos, así que
`⟨e_m ∘ M^k, e_n⟩` es `1` a lo más para un `k`. -/
theorem orbit_injective (m : Fin 2 → ℤ) (hm : m ≠ 0) (k l : ℕ) (h : (M ℤ ^ k) *ᵥ m = (M ℤ ^ l) *ᵥ m) : k = l := by
  have hdetM : (M ℤ).det ≠ 0 := by simp [M, Matrix.det_fin_two]
  have key : ∀ a b : ℕ, a < b → (M ℤ ^ a) *ᵥ m = (M ℤ ^ b) *ᵥ m → False := by
    intro a b hab hh
    obtain ⟨d, rfl⟩ : ∃ d, b = a + (d + 1) := ⟨b - a - 1, by omega⟩
    have h1 : (M ℤ ^ a) *ᵥ ((M ℤ ^ (d + 1)) *ᵥ m - m) = 0 := by
      rw [Matrix.mulVec_sub, Matrix.mulVec_mulVec, ← pow_add, ← hh, sub_self]
    have hdeta : (M ℤ ^ a).det ≠ 0 := by rw [Matrix.det_pow]; exact pow_ne_zero _ hdetM
    have h2 := Matrix.eq_zero_of_mulVec_eq_zero hdeta h1
    exact hm (no_periodic_vector d m (sub_eq_zero.mp h2))
  rcases Nat.lt_trichotomy k l with hkl | hkl | hkl
  · exact (key k l hkl h).elim
  · exact hkl
  · exact (key l k hkl h.symm).elim

/-- Todo punto periódico es de torsión: si `A (x, y)` es entero con `A = (a b; c d)` entera, entonces
`det A · (x, y)` es entero (es `adj A` aplicado al vector entero `(k, l)`). -/
theorem periodic_is_torsion (a b c d k l : ℤ) (x y : ℝ)
    (h1 : (a : ℝ) * x + b * y = k) (h2 : (c : ℝ) * x + d * y = l) :
    ((a * d - b * c : ℤ) : ℝ) * x = ((d * k - b * l : ℤ) : ℝ) ∧
    ((a * d - b * c : ℤ) : ℝ) * y = ((a * l - c * k : ℤ) : ℝ) := by
  push_cast
  constructor
  · linear_combination (d : ℝ) * h1 - (b : ℝ) * h2
  · linear_combination (a : ℝ) * h2 - (c : ℝ) * h1

end DosCarasFibonacci

end DosCarasFibonacciBlock

