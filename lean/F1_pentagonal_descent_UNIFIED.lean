    hL      L(·, χ₅) es entera          `DirichletCharacter.differentiable_LFunction`
                                        + `chi5_ne_one` (F1_PCF_session_modules L2620)
    hR      su reflejo s ↦ conj L(s̄) es entero   `DifferentiableAt.conj_conj`
    hagree  coinciden en Re s > 1       serie de Dirichlet con coeficientes reales
    hid     teorema de identidad        `AnalyticOnNhd.eq_of_eventuallyEq`

  Consecuencias descargadas: `ClosedUnderMate` y `RealCoefficients` para χ₅,
  y §71 (`E ⟺ ningún par comparte ordenada`) queda sin hipótesis.

  ⚠ ESCRITO SIN COMPILAR.  Depende de PCF_unificado (y por tanto de CW6).
  Nombres de Mathlib con riesgo: `DifferentiableAt.conj_conj`, `tsum_star`,
  `Complex.cpow_conj`, `Complex.natCast_arg`, `AnalyticOnNhd.eq_of_eventuallyEq`,
  `LSeries.term_of_ne_zero`.
-/



open Complex ComplexConjugate Filter Topology

noncomputable section

namespace F1PCFUnified

/-- **[P·hL]** L(s, χ₅) es entera. -/
theorem D16_hL : Differentiable ℂ (DirichletCharacter.LFunction chi5_D) :=
  DirichletCharacter.differentiable_LFunction chi5_ne_one

/-- **[P·hR]** El reflejo de Schwarz de una función entera es entero. -/
theorem D16_hR : Differentiable ℂ (conjReflect (DirichletCharacter.LFunction chi5_D)) := by
  have hc : conjReflect (DirichletCharacter.LFunction chi5_D)
      = (starRingEnd ℂ) ∘ DirichletCharacter.LFunction chi5_D ∘ (starRingEnd ℂ) := rfl
  rw [hc]
  intro s
  have h := (D16_hL ((starRingEnd ℂ) s)).conj_conj
  rwa [Complex.conj_conj] at h

/-- **[P·hid]** Teorema de identidad: dos funciones enteras que coinciden en
    Re s > 1 coinciden en todo ℂ. -/
theorem D16_hid : ∀ f g : ℂ → ℂ, Differentiable ℂ f → Differentiable ℂ g →
    (∀ s : ℂ, 1 < s.re → f s = g s) → ∀ s : ℂ, f s = g s := by
  intro f g hf hg hfg
  have hU : {s : ℂ | 1 < s.re} ∈ 𝓝 (2 : ℂ) :=
    (isOpen_lt continuous_const Complex.continuous_re).mem_nhds (by norm_num)
  have hev : f =ᶠ[𝓝 (2 : ℂ)] g := Filter.mem_of_superset hU (fun s hs => hfg s hs)
  have hfa : AnalyticOnNhd ℂ f Set.univ := fun z _ => hf.analyticAt z
  have hga : AnalyticOnNhd ℂ g Set.univ := fun z _ => hg.analyticAt z
  have heq : f = g := hfa.eq_of_eventuallyEq hga hev
  -- alternativa: `(hfa.eqOn_of_preconnected_of_eventuallyEq hga isPreconnected_univ
  --                 (Set.mem_univ _) hev) (Set.mem_univ s)`
  exact fun s => congrFun heq s

/-- Término a término: con χ₅ real, conj(χ₅(n)/n^{s̄}) = χ₅(n)/n^s. -/
theorem D16_term_conj (s : ℂ) (n : ℕ) :
    (starRingEnd ℂ) (LSeries.term (fun n => chi5_D n) ((starRingEnd ℂ) s) n)
      = LSeries.term (fun n => chi5_D n) s n := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp [LSeries.term]
  · have hn0 : n ≠ 0 := Nat.pos_iff_ne_zero.mp hn
    simp only [LSeries.term_of_ne_zero hn0]
    rw [map_div₀, chi5_values_are_conj_invariant]
    congr 1
    have harg : (n : ℂ).arg ≠ Real.pi := by
      rw [Complex.natCast_arg]; exact Real.pi_ne_zero.symm
    rw [Complex.cpow_conj _ _ harg, Complex.conj_conj, Complex.conj_natCast]

/-- **[P·hagree]** El reflejo coincide con L en Re s > 1. -/
theorem D16_hagree : ∀ s : ℂ, 1 < s.re →
    conjReflect (DirichletCharacter.LFunction chi5_D) s
      = DirichletCharacter.LFunction chi5_D s := by
  intro s hs
  have hs' : 1 < ((starRingEnd ℂ) s).re := by rwa [Complex.conj_re]
  rw [conjReflect_apply, DirichletCharacter.LFunction_eq_LSeries chi5_D hs',
    DirichletCharacter.LFunction_eq_LSeries chi5_D hs]
  unfold LSeries
  rw [starRingEnd_apply, tsum_star]
  congr 1
  funext n
  rw [← starRingEnd_apply]
  exact D16_term_conj s n

/-- **[P] ★ `hconj` DESCARGADA.**  L(s̄, χ₅) = conj L(s, χ₅) para todo s. -/
theorem hconj_discharged :
    ∀ s : ℂ, DirichletCharacter.LFunction chi5_D ((starRingEnd ℂ) s)
      = (starRingEnd ℂ) (DirichletCharacter.LFunction chi5_D s) :=
  identity_theorem_transfers _ D16_hL D16_hR D16_hagree D16_hid

/-- **[P]** `ClosedUnderMate` para χ₅, sin hipótesis. -/
theorem closedUnderMate_chi5 :
    ClosedUnderMate (stripZeros (DirichletCharacter.LFunction chi5_D)) :=
  closedUnderMate_needs_only_conj_now hconj_discharged

/-- **[P]** `RealCoefficients` para χ₅, sin hipótesis. -/
theorem realCoefficients_chi5 :
    RealCoefficients (DirichletCharacter.LFunction chi5_D) :=
  realCoefficients_of_conj_comm _ hconj_discharged

/-- **[P] ★ §71, AHORA INCONDICIONAL.**  `E_iff_no_shared_ordinate`
    (PCF_sesion_completa §71.4) tenía una sola hipótesis analítica,
    `ClosedUnderMate`.  Con `closedUnderMate_chi5` queda sin hipótesis:
    todos los ceros en la franja están en la línea ⟺ ningún par distinto
    comparte ordenada. -/
theorem E_iff_no_shared_ordinate_chi5 :
    OnTheLine (stripZeros (DirichletCharacter.LFunction chi5_D)) ↔
      ¬ SharesOrdinate (stripZeros (DirichletCharacter.LFunction chi5_D)) :=
  E_iff_no_shared_ordinate _ closedUnderMate_chi5

/-- **[P]** La reducción por repulsión, con `hconj` descargada.
    ⚠ Estatus de `MinSpacing` según el propio corpus: es la cota MEDIDA
    `[N]` (m = 0.2307 sobre 237 espaciados, §71.5); en ventanas finitas es
    teorema (`minSpacing_is_a_theorem_on_windows`); en forma global el corpus
    la refuta si los espaciados tienden a 0 (`no_uniform_m_of_vanishing_spacing`).
    El contenido que sí sirve es `¬ SharesOrdinate`, y ése es E
    (`E_iff_no_shared_ordinate_chi5`, arriba). -/
theorem route_repulsion_needs_only_minSpacing
    (ρ : ℂ) (hρ : ρ ∈ stripZeros (DirichletCharacter.LFunction chi5_D))
    (m : ℝ) (hm : MinSpacing (stripZeros (DirichletCharacter.LFunction chi5_D)) m) :
