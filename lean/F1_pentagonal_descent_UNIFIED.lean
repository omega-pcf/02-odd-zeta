   apex_through_gamma.2, cos_pi_third_eq_mu3,
   the_centre_is_fixed_for_every_zero z.ρ, fixed_locus_is_the_line s⟩

theorem the_full_chain_euler_operator_zeros (z : Chi5Zero) (k : Fin 3) (s : ℂ)
    (hw : Complex.abs w_pcf = 1) (hpos : 0 < zeroCoord z.ρ)
    (hle : discP (zeroCoord z.ρ) ≤ 1/12)
    (h0 : 0 < z.ρ.re) (h1 : z.ρ.re < 1) :
    -- los ramificados 2 y 5 son los dos de φ
    (((Nat.gcd 2 20 = 2) ∧ (Nat.gcd 5 20 = 5)) ∧
     ((φ : ℝ) ^ 2 = (φ : ℝ) + 1) ∧
     (¬ ∃ i : ℤ, (φ : ℝ) ^ i = 2)) ∧
    -- los no ramificados entran por Z₂₀* y dan los parámetros del operador
    ((∀ r : ℕ, r.Prime → 5 < r → (r : ZMod 20) ∈ ZtwentyStar) ∧
     ((1:ℝ) / (ZtwentyStar.card : ℝ) = 1/8)) ∧
    -- el operador cuelga del ancla
    ((Complex.abs (Omega_hat k) = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ))) ∧
     ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = ‖Omega_hat 0‖)) ∧
    -- el cero cuelga del operador por el centro
    (((ctr₉ z.ρ (1 - z.ρ)).re = (Omega_hat ⟨0, by norm_num⟩).re) ∧
     (ctr₉ z.ρ (1 - z.ρ) = 1/2)) ∧
    -- y su descenso al nivel cero es E
    ((valPhi (zeroCoord z.ρ) = 0 ↔ z.ρ.re = 1/2) ∧
     (IsMonomial (zeroCoord z.ρ) ↔ z.ρ.re = 1/2)) :=
  ⟨⟨⟨two_and_five_are_the_ramified_primes.1,
     two_and_five_are_the_ramified_primes.2.1⟩,
    phi_sq, lambda_is_not_an_integer⟩,
   ⟨primes_land_in_ZtwentyStar, beta0_is_inverse_of_the_carriers⟩,
   ⟨spectrum_modulus_is_the_anchor k hw, apex_through_operator_and_anchor⟩,
   ⟨orbit_centre_is_in_the_spectrum z.ρ, the_centre_is_fixed_for_every_zero z.ρ⟩,
   ⟨degenerate_iff_valuation_zero z.ρ h0 h1,
    descending_to_F1_is_E z.ρ hpos hle h0⟩⟩

def TheStructuralPosition (r : ℝ) : Prop := r = 1

theorem the_monoid_has_one_point_under_confinement (r : ℝ) (hr : 0 < r)
    (hle : discP r ≤ 1/12) :
    IsMonomial r ↔ TheStructuralPosition r :=
  monomial_iff_one_under_confinement r hr hle

theorem the_structural_position_is_phi_zero :
    ((φ : ℝ) ^ (0 : ℤ) = 1) ∧ (TheStructuralPosition ((φ : ℝ) ^ (0 : ℤ))) := by
  refine ⟨by simp, ?_⟩
  unfold TheStructuralPosition; simp

theorem no_other_power_survives (k : ℤ) (hk : k ≠ 0)
    (hle : discP ((φ : ℝ) ^ k) ≤ 1/12) : False := by
  have hpos : 0 < (φ : ℝ) ^ k := zpow_pos φ_pos k
  have h1 : (φ : ℝ) ^ k = 1 :=
    (monomial_iff_one_under_confinement ((φ : ℝ) ^ k) hpos hle).mp ⟨k, rfl⟩
  have := phi_zpow_injective (a₁ := k) (a₂ := 0) (by simpa using h1)
  exact hk this

theorem this_is_a_theorem_not_a_conjecture (r : ℝ) (hr : 0 < r)
    (hle : discP r ≤ 1/12) :
    (IsMonomial r ↔ TheStructuralPosition r) ∧
    (Function.Injective (fun k : ℤ => (φ : ℝ) ^ k)) ∧
    (IsMonomial (1 : ℝ)) :=
  ⟨monomial_iff_one_under_confinement r hr hle,
   phi_zpow_injective, isMonomial_one⟩

theorem the_structural_side_and_the_analytic_side (ρ : ℂ)
    (hpos : 0 < zeroCoord ρ) (hle : discP (zeroCoord ρ) ≤ 1/12) (h0 : 0 < ρ.re) :
    -- LADO ESTRUCTURAL: teorema sobre el monoide, sin mencionar ceros
    ((∀ r : ℝ, 0 < r → discP r ≤ 1/12 → (IsMonomial r ↔ TheStructuralPosition r)) ∧
     (Function.Injective (fun k : ℤ => (φ : ℝ) ^ k))) ∧
    -- LADO ANALÍTICO: el traslado a un cero concreto
    ((IsMonomial (zeroCoord ρ) ↔ ρ.re = 1/2) ∧
     (zeroCoord ρ = 1 ↔ ρ.re = 1/2)) :=
  ⟨⟨fun r hr h => monomial_iff_one_under_confinement r hr h, phi_zpow_injective⟩,
   ⟨descending_to_F1_is_E ρ hpos hle h0, coord_eq_one_iff_re_half ρ h0⟩⟩

theorem confinement_pins_the_leading_digit (r : ℝ)
    (hlo : Real.sqrt 3 / 2 ≤ r) (hhi : r ≤ 2 / Real.sqrt 3) :
    ((φ : ℝ) ^ (-1 : ℤ) < r) ∧ (r < (φ : ℝ) ^ (1 : ℤ)) := by
  have h3 : (1:ℝ) < Real.sqrt 3 := by
    nlinarith [Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 3),
               Real.sqrt_nonneg 3]
  have hs : Real.sqrt 3 < 2 := by
    nlinarith [Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 3), Real.sqrt_nonneg 3]
  have hphi : (1.6:ℝ) < φ := by
    unfold φ
    nlinarith [Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 5), Real.sqrt_nonneg 5,
               Real.sqrt_lt_sqrt (by norm_num : (0:ℝ) ≤ 4) (by norm_num : (4:ℝ) < 5)]
  constructor
  · have : (φ : ℝ) ^ (-1 : ℤ) < Real.sqrt 3 / 2 := by
      rw [zpow_neg, zpow_one]
      rw [inv_lt_iff_one_lt_mul₀ φ_pos]
      have h17 : (1.7:ℝ) < Real.sqrt 3 := by
        rw [Real.lt_sqrt (show 0 ≤ (1.7:ℝ) by norm_num)]; norm_num
      have hp3 : (2:ℝ) < φ * Real.sqrt 3 := by nlinarith [hphi, h17]
      nlinarith [hp3, hs]
    linarith
  · have : (2:ℝ) / Real.sqrt 3 < (φ : ℝ) ^ (1 : ℤ) := by
      rw [zpow_one]
      rw [div_lt_iff₀ (by linarith : (0:ℝ) < Real.sqrt 3)]
      have h17 : (1.7:ℝ) < Real.sqrt 3 := by
        rw [Real.lt_sqrt (show 0 ≤ (1.7:ℝ) by norm_num)]; norm_num
      have hp3 : (2:ℝ) < φ * Real.sqrt 3 := by nlinarith [hphi, h17]
      nlinarith [hp3]
    linarith

theorem the_tail_is_the_whole_gap (ρ : ℂ) (hpos : 0 < zeroCoord ρ)
    (hle : discP (zeroCoord ρ) ≤ 1/12) (h0 : 0 < ρ.re) :
    (IsMonomial (zeroCoord ρ) ↔ zeroCoord ρ = 1) ∧
    (IsMonomial (zeroCoord ρ) ↔
       ∃ S : Finset ℤ, S.card = 1 ∧ PhiExpansion (zeroCoord ρ) S) ∧
    (zeroCoord ρ = 1 ↔ ρ.re = 1/2) :=
  ⟨monomial_iff_one_under_confinement (zeroCoord ρ) hpos hle,
   monomial_iff_one_digit (zeroCoord ρ),
   coord_eq_one_iff_re_half ρ h0⟩

theorem where_the_attempt_at_E_stops (ρ : ℂ) (hpos : 0 < zeroCoord ρ)
    (hle : discP (zeroCoord ρ) ≤ 1/12) (h0 : 0 < ρ.re) (h1 : ρ.re < 1) :
    -- lo que SÍ tengo: si la expansión tiene un dígito, E
    ((∃ S : Finset ℤ, S.card = 1 ∧ PhiExpansion (zeroCoord ρ) S) → ρ.re = 1/2) ∧
    -- y las tres formas equivalentes de la misma condición
    ((IsMonomial (zeroCoord ρ) ↔ zeroCoord ρ = 1) ∧
     (valPhi (zeroCoord ρ) = 0 ↔ ρ.re = 1/2) ∧
     ((rad₉ ρ (1 - ρ)).re = 0 ↔ ρ.re = 1/2)) := by
  refine ⟨fun h => ?_, ⟨monomial_iff_one_under_confinement (zeroCoord ρ) hpos hle,
                        degenerate_iff_valuation_zero ρ h0 h1,
                        orbit_radius_vanishes_iff_E ρ⟩⟩
  obtain ⟨S, hc, he⟩ := h
  have hm : IsMonomial (zeroCoord ρ) := one_digit_is_monomial (zeroCoord ρ) S hc he
  have h1 : zeroCoord ρ = 1 :=
    (monomial_iff_one_under_confinement (zeroCoord ρ) hpos hle).mp hm
  exact (coord_eq_one_iff_re_half ρ h0).mp h1

