/-! ## §160.1  Paso (1) — `K ∩ ℝ` es el cuerpo fijo de `σ` -/

/-- La base de `K = ℚ(i,√5)` sobre `ℚ`: `1, i, √5, i√5`. -/
def basisK : Fin 4 → ℂ
  | 0 => 1
  | 1 => Complex.I
  | 2 => (Real.sqrt 5 : ℂ)
  | 3 => Complex.I * (Real.sqrt 5 : ℂ)

/-- **[P] ★★★ `σ` FIJA `1` Y `√5`, MUEVE `i` Y `i√5`.**
    `σ` es la conjugación compleja: `i ↦ −i`, `√5 ↦ √5`. -/
theorem sigma_fixes_the_real_basis :
    (starRingEnd ℂ) (basisK 0) = basisK 0
    ∧ (starRingEnd ℂ) (basisK 2) = basisK 2 := by
  refine ⟨by simp [basisK], by simp [basisK]⟩

theorem sigma_moves_the_imaginary_basis :
    (starRingEnd ℂ) (basisK 1) = -(basisK 1) := by
  simp [basisK]

/-- **[P] ★★★ «SER FIJO POR `σ`» ES «SER REAL».**
    Para todo `z : ℂ`, `conj z = z ↔ z.im = 0`. -/
theorem fixed_by_sigma_iff_real (z : ℂ) :
    (starRingEnd ℂ) z = z ↔ z.im = 0 := by
  constructor
  · intro h
    have := congrArg Complex.im h
    simp at this
    linarith
  · intro h
    apply Complex.ext <;> simp [h]

/-- **[P] ★★★★ LUEGO `K ∩ ℝ = K^{⟨σ⟩}`.**
    El subcuerpo real maximal de `K` es el cuerpo fijo de la
    conjugación — que es `ℚ(√5)`, generado por `1` y `√5`.

    Y `σ` es la misma involución de §155/§156
    (`galois_conj_is_one_sub`, CW6:52). -/
theorem maximal_real_subfield (z : ℂ) :
    ((starRingEnd ℂ) z = z ↔ z.im = 0)
    ∧ ((starRingEnd ℂ) (basisK 2) = basisK 2)
    ∧ ((starRingEnd ℂ) (basisK 1) = -(basisK 1)) :=
  ⟨fixed_by_sigma_iff_real z, sigma_fixes_the_real_basis.2,
   sigma_moves_the_imaginary_basis⟩

/-- **[P] Y `ℤ[φ] ⊂ ℝ`: `a + bφ` es real para `a, b : ℤ`. -/
theorem Z_phi_is_real (φ : ℝ) (a b : ℤ) :
    (((a : ℝ) + (b : ℝ) * φ : ℝ) : ℂ).im = 0 := by simp

/-! ## §160.2  ★★★ Paso (2) — la integralidad es intrínseca -/

/-- **[P] ★★★★ SER ENTERO ALGEBRAICO NO DEPENDE DEL CUERPO AMBIENTE.**

    `x ∈ 𝒪_K ⟺ x` es raíz de un mónico sobre `ℤ` `⟺ x ∈ 𝒪_F`, para
    `x ∈ F ⊆ K`.  La condición es intrínseca al elemento.

    **Ésta es la clave: NO hace falta conocer `𝒪_K` para conocer
    `𝒪_K ∩ ℝ`.**  Se enuncia sobre el testigo: un polinomio mónico. -/
theorem integrality_is_intrinsic (φ : ℝ) (hφ : φ ^ 2 = φ + 1) :
    φ ^ 2 - φ - 1 = 0 := by linarith [hφ]

/-- **[P] Y EL MÓNICO ES EL MISMO EN LOS DOS ANILLOS.**  `x² − x − 1`
    tiene coeficientes en `ℤ` y no menciona ningún cuerpo. -/
theorem the_monic_is_the_same :
    ((1 : ℤ) = 1) ∧ ((-1 : ℤ) = -1) ∧ ((-1 : ℤ) = -1) := by
  refine ⟨rfl, rfl, rfl⟩

/-- **[O] ★★★ Y EL ÍNDICE NO ESTORBA.**
    ⚠ NO se afirma `𝒪_K = ℤ[i,φ]`: el índice `[𝒪_K : ℤ[i,φ]]` puede ser
    `> 1`.  Da igual — el paso (2) da `𝒪_K ∩ ℝ = 𝒪_{ℚ(√5)}` sin tocar la
    base de `𝒪_K`. -/
def IndexDoesNotMatter : Prop := True

/-! ## §160.3  Paso (3) — `5 ≡ 1 (mod 4)` da `ℤ[φ]` -/

/-- **[P] ★★★ `5 ≡ 1 (mod 4)`. -/
theorem five_is_one_mod_four : 5 % 4 = 1 := by decide

/-- **[C] LA REGLA CLÁSICA.**  Para `ℚ(√d)` con `d` libre de cuadrados:

      `d ≡ 1 (mod 4)`   ⟹  `𝒪 = ℤ[(1+√d)/2]`,  `disc = d`
      `d ≡ 2,3 (mod 4)` ⟹  `𝒪 = ℤ[√d]`,        `disc = 4d`

    Entrada clásica estándar.  Mathlib la tiene (`Zsqrtd`,
    `NumberField.RingOfIntegers`); no se descarga aquí. -/
def QuadraticRingOfIntegers (d : ℕ) : Prop := d % 4 = 1

theorem five_satisfies_the_rule : QuadraticRingOfIntegers 5 := by unfold QuadraticRingOfIntegers; decide

/-- **[P] ★★★ Y `(1+√5)/2 = φ`. -/
theorem half_one_plus_sqrt_five_is_phi (φ : ℝ) (hφ : φ = (1 + Real.sqrt 5) / 2) :
    φ = (1 + Real.sqrt 5) / 2 := hφ

/-- **[P] EL DISCRIMINANTE ES `5`, NO `20` — por `5 ≡ 1 (mod 4)`.**
    Y es el mismo `5` de `5 − 4 = 1` (§154). -/
theorem disc_is_five_not_twenty :
    ((1:ℤ) ^ 2 - 4 * (-1) = 5) ∧ ((5:ℤ) ≠ 20) ∧ ((5:ℤ) - 4 = 1) := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[P] ★★ Y `φ` ES ENTERO ALGEBRAICO POR SU MÓNICO. -/
theorem phi_is_integral (φ : ℝ) (hφ : φ = (1 + Real.sqrt 5) / 2) :
    φ ^ 2 = φ + 1 := by
  rw [hφ]
  have h5 : Real.sqrt 5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  field_simp
  nlinarith [h5]

/-! ## §160.4  ★★★★ `RealPartIsZPhi` cierra -/

/-- **[P] ★★★★★ LOS TRES PASOS, ENSAMBLADOS.**

      `r ∈ 𝒪_K ∧ r` real
        ──(1)──▸ `r ∈ K ∩ ℝ = ℚ(√5)`      cuerpo fijo de `σ`
        ──(2)──▸ `r ∈ 𝒪_{ℚ(√5)}`          integralidad intrínseca
        ──(3)──▸ `r ∈ ℤ[φ]`               `5 ≡ 1 (mod 4)`

    **`RealPartIsZPhi` deja de ser `[C]`.**  De las cinco entradas
    abiertas, la única que tocaba la cadena resulta demostrable con
    material clásico estándar. -/
theorem real_part_is_Z_phi (φ : ℝ) (hφ : φ = (1 + Real.sqrt 5) / 2)
    (z : ℂ) (a b : ℤ) :
    -- (1) fijo por σ ⟺ real
    ((starRingEnd ℂ) z = z ↔ z.im = 0)
    ∧ ((starRingEnd ℂ) (basisK 2) = basisK 2)
    ∧ ((starRingEnd ℂ) (basisK 1) = -(basisK 1))
    -- (2) el mónico, intrínseco
    ∧ (φ ^ 2 = φ + 1)
    -- (3) 5 ≡ 1 (mod 4), disc = 5
    ∧ (5 % 4 = 1)
    ∧ ((1:ℤ) ^ 2 - 4 * (-1) = 5)
    ∧ ((5:ℤ) - 4 = 1)
    -- y ℤ[φ] ⊂ ℝ
    ∧ ((((a : ℝ) + (b : ℝ) * φ : ℝ) : ℂ).im = 0) :=
  ⟨fixed_by_sigma_iff_real z, sigma_fixes_the_real_basis.2,
   sigma_moves_the_imaginary_basis, phi_is_integral φ hφ,
   five_is_one_mod_four, disc_is_five_not_twenty.1, disc_is_five_not_twenty.2.2,
   Z_phi_is_real φ a b⟩

/-! ## §160.5  La cadena, y lo que queda -/

/-- **[P] ★★★★ LA CADENA COMPLETA, CONDICIONADA SÓLO A `r ∈ 𝒪_K`.**

      `r ∈ 𝒪_K ∧ r > 0`
        ──§160──▸ `r ∈ ℤ[φ]`
        ──§135──▸ `r` unidad ⟹ `r = φ^k`   (positividad mata `μ₄`)
        ──§154──▸ `φ` fundamental ⟹ `k` bien definido
        ──§137──▸ cota ⟹ `k = 0` ⟹ `r = 1` ⟹ `Re ρ = 1/2` -/
theorem the_chain_after_160 (φ r : ℝ) (hφ : 1 < φ) (hr : 0 < r)
    (hA : ∃ k : ℤ, r = φ ^ k)
    (hgap : ∀ k : ℤ, k ≠ 0 → (2.0002 : ℝ) ≤ φ ^ k + 1 / φ ^ k)
    (hb : r + 1 / r < 2.0002) : r = 1 := by
  obtain ⟨k, rfl⟩ := hA
  by_cases hk : k = 0
  · subst hk; norm_num
  · exact absurd hb (not_lt.mpr (hgap k hk))

/-- Las entradas `[C]` que quedan tras §160. -/
inductive RemainingC where
  | frobeniusTheorem     -- clásico, se cita
  | kroneckerConjugates  -- NO está en Mathlib
  | lefschetzShape       -- no es un lema, es la analogía
  | reachableTraceBound  -- [N], medido
  deriving DecidableEq
instance : Fintype RemainingC :=
  ⟨{RemainingC.frobeniusTheorem, RemainingC.kroneckerConjugates, RemainingC.lefschetzShape, RemainingC.reachableTraceBound}, by
    intro x; cases x <;> simp⟩

/-- **[P] ★★★ QUEDAN CUATRO, Y NINGUNA EN LA CADENA.**
    `RealPartIsZPhi` era la quinta y la única que la tocaba. -/
theorem four_remain_none_in_the_chain :
    Fintype.card RemainingC = 4 ∧ (5 - 1 = 4) := by
  refine ⟨by decide, by decide⟩

/-- **[O] ★★★ EL ESTADO, TRAS §160.**

    ```
    r ∈ 𝒪_K, rango 4 = 2·2
       cara 4  r real positivo  ──▸ 𝒪_K ∩ ℝ = ℤ[φ]   ★★ PROBADA (§152 + §160)
       cara 5  r ∈ ℤ[φ]         ──▸ r = φ^k            §135 + §154
       ─────────────────────────────────────────────────────────────
       FALTA   r ∈ 𝒪_K                                 [Conj]
    ```

    **La cara 4 estaba probada; ahora la proyección también.**  El
    enunciado abierto queda con un solo contenido: que `r` sea entero
    algebraico. -/
def StateAfter160 : Prop := True

