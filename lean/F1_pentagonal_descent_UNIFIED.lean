      reZero ρ ≠ reZero σ → (3:ℝ)/4 ≤ |reZero ρ - reZero σ|) :=
  ⟨by norm_num, fun ρ σ h0 h1 g0 g1 hne =>
     embedding_separates_the_real_parts reZero hemb ρ σ h0 h1 g0 g1 hne⟩

theorem embedding_separates_real_parts_not_ordinates (reZero : ℂ → ℝ)
