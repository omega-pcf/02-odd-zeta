section OrbitaLibreEIndiceBlock

/-!
# Sprint 93. Una órbita libre de Klein aporta dos planos hiperbólicos a la forma de Weil.

Para f real y γ = (ρ − 1/2)/i, el cuádruple {ρ, ρ̄, 1 − ρ, 1 − ρ̄} aporta al lado de los ceros
q(f) = 4·Re(f̂(γ)·f̂(−γ)).  Con A = a₁ + i a₂ y B = b₁ + i b₂ (funcionales reales de f),
Re(AB) = a₁b₁ − a₂b₂, que es diferencia de cuadrados en dos pares: signatura ≤ (2, 2).
Sobre funciones pares B = A y sobre impares B = −A: una dirección negativa en cada paridad.
Un cero en la recta (γ real) da f̂(−γ) = conj f̂(γ) y aporta |f̂(γ)|² ≥ 0.

Estado: [P*] escrito, sin compilar.
-/

namespace OrbitaLibre

/-- **[P*] Re(AB) es diferencia de cuadrados: dos planos hiperbólicos.** -/
theorem re_mul_two_planes (a₁ a₂ b₁ b₂ : ℝ) :
    4 * (a₁ * b₁ - a₂ * b₂)
      = ((a₁ + b₁) ^ 2 - (a₁ - b₁) ^ 2) - ((a₂ + b₂) ^ 2 - (a₂ - b₂) ^ 2) := by ring

/-- **[P*] La forma del cuádruple es 4·Re(A·B).** -/
theorem quadruple_form (A B : ℂ) : 4 * (A * B).re = 4 * (A.re * B.re - A.im * B.im) := by
  simp [Complex.mul_re]

/-- **[P*] En funciones pares (B = A): 4·Re(A²) = 4(a₁² − a₂²), signatura ≤ (1,1).** -/
theorem even_part (A : ℂ) : 4 * (A * A).re = 4 * A.re ^ 2 - 4 * A.im ^ 2 := by
  simp [Complex.mul_re]; ring

/-- **[P*] En funciones impares (B = −A): el signo se invierte, signatura ≤ (1,1).** -/
theorem odd_part (A : ℂ) : 4 * (A * (-A)).re = -(4 * A.re ^ 2 - 4 * A.im ^ 2) := by
  simp [Complex.mul_re]; ring

/-- **[P*] Un cero sobre la recta aporta un cuadrado.**  Si B = conj A, Re(A B) = |A|² ≥ 0. -/
theorem on_line_nonneg (A : ℂ) : 0 ≤ (A * (starRingEnd ℂ) A).re := by
  simp [Complex.mul_re]; nlinarith [sq_nonneg A.re, sq_nonneg A.im]

end OrbitaLibre

end OrbitaLibreEIndiceBlock

