namespace PCFGranularity

set_option linter.unusedVariables false


/- =====================================================================
   BLOQUE 1 de 16 - PCF_granularity_kernel
   el objeto, la fibra, la ceguera
   ===================================================================== -/


/-! ## 0. Integer 2×2 matrices -/

structure Mat2 where
  a : Int
  b : Int
  c : Int
  d : Int
deriving DecidableEq, Repr

namespace Mat2

def mul (X Y : Mat2) : Mat2 :=
  ⟨X.a * Y.a + X.b * Y.c, X.a * Y.b + X.b * Y.d,
   X.c * Y.a + X.d * Y.c, X.c * Y.b + X.d * Y.d⟩

def add (X Y : Mat2) : Mat2 := ⟨X.a + Y.a, X.b + Y.b, X.c + Y.c, X.d + Y.d⟩
def sub (X Y : Mat2) : Mat2 := ⟨X.a - Y.a, X.b - Y.b, X.c - Y.c, X.d - Y.d⟩

def one : Mat2 := ⟨1, 0, 0, 1⟩
def det (X : Mat2) : Int := X.a * X.d - X.b * X.c
def tr  (X : Mat2) : Int := X.a + X.d

/-- Entrywise reduction mod `m`. -/
def rmod (X : Mat2) (m : Int) : Mat2 := ⟨X.a % m, X.b % m, X.c % m, X.d % m⟩

def npow (X : Mat2) : Nat → Mat2
  | 0 => one
  | n + 1 => mul (npow X n) X

end Mat2

/-- The golden substitution matrix. -/
def M : Mat2 := ⟨0, 1, 1, 1⟩

/-! ## 1. The generating identity  M² = M + I

  Everything below is a corollary of this single equation, which is the matrix
  form of `φ² = φ + 1`. -/

/-- **The generating identity.**  `M² = M + I`. -/
theorem M_char : Mat2.mul M M = Mat2.add M Mat2.one := by decide

/-- The characteristic data: `tr M = 1`, `det M = -1`.
    `λ² − (tr)λ + det = λ² − λ − 1`, whose positive root is φ. -/
theorem M_trace : Mat2.tr M = 1 := by decide

/-- **Orientation reversal.**  `det M = −1`: `M` does not preserve orientation
    of the torus, hence its mapping torus is non-orientable. (Claim 4.) -/
theorem M_det : Mat2.det M = -1 := by decide

/-- `det M = −1 ≠ 1`: the reversal is genuine, not a degenerate case. -/
theorem M_det_ne_one : Mat2.det M ≠ 1 := by decide

/-! ## 2. Claim 1 — Fourier is a quotient:  H₁ of the mapping torus is ℤ

  `H₁(T²_M) = ℤ ⊕ coker(M − I)`.  We show `M − I` is invertible over ℤ, with
  inverse `M` itself — an immediate consequence of `M_char`.  Hence the cokernel
  vanishes and `H₁ = ℤ`: the abelianised (= Fourier-visible) invariant retains
  only the base circle, and every refinement datum sits in π₁, invisible to H₁. -/

/-- `(M − I)·M = I`: `M − I` is invertible over ℤ and its inverse is `M`.
    This is `M² − M = I`, i.e. `M_char` rearranged. -/
theorem MsubI_mul_M : Mat2.mul (Mat2.sub M Mat2.one) M = Mat2.one := by decide

/-- `M·(M − I) = I`: the two-sided inverse. -/
theorem M_mul_MsubI : Mat2.mul M (Mat2.sub M Mat2.one) = Mat2.one := by decide

/-- `det (M − I) = −1`: a unit of ℤ, so the cokernel of `M − I` on ℤ² is trivial.
    Consequently `H₁(T²_M ; ℤ) = ℤ`. -/
theorem det_MsubI : Mat2.det (Mat2.sub M Mat2.one) = -1 := by decide

/-! ## 3. Claim 4 — the orientation double cover

  The orientation double cover of the mapping torus of `M` is the mapping torus
  of `M²`, which IS orientation preserving.  The cover is connected precisely
  because `det M = −1 ≠ 1 = det M²`; one turn around the scale circle does not
  close the labels, two turns do.  This is the "half level". -/

/-- `det M² = +1`: the square is orientation preserving, so the double cover of
    the mapping torus is orientable. -/
theorem det_M_sq : Mat2.det (Mat2.mul M M) = 1 := by decide

/-- The orientation character `σ ↦ (det M)^σ` has order exactly two:
    it is nontrivial at one step and trivial at two. -/
theorem orientation_order_two :
    Mat2.det M ≠ 1 ∧ Mat2.det (Mat2.mul M M) = 1 := by decide

/-! ## 4. Claim 1/4 — the fibre: the colour triad is the order of M mod 2

  `M mod 2` has order exactly 3 in `GL₂(𝔽₂)`.  This is the Pisano period π(2)=3,
  and it is the arithmetic source of the ternary colour index ωc = exp(2πi/3)
  of the corpus — it is derived here, not posited. -/

/-- `M mod 2` is not the identity. -/
theorem M_mod2_ne_one : (Mat2.npow M 1).rmod 2 ≠ Mat2.one := by decide

/-- `M² mod 2` is not the identity. -/
theorem M_sq_mod2_ne_one : (Mat2.npow M 2).rmod 2 ≠ Mat2.one := by decide

/-- `M³ mod 2` IS the identity: the order of `M` in `GL₂(𝔽₂)` is exactly 3. -/
theorem M_cube_mod2_eq_one : (Mat2.npow M 3).rmod 2 = Mat2.one := by decide

/-- **The colour triad, derived.**  The order of `M` modulo 2 is exactly three. -/
theorem colour_order_three :
    (Mat2.npow M 1).rmod 2 ≠ Mat2.one ∧
    (Mat2.npow M 2).rmod 2 ≠ Mat2.one ∧
    (Mat2.npow M 3).rmod 2 = Mat2.one :=
  ⟨M_mod2_ne_one, M_sq_mod2_ne_one, M_cube_mod2_eq_one⟩

/-! ## 5. Fibonacci and the φ-adic lattice -/

def fib : Nat → Nat
  | 0 => 0
  | 1 => 1
  | n + 2 => fib n + fib (n + 1)

theorem fib_succ_succ (n : Nat) : fib (n + 2) = fib n + fib (n + 1) := rfl

/-- Every Fibonacci number after the zeroth is strictly positive. -/
theorem fib_succ_pos : ∀ n : Nat, 0 < fib (n + 1)
  | 0 => by decide
  | n + 1 => by
      have h := fib_succ_pos n
      have e : fib (n + 1 + 1) = fib n + fib (n + 1) := rfl
      omega

/-- Coefficients `(p, q)` of `φⁿ = p + q·φ` in ℤ[φ].  The recursion
    `(p,q) ↦ (q, p+q)` is exactly the action of `M`. -/
def phiCoef : Nat → Nat × Nat
  | 0 => (1, 0)
  | n + 1 => ((phiCoef n).2, (phiCoef n).1 + (phiCoef n).2)

theorem phiCoef_succ (n : Nat) :
    phiCoef (n + 1) = ((phiCoef n).2, (phiCoef n).1 + (phiCoef n).2) := rfl

/-- `φⁿ⁺¹ = F_n + F_{n+1}·φ`. -/
theorem phiCoef_eq_fib : ∀ n : Nat, phiCoef (n + 1) = (fib n, fib (n + 1))
  | 0 => by decide
  | n + 1 => by
      have ih := phiCoef_eq_fib n
      have e : phiCoef (n + 2)
             = ((phiCoef (n+1)).2, (phiCoef (n+1)).1 + (phiCoef (n+1)).2) := rfl
      rw [e, ih]
      have e2 : fib (n + 2) = fib n + fib (n + 1) := rfl
      simp [e2]

/-- **Claim 2, arithmetic core.**  The φ-coefficient of `φⁿ⁺¹` never vanishes.
    Hence `φⁿ⁺¹` is never an integer, and in particular never a power of 2:
    the φ-grid and the dyadic grid meet only at the identity. -/
theorem phiCoef_snd_pos (n : Nat) : 0 < (phiCoef (n + 1)).2 := by
  rw [phiCoef_eq_fib n]
  exact fib_succ_pos n

/-! ## 6. Claim 3 — adjacent additive closure, and why it forces φ -/

/-- **Adjacent closure.**  `φⁿ + φⁿ⁺¹ = φⁿ⁺²`, at the level of ℤ[φ] coordinates.
    The φ-lattice is closed under addition of neighbouring levels. -/
theorem adjacent_closure (n : Nat) :
    ((phiCoef n).1 + (phiCoef (n + 1)).1, (phiCoef n).2 + (phiCoef (n + 1)).2)
      = phiCoef (n + 2) := by
  have e1 : phiCoef (n + 1) = ((phiCoef n).2, (phiCoef n).1 + (phiCoef n).2) := rfl
  have e2 : phiCoef (n + 2)
          = ((phiCoef (n+1)).2, (phiCoef (n+1)).1 + (phiCoef (n+1)).2) := rfl
  rw [e2, e1]

/-- **No integer ratio has the closure property.**  `r² = r + 1` has no solution
    in ℕ, so no integer-ratio geometric grid — the dyadic one `r = 2` above all —
    is closed under addition of adjacent levels. -/
theorem no_nat_closure : ∀ r : Nat, r * r ≠ r + 1
  | 0 => by decide
  | 1 => by decide
  | n + 2 => by
      intro h
      have hb : 2 * (n + 2) ≤ (n + 2) * (n + 2) :=
        Nat.mul_le_mul (by omega) (Nat.le_refl (n + 2))
      omega

/-- The dyadic grid explicitly fails: `2² = 4 ≠ 3 = 2 + 1`. -/
theorem dyadic_not_closed : 2 * 2 ≠ 2 + 1 := by decide

/-- **No RATIONAL ratio has the closure property either.**  Writing `x = m/f`
    in lowest or any terms, `x² = x + 1` becomes `m² = m·f + f²`, and this has no
    solution in ℕ with `f ≥ 1`.

    The proof is the golden descent: a solution `(m,f)` forces `f < m < 2f`, and
    then `(f, m−f)` is a strictly smaller solution — the Fibonacci recursion run
    backwards.  Infinite descent on `f` closes it.

    This is the arithmetic heart of BOTH Claim 3 (only φ is closed) and Claim 2
    (the φ-grid and the dyadic grid share only the identity): it is exactly the
    irrationality of φ, proved here without Mathlib and without √5. -/
theorem no_golden_rational : ∀ f m : Nat, 0 < f → m * m ≠ m * f + f * f := by
  intro f
  induction f using Nat.strongRecOn with
  | ind f ih =>
    intro m hf h
    have hff : 0 < f * f := Nat.mul_pos hf hf
    -- `f < m`
    have hmf : f < m := by
      rcases Nat.lt_or_ge f m with hlt | hge
      · exact hlt
      · have h1 : m * m ≤ m * f := Nat.mul_le_mul (Nat.le_refl m) hge
        omega
    -- `m < 2f`
    have hm2f : m < 2 * f := by
      rcases Nat.lt_or_ge m (2 * f) with hlt | hge
      · exact hlt
      · have h1 : (2 * f) * m ≤ m * m := Nat.mul_le_mul hge (Nat.le_refl m)
        have h2 : f * (2 * f) ≤ f * m := Nat.mul_le_mul (Nat.le_refl f) hge
        have e1 : (2 * f) * m = 2 * (f * m) := by rw [Nat.mul_assoc]
        have e2 : f * (2 * f) = 2 * (f * f) := by
          rw [Nat.mul_comm f (2 * f), Nat.mul_assoc]
        have e3 : m * f = f * m := Nat.mul_comm m f
        omega
    -- the descent step: `(f, m − f)` is a strictly smaller solution
    obtain ⟨r, hr⟩ : ∃ r, m = f + r := ⟨m - f, by omega⟩
    subst hr
    have hr0 : 0 < r := by omega
    have hrf : r < f := by omega
    have d1 : (f + r) * (f + r) = f * (f + r) + r * (f + r) := Nat.add_mul f r (f + r)
    have d2 : f * (f + r) = f * f + f * r := Nat.mul_add f f r
    have d3 : r * (f + r) = r * f + r * r := Nat.mul_add r f r
    have d4 : (f + r) * f = f * f + r * f := Nat.add_mul f r f
    have d5 : r * f = f * r := Nat.mul_comm r f
    have key : f * f = f * r + r * r := by omega
    exact ih r hrf f hr0 key

/-- Restated in the form used by the real layer: no positive rational `m/f`
    satisfies `x² = x + 1`.  Hence the unique positive real solution, φ, is
    irrational — and `Λ = log 2 / log φ` is therefore irrational as well
    (Claim 2), since `Λ = p/q` would force `φ^p = 2^q ∈ ℤ`. -/
theorem golden_irrational_kernel (m f : Nat) (hf : 0 < f) :
    m * m ≠ m * f + f * f :=
  no_golden_rational f m hf

/-! ## 7. Claim 1 — the fibre and the strict refinement of the index set

  The joint index is `(level, colour, orientation)`; the Fourier index is the
  level alone.  Forgetting the fibre is a surjection with fibre of size 6, so
  the joint decomposition is a STRICT refinement of the Fourier one. -/

inductive Colour where
  | c0 | c1 | c2
deriving DecidableEq, Repr

inductive Orient where
  | pos | neg
deriving DecidableEq, Repr

/-- The deck action of one turn around the scale circle on the colour: the
    order-3 generator supplied by `M mod 2`. -/
def Colour.shift : Colour → Colour
  | .c0 => .c1 | .c1 => .c2 | .c2 => .c0

/-- The deck action on the orientation: the order-2 half-turn `e^{iπ} = −1`. -/
def Orient.flip : Orient → Orient
  | .pos => .neg | .neg => .pos

def Colour.iter (n : Nat) (k : Colour) : Colour :=
  match n with | 0 => k | n+1 => Colour.shift (Colour.iter n k)

def Orient.iter (n : Nat) (e : Orient) : Orient :=
  match n with | 0 => e | n+1 => Orient.flip (Orient.iter n e)

/-- The colour shift has order exactly three. -/
theorem colour_shift_order :
    (∀ k, Colour.iter 3 k = k) ∧ (∃ k, Colour.iter 1 k ≠ k)
      ∧ (∃ k, Colour.iter 2 k ≠ k) := by
  refine ⟨?_, ⟨Colour.c0, by decide⟩, ⟨Colour.c0, by decide⟩⟩
  intro k; cases k <;> decide

/-- The orientation flip has order exactly two. -/
theorem orient_flip_order :
    (∀ e, Orient.iter 2 e = e) ∧ (∃ e, Orient.iter 1 e ≠ e) := by
  refine ⟨?_, ⟨Orient.pos, by decide⟩⟩
  intro e; cases e <;> decide

/-- One deck step of the mapping torus acting on the fibre. -/
def step (x : Colour × Orient) : Colour × Orient :=
  (Colour.shift x.1, Orient.flip x.2)

def stepIter (n : Nat) (x : Colour × Orient) : Colour × Orient :=
  match n with | 0 => x | n+1 => step (stepIter n x)

/-- **The deck group of the fibre is ℤ/6.**  The monodromy of one turn around
    the scale circle has order exactly six: three from the colour (order of
    `M mod 2`), two from the orientation (`det M = −1`).  The labels return only
    after six turns — the granularity factor. -/
theorem deck_order_six :
    (∀ x, stepIter 6 x = x) ∧
    (∃ x, stepIter 1 x ≠ x) ∧ (∃ x, stepIter 2 x ≠ x) ∧
    (∃ x, stepIter 3 x ≠ x) ∧ (∃ x, stepIter 4 x ≠ x) ∧
    (∃ x, stepIter 5 x ≠ x) := by
  refine ⟨?_, ⟨(Colour.c0, Orient.pos), by decide⟩,
             ⟨(Colour.c0, Orient.pos), by decide⟩,
             ⟨(Colour.c0, Orient.pos), by decide⟩,
             ⟨(Colour.c0, Orient.pos), by decide⟩,
             ⟨(Colour.c0, Orient.pos), by decide⟩⟩
  intro x
  obtain ⟨k, e⟩ := x
  cases k <;> cases e <;> decide

/-- The joint index of the refined decomposition. -/
abbrev JointIdx := Nat × Colour × Orient

/-- Forgetting the fibre: the Fourier index is the level alone. -/
def forgetFibre (x : JointIdx) : Nat := x.1

/-- The fibre over a level, listed. -/
def fibreList (σ : Nat) : List JointIdx :=
  [(σ, .c0, .pos), (σ, .c0, .neg), (σ, .c1, .pos),
   (σ, .c1, .neg), (σ, .c2, .pos), (σ, .c2, .neg)]

/-- The fibre has exactly six elements. -/
theorem fibre_length (σ : Nat) : (fibreList σ).length = 6 := rfl

/-- The listed fibre has no repetitions. -/
theorem fibre_nodup (σ : Nat) : (fibreList σ).Nodup := by
  simp [fibreList, List.nodup_cons]

/-- Everything listed does lie over `σ`. -/
theorem fibre_sound (σ : Nat) : ∀ x ∈ fibreList σ, forgetFibre x = σ := by
  intro x hx
  simp only [fibreList, List.mem_cons, List.not_mem_nil, or_false] at hx
  rcases hx with h | h | h | h | h | h <;> subst h <;> rfl

/-- Nothing over `σ` is missing: the list is the whole fibre. -/
theorem fibre_complete (σ : Nat) (x : JointIdx) (h : forgetFibre x = σ) :
    x ∈ fibreList σ := by
  obtain ⟨s, k, e⟩ := x
  have hs : s = σ := h
  subst hs
  cases k <;> cases e <;> simp [fibreList]

/-- `forgetFibre` is onto: every Fourier index is realised. -/
theorem forget_surjective (σ : Nat) : ∃ x : JointIdx, forgetFibre x = σ :=
  ⟨(σ, .c0, .pos), rfl⟩

/-- **Claim 1.**  The joint decomposition is a STRICT refinement: the forgetful
    map is onto but not injective, so the Fourier index set is a proper quotient
    of the joint index set.  Granularity is the fibre. -/
theorem refinement_strict :
    (∀ σ : Nat, ∃ x : JointIdx, forgetFibre x = σ) ∧
    (∃ x y : JointIdx, forgetFibre x = forgetFibre y ∧ x ≠ y) := by
  refine ⟨forget_surjective, ⟨(0, .c0, .pos), (0, .c1, .pos), rfl, ?_⟩⟩
  intro h
  exact absurd (congrArg (fun z => z.2.1) h) (by decide)

/-! ## 8. Summary: the four claims, as one package -/

/-- **The kernel theorem.**  All four granularity claims, as corollaries of the
    single identity `M² = M + I`:

    (i)   `M² = M + I` and `det M = −1` — orientation is reversed (Claim 4);
    (ii)  `(M − I)·M = I` — `coker(M − I) = 0`, so `H₁(T²_M) = ℤ`: the
          abelianised/Fourier invariant keeps only the base circle (Claim 1);
    (iii) `M mod 2` has order 3 — the colour triad is derived, and with the
          orientation flip the deck group of the fibre is ℤ/6 (Claims 1,4);
    (iv)  the φ-coefficient never vanishes — the φ-grid meets the dyadic grid
          only at the identity (Claim 2); and no integer ratio is closed under
          adjacent addition, which singles out `r² = r + 1` (Claim 3). -/
theorem kernel_theorem :
    (Mat2.mul M M = Mat2.add M Mat2.one) ∧
    (Mat2.det M = -1) ∧
    (Mat2.mul (Mat2.sub M Mat2.one) M = Mat2.one) ∧
    ((Mat2.npow M 3).rmod 2 = Mat2.one ∧ (Mat2.npow M 1).rmod 2 ≠ Mat2.one) ∧
    (∀ x, stepIter 6 x = x) ∧
    (∀ n : Nat, 0 < (phiCoef (n + 1)).2) ∧
    (∀ r : Nat, r * r ≠ r + 1) ∧
    (∀ f m : Nat, 0 < f → m * m ≠ m * f + f * f) :=
  ⟨M_char, M_det, MsubI_mul_M,
   ⟨M_cube_mod2_eq_one, M_mod2_ne_one⟩,
   deck_order_six.1, phiCoef_snd_pos, no_nat_closure, no_golden_rational⟩

/-! ## 9. Gap D4 — the three observables commute, and only the triple is complete

  The companion corpus specifies the scale operator and the colour operator by
  their SPECTRA (`Espec`, `Omega_eigenvalues`) but never exhibits them as
  operators on a common space, so their commutation — which Claim 1 needs — was
  nowhere proved.  This section supplies the missing construction in the only
  form Claim 1 actually requires.

  All three are diagonal (multiplication) operators on functions over the joint
  index, each depending on a different coordinate:

      H  : symbol  E(σ)      the scale / level operator
      Ω̂  : symbol  C(k)      the colour operator
      W  : symbol  O(ε)      the orientation operator

  Diagonal operators whose symbols are functions of disjoint coordinates commute
  for the trivial reason — and that is the point: the corpus's two operators DO
  live on a product index.  The substantive statement is the pair
  `H_not_complete` / `joint_separates`: `H` alone has six-fold degenerate
  eigenspaces, the triple `(H, Ω̂, W)` separates points.  That is exactly
  "complete set of commuting observables", which is what makes the joint
  decomposition a strict refinement rather than a relabelling. -/

section Observables

variable {R : Type}

/-- Diagonal action of a symbol `f` on a state `ψ`. -/
def diag [Mul R] (f ψ : JointIdx → R) : JointIdx → R := fun i => f i * ψ i

/-- **Diagonal operators commute** whenever the scalars do.  Associativity and
    commutativity of `R` are taken as hypotheses so that this file stays free of
    Mathlib's algebraic hierarchy. -/
theorem diag_comm [Mul R]
    (hassoc : ∀ a b c : R, a * (b * c) = (a * b) * c)
    (hcomm : ∀ a b : R, a * b = b * a)
    (f g ψ : JointIdx → R) :
    diag f (diag g ψ) = diag g (diag f ψ) := by
  funext i
  show f i * (g i * ψ i) = g i * (f i * ψ i)
  rw [hassoc, hassoc, hcomm (f i) (g i)]

/-- Symbol of the scale operator `H`: a function of the level alone. -/
def symH (E : Nat → R) : JointIdx → R := fun i => E i.1

/-- Symbol of the colour operator `Ω̂`: a function of the colour alone. -/
def symC (C : Colour → R) : JointIdx → R := fun i => C i.2.1

/-- Symbol of the orientation operator `W`: a function of the orientation alone. -/
def symO (O : Orient → R) : JointIdx → R := fun i => O i.2.2

/-- **[H, Ω̂] = 0.** -/
theorem commute_H_C [Mul R]
    (hassoc : ∀ a b c : R, a * (b * c) = (a * b) * c)
    (hcomm : ∀ a b : R, a * b = b * a)
    (E : Nat → R) (C : Colour → R) (ψ : JointIdx → R) :
    diag (symH E) (diag (symC C) ψ) = diag (symC C) (diag (symH E) ψ) :=
  diag_comm hassoc hcomm _ _ _

/-- **[H, W] = 0.** -/
theorem commute_H_O [Mul R]
    (hassoc : ∀ a b c : R, a * (b * c) = (a * b) * c)
    (hcomm : ∀ a b : R, a * b = b * a)
    (E : Nat → R) (O : Orient → R) (ψ : JointIdx → R) :
    diag (symH E) (diag (symO O) ψ) = diag (symO O) (diag (symH E) ψ) :=
  diag_comm hassoc hcomm _ _ _

/-- **[Ω̂, W] = 0.** -/
theorem commute_C_O [Mul R]
    (hassoc : ∀ a b c : R, a * (b * c) = (a * b) * c)
    (hcomm : ∀ a b : R, a * b = b * a)
    (C : Colour → R) (O : Orient → R) (ψ : JointIdx → R) :
    diag (symC C) (diag (symO O) ψ) = diag (symO O) (diag (symC C) ψ) :=
  diag_comm hassoc hcomm _ _ _

/-- **H alone is NOT a complete set of commuting observables.**  Whatever the
    level spectrum `E`, two distinct joint indices over the same level carry the
    same `H`-eigenvalue: the eigenspaces are degenerate. -/
theorem H_not_complete (E : Nat → R) :
    ∃ i j : JointIdx, i ≠ j ∧ symH E i = symH E j := by
  refine ⟨(0, Colour.c0, Orient.pos), (0, Colour.c1, Orient.pos), ?_, rfl⟩
  intro h
  exact absurd (congrArg (fun z => z.2.1) h) (by decide)

/-- The degeneracy of `H` is exactly sixfold: the whole fibre. -/
theorem H_degeneracy_six (E : Nat → R) (σ : Nat) :
    (fibreList σ).length = 6 ∧ ∀ i ∈ fibreList σ, symH E i = E σ := by
  refine ⟨rfl, ?_⟩
  intro i hi
  have h : i.1 = σ := fibre_sound σ i hi
  show E i.1 = E σ
  rw [h]

/-- **The triple (H, Ω̂, W) IS complete.**  If the three spectra are injective on
    their own coordinates, the joint eigenvalue determines the index: the joint
    eigenspaces are one-dimensional.  Together with `H_not_complete` this is the
    precise content of Claim 1 — the joint decomposition strictly refines the
    one indexed by the level alone. -/
theorem joint_separates
    (E : Nat → R) (C : Colour → R) (O : Orient → R)
    (hE : ∀ a b : Nat, E a = E b → a = b)
    (hC : ∀ a b : Colour, C a = C b → a = b)
    (hO : ∀ a b : Orient, O a = O b → a = b)
    (i j : JointIdx)
    (h1 : symH E i = symH E j)
    (h2 : symC C i = symC C j)
    (h3 : symO O i = symO O j) : i = j := by
  obtain ⟨s1, k1, e1⟩ := i
  obtain ⟨s2, k2, e2⟩ := j
  have hs : s1 = s2 := hE _ _ h1
  have hk : k1 = k2 := hC _ _ h2
  have he : e1 = e2 := hO _ _ h3
  subst hs; subst hk; subst he
  rfl

end Observables

/-! ## 10. Gap D1 (combinatorial core) — Fourier blindness

  Claim 1 says the Fourier decomposition is the QUOTIENT of the joint one.  The
  sharp form of that is: an observable invariant under the deck action of the
  mapping torus is a function of the LEVEL alone, and therefore cannot separate
  two points of the same fibre.

  Since the deck group ℤ/6 acts simply transitively on the fibre ℤ/3 × ℤ/2,
  "deck invariant" and "constant on fibres" are the same condition — and every
  abelian (character-theoretic, i.e. Fourier) observable is deck invariant,
  because characters of π₁ factor through H₁ = ℤ, which is the level.

  What is proved here is the index-level statement.  The analytic statement on
  L²(X) for the actual manifold is NOT proved here and remains open; see the
  companion note. -/

/-- One deck step on the full index: the level is fixed, the fibre rotates. -/
def deckStep (i : JointIdx) : JointIdx := (i.1, step i.2)

/-- `n` deck steps. -/
def deckIter (n : Nat) (i : JointIdx) : JointIdx := (i.1, stepIter n i.2)

theorem deckIter_succ (n : Nat) (i : JointIdx) :
    deckIter (n + 1) i = deckStep (deckIter n i) := rfl

/-- The deck step never changes the level. -/
theorem deckStep_level (i : JointIdx) : (deckStep i).1 = i.1 := rfl

/-- **The deck action is transitive on the fibre.**  Any point of a fibre is
    reached from any other in fewer than six steps.  With `deck_order_six` (the
    action is free) this says the action is SIMPLY transitive: the fibre is a
    torsor under ℤ/6. -/
theorem deck_transitive :
    ∀ x y : Colour × Orient, ∃ n : Nat, n < 6 ∧ stepIter n x = y := by
  intro x y
  obtain ⟨k1, e1⟩ := x
  obtain ⟨k2, e2⟩ := y
  cases k1 <;> cases e1 <;> cases k2 <;> cases e2 <;>
    first
      | exact ⟨0, by decide, by decide⟩
      | exact ⟨1, by decide, by decide⟩
      | exact ⟨2, by decide, by decide⟩
      | exact ⟨3, by decide, by decide⟩
      | exact ⟨4, by decide, by decide⟩
      | exact ⟨5, by decide, by decide⟩

/-- A deck-invariant symbol is invariant under any number of steps. -/
theorem deck_invariant_iter {A : Type} (f : JointIdx → A)
    (hf : ∀ i, f (deckStep i) = f i) : ∀ n i, f (deckIter n i) = f i := by
  intro n
  induction n with
  | zero => intro i; rfl
  | succ n ih =>
      intro i
      rw [deckIter_succ, hf, ih]

/-- **Fourier blindness.**  A deck-invariant observable is a function of the
    level alone: it takes the same value at any two indices over the same level.
    Hence no abelian/Fourier observable separates points of a fibre, and the
    Fourier index set is a proper quotient of the joint index set. -/
theorem deck_invariant_is_level_function {A : Type} (f : JointIdx → A)
    (hf : ∀ i, f (deckStep i) = f i)
    (i j : JointIdx) (hij : i.1 = j.1) : f i = f j := by
  obtain ⟨n, _, hxy⟩ := deck_transitive i.2 j.2
  have hstep : deckIter n i = j := by
    show (i.1, stepIter n i.2) = j
    rw [hxy, hij]
  rw [← hstep, deck_invariant_iter f hf]

/-- The converse: a function of the level alone IS deck invariant.  So
    "deck invariant" and "function of the level" are the same class of
    observable — the Fourier class. -/
theorem level_function_is_deck_invariant {A : Type} (g : Nat → A) :
    ∀ i, (fun i : JointIdx => g i.1) (deckStep i) = (fun i : JointIdx => g i.1) i := by
  intro i; rfl

/-- **Claim 1, final form.**  The joint decomposition separates points that the
    deck-invariant (Fourier) class provably cannot: `refinement_strict` exhibits
    two distinct indices over one level, `deck_invariant_is_level_function` says
    every Fourier observable identifies them, and `joint_separates` says the
    triple `(H, Ω̂, W)` distinguishes them. -/
theorem claim_one :
    (∃ i j : JointIdx, i ≠ j ∧ i.1 = j.1) ∧
    (∀ {A : Type} (f : JointIdx → A), (∀ i, f (deckStep i) = f i) →
        ∀ i j : JointIdx, i.1 = j.1 → f i = f j) := by
  refine ⟨⟨(0, Colour.c0, Orient.pos), (0, Colour.c1, Orient.pos), ?_, rfl⟩, ?_⟩
  · intro h
    exact absurd (congrArg (fun z => z.2.1) h) (by decide)
  · intro A f hf i j hij
    exact deck_invariant_is_level_function f hf i j hij

/-! ## 11. Gap D3 — the colour triad, derived

  Up to here the ternary colour was a COINCIDENCE: `M mod 2` has order 3, and the
  companion corpus uses ωc = exp(2πi/3).  This section removes the coincidence.

  The key observation is that `M` is not an arbitrary matrix: it is the companion
  matrix of `λ² − λ − 1`, so in the basis `(1, φ)` it is exactly **multiplication
  by φ on ℤ[φ]**.  Everything then reads off the arithmetic of that ring:

    • `det M = N(φ) = −1`   — the orientation reversal IS the field norm of φ.
                              φ is a unit of norm −1; that is why the mapping
                              torus is non-orientable.
    • `ℤ[φ]/(2) ≅ 𝔽₄`      — the golden polynomial is irreducible mod 2, so 2 is
                              INERT in ℤ[φ].  And 2 is not an arbitrary prime: it
                              is the scale quantum, `φ^Λ = 2` (corpus
                              `mersenne_bridge`).
    • `𝔽₄* = {1, φ̄, φ̄²}`   — cyclic of order 3, canonically generated by the
                              image of φ.  THIS is the colour triad.
    • the colour shift      — is multiplication by φ̄ (`colour_shift_is_mul_phi`).

  So: **the ternary colour is the unit group of the golden ring modulo its own
  scale quantum.**  It is derived, not posited, and the generator is canonical
  (the image of φ) rather than an arbitrary choice of cube root of unity. -/

/-! ### 11.1 ℤ[φ] and the norm -/

/-- `ℤ[φ]` in the basis `(1, φ)`: the pair `(a,b)` denotes `a + bφ`. -/
abbrev Zphi := Int × Int

/-- Multiplication in `ℤ[φ]`, using `φ² = φ + 1`:
    `(a+bφ)(c+dφ) = (ac+bd) + (ad+bc+bd)φ`. -/
def zmul (x y : Zphi) : Zphi :=
  (x.1 * y.1 + x.2 * y.2, x.1 * y.2 + x.2 * y.1 + x.2 * y.2)

def zOne : Zphi := (1, 0)
def zPhi : Zphi := (0, 1)

/-- Multiplication by φ: `(a,b) ↦ (b, a+b)` — the Fibonacci recursion. -/
def mulPhi (x : Zphi) : Zphi := (x.2, x.1 + x.2)

theorem zmul_phi (x : Zphi) : zmul zPhi x = mulPhi x := by
  show ((0:Int) * x.1 + 1 * x.2, (0:Int) * x.2 + 1 * x.1 + 1 * x.2) = (x.2, x.1 + x.2)
  simp

/-- **`M` is multiplication by φ.**  Applying the matrix `M` to the coordinate
    vector of `a + bφ` gives the coordinate vector of `φ·(a + bφ)`.  This is what
    makes every statement of this file a statement about the ring ℤ[φ]. -/
theorem M_is_mul_by_phi (x : Zphi) :
    (M.a * x.1 + M.b * x.2, M.c * x.1 + M.d * x.2) = mulPhi x := by
  show ((0:Int) * x.1 + 1 * x.2, (1:Int) * x.1 + 1 * x.2) = (x.2, x.1 + x.2)
  simp

/-- The field norm of `ℚ(√5)` restricted to `ℤ[φ]`:
    `N(a + bφ) = a² + ab − b²`. -/
def znorm (x : Zphi) : Int := x.1 * x.1 + x.1 * x.2 - x.2 * x.2

/-- The same norm form written with `*` instead of `^`, so that it compiles
    without Mathlib.  `F1_PCF_Unified.normForm` in the corpus writes it as
    `a^2 + a*b - b^2`; the two agree by `ring` once Mathlib is available, and
    that one-line bridge is the ONLY thing the corpus hook needs. -/
def normFormMul (a b : Int) : Int := a * a + a * b - b * b

/-- `znorm` and the corpus norm form are literally the same function. -/
theorem znorm_eq_normFormMul (a b : Int) : znorm (a, b) = normFormMul a b := rfl

/-- `N(φ) = −1` in the corpus spelling. -/
theorem normFormMul_phi : normFormMul 0 1 = -1 := by decide

/-- **The hook.**  `det M = N(φ) = −1` stated against the corpus norm form.
    Claim 4 therefore rests on a function already verified in
    `F1_PCF_Unified.lean` rather than on a new definition. -/
theorem det_M_eq_normFormMul : Mat2.det M = normFormMul 0 1 := by decide

/-- `N(1) = 1`. -/
theorem znorm_one : znorm zOne = 1 := by decide

/-- **`N(φ) = −1`.**  φ is a unit of norm `−1`. -/
theorem znorm_phi : znorm zPhi = -1 := by decide

/-- **The orientation reversal is the norm.**  `det M = N(φ) = −1`: the
    non-orientability of the mapping torus (Claim 4) is the arithmetic fact that
    the fundamental unit of ℤ[φ] has norm `−1`. -/
theorem det_M_eq_norm_phi : Mat2.det M = znorm zPhi := by decide

/-! ### 11.2 ℤ[φ]/(2) is the field 𝔽₄

  The scale quantum is `2` (corpus: `φ^Λ = 2`).  Reducing the golden ring by it
  gives a field with four elements, because `λ² − λ − 1 ≡ λ² + λ + 1 (mod 2)` is
  irreducible over `𝔽₂`. -/

/-- `𝔽₄ = ℤ[φ]/(2)`, written `a + b·φ̄` with `a, b ∈ 𝔽₂ = Bool`. -/
abbrev F4 := Bool × Bool

def f4add (x y : F4) : F4 := (Bool.xor x.1 y.1, Bool.xor x.2 y.2)

/-- Multiplication reduced mod 2, still using `φ̄² = φ̄ + 1`. -/
def f4mul (x y : F4) : F4 :=
  (Bool.xor (x.1 && y.1) (x.2 && y.2),
   Bool.xor (Bool.xor (x.1 && y.2) (x.2 && y.1)) (x.2 && y.2))

def f4zero : F4 := (false, false)
def f4one  : F4 := (true,  false)
def f4phi  : F4 := (false, true)

def f4pow (x : F4) : Nat → F4
  | 0 => f4one
  | n + 1 => f4mul (f4pow x n) x

/-- `λ² + λ + 1` has no root in `𝔽₂`, so the golden polynomial is irreducible
    mod 2 and the prime 2 is INERT in `ℤ[φ]`. -/
theorem golden_poly_no_root_mod2 :
    ∀ t : Bool, Bool.xor (Bool.xor (t && t) t) true = true := by
  intro t; cases t <;> decide

/-- Multiplication in `𝔽₄` is commutative. -/
theorem f4mul_comm : ∀ x y : F4, f4mul x y = f4mul y x := by
  intro x y
  obtain ⟨a, b⟩ := x; obtain ⟨c, d⟩ := y
  cases a <;> cases b <;> cases c <;> cases d <;> decide

/-- Multiplication in `𝔽₄` is associative. -/
theorem f4mul_assoc : ∀ x y z : F4, f4mul (f4mul x y) z = f4mul x (f4mul y z) := by
  intro x y z
  obtain ⟨a, b⟩ := x; obtain ⟨c, d⟩ := y; obtain ⟨e, f⟩ := z
  cases a <;> cases b <;> cases c <;> cases d <;> cases e <;> cases f <;> decide

/-- **`ℤ[φ]/(2)` is a field.**  Every nonzero element is invertible, so the
    quotient is `𝔽₄` and 2 is inert. -/
theorem f4_every_nonzero_invertible :
    ∀ x : F4, x ≠ f4zero → ∃ y, f4mul x y = f4one := by
  intro x hx
  obtain ⟨a, b⟩ := x
  cases a <;> cases b <;>
    first
      | exact absurd rfl hx
      | exact ⟨(true, false), by decide⟩
      | exact ⟨(true, true),  by decide⟩
      | exact ⟨(false, true), by decide⟩

/-- **The colour triad.**  `φ̄` has multiplicative order exactly 3 in `𝔽₄`, so
    `𝔽₄* = {1, φ̄, φ̄²}` is cyclic of order 3 with canonical generator the image
    of φ. -/
theorem f4phi_order_three :
    f4pow f4phi 1 ≠ f4one ∧ f4pow f4phi 2 ≠ f4one ∧ f4pow f4phi 3 = f4one := by
  decide

/-- The three units of `𝔽₄`, listed. -/
def F4star : List F4 := [f4one, f4phi, f4mul f4phi f4phi]

theorem F4star_length : F4star.length = 3 := rfl

theorem F4star_nodup : F4star.Nodup := by decide

/-- The list is exactly the set of nonzero elements. -/
theorem F4star_complete : ∀ x : F4, x ≠ f4zero → x ∈ F4star := by
  intro x hx
  obtain ⟨a, b⟩ := x
  cases a <;> cases b <;> first | exact absurd rfl hx | decide

/-! ### 11.3 The colour shift IS multiplication by φ̄ -/

/-- The canonical labelling of the colour by the units of `𝔽₄`. -/
def colourToF4 : Colour → F4
  | .c0 => f4one
  | .c1 => f4phi
  | .c2 => f4mul f4phi f4phi

theorem colourToF4_inj : ∀ k l : Colour, colourToF4 k = colourToF4 l → k = l := by
  intro k l h
  cases k <;> cases l <;> first | rfl | exact absurd h (by decide)

/-- **D3, closed.**  The colour shift of §7 is multiplication by `φ̄` in `𝔽₄`.
    The ternary colour index is therefore not a posited arity: it is the unit
    group of `ℤ[φ]` modulo the scale quantum `2`, and its generator is the image
    of φ itself. -/
theorem colour_shift_is_mul_phi (k : Colour) :
    colourToF4 (Colour.shift k) = f4mul f4phi (colourToF4 k) := by
  cases k <;> decide

/-! ### 11.3b Two consequences that answer standard objections

  These are not rhetorical replies; each is a theorem. -/

/-- The action of a matrix on the coordinate lattice `ℤ[φ] ≅ ℤ²`. -/
def act (X : Mat2) (v : Zphi) : Zphi :=
  (X.a * v.1 + X.b * v.2, X.c * v.1 + X.d * v.2)

/-- **`M − I` is SURJECTIVE on ℤ²**, with explicit preimage `M·v`.
    (This is `(M−I)M = I` read as a statement about the lattice.)

    Consequence, with `π₁(X) = ℤ² ⋊_M ℤ`: the commutator `[t,v] = (M−I)v`
    ranges over ALL of ℤ², so the commutator subgroup is the full ℤ² — a
    free abelian group of rank 2.  Abelianising therefore destroys a rank-2
    lattice, and `H₁(X) = ℤ` is not a statement that there is little structure
    but that a rank-2 lattice is invisible to the abelian invariant.

    This is the quantitative answer to "H₁ = ℤ is trivial, where is the
    content?": the content is `rank [π₁,π₁] = 2`. -/
theorem MsubI_surjective (v : Zphi) :
    act (Mat2.sub M Mat2.one) (act M v) = v := by
  obtain ⟨x, y⟩ := v
  simp [act, Mat2.sub, M, Mat2.one]

/-- **The multiresolution obstruction IS `no_nat_closure`.**

    A multiresolution ladder with dilation `a > 1` and translations by the
    lattice `ℤ` requires `a·ℤ ⊆ ℤ` — otherwise `V₀ ⊆ V₁` is incompatible with
    the two shift-invariances — and `a·ℤ ⊆ ℤ` forces `a ∈ ℤ`, so `a ∈ ℕ`
    for `a > 1`.

    For `a = φ` that would need a natural number satisfying `r² = r + 1`,
    which `no_nat_closure` refutes.  So the statement "there is no
    multiresolution analysis with dilation φ and integer translates" is not a
    caution: it is the SAME theorem that says no integer-ratio grid is closed
    under addition of adjacent levels.

    (This bounds MRA only.  Wavelet FRAMES with non-integer dilation are a
    different object and are not excluded by this argument.) -/
theorem no_integer_dilation_satisfies_golden : ∀ r : Nat, r * r ≠ r + 1 :=
  no_nat_closure

/-! ### 11.3c The degree-six cover, and where the torsion appears

  The `ℤ/6` of §7 is NOT the fibre of the fibration `X → S¹` (that fibre is
  `T²`).  It is the deck group of a COVERING: the map

      π₁(S¹) = ℤ ⟶ GL₂(𝔽₂) × {±1},   n ↦ (Mⁿ mod 2, (det M)ⁿ)

  has image cyclic of order 6 and kernel 6ℤ, so the associated cover is the
  mapping torus of `M⁶`.  Naming that space is what turns Claim 1 from a
  negative statement into a computable one.

  Two exact identities do all the work:

      M³ = 2M + I          M⁶ = 4M³ + I                                    (★)

  so `M³ − I = 2M` and `M⁶ − I = 4M³`, with `M` and `M³` both in `GL₂(ℤ)`.
  Since a unimodular factor does not change the image lattice,

      im(M³ − I) = 2ℤ²        im(M⁶ − I) = 4ℤ²

  and therefore, by the Wang sequence,

      H₁(X)           = ℤ                    (coker(M − I) = 0)
      H₁(X̃₂)          = ℤ                    (coker(M² − I) = 0)
      H₁(X̃₃)          = ℤ ⊕ (ℤ/2)²
      H₁(X̃₆)          = ℤ ⊕ (ℤ/4)²

  **The torsion appears on the colour cover, not on the orientation cover.**
  The orientation ℤ/2 is homologically invisible even upstairs; the colour ℤ/3
  creates torsion.  That is a positive, computed discrimination between the two
  factors of the deck group — sharper than saying H₁ "cannot see" the fibre. -/

/-- Scalar multiple of a matrix. -/
def Mat2.smul (k : Int) (X : Mat2) : Mat2 := ⟨k * X.a, k * X.b, k * X.c, k * X.d⟩

/-- `M³ = 2M + I`, hence `M³ − I = 2M`. -/
theorem M_cube_sub_one : Mat2.sub (Mat2.npow M 3) Mat2.one = Mat2.smul 2 M := by
  decide

/-- `M⁶ = 4M³ + I`, hence `M⁶ − I = 4M³`. -/
theorem M_six_sub_one :
    Mat2.sub (Mat2.npow M 6) Mat2.one = Mat2.smul 4 (Mat2.npow M 3) := by decide

/-- `det M³ = −1`: `M³` is unimodular, so it does not change the image lattice. -/
theorem det_M_cube : Mat2.det (Mat2.npow M 3) = -1 := by decide

/-- An explicit inverse of `M³` over ℤ. -/
theorem M_cube_inv : Mat2.mul (Mat2.npow M 3) ⟨-3, 2, 2, -1⟩ = Mat2.one := by decide

/-- The orientation double cover still has trivial cokernel: `det(M² − I) = −1`. -/
theorem det_M_sq_sub_one : Mat2.det (Mat2.sub (Mat2.npow M 2) Mat2.one) = -1 := by
  decide

/-- The colour triple cover has cokernel of order 4, the joint cover order 16. -/
theorem det_covers :
    Mat2.det (Mat2.sub (Mat2.npow M 3) Mat2.one) = -4 ∧
    Mat2.det (Mat2.sub (Mat2.npow M 6) Mat2.one) = -16 := by decide

/-- **Six is minimal.**  For `n = 1,…,5` at least one of the two characters
    (reduction mod 2, determinant) is nontrivial on `Mⁿ`; both are trivial at
    `n = 6`.  So the joint cover has degree exactly 6. -/
theorem cover_degree_six :
    ((Mat2.npow M 6).rmod 2 = Mat2.one ∧ Mat2.det (Mat2.npow M 6) = 1) ∧
    ¬((Mat2.npow M 1).rmod 2 = Mat2.one ∧ Mat2.det (Mat2.npow M 1) = 1) ∧
    ¬((Mat2.npow M 2).rmod 2 = Mat2.one ∧ Mat2.det (Mat2.npow M 2) = 1) ∧
    ¬((Mat2.npow M 3).rmod 2 = Mat2.one ∧ Mat2.det (Mat2.npow M 3) = 1) ∧
    ¬((Mat2.npow M 4).rmod 2 = Mat2.one ∧ Mat2.det (Mat2.npow M 4) = 1) ∧
    ¬((Mat2.npow M 5).rmod 2 = Mat2.one ∧ Mat2.det (Mat2.npow M 5) = 1) := by
  decide

/-- The image of `M³ − I` on the lattice is `2·(image of M)`; since `M` is
    unimodular (`MsubI_surjective` gives its inverse) that image is `2ℤ²`. -/
theorem act_M_cube_sub_one (v : Zphi) :
    act (Mat2.sub (Mat2.npow M 3) Mat2.one) v
      = (2 * (act M v).1, 2 * (act M v).2) := by
  obtain ⟨x, y⟩ := v
  simp [act, Mat2.sub, Mat2.npow, Mat2.mul, Mat2.one, M]
  omega

/-! ### 11.4 The Teichmüller ambiguity is NOT the orientation

  Lifting `𝔽₄*` into the cube roots of unity in ℂ admits exactly two choices,
  `φ̄ ↦ ω` and `φ̄ ↦ ω²`, exchanged by the Frobenius `x ↦ x²`, which generates
  `Gal(𝔽₄/𝔽₂) ≅ ℤ/2`.

  That ℤ/2 must NOT be confused with the orientation ℤ/2 of Claim 4.  The
  orientation character is `det` over ℤ, and `det` is invisible mod 2 — over
  `𝔽₂` there is only one unit.  The two ℤ/2's come from different quotients of
  `π₁(S¹) = ℤ`, which is also why they commute. -/

def frob (x : F4) : F4 := f4mul x x

/-- Frobenius has order two on `𝔽₄`: `x⁴ = x`. -/
theorem frob_order_two : ∀ x : F4, frob (frob x) = x := by
  intro x
  obtain ⟨a, b⟩ := x
  cases a <;> cases b <;> decide

/-- Frobenius exchanges the two generators of `𝔽₄*`, so the two Teichmüller
    lifts are exchanged: `φ̄ ↦ φ̄²` and `φ̄² ↦ φ̄`. -/
theorem frob_swaps_generators :
    frob f4phi = f4mul f4phi f4phi ∧ frob (f4mul f4phi f4phi) = f4phi := by decide

/-- **The orientation character is invisible mod 2.**  `det M = −1` and
    `det I = 1` have the same reduction mod 2, so the ℤ/2 of Claim 4 does not
    factor through `GL₂(𝔽₂)`: it is a different quotient of `π₁(S¹) = ℤ` from
    the one carrying the colour. -/
theorem det_invisible_mod2 : Mat2.det M % 2 = Mat2.det Mat2.one % 2 := by decide

/-- **The two ℤ/2's are distinct.**  The Frobenius acts nontrivially on the
    colour (it swaps the generators) while the orientation character acts
    trivially on it; conversely the orientation character is nontrivial over ℤ
    while being trivial mod 2. -/
theorem two_distinct_Z2 :
    frob f4phi ≠ f4phi ∧ Mat2.det M ≠ 1 ∧ Mat2.det M % 2 = 1 := by decide

/-! ### 11.4b D3′ — the archimedean place breaks the Teichmüller tie

  The two lifts `𝔽₄* → μ₃` are exchanged by Frobenius, so a choice is needed.
  It is not a convention: the choice is already made upstairs.

  `Gal(ℚ(√5)/ℚ) = {id, σ}` with `σ(φ) = 1 − φ`, and since 2 is inert the
  decomposition group at 2 is the whole Galois group, mapping onto
  `Gal(𝔽₄/𝔽₂) = ⟨Frobenius⟩`.  Reduction therefore carries the two Galois
  conjugates of φ to the two generators of `𝔽₄*`:

      φ   ↦ φ̄        1 − φ ≡ 1 + φ = φ̄²   (mod 2)

  Selecting `φ = (1+√5)/2` — the POSITIVE root, i.e. the expanding eigenvalue of
  `M` — therefore selects `φ̄` rather than `φ̄²`, and the lift is fixed by
  `φ̄ ↦ ω`.  The archimedean place breaks the tie at the inert place. -/

/-- `1 + φ̄ = φ̄²` in `𝔽₄`: the Galois conjugate of φ reduces to the OTHER
    generator, so the two conjugates hit the two generators. -/
theorem conjugate_reduces_to_other_generator :
    f4add f4one f4phi = f4mul f4phi f4phi := by decide

/-- The two generators are distinct, so the choice is genuine. -/
theorem two_generators_distinct : f4phi ≠ f4mul f4phi f4phi := by decide

/-! ### 11.4c D4′ — the two operators written `Ω̂` are not the same operator

  The companion corpus uses `Ω̂` for two different things:

    (a) the COLOUR matrix `½·diag(1, ω, ω²)` on the ℂ³ factor of
        `ℋ = L²(ℂ) ⊗ ℂ³`;
    (b) the SCALE LADDER `F_σ → F_{σ+1}`, which raises the level.

  They behave oppositely against the level operator `H`:

    • (a) preserves the level (`deckStep_level`), acts on a different tensor
      factor, and therefore commutes with `H` — this is what Claim 1 needs, and
      it is `commute_H_C`;
    • (b) changes the level, so it CANNOT commute with any `H` whose spectrum
      separates adjacent levels.  The correct relation there is a ladder
      relation, not a commutation.

  Disambiguating the two uses is the whole content of D4′.  Below, the negative
  half, which is the one that is easy to get wrong. -/

/-- The level-raising map on the joint index. -/
def raise (i : JointIdx) : JointIdx := (i.1 + 1, i.2)

/-- **The ladder does not commute with the level operator.**  If the level
    spectrum separates levels 0 and 1, the symbol of `H` is changed by raising.
    Contrast `deckStep_level`, which shows the colour step leaves it fixed. -/
theorem raise_changes_level {R : Type} (E : Nat → R) (hE : E 0 ≠ E 1) :
    ∃ i : JointIdx, symH E (raise i) ≠ symH E i := by
  refine ⟨(0, Colour.c0, Orient.pos), ?_⟩
  exact fun h => hE h.symm

/-- The colour step leaves the level fixed — so it belongs to a different
    tensor factor than `H`, and `commute_H_C` applies to it. -/
theorem colour_step_preserves_level (i : JointIdx) : (deckStep i).1 = i.1 := rfl

/-! ### 11.5 Summary of the derivation -/

/-- **The golden ring theorem.**  Everything in this note is arithmetic of
    `ℤ[φ]` with `M` acting as multiplication by φ:

    (i)   `M` is multiplication by φ in the basis `(1, φ)`;
    (ii)  `det M = N(φ) = −1` — Claim 4 is the norm of the fundamental unit;
    (iii) the golden polynomial is irreducible mod 2, so `ℤ[φ]/(2) = 𝔽₄` and the
          scale quantum 2 is inert;
    (iv)  `φ̄` generates `𝔽₄*`, cyclic of order 3 — the colour triad, derived;
    (v)   the colour shift is multiplication by `φ̄`;
    (vi)  the Teichmüller ℤ/2 (Frobenius) is distinct from the orientation ℤ/2
          (`det`, invisible mod 2). -/
theorem golden_ring_theorem :
    (∀ x : Zphi, (M.a * x.1 + M.b * x.2, M.c * x.1 + M.d * x.2) = mulPhi x) ∧
    (Mat2.det M = znorm zPhi) ∧
    (∀ t : Bool, Bool.xor (Bool.xor (t && t) t) true = true) ∧
    (∀ x : F4, x ≠ f4zero → ∃ y, f4mul x y = f4one) ∧
    (f4pow f4phi 3 = f4one ∧ f4pow f4phi 1 ≠ f4one) ∧
    (∀ k : Colour, colourToF4 (Colour.shift k) = f4mul f4phi (colourToF4 k)) ∧
    (frob f4phi ≠ f4phi ∧ Mat2.det M % 2 = Mat2.det Mat2.one % 2) :=
  ⟨M_is_mul_by_phi, det_M_eq_norm_phi, golden_poly_no_root_mod2,
   f4_every_nonzero_invertible,
   ⟨f4phi_order_three.2.2, f4phi_order_three.1⟩,
   colour_shift_is_mul_phi,
   ⟨two_distinct_Z2.1, det_invisible_mod2⟩⟩



