/-! ## §124.1  E140 — el ancla instancia la pata sobre `Λ` -/

/-- **[C] EL ANCLA.**  `Λ(0) = Λ(1) = 2 log φ`: la simetría `τ` de la
    pata `6`, pero SOBRE `Λ` ---no sobre `ℂ` genérico. -/
def AnchorOnLambda (Λ₀ Λ₁ φ : ℝ) : Prop :=
  Λ₀ = Λ₁ ∧ Λ₀ = 2 * Real.log φ ∧ 0 < φ

/-- **[P] Y `φ` SE RECUPERA DE ÉL.**  `exp(Λ(0)/2) = φ`. -/
theorem phi_from_the_anchor₄ (Λ₀ Λ₁ φ : ℝ) (h : AnchorOnLambda Λ₀ Λ₁ φ) :
    Real.exp (Λ₀ / 2) = φ := by
  obtain ⟨_, h2, h3⟩ := h
  rw [h2]; field_simp; exact Real.exp_log h3

/-- **[C] `Z` ES CERRADO BAJO `V`.**  Por la ecuación funcional
    (`τ`) y la realidad de `χ₅` (`σ`).  Entrada del corpus, §72. -/
def ZIsAVSet (Z : Set ℂ) : Prop :=
  (∀ ρ ∈ Z, (1 : ℂ) - ρ ∈ Z) ∧ (∀ ρ ∈ Z, (starRingEnd ℂ) ρ ∈ Z)

/-- **[P] LUEGO LOS CEROS ESTÁN EN LA ESTRUCTURA.**  No son puntos
    sueltos de `ℂ`: la órbita de cada uno está en `Z`.

    **Eso es parte del «quién», y yo lo negaba.** -/
theorem zeros_are_in_the_structure (Z : Set ℂ) (h : ZIsAVSet Z)
    (ρ : ℂ) (hρ : ρ ∈ Z) :
    ((1 : ℂ) - ρ ∈ Z) ∧ ((starRingEnd ℂ) ρ ∈ Z) ∧
    ((1 : ℂ) - (starRingEnd ℂ) ρ ∈ Z) :=
  ⟨h.1 ρ hρ, h.2 ρ hρ, h.1 _ (h.2 ρ hρ)⟩

/-- **[P] Y LO QUE FALTA ES DÓNDE, NO SI.**  `E` es que el
    `V`-conjunto esté en `Fix(στ)`. -/
theorem what_is_missing_is_where (ρ : ℂ) :
    ((1 : ℂ) - (starRingEnd ℂ) ρ = ρ) ↔ ρ.re = 1 / 2 := by
  rw [Complex.ext_iff]
  simp only [Complex.sub_re, Complex.sub_im, Complex.one_re, Complex.one_im,
             Complex.conj_re, Complex.conj_im]
  constructor
  · rintro ⟨h1, -⟩; linarith
  · intro h
    exact ⟨by linarith, by ring⟩

/-! ## §124.2  E141 — una coordenada, cinco niveles -/

/-- **[C] LA IDENTIDAD.**  `módulo = φ^exponente`: un solo mapa
    `t ↦ φ^t`, y cada nivel cuantiza `t` de otro modo. -/
def ModulusIsPhiPower (m t : ℝ) : Prop := m = Real.exp (t * Real.log φ)

/-- **[P] EL NIVEL DE LOS CEROS: `t = 0`.**  `φ⁰ = 1`, y `E` dice
    que el exponente vale cero. -/
theorem zeros_level_exponent_zero : (φ : ℝ) ^ (0 : ℤ) = 1 := by simp

/-- **[P] EL NIVEL DE LA TORRE: `t = k` ENTERO.**  `φ^k`, con la
    diferencia recíproca dando la cadena. -/
theorem tower_level (k : ℤ) :
    (φ : ℝ) ^ k * (φ : ℝ) ^ (-k) = 1 := by
  rw [← zpow_add₀ (ne_of_gt (lt_trans one_pos φ_gt_one))]
  simp

/-- **[C] EL NIVEL DEL ESPECTRO: `t = −λ`.**  `φ^{−λ} = 1/2`, con
    `φ^λ = 2` ---el puente de Mersenne. -/
def SpectrumLevel (v lam : ℝ) : Prop :=
  v = 1 / 2 ∧ Real.exp (lam * Real.log φ) = 2

/-- **[P] EL EXPONENTE `−λ` CODIFICA EL GRADO DOS.**  Porque
    `φ^λ = 2`, y `2` es el grado de `x² = x + 1`. -/
theorem spectrum_exponent_encodes_degree_two (v lam : ℝ)
    (h : SpectrumLevel v lam) :
    (v = 1 / 2) ∧ (Real.exp (lam * Real.log φ) = 2) := h

/-- **[O] UNA COORDENADA, DOS PUNTOS.**  El operador en `t = −λ` y
    los ceros en `t = 0` están en el MISMO mapa `t ↦ φ^t`.

    **No son dos coordenadas: son dos valores de una.** -/
theorem one_coordinate_two_points (v lam : ℝ) (h : SpectrumLevel v lam) :
    ((φ : ℝ) ^ (0 : ℤ) = 1) ∧ (v = 1 / 2) ∧ ((1 : ℝ) ≠ 1 / 2) :=
  ⟨zeros_level_exponent_zero, h.1, by norm_num⟩

/-! ## §124.3  La cadena en la misma torre -/

/-- **[P] `k = 2, 1, 0` DA `disc = 5, 1, 0`.**  Los tres niveles de
    la cadena, en la misma familia ---y `E ⟺ k = 0`. -/
theorem chain_in_one_tower (h : (φ : ℝ) ^ 2 = φ + 1) (hne : (φ : ℝ) ≠ 0) :
    (((φ : ℝ) ^ (0 : ℤ) - (φ : ℝ) ^ (-(0 : ℤ))) ^ 2 = 0) ∧
    (((φ : ℝ) - 1 / φ) ^ 2 = 1) ∧
    ((φ : ℝ) - 1 / φ = 1) := by
  have hd : (φ : ℝ) - 1 / φ = 1 := decoration_pair_gap_is_one
  refine ⟨by simp, ?_, hd⟩
  rw [hd]; norm_num

/-- **[O] EL BALANCE DE §124.**

    | | dije | corregido |
    |---|---|---|
    | E140 | «el cocono no da el quién» | **el ancla da que `Z` es `V`-conjunto** |
    | E141 | «otra coordenada» | **un nivel más de `módulo = φ^t`** |
    | la familia `{φ^k}` | reformulación lateral | **el nivel 5, y `E` es su `t = 0`** |

    **Nada de esto prueba `E`.**  Retira dos separaciones: los ceros
    pertenecen a la estructura, y el operador y ellos comparten la
    coordenada que `E` fija. -/
theorem the_balance_of_section_124 (Z : Set ℂ) (h : ZIsAVSet Z)
    (ρ : ℂ) (hρ : ρ ∈ Z) (v lam : ℝ) (hs : SpectrumLevel v lam) :
    ((1 : ℂ) - ρ ∈ Z) ∧
    (((1 : ℂ) - (starRingEnd ℂ) ρ = ρ) ↔ ρ.re = 1 / 2) ∧
    ((φ : ℝ) ^ (0 : ℤ) = 1) ∧
    (v = 1 / 2) :=
  ⟨h.1 ρ hρ, what_is_missing_is_where ρ, zeros_level_exponent_zero, hs.1⟩

