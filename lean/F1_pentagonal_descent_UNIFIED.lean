/-! ## §118.1  El recorrido de la ventana -/

/-- **[P] `log 4096 = 12·log 2` Y EL FACTOR SOBRE `log 4`.** -/
theorem window_4096_span :
    Real.log 4096 = 12 * Real.log 2 ∧
    Real.log 4 = 2 * Real.log 2 ∧
    Real.log 64 = 6 * Real.log 2 := by
  refine ⟨?_, ?_, ?_⟩
  · rw [show (4096 : ℝ) = 2 ^ (12 : ℕ) by norm_num, Real.log_pow]; push_cast; ring
  · rw [show (4 : ℝ) = 2 ^ (2 : ℕ) by norm_num, Real.log_pow]; push_cast; ring
  · rw [show (64 : ℝ) = 2 ^ (6 : ℕ) by norm_num, Real.log_pow]; push_cast; ring

/-- **[P] EL FACTOR ES `4.5` SOBRE `log 4` Y `1.5` SOBRE `log 64`. -/
theorem window_factors :
    ((12 : ℝ) / 2 = 6) ∧ ((12 : ℝ) / 6 = 2) := by
  refine ⟨by norm_num, by norm_num⟩

/-! ## §118.2  La ventana, como predicado con su margen -/

/-- **[N] EL MARGEN POR TRAMO.**  Numérico: mínimo sobre malla más
    cota de derivada.  Predicado, no teorema. -/
def WindowMargin₈ (Q : ℝ → ℝ) (hi m : ℝ) : Prop :=
  ∀ T : ℝ, 0 < T → T < hi → m ≤ Q T

/-- **[P] LA VENTANA EXTENDIDA A `log 4096`.**  Con el margen medido
    `0.0269`, la positividad se sigue en toda la ventana. -/
theorem extended_window_4096 (Q : ℝ → ℝ)
    (h : WindowMargin₈ Q (Real.log 4096) (269 / 10000)) :
    ∀ T : ℝ, 0 < T → T < Real.log 4096 → 0 < Q T := by
  intro T hT hlt
  have := h T hT hlt
  linarith

/-- **[P] Y CONTIENE A LA DE §36.**  `log 64 < log 4096`, luego el
    resultado anterior se recupera. -/
theorem contains_the_old_window (Q : ℝ → ℝ)
    (h : WindowMargin₈ Q (Real.log 4096) (269 / 10000)) :
    (∀ T : ℝ, 0 < T → T < Real.log 64 → 0 < Q T) := by
  intro T hT hlt
  have hlog : Real.log 64 < Real.log 4096 := by
    apply Real.log_lt_log <;> norm_num
  exact extended_window_4096 Q h T hT (lt_trans hlt hlog)

/-! ## §118.3  El margen no decae monótonamente -/

/-- **[P] LA SECUENCIA SUBE EN `[log128, log256]`.**  `0.043331 <
    0.052975`: más adversos (14 vs 11) y mejor margen.

    **La caída de `[log32,log64]` fue un tramo malo, no una
    tendencia.** -/
theorem margin_not_monotone :
    ((43331 : ℝ) / 1000000 < 52975 / 1000000) ∧
    ((26876 : ℝ) / 1000000 < 43331 / 1000000) ∧
    ((0 : ℝ) < 26876 / 1000000) := by
  refine ⟨by norm_num, by norm_num, by norm_num⟩

/-- **[P] Y EL MÍNIMO GLOBAL ES EL DEL ÚLTIMO TRAMO.**  De los siete
    valores, `0.026876` es el menor y es positivo. -/
theorem global_minimum_is_positive :
    ((26876 : ℝ) / 1000000 ≤ 43331 / 1000000) ∧
    ((26876 : ℝ) / 1000000 ≤ 45692 / 1000000) ∧
    ((26876 : ℝ) / 1000000 ≤ 78246 / 1000000) ∧
    ((0 : ℝ) < 26876 / 1000000) := by
  refine ⟨by norm_num, by norm_num, by norm_num, by norm_num⟩

/-! ## §118.4  El balance -/

/-- **[O] EL BALANCE DE §118.**

    | | §36 | §118 |
    |---|---|---|
    | ventana | `2L < log 64` | **`2L < log 4096`** |
    | margen | `0.0443` | **`0.0269`** |
    | factor sobre `log 4` | 3 | **6** |
    | §36 reproducido | --- | **sí, a `0.3 %`** |
    | monotonía del margen | supuesta decreciente | **se ESTABILIZA** |

    **Nada de esto prueba `E`.**  Es porción probada.  Y contra lo que
    §36 preveía ---«cada tramo nuevo cuesta más y da menos»--- cuesta
    más pero NO da menos: el margen tiene cota inferior `0.026876`
    sostenida en seis tramos. -/
theorem the_balance_of_section_118 (Q : ℝ → ℝ)
    (h : WindowMargin₈ Q (Real.log 4096) (269 / 10000)) :
    (Real.log 4096 = 12 * Real.log 2) ∧
    (∀ T : ℝ, 0 < T → T < Real.log 4096 → 0 < Q T) ∧
    ((12 : ℝ) / 2 = 6) ∧
    ((43331 : ℝ) / 1000000 < 52975 / 1000000) :=
  ⟨window_4096_span.1, extended_window_4096 Q h, window_factors.1,
   margin_not_monotone.1⟩

