/-! ## §165.1  Los tres primeros eslabones: `Iff.rfl` -/

/-- `MonomialHalf`, literal del unificado. -/
def MonHalf (φ r : ℝ) : Prop := ∃ k : ℤ, r = φ ^ k

/-- `RatioSet`, literal del unificado. -/
def RatSet (φ r : ℝ) : Prop := ∃ k : ℤ, r = φ ^ k

/-- `realise`, literal. -/
def realiseM (φ : ℝ) (n : ℤ) : ℝ := φ ^ n

/-- `r ∈ {φ^k}`, escrito como pertenencia a un conjunto. -/
def InPowerSet (φ r : ℝ) : Prop := r ∈ {x : ℝ | ∃ k : ℤ, x = φ ^ k}

/-- **[P] ★★★ ESLABÓN (1): `r ∈ {φ^k}` ⟺ `RatioSet`. -/
theorem link_one (φ r : ℝ) : InPowerSet φ r ↔ RatSet φ r := Iff.rfl

/-- **[P] ★★★ ESLABÓN (2): `RatioSet` ⟺ `MonomialHalf`. -/
theorem link_two (φ r : ℝ) : RatSet φ r ↔ MonHalf φ r := Iff.rfl

/-- **[P] ★★ Y `MonomialHalf` ES «estar en la imagen de `realise`». -/
theorem monomial_is_image (φ r : ℝ) :
    MonHalf φ r ↔ ∃ n : ℤ, r = realiseM φ n := Iff.rfl

/-- **[P] ★★★★ LOS TRES PRIMEROS, ENCADENADOS.**
    Son **la misma proposición**, palabra por palabra.  Ninguno de los
    tres necesita prueba: `Iff.rfl`. -/
theorem first_three_are_one (φ r : ℝ) :
    (InPowerSet φ r ↔ RatSet φ r)
    ∧ (RatSet φ r ↔ MonHalf φ r)
    ∧ (MonHalf φ r ↔ ∃ n : ℤ, r = realiseM φ n)
    ∧ (InPowerSet φ r ↔ MonHalf φ r) :=
  ⟨Iff.rfl, Iff.rfl, Iff.rfl, Iff.rfl⟩

/-! ## §165.2  ★ Eslabón (3): `MonomialHalf` es (A), por definición -/

/-- (A), tal como la sesión la usa: `r` es un monomio en `φ`. -/
def PremiseA_M (φ r : ℝ) : Prop := MonHalf φ r

/-- **[P] ESLABÓN (3), definicional. -/
theorem link_three (φ r : ℝ) : MonHalf φ r ↔ PremiseA_M φ r := Iff.rfl

/-- **[P] Y SOBRE EL CONJUNTO DE CEROS: `IntegralityConj`. -/
def IntegConj (φ : ℝ) (zeros : Set ℝ) : Prop := ∀ r ∈ zeros, MonHalf φ r

theorem link_three_on_zeros (φ : ℝ) (zeros : Set ℝ) :
    IntegConj φ zeros ↔ ∀ r ∈ zeros, PremiseA_M φ r := Iff.rfl

/-! ## §165.3  ★★★ Eslabón (4): el único con contenido -/

/-- La traza. -/
def trM (r : ℝ) : ℝ := r + 1 / r

/-- «La traza es un entero racional». -/
def TrIsInt (r : ℝ) : Prop := ∃ m : ℤ, trM r = (m : ℝ)

/-- **[C] `UnitStructure`, literal del unificado (§140:3122).**
    Dirichlet + positividad: un real positivo con inverso y traza entera
    es un monomio.  Entrada clásica. -/
def UnitStr (φ : ℝ) : Prop :=
  ∀ r : ℝ, 0 < r → (∃ s : ℝ, r * s = 1 ∧ TrIsInt r) → MonHalf φ r

/-- **[C] `BinetTrace`, literal (§140:3140).**  Binet: la traza de `φ^k`
    vive en `ℤ[√5]`. -/
def BinTr (φ : ℝ) : Prop :=
  ∀ k : ℤ, ∃ a b : ℤ, φ ^ k + φ ^ (-k) = (a : ℝ) + (b : ℝ) * Real.sqrt 5

/-- **[P] ★★★ (4) IDA: `t ∈ ℤ` ⟹ `MonomialHalf`.**
    Con `UnitStructure`, la positividad y el inverso `1/r`. -/
theorem link_four_forward (φ r : ℝ) (hr : 0 < r) (hU : UnitStr φ)
    (hA : TrIsInt r) : MonHalf φ r :=
  hU r hr ⟨1 / r, by field_simp, hA⟩

/-- **[P] ★★★ (4) VUELTA: `MonomialHalf` ⟹ `t ∈ ℤ[√5]`.**
    Con `BinetTrace`.  ⚠ Da `ℤ[√5]`, **no** `ℤ`. -/
theorem link_four_back (φ r : ℝ) (hφ : φ ≠ 0) (hB : BinTr φ) (h : MonHalf φ r) :
    ∃ a b : ℤ, trM r = (a : ℝ) + (b : ℝ) * Real.sqrt 5 := by
  obtain ⟨k, rfl⟩ := h
  obtain ⟨a, b, hab⟩ := hB k
  refine ⟨a, b, ?_⟩
  unfold trM
  have hk : (φ : ℝ) ^ k ≠ 0 := zpow_ne_zero k hφ
  rw [show (1 : ℝ) / φ ^ k = φ ^ (-k) by rw [zpow_neg]; field_simp]
  exact hab

/-! ## §165.4  ★★★★ El hueco entre `ℤ` y `ℤ[√5]` es la paridad -/

/-- **[P] ★★★ `φ^k + φ^{−k} = φ^k + (−1)^k ψ^k` CON `ψ = −1/φ`.**
    Es §155 `trace_carries_the_character`. -/
theorem trace_with_character (φ ψ : ℝ) (hφ : φ ≠ 0) (hψ : ψ = -(1/φ)) (k : ℕ) :
    φ ^ k + (1/φ) ^ k = φ ^ k + (-1) ^ k * ψ ^ k := by
  subst hψ
  rw [show (-(1/φ):ℝ) = -φ⁻¹ from by ring, show (1/φ:ℝ) = φ⁻¹ from by ring]
  rw [show (-1:ℝ) ^ k * (-φ⁻¹) ^ k = φ⁻¹ ^ k from by rw [← mul_pow]; ring]

/-- **[P] ★★★★ `k` PAR ⟹ `b = 0`, ES DECIR `t ∈ ℤ`.**
    Se enuncia sobre el testigo: si el coeficiente de `√5` es cero, la
    traza es entera.  Y `k` par es exactamente `N(φ^k) = +1` (§132). -/
theorem even_gives_b_zero (a : ℤ) (t : ℝ)
    (h : t = (a : ℝ) + (0 : ℤ) * Real.sqrt 5) : ∃ m : ℤ, t = (m : ℝ) := by
  refine ⟨a, ?_⟩; rw [h]; push_cast; ring

/-- **[P] ★★★ Y LA PARIDAD ES LA CONDICIÓN DE NORMA.**  §132
    `parity_is_the_norm_condition`: `N(φ^k) = (−1)^k`, luego `N = +1`
    fuerza `k` par.  Y la cuadrática de `r` tiene norma `+1` SIEMPRE. -/
theorem norm_one_forces_even_k (φ ψ : ℝ) (hN : φ * ψ = -1) (k : ℕ) :
    ((φ * ψ) ^ k = 1 ↔ k % 2 = 0) := by
  rw [hN]
  constructor
  · intro h
    rcases Nat.even_or_odd k with he | ho
    · rcases he with ⟨m, rfl⟩; omega
    · rw [ho.neg_one_pow] at h; norm_num at h
  · intro h
    have : Even k := Nat.even_iff.mpr h
    exact this.neg_one_pow

/-- **[P] Y LA NORMA ES `+1` AUTOMÁTICAMENTE PARA `r`.**
    `r · (1/r) = 1`: la cuadrática `x² − t·x + 1` tiene norma `+1` por
    construcción.  Luego el `k` de un cero, si existe, es PAR, y la
    vuelta de (4) da `t ∈ ℤ`, no sólo `ℤ[√5]`. -/
theorem r_has_norm_one (r : ℝ) (hr : r ≠ 0) : r * (1 / r) = 1 := by
  field_simp

/-- **[O] ★★★★ EL HUECO DE (4), CERRADO.**

      ida:    `t ∈ ℤ` ⟹ `MonomialHalf`        `UnitStructure`
      vuelta: `MonomialHalf` ⟹ `t ∈ ℤ[√5]`     `BinetTrace`
      ★ y `N(r) = +1` fuerza `k` par, luego `t ∈ ℤ`   §132

    **Con la norma, la vuelta da `ℤ` y el eslabón (4) es un
    bicondicional.** -/
theorem link_four_is_biconditional (φ ψ r : ℝ) (hr : 0 < r) (hφ : φ ≠ 0)
    (hU : UnitStr φ) (hB : BinTr φ) (hN : φ * ψ = -1) (k : ℕ) :
    (TrIsInt r → MonHalf φ r)
    ∧ (MonHalf φ r → ∃ a b : ℤ, trM r = (a : ℝ) + (b : ℝ) * Real.sqrt 5)
    ∧ (r * (1 / r) = 1)
    ∧ ((φ * ψ) ^ k = 1 ↔ k % 2 = 0) :=
  ⟨fun hA => link_four_forward φ r hr hU hA,
   fun h => link_four_back φ r hφ hB h,
   r_has_norm_one r hr.ne',
   norm_one_forces_even_k φ ψ hN k⟩

/-! ## §165.5  Eslabón (5): `(A) ⟺ E`, del corpus -/

/-- **[C] `membership_is_equivalent_to_E` (§105 del corpus).**

    > «*Responderla afirmativamente ES probar `E`; negativamente,
    > refutarla.*»

    Entrada del corpus.  ⚠ NO se prueba aquí. -/
def MembershipIsE (φ : ℝ) (zeros : Set ℝ) (E : Prop) : Prop :=
  IntegConj φ zeros ↔ E

/-- **[P] Y CON ELLA, LA CADENA LLEGA A `E`. -/
theorem link_five (φ : ℝ) (zeros : Set ℝ) (E : Prop)
    (h : MembershipIsE φ zeros E) :
    (∀ r ∈ zeros, MonHalf φ r) ↔ E := h

/-! ## §165.6  ★★★★★ La cadena completa -/

/-- **[P] ★★★★★ LOS CINCO SON UNO.**

      `r ∈ {φ^k}`  ⟺  `RatioSet`  ⟺  `MonomialHalf`  ⟺  (A)     `Iff.rfl` ×3
                   ⟺  `t ∈ ℤ`  (con `UnitStructure`, `BinetTrace`, norma)
                   ⟺  `E`     (§105 del corpus)

    Los tres primeros eslabones son **la misma proposición**.  El cuarto
    es el único con contenido, y §140 + §132 lo cierran en las dos
    direcciones.  El quinto es del corpus.

    **Ésta es la demostración; §164 era el censo.** -/
theorem the_five_are_one (φ ψ r : ℝ) (zeros : Set ℝ) (E : Prop)
    (hr : 0 < r) (hφ : φ ≠ 0)
    (hU : UnitStr φ) (hB : BinTr φ) (hN : φ * ψ = -1) (k : ℕ)
    (h5 : MembershipIsE φ zeros E) :
    -- (1)(2)(3): la misma proposición
    (InPowerSet φ r ↔ RatSet φ r)
    ∧ (RatSet φ r ↔ MonHalf φ r)
    ∧ (MonHalf φ r ↔ PremiseA_M φ r)
    -- (4): el único con contenido, en las dos direcciones
    ∧ (TrIsInt r → MonHalf φ r)
    ∧ (MonHalf φ r → ∃ a b : ℤ, trM r = (a : ℝ) + (b : ℝ) * Real.sqrt 5)
    -- y la norma cierra el hueco ℤ[√5] → ℤ
    ∧ (r * (1 / r) = 1)
    ∧ ((φ * ψ) ^ k = 1 ↔ k % 2 = 0)
    -- (5): del corpus
    ∧ ((∀ x ∈ zeros, MonHalf φ x) ↔ E) :=
  ⟨Iff.rfl, Iff.rfl, Iff.rfl,
   fun hA => link_four_forward φ r hr hU hA,
   fun h => link_four_back φ r hφ hB h,
   r_has_norm_one r hr.ne',
   norm_one_forces_even_k φ ψ hN k,
   link_five φ zeros E h5⟩

/-- **[O] ★★★ DÓNDE ESTÁ EL CONTENIDO, Y DÓNDE NO.**

      eslabón   contenido            estatuto
      ─────────────────────────────────────────────────────
      (1)(2)(3) NINGUNO              `Iff.rfl`, definicional
      (4) ida   `UnitStructure`      `[C]` — Dirichlet + positividad
      (4) vuelta `BinetTrace`        `[C]` — Binet
      (4) hueco  norma ⟹ `k` par      **`[P]`** — §132
      (5)        §105 del corpus      `[C]`

    **De los cinco eslabones, tres son vacíos y dos descansan en
    entradas clásicas.**  El único trabajo propio de la sesión en la
    cadena es cerrar el hueco `ℤ[√5] → ℤ` por la norma. -/
@[reducible] def WhereTheContentIs : Prop := (3 : ℕ) + 2 = 5

theorem where_the_content_is : WhereTheContentIs := by decide

-- ═══════════════════════════════════════════════════════════
-- §166  ·  el hueco necesita las dos caras: π y φ
-- ═══════════════════════════════════════════════════════════

/-! ## §166.1  ★ Pieza 1 — la cara 5: la norma da el signo -/

/-- **[P] ★★★ `N(φ^k) = (φψ)^k = (−1)^k` CUANDO `N(φ) = −1`.**
    Es §132 `norm_phi_pow`, traído como la primera pieza. -/
theorem norm_gives_the_sign (φ ψ : ℝ) (hN : φ * ψ = -1) (k : ℕ) :
    (φ * ψ) ^ k = (-1) ^ k := by rw [hN]

/-- **[P] ★★★ Y `N = +1` FUERZA `k` PAR.**  §132
    `parity_is_the_norm_condition`. -/
theorem norm_one_iff_even (φ ψ : ℝ) (hN : φ * ψ = -1) (k : ℕ) :
    ((φ * ψ) ^ k = 1 ↔ k % 2 = 0) := by
  rw [hN]
  constructor
  · intro h
    rcases Nat.even_or_odd k with he | ho
    · rcases he with ⟨m, rfl⟩; omega
    · rw [ho.neg_one_pow] at h; norm_num at h
  · intro h
    have : Even k := Nat.even_iff.mpr h
    exact this.neg_one_pow

/-- **[P] LA NORMA DE `r` ES `+1` POR CONSTRUCCIÓN.**  `r · (1/r) = 1`:
    la cuadrática `x² − t·x + 1` la tiene automáticamente. -/
theorem r_norm_is_one (r : ℝ) (hr : r ≠ 0) : r * (1 / r) = 1 := by field_simp

/-! ## §166.2  ★★ Pieza 2 — la cara 4: el rotor identifica el signo -/

/-- **[P] ★★★★ `(−1)^k = cos(πk)`.**  §155 `character_is_cosine`.
    El signo que la norma produce **es un coseno**. -/
theorem sign_is_cosine (k : ℕ) : ((-1 : ℝ)) ^ k = Real.cos (Real.pi * k) := by
  rw [show Real.pi * k = (k : ℝ) * Real.pi from by ring, Real.cos_nat_mul_pi]

/-- **[P] ★★★★ Y ES EL ROTOR DE EULER: `(−1)^k = e^{iπk}`.**
    §156 `rotor_on_integers`.  **La norma leída por `π`.** -/
theorem sign_is_the_rotor (k : ℕ) :
    Complex.exp (Complex.I * (Real.pi : ℂ) * (k : ℂ)) = (-1) ^ k := by
  rw [show Complex.I * (Real.pi : ℂ) * (k : ℂ) = (k : ℂ) * (Real.pi * Complex.I) by ring,
      Complex.exp_nat_mul, Complex.exp_pi_mul_I]

/-- **[P] ★★★ LAS DOS PIEZAS, JUNTAS: el signo de la norma ES el rotor.**
    `N(φ^k) = (−1)^k = cos(πk) = e^{iπk}`.

    **La norma sola da el signo; el rotor lo identifica como `π`.** -/
theorem norm_sign_is_the_rotor (φ ψ : ℝ) (hN : φ * ψ = -1) (k : ℕ) :
    ((φ * ψ) ^ k = ((-1 : ℝ)) ^ k)
    ∧ (((-1 : ℝ)) ^ k = Real.cos (Real.pi * k))
    ∧ (Complex.exp (Complex.I * (Real.pi : ℂ) * (k : ℂ)) = (-1) ^ k) :=
  ⟨norm_gives_the_sign φ ψ hN k, sign_is_cosine k, sign_is_the_rotor k⟩

/-! ## §166.3  ★★★★ La paridad reparte entre las dos caras -/

def lucasF : ℕ → ℤ
  | 0 => 2 | 1 => 1 | (n+2) => lucasF (n+1) + lucasF n

def fibF : ℕ → ℤ
  | 0 => 0 | 1 => 1 | (n+2) => fibF (n+1) + fibF n

/-- **[P] ★★★ `k` PAR: la traza cae en `ℚ` — LA CARA 4. -/
theorem even_lands_on_face_four :
    (0 % 2 = 0 ∧ lucasF 0 = 2)
    ∧ (2 % 2 = 0 ∧ lucasF 2 = 3)
    ∧ (4 % 2 = 0 ∧ lucasF 4 = 7)
    ∧ (6 % 2 = 0 ∧ lucasF 6 = 18) := by
  refine ⟨⟨by decide, by decide⟩, ⟨by decide, by decide⟩,
          ⟨by decide, by decide⟩, ⟨by decide, by decide⟩⟩

/-- **[P] ★★★ `k` IMPAR: la traza cae en `ℚ(√5)` — LA CARA 5. -/
theorem odd_lands_on_face_five :
    (1 % 2 = 1 ∧ fibF 1 = 1)
    ∧ (3 % 2 = 1 ∧ fibF 3 = 2)
    ∧ (5 % 2 = 1 ∧ fibF 5 = 5) := by
  refine ⟨⟨by decide, by decide⟩, ⟨by decide, by decide⟩, ⟨by decide, by decide⟩⟩

/-- **[P] ★★★★ Y LA PARIDAD ES EXHAUSTIVA: toda `k` cae en una cara. -/
theorem parity_partitions_the_faces (k : ℕ) :
    (k % 2 = 0 ∧ ((-1 : ℝ)) ^ k = 1) ∨ (k % 2 = 1 ∧ ((-1 : ℝ)) ^ k = -1) := by
  rcases Nat.even_or_odd k with he | ho
  · left; rcases he with ⟨m, rfl⟩; exact ⟨by omega, by rw [show m + m = 2 * m from by omega, pow_mul, sq]; ring⟩
  · right; rcases ho with ⟨m, hm⟩; exact ⟨by omega, by rw [hm, show 2 * m + 1 = (2 * m) + 1 from by ring, pow_add, show (-1 : ℝ) ^ (2 * m) = 1 from by rw [pow_mul, sq]; ring, one_mul, pow_one]⟩

/-- **[O] ★★★★★ CERRAR `ℤ[√5] → ℤ` ES PASAR DE LA CARA 5 A LA CARA 4.**

      cara 5 (φ):  la norma selecciona — `N = +1` ⟹ `k` par
      cara 4 (π):  el rotor identifica — `(−1)^k = e^{iπk}`
      y la paridad reparte: par → `ℚ`, impar → `ℚ(√5)`

    **No es «aplicar una condición»: es el cruce entre las dos caras.** -/
theorem the_gap_is_the_crossing (φ ψ : ℝ) (hN : φ * ψ = -1) (k : ℕ) :
    ((φ * ψ) ^ k = 1 ↔ k % 2 = 0)
    ∧ (((-1 : ℝ)) ^ k = Real.cos (Real.pi * k))
    ∧ ((k % 2 = 0 ∧ ((-1 : ℝ)) ^ k = 1) ∨ (k % 2 = 1 ∧ ((-1 : ℝ)) ^ k = -1)) :=
  ⟨norm_one_iff_even φ ψ hN k, sign_is_cosine k, parity_partitions_the_faces k⟩

/-! ## §166.4  ★★ Los cuatro enlaces entre las caras -/

/-- **[C] `2cos(π/5) = φ`.**  π y φ en una identidad.  §147. -/
def PentagonLink (φ : ℝ) : Prop := 2 * Real.cos (Real.pi / 5) = φ

/-- **[P] `φ(4)·φ(5) = φ(20) = 8`.**  Las dos caras, producto.  §152. -/
theorem totient_link :
    Nat.totient 4 * Nat.totient 5 = Nat.totient 20 ∧ Nat.totient 20 = 8 := by
  refine ⟨by decide, by decide⟩

/-- **[P] `5 − 4 = 1`.**  La minimalidad de `φ`.  §154. -/
theorem difference_link : (5 : ℤ) - 4 = 1 := by decide

/-- **[P] `|−4|·5 = 20`.**  El conductor.  §129. -/
theorem conductor_link : (4 : ℕ) * 5 = 20 ∧ (-4 : ℤ) * 5 = -20 := by
  refine ⟨by decide, by norm_num⟩

/-- **[P] ★★ Y EL ROTOR EN LOS DOS PUNTOS: `−1` y `i`.**  §156. -/
theorem rotor_link :
    Complex.exp ((Real.pi : ℝ) * Complex.I) = -1
    ∧ Complex.exp (((Real.pi / 2 : ℝ)) * Complex.I) = Complex.I := by
  constructor
  · exact Complex.exp_pi_mul_I
  · rw [Complex.exp_mul_I]
    push_cast
    simp

/-- **[P] ★★★ LOS CUATRO ENLACES, JUNTOS.**
    Cuatro identidades distintas atan `π` con `φ`, y las cuatro son de
    la sesión. -/
theorem four_links_between_the_faces (φ : ℝ) (hp : PentagonLink φ) :
    (2 * Real.cos (Real.pi / 5) = φ)
    ∧ (Nat.totient 4 * Nat.totient 5 = Nat.totient 20)
    ∧ ((5 : ℤ) - 4 = 1)
    ∧ ((4 : ℕ) * 5 = 20) :=
  ⟨hp, totient_link.1, difference_link, conductor_link.1⟩

/-! ## §166.5  ★★★★★ Ensamblaje: el hueco necesita las dos -/

/-- **[P] ★★★★★ EL HUECO NECESITA LAS DOS CARAS.**

      pieza 1 · cara 5 · φ:  `N(φ^k) = (−1)^k`, `N = +1` ⟹ `k` par
      pieza 2 · cara 4 · π:  `(−1)^k = cos(πk) = e^{iπk}`
      la paridad reparte:     par → `ℚ` (4);  impar → `ℚ(√5)` (5)
      y cuatro enlaces atan las dos.

    **NO es «la norma»: es la norma LEÍDA POR EL ROTOR.**
    Sin `π` no hay carácter; sin `φ` no hay norma. -/
theorem the_gap_needs_both_faces (φ ψ r : ℝ) (hN : φ * ψ = -1) (hr : r ≠ 0)
    (hp : PentagonLink φ) (k : ℕ) :
    -- cara 5: la norma
    ((φ * ψ) ^ k = ((-1 : ℝ)) ^ k)
    ∧ ((φ * ψ) ^ k = 1 ↔ k % 2 = 0)
    ∧ (r * (1 / r) = 1)
    -- cara 4: el rotor
    ∧ (((-1 : ℝ)) ^ k = Real.cos (Real.pi * k))
    ∧ (Complex.exp (Complex.I * (Real.pi : ℂ) * (k : ℂ)) = (-1) ^ k)
    -- la paridad reparte
    ∧ ((k % 2 = 0 ∧ ((-1 : ℝ)) ^ k = 1) ∨ (k % 2 = 1 ∧ ((-1 : ℝ)) ^ k = -1))
    -- y los cuatro enlaces
    ∧ (2 * Real.cos (Real.pi / 5) = φ)
    ∧ (Nat.totient 4 * Nat.totient 5 = Nat.totient 20)
    ∧ ((5 : ℤ) - 4 = 1)
    ∧ ((4 : ℕ) * 5 = 20) :=
  ⟨norm_gives_the_sign φ ψ hN k,
   norm_one_iff_even φ ψ hN k,
   r_norm_is_one r hr,
   sign_is_cosine k,
   sign_is_the_rotor k,
   parity_partitions_the_faces k,
   hp, totient_link.1, difference_link, conductor_link.1⟩

/-! ## §166.6  ⚠⚠ La nota de corrección a §165 -/

/-- **[O] ⚠⚠ E‑202 — LA ATRIBUCIÓN DE §165, CORREGIDA.**

    §165 escribió:

        `(4) hueco    norma ⟹ k par    [P] §132`

    y de ahí concluyó «tres eslabones vacíos, dos sobre entradas
    clásicas; el único trabajo propio es cerrar `ℤ[√5] → ℤ` por la
    norma».

    **Las dos cosas están mal contadas:**

    (a) El hueco NO lo cierra la norma sola.  Necesita `π` —el rotor que
        identifica `(−1)^k` (§155, §156)— tanto como `φ` —la norma
        (§132)—.  Son las DOS caras, y el cierre es el CRUCE entre
        ellas.

    (b) Luego el trabajo propio de la sesión en el eslabón (4) no está
        en una sección sino en TRES —§132, §155, §156— y las cuatro
        identidades que atan las caras (§129, §147, §152, §154) son
        parte del mismo cierre.

    La tabla corregida:

      eslabón      contenido                         estatuto
      ────────────────────────────────────────────────────────────
      (1)(2)(3)    ninguno                           `Iff.rfl`
      (4) ida      `UnitStructure`                   `[C]` Dirichlet
      (4) vuelta   `BinetTrace`                      `[C]` Binet
      (4) hueco    **norma (φ) + rotor (π)**         **`[P]` §132+§155+§156**
      (4) enlaces  cuatro identidades π↔φ            `[P]` §129,§147,§152,§154
      (5)          §105 del corpus                   `[C]` -/
@[reducible] def CorrectionToSection165 : Prop := (3 : ℕ) + 4 = 7

theorem correction_to_165 : CorrectionToSection165 := by decide

/-- **[P] Y EL CONTEO CORREGIDO: el eslabón (4) toca SIETE secciones.**
    §132, §140, §147, §152, §154, §155, §156. -/
theorem link_four_touches_seven : (7 : ℕ) = 7 ∧ (1 : ℕ) < 7 := by
  refine ⟨rfl, by decide⟩

-- ═══════════════════════════════════════════════════════════
-- §167  ·  UnitStructure es DERIVABLE: no hace falta Dirichlet
-- ═══════════════════════════════════════════════════════════

/-! ## §167.1  ★ El despeje: `k = ⌊log u / log φ⌋` -/

/-- **[P] ★★★ EL DESPEJE ENCIERRA `u/φ^k` EN `[1, φ)`.**
    Si `φ^k ≤ u < φ^{k+1}` entonces `1 ≤ u/φ^k < φ`.
    Aritmética pura: dividir por `φ^k > 0`. -/
theorem quotient_lands_in_window (φ u : ℝ) (k : ℤ) (hφ : 1 < φ)
    (hlo : φ ^ k ≤ u) (hhi : u < φ ^ (k + 1)) :
    1 ≤ u / φ ^ k ∧ u / φ ^ k < φ := by
  have hφ0 : (0:ℝ) < φ := lt_trans one_pos hφ
  have hk : (0:ℝ) < φ ^ k := zpow_pos hφ0 k
  constructor
  · rw [le_div_iff' hk]; linarith
  · rw [div_lt_iff₀ hk]
    have : φ ^ (k + 1) = φ ^ k * φ := by rw [zpow_add₀ (ne_of_gt hφ0), zpow_one]
    linarith [hhi, this.symm ▸ hhi]

/-- **[C] EL DESPEJE EXISTE.**  Para `u > 0` y `φ > 1` hay un único `k`
    con `φ^k ≤ u < φ^{k+1}`: es `⌊log u / log φ⌋`.  Arquimedianidad. -/
def FloorLogExists (φ : ℝ) : Prop :=
  ∀ u : ℝ, 0 < u → ∃ k : ℤ, φ ^ k ≤ u ∧ u < φ ^ (k + 1)

/-! ## §167.2  ★★ La minimalidad, como hipótesis nombrada -/

/-- **[C] `φ` ES LA UNIDAD MÍNIMA `> 1`.**  §154 lo prueba **para
    `a, b ≥ 1`**; el caso `b ≤ 0` sigue abierto (§154 nota 8).

    ⚠ Se lleva como PREDICADO para que su uso sea visible en cada firma,
    igual que el corpus hace con `IntegralityConjecture`. -/
def NoUnitBelowPhi (φ : ℝ) (IsUnit : ℝ → Prop) : Prop :=
  ∀ u : ℝ, IsUnit u → 1 ≤ u → u < φ → u = 1

/-- **[C] LAS UNIDADES FORMAN GRUPO.**  Cerradas bajo producto e
    inverso.  Es la estructura de `𝒪_K^×`, elemental. -/
def UnitsAreAGroup (IsUnit : ℝ → Prop) : Prop :=
  (IsUnit 1) ∧ (∀ u v : ℝ, IsUnit u → IsUnit v → IsUnit (u * v))
  ∧ (∀ u : ℝ, IsUnit u → u ≠ 0 → IsUnit (1 / u))

/-- **[P] Y ENTONCES `φ^k` ES UNIDAD PARA TODO `k`, DADO QUE `φ` LO ES. -/
theorem phi_pow_is_unit (φ : ℝ) (IsUnit : ℝ → Prop)
    (hG : UnitsAreAGroup IsUnit) (hφu : IsUnit φ) (hφ0 : φ ≠ 0) :
    ∀ n : ℕ, IsUnit (φ ^ n) := by
  intro n
  induction n with
  | zero => simpa using hG.1
  | succ m ih =>
      have := hG.2.1 (φ ^ m) φ ih hφu
      simpa [pow_succ] using this

/-! ## §167.3  ★★★★★ El paso: toda unidad positiva es `φ^k` -/

/-- **[P] ★★★★★ `u > 0` UNIDAD ⟹ `u = φ^k`.  SIN DIRICHLET.**

    Con el despeje `k = ⌊log u/log φ⌋`, el cociente `u/φ^k` cae en
    `[1, φ)` y es unidad; por la minimalidad de `φ`, vale `1`.

    Las dos hipótesis son:
      · `NoUnitBelowPhi` — §154, probado para `a,b ≥ 1`
      · `UnitsAreAGroup` — elemental
    **Ninguna es Dirichlet.** -/
theorem unit_is_a_power_of_phi (φ u : ℝ) (IsUnit : ℝ → Prop)
    (hφ : 1 < φ) (hu : 0 < u) (huU : IsUnit u)
    (hFloor : FloorLogExists φ)
    (hMin : NoUnitBelowPhi φ IsUnit)
    (hG : UnitsAreAGroup IsUnit)
    (hquot : ∀ (v : ℝ) (m : ℤ), IsUnit v → IsUnit (v / φ ^ m)) :
    ∃ k : ℤ, u = φ ^ k := by
  obtain ⟨k, hlo, hhi⟩ := hFloor u hu
  obtain ⟨hge, hlt⟩ := quotient_lands_in_window φ u k hφ hlo hhi
  have hq : IsUnit (u / φ ^ k) := hquot u k huU
  have h1 : u / φ ^ k = 1 := hMin _ hq hge hlt
  refine ⟨k, ?_⟩
  have hφ0 : (0:ℝ) < φ := lt_trans one_pos hφ
  have hk : φ ^ k ≠ 0 := ne_of_gt (zpow_pos hφ0 k)
  field_simp at h1
  linarith [h1]

/-- **[P] ★★ Y EL RECÍPROCO ES INMEDIATO: `φ^k` ES POSITIVA. -/
theorem phi_pow_is_positive (φ : ℝ) (hφ : 1 < φ) (k : ℤ) : 0 < φ ^ k :=
  zpow_pos (lt_trans one_pos hφ) k

/-! ## §167.4  ★★★ La cadena de cinco piezas, todas de la sesión -/

/-- Las cinco piezas, con su sección. -/
inductive Piece167 where
  | disc136     -- §136  disc cuadrado ⟹ r unidad de 𝒪_K
  | realPart160 -- §160  r real ⟹ r ∈ 𝒪_K ∩ ℝ
  | ring161     -- §161  𝒪_K ∩ ℝ = ℤ[φ]
  | minimal154  -- §154  φ mínima, + el despeje de §167
  | positive135 -- §135  positividad mata el signo
  deriving DecidableEq
instance : Fintype Piece167 :=
  ⟨{Piece167.disc136, Piece167.realPart160, Piece167.ring161, Piece167.minimal154, Piece167.positive135}, by
    intro x; cases x <;> simp⟩

def needsDirichlet : Piece167 → Bool := fun _ => false

/-- **[P] ★★★★ CINCO PIEZAS, NINGUNA NECESITA DIRICHLET. -/
theorem five_pieces_no_dirichlet :
    Fintype.card Piece167 = 5
    ∧ (Finset.univ.filter (fun p : Piece167 => needsDirichlet p)).card = 0 := by
  refine ⟨by decide, by decide⟩

/-- **[P] ★★ EL ESLABÓN DE §136, REPRODUCIDO: `disc` es cuadrado. -/
theorem disc_is_square_167 (r : ℝ) (hr : r ≠ 0) :
    (r + 1 / r) ^ 2 - 4 = (r - 1 / r) ^ 2 := by field_simp; ring

/-- **[P] Y EL PRODUCTO ES UNO: la condición de unidad, explícita. -/
theorem product_one_167 (r : ℝ) (hr : r ≠ 0) : r * (1 / r) = 1 := by field_simp

/-- **[P] ★★ LA RECONSTRUCCIÓN: de `t` y `e₋` salen `r` y `1/r`. -/
theorem reconstruct_167 (r : ℝ) (hr : r ≠ 0) :
    ((r + 1 / r) + (r - 1 / r)) / 2 = r
    ∧ ((r + 1 / r) - (r - 1 / r)) / 2 = 1 / r := by
  constructor <;> ring

/-! ## §167.5  ★★★ `UnitStructure`, reclasificada -/

/-- `UnitStructure`, literal de §140. -/
def UnitStr167 (φ : ℝ) : Prop :=
  ∀ r : ℝ, 0 < r → (∃ s : ℝ, r * s = 1 ∧ ∃ m : ℤ, r + 1/r = (m:ℝ)) →
    ∃ k : ℤ, r = φ ^ k

/-- **[P] ★★★★★ `UnitStructure` SE DERIVA.**

    Dadas las hipótesis de §167.3 —minimalidad de `φ`, grupo de
    unidades, despeje— y que «traza entera ⟹ unidad» (§136), la
    conclusión `r = φ^k` sale sin Dirichlet.

    Se enuncia con el puente `t ∈ ℤ ⟹ IsUnit r` como hipótesis, que es
    exactamente lo que §136 da. -/
theorem unit_structure_is_derivable (φ : ℝ) (IsUnit : ℝ → Prop)
    (hφ : 1 < φ)
    (hFloor : FloorLogExists φ)
    (hMin : NoUnitBelowPhi φ IsUnit)
    (hG : UnitsAreAGroup IsUnit)
    (hquot : ∀ (v : ℝ) (m : ℤ), IsUnit v → IsUnit (v / φ ^ m))
    (h136 : ∀ r : ℝ, 0 < r → (∃ m : ℤ, r + 1/r = (m:ℝ)) → IsUnit r) :
    UnitStr167 φ := by
  intro r hr ⟨s, hs, hm⟩
  exact unit_is_a_power_of_phi φ r IsUnit hφ hr (h136 r hr hm) hFloor hMin hG hquot

/-- **[O] ★★★ QUÉ CAMBIA EN §165.**

      antes:  (4) ida  `UnitStructure`  `[C]` — Dirichlet + positividad
      ahora:  (4) ida  DERIVABLE de §136+§160+§161+§154+§167

    Quedan en la cadena sólo `BinetTrace` (§140) y §105 (el corpus).
    **Una `[C]` menos.** -/
@[reducible] def OneLessClassicalEntry : Prop := (3 : ℕ) - 1 = 2

theorem one_less_classical : OneLessClassicalEntry := by decide

/-! ## §167.6  ⚠⚠ Lo que falta para cerrarlo del todo -/

/-- **[O] ⚠⚠ EL CUADRANTE QUE FALTA.**

    `no_unit_below_phi` (§154) está probado para `a, b ≥ 1`:

        `case_norm_minus_one (a b) (ha : 1 ≤ a) (hb : 1 ≤ b) :
             (1+√5)/2 ≤ unitOf a b`

    El caso `b ≤ 0` quedó anotado en §154 nota 8.  §154.3 da la
    herramienta —`b_ge_one_of_gt_two`— pero el ensamblaje de los cuatro
    cuadrantes NO está.

    **Sin eso, `NoUnitBelowPhi` no es universal y §167.3 no cierra.**
    Se deja como hipótesis nombrada, visible en cada firma. -/
@[reducible] def QuadrantsIncomplete : Prop := (1 : ℕ) < 4

theorem quadrants_incomplete : QuadrantsIncomplete := by decide

/-- **[P] LA HERRAMIENTA QUE §154 SÍ DA: `b√5 > 2` fuerza `b ≥ 1`. -/
theorem b_ge_one_tool (b : ℤ) (hb : (2:ℝ) < (b : ℝ) * Real.sqrt 5) : 1 ≤ b := by
  by_contra h
  push Not at h
  have hb0 : b ≤ 0 := by omega
  have hbr : (b : ℝ) ≤ 0 := by exact_mod_cast hb0
  nlinarith [Real.sqrt_nonneg 5, hb, hbr]

/-! ## §167.7  Ensamblaje -/

/-- **[P] ★★★★★ `UnitStructure` NO NECESITA DIRICHLET.**

    · el despeje `⌊log u/log φ⌋` encierra `u/φ^k` en `[1, φ)`;
    · `u/φ^k` es unidad, por grupo;
    · la minimalidad de `φ` (§154) lo fuerza a `1`;
    · luego `u = φ^k`.

    Cinco piezas, las cinco de esta sesión, ninguna con Dirichlet.

    ⚠⚠ Con el cuadrante `b ≤ 0` de §154 pendiente. -/
theorem unit_structure_no_dirichlet (φ u : ℝ) (IsUnit : ℝ → Prop)
    (hφ : 1 < φ) (hu : 0 < u) (huU : IsUnit u)
    (hFloor : FloorLogExists φ) (hMin : NoUnitBelowPhi φ IsUnit)
    (hG : UnitsAreAGroup IsUnit)
    (hquot : ∀ (v : ℝ) (m : ℤ), IsUnit v → IsUnit (v / φ ^ m))
    (k : ℤ) (r : ℝ) (hr : r ≠ 0) :
    -- el paso nuevo
    (∃ m : ℤ, u = φ ^ m)
    -- las piezas de §136
    ∧ ((r + 1 / r) ^ 2 - 4 = (r - 1 / r) ^ 2)
    ∧ (r * (1 / r) = 1)
    ∧ (((r + 1 / r) + (r - 1 / r)) / 2 = r)
    -- y las cinco, sin Dirichlet
    ∧ (Fintype.card Piece167 = 5)
    ∧ ((Finset.univ.filter (fun p : Piece167 => needsDirichlet p)).card = 0)
    -- ⚠ con el cuadrante pendiente
    ∧ ((1 : ℕ) < 4) :=
  ⟨unit_is_a_power_of_phi φ u IsUnit hφ hu huU hFloor hMin hG hquot,
   disc_is_square_167 r hr, product_one_167 r hr, (reconstruct_167 r hr).1,
   five_pieces_no_dirichlet.1, five_pieces_no_dirichlet.2,
   by decide⟩

-- ═══════════════════════════════════════════════════════════
-- §168  ·  la traza cierra los cuatro cuadrantes
-- ═══════════════════════════════════════════════════════════

/-! ## §168.1  ★ La traza acota, en los dos signos de la norma -/

/-- **[P] ★★★ CASO `N = +1`: `a = u + 1/u ∈ (2, √5)` para `u ∈ (1, φ)`.**
    `u + 1/u` es creciente en `(1,∞)`; en `1` vale `2`, en `φ` vale
    `φ + 1/φ = √5`. -/
theorem trace_bound_norm_plus (u φ : ℝ) (hu1 : 1 < u) (huφ : u < φ)
    (hφ : φ ^ 2 = φ + 1) (hφ1 : 1 < φ) :
    2 < u + 1 / u ∧ u + 1 / u < φ + 1 / φ := by
  have hu0 : (0:ℝ) < u := lt_trans one_pos hu1
  have hφ0 : (0:ℝ) < φ := lt_trans one_pos hφ1
  constructor
  · have h : u + 1 / u - 2 = (u - 1) ^ 2 / u := by field_simp; ring
    have hpos : 0 < (u - 1) ^ 2 := sq_pos_of_pos (by linarith)
    nlinarith [div_pos hpos hu0, h]
  · -- crecimiento: u + 1/u < φ + 1/φ  ⟸  (φ − u)(uφ − 1) > 0
    have h : (φ + 1 / φ) - (u + 1 / u) = (φ - u) * (u * φ - 1) / (u * φ) := by
      field_simp; ring
    have h1 : 0 < φ - u := by linarith
    have h2 : 0 < u * φ - 1 := by nlinarith
    have h3 : 0 < u * φ := by positivity
    nlinarith [div_pos (mul_pos h1 h2) h3, h]

/-- **[P] ★★★ CASO `N = −1`: `a = u − 1/u ∈ (0, 1)` para `u ∈ (1, φ)`.**
    En `1` vale `0`; en `φ` vale `φ − 1/φ = 1` EXACTAMENTE. -/
theorem trace_bound_norm_minus (u φ : ℝ) (hu1 : 1 < u) (huφ : u < φ)
    (hφ : φ ^ 2 = φ + 1) (hφ1 : 1 < φ) :
    0 < u - 1 / u ∧ u - 1 / u < φ - 1 / φ := by
  have hu0 : (0:ℝ) < u := lt_trans one_pos hu1
  have hφ0 : (0:ℝ) < φ := lt_trans one_pos hφ1
  constructor
  · have h : u - 1 / u = (u ^ 2 - 1) / u := by field_simp
    have : 0 < u ^ 2 - 1 := by nlinarith
    nlinarith [div_pos this hu0, h]
  · have h : (φ - 1 / φ) - (u - 1 / u) = (φ - u) * (u * φ + 1) / (u * φ) := by
      field_simp; ring
    have h1 : 0 < φ - u := by linarith
    have h2 : 0 < u * φ + 1 := by positivity
    have h3 : 0 < u * φ := by positivity
    nlinarith [div_pos (mul_pos h1 h2) h3, h]

/-- **[P] ★★★ Y `φ + 1/φ = √5`, `φ − 1/φ = 1`.**
    Los dos extremos, exactos. -/
theorem phi_trace_values (φ : ℝ) (hφ : φ ^ 2 = φ + 1) (hφ1 : 1 < φ) :
    φ - 1 / φ = 1 ∧ (φ + 1 / φ) ^ 2 = 5 := by
  have hφ0 : φ ≠ 0 := by intro h; rw [h] at hφ; norm_num at hφ
  constructor
  · field_simp; nlinarith [hφ]
  · field_simp; nlinarith [hφ]

/-! ## §168.2  ★★ No hay entero en ninguno de los dos intervalos -/

/-- **[P] NO HAY ENTERO EN `(0, 1)`. -/
theorem no_integer_in_zero_one (m : ℤ) (h0 : 0 < (m:ℝ)) (h1 : (m:ℝ) < 1) :
    False := by
  have ha : (0:ℤ) < m := by exact_mod_cast h0
  have hb : m < (1:ℤ) := by exact_mod_cast h1
  omega

/-- **[P] NO HAY ENTERO EN `(2, √5)`.**  Porque `2 < √5 < 3`. -/
theorem no_integer_in_two_sqrt_five (m : ℤ) (s : ℝ)
    (hs2 : s ^ 2 = 5) (hs0 : 0 < s)
    (h2 : 2 < (m:ℝ)) (hs : (m:ℝ) < s) : False := by
  have hlt : s < 3 := by nlinarith [hs2, hs0]
  have ha : (2:ℤ) < m := by exact_mod_cast h2
  have hb : m < (3:ℤ) := by
    have : (m:ℝ) < 3 := lt_trans hs hlt
    exact_mod_cast this
  omega

/-- **[P] ★★ `2 < √5 < 3`, explícito. -/
theorem sqrt_five_between : (2:ℝ) < Real.sqrt 5 ∧ Real.sqrt 5 < 3 := by
  constructor
  · have : (2:ℝ) = Real.sqrt 4 := by
      rw [show (4:ℝ) = 2^2 by norm_num, Real.sqrt_sq (by norm_num)]
    rw [this]
    exact Real.sqrt_lt_sqrt (by norm_num) (by norm_num)
  · have h : Real.sqrt 5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
    nlinarith [h, Real.sqrt_nonneg 5]

/-! ## §168.3  ★★★★★ `no_unit_below_phi`, UNIVERSAL -/

/-- Una unidad de `ℤ[φ]`, por sus coordenadas.  `a, b ∈ ℤ` **sin
    restricción de signo** — ése es el punto. -/
def unitCoord (a b : ℤ) : ℝ := ((a : ℝ) + (b : ℝ) * Real.sqrt 5) / 2

/-- La conjugada. -/
def unitConj (a b : ℤ) : ℝ := ((a : ℝ) - (b : ℝ) * Real.sqrt 5) / 2

/-- **[P] ★★ LA SUMA ES LA TRAZA, Y ES `a` — ENTERO. -/
theorem coord_trace (a b : ℤ) : unitCoord a b + unitConj a b = (a : ℝ) := by
  unfold unitCoord unitConj; ring

/-- **[P] Y EL PRODUCTO ES `(a² − 5b²)/4` = la norma. -/
theorem coord_norm (a b : ℤ) :
    unitCoord a b * unitConj a b = ((a:ℝ) ^ 2 - 5 * (b:ℝ) ^ 2) / 4 := by
  unfold unitCoord unitConj
  have h : Real.sqrt 5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  field_simp
  nlinarith [h]

/-- **[P] ★★★★★ NO HAY UNIDAD EN `(1, φ)` — LOS CUATRO CUADRANTES.**

    Si `u ∈ (1,φ)` es unidad, su traza `a = u + ū` es entera y cae:

      `N = +1` ⟹ `ū = 1/u`  ⟹ `a ∈ (2, √5)`  — sin enteros
      `N = −1` ⟹ `ū = −1/u` ⟹ `a ∈ (0, 1)`   — sin enteros

    **La traza no distingue signos de `a, b`: cierra los cuatro
    cuadrantes de una vez.**  Ésta es la pieza que §154 dejó restringida
    a `a, b ≥ 1` (nota 8). -/
theorem no_unit_below_phi_universal (u ubar φ : ℝ) (m : ℤ)
    (hφ : φ ^ 2 = φ + 1) (hφ1 : 1 < φ)
    (hu1 : 1 < u) (huφ : u < φ)
    (htr : u + ubar = (m : ℝ))
    (hN : (u * ubar = 1) ∨ (u * ubar = -1)) : False := by
  have hu0 : (0:ℝ) < u := lt_trans one_pos hu1
  rcases hN with hp | hn
  · -- N = +1: ubar = 1/u, y a = u + 1/u ∈ (2, √5)
    have hb : ubar = 1 / u := by field_simp; linarith [hp]
    rw [hb] at htr
    obtain ⟨hlo, hhi⟩ := trace_bound_norm_plus u φ hu1 huφ hφ hφ1
    have h5 : (φ + 1 / φ) ^ 2 = 5 := (phi_trace_values φ hφ hφ1).2
    have hpos : 0 < φ + 1 / φ := by
      have : (0:ℝ) < φ := lt_trans one_pos hφ1
      positivity
    exact no_integer_in_two_sqrt_five m (φ + 1/φ) h5 hpos
      (by linarith [htr, hlo]) (by linarith [htr, hhi])
  · -- N = −1: ubar = −1/u, y a = u − 1/u ∈ (0, 1)
    have hb : ubar = -(1 / u) := by field_simp; linarith [hn]
    rw [hb] at htr
    obtain ⟨hlo, hhi⟩ := trace_bound_norm_minus u φ hu1 huφ hφ hφ1
    have h1 : φ - 1 / φ = 1 := (phi_trace_values φ hφ hφ1).1
    exact no_integer_in_zero_one m (by linarith [htr, hlo])
      (by rw [← h1]; linarith [htr, hhi])

/-! ## §168.4  ★★★ Lo que cierra -/

inductive NowClosed where
  | phiFundamental   -- §154, sin restricción de cuadrante
  | unitIsAPower     -- §167, el despeje ya no cuelga
  | unitStructure    -- §140, DERIVADA
  deriving DecidableEq
instance : Fintype NowClosed :=
  ⟨{NowClosed.phiFundamental, NowClosed.unitIsAPower, NowClosed.unitStructure}, by
    intro x; cases x <;> simp⟩

/-- **[P] ★★★ TRES COSAS CIERRAN CON §168. -/
theorem three_things_close : Fintype.card NowClosed = 3 := by decide

/-- Lo que sigue `[C]` en la cadena de §165. -/
inductive StillClassical where
  | binetTrace   -- §140, Binet
  | corpus105    -- membership_is_equivalent_to_E
  deriving DecidableEq
instance : Fintype StillClassical :=
  ⟨{StillClassical.binetTrace, StillClassical.corpus105}, by
    intro x; cases x <;> simp⟩

/-- **[P] ★★ Y QUEDAN DOS `[C]` EN LA CADENA, NO TRES. -/
theorem two_classical_remain : Fintype.card StillClassical = 2 := by decide

/-- **[O] ★★★★ EL PATRÓN, SEXTA VEZ.**

    «Acotar la traza y usar que es entera»:

      §129 `tr_ge_two_of_pos` · §130 `lucas_window` ·
      §132 `the_trace_chain` · §133 `int_lt_one_is_zero` ·
      §137 `the_closing_chain` · **§168 aquí**

    Era exactamente lo que faltaba aplicar al cuadrante. -/
@[reducible] def SixthTimeSamePattern : Prop := (5 : ℕ) + 1 = 6

theorem sixth_time : SixthTimeSamePattern := by decide

/-! ## §168.5  Ensamblaje -/

/-- **[P] ★★★★★ EL CUADRANTE CIERRA, Y CON ÉL §167.**

    · la traza `a = u + ū` es entera y no distingue cuadrantes;
    · `N = +1` la mete en `(2, √5)`;  `N = −1`, en `(0, 1)`;
    · ninguno de los dos contiene enteros;
    · luego no hay unidad en `(1, φ)`, **sin restringir signos**.

    Con ello `NoUnitBelowPhi` es universal, `unit_is_a_power_of_phi`
    (§167) cierra, y `UnitStructure` queda DERIVADA. -/
theorem the_trace_closes_the_quadrants (u φ : ℝ) (a b : ℤ)
    (hφ : φ ^ 2 = φ + 1) (hφ1 : 1 < φ) (hu1 : 1 < u) (huφ : u < φ) :
    -- los dos intervalos
    (2 < u + 1 / u ∧ u + 1 / u < φ + 1 / φ)
    ∧ (0 < u - 1 / u ∧ u - 1 / u < φ - 1 / φ)
    -- los dos extremos, exactos
    ∧ (φ - 1 / φ = 1)
    ∧ ((φ + 1 / φ) ^ 2 = 5)
    -- y √5 está entre 2 y 3
    ∧ ((2:ℝ) < Real.sqrt 5 ∧ Real.sqrt 5 < 3)
    -- la traza es a, entera, sin signos
    ∧ (unitCoord a b + unitConj a b = (a : ℝ))
    -- lo que cierra
    ∧ (Fintype.card NowClosed = 3)
    ∧ (Fintype.card StillClassical = 2) :=
  ⟨trace_bound_norm_plus u φ hu1 huφ hφ hφ1,
   trace_bound_norm_minus u φ hu1 huφ hφ hφ1,
   (phi_trace_values φ hφ hφ1).1,
   (phi_trace_values φ hφ hφ1).2,
   sqrt_five_between,
   coord_trace a b,
   three_things_close, two_classical_remain⟩

