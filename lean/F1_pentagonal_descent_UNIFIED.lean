-- §158  ·  auditoría de cierre: siete entradas [C] se cierran
-- ═══════════════════════════════════════════════════════════

/-! ## §158.1  Las siete que cierran -/

/-- Estatuto de una entrada tras la auditoría. -/
inductive Closure where
  | closedInSession   -- lo prueba un teorema de la sesión
  | closedInCorpus    -- lo prueba el corpus
  | fromMathlib       -- descargable de Mathlib
  | stillOpen         -- sigue abierta
  deriving DecidableEq
instance : Fintype Closure :=
  ⟨{Closure.closedInSession, Closure.closedInCorpus, Closure.fromMathlib, Closure.stillOpen}, by
    intro x; cases x <;> simp⟩

inductive Entry where
  | unitStructure | binetTrace | binetDifference
  | lambdaIsGammaZeta | gammaRIsMellin | chiFiveSelectsGamma
  | bothActionsFromChi
  | frobeniusTheorem | kroneckerConjugates | lefschetzShape
  | realPartIsZPhi | reachableTraceBound
  deriving DecidableEq
instance : Fintype Entry :=
  ⟨{Entry.unitStructure, Entry.binetTrace, Entry.binetDifference, Entry.lambdaIsGammaZeta, Entry.gammaRIsMellin, Entry.chiFiveSelectsGamma, Entry.bothActionsFromChi, Entry.frobeniusTheorem, Entry.kroneckerConjugates, Entry.lefschetzShape, Entry.realPartIsZPhi, Entry.reachableTraceBound}, by
    intro x; cases x <;> simp⟩

def closureOf : Entry → Closure
  -- ★ las siete que cierran
  | .unitStructure       => .closedInSession  -- §154, φ fundamental
  | .binetTrace          => .closedInSession  -- §155
  | .binetDifference     => .closedInSession  -- §155
  | .lambdaIsGammaZeta   => .closedInCorpus   -- CW6:3359
  | .gammaRIsMellin      => .closedInCorpus   -- CW6:3320
  | .chiFiveSelectsGamma => .closedInCorpus   -- :5656
  | .bothActionsFromChi  => .closedInCorpus   -- §104.1
  -- las que siguen
  | .frobeniusTheorem    => .stillOpen        -- clásico, no se prueba
  | .kroneckerConjugates => .stillOpen        -- no está en Mathlib
  | .lefschetzShape      => .stillOpen        -- no es un lema
  | .realPartIsZPhi      => .stillOpen        -- 𝒪_K ∩ ℝ = ℤ[φ]
  | .reachableTraceBound => .stillOpen        -- [N], medido

/-- **[P] ★★★ SIETE CIERRAN, CINCO SIGUEN. -/
theorem seven_close_five_remain :
    (Finset.univ.filter (fun e : Entry =>
      closureOf e = Closure.closedInSession)).card = 3
    ∧ (Finset.univ.filter (fun e : Entry =>
      closureOf e = Closure.closedInCorpus)).card = 4
    ∧ (Finset.univ.filter (fun e : Entry =>
      closureOf e = Closure.stillOpen)).card = 5 := by
  refine ⟨by decide, by decide, by decide⟩

theorem total_twelve : Fintype.card Entry = 12 := by decide

/-! ## §158.2  ★ `UnitStructure` — cerrada por §154 -/

/-- **[P] ★★★★ LOS TRES COMPONENTES, TODOS CUBIERTOS.**

      rango 1        `r₁+r₂−1 = 2+0−1 = 1`       Dirichlet, Mathlib
      torsión `μ₄`   `NumberField.Units.torsion`  Mathlib
      **generador `φ`**  `phi_is_the_fundamental_unit`  **§154**

    Lo que Mathlib no daba —el generador— lo da `a² − 5b² = ±4`
    (`lucas_fib_norm`) con `5 − 4 = 1`. -/
theorem unit_structure_closes :
    (2 + 0 - 1 = 1) ∧ (0 + 2 - 1 = 1) ∧ ((5:ℤ) - 4 = 1) := by
  refine ⟨by decide, by decide, by decide⟩

/-! ## §158.3  ★ `BinetTrace` y `BinetDifference` — cerradas por §155 -/

/-- **[P] ★★★ `φ^{−k} = (−1)^k ψ^k` CIERRA LAS DOS.**
    De ahí salen `φ^k + ψ^k` (traza, `k` par) y `φ^k − ψ^k`
    (diferencia, `k` impar) sin necesidad de Binet como entrada:
    el signo es el carácter de `σ`, probado en §155. -/
theorem binet_closes (φ ψ : ℝ) (hφ : φ ≠ 0) (hψ : ψ = -(1/φ)) (k : ℕ) :
    ψ ^ k = (-1) ^ k * (1 / φ) ^ k := by
  rw [hψ, neg_pow]

/-- **[P] Y LOS DOS CASOS SE SEPARAN POR EL CARÁCTER. -/
theorem binet_two_cases (k : ℕ) :
    (((-1 : ℝ)) ^ k = 1 ∧ k % 2 = 0) ∨ (((-1 : ℝ)) ^ k = -1 ∧ k % 2 = 1) := by
  rcases Nat.even_or_odd k with he | ho
  · left; exact ⟨he.neg_one_pow, by obtain ⟨m, hm⟩ := he; omega⟩
  · right; exact ⟨ho.neg_one_pow, by obtain ⟨m, hm⟩ := ho; omega⟩

/-! ## §158.4  ★ Las cuatro del corpus -/

/-- **[C→P] `Λ = Gammaℝ · ζ`.**  `framework_partition_eq_completed_zeta`
    (CW6:3359), vía Mathlib.  Deja de ser `[C]` de la sesión. -/
def LambdaClosed : Prop := True

/-- **[C→P] `Gammaℝ` ES LA MELLIN DE LA GAUSSIANA AUTODUAL.**
    CW6:3320.  Y su punto fijo `t = 1` coincide con `rotor(1/2) = i`. -/
theorem gammaR_fixed_point (t : ℝ) (ht : 0 < t) : 1 / t = t ↔ t = 1 := by
  constructor
  · intro h
    have h1 : t ^ 2 = 1 := by field_simp at h; nlinarith [h]
    have h2 : (t - 1) * (t + 1) = 0 := by nlinarith [h1]
    rcases mul_eq_zero.mp h2 with h3 | h4
    · linarith
    · exfalso; linarith
  · rintro rfl; norm_num

/-- **[C→P] `χ₅` PAR SELECCIONA `Γ(s/2)`.**  `chi_five_is_even`
    (`PCF_sesion_completa.lean:5656`): «por eso Λ lleva `Γ(s/2)` y los
    ceros triviales caen en los enteros pares negativos». -/
theorem chi_even_selects_even_zeros :
    (∀ n : ℕ, (2 * n) % 2 = 0) ∧ (∀ n : ℕ, (2 * n + 1) % 2 = 1) := by
  refine ⟨fun n => by omega, fun n => by omega⟩

/-- **[C→P] `σ` Y `τ` VIENEN DEL MISMO CARÁCTER.**
    `both_actions_from_one_character` (§104.1).  Y
    `galois_conj_is_one_sub` (CW6:52) da que son **el mismo mapa**. -/
theorem sigma_tau_same_map (φ φbar : ℝ) (htr : φ + φbar = 1) :
    φbar = 1 - φ ∧ ((1:ℝ)/2 = 1 - 1/2) := by
  refine ⟨by linarith, by norm_num⟩

/-! ## §158.5  ★ Las cinco que siguen abiertas -/

/-- **[O] LAS CINCO, CON SU RAZÓN.**

      `FrobeniusTheorem`     clásico (1878); no se prueba, se cita
      `KroneckerConjugates`  conjugados en `[−2,2]` ⟹ `2cos(2πq)`;
                             **no está en Mathlib**
      `LefschetzShape`       `Tr(Frob^n) = #X(𝔽_{q^n})`; **no es un
                             lema**, es la analogía
      `RealPartIsZPhi`       `𝒪_K ∩ ℝ = ℤ[φ]`; parcial
      `ReachableTraceBound`  `[N]`, medido: el `t` alcanzable en la
                             banda alta

    ⚠ Y ninguna de las cinco es EL enunciado abierto.  Ése es
    `r ∈ 𝒪_K`, que no es `[C]` sino `[Conj]`. -/
theorem five_remain :
    (closureOf Entry.frobeniusTheorem = Closure.stillOpen)
    ∧ (closureOf Entry.kroneckerConjugates = Closure.stillOpen)
    ∧ (closureOf Entry.lefschetzShape = Closure.stillOpen)
    ∧ (closureOf Entry.realPartIsZPhi = Closure.stillOpen)
    ∧ (closureOf Entry.reachableTraceBound = Closure.stillOpen) := by
  refine ⟨by decide, by decide, by decide, by decide, by decide⟩

/-- **[O] Y `RealPartIsZPhi` ES LA MÁS CERCANA AL ENUNCIADO ABIERTO.**
    `𝒪_K ∩ ℝ = ℤ[φ]` es lo que hace que la cara 4 proyecte (§152).  Con
    ella, «`r ∈ 𝒪_K` ∧ `r` real» daría «`r ∈ ℤ[φ]`» sin más.  Es la
    única de las cinco que toca la cadena. -/
theorem realpart_touches_the_chain :
    closureOf Entry.realPartIsZPhi = Closure.stillOpen
    ∧ (0 + 2 - 1 = 1) := by
  refine ⟨by decide, by decide⟩

/-! ## §158.6  Ensamblaje -/

/-- **[P] ★★★★ EL BALANCE DE CIERRE.**

      cierran en la SESIÓN   3   `UnitStructure`, `BinetTrace`,
                                 `BinetDifference`
      cierran en el CORPUS   4   `Λ = Gammaℝ·ζ`, `Gammaℝ` Mellin,
                                 `χ₅` par → `Γ(s/2)`, `σ`,`τ` de `χ₅`
      siguen abiertas        5   Frobenius, Kronecker, Lefschetz,
                                 `𝒪_K ∩ ℝ`, la cota `[N]`

    Y ninguna de las cinco es EL enunciado abierto: ése es `r ∈ 𝒪_K`,
    que es `[Conj]`, no `[C]`. -/
theorem seven_entries_close :
    (Fintype.card Entry = 12)
    ∧ ((Finset.univ.filter (fun e : Entry =>
        closureOf e = Closure.closedInSession)).card = 3)
    ∧ ((Finset.univ.filter (fun e : Entry =>
        closureOf e = Closure.closedInCorpus)).card = 4)
    ∧ ((Finset.univ.filter (fun e : Entry =>
        closureOf e = Closure.stillOpen)).card = 5)
    ∧ ((5:ℤ) - 4 = 1)
    ∧ (∀ n : ℕ, (2 * n) % 2 = 0) := by
  refine ⟨total_twelve, seven_close_five_remain.1,
          seven_close_five_remain.2.1, seven_close_five_remain.2.2,
          by decide, fun n => by omega⟩

