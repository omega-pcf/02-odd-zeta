/-! ## §110.1  Las dos entradas clásicas, en la firma -/

/-- **[C] LA FACTORIZACIÓN DE HADAMARD, en forma logarítmica.**
    `Λ'/Λ(s) = B + Σ_ρ (1/(s−ρ) + 1/ρ)`.  Se lleva como predicado:
    el análisis es clásico. -/
def HadamardLogDerivative (LlogD : ℝ → ℝ) (B : ℝ) (Ssum : ℝ → ℝ) : Prop :=
  ∀ s : ℝ, LlogD s = B + Ssum s

/-- **[C] EL CIERRE BAJO `ρ ↦ 1−ρ`.**  Por la ecuación funcional, la
    suma en `s = 1` se parte en dos copias de `S`. -/
def FunctionalSymmetry (Ssum : ℝ → ℝ) (S : ℝ) : Prop :=
  Ssum 1 = 2 * S

/-- **[C] EL ANCLA.**  `B = −S`, es decir `B = −Σ Re(1/ρ)`. -/
def AnchorValue (B S : ℝ) : Prop := B = -S

/-! ## §110.2  La convergencia, como teorema -/

/-- **[P] `λ₁ = −B`.**  De las tres entradas:

        `λ₁ = Λ'/Λ(1) = B + 2S`  y  `B = −S`
        ⟹  `λ₁ = −S + 2S = S = −B`.

    **Las dos rutas dan el mismo número por teorema**, no por ajuste
    numérico. -/
theorem two_routes_agree (LlogD : ℝ → ℝ) (Ssum : ℝ → ℝ) (B S : ℝ)
    (hH : HadamardLogDerivative LlogD B Ssum)
    (hF : FunctionalSymmetry Ssum S)
    (hA : AnchorValue B S) :
    LlogD 1 = -B := by
  unfold HadamardLogDerivative at hH
  unfold FunctionalSymmetry at hF
  unfold AnchorValue at hA
  rw [hH 1, hF, hA]
  ring

/-- **[P] Y ES POSITIVO SI `B < 0`.**  El signo de `λ₁` es el opuesto
    al de `B` ---lo que descarta cualquier valor negativo para `λ₁`
    cuando el ancla es negativa. -/
theorem li_one_sign (LlogD : ℝ → ℝ) (Ssum : ℝ → ℝ) (B S : ℝ)
    (hH : HadamardLogDerivative LlogD B Ssum)
    (hF : FunctionalSymmetry Ssum S)
    (hA : AnchorValue B S) (hB : B < 0) :
    0 < LlogD 1 := by
  rw [two_routes_agree LlogD Ssum B S hH hF hA]
  linarith

/-! ## §110.3  La simetría, por término -/

/-- **[P] EN LA LÍNEA, `1−ρ = ρ̄`.**  Para `ρ = 1/2 + iγ`, el
    compañero funcional es el conjugado ---por eso
    `Σ 1/(1−ρ) = Σ 1/ρ` término a término. -/
theorem functional_mate_is_conjugate (γ : ℝ) :
    (1 : ℂ) - ⟨1 / 2, γ⟩ = (starRingEnd ℂ) ⟨1 / 2, γ⟩ := by
  apply Complex.ext <;> simp [Complex.sub_re, Complex.sub_im,
    Complex.one_re, Complex.one_im, Complex.conj_re, Complex.conj_im]
  norm_num

/-- **[P] Y EL APORTE DEL PAR ES REAL Y POSITIVO.**
    `1/ρ + 1/ρ̄ = 2Re(1/ρ) = 1/(1/4 + γ²) > 0`. -/
theorem pair_contribution_positive (γ : ℝ) :
    0 < (1 : ℝ) / (1 / 4 + γ ^ 2) := by positivity

/-! ## §110.4  La cola, y por qué 90 ceros no bastan -/

/-- **[N] LA COLA.**  `Σ_{γ>T} 1/(1/4+γ²)` con densidad
    `(1/2π)log(5γ/2π)` estimada por
    `(1/2π)[log(5T/2π) + 1]/T`.  Entrada numérica. -/
def TailEstimate (tail T : ℝ) : Prop :=
  tail = (Real.log (5 * T / (2 * Real.pi)) + 1) / (2 * Real.pi * T)

/-- **[P] LA COLA ES POSITIVA Y DECRECE.**  Para `T` grande la
    estimación es positiva ---luego la suma truncada SUBESTIMA, que
    es la dirección observada (`0.0721 < 0.0783`). -/
theorem tail_is_positive (T : ℝ) (hT : 2 * Real.pi / 5 < T) (hT0 : 0 < T) :
    0 < (Real.log (5 * T / (2 * Real.pi)) + 1) / (2 * Real.pi * T) := by
  have h1 : 1 < 5 * T / (2 * Real.pi) := by
    rw [one_lt_div (by positivity)]
    linarith [hT]
  have h2 : 0 < Real.log (5 * T / (2 * Real.pi)) := Real.log_pos h1
  positivity

/-- **[O] LA DIRECCIÓN DEL ERROR ESTÁ EXPLICADA.**  La cola es
    positiva, luego truncar da MENOS que el valor ---y eso es lo
    observado: `0.0721361550550517 < 0.0782784769970`. -/
theorem truncation_underestimates (T : ℝ) (hT : 2 * Real.pi / 5 < T)
    (hT0 : 0 < T) :
    0 < (Real.log (5 * T / (2 * Real.pi)) + 1) / (2 * Real.pi * T) :=
  tail_is_positive T hT hT0

/-! ## §110.5  El balance -/

/-- **[O] EL BALANCE DE §110.**

    | | |
    |---|---|
    | ruta A, `s=0` | `B = −Σ Re(1/ρ) = −0.0782784769970` |
    | ruta B, `s=1` | `λ₁ = Σ 1/ρ = +0.0782784769971` |
    | por qué coinciden | **Hadamard + ecuación funcional**, `[P]` |
    | la desviación de `90` ceros | **la cola**, `0.12%` de acuerdo |

    **El `=` entre las dos rutas es teorema**, y la desviación
    numérica es truncamiento con decaimiento `(log T)/T`.

    Esto fija `λ₁ = +0.0782784769971` y confirma la corrección de
    §109 sobre §86. -/
theorem the_balance_of_section_110 (LlogD : ℝ → ℝ) (Ssum : ℝ → ℝ) (B S γ T : ℝ)
    (hH : HadamardLogDerivative LlogD B Ssum)
    (hF : FunctionalSymmetry Ssum S)
    (hA : AnchorValue B S) (hB : B < 0)
    (hT : 2 * Real.pi / 5 < T) (hT0 : 0 < T) :
    (LlogD 1 = -B) ∧
    (0 < LlogD 1) ∧
    (0 < (1 : ℝ) / (1 / 4 + γ ^ 2)) ∧
    (0 < (Real.log (5 * T / (2 * Real.pi)) + 1) / (2 * Real.pi * T)) :=
  ⟨two_routes_agree LlogD Ssum B S hH hF hA,
   li_one_sign LlogD Ssum B S hH hF hA hB,
   pair_contribution_positive γ,
   tail_is_positive T hT hT0⟩

