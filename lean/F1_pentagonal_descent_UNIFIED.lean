   BLOQUE 12 de 16 - PCF_homology_visibility
   que NO quiere decir visible en H1
   ===================================================================== -/


/-! ## 1.  Un homomorfismo desde el color hacia la torsión -/

/-- Un elemento de `(ℤ/4)²`, como par de residuos. -/
abbrev T4 := Nat × Nat

/-- Un homomorfismo desde `ℤ/m` a `(ℤ/4)²` queda determinado por su valor en
    el generador, y la única condición es que `m` veces ese valor se anule. -/
def killedBy (m : Nat) (v : T4) : Bool :=
  ((m * v.1) % 4 == 0) && ((m * v.2) % 4 == 0)

/-- **[P] `Hom(ℤ/3, (ℤ/4)²) = 0`.**  El único valor admisible del generador
    es el neutro: el color no se mete en la torsión de la cubierta.

    Por eso «el refinamiento es visible en homología» no puede leerse como
    «el grupo de cubierta está ahí dentro». -/
theorem colour_does_not_embed :
    ((List.range 4).all (fun a => (List.range 4).all (fun b =>
       !(killedBy 3 (a, b)) || ((a == 0) && (b == 0))))) = true := by
  decide

/-- **[P] LA ORIENTACIÓN SÍ.**  `(2,2)` es de orden dos en `(ℤ/4)²` y es
    matado por `2`: hay homomorfismos no triviales desde `ℤ/2`. -/
theorem orientation_does_embed :
    killedBy 2 (2, 2) = true ∧ ((2, 2) : T4) ≠ ((0, 0) : T4) := by
  refine ⟨by decide, by decide⟩

/-- **[P] LUEGO SÓLO LA 2-PARTE DE `μ₆` SE LEE EN LA TORSIÓN.**  Un elemento
    matado por seis está matado por dos: el factor `ℤ/3` no contribuye. -/
theorem only_the_two_part_of_mu6_embeds :
    ((List.range 4).all (fun a => (List.range 4).all (fun b =>
       !(killedBy 6 (a, b)) || (killedBy 2 (a, b))))) = true := by
  decide

/-! ## 2.  Y la torsión no es el grupo de cubierta -/

/-- La torsión de `H₁(X̃₆)` es `coker(M⁶ − I) = ℤ²/4ℤ²`, de orden `16` y
    exponente `4`; el grupo de cubierta tiene orden `6` y exponente `6`.
    Ni los órdenes ni los exponentes coinciden. -/
theorem torsion_is_not_the_deck_group :
    4 * 4 = 16 ∧ 16 ≠ 6 ∧ ¬ (6 ∣ 4) ∧ ¬ (3 ∣ 4) := by
  refine ⟨by decide, by decide, by decide, by decide⟩

/-! ## 3.  La conjunción -/

/-- **[P⊕] QUÉ QUIERE DECIR «VISIBLE EN HOMOLOGÍA», EXACTAMENTE.**

    (a) `Hom(ℤ/3, (ℤ/4)²) = 0`: el color no inyecta en la torsión;
    (b) pero hay homomorfismos no triviales desde `ℤ/2`;
    (c) luego de `μ₆` sólo la orientación se lee ahí;
    (d) y la torsión —orden `16`, exponente `4`— no es el grupo de cubierta
        —orden `6`—, ni lo contiene.

    Luego «visible» significa lo que `thm:cover-homology` demuestra y nada
    más: **la homología de la cubierta difiere de la de la base**, y ese
    cambio es causado por el refinamiento.  No significa que el grupo de
    cubierta se lea dentro de `H₁`.  Leerlo así repetiría el error que
    `no_hom_from_Z3` ya cierra en otro sitio. -/
theorem what_visible_in_homology_means :
    (((List.range 4).all (fun a => (List.range 4).all (fun b =>
       !(killedBy 3 (a, b)) || ((a == 0) && (b == 0))))) = true) ∧
    (killedBy 2 (2, 2) = true ∧ ((2, 2) : T4) ≠ ((0, 0) : T4)) ∧
    (((List.range 4).all (fun a => (List.range 4).all (fun b =>
       !(killedBy 6 (a, b)) || (killedBy 2 (a, b))))) = true) ∧
    (¬ (3 ∣ 4)) :=
  ⟨colour_does_not_embed, orientation_does_embed, only_the_two_part_of_mu6_embeds,
   torsion_is_not_the_deck_group.2.2.2⟩



