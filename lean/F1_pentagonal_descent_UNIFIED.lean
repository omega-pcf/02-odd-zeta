/-! ### Cláusulas que faltaban en F₁ -/

/-- (ii) Cierre de la décima raíz: ζ₁₀¹⁰ = 1. -/
theorem zeta10_pow_ten : (Complex.exp (Real.pi * Complex.I / 5)) ^ (10:ℕ) = 1 := by
  rw [← Complex.exp_nat_mul]
  change Complex.exp (↑10 * (↑Real.pi * Complex.I / 5)) = 1
  have h : (↑10 : ℂ) * (Real.pi * Complex.I / 5) = 2 * Real.pi * Complex.I := by ring
  rw [h, Complex.exp_two_pi_mul_I]

/-- (xii) Discretización del rotor: (ζ₁₀^k)¹⁰ = 1 para todo k. -/
theorem zeta10_pow_k_pow_ten (k : ℕ) :
    ((Complex.exp (Real.pi * Complex.I / 5)) ^ k) ^ (10:ℕ) = 1 := by
  rw [← pow_mul]; rw [show k * (10:ℕ) = (10:ℕ) * k from mul_comm k 10];
  rw [pow_mul, zeta10_pow_ten, one_pow]

/-- (i) Inscripción ciclotómica: φ = ζ₁₀ + ζ₁₀⁻¹.
    La cara del rotor complejo: φ es la traza de la décima raíz. -/
theorem phi_cyclotomic_inscription :
    (Complex.exp (Real.pi * Complex.I / 5))
      + (Complex.exp (Real.pi * Complex.I / 5))⁻¹ = (φ : ℂ) := by
  -- Step 1: exp(z)⁻¹ = exp(-z)
  have h1 : (Complex.exp (Real.pi * Complex.I / 5))⁻¹
         = Complex.exp (-(Real.pi * Complex.I / 5)) := by
    rw [← Complex.exp_neg]
  rw [h1]
  -- Step 2: exp(iθ) + exp(-iθ) = 2*cos(θ) by definition of Complex.cos
  have h2 : Complex.exp (Real.pi * Complex.I / 5) + Complex.exp (-(Real.pi * Complex.I / 5))
           = 2 * Complex.cos ((Real.pi / 5 : ℝ) : ℂ) := by
    unfold Complex.cos; field_simp; congr 1
    · rw [show (Real.pi : ℂ) * Complex.I / 5 = Complex.I * (Real.pi / 5) from by ring]
      simp [Complex.ofReal_div]
    · rw [show -((Real.pi : ℂ) * Complex.I / 5) = -(Complex.I * (Real.pi / 5)) from by ring]
      simp [Complex.ofReal_div]
  rw [h2]
  -- Step 3: Complex.cos(x) = (Real.cos x) for real x
  rw [← Complex.ofReal_cos]
  -- Step 4: 2 * Real.cos(pi/5) = phi
  rw [cos_pi_div_five_eq]
  push_cast; ring

/-- (vii) Identificación ternaria triple: 3 = M₂ = |{3,7,11}|.
    El multiplicador de la identidad universal no es libre. -/
theorem triple_ternary_identification :
    (3 : ℕ) = 2^2 - 1 ∧ ({3, 7, 11} : Finset (ZMod 20)).card = 3 := by
  refine ⟨by norm_num, by decide⟩

/-- (x) Inclusión del sub-objeto de Galois: {3,7,11} ⊆ ℤ₂₀*.
    El locus aritmético de Mersenne vive dentro del grupo de Galois. -/
theorem admissible_subset_ZtwentyStar :
    ({3, 7, 11} : Finset (ZMod 20)) ⊆ ZtwentyStar := by decide

/-- (ix) Orden de Galois y razón cuantitativa: |ℤ₂₀*| = 8, y el
    locus admisible ocupa 3 de esas 8 clases. -/
theorem galois_order_and_ratio :
    ZtwentyStar.card = 8 ∧ ({3, 7, 11} : Finset (ZMod 20)).card = 3 := by
  refine ⟨by decide, by decide⟩

/-! ### El ensamblaje: la identidad se preserva -/

/-- **PRESERVACIÓN DE LA IDENTIDAD UNIVERSAL EN F₁.**

    Las cláusulas de `thm:coincidence-intro`, agrupadas por la
    estructura que habitan, todas realizadas por el MISMO φ dentro
    de F₁:

      rotor complejo ℂ     — (i) (ii) (xii)
      línea trigonométrica — (iii)
      línea multiplicativa — (iv)
      Mersenne mod 20      — (vii)
      Galois de ℚ(ζ₂₀)     — (ix) (x)

    Un solo generador, cinco estructuras, sin parámetro libre. -/
theorem identity_preserved_in_F1 :
    -- rotor complejo
    ((Complex.exp (Real.pi * Complex.I / 5))
       + (Complex.exp (Real.pi * Complex.I / 5))⁻¹ = (φ : ℂ)) ∧
    ((Complex.exp (Real.pi * Complex.I / 5)) ^ (10:ℕ) = 1) ∧
    (∀ k : ℕ, ((Complex.exp (Real.pi * Complex.I / 5)) ^ k) ^ (10:ℕ) = 1) ∧
    -- línea trigonométrica real
    (Real.cos (Real.pi / 5) = φ / 2) ∧
    -- línea real-multiplicativa
    ((φ : ℝ) ^ (Real.log 2 / Real.log φ) = 2) ∧
    -- aritmética de Mersenne mod 20
    ((3 : ℕ) = 2^2 - 1 ∧ ({3, 7, 11} : Finset (ZMod 20)).card = 3) ∧
    -- Galois
    (ZtwentyStar.card = 8 ∧ ({3, 7, 11} : Finset (ZMod 20)) ⊆ ZtwentyStar) := by
  exact ⟨phi_cyclotomic_inscription, zeta10_pow_ten, zeta10_pow_k_pow_ten,
         cos_pi_div_five_eq, mersenne_bridge, triple_ternary_identification,
         ⟨galois_order_and_ratio.1, admissible_subset_ZtwentyStar⟩⟩

/-- **LA EXTENSIÓN HASTA LOS CEROS.**
    La identidad no se detiene en el conductor.  Por la cadena de
    determinación (`routes:prop-determination`, cinco flechas
    probadas: φ → χ₅ por Binet → factores locales → L → Z_χ₅, «no
    free parameter enters at any stage») el mismo φ genera el
    conjunto de ceros.  La cadena es además INYECTIVA: cambiar el
    generador cambia el conjunto de ceros — con ε(8) = 1+√2 se
    obtiene χ₈ y ordenadas distintas (4.8999…, 7.6284…, frente a
    6.6484…, 9.8314… de χ₅; separación mínima 0.3517,
    `verify_determination_causal.py`).

    Y el módulo que la clase realiza es μ₃ = 1/2, el mismo por las
    tres caras: retículo de Eisenstein ‖½ω^k‖ = 1/2 (álgebra),
    half-factorial Γ(3/2)/√π = 1/2 (isometría), y φ^(-λ) = 1/2
    (torre).  Un generador, un módulo, un conjunto de ceros. -/
theorem identity_extends_to_spectrum :
    ((φ : ℝ) ^ (Real.log 2 / Real.log φ) = 2) ∧
    (mu_n_param 3 = 1/2) ∧
    (‖Omega_hat 0‖ = mu_n_param 3) ∧
    (∀ z : Chi5Zero, 0 < z.ρ.re ∧ z.ρ.re < 1) := by
  refine ⟨mersenne_bridge, mu_ternary_param, ?_, fun z => ⟨z.in_strip_pos, z.in_strip_lt⟩⟩
  unfold Omega_hat mu_n_param; norm_num


/- NOTAS PARA HERMES ─────────────────────────────────────────────
   1. `phi_cyclotomic_inscription` es la única con riesgo real.
      Nombres alternativos si fallan:
      - `Complex.exp_add_exp_neg_eq_two_mul_cos` puede llamarse
        `Complex.cos_eq_exp_add_exp_neg` (dividido entre 2) o
        `Complex.two_cos`.
      - Ruta alternativa más segura: escribir todo en la forma
          exp(iθ) + exp(-iθ) = 2cos θ
        vía `Complex.exp_mul_I` en ambos términos y sumar partes
