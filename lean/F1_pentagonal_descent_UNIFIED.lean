  have h5 : ((φ : ℝ) + 1 / (φ : ℝ)) = Real.sqrt 5 := phi_trace_is_sqrt_five
  rw [h5] at ht
  have hrt : Irrational (Real.sqrt 5) :=
    (Nat.Prime.irrational_sqrt (by norm_num : Nat.Prime 5))
