theorem height_bounded_below_the_line (ρ : ℂ) (hρ : ρ ≠ 0)
    (hd : ρ.re ^ 2 + ρ.im ^ 2 ≠ 0) (h0 : 0 < ρ.re) (h1 : ρ.re < 1)
    (hlt : (zeroCoord ρ) ^ 2 - 1 < 0) :
    (1 - (zeroCoord ρ) ^ 2) * ρ.im ^ 2 < 1 := by
  have hid := the_bound_reaches_the_other_family ρ hρ hd
  have hprod : 0 ≤ (1 - (zeroCoord ρ) ^ 2) * ρ.re ^ 2 :=
    mul_nonneg (by linarith) (sq_nonneg ρ.re)
  nlinarith [hid, h1, hprod]

theorem noLowZeros_forces_a_small_defect (ρ : ℂ) (hρ : ρ ≠ 0)
    (hd : ρ.re ^ 2 + ρ.im ^ 2 ≠ 0) (h0 : 0 < ρ.re) (h1 : ρ.re < 1)
    (hγ : 2 ≤ |ρ.im|) :
    |(zeroCoord ρ) ^ 2 - 1| ≤ 1/4 := by
  have h4 : (4:ℝ) ≤ ρ.im ^ 2 := by
    have hs : |ρ.im| ^ 2 = ρ.im ^ 2 := sq_abs ρ.im
    nlinarith [hγ, abs_nonneg ρ.im, hs]
  rcases lt_trichotomy ((zeroCoord ρ) ^ 2 - 1) 0 with hlt | heq | hgt
  · have hb := height_bounded_below_the_line ρ hρ hd h0 h1 hlt
    rw [abs_of_neg hlt]
    have hstep : (1 - (zeroCoord ρ) ^ 2) * 4 ≤ (1 - (zeroCoord ρ) ^ 2) * ρ.im ^ 2 :=
      mul_le_mul_of_nonneg_left h4 (by linarith)
    linarith
  · rw [heq]; norm_num
  · have hb := height_bounded_by_the_defect ρ hρ hd h0 h1 hgt
    rw [abs_of_pos hgt]
    have hstep : ((zeroCoord ρ) ^ 2 - 1) * 4 ≤ ((zeroCoord ρ) ^ 2 - 1) * ρ.im ^ 2 :=
      mul_le_mul_of_nonneg_left h4 (le_of_lt hgt)
    linarith

theorem no_zero_carries_a_family_coordinate (ρ : ℂ) (hρ : ρ ≠ 0)
    (hd : ρ.re ^ 2 + ρ.im ^ 2 ≠ 0) (h0 : 0 < ρ.re) (h1 : ρ.re < 1)
    (hγ : 2 ≤ |ρ.im|) (k : ℤ) (hk : zeroCoord ρ = (φ : ℝ) ^ k)
    (hbig : 1/4 < |((φ : ℝ) ^ k) ^ 2 - 1|) : False := by
  have hb := noLowZeros_forces_a_small_defect ρ hρ hd h0 h1 hγ
