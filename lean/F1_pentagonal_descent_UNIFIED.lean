section Block08

/-
  F1_primon_space.lean
  ────────────────────────────────────────────────────────────────────────
  RUTA AL NÚCLEO — el espacio que lleva todos los ψ_p a la vez.

  El operador hermitiano H̃_PCF del manuscrito HP vive en ℓ²(ℕ) con base
  {e_n}.  Ese mismo espacio es el que pide la positividad de Weil, si sobre
  él actúan TODOS los Frobenius a la vez.  Aquí se construye esa acción, en
  su forma algebraica (funciones de soporte finito ℕ →₀ ℂ, que son el núcleo
  algebraico 𝒟₀ denso en ℓ²(ℕ) del manuscrito, thm:domain-dense):

    · el monoide multiplicativo actúa por desplazamientos U_p : e_n ↦ e_{pn},
      con U_p ∘ U_q = U_{pq} — la misma ley que X_PCF (ψ_p ∘ ψ_q = ψ_{pq});
    · el Frobenius de ℤ[φ] da el giro: sobre √5, ψ_n actúa por χ₅(n);
    · la traza torcida truncada Σ_{n<N} χ₅(n) n^{−s} es la suma parcial de
      L(s,χ₅): el gas de primones de la Parte III, torcido por el Frobenius.

  Estado: [P*] redactado, sin compilar.  Nada de este archivo afirma E.
  Nombres de Mathlib a verificar: `Finsupp.lmapDomain`, `Finsupp.lmapDomain_apply`,
  `Finsupp.mapDomain_comp`, `Finsupp.mapDomain_single`.
-/



namespace F1PrimonSpace

open F1Pendientes F1FrobeniusEigen

/-- El núcleo algebraico 𝒟₀ de ℓ²(ℕ): combinaciones finitas de los e_n. -/
abbrev D0 := ℕ →₀ ℂ

/-- e_n. -/
noncomputable def e (n : ℕ) : D0 := Finsupp.single n 1

/-- **Desplazamiento multiplicativo** U_p : e_n ↦ e_{p·n}. -/
noncomputable def U (p : ℕ) : D0 →ₗ[ℂ] D0 :=
  Finsupp.lmapDomain ℂ ℂ (fun n => p * n)

/-- **[P*]** U_p(e_n) = e_{pn}. -/
theorem U_e (p n : ℕ) : U p (e n) = e (p * n) := by
  unfold U e
  rw [Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]

/-- **[P*] ★★★★ LEY DE BORGER EN ℓ²(ℕ): U_p ∘ U_q = U_{pq}.**
    La misma ley de composición que `psi_comp` en X_PCF. -/
theorem U_comp (p q : ℕ) : (U p).comp (U q) = U (p * q) := by
  apply LinearMap.ext
  intro f
  simp only [U, LinearMap.comp_apply, Finsupp.lmapDomain_apply]
  rw [← Finsupp.mapDomain_comp]
  congr 1
  funext n
  simp [Function.comp, mul_assoc]

/-- **[P*]** Los desplazamientos conmutan. -/
theorem U_commute (p q : ℕ) : (U p).comp (U q) = (U q).comp (U p) := by
  rw [U_comp, U_comp, mul_comm]

/-- χ₅ sobre ℕ, con valores en ℤ, vía `chi5_Z` de ZMod 5. -/
def χ5 (n : ℕ) : ℤ := F1PCFUnified.chi5_Z (n : ZMod 5)

/-- **[P*]** χ₅ es completamente multiplicativo. -/
theorem χ5_mul (m n : ℕ) : χ5 (m * n) = χ5 m * χ5 n := by
  unfold χ5; push_cast; exact chi5_Z_mul' _ _

/-- **[P*] ★★★★★ EL GIRO ES EL FROBENIUS.**
    Para n primo con 5, el coeficiente χ₅(n) con el que e_n entra en la traza
    torcida es el valor propio de ψ_n sobre √5. -/
theorem twist_is_frobenius (n : ℕ) (hn : ((n : ℕ) : ZMod 5) ≠ 0) :
    ψ n sqrt5 = ((χ5 n : ℤ) : Zφ) * sqrt5 :=
  frobenius_eigenvalue_on_sqrt5 n hn

/-- **[P*] ★★★★ COVARIANCIA.**  Mover e_n a e_{pn} multiplica el giro por el
    valor propio de ψ_p:  χ₅(pn) = χ₅(p)·χ₅(n).  En operadores:
    D_χ ∘ U_p = χ₅(p) · U_p ∘ D_χ, con D_χ el diagonal e_n ↦ χ₅(n) e_n. -/
theorem covariance (p n : ℕ) : χ5 (p * n) = χ5 p * χ5 n := χ5_mul p n

/-- **La traza torcida truncada**: Σ_{n<N} χ₅(n) n^{−s}. -/
noncomputable def twistedTrace (s : ℂ) (N : ℕ) : ℂ :=
  ∑ n ∈ Finset.range N, (χ5 n : ℂ) * (n : ℂ) ^ (-s)

/-- **[P*]** Es la suma parcial de la serie de Dirichlet de χ₅: cada término es
    el valor propio de ψ_n sobre √5 por n^{−s}.  El límite N → ∞ para Re s > 1
    es L(s,χ₅) [C: Mathlib `LSeries`, a enlazar al compilar]. -/
theorem twistedTrace_succ (s : ℂ) (N : ℕ) :
    twistedTrace s (N + 1) = twistedTrace s N + (χ5 N : ℂ) * (N : ℂ) ^ (-s) := by
  unfold twistedTrace; rw [Finset.sum_range_succ]

end F1PrimonSpace

/-
  QUÉ QUEDA ABIERTO
  ─────────────────
  Esta construcción da, para Re s > 1, la función de partición torcida:
  Tr(N^{−s} ⊗ ψ_N | ℓ²(ℕ) ⊗ ℚ√5) = L(s,χ₅).  Es el sistema de Bost–Connes /
  gas de primones con el giro de Frobenius de ℤ[φ].

  Los ceros viven en la continuación analítica, no en Re s > 1.  Pasar de esta
  traza a una forma positiva cuyo lado espectral sean los ceros es el paso de
  Connes (espacio de clases de adèles, espectro de absorción), y su
  positividad es equivalente a GRH(χ₅).  Ése sigue siendo el núcleo.
-/

end Block08

