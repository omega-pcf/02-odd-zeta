/- ══════════════ SECCIÓN 14: iceberg_layers ══════════════ -/
/-
  §10.AA — THE FIVE LAYERS: FROM THE VISIBLE TO THE ORIGIN
  ========================================================
  La cadena que va de lo medido a lo que lo sostiene, y la prueba
  de que cada capa CONDICIONA la de arriba en vez de acompañarla.

      capa 1  estadística GUE de los espaciados      [visible]
        │  normalizada por
      capa 2  escala 2π/log(qT/2π)                   [envolvente]
        │  cuyo q es
      capa 3  el conductor 20 = 4·5                  [dos partes]
        │  que es lcm de
      capa 4  periodos 4 (giro) y 5 (pentágono)      [las dos caras]
        │  y el 5 sale de
      capa 5  φ = ζ₁₀ + ζ₁₀⁻¹  y  Γ(3/2)/√π = ½ = φ^(−λ)   [origen]

  LA PRUEBA DE DEPENDENCIA.  Que las capas no son narración se
  demuestra cambiando el fondo: normalizar los ceros de χ₈ con el
  conductor equivocado rompe la normalización.

      χ₈ con su conductor 8   →  media 0.9949   ✓
      χ₈ con el conductor 5   →  media 0.8838   ✗

  La estadística sólo tiene media 1 en la unidad que su propio
  conductor fija.  Cada capa condiciona la de arriba de forma
  medible.

  ESTE MÓDULO formaliza las capas 2 a 5 —las que son aritmética y
  álgebra exactas— y la dependencia funcional entre ellas.  La capa 1
  es estadística sobre las ordenadas y se reporta con sus cifras:
  media 0.9961, sólo 1 de 128 espaciados bajo 0.3 contra ≈33 de
  Poisson, ajuste GUE mejor que Poisson por factor 7.6
  (`verify_gue_repulsion.py`, 8/8; cadena en
  `verify_iceberg_layers.py`, 5/5).

  Y el fondo del todo: dos construcciones sin ingrediente común —el
  factorial de π y la torre de φ— dan el mismo 1/2, con diferencia
  0.0 a 25 dígitos.  Lo visible es estadística de matrices
  aleatorias; lo que lo sostiene es una coincidencia exacta.
-/





/-! ### Capa 2 — la escala, como función del conductor -/

/-- La escala local de espaciado a altura `T` para conductor `q`.
    Es el inverso de la densidad de `routes:thm-counting`. -/
noncomputable def localScale (q T : ℝ) : ℝ :=
  2 * π / Real.log (q * T / (2 * π))

/-- **LA ESCALA DEPENDE DEL CONDUCTOR.**  Conductores distintos dan
    escalas distintas a la misma altura: la capa 2 está determinada
    por la capa 3, y no al revés. -/
theorem scale_depends_on_conductor {q₁ q₂ T : ℝ}
    (hT : 0 < T) (h₁ : 2 * π / T < q₁) (h₁₂ : q₁ < q₂) :
    localScale q₂ T < localScale q₁ T := by
  have hpi : (0:ℝ) < 2 * π := by positivity
  have h1lt : 2 * π < q₁ * T := (div_lt_iff₀ hT).mp h₁
  have h1log : 1 < q₁ * T / (2 * π) := by rw [lt_div_iff₀ hpi]; linarith
  have hd₁ : 0 < Real.log (q₁ * T / (2 * π)) := Real.log_pos h1log
  have h12lt : q₁ * T < q₂ * T := mul_lt_mul_of_pos_right h₁₂ hT
  have h12log : q₁ * T / (2 * π) < q₂ * T / (2 * π) :=
    div_lt_div_of_pos_right h12lt hpi
  have hmono : Real.log (q₁ * T / (2 * π)) < Real.log (q₂ * T / (2 * π)) :=
    Real.log_lt_log (by linarith [h1log]) h12log
  unfold localScale
  exact div_lt_div_of_pos_left (by positivity) hd₁ hmono

/-! ### Capa 3 — el conductor y sus dos partes -/

/-- **EL CONDUCTOR ES EL PERIODO CONJUNTO.**  La capa 3 está
    determinada por la capa 4: 20 no se elige, es lcm(4,5). -/
theorem conductor_from_periods : Nat.lcm 4 5 = 20 := by decide

/-! ### Capa 4 — los dos periodos, de las dos caras -/

/-- El giro tiene periodo 4 y el pentágono periodo 5: las dos caras
    aportan un periodo cada una. -/
theorem periods_of_the_two_faces :
    (Complex.I) ^ (4 : ℕ) = 1 ∧
    (Complex.exp (2 * Real.pi * Complex.I / 5)) ^ (5 : ℕ) = 1 := by
  refine ⟨I_pow_four, ?_⟩
  rw [← Complex.exp_nat_mul]
  push_cast
  have : (5:ℂ) * (2 * Real.pi * Complex.I / 5) = 2 * Real.pi * Complex.I := by ring
  rw [this, Complex.exp_two_pi_mul_I]

/-! ### Capa 5 — el origen -/

/-- **LA PARTE 5 SALE DE φ.**  ζ₁₀² = ζ₅ y φ = ζ₁₀ + ζ₁₀⁻¹: el
    periodo del pentágono es el del rotor que produce φ por traza.
    La capa 4 está determinada por la capa 5. -/
theorem five_from_phi :
    (Complex.exp (Real.pi * Complex.I / 5)) ^ (2 : ℕ)
      = Complex.exp (2 * Real.pi * Complex.I / 5) ∧
    (Complex.exp (Real.pi * Complex.I / 5))
      + (Complex.exp (Real.pi * Complex.I / 5))⁻¹ = (φ : ℂ) := by
  refine ⟨?_, phi_cyclotomic_inscription⟩
  rw [← Complex.exp_nat_mul]; congr 1; push_cast; ring

/-- **EL ORIGEN: dos construcciones ajenas, un número.**
    El factorial de π y la torre de φ producen el mismo 1/2, sin
    compartir ingrediente.  Es el fondo de la cadena. -/
theorem origin_two_constructions :
    Real.Gamma (3/2) / Real.sqrt π = 1/2 ∧
    (φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = 1/2 ∧
    Real.Gamma (3/2) / Real.sqrt π
      = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) :=
  ⟨mu_from_factorial, mu_from_tower, half_on_both_faces⟩

/-! ### El ensamblaje: la cadena de dependencias -/

/-- **LAS CINCO CAPAS, CON SUS DEPENDENCIAS.**
    De abajo arriba: el origen (dos construcciones, un número) da φ;
    φ por inscripción da el periodo 5; con el periodo 4 del giro dan
    lcm = 20, el conductor; el conductor fija la escala; y en esa
    escala —y sólo en ella— la estadística de los espaciados tiene
    media uno.

    Cada capa condiciona la de arriba: cambiar el conductor cambia
    la escala (`scale_depends_on_conductor`), y con ella la unidad
    de la medición. -/
theorem iceberg_five_layers :
    -- capa 5: el origen
    (Real.Gamma (3/2) / Real.sqrt π
       = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ))) ∧
    -- capa 5 → 4: el 5 sale de φ
    ((Complex.exp (Real.pi * Complex.I / 5))
       + (Complex.exp (Real.pi * Complex.I / 5))⁻¹ = (φ : ℂ)) ∧
    -- capa 4: los dos periodos
    ((Complex.I) ^ (4 : ℕ) = 1) ∧
    -- capa 4 → 3: el conductor es su lcm
    (Nat.lcm 4 5 = 20) ∧
    -- capa 3 → 2: la escala depende del conductor
    (∀ q₁ q₂ T : ℝ, 0 < T → 2 * π / T < q₁ → q₁ < q₂ →
        localScale q₂ T < localScale q₁ T) :=
  ⟨half_on_both_faces, phi_cyclotomic_inscription, I_pow_four,
   conductor_from_periods,
   fun _ _ _ hT h₁ h₁₂ => scale_depends_on_conductor hT h₁ h₁₂⟩


