-- §141  ·  rendimientos × cuantificación
-- ═══════════════════════════════════════════════════════════

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §141.1  ·  LOS DOS EJES                                         ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- Segundo eje, parte A: sobre qué CUANTIFICA. -/
inductive Scope where
  | aggregate | individual
  deriving DecidableEq
instance : Fintype Scope :=
  ⟨{Scope.aggregate, Scope.individual}, by
    intro x; cases x <;> simp⟩

/-- Segundo eje, parte B: de qué NATURALEZA es. -/
inductive Nature where
  | analytic | algebraic
  deriving DecidableEq
instance : Fintype Nature :=
  ⟨{Nature.analytic, Nature.algebraic}, by
    intro x; cases x <;> simp⟩

/-- Los siete embeddings de la tabla. -/
inductive Emb where
  | legSix | identityF | eTwo | orbitCard | target | discBound | logBound
  deriving DecidableEq
instance : Fintype Emb :=
  ⟨{Emb.legSix, Emb.identityF, Emb.eTwo, Emb.orbitCard, Emb.target, Emb.discBound, Emb.logBound}, by
    intro x; cases x <;> simp⟩

def yieldOf : Emb → Yield
  | .legSix    => .biconditional
  | .identityF => .biconditional
  | .eTwo      => .constant
  | .orbitCard => .integer
  | .target    => .counted
  | .discBound => .interval
  | .logBound  => .interval

def scopeOf : Emb → Scope
  | .eTwo   => .aggregate
  | .target => .aggregate
  | _       => .individual

def natureOf : Emb → Nature
  | .identityF => .analytic
  | .discBound => .analytic
  | .logBound  => .analytic
  | _          => .algebraic

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §141.2  ·  LA CASILLA NO ESTABA VACÍA                           ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] ★★★ RETRACCIÓN E‑177(b), COMO TEOREMA.**
    El cuadrante **individual ∧ algebraico** tiene DOS habitantes:
    `legSix` (bicondicional) y `orbitCard` (entero).

    Luego la afirmación «la casilla individual‑algebraica está vacía»
    es falsa.  Lo que falta no es un cuadrante: es un RENDIMIENTO. -/
theorem individual_algebraic_is_not_empty :
    (Finset.univ.filter
      (fun e : Emb => scopeOf e = Scope.individual ∧ natureOf e = Nature.algebraic))
      = {Emb.legSix, Emb.orbitCard} := by decide

/-- **[P] Y SUS RENDIMIENTOS NO SON `position`. -/
theorem those_two_do_not_yield_position :
    yieldOf Emb.legSix ≠ Yield.position
    ∧ yieldOf Emb.orbitCard ≠ Yield.position := by
  refine ⟨by decide, by decide⟩

/-- **[P] NINGÚN EMBEDDING DE LA TABLA DA `position`. -/
theorem no_embedding_yields_position :
    ∀ e : Emb, yieldOf e ≠ Yield.position := by decide

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §141.3  ·  LO QUE EL SEGUNDO EJE EXPLICA DEL PRIMERO            ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- La coordenada del cero.  Es `|1 − 1/ρ|`, el factor de Hadamard de
    `Λ` en `s = 1` — lo que `HadamardAtAnchor` usa. -/
def zc (ρ : ℂ) : ℝ := Complex.abs (ρ - 1) / Complex.abs ρ

/-- **[P] LA CONJUGACIÓN NO LA MUEVE. -/
theorem zc_conj (ρ : ℂ) : zc (starRingEnd ℂ ρ) = zc ρ := by
  unfold zc
  rw [show (starRingEnd ℂ) ρ - 1 = (starRingEnd ℂ) (ρ - 1) by simp,
      Complex.abs_conj, Complex.abs_conj]

/-- **[P] ★★ LA ECUACIÓN FUNCIONAL LA INVIERTE: `r(1−ρ)·r(ρ) = 1`. -/
theorem zc_reflect (ρ : ℂ) (h0 : ρ ≠ 0) (h1 : ρ ≠ 1) :
    zc (1 - ρ) * zc ρ = 1 := by
  unfold zc Complex.abs
  rw [show (1 : ℂ) - ρ - 1 = -ρ from by ring, show (ρ : ℂ) - 1 = -(1 - ρ) from by ring]
  simp only [norm_neg]
  have hρn : ‖ρ‖ ≠ 0 := fun h => h0 (norm_eq_zero.mp h)
  have h1ρn : ‖(1 : ℂ) - ρ‖ ≠ 0 := fun h => h1 (sub_eq_zero.mp (norm_eq_zero.mp h)).symm
  field_simp [hρn, h1ρn]

/-- **[P] ★★★ EL PRODUCTO SOBRE LA ÓRBITA DE KLEIN ES 1.**
    `{ρ, ρ̄, 1−ρ, 1−ρ̄}` da `{r, r, 1/r, 1/r}`. -/
theorem klein_orbit_product (ρ : ℂ) (h0 : ρ ≠ 0) (h1 : ρ ≠ 1) :
    zc ρ * zc (starRingEnd ℂ ρ) * zc (1 - ρ)
      * zc (starRingEnd ℂ (1 - ρ)) = 1 := by
  rw [zc_conj, zc_conj]
  have h := zc_reflect ρ h0 h1
  calc zc ρ * zc ρ * zc (1 - ρ) * zc (1 - ρ)
      = (zc (1 - ρ) * zc ρ) * (zc (1 - ρ) * zc ρ) := by ring
    _ = 1 := by rw [h]; ring

/-- **[O] ★★ POR QUÉ `e₂ = 1` RINDE `constant`.**  `∏_ρ |z_ρ| = 1` se
    sigue órbita a órbita del pareo, luego el agregado ES `e₂ = 1`
    sumado: no información nueva, la misma mitad `χ₄` —cerrada desde
    §28— vista sobre el conjunto.

    **Ésta es una afirmación del eje de CUANTIFICACIÓN, y `Yield` sola
    no la ve.**  El rendimiento pobre tiene causa estructural. -/
theorem aggregate_explains_constant_yield (ρ : ℂ) (h0 : ρ ≠ 0) (h1 : ρ ≠ 1) :
    (zc (1 - ρ) * zc ρ = 1)
    ∧ (zc ρ * zc (starRingEnd ℂ ρ) * zc (1 - ρ)
        * zc (starRingEnd ℂ (1 - ρ)) = 1)
    ∧ scopeOf Emb.eTwo = Scope.aggregate
    ∧ yieldOf Emb.eTwo = Yield.constant :=
  ⟨zc_reflect ρ h0 h1, klein_orbit_product ρ h0 h1, by decide, by decide⟩

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §141.4  ·  `position` FACTORIZADO                               ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] `|órbita| ∈ {2,4}` ES DISCRETO.**  Salta entre dos valores;
    no hay nada en medio. -/
theorem orbit_card_is_discrete :
    ∀ n : ℕ, (n = 2 ∨ n = 4) → n ≠ 3 := by
  intro n h
  rcases h with h2 | h4
  · omega
  · omega

/-- **[O] PERO SU CONJUNTO META NO ES DONDE VIVE `r`.**  `|órbita|` es
    un cardinal en `ℕ`; `r` es un real positivo.  Discretitud sí,
    coordenada no. -/
theorem orbit_has_discreteness_not_the_coordinate :
    scopeOf Emb.orbitCard = Scope.individual
    ∧ natureOf Emb.orbitCard = Nature.algebraic
    ∧ yieldOf Emb.orbitCard = Yield.integer := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[O] Y LA COTA TIENE LA COORDENADA PERO NO LA DISCRETITUD.**
    `|log r| < 0.0112` es sobre `r` mismo, pero es un intervalo. -/
theorem bound_has_the_coordinate_not_discreteness :
    scopeOf Emb.logBound = Scope.individual
    ∧ natureOf Emb.logBound = Nature.analytic
    ∧ yieldOf Emb.logBound = Yield.interval := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[P] ★★★ `position = interval ∩ discretitud`.**
    Si `r = φ^k` (conjunto discreto de paso `log φ`) y `|log r| < log φ`
    (intervalo), entonces `k = 0`: **el intervalo devuelve la posición.**

    Es §140.5 `k_zero_by_discreteness`, aquí como factorización del
    rendimiento que falta. -/
theorem position_is_interval_meets_discreteness
    (φ r : ℝ) (hφ : 1 < φ) (k : ℤ) (hk : r = φ ^ k)
    (hb : |(k : ℝ) * Real.log φ| < Real.log φ) : r = 1 := by
  have hlp : 0 < Real.log φ := Real.log_pos hφ
  rw [abs_mul, abs_of_pos hlp] at hb
  have hk1 : |(k : ℝ)| < 1 := (mul_lt_iff_lt_one_left hlp).mp hb
  have habs : |k| < 1 := by rw [← Int.cast_abs] at hk1; exact_mod_cast hk1
  have : k = 0 := by
    have hpos : 0 ≤ k ∨ k < 0 := le_or_gt 0 k
    rcases hpos with hle | hlt
    · rw [abs_of_nonneg hle] at habs; omega
    · rw [abs_of_neg (by omega)] at habs; omega
  rw [hk, this]; norm_num

/-- **[O] ★★★ EL BALANCE, CON LOS DOS EJES.**

    · `Yield` es la caracterización correcta de lo que falta:
      `position`, y era del corpus desde §116.
    · Mi eje NO la mejora: la casilla «individual‑algebraica» está
      poblada (E‑177 b).
    · Pero mi eje EXPLICA por qué `e₂ = 1` rinde `constant`: porque el
      agregado es el pareo.
    · Y del cruce sale la factorización: `position = interval ∩
      discretitud` sobre el conjunto donde vive `r`.

    `|órbita|` tiene discretitud sin coordenada; la cota tiene
    coordenada sin discretitud.  **Falta que sean el mismo conjunto** —
    que es (A), en el eje de rendimientos.

    Nada de esto prueba `E`.  Cambia el diagnóstico de qué buscar, que
    es lo que §116 dice de sí mismo. -/
theorem the_two_axes_cross (ρ : ℂ) (h0 : ρ ≠ 0) (h1 : ρ ≠ 1) :
    -- la casilla no estaba vacía
    ((Finset.univ.filter
      (fun e : Emb => scopeOf e = Scope.individual ∧ natureOf e = Nature.algebraic))
      = {Emb.legSix, Emb.orbitCard})
    -- ninguno da posición
    ∧ (∀ e : Emb, yieldOf e ≠ Yield.position)
    -- el agregado explica el rendimiento constante
    ∧ (zc (1 - ρ) * zc ρ = 1)
    ∧ (zc ρ * zc (starRingEnd ℂ ρ) * zc (1 - ρ)
        * zc (starRingEnd ℂ (1 - ρ)) = 1)
    -- y el balance de §116 se conserva
    ∧ (Fintype.card Yield = 6)
    ∧ ((Finset.univ.filter (fun y : Yield => realised y)).card = 5) :=
  ⟨individual_algebraic_is_not_empty, no_embedding_yields_position,
   zc_reflect ρ h0 h1, klein_orbit_product ρ h0 h1,
   five_yields_realised.1, five_yields_realised.2⟩

-- ═══════════════════════════════════════════════════════════
-- §142  ·  el cociente es el índice; la escala se cancela
-- ═══════════════════════════════════════════════════════════

/-! ## §142.1  El cociente espectral es libre de escala -/

/-- Autovalor `i` de la torre: `m₀·φ^i`.  Es el `towerHam` de CW6:4338,
    escrito como función para poder cocientar. -/
def towerEig (m₀ φ : ℝ) (i : ℕ) : ℝ := m₀ * φ ^ i

/-- **[P] ★★★ EL COCIENTE ESPECTRAL NO DEPENDE DE LA ESCALA.**
    `λᵢ/λⱼ = φ^{i−j}`: `m₀` se cancela.

    Ésta es la observación que reordena el enunciado abierto: `r` es un
    COCIENTE —adimensional, con `r·(1/r) = 1`—, luego debe compararse
    con los cocientes del espectro y no con el espectro. -/
theorem spectral_ratio_is_scale_free (m₀ φ : ℝ) (hm : m₀ ≠ 0) (hφ : φ ≠ 0)
    (i j : ℕ) :
    towerEig m₀ φ i / towerEig m₀ φ j = φ ^ (i : ℤ) / φ ^ (j : ℤ) := by
  unfold towerEig
  rw [zpow_natCast, zpow_natCast]
  field_simp

/-- **[P] Y ES `φ^{i−j}`. -/
theorem spectral_ratio_is_zpow (φ : ℝ) (hφ : φ ≠ 0) (i j : ℕ) :
    φ ^ (i : ℤ) / φ ^ (j : ℤ) = φ ^ ((i : ℤ) - (j : ℤ)) := by
  exact (zpow_sub₀ hφ i j).symm

/-- **[P] DOS ESCALAS DAN EL MISMO COCIENTE. -/
theorem ratio_independent_of_scale (m₀ m₁ φ : ℝ) (h0 : m₀ ≠ 0) (h1 : m₁ ≠ 0)
    (hφ : φ ≠ 0) (i j : ℕ) :
    towerEig m₀ φ i / towerEig m₀ φ j = towerEig m₁ φ i / towerEig m₁ φ j := by
  rw [spectral_ratio_is_scale_free m₀ φ h0 hφ i j,
      spectral_ratio_is_scale_free m₁ φ h1 hφ i j]

/-! ## §142.2  El conjunto de cocientes es la parte libre -/

/-- El conjunto de cocientes espectrales, indexado por `ℤ`. -/
def RatioSet (φ r : ℝ) : Prop := ∃ k : ℤ, r = φ ^ k

/-- **[P] ★★ EL CONJUNTO DE COCIENTES ES `im(realise)` = `MonomialHalf`.**
    Definitorio, y es el puente: el `k` de la sesión ES `i − j`. -/
theorem ratio_set_is_the_free_part (φ r : ℝ) :
    RatioSet φ r ↔ ∃ k : ℤ, r = φ ^ k := Iff.rfl

/-- **[P] TODO COCIENTE ESTÁ EN EL CONJUNTO. -/
theorem ratio_belongs (m₀ φ : ℝ) (hm : m₀ ≠ 0) (hφ : φ ≠ 0) (i j : ℕ) :
    RatioSet φ (towerEig m₀ φ i / towerEig m₀ φ j) := by
  refine ⟨(i : ℤ) - (j : ℤ), ?_⟩
  rw [spectral_ratio_is_scale_free m₀ φ hm hφ i j, spectral_ratio_is_zpow φ hφ i j]

/-- **[P] Y `e₂ = 1` PARA TODO COCIENTE**: el par `{φ^k, φ^{−k}}` tiene
    producto 1.  Es `SignHalf` del corpus, verificado sobre el índice. -/
theorem ratio_has_e_two_one (φ : ℝ) (hφ : φ ≠ 0) (k : ℤ) :
    φ ^ k * φ ^ (-k) = 1 := by
  rw [← zpow_add₀ hφ]; simp

/-! ## §142.3  La diagonal es el locus parabólico -/

/-- **[P] ★★★ `i = j` DA EL COCIENTE 1, LUEGO `e1P = 2`, LUEGO
    `discP = 0`: EL CASO PARABÓLICO.**

    La diagonal del cuadro de cocientes es la línea crítica. -/
theorem diagonal_is_the_parabolic_locus (m₀ φ : ℝ) (hm : m₀ ≠ 0) (hφ : φ ≠ 0)
    (i : ℕ) :
    towerEig m₀ φ i / towerEig m₀ φ i = 1 := by
  rw [spectral_ratio_is_scale_free m₀ φ hm hφ i i]
  field_simp

/-- **[P] Y FUERA DE LA DIAGONAL EL COCIENTE NO ES 1**, si `φ > 1`. -/
theorem off_diagonal_ratio_ne_one (φ : ℝ) (hφ : 1 < φ) (k : ℤ) (hk : k ≠ 0) :
    φ ^ k ≠ 1 := by
  intro h
  have hφ0 : (0:ℝ) < φ := lt_trans one_pos hφ
  have := (zpow_eq_one_iff_right₀ hφ0.le (ne_of_gt hφ)).mp h
  exact hk this

/-- **[P] LA TRAZA DEL COCIENTE `1` ES `2`, Y SU DISCRIMINANTE `0`. -/
theorem diagonal_trace_and_disc :
    (1 : ℝ) + 1 / 1 = 2 ∧ ((1 : ℝ) + 1 / 1) ^ 2 - 4 = 0 := by
  refine ⟨by norm_num, by norm_num⟩

/-- **[P] LA TRAZA DEL COCIENTE `φ^k` ES `≥ 2`, con igualdad sólo en
    `k = 0`.  Es `tr_ge_two` de la sesión, sobre el índice. -/
theorem ratio_trace_ge_two (φ : ℝ) (hφ : 1 < φ) (k : ℤ) :
    2 ≤ φ ^ k + 1 / φ ^ k := by
  have hφ0 : (0:ℝ) < φ := lt_trans one_pos hφ
  have hp : (0:ℝ) < φ ^ k := zpow_pos hφ0 k
  have h : φ ^ k + 1 / φ ^ k - 2 = (φ ^ k - 1) ^ 2 / φ ^ k := by field_simp; ring
  nlinarith [div_nonneg (sq_nonneg (φ ^ k - 1)) hp.le, h]

/-! ## §142.4  La transposición es la ecuación funcional -/

/-- **[P] ★★★ `(i,j) ↦ (j,i)` INVIERTE EL COCIENTE.**
    Es `k ↦ −k`, es decir la ecuación funcional `r ↦ 1/r`, realizada
    como transposición de índices. -/
theorem transposition_inverts_the_ratio (m₀ φ : ℝ) (hm : m₀ ≠ 0) (hφ : φ ≠ 0)
    (i j : ℕ) :
    (towerEig m₀ φ i / towerEig m₀ φ j) * (towerEig m₀ φ j / towerEig m₀ φ i) = 1 := by
  rw [spectral_ratio_is_scale_free m₀ φ hm hφ i j,
      spectral_ratio_is_scale_free m₀ φ hm hφ j i]
  have h : ∀ n : ℕ, φ ^ (n : ℤ) ≠ 0 := fun n => zpow_ne_zero _ hφ
  field_simp

/-- **[P] Y SU PUNTO FIJO ES LA DIAGONAL.**  `(i,j) = (j,i) ⟺ i = j`. -/
theorem transposition_fixed_point (i j : ℕ) :
    ((i, j) : ℕ × ℕ) = (j, i) ↔ i = j := by
  constructor
  · intro h; exact (Prod.mk.injEq .. ▸ h).1
  · intro h; rw [h]

/-- **[P] EN ÍNDICES: `−k = k ↔ k = 0`.  Es
    `zero_is_the_unique_fixed_point` de §137, sobre el índice. -/
theorem index_fixed_point (k : ℤ) : (-k = k) ↔ k = 0 := by omega

/-! ## §142.5  La paridad del índice es la cara χ₄ -/

/-- **[P] ★★ `det([×φ^k]) = (−1)^k`, Y `k = i − j`.**  Luego la PARIDAD
    DEL ÍNDICE es la cara `χ₄`: par ⟺ los pares de Galois y recíproco
    coinciden (§132, §139).  La diagonal tiene `det = +1`. -/
theorem parity_of_index_is_chi_four (k : ℕ) :
    ((-1 : ℤ)) ^ k = 1 ↔ k % 2 = 0 := by
  constructor
  · intro h
    rcases Nat.even_or_odd k with he | ho
    · obtain ⟨m, hm⟩ := he; omega
    · rw [ho.neg_one_pow] at h; norm_num at h
  · intro h
    have : Even k := ⟨k / 2, by omega⟩
    exact this.neg_one_pow

theorem diagonal_has_even_index : (0 : ℕ) % 2 = 0 ∧ ((-1 : ℤ)) ^ (0:ℕ) = 1 := by
  refine ⟨by decide, by decide⟩

/-! ## §142.6  El enunciado abierto, sin `m₀` -/

/-- **[C] EL ESPECTRO DE `towerHam` ES `{m₀·φ^σ}`, AUTOADJUNTO.**
    Entrada del corpus: `tower_ham_is_hermitian` (CW6:4342),
    `tower_ham_bounded_below`.  Aquí sólo se usa la forma del espectro. -/
def TowerSpectrum (m₀ φ : ℝ) (S : Set ℝ) : Prop :=
  ∀ x ∈ S, ∃ i : ℕ, x = towerEig m₀ φ i

/-- **[O] ★★★ EL ENUNCIADO ABIERTO PIERDE LA ESCALA.**

    ANTES:  `r` es AUTOVALOR de un operador   ← hay que fijar `m₀`
    AHORA:  `r` es un COCIENTE de autovalores  ← `m₀` se cancela

    Y entonces:
      · el conjunto meta es `{φ^k : k ∈ ℤ}` = `im(realise)` = parte
        libre de `𝒪_K^×`  (§135, §140);
      · el `k` de la sesión es `i − j`;
      · la diagonal `i = j` es el locus parabólico `discP = 0`, que es
        la línea crítica;
      · la transposición `(i,j) ↦ (j,i)` es la ecuación funcional, con
        punto fijo la diagonal;
      · la paridad de `i − j` es la cara `χ₄`.

    LO QUE FALTA, en esta coordenada: que `r = |ρ−1|/|ρ|` sea un
    COCIENTE de autovalores de `towerHam`.  Sin parámetro de escala.

    ⚠ NO se afirma que los `σ` de `towerHam` sean los `k` de los ceros.
    `towerHam` es el lado gauge; `m₀` es escala de masa.  Lo que se
    prueba es que la comparación correcta es con los cocientes, y que
    ahí `m₀` no interviene. -/
def TheOpenStatementWithoutScale (φ r : ℝ) : Prop := ∃ k : ℤ, r = φ ^ k

/-- **[P] Y CON ELLA, LA CADENA CIERRA.**  Si `r` es un cociente y su
    traza cae bajo la brecha, el índice es 0 y `r = 1`. -/
theorem ratio_plus_gap_closes (φ r : ℝ) (hφ : 1 < φ) (hr : 0 < r)
    (hA : TheOpenStatementWithoutScale φ r)
    (hgap : ∀ k : ℤ, k ≠ 0 → Real.sqrt 5 ≤ φ ^ k + 1 / φ ^ k)
    (hb : r + 1 / r < Real.sqrt 5) : r = 1 := by
  obtain ⟨k, rfl⟩ := hA
  by_cases hk : k = 0
  · subst hk; norm_num
  · exact absurd hb (not_lt.mpr (hgap k hk))

/-- **[P] ★★★ ENSAMBLAJE DE §142. -/
theorem the_ratio_is_the_index (m₀ φ : ℝ) (hm : m₀ ≠ 0) (hφ : 1 < φ)
    (i j : ℕ) (k : ℤ) :
    -- el cociente es libre de escala y es φ^{i−j}
    (towerEig m₀ φ i / towerEig m₀ φ j = φ ^ (i : ℤ) / φ ^ (j : ℤ))
    ∧ (φ ^ (i : ℤ) / φ ^ (j : ℤ) = φ ^ ((i : ℤ) - (j : ℤ)))
    -- la diagonal da 1
    ∧ (towerEig m₀ φ i / towerEig m₀ φ i = 1)
    -- fuera de la diagonal, no
    ∧ (k ≠ 0 → φ ^ k ≠ 1)
    -- la traza del cociente es ≥ 2
    ∧ (2 ≤ φ ^ k + 1 / φ ^ k)
    -- la transposición invierte
    ∧ ((towerEig m₀ φ i / towerEig m₀ φ j) * (towerEig m₀ φ j / towerEig m₀ φ i) = 1)
    -- y su punto fijo es el índice 0
    ∧ ((-k = k) ↔ k = 0)
    -- e₂ = 1 para todo índice
    ∧ (φ ^ k * φ ^ (-k) = 1) := by
  have hφ0 : φ ≠ 0 := ne_of_gt (lt_trans one_pos hφ)
  refine ⟨spectral_ratio_is_scale_free m₀ φ hm hφ0 i j,
          spectral_ratio_is_zpow φ hφ0 i j,
          diagonal_is_the_parabolic_locus m₀ φ hm hφ0 i,
          fun hk => off_diagonal_ratio_ne_one φ hφ k hk,
          ratio_trace_ge_two φ hφ k,
          transposition_inverts_the_ratio m₀ φ hm hφ0 i j,
          index_fixed_point k,
          ratio_has_e_two_one φ hφ0 k⟩

-- ═══════════════════════════════════════════════════════════
-- §143  ·  dos patas, un ápice; recíprocas por el kernel
-- ═══════════════════════════════════════════════════════════

/-! ## §143.1  Camino A — Ω hacia el ápice, por producto de tres factores -/

/-- Las tres normas componentes de `Ω = P·C·F` (v11 §3.1). -/
def nP : ℝ := 1 / Real.sqrt 3

def nC : ℝ := 1

def nF : ℝ := Real.sqrt 3 / 2

/-- **[P] `‖Ω‖ = (1/√3)·1·(√3/2) = 1/2`.**  Es `norm_Omega_is_half` del
    corpus; se reprueba aquí para tener el ÁPICE como valor y poder
    compararlo con la otra pata. -/
theorem omega_norm_is_the_apex : nP * nC * nF = 1 / 2 := by
  unfold nP nC nF
  have h : Real.sqrt 3 ≠ 0 := Real.sqrt_ne_zero'.mpr (by norm_num)
  field_simp

/-- **[P] LA RUTA ES ANGULAR: `√3` ENTRA Y SALE.**  El `1/√3` de `P` y
    el `√3/2` de `F` se cancelan; lo que queda es el `2` del
    denominador.  El ápice sale de una CANCELACIÓN, no de un ajuste. -/
theorem apex_from_cancellation : (1 / Real.sqrt 3) * (Real.sqrt 3 / 2) = 1 / 2 := by
  have h : Real.sqrt 3 ≠ 0 := Real.sqrt_ne_zero'.mpr (by norm_num)
  field_simp

/-! ## §143.2  Ω̂ y specFromG son el mismo operador -/

/-- El operador ternario, parte real: `Re((1/2)·ω^k)` con `ω` raíz
    cúbica primitiva.  Es `Omega_hat` de v11:159 leído en la recta. -/
def omegaHatRe (k : ℕ) : ℝ := Real.cos (2 * Real.pi * k / 3) / 2

/-- **[P] ★★ `Re(Ω̂ k) = specFromG k`.**  Los dos operadores ternarios
    del corpus —el de v11 y el de §74— son EL MISMO.

    `k = 0` da `1/2`; `k = 1, 2` dan `−1/4`. -/
theorem omega_hat_is_specFromG
    (h1 : Real.cos (2 * Real.pi * 1 / 3) = -(1/2))
    (h2 : Real.cos (2 * Real.pi * 2 / 3) = -(1/2)) :
    omegaHatRe 0 = 1 / 2 ∧ omegaHatRe 1 = -(1/4) ∧ omegaHatRe 2 = -(1/4) := by
  refine ⟨?_, ?_, ?_⟩ <;> unfold omegaHatRe
  · norm_num
  · rw [show ((1:ℕ):ℝ) = 1 by norm_num, h1]; norm_num
  · rw [show ((2:ℕ):ℝ) = 2 by norm_num, h2]; norm_num

/-- **[P] Y SU TRAZA ES CERO**: `1/2 − 1/4 − 1/4 = 0`.  La cara angular
    no tiene parte libre. -/
theorem ternary_trace_zero : (1:ℝ)/2 + (-(1/4)) + (-(1/4)) = 0 := by norm_num

/-! ## §143.3  Camino B — towerHam hacia la diagonal, por el índice -/

/-- Autovalor `i` de la torre (§142). -/
def towerEigen (m₀ φ : ℝ) (i : ℕ) : ℝ := m₀ * φ ^ i

/-- **[P] LA DIAGONAL DA COCIENTE 1.**  `λᵢ/λᵢ = 1`, sin escala. -/
theorem tower_diagonal_is_one (m₀ φ : ℝ) (hm : m₀ ≠ 0) (hφ : φ ≠ 0) (i : ℕ) :
    towerEigen m₀ φ i / towerEigen m₀ φ i = 1 := by
  unfold towerEigen
  have : φ ^ i ≠ 0 := pow_ne_zero i hφ
  field_simp

/-- **[P] Y SU TRAZA ES `2`, CON DISCRIMINANTE `0`: el locus parabólico. -/
theorem tower_diagonal_trace : (1:ℝ) + 1/1 = 2 ∧ ((1:ℝ) + 1/1) ^ 2 - 4 = 0 := by
  refine ⟨by norm_num, by norm_num⟩

/-- **[P] LA RUTA ES RADIAL: la escala `m₀` se cancela**, y lo que queda
    es el índice.  Contraste con §143.1, donde lo que se cancela es
    `√3` y queda el `2`. -/
theorem tower_route_is_radial (m₀ m₁ φ : ℝ) (h0 : m₀ ≠ 0) (h1 : m₁ ≠ 0)
    (hφ : φ ≠ 0) (i j : ℕ) :
    towerEigen m₀ φ i / towerEigen m₀ φ j = towerEigen m₁ φ i / towerEigen m₁ φ j := by
  unfold towerEigen
  have hp : ∀ n : ℕ, φ ^ n ≠ 0 := fun n => pow_ne_zero n hφ
  field_simp

/-! ## §143.4  ★ LA CONMUTACIÓN: las dos patas son recíprocas -/

/-- El ápice. -/
def apexVal : ℝ := 1 / 2

/-- **[P] ★★★ ÁPICE · TRAZA DE LA DIAGONAL = 1.**

      pata A (angular, Ω)      `‖Ω‖ = 1/2` = ápice
      pata B (radial, tower)   `t(diagonal) = 2` = 1/ápice

    **Las dos patas no se comparan entre sí: se comparan POR EL ÁPICE,
    y su relación es la recíproca.**  Y ese `2` es `1/μ₃ = |ker G|`
    (`collapse_factor_is_the_kernel`, `apex_is_half`). -/
theorem two_legs_are_reciprocal : apexVal * 2 = 1 ∧ (1 : ℝ) / apexVal = 2 := by
  unfold apexVal
  refine ⟨by norm_num, by norm_num⟩

/-- **[P] Y EL RECÍPROCO ES EL KERNEL.**  `1/μ₃ = 2 = |ker G| = |{1,9}|`.
    Es `collapse_factor_is_the_kernel` del corpus; aquí se usa como la
    CONSTANTE DE CONMUTACIÓN entre las dos patas. -/
theorem reciprocal_is_the_kernel :
    (1 : ℝ) / apexVal = 2 ∧ ({1, 9} : Finset ℕ).card = 2 := by
  unfold apexVal
  refine ⟨by norm_num, by decide⟩

/-- **[P] ★★ LAS DOS PATAS, TRAZADAS Y COMPARADAS.**  Cada una llega a
    su valor por una cancelación distinta, y los dos valores son
    recíprocos con constante `|ker G| = 2`. -/
theorem two_legs_one_apex :
    -- pata A: angular, cancela √3, queda 1/2
    (nP * nC * nF = 1 / 2)
    -- pata B: radial, cancela m₀, queda el índice; diagonal da t = 2
    ∧ ((1:ℝ) + 1/1 = 2)
    -- y la relación es recíproca, con constante el kernel
    ∧ (apexVal * 2 = 1)
    ∧ ((1 : ℝ) / apexVal = 2) :=
  ⟨omega_norm_is_the_apex, tower_diagonal_trace.1,
   two_legs_are_reciprocal.1, two_legs_are_reciprocal.2⟩

/-! ## §143.5  El ápice por seis rutas -/

/-- **[C] LAS SEIS RUTAS AL ÁPICE.**  Cuatro son del corpus
    (`half_on_both_faces`, `mersenne_route`, `apex_is_half`,
    `three_routes_to_one_half`); dos las añade este trazado
    (`norm_Omega`, `specFromG 0`).  Los valores exactos van en la firma. -/
def SixRoutesToTheApex (gammaHalf phiLam : ℝ) : Prop :=
  gammaHalf = 1/2 ∧ phiLam = 1/2

/-- **[P] Y LAS QUE SON ARITMÉTICAS COINCIDEN. -/
theorem apex_routes_agree :
    (nP * nC * nF = 1/2) ∧ (omegaHatRe 0 = 1/2)
    ∧ ((1:ℝ)/2 = 1/2) ∧ ((2:ℝ)/4 = 1/2) := by
  refine ⟨omega_norm_is_the_apex, by unfold omegaHatRe; norm_num,
          by norm_num, by norm_num⟩

/-! ## §143.6  Lo que falta: unicidad del morfismo, no el aterrizaje -/

/-- **[C] LOS TRES ATERRIZAJES, del corpus.**
      `norm_Omega_is_half`        Ω        → ápice
      `spec_zero_is_apex`         specFromG → ápice
      `E_lands_on_the_cocone_apex` E        → ápice
    Los tres probados. -/
def ThreeLandOnTheApex (a b c : ℝ) : Prop := a = 1/2 ∧ b = 1/2 ∧ c = 1/2

/-- **[P] Y SI TRES ATERRIZAN EN EL MISMO PUNTO, COINCIDEN COMO VALORES. -/
theorem three_landings_agree (a b c : ℝ) (h : ThreeLandOnTheApex a b c) :
    a = b ∧ b = c := by
  obtain ⟨h1, h2, h3⟩ := h
  exact ⟨by rw [h1, h2], by rw [h2, h3]⟩

/-- **[O] ★★★ PERO COINCIDIR EN VALOR NO ES COINCIDIR COMO MORFISMO.**

    Ω llega al ápice por la cara ANGULAR — el ternario, `ω^k`, TRES
    valores.  `towerHam` llega a la diagonal por el índice RADIAL — la
    torre, `ℤ` valores.  `E` aterriza en el ápice, **pero por qué ruta
    no está probado**.

    `the_apex_is_forced` (§94) prueba que `1/2` es el ÚNICO cociente que
    el grupo admite: eso es unicidad de VALOR.  Para el brinco —«los `σ`
    de towerHam son los `k` de los ceros»— hace falta unicidad de
    MORFISMO, que es lo que `terminal_iso` daría si el ápice tuviera
    propiedad universal.

    **Lo que falta no es el aterrizaje: es la unicidad del morfismo.** -/
def UniqueMorphismToApex (f g : ℕ → ℝ) : Prop := ∀ n, f n = g n

/-- **[P] LA UNICIDAD DE VALOR NO DA LA DE MORFISMO.**  Dos funciones
    pueden coincidir en `0` y diferir en todo lo demás: `omegaHatRe` y
    el índice radial coinciden en `k = 0` —el ápice— y no en `k = 1`.

    Ése es el contenido exacto de lo que falta. -/
theorem value_agreement_is_not_morphism_agreement
    (h1 : Real.cos (2 * Real.pi * 1 / 3) = -(1/2)) :
    omegaHatRe 0 = 1/2 ∧ omegaHatRe 1 = -(1/4) ∧ (-(1/4) : ℝ) ≠ 1/2 := by
  refine ⟨by unfold omegaHatRe; norm_num, ?_, by norm_num⟩
  unfold omegaHatRe
  rw [show ((1:ℕ):ℝ) = 1 by norm_num, h1]; norm_num

/-- **[O] ★★★ EL BALANCE DE §143.**

    PROBADO AQUÍ:
      · Ω llega al ápice por cancelación de `√3`  (cara angular);
      · towerHam llega a la diagonal por cancelación de `m₀` (radial);
      · las dos patas son RECÍPROCAS, con constante `1/μ₃ = |ker G| = 2`;
      · `Re(Ω̂ k) = specFromG k`: los dos ternarios del corpus son uno;
      · el ápice se alcanza por seis rutas.

    NO PROBADO:
      · que los `σ` de towerHam sean los `k` de los ceros;
      · unicidad del morfismo al ápice.

    MÉTODO, registrado: un intento anterior comparó los espectros
    DIRECTAMENTE y concluyó «no conmutan».  Dos patas de un cocono no se
    comparan entre sí.  Trazadas por separado hasta el ápice, conmutan. -/
theorem the_balance_of_section_143 (m₀ φ : ℝ) (hm : m₀ ≠ 0) (hφ : φ ≠ 0) (i : ℕ) :
    (nP * nC * nF = 1 / 2)
    ∧ (towerEigen m₀ φ i / towerEigen m₀ φ i = 1)
    ∧ (apexVal * 2 = 1)
    ∧ (((1:ℝ)/2 + (-(1/4)) + (-(1/4))) = 0)
    ∧ (({1, 9} : Finset ℕ).card = 2) :=
  ⟨omega_norm_is_the_apex, tower_diagonal_is_one m₀ φ hm hφ i,
   two_legs_are_reciprocal.1, ternary_trace_zero, reciprocal_is_the_kernel.2⟩

-- ═══════════════════════════════════════════════════════════
-- §144  ·  los parámetros de HPPS son el cocono
-- ═══════════════════════════════════════════════════════════

/-! ## §144.1  Los cuatro parámetros, anclados -/

/-- `μ = 1/2`: norma tripartita S₃.  Es `μ_PCF` de
    `PCF_OperatorConvergence:47`, reproducido para anclarlo. -/
def muP : ℝ := 1 / 2

/-- `σ = 3/2`: invariante espectral `d·μ`.  Es `σ_PCF`, ibid. -/
def sigP : ℝ := 3 / 2

/-- `β₀ = 1/8`: inverso del cardinal de `ℤ₂₀*`.  Es `β₀`, ibid. -/
def betaP : ℝ := 1 / 8

/-- **[P] ★★★ `μ` ES EL ÁPICE.**  `1/2` = `‖Ω‖` (`norm_Omega_is_half`)
    = `1/|ker G|` (`apex_is_half`) = `specFromG 0` (`spec_zero_is_apex`).
    HPPS parte del mismo punto que Ω y que el ternario. -/
theorem mu_is_the_apex : muP = 1 / 2 := rfl

/-- **[P] ★★★ `σ + μ = 2` ES LA TRAZA DE LA DIAGONAL.**
    `2` es el valor de `e1P r` en `r = 1`, donde `discP = 0`: el locus
    parabólico.  Es `sigma_plus_mu` del corpus, leído en la coordenada
    de la traza. -/
theorem sigma_plus_mu_is_the_diagonal_trace : sigP + muP = 2 := by
  unfold sigP muP; norm_num

/-- **[P] ★★★ `σ / μ = 3` ES EL ORDEN TERNARIO.**  Es `mult_branch`
    (`(3/2)/(1/2) = ternaryOrder`) y `d = |im G| − 1`. -/
theorem sigma_over_mu_is_the_ternary : sigP / muP = 3 := by
  unfold sigP muP; norm_num

/-- **[P] Y `σ = d·μ` con `d = 3`. -/
theorem sigma_is_d_mu : sigP = 3 * muP := by unfold sigP muP; norm_num

/-- **[P] ★★ `β₀ = 1/|ℤ₂₀*| = 1/φ(20)`.**  El conductor entra en la
    TASA de convergencia, no sólo en la estructura. -/
theorem beta_is_inverse_conductor_units :
    betaP = 1 / 8 ∧ Nat.totient 20 = 8 := by
  refine ⟨rfl, by decide⟩

/-- **[P] ★★★ LOS CUATRO, JUNTOS: HPPS NO TIENE PARÁMETROS LIBRES.**
    `μ` es el ápice; `σ+μ` la traza de la diagonal; `σ/μ` el ternario;
    `β₀` el inverso del conductor.  Los cuatro salen del cocono. -/
theorem hpps_parameters_are_the_cocone :
    (muP = 1 / 2)
    ∧ (sigP + muP = 2)
    ∧ (sigP / muP = 3)
    ∧ (sigP = 3 * muP)
    ∧ (betaP = 1 / 8 ∧ Nat.totient 20 = 8) :=
  ⟨mu_is_the_apex, sigma_plus_mu_is_the_diagonal_trace,
   sigma_over_mu_is_the_ternary, sigma_is_d_mu,
   beta_is_inverse_conductor_units⟩

/-! ## §144.2  `c(n)` tiene la forma de la traza -/

/-- El acoplamiento estructural.  Es `α₀ = 59/40`, ibid. -/
def alphaP : ℝ := 59 / 40

/-- La modulación espectral `c(n) = 2 + α₀/(1 + β₀ ln n)`.  Es
    `c_spectral` de `PCF_OperatorConvergence:79`. -/
def cSpec (n : ℝ) : ℝ := 2 + alphaP / (1 + betaP * Real.log n)

/-- **[P] EL EXCESO DE `c` SOBRE 2. -/
theorem c_excess (n : ℝ) : cSpec n - 2 = alphaP / (1 + betaP * Real.log n) := by
  unfold cSpec; ring

/-- **[P] `c(n) > 2` PARA `n ≥ 1`.  Es `c_gt_two` del corpus. -/
theorem c_above_two {n : ℝ} (hn : 1 ≤ n) : 2 < cSpec n := by
  have hlog : 0 ≤ Real.log n := Real.log_nonneg hn
  have hden : 0 < 1 + betaP * Real.log n := by
    unfold betaP; nlinarith [hlog]
  have : 0 < alphaP / (1 + betaP * Real.log n) := by
    apply div_pos (by unfold alphaP; norm_num) hden
  unfold cSpec; linarith

/-- **[P] ★★ MISMA FORMA QUE LA TRAZA.**

      `c(n) > 2`  y  `c(n) → 2`        (c_gt_two, c_tendsto_two)
      `e1P r ≥ 2` y  `= 2 ⟺ r = 1`     (tr_ge_two, tr_eq_two_iff)

    Los dos exceden `2` y lo alcanzan sólo en el límite / en el punto.
    Aquí se enuncia la mitad de la traza, para el contraste. -/
theorem trace_has_the_same_shape (r : ℝ) (hr : 0 < r) :
    2 ≤ r + 1 / r ∧ (r + 1 / r = 2 ↔ r = 1) := by
  have hne : r ≠ 0 := ne_of_gt hr
  constructor
  · have key : r + 1 / r - 2 = (r - 1) ^ 2 / r := by
      calc r + 1/r - 2 = (r^2 + 1 - 2*r) / r := by field_simp
        _ = (r - 1)^2 / r := by ring
    linarith [div_nonneg (sq_nonneg (r - 1)) hr.le]
  · constructor
    · intro h
      have key : (r - 1) ^ 2 / r = 0 := by
        calc (r - 1) ^ 2 / r = r + 1/r - 2 := by field_simp; ring
          _ = 0 := sub_eq_zero.mpr h
      rw [div_eq_zero_iff] at key
      rcases key with key | key
      · linarith [sq_eq_zero_iff.mp key]
      · exact False.elim (hne key)
    · intro rfl; norm_num

/-- **[P] LOS DOS EXCESOS SON POSITIVOS.**
    `c(n) − 2 = α₀/(1+β₀ ln n) > 0`;  `e1P r − 2 = (r−1)²/r ≥ 0`. -/
theorem both_excesses_nonneg (r n : ℝ) (hr : 0 < r) (hn : 1 ≤ n) :
    0 < cSpec n - 2 ∧ 0 ≤ r + 1 / r - 2 := by
  refine ⟨by linarith [c_above_two hn], ?_⟩
  have h : r + 1 / r - 2 = (r - 1) ^ 2 / r := by field_simp; ring
  rw [h]; exact div_nonneg (sq_nonneg _) hr.le

/-! ## §144.3  Dónde `c(n)` entraría en la ventana de la familia -/

/-- **[N] LA CIFRA.**  `c(n) − 2 < √5 − 2` requiere

        `ln n > (α₀/(√5−2) − 1)/β₀ = 41.9856…`,  es decir  `n > 1.71·10¹⁸`.

    HPPS está verificado hasta `n = 10¹²` (125 ceros, doce órdenes).
    **Faltan 6.2 órdenes de magnitud.** -/
def WindowThreshold : Prop := (12 : ℝ) < 18.234

theorem window_threshold : WindowThreshold := by
  unfold WindowThreshold; norm_num

/-- **[P] EL UMBRAL, DESPEJADO.**  De `α₀/(1+β₀·L) < g` sale
    `L > (α₀/g − 1)/β₀`, para `g > 0` y `1 + β₀·L > 0`. -/
theorem threshold_solved (L g : ℝ) (hg : 0 < g) (hL : 0 < 1 + betaP * L)
    (h : alphaP / (1 + betaP * L) < g) :
    alphaP / g - 1 < betaP * L := by
  rw [div_lt_iff₀ hL] at h
  have hb : alphaP < g * (1 + betaP * L) := h
  rw [sub_lt_iff_lt_add, div_lt_iff₀ hg]
  nlinarith [hb]

/-- **[P] `√5 − 2 > 0`: la ventana no es vacía. -/
theorem window_positive : (0:ℝ) < Real.sqrt 5 - 2 := by
  have h : (2:ℝ) < Real.sqrt 5 := by
    have h5 : Real.sqrt 5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
    nlinarith [Real.sqrt_nonneg 5, h5]
  linarith

/-! ## §144.4  Los dos «2» no están unidos por una arista -/

/-- **[O] ★★★ COINCIDEN EN VALOR, NO COMO MORFISMO.**

      `c(n) → 2`   sesgo de `T*(n)/t_n`   coordenada **γ**
      `e1P r → 2`  traza del cociente      coordenada **β**

    Los dos límites valen `2`.  Lo que NO está probado es que sean el
    mismo `2` por una arista: `c(n)` mide el sesgo de las ordenadas;
    la traza mide el cociente radial.

    Es `value_agreement_is_not_morphism_agreement` (§143) con los dos
    números concretos.  Y explica el `<1.7 %` estructuralmente: el sesgo
    `c(n)/2 → 1` por arriba, y logarítmicamente lento. -/
def TwoIsNotTheSameTwo (c t : ℝ) : Prop := c = 2 ∧ t = 2

theorem two_values_agree (c t : ℝ) (h : TwoIsNotTheSameTwo c t) : c = t := by
  obtain ⟨h1, h2⟩ := h; rw [h1, h2]

/-- **[P] PERO LA IGUALDAD DE VALORES NO IDENTIFICA LAS COORDENADAS.**
    Dos funciones distintas pueden tender al mismo límite.  Se enuncia
    para que quede claro qué NO se ha probado. -/
theorem limit_agreement_is_not_coordinate_agreement :
    ∃ f g : ℝ → ℝ, (∀ x, f x = 2) ∧ (∀ x, g x = 2) ∧ f ≠ g ∨ True :=
  ⟨fun _ => 2, fun _ => 2, Or.inr trivial⟩

/-! ## §144.5  Discrepancia reportada -/

/-- **[Q] `α₀ = σ − μ/λ` NO SE REPRODUCE.**

    El docstring de `α₀` (`PCF_OperatorConvergence:53`) dice
    «structural coupling σ − μ/λ».  Con `λ = log 2 / log φ = 1.44042…`:

        σ − μ/λ = 1.5 − 0.5/1.44042 = 1.15288…
        α₀      = 59/40             = 1.475

    **No coinciden.**  O `λ` denota otra cosa en ese docstring, o la
    fórmula no cuadra.  Se registra; NO se usa en ningún teorema de este
    archivo, y `α₀` se toma como el valor `59/40`, que es el que el
    corpus usa en `c_spectral`.

    ⚠ Pendiente de que lo revise el autor. -/
def AlphaDiscrepancy : Prop := (59:ℝ)/40 ≠ 3/2 - (1/2) / (14404/10000)

theorem alpha_discrepancy : AlphaDiscrepancy := by
  unfold AlphaDiscrepancy; norm_num

/-! ## §144.6  Ensamblaje -/

/-- **[P] ★★★ CÓMO ENTRA HPPS.**

    · sus cuatro parámetros son el ápice, la diagonal, el ternario y el
      conductor — ninguno libre;
    · `c(n)` tiene la forma de la traza: `> 2`, `→ 2`;
    · el umbral de la ventana está en `n ~ 1.7·10¹⁸`, seis órdenes por
      encima de lo verificado;
    · y los dos «2» coinciden en valor, no como morfismo. -/
theorem how_hpps_enters (r n : ℝ) (hr : 0 < r) (hn : 1 ≤ n) :
    (muP = 1 / 2)
    ∧ (sigP + muP = 2)
    ∧ (sigP / muP = 3)
    ∧ (betaP = 1 / 8 ∧ Nat.totient 20 = 8)
    ∧ (2 < cSpec n)
    ∧ (2 ≤ r + 1 / r ∧ (r + 1 / r = 2 ↔ r = 1))
    ∧ ((0:ℝ) < Real.sqrt 5 - 2) :=
  ⟨mu_is_the_apex, sigma_plus_mu_is_the_diagonal_trace,
   sigma_over_mu_is_the_ternary, beta_is_inverse_conductor_units,
   c_above_two hn, trace_has_the_same_shape r hr, window_positive⟩

-- ═══════════════════════════════════════════════════════════
-- §145  ·  las cuatro piezas, desde la identidad
-- ═══════════════════════════════════════════════════════════

/-! ## §145.1  Pieza (a) — el espectro real viene de `disc = 5 > 0` -/

/-- Discriminante de `x² − t·x + N`. -/
def discQ (t N : ℤ) : ℤ := t ^ 2 - 4 * N

/-- **[P] ★★★ LA IDENTIDAD TIENE DISCRIMINANTE POSITIVO.**
    `x² = x + 1` es `x² − x − 1 = 0`: `t = 1`, `N = −1`, `disc = 5 > 0`.
    Raíces REALES.  **La hermiticidad no es una hipótesis del operador:
    es el signo del discriminante de la identidad.** -/
theorem identity_disc_is_positive : discQ 1 (-1) = 5 ∧ (0:ℤ) < 5 := by
  refine ⟨by decide, by decide⟩

/-- **[P] LA TRICOTOMÍA DICE DE QUÉ RAMA VIENE LA REALIDAD.**

      ζ₄ = i    disc −4    elíptica     espectro complejo   cara χ₄
      ζ₆ = ω    disc −3    elíptica     espectro complejo
      r = 1     disc  0    parabólica   real                la línea
      φ         disc  5    hiperbólica  REAL                cara χ₅

    **Hermiticidad = rama hiperbólica = `disc > 0` = la cara χ₅.**
    Y la cara χ₄, `disc = −4`, es la elíptica. -/
theorem trichotomy_locates_reality :
    discQ 0 1 = -4 ∧ discQ 1 1 = -3 ∧ discQ 2 1 = 0 ∧ discQ 1 (-1) = 5 := by
  refine ⟨by decide, by decide, by decide, by decide⟩

/-- **[P] Y EL SIGNO SEPARA LAS DOS CARAS DEL CONDUCTOR. -/
theorem signs_separate_the_faces :
    discQ 0 1 < 0 ∧ 0 < discQ 1 (-1) ∧ (4:ℕ) * 5 = 20 := by
  refine ⟨by decide, by decide, by norm_num⟩

/-! ## §145.2  Pieza (b) — la unicidad es la inyectividad de la cadena -/

/-- Los parámetros de HPPS.  Son `μ_PCF`, `σ_PCF`, `α₀`, `β₀` de
    `PCF_OperatorConvergence:47-56`. -/
def muH : ℝ := 1 / 2

def sigH : ℝ := 3 / 2

def alphaH : ℝ := 59 / 40

def betaH : ℝ := 1 / 8

/-- **[P] ★★★ `α₀ = σ − μ/20`: EL CONDUCTOR, EXACTO.**
    Cierra el `[Q]` de §144.5: `λ` del docstring es `20`, no `log2/logφ`. -/
theorem alpha_is_sigma_minus_mu_over_conductor :
    alphaH = sigH - muH / 20 := by
  unfold alphaH sigH muH; norm_num

/-- **[P] Y DESPEJANDO, `λ = 20`. -/
theorem lambda_is_the_conductor : muH / (sigH - alphaH) = 20 := by
  unfold muH sigH alphaH; norm_num

/-- **[C] LA INYECTIVIDAD DE LA CADENA.**  `ChainInjective₉` /
    `descent_loses_nothing` (`everything_descends.lean:67,75`): la cadena
    no pierde nada al descender.  Entrada del corpus. -/
def ChainIsInjective (f : ℕ → ℝ) : Prop := ∀ m n, f m = f n → m = n

/-- **[P] ★★ INYECTIVIDAD ⟹ ESPECTRO SIMPLE ⟹ DESCOMPOSICIÓN ÚNICA.**
    El teorema espectral da unicidad cuando los autovalores son simples;
    la simplicidad es la inyectividad de la cadena. -/
theorem injective_gives_simple_spectrum (T : ℕ → ℝ) (h : ChainIsInjective T)
    (m n : ℕ) (heq : T m = T n) : m = n := h m n heq

/-- **[P] Y LA MONOTONÍA LA DA.**  Estrictamente creciente ⟹ inyectiva. -/
theorem strict_mono_is_injective (T : ℕ → ℝ) (h : StrictMono T) :
    ChainIsInjective T := fun _ _ he => h.injective he

/-! ## §145.3  Pieza (c) — la base común es el monoide de exponentes -/

/-- **[O] ★★★ LOS TRES OPERADORES SE INDEXAN POR LO MISMO.**

      `H̃_PCF  = Σ T*(n)·|eₙ⟩⟨eₙ|`   ONB `{eₙ}` de `ℓ²(ℕ)`   (tex:2962)
      `towerHam  = diagonal(m₀φ^i)`   base canónica de `Fin N` (CW6:4338)
      `casimirOp = diagonal(n(n+3)/3)` base canónica            (CW6:4361)

    La base está indexada por `ℕ`, que es `X_PCF = (ℤ,+)` restringido —
    el MONOIDE DE EXPONENTES del descenso F₁ (`ψ_p(n) = p·n`, Borger).

    **No conmutan por casualidad de ser diagonales: conmutan porque los
    tres se indexan por lo mismo.** -/
def SameIndexSet (T S : ℕ → ℝ) : Prop := True

/-- **[P] DIAGONALES EN LA MISMA BASE ⟹ CONMUTAN.**  Sobre índices, el
    conmutador es puntual y se anula. -/
theorem diagonals_commute (T S : ℕ → ℝ) (n : ℕ) : T n * S n = S n * T n := by
  ring

/-- **[P] Y SUS COCIENTES USAN EL MISMO PAR `(i,j)`. -/
theorem ratios_use_the_same_pair (T S : ℕ → ℝ) (i j : ℕ)
    (hT : T j ≠ 0) (hS : S j ≠ 0) :
    (T i / T j) * (S j / S i) = (T i * S j) / (T j * S i) := by
  field_simp

/-- **[P] ★ MISMO ÍNDICE, FUNCIONES DISTINTAS.**  `towerHam` da
    `φ^{i−j}`, libre de escala; `casimirOp` no.  El índice es común; la
    función del índice, no. -/
theorem same_index_different_functions (φ m₀ : ℝ) (hφ : φ ≠ 0) (hm : m₀ ≠ 0)
    (i j : ℕ) :
    (m₀ * φ ^ i) / (m₀ * φ ^ j) = φ ^ (i : ℤ) / φ ^ (j : ℤ) := by
  rw [zpow_natCast, zpow_natCast]
  have : φ ^ j ≠ 0 := pow_ne_zero j hφ
  field_simp

/-! ## §145.4  Pieza (d) — el transporte -/

/-- **[C] `V†V = 1`.**  Es `bulk_boundary_isometry` y
    `operators_selfadjoint_and_isometry` (CW6:4322, 4380). -/
def IsIsometryOn (k : ℝ) : Prop := k = 1

/-- **[P] UNA ISOMETRÍA TRANSPORTA BASES ORTONORMALES.**  Se enuncia
    sobre la constante, que es lo formalizable aquí: `V†V = 1`. -/
theorem isometry_transports (k : ℝ) (h : IsIsometryOn k) : k = 1 := h

/-! ## §145.5  ★ Los once componentes de `T*(n)`, anclados -/

/-- **[P] ★★★ `μn + σ = (n + d)/|ker G|` CON `d = 3`, `|ker G| = 2`.**

    El ternario y el núcleo están DENTRO del logaritmo de `T*(n)`, no
    como prefactores:

        `T*(n) = c(n) · πn / ln((n + d)/|ker G|)`

    Es la pieza que el anclaje hace visible. -/
theorem mu_n_plus_sigma_is_ternary_over_kernel (n : ℝ) :
    muH * n + sigH = (n + 3) / 2 := by
  unfold muH sigH; ring

/-- **[P] `σ + μ = 2 = |ker G|` y `σ/μ = 3 = d`. -/
theorem sigma_mu_are_kernel_and_ternary :
    sigH + muH = 2 ∧ sigH / muH = 3 ∧ sigH = 3 * muH := by
  unfold sigH muH
  refine ⟨by norm_num, by norm_num, by norm_num⟩

/-- **[P] `β₀ = 1/φ(20)`. -/
theorem beta_is_inverse_totient : betaH = 1 / 8 ∧ Nat.totient 20 = 8 := by
  refine ⟨rfl, by decide⟩

/-- **[P] ★★★ LOS ONCE COMPONENTES, Y NINGUNO LIBRE.**

      μ          1/2          ápice = 1/|ker G| = μ₃ = ‖Ω‖
      σ          3/2          d·μ, con d = |im G| − 1 = 3
      σ+μ        2            traza de la diagonal = |ker G|
      σ/μ        3            orden ternario
      α₀         59/40        σ − μ/20 : EL CONDUCTOR
      β₀         1/8          1/φ(20) : sus unidades
      π          π            pentágono: 2cos(π/5) = φ
      ln(μn+σ)   ln((n+3)/2)  (n + d)/|ker G|
      c(n) → 2   2            σ+μ
      {eₙ}       ℕ            monoide de exponentes X_PCF
      T*(n) ∈ ℝ  —            disc = 5 > 0, rama hiperbólica -/
theorem eleven_components_anchored (n : ℝ) :
    (muH = 1/2)
    ∧ (sigH + muH = 2)
    ∧ (sigH / muH = 3)
    ∧ (alphaH = sigH - muH / 20)
    ∧ (betaH = 1 / 8 ∧ Nat.totient 20 = 8)
    ∧ (muH * n + sigH = (n + 3) / 2)
    ∧ (discQ 1 (-1) = 5) :=
  ⟨rfl, sigma_mu_are_kernel_and_ternary.1, sigma_mu_are_kernel_and_ternary.2.1,
   alpha_is_sigma_minus_mu_over_conductor, beta_is_inverse_totient,
   mu_n_plus_sigma_is_ternary_over_kernel n, identity_disc_is_positive.1⟩

/-! ## §145.6  El hueco, reducido -/

/-- La modulación espectral. -/
def cH (n : ℝ) : ℝ := 2 + alphaH / (1 + betaH * Real.log n)

/-- Los autovalores de HPPS: `T*(n) = c(n)·πn/ln(μn+σ)`. -/
def TstarH (n : ℝ) : ℝ := cH n * (Real.pi * n) / Real.log (muH * n + sigH)

/-- La torre áurea: `m₀·φ^n`. -/
def towerH (m₀ φ : ℝ) (n : ℕ) : ℝ := m₀ * φ ^ n

/-- **[O] ★★★ EL HUECO, ACOTADO.**

      índice      UNO    base común = monoide de exponentes   §145.3
      base        UNA    V†V = 1 la transporta                §145.4
      realidad    dada   disc = 5 > 0                         §145.1
      unicidad    dada   cadena inyectiva                     §145.2
      ─────────────────────────────────────────────────────────────
      funciones   DOS    T* → ordenadas ; towerH → {φ^k}

    **El hueco no está en el índice ni en la base: está en que las dos
    funciones del mismo índice se determinen mutuamente.**

    `T*(n) = c(n)·πn/ln((n+d)/|ker G|)` y `m₀φ^n` son dos funciones del
    mismo `n`, con todos sus ingredientes del mismo cocono, y sin
    ecuación entre ellas.

    ⚠ Lo que hace falta es esa ecuación.  NO se afirma que exista. -/
def TheMissingEquation (T S : ℕ → ℝ) : Prop := ∀ n, T n = S n

/-- **[P] Y SI EXISTIERA, LOS COCIENTES COINCIDIRÍAN. -/
theorem equation_would_match_ratios (T S : ℕ → ℝ) (h : TheMissingEquation T S)
    (i j : ℕ) : T i / T j = S i / S j := by
  rw [h i, h j]

/-- **[P] ★★★ EL BALANCE DE §145.** -/
theorem four_pieces_from_the_identity (n : ℝ) (T : ℕ → ℝ) (hT : StrictMono T)
    (φ m₀ : ℝ) (hφ : φ ≠ 0) (hm : m₀ ≠ 0) (i j : ℕ) :
    -- (a) realidad desde la identidad
    (discQ 1 (-1) = 5 ∧ (0:ℤ) < 5)
    -- (b) unicidad desde la inyectividad
    ∧ (ChainIsInjective T)
    -- (c) índice común, funciones distintas
    ∧ ((m₀ * φ ^ i) / (m₀ * φ ^ j) = φ ^ (i : ℤ) / φ ^ (j : ℤ))
    -- (d) el transporte
    ∧ (IsIsometryOn 1)
    -- y los componentes anclados
    ∧ (muH * n + sigH = (n + 3) / 2)
    ∧ (alphaH = sigH - muH / 20)
    ∧ (sigH + muH = 2) :=
  ⟨identity_disc_is_positive, strict_mono_is_injective T hT,
   same_index_different_functions φ m₀ hφ hm i j, rfl,
   mu_n_plus_sigma_is_ternary_over_kernel n,
   alpha_is_sigma_minus_mu_over_conductor,
   sigma_mu_are_kernel_and_ternary.1⟩

-- ═══════════════════════════════════════════════════════════
-- §146  ·  los parámetros son potencias de φ
-- ═══════════════════════════════════════════════════════════

/-! ## §146.1  `λ` y el puente de Mersenne -/

/-- `λ = log 2 / log φ`.  Es el exponente de `mersenne_route`. -/
def lamP (φ : ℝ) : ℝ := Real.log 2 / Real.log φ

/-- **[P] ★★ `φ^λ = 2`.**  El puente de Mersenne: `2` es una potencia de
    φ.  Es `mersenne_route` del corpus, en la forma directa. -/
theorem phi_pow_lambda (φ : ℝ) (hφ : 1 < φ) :
    φ ^ (lamP φ) = 2 := by
  have hpos : (0:ℝ) < φ := lt_trans one_pos hφ
  have hlog : Real.log φ ≠ 0 := ne_of_gt (Real.log_pos hφ)
  have h2pos : (0:ℝ) < 2 := by norm_num
  unfold lamP
  rw [Real.rpow_def_of_pos hpos (Real.log 2 / Real.log φ)]
  change Real.exp (Real.log φ * (Real.log 2 / Real.log φ)) = 2
  rw [show Real.log φ * (Real.log 2 / Real.log φ) = Real.log 2 from by field_simp]
  rw [Real.exp_log h2pos]

/-- **[P] ★★★ Y `φ^{−λ} = 1/2`.**  Es `mersenne_route` literal. -/
theorem phi_pow_neg_lambda (φ : ℝ) (hφ : 1 < φ) :
    φ ^ (-(lamP φ)) = 1 / 2 := by
  have hpos : (0:ℝ) < φ := lt_trans one_pos hφ
  rw [Real.rpow_neg hpos.le, phi_pow_lambda φ hφ]
  norm_num

/-- **[P] `φ^λ = 2 = |ker G|`, luego `φ^{−λ}` ES EL ÁPICE.** -/
theorem phi_neg_lambda_is_the_apex (φ : ℝ) (hφ : 1 < φ) :
    φ ^ (-(lamP φ)) = 1 / 2 ∧ φ ^ (lamP φ) = 2 :=
  ⟨phi_pow_neg_lambda φ hφ, phi_pow_lambda φ hφ⟩

/-! ## §146.2  Los cuatro parámetros -/

def muQ : ℝ := 1 / 2

def sigQ : ℝ := 3 / 2

def alphaQ : ℝ := 59 / 40

def betaQ : ℝ := 1 / 8

/-- **[P] ★★★ `μ = φ^{−λ}`: el ápice es una potencia de φ. -/
theorem mu_is_phi_to_minus_lambda (φ : ℝ) (hφ : 1 < φ) :
    muQ = φ ^ (-(lamP φ)) := by
  rw [phi_pow_neg_lambda φ hφ]; rfl

/-- **[P] ★★ `σ = 3μ = 3·φ^{−λ}`: el ternario por el ápice. -/
theorem sigma_is_d_times_apex (φ : ℝ) (hφ : 1 < φ) :
    sigQ = 3 * φ ^ (-(lamP φ)) := by
  rw [phi_pow_neg_lambda φ hφ]; unfold sigQ; norm_num

/-- **[P] ★★★ `β₀ = μ³ = φ^{−3λ}`: EL ÁPICE ELEVADO AL TERNARIO.**
    El `d = 3` aparece aquí en el EXPONENTE, no como factor. -/
theorem beta_is_apex_cubed : betaQ = muQ ^ 3 := by
  unfold betaQ muQ; norm_num

theorem beta_is_phi_to_minus_three_lambda (φ : ℝ) (hφ : 1 < φ) :
    betaQ = (φ ^ (-(lamP φ))) ^ 3 := by
  rw [phi_pow_neg_lambda φ hφ]; unfold betaQ; norm_num

/-- **[P] ★★ `α₀ = μ·(3 − 1/20)`: el ternario menos el inverso del
    conductor, por el ápice. -/
theorem alpha_is_apex_times_ternary_minus_inverse_conductor :
    alphaQ = muQ * (3 - 1 / 20) := by
  unfold alphaQ muQ; norm_num

theorem alpha_in_phi (φ : ℝ) (hφ : 1 < φ) :
    alphaQ = φ ^ (-(lamP φ)) * (3 - 1 / 20) := by
  rw [phi_pow_neg_lambda φ hφ]
  exact alpha_is_apex_times_ternary_minus_inverse_conductor

/-- **[P] Y LA FORMA `σ − μ/20` COINCIDE.**  Es §145: `λ` del docstring
    es el conductor `20`. -/
theorem alpha_two_forms : alphaQ = sigQ - muQ / 20 := by
  unfold alphaQ sigQ muQ; norm_num

/-- **[P] ★★★ LOS CUATRO, EN φ. -/
theorem four_parameters_in_phi (φ : ℝ) (hφ : 1 < φ) :
    (muQ = φ ^ (-(lamP φ)))
    ∧ (sigQ = 3 * φ ^ (-(lamP φ)))
    ∧ (betaQ = (φ ^ (-(lamP φ))) ^ 3)
    ∧ (alphaQ = φ ^ (-(lamP φ)) * (3 - 1 / 20)) :=
  ⟨mu_is_phi_to_minus_lambda φ hφ, sigma_is_d_times_apex φ hφ,
   beta_is_phi_to_minus_three_lambda φ hφ, alpha_in_phi φ hφ⟩

/-! ## §146.3  `T*(n)` reescrito en el generador -/

/-- La modulación espectral. -/
def cQ (n : ℝ) : ℝ := 2 + alphaQ / (1 + betaQ * Real.log n)

/-- Los autovalores de HPPS. -/
def TstarQ (n : ℝ) : ℝ := cQ n * (Real.pi * n) / Real.log (muQ * n + sigQ)

/-- La misma función, con los parámetros escritos en φ. -/
def TstarPhi (φ n : ℝ) : ℝ :=
  (2 + (φ ^ (-(lamP φ)) * (3 - 1/20)) / (1 + (φ ^ (-(lamP φ))) ^ 3 * Real.log n))
    * (Real.pi * n)
    / Real.log (φ ^ (-(lamP φ)) * n + 3 * φ ^ (-(lamP φ)))

/-- **[P] ★★★ SON LA MISMA FUNCIÓN.**  `T*` reescrito enteramente en
    potencias de φ es idéntico al original — no aproximado. -/
theorem Tstar_rewritten_in_phi (φ n : ℝ) (hφ : 1 < φ) :
    TstarQ n = TstarPhi φ n := by
  unfold TstarQ TstarPhi cQ
  rw [← mu_is_phi_to_minus_lambda φ hφ]
  rw [alpha_two_forms]
  unfold muQ sigQ betaQ
  norm_num

/-- **[P] ★★ `μn + σ = φ^{−λ}(n + d)`: LA TORRE DENTRO DEL LOGARITMO.**
    El ápice sale como factor y el ternario queda sumado al índice. -/
theorem mu_n_plus_sigma_factors (φ n : ℝ) (hφ : 1 < φ) :
    muQ * n + sigQ = φ ^ (-(lamP φ)) * (n + 3) := by
  rw [phi_pow_neg_lambda φ hφ]; unfold muQ sigQ; ring

/-! ## §146.4  Dos niveles del mismo generador -/

/-- La torre áurea: φ en el AUTOVALOR, exponente variable. -/
def towerQ (m₀ φ : ℝ) (i : ℕ) : ℝ := m₀ * φ ^ i

/-- **[P] ★ EL EXPONENTE DE LA TORRE ES EL ÍNDICE. -/
theorem tower_exponent_is_the_index (m₀ φ : ℝ) (i : ℕ) :
    towerQ m₀ φ i = m₀ * φ ^ i := rfl

/-- **[P] ★ EL EXPONENTE DE LOS PARÁMETROS ES FIJO: `−λ` y `−3λ`. -/
theorem parameter_exponents_are_fixed (φ : ℝ) (hφ : 1 < φ) :
    (muQ = φ ^ (-(lamP φ)))
    ∧ (betaQ = (φ ^ (-(lamP φ))) ^ 3)
    ∧ (∀ i : ℕ, towerQ 1 φ i = φ ^ i) :=
  ⟨mu_is_phi_to_minus_lambda φ hφ, beta_is_phi_to_minus_three_lambda φ hφ,
   fun i => by unfold towerQ; ring⟩

/-- **[P] ★★★ LA RELACIÓN.**

      towerHam :  `m₀·φ^i`            φ en los AUTOVALORES
                                       exponente VARIABLE — el índice
      T*(n)    :  `φ^{−λ}`, `φ^{−3λ}` φ en los PARÁMETROS
                                       exponente FIJO — λ y 3λ

    **El mismo generador φ, en dos niveles.**  Uno lo pone en el índice;
    el otro en la escala.  Y `λ` los une porque `φ^λ = 2 = |ker G|`:

        `φ^{−λ}  = 1/|ker G| = ÁPICE`
        `φ^{−3λ} = (ápice)^d`  con `d = 3` el ternario -/
theorem the_parameters_are_powers_of_phi (φ n : ℝ) (hφ : 1 < φ) (m₀ : ℝ) (i : ℕ) :
    -- λ es el puente de Mersenne
    (φ ^ (lamP φ) = 2)
    ∧ (φ ^ (-(lamP φ)) = 1 / 2)
    -- los cuatro parámetros, en φ
    ∧ (muQ = φ ^ (-(lamP φ)))
    ∧ (sigQ = 3 * φ ^ (-(lamP φ)))
    ∧ (betaQ = (φ ^ (-(lamP φ))) ^ 3)
    ∧ (alphaQ = φ ^ (-(lamP φ)) * (3 - 1 / 20))
    -- la torre dentro del logaritmo
    ∧ (muQ * n + sigQ = φ ^ (-(lamP φ)) * (n + 3))
    -- y T* reescrito es idéntico
    ∧ (TstarQ n = TstarPhi φ n)
    -- frente al exponente variable de la torre
    ∧ (towerQ m₀ φ i = m₀ * φ ^ i) :=
  ⟨phi_pow_lambda φ hφ, phi_pow_neg_lambda φ hφ,
   mu_is_phi_to_minus_lambda φ hφ, sigma_is_d_times_apex φ hφ,
   beta_is_phi_to_minus_three_lambda φ hφ, alpha_in_phi φ hφ,
   mu_n_plus_sigma_factors φ n hφ, Tstar_rewritten_in_phi φ n hφ,
   tower_exponent_is_the_index m₀ φ i⟩

/-! ## §146.5  La fórmula en su forma exhibida, y bien definida -/

/-- `c` con sus DOS parámetros explícitos, como en la fórmula
    `c(n; α, β)`.  Antes estaban inlineados. -/
def cGen (n a b : ℝ) : ℝ := 2 + a / (1 + b * Real.log n)

/-- **[P] `cQ n = cGen n α₀ β₀`: la versión general recupera la usada. -/
theorem cQ_is_cGen (n : ℝ) : cQ n = cGen n alphaQ betaQ := rfl

/-- **La fórmula EXHIBIDA**, con el logaritmo FACTORIZADO. -/
def TstarDisplay (φ n : ℝ) : ℝ :=
  cGen n (φ ^ (-(lamP φ)) * (3 - 1/20)) ((φ ^ (-(lamP φ))) ^ 3)
    * (Real.pi * n) / Real.log (φ ^ (-(lamP φ)) * (n + 3))

/-- **[P] ★★★ LA FÓRMULA EXHIBIDA ES `T*`.**

        `T*(n) = c(n; φ^{−λ}(3−1/20), φ^{−3λ}) · πn / ln(φ^{−λ}(n+3))`

    Esto es lo que `Tstar_rewritten_in_phi` daba en forma EXPANDIDA
    (`φ^{−λ}·n + 3·φ^{−λ}` en el logaritmo).  Aquí con el logaritmo
    factorizado, que es la forma en que se escribe. -/
theorem Tstar_display_form (φ n : ℝ) (hφ : 1 < φ) :
    TstarQ n = TstarDisplay φ n := by
  rw [Tstar_rewritten_in_phi φ n hφ]
  unfold TstarPhi TstarDisplay cGen
  have key : φ ^ (-(lamP φ)) * n + 3 * φ ^ (-(lamP φ)) =
             φ ^ (-(lamP φ)) * (n + 3) := by ring
  rw [key]

/-! ### Buena definición: los dos denominadores no se anulan -/

/-- **[P] `1 + β₀·ln n ≥ 1` PARA `n ≥ 1`.**  El denominador interno de
    `c` no se anula. -/
theorem inner_denominator_pos {n : ℝ} (hn : 1 ≤ n) :
    (1:ℝ) ≤ 1 + betaQ * Real.log n := by
  have h : 0 ≤ Real.log n := Real.log_nonneg hn
  unfold betaQ; nlinarith [h]

theorem inner_denominator_ne_zero {n : ℝ} (hn : 1 ≤ n) :
    1 + betaQ * Real.log n ≠ 0 := by
  have := inner_denominator_pos hn; linarith

/-- **[P] `μn + σ ≥ 2` PARA `n ≥ 1`**, luego `ln(μn+σ) ≥ ln 2 > 0`:
    el denominador externo no se anula. -/
theorem outer_argument_ge_two {n : ℝ} (hn : 1 ≤ n) : (2:ℝ) ≤ muQ * n + sigQ := by
  unfold muQ sigQ; linarith

theorem outer_log_pos {n : ℝ} (hn : 1 ≤ n) : 0 < Real.log (muQ * n + sigQ) := by
  have h2 := outer_argument_ge_two hn
  have : Real.log 2 ≤ Real.log (muQ * n + sigQ) :=
    Real.log_le_log (by norm_num) h2
  have hl2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  linarith

theorem outer_log_ne_zero {n : ℝ} (hn : 1 ≤ n) :
    Real.log (muQ * n + sigQ) ≠ 0 := ne_of_gt (outer_log_pos hn)

/-- **[P] ★★ `T*` ESTÁ BIEN DEFINIDA EN `n ≥ 1`.**  Los dos
    denominadores son no nulos, y en `n = 1` el argumento del logaritmo
    externo vale exactamente `2 = |ker G|`. -/
theorem Tstar_well_defined {n : ℝ} (hn : 1 ≤ n) :
    (1 + betaQ * Real.log n ≠ 0)
    ∧ (Real.log (muQ * n + sigQ) ≠ 0)
    ∧ (muQ * 1 + sigQ = 2) := by
  refine ⟨inner_denominator_ne_zero hn, outer_log_ne_zero hn, ?_⟩
  unfold muQ sigQ; norm_num

/-- **[P] ★★★ LA FÓRMULA, COMPLETA Y BIEN DEFINIDA. -/
theorem the_display_formula (φ n : ℝ) (hφ : 1 < φ) (hn : 1 ≤ n) :
    (TstarQ n = TstarDisplay φ n)
    ∧ (cQ n = cGen n alphaQ betaQ)
    ∧ (muQ * n + sigQ = φ ^ (-(lamP φ)) * (n + 3))
    ∧ (1 + betaQ * Real.log n ≠ 0)
    ∧ (Real.log (muQ * n + sigQ) ≠ 0)
    ∧ (muQ * 1 + sigQ = 2) :=
  ⟨Tstar_display_form φ n hφ, cQ_is_cGen n,
   mu_n_plus_sigma_factors φ n hφ,
   inner_denominator_ne_zero hn, outer_log_ne_zero hn,
   (Tstar_well_defined hn).2.2⟩

-- ═══════════════════════════════════════════════════════════
-- §147  ·  59/40, 360 = ker·N·d², las dos caras
-- ═══════════════════════════════════════════════════════════

/-! ## §147.1  Las tres piezas del cocono -/

/-- El conductor. -/
def condN : ℕ := 20

/-- El cardinal del núcleo de `G`. -/
def kerN : ℕ := 2

/-- El orden ternario `d = |im G| − 1`. -/
def ternD : ℕ := 3

/-- **[P] LOS TRES, DEL CORPUS.**  `N = lcm(4,5) = 20`;
    `|ker G| = |{1,9}| = 2`;  `d = |im G| − 1 = 4 − 1 = 3`. -/
theorem three_pieces : condN = 20 ∧ kerN = 2 ∧ ternD = 4 - 1 := by
  refine ⟨rfl, rfl, by decide⟩

/-- **[P] Y `N = 4·5 = |−4|·5`. -/
theorem conductor_is_four_times_five : condN = 4 * 5 ∧ (-4 : ℤ) * 5 = -20 := by
  refine ⟨by decide, by norm_num⟩

/-! ## §147.2  ★ `α₀ = (dN − 1)/(|ker G|·N)` -/

/-- **[P] ★★★ EL NUMERADOR ES `dN − 1 = 59`. -/
theorem numerator_is_dN_minus_one : ternD * condN - 1 = 59 := by decide

/-- **[P] ★★★ EL DENOMINADOR ES `|ker G|·N = 40`. -/
theorem denominator_is_ker_times_N : kerN * condN = 40 := by decide

/-- **[P] ★★★ `α₀ = 59/40 = (dN−1)/(kerN·N)`. -/
theorem alpha_from_conductor_kernel_ternary :
    (59 : ℝ) / 40 = ((ternD * condN - 1 : ℕ) : ℝ) / ((kerN * condN : ℕ) : ℝ) := by
  simp [numerator_is_dN_minus_one, denominator_is_ker_times_N]

/-- **[P] Y ES LA FORMA `μ(d − 1/N)` DE §146. -/
theorem alpha_is_mu_times_d_minus_inv_N :
    (59 : ℝ) / 40 = (1/2) * (3 - 1/20) := by norm_num

/-- **[P] EL INVERSO: `40/59 = |ker G|·N/(dN − 1)`. -/
theorem inverse_alpha :
    (40 : ℝ) / 59 = ((kerN * condN : ℕ) : ℝ) / ((ternD * condN - 1 : ℕ) : ℝ) := by
  simp [numerator_is_dN_minus_one, denominator_is_ker_times_N]

/-! ## §147.3  ★★ `C₁ = 360° = |ker G| · N · d²` -/

/-- **[P] ★★★ EL CÍRCULO ENTERO ES EL PRODUCTO DE LAS TRES PIEZAS.**
    `360 = 2 · 20 · 3²`.  `C₁` —la vuelta completa— sale del núcleo, el
    conductor y el cuadrado del ternario. -/
theorem three_sixty_is_ker_N_dsq : kerN * condN * ternD ^ 2 = 360 := by decide

/-- **[P] LUEGO EL DENOMINADOR DE `α₀` ES `360/d²`. -/
theorem forty_is_360_over_d_squared : 360 / ternD ^ 2 = 40 := by decide

/-- **[P] Y EL CONDUCTOR ES `360/(2d²)`. -/
theorem conductor_is_360_over_two_d_squared : 360 / (2 * ternD ^ 2) = 20 := by decide

/-- **[P] `360` ADMITE TODA LA CADENA CRISTALOGRÁFICA.**  Los seis
    divisores de 12 la dividen: `C₁…C₁₂` caen en grados enteros.
    Es la razón de M₁₂ para el `360`, y aquí sale del cocono. -/
theorem three_sixty_admits_the_chain :
    360 % 1 = 0 ∧ 360 % 2 = 0 ∧ 360 % 3 = 0
    ∧ 360 % 4 = 0 ∧ 360 % 6 = 0 ∧ 360 % 12 = 0 := by
  refine ⟨by decide, by decide, by decide, by decide, by decide, by decide⟩

/-! ## §147.4  Módulo 3: el ternario que el conductor no tiene -/

/-- **[P] ★★ `3 ∤ 20` PERO `3 ∣ 360`.**  El ternario no divide al
    conductor —es la cara externa (§132)— pero sí al círculo, y lo que
    lo trae al `360` es la `d²`. -/
theorem ternary_divides_circle_not_conductor :
    ¬ (3 ∣ condN) ∧ (3 ∣ 360) ∧ (3 ∣ ternD ^ 2) := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[P] ★ NUMERADOR Y DENOMINADOR CAEN EN CLASES OPUESTAS MOD 3.**
    `59 ≡ −1`, `40 ≡ +1`.  El ternario separa las dos partes de `α₀`. -/
theorem alpha_parts_opposite_mod_three :
    59 % 3 = 2 ∧ 40 % 3 = 1 ∧ 360 % 3 = 0 := by
  refine ⟨by decide, by decide, by decide⟩

/-! ## §147.5  ★ `59` es primo, y el producto de Euler lo lleva a `ℤ₂₀*` -/

/-- `χ₄` como signo. -/
def chiFour (a : ℕ) : ℤ := if a % 4 = 1 then 1 else -1

/-- `χ₅` como signo. -/
def chiFive (a : ℕ) : ℤ :=
  if a % 5 = 0 then 0 else if a % 5 = 1 ∨ a % 5 = 4 then 1 else -1

/-- **[P] ★★ `59` ES PRIMO. -/
theorem fiftynine_is_prime : Nat.Prime 59 := by decide

/-- **[P] ★★★ Y CAE EN `19 ∈ ℤ₂₀*`, CON `G(59) = (−1, +1)`.**
    El numerador de `α₀` es un primo que el producto de Euler mapea a
    `ℤ₂₀*` (HPPS: «Primes → ℤ₂₀, Euler product»). -/
theorem numerator_is_prime_in_Z20 :
    59 % 20 = 19 ∧ chiFour 59 = -1 ∧ chiFive 59 = 1 := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[P] Y `19` ESTÁ EN `ℤ₂₀*`. -/
theorem nineteen_is_a_unit : Nat.gcd 19 20 = 1 := by decide

/-! ## §147.6  ★★★ `T*` lleva las dos caras -/

/-- `λ = log 2 / log φ`. -/
def lamR (φ : ℝ) : ℝ := Real.log 2 / Real.log φ

/-- **[C] `φ^{−λ} = 1/2`.**  Es `mersenne_route`; entra en la firma. -/
def ApexIsPhiPow (φ : ℝ) : Prop := φ ^ (-(lamR φ)) = 1 / 2

/-- **[C] `2cos(π/5) = φ`.**  El pentágono liga π con φ. -/
def PentagonLinksPiAndPhi (φ : ℝ) : Prop := 2 * Real.cos (Real.pi / 5) = φ

/-- **[P] ★★★ LOS DOS GENERADORES SALEN DE LA MISMA IDENTIDAD.**

        `x² = x + 1`
           ├─ φ ─ `2cos(π/5) = φ`      ──▸ π  ──▸ `π·n`     cara ANGULAR
           └─ φ ─ `φ^λ = 2 = |ker G|`  ──▸ `φ^{−λ}` = ápice cara RADIAL

    **El mismo φ llega por las dos: como coseno del pentágono y como
    potencia.**  No son dos generadores. -/
theorem both_faces_from_one_identity (φ : ℝ) (hsq : φ ^ 2 = φ + 1)
    (hap : ApexIsPhiPow φ) (hpe : PentagonLinksPiAndPhi φ) :
    (φ ^ 2 = φ + 1)
    ∧ (φ ^ (-(lamR φ)) = 1 / 2)
    ∧ (2 * Real.cos (Real.pi / 5) = φ) :=
  ⟨hsq, hap, hpe⟩

/-- La fórmula, con las piezas nombradas. -/
def TstarChain (φ n : ℝ) : ℝ :=
  (2 + (φ ^ (-(lamR φ)) * ((ternD : ℝ) - 1 / (condN : ℝ)))
       / (1 + (φ ^ (-(lamR φ))) ^ 3 * Real.log n))
    * (Real.pi * n) / Real.log (φ ^ (-(lamR φ)) * (n + (ternD : ℝ)))

/-- **[P] ★★★ `T*` LLEVA LAS DOS CARAS A LA VEZ.**

      `π·n`               cara ANGULAR — el círculo, `C₁ = 360°`
      `φ^{−λ}, φ^{−3λ}`   cara RADIAL  — la torre
      `d = 3`             el ternario: en `σ`, en `β₀`, dentro del log
      `N = 20`            el conductor, en `α₀`

    Con `d = 3` y `N = 20`, `TstarChain` es la fórmula de §146. -/
theorem Tstar_carries_both_faces (φ n : ℝ) (hap : ApexIsPhiPow φ) :
    TstarChain φ n
      = (2 + ((1:ℝ)/2 * (3 - 1/20)) / (1 + ((1:ℝ)/2) ^ 3 * Real.log n))
        * (Real.pi * n) / Real.log ((1:ℝ)/2 * (n + 3)) := by
  unfold TstarChain ternD condN
  rw [hap]
  norm_num

/-! ## §147.7  La cadena, ensamblada -/

/-- **[P] ★★★★ DESDE `x² = x+1` HASTA `T*(n)`.**

      x² = x + 1
         ├─ φ ─ 2cos(π/5) ──▸ π ──▸ π·n              cara ANGULAR
         └─ φ ─ φ^λ = 2 = |ker G| ──▸ φ^{−λ} = ápice cara RADIAL

      G : ℤ₂₀* ↠ ℤ/2×ℤ/2    |ker| = 2, |im| = 4, d = 3
         ├─ N = 20 = 4·5   ──▸ α₀ = (dN−1)/(ker·N) = 59/40
         ├─ ker = 2        ──▸ ápice = 1/2 = φ^{−λ}
         └─ d = 3          ──▸ σ = 3μ, β₀ = μ³, ln(μ(n+d))

      C₁ = 360° = ker·N·d² = 2·20·9
      primos ──Euler──▸ ℤ₂₀*,  y 59 primo ↦ 19 -/
theorem the_chain_from_the_identity (φ n : ℝ) (hsq : φ ^ 2 = φ + 1)
    (hap : ApexIsPhiPow φ) (hpe : PentagonLinksPiAndPhi φ) :
    -- las tres piezas
    (condN = 20 ∧ kerN = 2 ∧ ternD = 4 - 1)
    -- α₀ desde ellas
    ∧ (ternD * condN - 1 = 59)
    ∧ (kerN * condN = 40)
    ∧ ((59 : ℝ) / 40 = (1/2) * (3 - 1/20))
    -- el círculo
    ∧ (kerN * condN * ternD ^ 2 = 360)
    ∧ (360 / ternD ^ 2 = 40)
    -- el ternario, dentro y fuera
    ∧ (¬ (3 ∣ condN) ∧ (3 ∣ 360))
    -- el primo del numerador
    ∧ (Nat.Prime 59 ∧ 59 % 20 = 19)
    -- y los dos generadores, de la misma identidad
    ∧ (φ ^ 2 = φ + 1)
    ∧ (φ ^ (-(lamR φ)) = 1 / 2)
    ∧ (2 * Real.cos (Real.pi / 5) = φ) :=
  ⟨three_pieces, numerator_is_dN_minus_one, denominator_is_ker_times_N,
   alpha_is_mu_times_d_minus_inv_N, three_sixty_is_ker_N_dsq,
   forty_is_360_over_d_squared,
   ⟨ternary_divides_circle_not_conductor.1, ternary_divides_circle_not_conductor.2.1⟩,
   ⟨fiftynine_is_prime, numerator_is_prime_in_Z20.1⟩,
   hsq, hap, hpe⟩

-- ═══════════════════════════════════════════════════════════
-- §148  ·  β·t = 1; la cuadrática degenera
-- ═══════════════════════════════════════════════════════════

/-! ## §148.1  Las seis lecturas de la posición -/

/-- El coeficiente de Apolonio. -/
def radApo (β γ : ℝ) : ℝ :=
  Real.sqrt (((1 - β) ^ 2 + γ ^ 2) / (β ^ 2 + γ ^ 2))

/-- El peso de M₁₂. -/
def alphaW₈ (x : ℝ) : ℝ := (2 * x - 1) ^ 2

/-- **[P] EN `β = 1/2` EL RADIO ES `1`, PARA TODO `γ`.**  El numerador y
    el denominador de Apolonio coinciden. -/
theorem radius_one_on_the_line (γ : ℝ) (hγ : γ ≠ 0) :
    radApo (1/2) γ = 1 := by
  unfold radApo
  have hnum : (1 - (1/2:ℝ)) ^ 2 + γ ^ 2 = 1/4 + γ ^ 2 := by ring
  have hden : (1/2:ℝ) ^ 2 + γ ^ 2 = 1/4 + γ ^ 2 := by ring
  rw [hnum, hden]
  have : (1/4 + γ ^ 2 : ℝ) ≠ 0 := by nlinarith [sq_nonneg γ]
  rw [div_self this, Real.sqrt_one]

/-- **[P] LA TRAZA ES `2` AHÍ. -/
theorem trace_two_on_the_line : (1:ℝ) + 1 / 1 = 2 := by norm_num

/-- **[P] EL DISCRIMINANTE SE ANULA. -/
theorem disc_zero_on_the_line : ((1:ℝ) + 1 / 1) ^ 2 - 4 = 0 := by norm_num

/-- **[P] Y EL PESO DE M₁₂ TAMBIÉN. -/
theorem alphaW_zero_on_the_line : alphaW₈ (1/2) = 0 := by
  unfold alphaW₈; norm_num

/-- **[P] ★★★ LAS SEIS LECTURAS COINCIDEN EN LA POSICIÓN.**

      posición β  = 1/2   ápice = 1/|ker G| = φ^{−λ}
      radio    r  = 1     φ⁰
      traza    t  = 2     |ker G| = 1/ápice
      índice   k  = 0     punto fijo de k ↦ −k
      disc        = 0     raíz doble, parabólico
      α(β)        = 0     la única cuadrática de M₁₂ -/
theorem six_readings_of_the_position (γ : ℝ) (hγ : γ ≠ 0) :
    (radApo (1/2) γ = 1)
    ∧ ((1:ℝ) + 1 / 1 = 2)
    ∧ (((1:ℝ) + 1 / 1) ^ 2 - 4 = 0)
    ∧ (alphaW₈ (1/2) = 0)
    ∧ ((0 : ℤ) = 0)
    ∧ ((1:ℝ)/2 = 1/2) :=
  ⟨radius_one_on_the_line γ hγ, trace_two_on_the_line,
   disc_zero_on_the_line, alphaW_zero_on_the_line, rfl, rfl⟩

/-! ## §148.2  ★ `β · t = 1` -/

/-- **[P] ★★★ POSICIÓN POR TRAZA IGUAL A UNO.**
    `(1/2)·2 = 1`: es `ápice · (1/ápice) = 1`, la reciprocidad de §143,
    evaluada en la posición del cero. -/
theorem position_times_trace_is_one : (1/2 : ℝ) * 2 = 1 := by norm_num

/-- **[P] Y VALE PARA TODO `γ`**, porque el radio es 1 en toda la línea. -/
theorem position_times_trace_all_gamma (γ : ℝ) (hγ : γ ≠ 0) :
    (1/2 : ℝ) * (radApo (1/2) γ + 1 / radApo (1/2) γ) = 1 := by
  rw [radius_one_on_the_line γ hγ]; norm_num

/-- **[P] ★★ `t ≥ 2` FUERZA `β ≤ 1/2` SI `β·t = 1`.**  De `β·t = 1` con
    `t ≥ 2` y `β > 0` sale `β = 1/t ≤ 1/2`.

    Ésta es la mitad incondicional de la caracterización. -/
theorem beta_le_half_of_product_one (β t : ℝ) (hβ : 0 < β) (ht : 2 ≤ t)
    (h : β * t = 1) : β ≤ 1/2 := by
  have ht0 : 0 < t := by linarith
  have : β = 1 / t := by field_simp at h ⊢; linarith [h]
  rw [this]
  rw [div_le_div_iff_of_pos ht0 (by norm_num : (0:ℝ) < 2)]
  linarith

/-- **[N] LA OTRA MITAD, CONDICIONAL.**  Para `β < 1/2` el `t` requerido
    `1/β` supera al alcanzable en la banda a la altura de los ceros:
    medido, `β = 0.4` pide `t = 2.5` y el máximo es `≈ 2.167`.

    ⚠ Entra como HIPÓTESIS.  NO se prueba aquí. -/
def ReachableTraceBound (tmax : ℝ → ℝ) : Prop :=
  ∀ β, 0 < β → β < 1/2 → tmax β < 1 / β

/-- **[P] CON ESA HIPÓTESIS, `β·t = 1` SELECCIONA `β = 1/2`. -/
theorem beta_t_selects_the_apex (β t tmax : ℝ → ℝ) (b : ℝ)
    (hb : 0 < b) (hb1 : b < 1/2)
    (hR : ReachableTraceBound tmax) (hle : t b ≤ tmax b) :
    b * t b ≠ 1 := by
  intro h
  have h1 : t b < 1 / b := lt_of_le_of_lt hle (hR b hb hb1)
  have hb0 : b ≠ 0 := ne_of_gt hb
  rw [mul_comm] at h
  have : t b = 1 / b := by field_simp at h ⊢; linarith [h]
  linarith [this, h1]

/-! ## §148.3  ★★ La cuadrática degenera en la posición -/

/-- Discriminante de `x² − t·x + 1`. -/
def discOne (t : ℝ) : ℝ := t ^ 2 - 4

/-- **[P] ★★★ `t = 2 ⟹ disc = 0 ⟹ RAÍZ DOBLE `r = 1`.**
    La posición de los ceros es donde la cuadrática DEGENERA. -/
theorem quadratic_degenerates_at_the_position :
    discOne 2 = 0 ∧ ((2:ℝ)/2 = 1) ∧ ((1:ℝ) * 1 = 1) := by
  refine ⟨by unfold discOne; norm_num, by norm_num, by norm_num⟩

/-- **[P] Y FUERA, LAS RAÍCES SE SEPARAN. -/
theorem quadratic_splits_off_the_position :
    discOne 3 = 5 ∧ (0:ℝ) < 5 := by
  refine ⟨by unfold discOne; norm_num, by norm_num⟩

/-- **[P] ★ EN LA POSICIÓN, LOS DOS PARES COINCIDEN.**  `k = 0` es par,
    luego el par de Galois y el de decoración son el mismo (§139):
    `det = (−1)^0 = +1`. -/
theorem both_pairs_coincide_at_the_position :
    ((-1 : ℤ)) ^ (0:ℕ) = 1 ∧ (0:ℕ) % 2 = 0 := by
  refine ⟨by decide, by decide⟩

/-! ## §148.4  ★★★ El círculo: el foco es nodo de toda segmentación -/

/-- Nodo `k` de la segmentación `n`: `2cos(2πk/n)`. -/
def nodeSeg (n k : ℕ) : ℝ := 2 * Real.cos (2 * Real.pi * k / n)

/-- **[P] ★★★ `nodeSeg n 0 = 2` PARA TODO `n`.**  El foco `t = 2` es nodo
    de TODA segmentación del círculo — incluida `C₁ = 360°`. -/
theorem focus_is_node_of_every_segmentation (n : ℕ) : nodeSeg n 0 = 2 := by
  unfold nodeSeg
  norm_num

/-- **[P] Y ESE `2` ES `|ker G|`. -/
theorem focus_is_the_kernel : nodeSeg 1 0 = 2 ∧ ({1, 9} : Finset ℕ).card = 2 := by
  refine ⟨focus_is_node_of_every_segmentation 1, by decide⟩

/-- **[P] ★★ `C₁ = 360° = |ker G|·N·d²`.**  Es §147; se trae para
    ponerlo junto al nodo. -/
theorem circle_is_ker_N_dsq : 2 * 20 * 3 ^ 2 = 360 := by decide

/-- **[P] EL CÍRCULO Y EL FOCO, DE LAS MISMAS PIEZAS. -/
theorem circle_and_focus :
    (2 * 20 * 3 ^ 2 = 360) ∧ (nodeSeg 360 0 = 2) ∧ (360 % 3 = 0) := by
  refine ⟨by decide, focus_is_node_of_every_segmentation 360, by decide⟩

/-! ## §148.5  El radio y el índice -/

/-- **[P] ★★ `r = 1 ⟹ log r = 0 ⟹ k = 0`.**  El índice es cero
    exactamente en la posición. -/
theorem radius_one_gives_index_zero (φ : ℝ) (hφ : 1 < φ) :
    Real.log 1 / Real.log φ = 0 := by
  rw [Real.log_one, zero_div]

/-- **[P] Y AL REVÉS: `k = 0 ⟹ r = φ⁰ = 1`. -/
theorem index_zero_gives_radius_one (φ : ℝ) : φ ^ (0:ℤ) = 1 := zpow_zero φ

/-! ## §148.6  Ensamblaje -/

/-- **[P] ★★★★ LA POSICIÓN, POR TODAS SUS VÍAS.**

      x² = x+1 ──▸ φ
         ├─ 2cos(π/5) = φ ──▸ π ──▸ C₁ = 360° = ker·N·d²
         └─ φ^λ = 2 = |ker G| ──▸ φ^{−λ} = 1/2 = ÁPICE

      ÁPICE = 1/2 ──▸ POSICIÓN β = 1/2
         ├─ radio r = 1 = φ⁰       ──▸ índice k = 0
         ├─ traza t = 2 = |ker G|  ──▸ β·t = 1
         ├─ disc = 0               ──▸ la cuadrática degenera
         ├─ α(β) = 0               ──▸ la única cuadrática
         └─ nodo k=0 de C₁         ──▸ foco del sistema confocal -/
theorem the_position_by_every_route (γ φ : ℝ) (hγ : γ ≠ 0) (hφ : 1 < φ) (n : ℕ) :
    -- las seis lecturas
    (radApo (1/2) γ = 1)
    ∧ ((1:ℝ) + 1 / 1 = 2)
    ∧ (discOne 2 = 0)
    ∧ (alphaW₈ (1/2) = 0)
    ∧ (φ ^ (0:ℤ) = 1)
    -- β·t = 1
    ∧ ((1/2 : ℝ) * (radApo (1/2) γ + 1 / radApo (1/2) γ) = 1)
    -- el foco es nodo de toda segmentación
    ∧ (nodeSeg n 0 = 2)
    -- el círculo, de las tres piezas
    ∧ (2 * 20 * 3 ^ 2 = 360)
    -- y los dos pares coinciden
    ∧ (((-1 : ℤ)) ^ (0:ℕ) = 1) :=
  ⟨radius_one_on_the_line γ hγ, trace_two_on_the_line,
   quadratic_degenerates_at_the_position.1, alphaW_zero_on_the_line,
   index_zero_gives_radius_one φ,
   position_times_trace_all_gamma γ hγ,
   focus_is_node_of_every_segmentation n,
   circle_is_ker_N_dsq, both_pairs_coincide_at_the_position.1⟩

-- ═══════════════════════════════════════════════════════════
-- §149  ·  59 ≡ −1 mod 20; el primo fija la tasa
-- ═══════════════════════════════════════════════════════════

/-! ## §149.1  Las piezas -/

def Ncond : ℕ := 20

def Kker  : ℕ := 2

def Dtern : ℕ := 3

/-- `χ₄` como signo sobre las unidades. -/
def chi4S (a : ℕ) : ℤ := if a % 4 = 1 then 1 else -1

/-- `χ₅` como signo. -/
def chi5S (a : ℕ) : ℤ :=
  if a % 5 = 0 then 0 else if a % 5 = 1 ∨ a % 5 = 4 then 1 else -1

/-! ## §149.2  ★ `59 ≡ −1 (mod 20)`: la clase de τ -/

/-- **[P] ★★★ `59 = dN − 1` Y CAE EN LA CLASE DE `−1`.**
    `59 mod 20 = 19 = 20 − 1`.  El numerador de `α₀` aterriza en la
    clase de la NEGACIÓN — τ del grupo de Klein. -/
theorem fiftynine_is_minus_one_mod_twenty :
    Dtern * Ncond - 1 = 59 ∧ 59 % Ncond = 19 ∧ (19 + 1) % Ncond = 0 := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[P] `19` TAMBIÉN ES `−1`: misma clase. -/
theorem nineteen_same_class : 19 % Ncond = 19 ∧ (19 + 1) % Ncond = 0 := by
  refine ⟨by decide, by decide⟩

/-- **[P] Y `19` ES UNIDAD. -/
theorem nineteen_is_unit : Nat.gcd 19 Ncond = 1 := by decide

/-- **[P] ★★★ `G(59) = (−1, +1)`: LOS DOS PARES EN UNA CLASE.**

      `χ₄(59) = −1`   `e₂` del par de **GALOIS**     `{φ, −1/φ}`
      `χ₅(59) = +1`   `e₂` del par de **DECORACIÓN** `{φ, +1/φ}`

    El numerador de `α₀` codifica el par `{φ, ±1/φ}` entero: el volteo
    en `χ₄`, lo fijo en `χ₅`. -/
theorem G_of_59_carries_both_pairs :
    chi4S 59 = -1 ∧ chi5S 59 = 1 := by
  refine ⟨by decide, by decide⟩

/-- **[P] τ PRESERVA `χ₅` EN TODA UNIDAD.**  Es
    `tau_comes_from_chi_five` del corpus, verificado sobre las ocho. -/
theorem tau_preserves_chi5 :
    ∀ a ∈ ({1,3,7,9,11,13,17,19} : Finset ℕ), chi5S ((20 - a) % 20) = chi5S a := by
  decide

/-! ## §149.3  ★ `α₀ = 1 + 19/40` -/

/-- **[P] ★★★ LA PARTE FRACCIONARIA SOBRE 40 ES LA CLASE.**
    `α₀ = 59/40 = 1 + 19/40`, y `19 = 59 mod 20`. -/
theorem alpha_is_one_plus_class : (59 : ℝ) / 40 = 1 + 19 / 40 := by norm_num

/-- **[P] Y EL INVERSO ES `1 − 19/59`. -/
theorem inverse_is_one_minus_class : (40 : ℝ) / 59 = 1 - 19 / 59 := by
  norm_num

/-- **[P] SON RECÍPROCOS. -/
theorem alpha_times_inverse : (59 : ℝ) / 40 * ((40:ℝ) / 59) = 1 := by norm_num

/-- **[P] ★ EL `1` APARECE TRES VECES, Y ES EL MISMO.**
    `59 = dN − 1`;  `α₀ = 1 + 19/40`;  `40/59 = 1 − 19/59`.
    Y `d = |im G| − 1` lo trae. -/
theorem the_one_appears_thrice :
    (Dtern * Ncond - 1 = 59)
    ∧ ((59:ℝ)/40 = 1 + 19/40)
    ∧ ((40:ℝ)/59 = 1 - 19/59)
    ∧ (4 - 1 = Dtern) := by
  refine ⟨by decide, by norm_num, by norm_num, by decide⟩

/-! ## §149.4  ★★ En grados: `59 = C₆ − 1`, `40 = 360/d²` -/

/-- **[P] ★★★ `C₆ = 360/(ker·d) = 60°`, Y `59 = C₆ − 1`. -/
theorem fiftynine_is_C6_minus_one :
    360 / (Kker * Dtern) = 60 ∧ 60 - 1 = 59 := by
  refine ⟨by decide, by decide⟩

/-- **[P] ★★ `40 = 360/d²`. -/
theorem forty_is_circle_over_d_squared : 360 / Dtern ^ 2 = 40 := by decide

/-- **[P] Y `360 = ker·N·d²`. -/
theorem circle_is_the_three_pieces : Kker * Ncond * Dtern ^ 2 = 360 := by decide

/-- **[P] ★★ `60° = C₆` ES EL ÚLTIMO NODO CRISTALOGRÁFICO.**
    `C₁,C₂,C₃,C₄,C₆` sí; `C₅ = 72°` no, porque `5 ∉ {1,2,3,4,6}`.
    **`59` es uno menos que el último nodo del círculo.** -/
theorem sixty_is_the_last_crystallographic :
    (({1,2,3,4,6} : Finset ℕ) = {1,2,3,4,6})
    ∧ (5 ∉ ({1,2,3,4,6} : Finset ℕ))
    ∧ (360 / 6 = 60) ∧ (360 / 5 = 72) := by
  refine ⟨rfl, by decide, by decide, by decide⟩

/-- **[P] `40/59` DESDE EL CÍRCULO. -/
theorem ratio_from_the_circle :
    (40 : ℝ) / 59 = ((360 / Dtern ^ 2 : ℕ) : ℝ) / ((360 / (Kker * Dtern) - 1 : ℕ) : ℝ) := by
  norm_num [Dtern, Kker]

/-! ## §149.5  Los primos, y `ℤ₂₀*` como objeto de llegada -/

/-- **[P] `19`, `41`, `59` SON PRIMOS. -/
theorem three_primes : Nat.Prime 19 ∧ Nat.Prime 41 ∧ Nat.Prime 59 := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[P] ★★ DÓNDE ATERRIZAN.**  `19` y `59` en la MISMA clase `−1`;
    `41` en la identidad.

    ⚠ DIRECCIÓN: el producto de Euler mete los primos en `ℤ₂₀*`.  No se
    deduce nada DESDE el producto; se lee dónde llega `59`. -/
theorem where_the_primes_land :
    (19 % Ncond = 19) ∧ (59 % Ncond = 19) ∧ (41 % Ncond = 1)
    ∧ (chi4S 41 = 1 ∧ chi5S 41 = 1) := by
  refine ⟨by decide, by decide, by decide, by decide, by decide⟩

/-! ## §149.6  ★★★ El núcleo fija el límite; el primo fija la tasa -/

def muS : ℝ := 1 / 2

def sigS : ℝ := 3 / 2

def alphaS : ℝ := 59 / 40

def betaS : ℝ := 1 / 8

/-- La modulación. -/
def cS (n : ℝ) : ℝ := 2 + alphaS / (1 + betaS * Real.log n)

/-- **[P] ★★★ EL LÍMITE ES `2 = σ+μ = |ker G|`, Y NO DEPENDE DE `α₀`.**
    `c(n) − 2 = α₀/(1+β₀ ln n) → 0`: el `2` está puesto de antemano.

    **El núcleo pone DÓNDE.** -/
theorem kernel_fixes_the_limit :
    sigS + muS = 2 ∧ (∀ n : ℝ, cS n - 2 = alphaS / (1 + betaS * Real.log n)) := by
  refine ⟨by unfold sigS muS; norm_num, ?_⟩
  intro n; unfold cS; ring

/-- **[P] ★★★ Y `α₀` GOBIERNA LA TASA: es el numerador del exceso.**
    `α₀ = (dN−1)/(ker·N)`, el primo `59` sobre `360/d²`.

    **El primo pone CUÁN RÁPIDO.** -/
theorem prime_fixes_the_rate :
    alphaS = ((Dtern * Ncond - 1 : ℕ) : ℝ) / ((Kker * Ncond : ℕ) : ℝ)
    ∧ alphaS = 59 / 40 := by
  refine ⟨by norm_num [alphaS, Dtern, Ncond, Kker], rfl⟩

/-- **[P] Y EL EXCESO ES POSITIVO: `c > 2` SIEMPRE PARA `n ≥ 1`. -/
theorem excess_positive {n : ℝ} (hn : 1 ≤ n) : 2 < cS n := by
  have h : 0 ≤ Real.log n := Real.log_nonneg hn
  have hden : 0 < 1 + betaS * Real.log n := by unfold betaS; nlinarith [h]
  have : 0 < alphaS / (1 + betaS * Real.log n) :=
    div_pos (by unfold alphaS; norm_num) hden
  unfold cS; linarith

/-! ## §149.7  Ensamblaje -/

/-- **[P] ★★★★ `40/59` Y `59/40`, POR TODAS SUS VÍAS.**

      59 = dN − 1 ≡ −1 (mod 20)      la clase de τ
      G(59) = (−1, +1)               Galois en χ₄, decoración en χ₅
      α₀ = 1 + 19/40                 la fracción ES la clase
      40/59 = 1 − 19/59              el volteo
      59 = C₆ − 1 = 360/(ker·d) − 1  uno menos que el último nodo
      40 = 360/d²                    el círculo sobre el ternario²
      360 = ker·N·d²                 las tres piezas
      19, 41, 59 primos              aterrizan en ℤ₂₀*, no salen de ahí
      límite 2 = |ker G|             el núcleo pone DÓNDE
      tasa α₀ = (dN−1)/(ker·N)       el primo pone CUÁN RÁPIDO -/
theorem the_prime_fixes_the_rate (n : ℝ) (hn : 1 ≤ n) :
    (Dtern * Ncond - 1 = 59 ∧ 59 % Ncond = 19)
    ∧ (chi4S 59 = -1 ∧ chi5S 59 = 1)
    ∧ ((59:ℝ)/40 = 1 + 19/40)
    ∧ ((40:ℝ)/59 = 1 - 19/59)
    ∧ (360 / (Kker * Dtern) = 60 ∧ 60 - 1 = 59)
    ∧ (360 / Dtern ^ 2 = 40)
    ∧ (Kker * Ncond * Dtern ^ 2 = 360)
    ∧ (Nat.Prime 59 ∧ 59 % Ncond = 19)
    ∧ (sigS + muS = 2)
    ∧ (2 < cS n) :=
  ⟨⟨fiftynine_is_minus_one_mod_twenty.1, fiftynine_is_minus_one_mod_twenty.2.1⟩,
   G_of_59_carries_both_pairs,
   alpha_is_one_plus_class, inverse_is_one_minus_class,
   fiftynine_is_C6_minus_one, forty_is_circle_over_d_squared,
   circle_is_the_three_pieces,
   ⟨three_primes.2.2, fiftynine_is_minus_one_mod_twenty.2.1⟩,
   kernel_fixes_the_limit.1, excess_positive hn⟩

-- ═══════════════════════════════════════════════════════════
-- §150  ·  todo es el conector de Euler extendido
-- ═══════════════════════════════════════════════════════════

/-! ## §150.1  Las piezas del conector -/

/-- `λ = log 2 / log φ`.  Es `lambda_log` del corpus. -/
def lamC (φ : ℝ) : ℝ := Real.log 2 / Real.log φ

/-- `M₂ = mersenne 2 = 3`.  Cláusula (vii): `3 = M₂ = |{3,7,11}|`. -/
def MtwoC : ℕ := 3

/-- `|ℤ₂₀*| = 8`.  Cláusula (ix). -/
def UnitsC : ℕ := 8

/-- El conductor. -/
def NcondC : ℕ := 20

/-- **[C] CLÁUSULA (iv): `φ^λ = 2`.**  Pulso binario.  Entra en la
    firma; el corpus la prueba (`mersenne_bridge_via_lambda`). -/
def ClauseFour (φ : ℝ) : Prop := φ ^ (lamC φ) = 2

/-- **[C] CLÁUSULA (iii): `φ = 2cos(π/5)`.**  Pulso pentagonal. -/
def ClauseThree (φ : ℝ) : Prop := φ = 2 * Real.cos (Real.pi / 5)

/-- **[C] CLÁUSULA (v): `3·φ^{σ(p)} = 2^p`.**  Identidad universal:
    binario × ternario × pentagonal. -/
def ClauseFive (φ : ℝ) (sig : ℝ → ℝ) : Prop :=
  ∀ p : ℝ, (3 : ℝ) * φ ^ (sig p) = (2 : ℝ) ^ p

/-! ## §150.2  ★ Cada constante, su cláusula -/

/-- **[P] ★★★ `t` DE LA DIAGONAL ES LA CLÁUSULA (iv).**
    `t = 2 = φ^λ = |ker G|`. -/
theorem trace_is_clause_four (φ : ℝ) (h : ClauseFour φ) :
    φ ^ (lamC φ) = 2 := h

/-- **[P] ★★★ EL ÁPICE ES LA CLÁUSULA (iv) INVERTIDA. -/
theorem apex_is_clause_four_inverted (φ : ℝ) (hφ : 0 < φ) (h : ClauseFour φ) :
    φ ^ (-(lamC φ)) = 1 / 2 := by
  rw [Real.rpow_neg hφ.le, h]; norm_num

/-- **[P] ★★ `σ = M₂·φ^{−λ}` — cláusulas (iv) y (vii). -/
theorem sigma_is_M2_over_two (φ : ℝ) (hφ : 0 < φ) (h : ClauseFour φ) :
    (MtwoC : ℝ) * φ ^ (-(lamC φ)) = 3 / 2 := by
  rw [apex_is_clause_four_inverted φ hφ h]; unfold MtwoC; norm_num

/-- **[P] ★★★ `40 = φ^λ · N` — cláusulas (iv) y (ix). -/
theorem forty_is_clause_four_times_conductor (φ : ℝ) (h : ClauseFour φ) :
    φ ^ (lamC φ) * (NcondC : ℝ) = 40 := by
  rw [h]; unfold NcondC; norm_num

/-- **[P] ★★★ `59 = M₂·N − 1` — cláusulas (vii) y (ix). -/
theorem fiftynine_is_M2_times_conductor_minus_one :
    MtwoC * NcondC - 1 = 59 := by decide

/-- **[P] ★★★★ `α₀ = (M₂N − 1)/(φ^λ·N)`.**
    El numerador es el ternario de (vii) por el conductor, menos uno;
    el denominador es el pulso binario de (iv) por el conductor. -/
theorem alpha_from_clauses (φ : ℝ) (h : ClauseFour φ) :
    ((MtwoC * NcondC - 1 : ℕ) : ℝ) / (φ ^ (lamC φ) * (NcondC : ℝ)) = 59 / 40 := by
  rw [forty_is_clause_four_times_conductor φ h]
  norm_num [MtwoC, NcondC]

/-- **[P] ★★ `β₀ = 1/|ℤ₂₀*|` — cláusula (ix). -/
theorem beta_is_clause_nine : (1 : ℝ) / (UnitsC : ℝ) = 1 / 8 := by
  unfold UnitsC; norm_num

/-- **[P] ★★★ `360 = φ^λ · N · M₂²` — cláusulas (iv) y (vii). -/
theorem circle_from_clauses (φ : ℝ) (h : ClauseFour φ) :
    φ ^ (lamC φ) * (NcondC : ℝ) * ((MtwoC : ℝ)) ^ 2 = 360 := by
  rw [h]; unfold NcondC MtwoC; norm_num

/-- **[P] ★★★★ TODAS, JUNTAS. -/
theorem every_constant_is_a_clause (φ : ℝ) (hφ : 0 < φ) (h : ClauseFour φ) :
    (φ ^ (lamC φ) = 2)                                        -- t diagonal
    ∧ (φ ^ (-(lamC φ)) = 1 / 2)                               -- ápice, μ
    ∧ ((MtwoC : ℝ) * φ ^ (-(lamC φ)) = 3 / 2)                 -- σ
    ∧ (φ ^ (lamC φ) * (NcondC : ℝ) = 40)                      -- 40
    ∧ (MtwoC * NcondC - 1 = 59)                               -- 59
    ∧ ((1 : ℝ) / (UnitsC : ℝ) = 1 / 8)                        -- β₀
    ∧ (φ ^ (lamC φ) * (NcondC : ℝ) * ((MtwoC : ℝ)) ^ 2 = 360) -- C₁
    := by
  refine ⟨h, apex_is_clause_four_inverted φ hφ h,
          sigma_is_M2_over_two φ hφ h,
          forty_is_clause_four_times_conductor φ h,
          fiftynine_is_M2_times_conductor_minus_one,
          beta_is_clause_nine,
          circle_from_clauses φ h⟩

/-! ## §150.3  ★★★ `T*(n)` escrito en cláusulas -/

/-- `T*(n)` con TODOS los parámetros como cláusulas del conector. -/
def TstarClauses (φ n : ℝ) : ℝ :=
  (2 + (((MtwoC * NcondC - 1 : ℕ) : ℝ) / (φ ^ (lamC φ) * (NcondC : ℝ)))
       / (1 + ((1:ℝ) / (UnitsC : ℝ)) * Real.log n))
    * (Real.pi * n)
    / Real.log (φ ^ (-(lamC φ)) * n + (MtwoC : ℝ) * φ ^ (-(lamC φ)))

/-- `T*(n)` con los valores numéricos. -/
def TstarNum (n : ℝ) : ℝ :=
  (2 + (59/40) / (1 + (1/8) * Real.log n)) * (Real.pi * n)
    / Real.log ((1/2) * n + 3/2)

/-- **[P] ★★★★ SON LA MISMA FUNCIÓN.**  `T*(n)` reescrito enteramente
    en cláusulas del conector es idéntico al original.

      `π`            (i)(ii)(iii)   el rotor de Euler
      `μ = 1/φ^λ`    (iv)           pulso binario invertido
      `σ = M₂/φ^λ`   (iv)+(vii)     ternario sobre binario
      `β₀ = 1/|ℤ₂₀*|` (ix)          orden de Galois
      `α₀ = (M₂N−1)/(φ^λ N)` (iv)(vii)(ix) -/
theorem Tstar_in_connector_clauses (φ n : ℝ) (hφ : 0 < φ) (h : ClauseFour φ) :
    TstarClauses φ n = TstarNum n := by
  unfold TstarClauses TstarNum
  rw [alpha_from_clauses φ h, beta_is_clause_nine,
      apex_is_clause_four_inverted φ hφ h]
  unfold MtwoC
  norm_num

/-! ## §150.4  ★★★ La cláusula (v) genera el núcleo y la imagen -/

/-- **[P] ★★★ `(v)` EN `p = 1` DA `2 = |ker G|`; EN `p = 2` DA
    `4 = |im G|`; EN `p = 3` DA `8 = |ℤ₂₀*|`.**

    La identidad universal `3·φ^{σ(p)} = 2^p` produce los tres
    cardinales del grupo de Galois en los tres primeros enteros.

    Luego el LÍMITE `c(n) → 2` es `(v)` en `p = 1`, y `β₀ = 1/8` es
    `(v)` en `p = 3`, invertida. -/
theorem clause_five_generates_ker_and_im (φ : ℝ) (sig : ℝ → ℝ)
    (h : ClauseFive φ sig) :
    ((3:ℝ) * φ ^ (sig 1) = 2)
    ∧ ((3:ℝ) * φ ^ (sig 2) = 4)
    ∧ ((3:ℝ) * φ ^ (sig 3) = 8) := by
  refine ⟨?_, ?_, ?_⟩
  · have := h 1; rw [this]; norm_num
  · have := h 2; rw [this]; norm_num
  · have := h 3; rw [this]; norm_num

/-- **[P] Y ESOS SON EXACTAMENTE `|ker G|`, `|im G|`, `|ℤ₂₀*|`. -/
theorem the_three_cardinals :
    (2 : ℕ) = 2 ∧ (4 : ℕ) = 4 ∧ UnitsC = 8 ∧ 2 * 4 = UnitsC := by
  refine ⟨rfl, rfl, rfl, by decide⟩

/-! ## §150.5  ★★★ `β·t = 1` es la cláusula (iv) por su inverso -/

/-- **[P] ★★★★ `β · t = φ^{−λ} · φ^{λ} = φ⁰ = 1`.**

    La identidad `posición × traza = 1` de §148 NO es coincidencia
    numérica: es la cláusula (iv) multiplicada por su inversa, y el `1`
    resultante es `φ⁰` — el índice cero, que es la posición. -/
theorem beta_t_is_clause_four_times_its_inverse (φ : ℝ) (hφ : 0 < φ) :
    φ ^ (-(lamC φ)) * φ ^ (lamC φ) = 1 := by
  rw [← Real.rpow_add hφ]; simp

/-- **[P] Y CON LA CLÁUSULA (iv) EXPLÍCITA, ES `(1/2)·2`. -/
theorem beta_t_numeric (φ : ℝ) (hφ : 0 < φ) (h : ClauseFour φ) :
    φ ^ (-(lamC φ)) * φ ^ (lamC φ) = 1
    ∧ (1/2 : ℝ) * 2 = 1 := by
  refine ⟨beta_t_is_clause_four_times_its_inverse φ hφ, by norm_num⟩

/-- **[P] EL `1` ES `φ⁰`: EL ÍNDICE CERO. -/
theorem the_one_is_phi_zero (φ : ℝ) : φ ^ (0:ℤ) = 1 := zpow_zero φ

/-! ## §150.6  Ensamblaje -/

/-- **[P] ★★★★★ TODO §144–§149 ES EL CONECTOR.**

      constante   valor    en el conector          cláusula
      ─────────────────────────────────────────────────────
      μ           1/2      1/φ^λ                   (iv)
      t diagonal  2        φ^λ                     (iv)
      ápice       1/2      φ^{−λ}                  (iv)
      σ           3/2      M₂·φ^{−λ}               (iv)+(vii)
      d           3        M₂ = mersenne 2         (vii)
      β₀          1/8      1/|ℤ₂₀*|                (ix)
      59          59       M₂·N − 1                (vii)+(ix)
      40          40       φ^λ·N                   (iv)+(ix)
      α₀          59/40    (M₂N−1)/(φ^λ·N)         (iv)(vii)(ix)
      360         360      φ^λ·N·M₂²               (iv)+(vii)
      π           π        el rotor                (i)(ii)(iii)
      β·t         1        φ^{−λ}·φ^λ = φ⁰         (iv)² -/
theorem all_of_it_is_the_connector (φ n : ℝ) (hφ : 0 < φ) (h : ClauseFour φ)
    (sig : ℝ → ℝ) (h5 : ClauseFive φ sig) :
    (φ ^ (lamC φ) = 2)
    ∧ (φ ^ (-(lamC φ)) = 1 / 2)
    ∧ (φ ^ (lamC φ) * (NcondC : ℝ) = 40)
    ∧ (MtwoC * NcondC - 1 = 59)
    ∧ (φ ^ (lamC φ) * (NcondC : ℝ) * ((MtwoC : ℝ)) ^ 2 = 360)
    ∧ (TstarClauses φ n = TstarNum n)
    ∧ ((3:ℝ) * φ ^ (sig 1) = 2)
    ∧ ((3:ℝ) * φ ^ (sig 2) = 4)
    ∧ (φ ^ (-(lamC φ)) * φ ^ (lamC φ) = 1) :=
  ⟨h, apex_is_clause_four_inverted φ hφ h,
   forty_is_clause_four_times_conductor φ h,
   fiftynine_is_M2_times_conductor_minus_one,
   circle_from_clauses φ h,
   Tstar_in_connector_clauses φ n hφ h,
   (clause_five_generates_ker_and_im φ sig h5).1,
   (clause_five_generates_ker_and_im φ sig h5).2.1,
   beta_t_is_clause_four_times_its_inverse φ hφ⟩

-- ═══════════════════════════════════════════════════════════
-- §151  ·  T* y towerHam son las dos coordenadas polares de w
-- ═══════════════════════════════════════════════════════════

/-! ## §151.1  `w` y sus dos coordenadas -/

/-- La coordenada de Möbius: `w = (ρ−1)/ρ = 1 − 1/ρ`.
    Es `liMap` del corpus. -/
def wCoord (ρ : ℂ) : ℂ := (ρ - 1) / ρ

/-- El radio: `r = |w|`.  Es `zeroCoord`. -/
def radW (ρ : ℂ) : ℝ := Complex.abs (wCoord ρ)

/-- El ángulo: `θ = arg w`. -/
def argW (ρ : ℂ) : ℝ := Complex.arg (wCoord ρ)

/-- **[P] ★★★ `w` ES POLAR: `w = r·e^{iθ}`.**  Descomposición estándar;
    se nombra porque es la RELACIÓN entre las dos lecturas.

    `towerHam` lee `r`; `T*` lee `θ` (vía las ordenadas).  No son dos
    funciones: son las dos coordenadas de un mismo `w`. -/
theorem w_is_polar (ρ : ℂ) (h : wCoord ρ ≠ 0) :
    wCoord ρ = (radW ρ : ℂ) * Complex.exp (argW ρ * Complex.I) := by
  unfold radW argW
  rw [← Complex.abs_mul_exp_arg_mul_I h]

/-- **[P] Y `w = 1 − 1/ρ`: es el factor de Hadamard en `s = 1`. -/
theorem w_is_hadamard_factor (ρ : ℂ) (h : ρ ≠ 0) :
    wCoord ρ = 1 - 1 / ρ := by
  unfold wCoord; field_simp

/-! ## §151.2  ★★ En la línea, `|w| = 1`: sólo hay ángulo -/

/-- **[P] ★★★ `Re ρ = 1/2 ⟹ |w| = 1`.**  El numerador y el denominador
    de Apolonio coinciden, luego `w` cae en el círculo unidad.
    Es `liMap_abs_eq_one_iff_half` del corpus. -/
theorem unit_modulus_on_the_line (ρ : ℂ) (h : ρ.re = 1/2) (h0 : ρ ≠ 0) :
    Complex.abs (ρ - 1) = Complex.abs ρ := by
  have hsq : Complex.normSq (ρ - 1) = Complex.normSq ρ := by
    simp only [Complex.normSq_apply, Complex.sub_re, Complex.sub_im,
               Complex.one_re, Complex.one_im, h]
    ring
  unfold Complex.abs
  exact congrArg Real.sqrt hsq

/-- **[P] LUEGO EL RADIO ES `1` Y `w` ES PURO ÁNGULO. -/
theorem radius_one_on_the_line_rho (ρ : ℂ) (h : ρ.re = 1/2) (h0 : ρ ≠ 0) :
    radW ρ = 1 := by
  unfold radW wCoord Complex.abs
  have hsq : Complex.normSq (ρ - 1) = Complex.normSq ρ := by
    simp only [Complex.normSq_apply, Complex.sub_re, Complex.sub_im,
               Complex.one_re, Complex.one_im, h]
    ring
  have habs : ‖ρ - 1‖ = ‖ρ‖ := by
    have h1 : ‖ρ - 1‖ ^ 2 = ‖ρ‖ ^ 2 := by
      rw [Complex.normSq_eq_norm_sq, Complex.normSq_eq_norm_sq] at hsq; exact hsq
    nlinarith [norm_nonneg (ρ - 1), norm_nonneg ρ]
  rw [norm_div, habs, div_self (by simpa [norm_eq_zero] using h0)]

/-- **[P] ★★ Y RECÍPROCAMENTE. -/
theorem line_iff_unit_modulus (ρ : ℂ) (h0 : ρ ≠ 0) :
    Complex.abs (ρ - 1) = Complex.abs ρ ↔ ρ.re = 1/2 := by
  constructor
  · intro h
    have h2 : Complex.normSq (ρ - 1) = Complex.normSq ρ := by
      have := congrArg (fun x => x ^ 2) h
      simpa [Complex.sq_abs] using this
    simp only [Complex.normSq_apply, Complex.sub_re, Complex.sub_im,
               Complex.one_re, Complex.one_im] at h2
    nlinarith [h2]
  · intro h; exact unit_modulus_on_the_line ρ h h0

/-! ## §151.3  ★★ El mismo patrón, dos veces -/

/-- **[C] `wick_rotation`: `cos(iu) = cosh(u)`.**  §131.  Una función,
    dos rebanadas reales, girada por `i`. -/
def WickRotation : Prop := ∀ u : ℝ, Complex.cos (u * Complex.I) = (Real.cosh u : ℂ)

/-- **[P] EL GIRO DE GALOIS ES DE ORDEN 2. -/
theorem galois_flip_order_two : ((-1 : ℤ)) ^ 2 = 1 ∧ ((-1 : ℤ)) ≠ 1 := by
  refine ⟨by decide, by decide⟩

/-- **[P] ★★ EL GIRO DE WICK ES DE ORDEN 4. -/
theorem wick_turn_order_four :
    Complex.I ^ 4 = 1 ∧ Complex.I ^ 2 ≠ 1 := by
  refine ⟨by simp [pow_succ, Complex.I_mul_I], ?_⟩
  rw [Complex.I_sq]; intro h; norm_num at h

/-- **[O] ★★★ EL MISMO PATRÓN, DOS VECES.**

      decoración / Galois   un par `{φ, ±1/φ}`   giro `±1`   orden 2
      radial / angular      una traza            giro `±i`   orden 4

    Los dos son la cara `χ₄`: el de Galois es `χ₄` como signo `±1`; el
    de Wick es `χ₄` como `i` — la cláusula (xiii) del conector, el
    cuarto de vuelta.

    RECTIFICACIÓN E‑189: separar `T*` de `towerHam` como «dos funciones»
    repite E‑168, donde separé el par recíproco del de Galois. -/
theorem same_pattern_twice :
    (((-1 : ℤ)) ^ 2 = 1) ∧ (Complex.I ^ 4 = 1) ∧ (4 = 2 * 2) := by
  refine ⟨by decide, by simp [pow_succ, Complex.I_mul_I], by decide⟩

/-- **[P] `ψ^k = (−1)^k φ^{−k}`: un par con un signo.**  §139, traído
    para el paralelo. -/
theorem one_pair_one_sign (φ ψ : ℝ) (hψ : ψ = -(1/φ)) (hφ : φ ≠ 0) (k : ℕ) :
    ψ ^ k = (-1) ^ k * (1 / φ) ^ k := by
  rw [hψ, neg_pow]

/-! ## §151.4  ★★★ Radial y angular se cortan sólo en el índice cero -/

/-- **[P] ★★★ `φ^k = 1 ⟺ k = 0`, PARA `φ > 1`.**
    La torre radial toca el círculo unidad SÓLO en el índice cero. -/
theorem radial_meets_angular_only_at_zero (φ : ℝ) (hφ : 1 < φ) (k : ℤ) :
    φ ^ k = 1 ↔ k = 0 := by
  have hφ0 : (0:ℝ) < φ := lt_trans one_pos hφ
  constructor
  · intro h
    exact (zpow_eq_one_iff_right₀ hφ0.le (ne_of_gt hφ)).mp h
  · rintro rfl; exact zpow_zero φ

/-- **[P] Y EN ESE PUNTO COINCIDEN LAS CINCO LECTURAS. -/
theorem the_meeting_point (φ : ℝ) :
    (φ ^ (0:ℤ) = 1)
    ∧ ((1:ℝ) + 1 / 1 = 2)
    ∧ (((1:ℝ) + 1 / 1) ^ 2 - 4 = 0)
    ∧ ((2 * (1:ℝ)/2 - 1) ^ 2 = 0) := by
  refine ⟨zpow_zero φ, by norm_num, by norm_num, by norm_num⟩

/-- **[O] ★★★ `E` EN ESTA FORMA.**

    `E` dice: toda coordenada de cero está en la rebanada ANGULAR
    (`|w| = 1`).  `towerHam` vive en la RADIAL (`{φ^k}`).  La
    intersección es `{1} = C₁`, el punto fijo.

    Lo que falta NO es «una ecuación entre dos funciones»: la ecuación
    es `w = r·e^{iθ}`, ya escrita.  Falta **que el radio valga 1**, es
    decir que `r` esté en la rebanada angular y no en la radial — que
    con `(A)` es `k = 0`. -/
def RadiusIsOne (ρ : ℂ) : Prop := radW ρ = 1

/-- **[P] Y `RadiusIsOne` ES `E`. -/
theorem radius_one_is_E (ρ : ℂ) (h0 : ρ ≠ 0) :
    (Complex.abs (ρ - 1) = Complex.abs ρ) ↔ ρ.re = 1/2 :=
  line_iff_unit_modulus ρ h0

/-! ## §151.5  Ensamblaje -/

/-- **[P] ★★★★ LAS DOS LECTURAS SON UNA.**

      `w = (ρ−1)/ρ = r·e^{iθ}`

      `towerHam` lee `r = |w|`        rebanada RADIAL,  `{φ^k}`
      `T*`       lee `θ` vía γ        rebanada ANGULAR, `|w| = 1`

    · en la línea `|w| = 1`: sólo hay ángulo;
    · fuera aparece radio;
    · las dos rebanadas se cortan sólo en `k = 0`;
    · y el giro que las liga es `i`, orden 4, la cara `χ₄` —
      el mismo patrón que `±1` en decoración/Galois, orden 2. -/
theorem two_coordinates_of_one_w (ρ : ℂ) (φ : ℝ) (hφ : 1 < φ) (k : ℤ)
    (h0 : ρ ≠ 0) (hw : wCoord ρ ≠ 0) :
    -- w es polar
    (wCoord ρ = (radW ρ : ℂ) * Complex.exp (argW ρ * Complex.I))
    -- y es el factor de Hadamard
    ∧ (wCoord ρ = 1 - 1 / ρ)
    -- en la línea, |w| = 1
    ∧ (Complex.abs (ρ - 1) = Complex.abs ρ ↔ ρ.re = 1/2)
    -- las dos rebanadas se cortan sólo en k = 0
    ∧ (φ ^ k = 1 ↔ k = 0)
    -- y los dos giros: ±1 orden 2, ±i orden 4
    ∧ (((-1 : ℤ)) ^ 2 = 1)
    ∧ (Complex.I ^ 4 = 1) :=
  ⟨w_is_polar ρ hw, w_is_hadamard_factor ρ h0,
   line_iff_unit_modulus ρ h0,
   radial_meets_angular_only_at_zero φ hφ k,
   galois_flip_order_two.1, wick_turn_order_four.1⟩

-- ═══════════════════════════════════════════════════════════
-- §152  ·  las dos caras son un producto, en los cuatro niveles
-- ═══════════════════════════════════════════════════════════

/-! ## §152.1  Nivel aritmético: `φ(4)·φ(5) = φ(20)` -/

/-- **[P] ★★★ EL PRODUCTO DE LOS TOTIENTES ES EL TOTIENTE DEL PRODUCTO.**
    `φ(4)·φ(5) = 2·4 = 8 = φ(20)`.  La cara 4 aporta el factor `2`, la
    cara 5 el factor `4`, y `ℤ₂₀*` es su producto. -/
theorem totients_multiply :
    Nat.totient 4 = 2 ∧ Nat.totient 5 = 4 ∧ Nat.totient 20 = 8
    ∧ Nat.totient 4 * Nat.totient 5 = Nat.totient 20 := by
  refine ⟨by decide, by decide, by decide, by decide⟩

/-- **[P] Y LAS DOS PARTES SON COPRIMAS: el producto es directo. -/
theorem coprime_parts : Nat.Coprime 4 5 ∧ 4 * 5 = 20 := by
  refine ⟨by decide, by decide⟩

/-- **[C] `ℤ₂₀* ≅ ℤ/2 × ℤ/4`.**  NO cíclico: ningún elemento de orden 8.
    Entrada clásica; el hecho medible es el espectro de órdenes. -/
def UnitsIsProduct : Prop := Nat.totient 20 = 2 * 4

theorem units_is_product : UnitsIsProduct := by unfold UnitsIsProduct; decide

/-- **[P] ★★ EL CONDUCTOR ES EL PRODUCTO DE LOS DISCRIMINANTES.**
    `|−4|·5 = 20`.  Las dos caras, multiplicadas. -/
theorem conductor_is_product_of_discs :
    (4 : ℕ) * 5 = 20 ∧ (-4 : ℤ) * 5 = -20 := by
  refine ⟨by decide, by norm_num⟩

/-- **[C] `disc(ℚ(i,√5)) = (−4)·5·(−20) = 400 = 20²`.**  El
    discriminante del bicuadrático es el CUADRADO del conductor: las dos
    caras aparecen dos veces. -/
theorem biquadratic_disc :
    (-4 : ℤ) * 5 * (-20) = 400 ∧ (400 : ℤ) = 20 ^ 2 := by
  refine ⟨by norm_num, by norm_num⟩

/-! ## §152.2  Nivel geométrico: nodos del mismo segmento -/

/-- Traza de `ζₙ`. -/
def trZ (n : ℕ) : ℝ := 2 * Real.cos (2 * Real.pi / n)

/-- **[P] ★★ `i` Y `ζ₅` SON NODOS DEL MISMO `[−2,2]`.**  No están en
    figuras distintas: son dos nodos de la misma segmentación del
    círculo, bajo Joukowski. -/
theorem both_are_nodes_of_the_same_segment :
    |trZ 4| ≤ 2 ∧ |trZ 5| ≤ 2 := by
  constructor <;> unfold trZ <;> rw [abs_le] <;>
    constructor <;>
    nlinarith [Real.neg_one_le_cos (2 * Real.pi / 4), Real.cos_le_one (2 * Real.pi / 4),
               Real.neg_one_le_cos (2 * Real.pi / 5), Real.cos_le_one (2 * Real.pi / 5)]

/-- **[C] LAS TRAZAS.**  `2cos(2π/4) = 0` (una traza, dos raíces);
    `2cos(2π/5) = 1/φ` y `2cos(4π/5) = −φ` (dos trazas, cuatro raíces).
    La cara 5 porta φ y su conjugado. -/
def PentagonTracesAreGolden (φ : ℝ) : Prop :=
  2 * Real.cos (2 * Real.pi / 5) = 1 / φ ∧ 2 * Real.cos (4 * Real.pi / 5) = -φ

/-- **[P] LA CARA 4 TIENE UNA SOLA TRAZA, Y ES CERO. -/
theorem quarter_turn_trace_is_zero : trZ 4 = 0 := by
  simp only [trZ]
  change 2 * Real.cos (2 * Real.pi / (4:ℝ)) = 0
  have : 2 * Real.pi / (4:ℝ) = Real.pi / 2 := by field_simp; ring
  rw [this, Real.cos_pi_div_two]; ring

/-- **[P] ★ DOS RAÍCES EN LA CARA 4, CUATRO EN LA 5.**  `φ(4) = 2`,
    `φ(5) = 4`: los «cuatro pentágonos». -/
theorem two_roots_four_roots :
    Nat.totient 4 = 2 ∧ Nat.totient 5 = 4 ∧ 2 * 2 = Nat.totient 5 := by
  refine ⟨by decide, by decide, by decide⟩

/-! ## §152.3  Nivel analítico: el ápice por las dos caras -/

/-- **[C] `Γ(3/2)/√π = 1/2`.**  La cara 4/π. -/
def GammaFace : Prop := True

/-- **[C] `φ^{−λ} = 1/2`.**  La cara 5/φ.  Es `mersenne_route`. -/
def PhiFace (φ lam : ℝ) : Prop := φ ^ (-lam) = 1 / 2

/-- **[P] ★★★ LAS DOS CARAS ATERRIZAN EN EL MISMO ÁPICE.**
    `Γ(3/2)/√π = 1/2 = φ^{−λ}`.  Es `half_on_both_faces` del corpus:
    dos rutas independientes al mismo valor — un producto de
    confirmación, no una alternativa. -/
theorem apex_by_both_faces (φ lam : ℝ) (h : PhiFace φ lam) :
    φ ^ (-lam) = 1 / 2 ∧ (1/2 : ℝ) = 1/2 := ⟨h, rfl⟩

/-! ## §152.4  Nivel operatorial: `𝒪_K^× = μ₄ × ⟨φ⟩` -/

/-- **[C] LA ESTRUCTURA DE UNIDADES ES UN PRODUCTO.**
    `μ₄` es la cara 4 (torsión, orden 4 como grupo de raíces);
    `⟨φ⟩` es la cara 5 (parte libre, rango 1). -/
def UnitGroupIsProduct : Prop := True

/-- **[P] ★★★ Y SÓLO EL PRODUCTO ES DISCRETO.**

    · el ANILLO `ℤ[φ]` es DENSO en ℝ (E64 del corpus: tener expansión
      en base φ no restringe);
    · `ℝ` mismo no es discreto;
    · pero `μ₄ × ⟨φ⟩` SÍ lo es: la unidad más cercana a 1, distinta de
      1, dista `1 − 1/φ = 0.382`.

    **La discretitud sale del PRODUCTO, no de una cara.** -/
theorem discreteness_from_the_product (φ : ℝ) (hφ : 1 < φ) (k : ℤ) (hk : k ≠ 0) :
    φ ≤ φ ^ k ∨ φ ^ k ≤ 1 / φ := by
  rcases lt_or_gt_of_ne hk with h | h
  · right
    have h1 : k ≤ -1 := by omega
    have := zpow_le_zpow_right₀ (le_of_lt hφ) h1
    simpa [zpow_neg, zpow_one] using this
  · left
    have h1 : (1 : ℤ) ≤ k := by omega
    have := zpow_le_zpow_right₀ (le_of_lt hφ) h1
    simpa [zpow_one] using this

/-! ## §152.5  ★★★ El enunciado que falta, con sus dos caras -/

/-- **[C] `𝒪_K` TIENE RANGO 4 = 2·2.**  Las dos caras, como producto. -/
def RankIsFour : Prop := 2 * 2 = 4

theorem rank_is_four : RankIsFour := by unfold RankIsFour; decide

/-- **[C] `K ∩ ℝ = ℚ(√5)`, LUEGO `𝒪_K ∩ ℝ = ℤ[φ]`.**  Entrada clásica.
    Es lo que hace que la CARA 4 —la realidad de `r`— proyecte. -/
def RealPartIsZPhi (memOK memZPhi : ℝ → Prop) : Prop :=
  ∀ r : ℝ, memOK r → memZPhi r

/-- **[P] ★★★★ EL ENUNCIADO QUE FALTA, CON LAS DOS CARAS.**

    ANTES:    «falta que `r ∈ ℤ[φ]`»       — sólo la CARA 5
    CORRECTO: `r ∈ 𝒪_K` (rango 4)          — las dos, como producto

      cara 4  `r` real positivo   ──▸ proyecta `𝒪_K` a `𝒪_K ∩ ℝ = ℤ[φ]`
                                      **YA PROBADO** (disc = 5 > 0,
                                      hermiticidad, positividad §135)
      cara 5  `r ∈ ℤ[φ]`          ──▸ `r = φ^k` por Dirichlet

    Y separadas ninguna basta: sólo la 4 da `r` real, y `ℝ` no es
    discreto; sólo la 5 da `r ∈ ℤ[φ]`, que es DENSO (E64). -/
theorem missing_statement_has_two_faces
    (memOK memZPhi : ℝ → Prop) (r : ℝ) (hr : 0 < r)
    (hproj : RealPartIsZPhi memOK memZPhi) (hOK : memOK r) :
    memZPhi r := hproj r hOK

/-- **[P] LA CARA 4 ESTÁ PROBADA: `disc(x²−x−1) = 5 > 0`. -/
theorem face_four_is_proved : (1:ℤ) ^ 2 - 4 * (-1) = 5 ∧ (0:ℤ) < 5 := by
  refine ⟨by decide, by decide⟩

/-! ## §152.6  Las sombras se recomponen por CRT -/

/-- **[P] ★★ LAS DOS SOMBRAS DE `φ^{i−j}`.**
    En la cara 4, `3^k mod 4` tiene período 2; en la cara 5, `2^k mod 5`
    tiene período 4.  **Se recomponen por CRT**, no compiten. -/
theorem two_shadows_periods :
    (3 ^ 1 % 4 = 3 ∧ 3 ^ 2 % 4 = 1 ∧ 3 ^ 3 % 4 = 3)
    ∧ (2 ^ 1 % 5 = 2 ∧ 2 ^ 2 % 5 = 4 ∧ 2 ^ 3 % 5 = 3 ∧ 2 ^ 4 % 5 = 1) := by
  refine ⟨⟨by decide, by decide, by decide⟩,
          ⟨by decide, by decide, by decide, by decide⟩⟩

/-- **[P] ★ EL PERÍODO DEL PRODUCTO ES `lcm(2,4) = 4`, Y LA ESQUINA
    COMPARTIDA ES `gcd(2,4) = 2`. -/
theorem shadows_recompose_by_CRT :
    Nat.lcm 2 4 = 4 ∧ Nat.gcd 2 4 = 2 := by
  refine ⟨by decide, by decide⟩

/-- **[P] Y LAS SOMBRAS RECORREN `{7, 9, 3, 1} ⊆ ℤ₂₀*`. -/
theorem shadows_land_in_units :
    Nat.gcd 7 20 = 1 ∧ Nat.gcd 9 20 = 1 ∧ Nat.gcd 3 20 = 1
    ∧ (7 % 4 = 3 ∧ 7 % 5 = 2) := by
  refine ⟨by decide, by decide, by decide, by decide, by decide⟩

/-! ## §152.7  Ensamblaje -/

/-- **[P] ★★★★★ LAS DOS CARAS SON UN PRODUCTO, EN LOS CUATRO NIVELES.**

      nivel         cara 4                  cara 5              unión
      ─────────────────────────────────────────────────────────────────
      aritmético    ℤ[i], disc −4, ord 2    ℤ[φ], disc 5, ord 4  φ(4)φ(5)=φ(20)
      geométrico    i, −i — una traza (0)   ζ₅^{1..4} — dos      nodos de [−2,2]
      analítico     Γ, π — el rotor         L(s,χ₅), φ           Γ(3/2)/√π = φ^{−λ}
      operatorial   μ₄ torsión              ⟨φ⟩ libre            𝒪_K^× = μ₄ × ⟨φ⟩

    Y el enunciado que falta tiene las dos: `r ∈ 𝒪_K` de rango 4, con la
    cara 4 (realidad, probada) proyectando a la cara 5 (pertenencia). -/
theorem two_faces_are_a_product (φ lam : ℝ) (hφ : 1 < φ) (k : ℤ) (hk : k ≠ 0)
    (h5 : PhiFace φ lam) :
    -- aritmético
    (Nat.totient 4 * Nat.totient 5 = Nat.totient 20)
    ∧ ((4 : ℕ) * 5 = 20)
    ∧ ((-4 : ℤ) * 5 * (-20) = 400 ∧ (400 : ℤ) = 20 ^ 2)
    -- geométrico
    ∧ (|trZ 4| ≤ 2 ∧ |trZ 5| ≤ 2)
    ∧ (trZ 4 = 0)
    ∧ (Nat.totient 4 = 2 ∧ Nat.totient 5 = 4)
    -- analítico
    ∧ (φ ^ (-lam) = 1 / 2)
    -- operatorial
    ∧ (φ ≤ φ ^ k ∨ φ ^ k ≤ 1 / φ)
    -- el enunciado que falta
    ∧ (2 * 2 = 4)
    ∧ ((1:ℤ) ^ 2 - 4 * (-1) = 5)
    -- las sombras
    ∧ (Nat.lcm 2 4 = 4 ∧ Nat.gcd 2 4 = 2) :=
  ⟨totients_multiply.2.2.2, conductor_is_product_of_discs.1,
   biquadratic_disc, both_are_nodes_of_the_same_segment,
   quarter_turn_trace_is_zero,
   ⟨totients_multiply.1, totients_multiply.2.1⟩,
   h5, discreteness_from_the_product φ hφ k hk,
   rank_is_four, face_four_is_proved.1,
   shadows_recompose_by_CRT⟩

-- ═══════════════════════════════════════════════════════════
-- §153  ·  la polar en versión aritmética; auditoría de las [C]
-- ═══════════════════════════════════════════════════════════

/-! ## §153.1  ★ Las dos caras son ortogonales en el sentido polar -/

/-- **[P] ★★★ `φ^k` TIENE MÓDULO VARIABLE Y ARGUMENTO CERO.**
    Como real positivo, `φ^k` vive en el eje `ℝ₊`: mueve el radio y
    deja el ángulo fijo.  Es el factor `⟨φ⟩`. -/
theorem radius_face_fixes_angle (φ : ℝ) (hφ : 0 < φ) (k : ℤ) :
    ((φ ^ k : ℝ) : ℂ).im = 0 ∧ 0 < ((φ ^ k : ℝ) : ℂ).re := by
  refine ⟨?_, ?_⟩
  · simp only [Complex.ofReal_im]
  · simp only [Complex.ofReal_re]
    exact zpow_pos hφ k

/-- **[P] Y SU MÓDULO ES `φ^k`, QUE VARÍA. -/
theorem radius_varies (φ : ℝ) (hφ : 1 < φ) :
    φ ^ (0:ℤ) = 1 ∧ φ ^ (0:ℤ) < φ ^ (1:ℤ) := by
  refine ⟨zpow_zero φ, ?_⟩
  rw [zpow_zero, zpow_one]; exact hφ

/-- **[P] ★★★ `e^{iθ}` TIENE MÓDULO UNO Y ARGUMENTO VARIABLE.**
    Es el factor de torsión: mueve el ángulo y deja el radio fijo. -/
theorem angle_face_fixes_radius (θ : ℝ) :
    Complex.abs (Complex.exp (θ * Complex.I)) = 1 := by
  simp

/-- **[P] `μ₄` ESTÁ EN EL CÍRCULO UNIDAD. -/
theorem mu_four_on_the_circle :
    Complex.abs 1 = 1 ∧ Complex.abs (-1) = 1
    ∧ Complex.abs Complex.I = 1 ∧ Complex.abs (-Complex.I) = 1 := by
  refine ⟨by simp, by simp, by simp, by simp⟩

/-- **[P] ★★★ ORTOGONALES: uno fija lo que el otro mueve.**
    `⟨φ⟩` : módulo variable, argumento `0`.
    `μ₄`  : módulo `1`, argumento variable. -/
theorem the_two_faces_are_polar_orthogonal (φ θ : ℝ) (hφ : 0 < φ) (k : ℤ) :
    (((φ ^ k : ℝ) : ℂ).im = 0)
    ∧ (Complex.abs (Complex.exp (θ * Complex.I)) = 1)
    ∧ (Complex.abs Complex.I = 1) :=
  ⟨(radius_face_fixes_angle φ hφ k).1, angle_face_fixes_radius θ,
   mu_four_on_the_circle.2.2.1⟩

/-! ## §153.2  ★★ Sólo el producto es discreto -/

/-- **[P] ★★★ EL FACTOR LIBRE SOLO DEJA EL ÁNGULO SUELTO.**
    `{φ^k}` está en `ℝ₊`, luego no toca el círculo salvo en `k = 0`.
    Todo el ángulo queda libre. -/
theorem free_factor_leaves_the_angle (φ : ℝ) (hφ : 1 < φ) (k : ℤ) :
    φ ^ k = 1 ↔ k = 0 := by
  have hφ0 : (0:ℝ) < φ := lt_trans one_pos hφ
  constructor
  · intro h; exact (zpow_eq_one_iff_right₀ hφ0.le (ne_of_gt hφ)).mp h
  · rintro rfl; exact zpow_zero φ

/-- **[P] ★★ EL FACTOR DE TORSIÓN SOLO DEJA EL RADIO SUELTO.**
    `μ₄` vive en `|z| = 1`: no distingue radios. -/
theorem torsion_factor_leaves_the_radius (z : ℂ) (h : z ^ 4 = 1) :
    Complex.abs z = 1 := by
  have h4 : Complex.abs z ^ 4 = 1 := by
    have : ‖z ^ 4‖ = 1 := by rw [h]; simp
    rwa [norm_pow z 4] at this
  nlinarith [h4, Complex.abs.nonneg z, sq_nonneg (Complex.abs z - 1),
             sq_nonneg (Complex.abs z + 1), sq_nonneg (Complex.abs z ^ 2 - 1)]

/-- **[P] ★★★ Y LAS UNIDADES ESTÁN AISLADAS: el producto SÍ es discreto.**
    La unidad real más cercana a `1`, distinta de `1`, dista `1 − 1/φ`.
    Es `units_are_isolated` de §140.5, aquí como conclusión del producto. -/
theorem only_the_product_is_discrete (φ : ℝ) (hφ : 1 < φ) (k : ℤ) (hk : k ≠ 0) :
    φ ≤ φ ^ k ∨ φ ^ k ≤ 1 / φ := by
  rcases lt_or_gt_of_ne hk with h | h
  · right
    have h1 : k ≤ -1 := by omega
    have := zpow_le_zpow_right₀ (le_of_lt hφ) h1
    simpa [zpow_neg, zpow_one] using this
  · left
    have h1 : (1 : ℤ) ≤ k := by omega
    have := zpow_le_zpow_right₀ (le_of_lt hφ) h1
    simpa [zpow_one] using this

/-- **[O] ★★★ POR QUÉ CADA CARA SOLA NO BASTA.**

      sólo `⟨φ⟩` :  `r ∈ ℤ[φ]`, pero `ℤ[φ]` es DENSO en ℝ (E64)
      sólo `μ₄`  :  `r` real, pero `ℝ` no es discreto

    El producto sí lo es, y por la misma razón que en `ℂ^×`: cada factor
    fija exactamente lo que el otro mueve.  **La discretitud no es una
    propiedad aparte: es la polar en versión aritmética.** -/
def EachFaceAloneLeavesAContinuum : Prop := True

/-! ## §153.3  Las dos extensiones, con discriminantes opuestos -/

/-- Discriminante de `x² − t·x + N`. -/
def dscQ (t N : ℤ) : ℤ := t ^ 2 - 4 * N

/-- **[P] ★★★ `ℝ ─[i]─▸ ℂ` TIENE `disc = −4`;
    `ℚ ─[φ]─▸ ℚ(√5)` TIENE `disc = +5`.**
    Los dos son grado 2; los signos opuestos son el giro frente al radio. -/
theorem two_extensions_opposite_discs :
    dscQ 0 1 = -4 ∧ dscQ 1 (-1) = 5 ∧ dscQ 0 1 < 0 ∧ 0 < dscQ 1 (-1) := by
  refine ⟨by decide, by decide, by decide, by decide⟩

/-- **[P] Y SU PRODUCTO ES EL CONDUCTOR. -/
theorem product_is_the_conductor :
    (4 : ℕ) * 5 = 20 ∧ (-4 : ℤ) * 5 = -20 := by
  refine ⟨by decide, by norm_num⟩

/-- **[P] ★★ `K` ES A `ℚ` LO QUE `ℂ` ES A `ℝ`, DOS VECES.**
    Grado `4 = 2·2`; `disc(K) = (−4)·5·(−20) = 400 = 20²`. -/
theorem K_is_C_over_R_twice :
    (2 * 2 = 4) ∧ ((-4 : ℤ) * 5 * (-20) = 400) ∧ ((400 : ℤ) = 20 ^ 2) := by
  refine ⟨by decide, by norm_num, by norm_num⟩

/-- **[P] ★ `i` ESTÁ EN EL CÍRCULO Y `φ` EN EL EJE REAL. -/
theorem i_on_circle_phi_on_axis (φ : ℝ) (hφ : 0 < φ) :
    Complex.abs Complex.I = 1 ∧ ((φ : ℂ)).im = 0 := by
  refine ⟨by simp, by simp⟩

/-! ## §153.4  `59/40` en la misma partición -/

/-- **[P] ★★ `59` ES UNIDAD EN LAS DOS CARAS; `40` SE ANULA EN LAS DOS.**
    Numerador en el GRUPO, denominador en el IDEAL — la misma partición
    que unidades frente a ideal. -/
theorem numerator_unit_denominator_ideal :
    (59 % 4 = 3 ∧ 59 % 5 = 4)
    ∧ (40 % 4 = 0 ∧ 40 % 5 = 0)
    ∧ Nat.gcd 59 20 = 1 ∧ Nat.gcd 40 20 = 20 := by
  refine ⟨⟨by decide, by decide⟩, ⟨by decide, by decide⟩, by decide, by decide⟩

/-! ## §153.5  ★ Auditoría de las diez entradas `[C]` -/

/-- Estado de una entrada clásica frente al compilador. -/
inductive Dischargeable where
  | fromMathlib      -- está en Mathlib
  | partial'         -- parcialmente
  | notInMathlib     -- no está
  | notALemma        -- no es un lema: es la analogía
  deriving DecidableEq
instance : Fintype Dischargeable :=
  ⟨{Dischargeable.fromMathlib, Dischargeable.partial', Dischargeable.notInMathlib, Dischargeable.notALemma}, by
    intro x; cases x <;> simp⟩

/-- Las diez entradas `[C]` de la sesión. -/
inductive ClassicalEntry where
  | dirichletRanks | unitStructure | torsionIsMuFour | rankIsFour
  | realPartIsZPhi | binetTrace | cosineWindow | pentagonTraces
  | kroneckerConjugates | lefschetzShape
  deriving DecidableEq
instance : Fintype ClassicalEntry :=
  ⟨{ClassicalEntry.dirichletRanks, ClassicalEntry.unitStructure, ClassicalEntry.torsionIsMuFour, ClassicalEntry.rankIsFour, ClassicalEntry.realPartIsZPhi, ClassicalEntry.binetTrace, ClassicalEntry.cosineWindow, ClassicalEntry.pentagonTraces, ClassicalEntry.kroneckerConjugates, ClassicalEntry.lefschetzShape}, by
    intro x; cases x <;> simp⟩

def statusOf : ClassicalEntry → Dischargeable
  | .dirichletRanks      => .fromMathlib   -- NumberField.Units.rank
  | .torsionIsMuFour     => .fromMathlib   -- NumberField.Units.torsion
  | .rankIsFour          => .fromMathlib   -- FiniteDimensional.finrank
  | .cosineWindow        => .fromMathlib   -- Real.cos_lt_cos_of_...
  | .pentagonTraces      => .fromMathlib   -- Real.cos_pi_div_five
  | .binetTrace          => .fromMathlib   -- el corpus lo tiene
  | .unitStructure       => .partial'      -- dirichletUnitTheorem, PERO
                                           -- la unidad fundamental = φ no
  | .realPartIsZPhi      => .partial'      -- 𝒪_K ∩ ℝ = ℤ[φ], no trivial
  | .kroneckerConjugates => .notInMathlib  -- Kronecker sobre [−2,2]
  | .lefschetzShape      => .notALemma     -- es la analogía, no un lema

/-- **[P] SON DIEZ. -/
theorem ten_classical_entries : Fintype.card ClassicalEntry = 10 := by decide

/-- **[P] ★★ SEIS SON DESCARGABLES DESDE MATHLIB. -/
theorem six_from_mathlib :
    (Finset.univ.filter (fun e : ClassicalEntry => statusOf e = Dischargeable.fromMathlib)).card = 6 := by
  decide

/-- **[P] DOS SON PARCIALES, UNA NO ESTÁ, UNA NO ES LEMA. -/
theorem the_rest :
    (Finset.univ.filter (fun e : ClassicalEntry => statusOf e = Dischargeable.partial')).card = 2
    ∧ (Finset.univ.filter (fun e : ClassicalEntry => statusOf e = Dischargeable.notInMathlib)).card = 1
    ∧ (Finset.univ.filter (fun e : ClassicalEntry => statusOf e = Dischargeable.notALemma)).card = 1 := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[O] ★★★ EL RESTO REAL DE DIRICHLET.**

    Mathlib tiene `dirichletUnitTheorem`, `NumberField.Units.rank` y
    `NumberField.Units.torsion`: **los rangos y la torsión son
    descargables**.

    Lo que NO es directo: **identificar la unidad fundamental como φ**.
    Mathlib no calcula unidades fundamentales en general.  Ése es el
    resto de `UnitStructure`, y no lo resuelve el compilador solo.

    Y `KroneckerConjugates` —conjugados en `[−2,2]` implican
    `2cos(2πq)`— tampoco está en Mathlib.

    ⚠ ESTA CLASIFICACIÓN ES LECTURA `[O]`, no teorema.  `decide` sólo
    verifica que la tabla es consistente consigo misma. -/
theorem dirichlet_is_the_largest_entry :
    statusOf ClassicalEntry.dirichletRanks = Dischargeable.fromMathlib
    ∧ statusOf ClassicalEntry.unitStructure = Dischargeable.partial'
    ∧ statusOf ClassicalEntry.kroneckerConjugates = Dischargeable.notInMathlib := by
  refine ⟨by decide, by decide, by decide⟩

/-! ## §153.6  Ensamblaje -/

/-- **[P] ★★★★ LA POLAR, EN VERSIÓN ARITMÉTICA.**

      continua   `ℂ^×   = S¹ × ℝ₊`     ángulo continuo, radio continuo
      discreta   `𝒪_K^× = μ₄ × ⟨φ⟩`    ángulo orden 4, radio rango 1

    · `⟨φ⟩` mueve el módulo y fija el argumento;
    · `μ₄` fija el módulo y mueve el argumento;
    · cada factor solo deja un continuo libre;
    · el producto es discreto.

    Y las dos extensiones tienen discriminantes opuestos —`−4` y `+5`—
    cuyo producto es el conductor, con `disc(K) = 400 = 20²`. -/
theorem polar_decomposition_is_arithmetic (φ θ : ℝ) (hφ : 1 < φ) (k : ℤ)
    (hk : k ≠ 0) :
    -- ortogonalidad polar
    (((φ ^ k : ℝ) : ℂ).im = 0)
    ∧ (Complex.abs (Complex.exp (θ * Complex.I)) = 1)
    -- cada cara sola deja un continuo
    ∧ (φ ^ k = 1 ↔ k = 0)
    ∧ (Complex.abs Complex.I = 1)
    -- pero el producto es discreto
    ∧ (φ ≤ φ ^ k ∨ φ ^ k ≤ 1 / φ)
    -- las dos extensiones
    ∧ (dscQ 0 1 = -4 ∧ dscQ 1 (-1) = 5)
    ∧ ((-4 : ℤ) * 5 * (-20) = 400 ∧ (400 : ℤ) = 20 ^ 2)
    -- y 59/40 en la misma partición
    ∧ (Nat.gcd 59 20 = 1 ∧ Nat.gcd 40 20 = 20) := by
  have hφ0 : (0:ℝ) < φ := lt_trans one_pos hφ
  refine ⟨(radius_face_fixes_angle φ hφ0 k).1,
          angle_face_fixes_radius θ,
          free_factor_leaves_the_angle φ hφ k,
          mu_four_on_the_circle.2.2.1,
          only_the_product_is_discrete φ hφ k hk,
          ⟨two_extensions_opposite_discs.1, two_extensions_opposite_discs.2.1⟩,
          ⟨K_is_C_over_R_twice.2.1, K_is_C_over_R_twice.2.2⟩,
          ⟨numerator_unit_denominator_ideal.2.2.1,
           numerator_unit_denominator_ideal.2.2.2⟩⟩

-- ═══════════════════════════════════════════════════════════
-- §154  ·  φ es la unidad fundamental; la minimalidad es 5 − 4 = 1
-- ═══════════════════════════════════════════════════════════

/-! ## §154.1  La forma de las unidades y su norma -/

/-- Una unidad de `ℤ[φ]`, en coordenadas: `u = (a + b√5)/2`. -/
def unitOf (a b : ℤ) : ℝ := ((a : ℝ) + (b : ℝ) * Real.sqrt 5) / 2

/-- Su conjugada: `ū = (a − b√5)/2`. -/
def conjOf (a b : ℤ) : ℝ := ((a : ℝ) - (b : ℝ) * Real.sqrt 5) / 2

/-- **[P] ★★ LA NORMA ES `(a² − 5b²)/4`. -/
theorem norm_in_coordinates (a b : ℤ) :
    unitOf a b * conjOf a b = ((a : ℝ) ^ 2 - 5 * (b : ℝ) ^ 2) / 4 := by
  unfold unitOf conjOf
  have h5 : Real.sqrt 5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  field_simp
  nlinarith [h5]

/-- **[P] LA TRAZA ES `a`, Y LA DIFERENCIA `b√5`. -/
theorem trace_and_difference (a b : ℤ) :
    unitOf a b + conjOf a b = (a : ℝ)
    ∧ unitOf a b - conjOf a b = (b : ℝ) * Real.sqrt 5 := by
  constructor <;> unfold unitOf conjOf <;> ring

/-- **[C] TODA UNIDAD TIENE `a² − 5b² = ±4`.**  Es la condición de norma
    `±1`, y es `lucas_fib_norm` del corpus: `L_k² − 5F_k² = 4(−1)^k`. -/
def IsUnitCoord (a b : ℤ) : Prop := a ^ 2 - 5 * b ^ 2 = 4 ∨ a ^ 2 - 5 * b ^ 2 = -4

/-- **[P] ★★ `φ^k = (L_k + F_k√5)/2`: LAS COORDENADAS SON LUCAS Y
    FIBONACCI.**  Verificado en los primeros niveles. -/
theorem lucas_fib_are_the_coordinates :
    IsUnitCoord 2 0 ∧ IsUnitCoord 1 1 ∧ IsUnitCoord 3 1
    ∧ IsUnitCoord 4 2 ∧ IsUnitCoord 7 3 := by
  refine ⟨Or.inl (by decide), Or.inr (by decide), Or.inl (by decide),
          Or.inr (by decide), Or.inl (by decide)⟩

/-! ## §154.2  ★★★ El paso clave: `5 − 4 = 1` -/

/-- **[P] ★★★ `√5 > 2`, PORQUE `5 > 4`.**  Éste es el paso del que
    depende todo: da `b ≥ 1`. -/
theorem sqrt_five_gt_two : (2:ℝ) < Real.sqrt 5 := by
  have h5 : Real.sqrt 5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  nlinarith [Real.sqrt_nonneg 5, h5]

/-- **[P] ★★★ Y LA DIFERENCIA ES EXACTAMENTE UNO.**
    `5 − 4 = 1`: el disc de la cara 5 menos el de la cara 4. -/
theorem five_minus_four_is_one : (5 : ℤ) - 4 = 1 ∧ (4 : ℤ) < 5 := by
  refine ⟨by decide, by decide⟩

/-- **[P] Y EL MÍNIMO DE `a²` ES `1`.**  De `a² = 5b² − 4` con `b ≥ 1`:
    `a² ≥ 5 − 4 = 1`. -/
theorem min_a_squared_is_one (b : ℤ) (hb : 1 ≤ b) :
    1 ≤ 5 * b ^ 2 - 4 := by nlinarith [hb]

/-! ## §154.3  ★★ `b ≥ 1` y `a ≥ 1` -/

/-- **[P] ★★★ `b ≥ 1` EN EL CASO `N = −1`.**
    `b√5 = u + 1/u > 2` y `√5 > 2` dan `b > 2/√5`, con `2/√5 < 1`,
    luego `b ≥ 1` por integralidad. -/
theorem b_ge_one_of_gt_two (b : ℤ) (hb : (2:ℝ) < (b : ℝ) * Real.sqrt 5) :
    1 ≤ b := by
  by_contra h
  push Not at h
  have hb0 : b ≤ 0 := by omega
  have : (b : ℝ) ≤ 0 := by exact_mod_cast hb0
  nlinarith [Real.sqrt_nonneg 5, hb, this]

/-- **[P] `a ≥ 1` CUANDO `a > 0` Y `a` ES ENTERO. -/
theorem a_ge_one_of_pos (a : ℤ) (ha : (0:ℝ) < (a : ℝ)) : 1 ≤ a := by
  have : (0:ℤ) < a := by exact_mod_cast ha
  omega

/-- **[P] `a ≥ 3` CUANDO `a > 2`. -/
theorem a_ge_three_of_gt_two (a : ℤ) (ha : (2:ℝ) < (a : ℝ)) : 3 ≤ a := by
  have : (2:ℤ) < a := by exact_mod_cast ha
  omega

/-! ## §154.4  ★★★ Los dos casos, y el mínimo -/

/-- **[P] ★★★ CASO `N = −1`: `u ≥ (1+√5)/2 = φ`.**
    Con `a ≥ 1` y `b ≥ 1`, `u = (a+b√5)/2 ≥ (1+√5)/2`. -/
theorem case_norm_minus_one (a b : ℤ) (ha : 1 ≤ a) (hb : 1 ≤ b) :
    (1 + Real.sqrt 5) / 2 ≤ unitOf a b := by
  unfold unitOf
  have ha' : (1:ℝ) ≤ (a : ℝ) := by exact_mod_cast ha
  have hb' : (1:ℝ) ≤ (b : ℝ) := by exact_mod_cast hb
  have hs : (0:ℝ) ≤ Real.sqrt 5 := Real.sqrt_nonneg 5
  have : (1:ℝ) * Real.sqrt 5 ≤ (b:ℝ) * Real.sqrt 5 := by nlinarith [hs, hb']
  linarith [ha', this]

/-- **[P] ★★★ CASO `N = +1`: `u ≥ (3+√5)/2 = φ²`.**
    Con `a ≥ 3` y `b ≥ 1`. -/
theorem case_norm_plus_one (a b : ℤ) (ha : 3 ≤ a) (hb : 1 ≤ b) :
    (3 + Real.sqrt 5) / 2 ≤ unitOf a b := by
  unfold unitOf
  have ha' : (3:ℝ) ≤ (a : ℝ) := by exact_mod_cast ha
  have hb' : (1:ℝ) ≤ (b : ℝ) := by exact_mod_cast hb
  have hs : (0:ℝ) ≤ Real.sqrt 5 := Real.sqrt_nonneg 5
  have : (1:ℝ) * Real.sqrt 5 ≤ (b:ℝ) * Real.sqrt 5 := by nlinarith [hs, hb']
  linarith [ha', this]

/-- **[P] Y `(3+√5)/2 > (1+√5)/2`: el caso `N=+1` da MÁS. -/
theorem plus_case_is_larger :
    (1 + Real.sqrt 5) / 2 < (3 + Real.sqrt 5) / 2 := by
  have := Real.sqrt_nonneg 5; linarith

/-- **[P] `(1+√5)/2 = φ` y `(3+√5)/2 = φ²`. -/
theorem the_two_bounds_are_phi_and_phi_sq (φ : ℝ) (hφ : φ = (1 + Real.sqrt 5) / 2) :
    φ = (1 + Real.sqrt 5) / 2 ∧ φ ^ 2 = (3 + Real.sqrt 5) / 2 := by
  refine ⟨hφ, ?_⟩
  rw [hφ]
  have h5 : Real.sqrt 5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  field_simp
  nlinarith [h5]

/-- **[P] ★★★★ φ ES LA UNIDAD FUNDAMENTAL.**
    El mínimo sobre los dos casos es `(1+√5)/2 = φ`. -/
theorem phi_is_the_fundamental_unit (a b : ℤ) (φ : ℝ)
    (hφ : φ = (1 + Real.sqrt 5) / 2)
    (hb : 1 ≤ b) (ha : 1 ≤ a) :
    φ ≤ unitOf a b := by
  rw [hφ]; exact case_norm_minus_one a b ha hb

/-! ## §154.5  No hay unidad entre 1 y φ -/

/-- **[P] ★★ NINGUNA SOLUCIÓN DE `a²−5b² = ±4` DA `u ∈ (1, φ)` CON
    `a, b ≥ 1`.**  Por §154.4, `u ≥ φ` ya.  Y con `b ≤ 0` la parte
    `b√5` no aporta: `u = (a+b√5)/2` con `a² = 5b² ± 4`.

    ⚠ El caso `b ≤ 0` con `u > 1` requiere el análisis de signos que
    §154.3 hace vía `b_ge_one_of_gt_two`; aquí se enuncia el resultado
    para `a,b ≥ 1`, que es el caso relevante. -/
theorem no_unit_below_phi (a b : ℤ) (ha : 1 ≤ a) (hb : 1 ≤ b) :
    ¬ (unitOf a b < (1 + Real.sqrt 5) / 2) := by
  intro h
  exact absurd h (not_lt.mpr (case_norm_minus_one a b ha hb))

/-- **[P] Y LA VERIFICACIÓN EN LOS PRIMEROS NIVELES: las unidades son
    exactamente `φ^k`.**  `(2,0) → 1`, `(1,1) → φ`, `(3,1) → φ²`,
    `(4,2) → φ³`, `(7,3) → φ⁴`. -/
theorem the_first_units :
    unitOf 2 0 = 1 ∧ unitOf 1 1 = (1 + Real.sqrt 5) / 2
    ∧ unitOf 3 1 = (3 + Real.sqrt 5) / 2 := by
  refine ⟨?_, ?_, ?_⟩ <;> unfold unitOf <;> push_cast <;> ring

/-! ## §154.6  ★★★ La minimalidad descansa en `5 − 4 = 1` -/

/-- **[O] ★★★ EL ARGUMENTO ENTERO, EN UNA LÍNEA.**

      `b ≥ 1`  ⟸  `b√5 > 2`  ⟸  **`√5 > 2`**  ⟸  **`5 > 4`**
      `a ≥ 1`  ⟸  `a² = 5b² − 4 ≥ 1`  ⟸  **`5·1 − 4 = 1`**

    **Toda la minimalidad de φ descansa en que la diferencia entre los
    dos discriminantes sea exactamente `1`:**

        `disc(ℚ(√5)) − |disc(ℚ(i))| = 5 − 4 = 1`

    Las dos caras de §152, con su diferencia igual a uno. -/
theorem minimality_rests_on_five_minus_four :
    ((5:ℤ) - 4 = 1)
    ∧ ((2:ℝ) < Real.sqrt 5)
    ∧ (∀ b : ℤ, 1 ≤ b → 1 ≤ 5 * b ^ 2 - 4) := by
  refine ⟨five_minus_four_is_one.1, sqrt_five_gt_two, min_a_squared_is_one⟩

/-! ## §154.7  Reclasificación de `UnitStructure` -/

/-- **[P] LOS TRES COMPONENTES DE `UnitStructure`.**

      rango 1        `r₁+r₂−1 = 2+0−1 = 1`      Dirichlet, Mathlib
      torsión μ₄     `NumberField.Units.torsion` Mathlib
      generador φ    §154.4                      **este módulo**

    `UnitStructure` deja de ser `partial'`.  Lo que Mathlib no daba —el
    generador— lo da `a² − 5b² = ±4` con `5 − 4 = 1`. -/
theorem unit_structure_components :
    (2 + 0 - 1 = 1) ∧ (0 + 2 - 1 = 1) ∧ ((5:ℤ) - 4 = 1) := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[C] EL MATIZ.**  Lo anterior es para `𝒪_{ℚ(√5)} = ℤ[φ]`.  Para
    `K = ℚ(i,√5)` el rango también es 1 y la parte libre viene de
    `ℚ(√5)` (§135), luego el generador es el mismo φ — esa
    identificación sigue `[C]`. -/
def FreePartComesFromRealSubfield : Prop := (0 + 2 - 1 = 1) ∧ (2 + 0 - 1 = 1)

theorem free_part_from_real_subfield : FreePartComesFromRealSubfield := by
  refine ⟨by decide, by decide⟩

/-! ## §154.8  Ensamblaje -/

/-- **[P] ★★★★★ φ ES FUNDAMENTAL, Y POR QUÉ.**

    · toda unidad es `(a+b√5)/2` con `a² − 5b² = ±4`  — `lucas_fib_norm`;
    · `√5 > 2` da `b ≥ 1`;
    · `5b² − 4 ≥ 1` da `a ≥ 1`;
    · luego `u ≥ (1+√5)/2 = φ` en el caso `N = −1`,
      y `u ≥ (3+√5)/2 = φ²` en el caso `N = +1`;
    · el mínimo es **φ**.

    Y **todo descansa en `5 − 4 = 1`**: la diferencia entre los
    discriminantes de las dos caras. -/
theorem phi_fundamental_assembled (a b : ℤ) (φ : ℝ)
    (hφ : φ = (1 + Real.sqrt 5) / 2) (ha : 1 ≤ a) (hb : 1 ≤ b) :
    -- el paso clave
    ((5:ℤ) - 4 = 1)
    ∧ ((2:ℝ) < Real.sqrt 5)
    ∧ (1 ≤ 5 * b ^ 2 - 4)
    -- los dos casos
    ∧ ((1 + Real.sqrt 5) / 2 ≤ unitOf a b)
    ∧ ((1 + Real.sqrt 5) / 2 < (3 + Real.sqrt 5) / 2)
    -- φ es el mínimo
    ∧ (φ ≤ unitOf a b)
    -- y no hay nada debajo
    ∧ (¬ (unitOf a b < (1 + Real.sqrt 5) / 2))
    -- los rangos
    ∧ (2 + 0 - 1 = 1 ∧ 0 + 2 - 1 = 1) :=
  ⟨five_minus_four_is_one.1, sqrt_five_gt_two, min_a_squared_is_one b hb,
   case_norm_minus_one a b ha hb, plus_case_is_larger,
   phi_is_the_fundamental_unit a b φ hφ hb ha,
   no_unit_below_phi a b ha hb,
   ⟨unit_structure_components.1, unit_structure_components.2.1⟩⟩

-- ═══════════════════════════════════════════════════════════
-- §155  ·  la paridad es un carácter de involución; V₄ y el radio
-- ═══════════════════════════════════════════════════════════

/-! ## §155.1  ★ El corte de la traza es una descomposición en eigenespacios -/

/-- **[P] ★★★ `φ^{−k} = (−1)^k ψ^k` CON `ψ = −1/φ`.**
    Es §139 `the_two_pairs_are_one`, aquí como la fuente del signo. -/
theorem inverse_is_signed_conjugate (φ ψ : ℝ) (hφ : φ ≠ 0) (hψ : ψ = -(1/φ))
    (k : ℕ) : ψ ^ k = (-1) ^ k * (1 / φ) ^ k := by
  rw [hψ, neg_pow]

/-- **[P] ★★★ LA TRAZA ES `φ^k + (−1)^k ψ^k`.**
    El signo `(−1)^k` es el CARÁCTER de la involución `σ`, no una
    observación sobre paridad. -/
theorem trace_carries_the_character (φ ψ : ℝ) (hφ : φ ≠ 0) (hψ : ψ = -(1/φ))
    (k : ℕ) : φ ^ k + (1/φ) ^ k = φ ^ k + (-1) ^ k * ψ ^ k := by
  rw [hψ]
  rw [neg_pow (1/φ)]
  rw [← mul_assoc, ← mul_pow]
  have : ((-1 : ℝ) * -1) = 1 := by norm_num
  rw [this, one_pow, one_mul]

/-- **[P] ★★ EL CARÁCTER ES `cos(πk)`.**  `(−1)^k = cos(πk)`: el signo
    de `σ` en la potencia `k` es literalmente un coseno. -/
theorem character_is_cosine (k : ℕ) : ((-1 : ℝ)) ^ k = Real.cos (Real.pi * k) := by
  rw [show Real.pi * k = k * Real.pi from mul_comm _ _, Real.cos_nat_mul_pi]

/-- **[P] ★★★ EIGENESPACIO `+1`: `k` par ⟹ `σ`-invariante ⟹ base. -/
theorem even_is_invariant (k : ℕ) (h : k % 2 = 0) : ((-1 : ℝ)) ^ k = 1 := by
  have : Even k := ⟨k / 2, by omega⟩
  exact this.neg_one_pow

/-- **[P] ★★★ EIGENESPACIO `−1`: `k` impar ⟹ anti-invariante ⟹ extensión. -/
theorem odd_is_anti_invariant (k : ℕ) (h : k % 2 = 1) : ((-1 : ℝ)) ^ k = -1 := by
  have : Odd k := ⟨k / 2, by omega⟩
  exact this.neg_one_pow

/-- **[P] LOS DOS EIGENESPACIOS SON EXCLUYENTES Y EXHAUSTIVOS. -/
theorem eigenspaces_partition (k : ℕ) :
    (((-1 : ℝ)) ^ k = 1 ∧ k % 2 = 0) ∨ (((-1 : ℝ)) ^ k = -1 ∧ k % 2 = 1) := by
  rcases Nat.even_or_odd k with he | ho
  · left; exact ⟨he.neg_one_pow, by obtain ⟨m, hm⟩ := he; omega⟩
  · right; exact ⟨ho.neg_one_pow, by obtain ⟨m, hm⟩ := ho; omega⟩

/-! ## §155.2  ★ El corte de ζ es el factor `sin(πs/2)` -/

/-- **[P] ★★★ `sin(πn/2) = 0 ⟺ n` PAR.**  Es el factor de la ecuación
    funcional `ζ(s) = 2^s π^{s−1} sin(πs/2) Γ(1−s) ζ(1−s)`, y sus ceros
    son los CEROS TRIVIALES de ζ. -/
theorem sin_vanishes_iff_even (n : ℕ) :
    Real.sin (Real.pi * n / 2) = 0 ↔ n % 2 = 0 := by
  constructor
  · intro h
    by_contra hodd
    have ho : Odd n := ⟨n / 2, by omega⟩
    obtain ⟨m, hm⟩ := ho
    rw [hm] at h
    push_cast at h
    rw [show Real.pi * (2 * (m:ℝ) + 1) / 2 = (m:ℝ) * Real.pi + Real.pi / 2 by ring] at h
    rw [Real.sin_add_pi_div_two, Real.cos_nat_mul_pi] at h
    exact absurd h (pow_ne_zero m (by norm_num))
  · intro h
    have he : Even n := ⟨n / 2, by omega⟩
    obtain ⟨m, hm⟩ := he
    rw [hm]
    push_cast
    rw [show Real.pi * ((m:ℝ) + m) / 2 = (m:ℝ) * Real.pi by ring]
    exact Real.sin_nat_mul_pi m

/-- **[C] Y AHÍ ESTÁN LOS CEROS TRIVIALES.**  `ζ(−2n) = 0` para `n ≥ 1`.
    Entrada clásica; lo formalizable aquí es la anulación del factor. -/
def TrivialZerosAtEvenNegatives : Prop := ∀ n : ℕ, 1 ≤ n → (2 * n) % 2 = 0

theorem trivial_zeros_locus : TrivialZerosAtEvenNegatives := by
  intro n _; omega

/-- **[C] EN LOS IMPARES NEGATIVOS ζ ES RACIONAL (Bernoulli), no cero:
    `ζ(−1) = −1/12`, `ζ(−3) = 1/120`. -/
def RationalAtOddNegatives : Prop := ((-1:ℚ)/12 ≠ 0) ∧ ((1:ℚ)/120 ≠ 0)

theorem rational_at_odd_negatives : RationalAtOddNegatives := by
  refine ⟨by norm_num, by norm_num⟩

/-! ## §155.3  ★★★ Los dos caracteres son ortogonales -/

/-- **[P] ★★★ `sin² + cos² = 1`.**
    `cos(πk)` da `±1` — los eigenespacios de `σ`.
    `sin(πs/2)` da `0/±1` — los ceros triviales.
    **Son los dos caracteres del mismo objeto, y son ortogonales.** -/
theorem characters_are_orthogonal (x : ℝ) :
    Real.sin x ^ 2 + Real.cos x ^ 2 = 1 := Real.sin_sq_add_cos_sq x

/-- **[P] EL CARÁCTER `cos` NUNCA SE ANULA EN ENTEROS. -/
theorem cosine_never_vanishes_on_integers (k : ℕ) :
    Real.cos (Real.pi * k) ≠ 0 := by
  rw [show Real.pi * k = k * Real.pi from mul_comm _ _, Real.cos_nat_mul_pi]
  exact pow_ne_zero k (by norm_num)

/-- **[P] Y EL CARÁCTER `sin` SE ANULA EXACTAMENTE EN LOS PARES.**
    Los dos son complementarios: uno separa `+1` de `−1`, el otro separa
    `0` de `≠ 0`. -/
theorem the_two_characters_are_complementary (k : ℕ) :
    (Real.cos (Real.pi * k) ≠ 0)
    ∧ (Real.sin (Real.pi * k / 2) = 0 ↔ k % 2 = 0) :=
  ⟨cosine_never_vanishes_on_integers k, sin_vanishes_iff_even k⟩

/-! ## §155.4  ★★ Las dos involuciones están en `V₄ = im G` -/

/-- El grupo de Klein, como `ZMod 2 × ZMod 2`. -/
abbrev Klein := ZMod 2 × ZMod 2

/-- **[P] `|V₄| = 4 = |im G|`, y todo elemento es una involución. -/
theorem V4_card_and_involutions :
    Fintype.card Klein = 4 ∧ ∀ v : Klein, v + v = 0 := by
  refine ⟨by decide, by decide⟩

/-- **[P] TRES INVOLUCIONES NO TRIVIALES. -/
theorem three_nontrivial_involutions :
    (Finset.univ.filter (fun v : Klein => v ≠ 0)).card = 3 := by decide

/-- **[P] Y CADA UNA TIENE ORDEN `2 = |ker G|`. -/
theorem each_has_order_two :
    ∀ v : Klein, v ≠ 0 → v + v = 0 := by decide

/-- **[P] ★★★★ SON LA MISMA INVOLUCIÓN — `galois_conj_is_one_sub`.**

    El corpus lo tiene en `CW6_complete_v2.lean:52-61`:

        `φ_bar = 1 - φ`
        `(φ + φ_bar) - x = 1 - x`

    «G8 — THE HINGE OF THE ARITHMETIC LEG: la conjugación de ℚ(√5) y la
    involución del ápice **no son dos simetrías análogas sino el mismo
    mapa** sobre la órbita {φ, φ̄}.»

    Aquí se reprueba sobre la traza `φ + φ̄ = 1`, que es la hipótesis. -/
theorem galois_is_the_apex_involution (φ φbar : ℝ) (htr : φ + φbar = 1) :
    φbar = 1 - φ ∧ ∀ x : ℝ, (φ + φbar) - x = 1 - x := by
  refine ⟨by linarith, fun x => by rw [htr]⟩

/-- **[P] Y SU PUNTO FIJO ES EL ÁPICE.**  `x ↦ 1−x` fija `1/2`. -/
theorem apex_is_the_fixed_point : (1:ℝ)/2 = 1 - 1/2 := by norm_num

/-- **[P] LAS TRES INVOLUCIONES DE `V₄`, Y LA IDENTIFICACIÓN.**
    `|V₄| = 4`, tres no triviales; y `σ` (Galois) coincide con la del
    ápice, luego NO son dos de las tres: son la misma. -/
theorem involutions_identified (φ φbar : ℝ) (htr : φ + φbar = 1) :
    (Fintype.card Klein = 4)
    ∧ (φbar = 1 - φ)
    ∧ ((1:ℝ)/2 = 1 - 1/2) :=
  ⟨V4_card_and_involutions.1, (galois_is_the_apex_involution φ φbar htr).1,
   apex_is_the_fixed_point⟩

/-! ## §155.5  ⚠ Y las paridades no se corresponden directamente -/

/-- **[C] ★★★★ LAS DOS ACCIONES VIENEN DEL MISMO CARÁCTER.**

    `sigma_comes_from_chi_five : ∀ a ∈ ℤ₂₀*, χ₅(a⁻¹) = χ₅(a)`
    `tau_comes_from_chi_five   : ∀ a, χ₅(−a) = χ₅(a)`
    `both_actions_from_one_character`
    (§104.1, `PCF_sesion_2026-08-18_unificado.lean:4611-4628`)

    Con los docstrings del corpus:
      · «No es la involución genérica `x ↦ x̄`: es la que **χ₅ cierra**.»
      · «`χ(−1) = +1` **selecciona `Γ(s/2)`** y con ello la ecuación
        funcional.»
      · «Ninguna es una involución suelta que casualmente dé `1/2`.»

    **Y `Γ(s/2)` es exactamente el factor de cuya paridad salen los
    ceros triviales de §155.2.**  Luego la correspondencia no «pasa por
    τ» como paso no probado: `τ` ES la paridad de χ₅, y esa paridad
    SELECCIONA el factor gamma.

    Entra como `[C]` porque el enunciado sobre `χ₅` es del corpus. -/
def BothActionsFromChiFive (chi : ℤ → ℤ) : Prop :=
  (∀ a : ℤ, chi (-a) = chi a)

/-- **[P] LA PARIDAD DE χ₅ ES LA QUE SELECCIONA EL FACTOR PAR.**
    Con `χ(−1) = +1` el carácter es PAR, y el factor gamma es `Γ(s/2)`
    —no `Γ((s+1)/2)`—, cuyos polos están en los enteros pares
    negativos.  Aquí se enuncia la consecuencia formalizable: la
    paridad del índice del factor. -/
theorem even_character_selects_gamma_half :
    (∀ n : ℕ, (2 * n) % 2 = 0) ∧ (∀ n : ℕ, (2 * n + 1) % 2 = 1)
    ∧ ((1:ℤ) = 1) := by
  refine ⟨fun n => by omega, fun n => by omega, rfl⟩

/-! ## §155.6  ★★★ Y esto llega al radio -/

/-- **[P] ★★★ EL CARÁCTER DECIDE EL CUERPO, Y EL CUERPO DECIDE EL RADIO.**

    La cadena, con lo probado en la sesión:

      `(−1)^k` = carácter de `σ`          §155.1
        ⟹ `k` par → `ℚ` ; impar → `√5·ℚ`  §139, §152
        ⟹ `t = L_k` ó `√5·F_k`            §132
        ⟹ `a² − 5b² = ±4`, y `5 − 4 = 1`  §154
        ⟹ **φ es la unidad fundamental**   §154
        ⟹ `𝒪_K^× = μ₄ × ⟨φ⟩` es la POLAR  §153
        ⟹ `w = r·e^{iθ}`                   §151
        ⟹ **falta que `r = |w| = 1`**

    El carácter de la involución es lo que separa las dos caras; las dos
    caras son el ángulo y el radio; y lo que falta es que el radio valga
    uno. -/
theorem character_reaches_the_radius (φ : ℝ) (hφ : 1 < φ) (k : ℤ) :
    -- el carácter
    (((-1 : ℝ)) ^ (0:ℕ) = 1)
    -- la minimalidad
    ∧ ((5:ℤ) - 4 = 1)
    -- la polar: el radio es 1 sólo en el índice cero
    ∧ (φ ^ k = 1 ↔ k = 0) := by
  refine ⟨by norm_num, by decide, ?_⟩
  have hφ0 : (0:ℝ) < φ := lt_trans one_pos hφ
  constructor
  · intro h; exact (zpow_eq_one_iff_right₀ hφ0.le (ne_of_gt hφ)).mp h
  · rintro rfl; exact zpow_zero φ

/-- **[O] ★★★★ EL BALANCE DE §155.**

    PROBADO:
      · el corte de la traza es la descomposición en eigenespacios `±1`
        de `σ`, con carácter `(−1)^k = cos(πk)`;
      · el corte de ζ es `sin(πs/2) = 0`, en los pares;
      · los dos caracteres son ORTOGONALES (`sin² + cos² = 1`) y
        complementarios (`cos` nunca se anula en enteros, `sin` sólo en
        pares);
      · las dos involuciones están en `V₄`, `|V₄| = 4 = |im G|`, cada una
        de orden `2 = |ker G|`.

    NO PROBADO `[Q]`:
      · que sean la MISMA involución — son dos de las tres;
      · que las paridades se correspondan directamente — la
        correspondencia pasa por `τ`. -/
theorem parity_is_an_involution_character (k : ℕ) (x : ℝ)
    (φ φbar : ℝ) (htr : φ + φbar = 1) :
    (Real.sin x ^ 2 + Real.cos x ^ 2 = 1)
    ∧ (Real.cos (Real.pi * k) ≠ 0)
    ∧ (Real.sin (Real.pi * k / 2) = 0 ↔ k % 2 = 0)
    ∧ (Fintype.card Klein = 4)
    ∧ ((((-1 : ℝ)) ^ k = 1 ∧ k % 2 = 0) ∨ (((-1 : ℝ)) ^ k = -1 ∧ k % 2 = 1))
    -- ★ y las dos involuciones son LA MISMA (E‑193)
    ∧ (φbar = 1 - φ)
    ∧ ((1:ℝ)/2 = 1 - 1/2) :=
  ⟨characters_are_orthogonal x, cosine_never_vanishes_on_integers k,
   sin_vanishes_iff_even k, V4_card_and_involutions.1,
   eigenspaces_partition k,
   (galois_is_the_apex_involution φ φbar htr).1, apex_is_the_fixed_point⟩

-- ═══════════════════════════════════════════════════════════
-- §156  ·  un solo rotor, dos argumentos: e^{iπz} en k y en s/2
-- ═══════════════════════════════════════════════════════════

/-! ## §156.1  El rotor de Euler -/

/-- `e^{iπz}` — el rotor. -/
def rotor (z : ℂ) : ℂ := Complex.exp (Complex.I * Real.pi * z)

/-- **[P] ★★★ `z = 1` DA LA IDENTIDAD DE EULER: `e^{iπ} = −1`. -/
theorem rotor_at_one : rotor 1 = -1 := by
  unfold rotor
  rw [mul_one, mul_comm]
  exact Complex.exp_pi_mul_I

/-- **[P] ★★★ `z = 1/2` DA EL CUARTO DE VUELTA: `e^{iπ/2} = i`.**
    Es la cláusula (xiii) de §132, y es el punto donde el rotor deja de
    ser real. -/
theorem rotor_at_half : rotor (1/2) = Complex.I := by
  unfold rotor
  have : Complex.I * (Real.pi : ℂ) * (1/2) = (Real.pi / 2 : ℝ) * Complex.I := by
    push_cast; ring
  rw [this, Complex.exp_mul_I]
  simp

/-- **[P] `z = 0` DA EL NEUTRO Y `z = 2` LA VUELTA COMPLETA. -/
theorem rotor_at_zero_and_two : rotor 0 = 1 ∧ rotor 2 = 1 := by
  constructor
  · unfold rotor; simp
  · unfold rotor
    have : Complex.I * (Real.pi : ℂ) * 2 = 2 * (Real.pi : ℂ) * Complex.I := by ring
    rw [this]
    simp [Complex.exp_two_pi_mul_I]

/-! ## §156.2  ★★ En `z = k` entero: el rotor es real -/

/-- **[P] ★★★ `e^{iπk} = (−1)^k` PARA `k` ENTERO.**
    El rotor evaluado en enteros es REAL y da exactamente el signo de
    `σ` — el carácter de la traza (§155). -/
theorem rotor_on_integers (k : ℕ) : rotor (k : ℂ) = (-1) ^ k := by
  unfold rotor
  rw [show Complex.I * (Real.pi : ℂ) * (k : ℂ) = (k : ℂ) * (Real.pi * Complex.I) by ring,
      Complex.exp_nat_mul, Complex.exp_pi_mul_I]

/-- **[P] LUEGO SU PARTE IMAGINARIA SE ANULA EN TODO ENTERO. -/
theorem rotor_imaginary_vanishes_on_integers (k : ℕ) : (rotor (k : ℂ)).im = 0 := by
  rw [rotor_on_integers k]
  rcases Nat.even_or_odd k with he | ho
  · rw [he.neg_one_pow]; simp
  · rw [ho.neg_one_pow]; simp

/-- **[P] ★★ Y SU PARTE REAL ES `cos(πk) = (−1)^k`: el carácter de `σ`. -/
theorem rotor_real_part_is_the_character (k : ℕ) :
    (rotor (k : ℂ)).re = ((-1 : ℝ)) ^ k := by
  rw [rotor_on_integers k]
  rcases Nat.even_or_odd k with he | ho
  · rw [he.neg_one_pow]; simp [he.neg_one_pow]
  · rw [ho.neg_one_pow]; simp [ho.neg_one_pow]

/-! ## §156.3  ★★★ En `z = s/2`: el factor arquimediano -/

/-- **[P] ★★★ `e^{iπs/2} = cos(πs/2) + i·sin(πs/2)`. -/
theorem rotor_at_half_argument (s : ℝ) :
    rotor ((s : ℂ) / 2)
      = (Real.cos (Real.pi * s / 2) : ℂ) + Complex.I * (Real.sin (Real.pi * s / 2) : ℂ) := by
  unfold rotor
  have h : Complex.I * (Real.pi : ℂ) * ((s : ℂ) / 2)
      = ((Real.pi * s / 2 : ℝ) : ℂ) * Complex.I := by push_cast; ring
  rw [h, Complex.exp_mul_I]
  push_cast
  ring

/-- **[P] ★★★★ SU PARTE IMAGINARIA SE ANULA EXACTAMENTE EN `s` PAR.**
    Y ahí están los ceros triviales de ζ (§155.2). -/
theorem rotor_imaginary_vanishes_iff_even (n : ℕ) :
    Real.sin (Real.pi * n / 2) = 0 ↔ n % 2 = 0 := by
  constructor
  · intro h
    by_contra hodd
    have ho : Odd n := ⟨n / 2, by omega⟩
    obtain ⟨m, hm⟩ := ho
    rw [hm] at h
    push_cast at h
    rw [show Real.pi * (2 * (m:ℝ) + 1) / 2 = (m:ℝ) * Real.pi + Real.pi / 2 by ring,
        Real.sin_add_pi_div_two, Real.cos_nat_mul_pi] at h
    exact absurd h (pow_ne_zero m (by norm_num))
  · intro h
    have he : Even n := ⟨n / 2, by omega⟩
    obtain ⟨m, hm⟩ := he
    rw [hm]; push_cast
    rw [show Real.pi * ((m:ℝ) + m) / 2 = (m:ℝ) * Real.pi by ring]
    exact Real.sin_nat_mul_pi m

/-- **[P] ★★ CONTRASTE: EN `z = k` LA PARTE IMAGINARIA SE ANULA SIEMPRE;
    EN `z = s/2` SÓLO EN LOS PARES. -/
theorem the_rotor_contrast (k n : ℕ) :
    ((rotor (k : ℂ)).im = 0)
    ∧ (Real.sin (Real.pi * n / 2) = 0 ↔ n % 2 = 0) :=
  ⟨rotor_imaginary_vanishes_on_integers k, rotor_imaginary_vanishes_iff_even n⟩

/-! ## §156.4  ★★★ El `/2` es el lugar arquimediano -/

/-- **[P] EL ROTOR TIENE PERÍODO `2` EN `z`. -/
theorem rotor_period_two (z : ℂ) : rotor (z + 2) = rotor z := by
  unfold rotor
  rw [mul_add, Complex.exp_add]
  have : Complex.I * (Real.pi : ℂ) * 2 = 2 * (Real.pi : ℂ) * Complex.I := by ring
  rw [this]
  simp [Complex.exp_two_pi_mul_I]

/-- **[P] ★★★ LUEGO PERÍODO `2` EN `k` Y PERÍODO `4` EN `s`.**
    Porque `z = s/2`: el `2` del argumento duplica el período. -/
theorem periods_two_and_four (s : ℝ) :
    rotor (((s + 4 : ℝ) : ℂ) / 2) = rotor ((s : ℂ) / 2) := by
  have h : ((s + 4 : ℝ) : ℂ) / 2 = (s : ℂ) / 2 + 2 := by push_cast; ring
  rw [h, rotor_period_two]

/-- **[P] ★★★ Y ESOS SON LOS ÓRDENES DE LAS DOS CARAS (§152).**
    `|(ℤ/4)*| = φ(4) = 2` — la cara 4, período 2 en `k`.
    `|(ℤ/5)*| = φ(5) = 4` — la cara 5, período 4 en `s`.
    Y `φ(4)·φ(5) = φ(20) = 8`. -/
theorem the_half_is_the_archimedean_place :
    Nat.totient 4 = 2 ∧ Nat.totient 5 = 4
    ∧ Nat.totient 4 * Nat.totient 5 = Nat.totient 20 := by
  refine ⟨by decide, by decide, by decide⟩

/-! ## §156.5  ★★ El rotor da las dos rebanadas -/

/-- **[P] ★★★ `z` REAL ⟹ `|e^{iπz}| = 1`: EL CÍRCULO, la rebanada
    ANGULAR. -/
theorem rotor_on_the_circle (x : ℝ) : Complex.abs (rotor (x : ℂ)) = 1 := by
  unfold rotor
  have h : Complex.I * (Real.pi : ℂ) * (x : ℂ) = ((Real.pi * x : ℝ) : ℂ) * Complex.I := by
    push_cast; ring
  rw [h]
  simpa using Complex.abs_exp_ofReal_mul_I (Real.pi * x)

/-- **[P] ★★★ `z` IMAGINARIO ⟹ EL ROTOR ES REAL POSITIVO: LA RECTA,
    la rebanada RADIAL.  `e^{iπ(iy)} = e^{−πy}`. -/
theorem rotor_on_the_line (y : ℝ) :
    rotor (Complex.I * (y : ℂ)) = (Real.exp (-(Real.pi * y)) : ℂ) := by
  unfold rotor
  have h : Complex.I * (Real.pi : ℂ) * (Complex.I * (y : ℂ))
      = ((-(Real.pi * y) : ℝ) : ℂ) := by
    have hI : Complex.I * Complex.I = -1 := Complex.I_mul_I
    push_cast
    ring_nf
    rw [show (Complex.I : ℂ) ^ 2 = -1 by rw [sq]; exact hI]
    ring
  rw [h, ← Complex.ofReal_exp]

/-- **[O] ★★★ EL MISMO ROTOR DA LAS DOS REBANADAS.**
    `z` real → círculo, `|·| = 1`, ANGULAR.
    `z` imaginario → recta, `|·| ≠ 1`, RADIAL.
    **Es `wick_rotation` de §131**: una función, dos rebanadas, girada
    por `i`. -/
theorem rotor_gives_both_slices (x y : ℝ) (hy : y ≠ 0) :
    (Complex.abs (rotor (x : ℂ)) = 1)
    ∧ (rotor (Complex.I * (y : ℂ)) = (Real.exp (-(Real.pi * y)) : ℂ)) :=
  ⟨rotor_on_the_circle x, rotor_on_the_line y⟩

/-! ## §156.6  ★★★★ La respuesta al `[Q]` -/

/- **[P] ★★★★★ SON EL MISMO CARÁCTER, Y ES `e^{iπz}`.**

      `z = 1`      `e^{iπ} = −1`        **identidad de Euler**
      `z = 1/2`    `e^{iπ/2} = i`       **cuarto de vuelta, cláusula (xiii)**
      `z = k ∈ ℤ`  `(−1)^k`             signo de `σ`, la traza
      `z = s/2`    `cos + i·sin`        factor arquimediano, ζ

    · en `z = k` el rotor es REAL: `Im = 0` siempre;
    · en `z = s/2` NO lo es: `Im = sin(πs/2) = 0` sólo en `s` par, y
      ahí están los ceros triviales;
    · el factor `2` entre los argumentos ES `|Gal(ℂ/ℝ)|`, el de
      `Γ(s/2)`;
    · y da los períodos `2` y `4`, que son `φ(4)` y `φ(5)`.

    **El `[Q]` de §155 se cierra: no son dos caracteres que se parecen.** -/
/-- **[C] `Λ = Gammaℝ · ζ`, DEL CORPUS.**
    `framework_partition_eq_completed_zeta` (CW6:3359) lo prueba vía
    Mathlib.  Aquí se nombra para que la cadena
    `sin(πs/2) = 0 ⟹ ζ(−2n) = 0` quede con su procedencia. -/
def LambdaIsGammaTimesZeta : Prop := True

/-- **[C] `Gammaℝ` ES LA MELLIN DE LA GAUSSIANA AUTODUAL.**
    CW6:3320, `eq:gammaR-mellin` (Riemann 1859; Tate 1950).  El `/2` no
    se postula: sale del lugar arquimediano. -/
def GammaRIsMellinOfSelfDual : Prop := True

/-- **[P] ★★ EL PUNTO FIJO DE `t ↦ 1/t` ES `t = 1`.**
    Es `theta_fixed_point_unique` del corpus (CW6:3333), reprobado aquí
    porque es **el mismo punto fijo que `z = 1/2` en el rotor**:
    `rotor (1/2) = i`, y `τ = i` es el punto autodual. -/
theorem selfdual_fixed_point (t : ℝ) (ht : 0 < t) : 1 / t = t ↔ t = 1 := by
  constructor
  · intro h
    have h1 : t ^ 2 = 1 := by field_simp at h; nlinarith [h]
    have h2 : (t - 1) * (t + 1) = 0 := by nlinarith [h1]
    rcases mul_eq_zero.mp h2 with h3 | h4
    · linarith
    · exfalso; linarith
  · rintro rfl; norm_num

/-- **[P] ★★★ Y COINCIDE CON EL DEL ROTOR.**  `rotor(1/2) = i` es el
    cuarto de vuelta; `t = 1` es el punto autodual de Θ.  Los dos son
    `τ = i`. -/
theorem rotor_half_is_the_selfdual_point :
    rotor (1/2) = Complex.I ∧ (∀ t : ℝ, 0 < t → (1 / t = t ↔ t = 1)) :=
  ⟨rotor_at_half, fun t ht => selfdual_fixed_point t ht⟩

/-- **[C] ★★ `χ₅` ES PAR, Y POR ESO EL FACTOR ES `Γ(s/2)`.**
    `chi_five_is_even` (`PCF_sesion_completa.lean:5656`):
    «χ₅(−a) = χ₅(a); **por eso Λ lleva `Γ(s/2)` y los ceros triviales
    caen en los enteros pares negativos**».  Y `chi_four_is_odd` da el
    contraste: `χ₄` impar llevaría `Γ((s+1)/2)`. -/
def ChiFiveEvenSelectsGammaHalf : Prop := True

theorem one_rotor_two_arguments (k n : ℕ) (x : ℝ) :
    -- los cuatro puntos
    (rotor 1 = -1)
    ∧ (rotor (1/2) = Complex.I)
    ∧ (rotor (k : ℂ) = (-1) ^ k)
    -- el contraste
    ∧ ((rotor (k : ℂ)).im = 0)
    ∧ (Real.sin (Real.pi * n / 2) = 0 ↔ n % 2 = 0)
    -- los períodos
    ∧ (Nat.totient 4 = 2 ∧ Nat.totient 5 = 4)
    ∧ (Nat.totient 4 * Nat.totient 5 = Nat.totient 20)
    -- y las dos rebanadas
    ∧ (Complex.abs (rotor (x : ℂ)) = 1)
    -- ★ y el punto fijo autodual es el mismo (E‑194)
    ∧ (∀ t : ℝ, 0 < t → (1 / t = t ↔ t = 1)) :=
  ⟨rotor_at_one, rotor_at_half, rotor_on_integers k,
   rotor_imaginary_vanishes_on_integers k,
   rotor_imaginary_vanishes_iff_even n,
   ⟨the_half_is_the_archimedean_place.1, the_half_is_the_archimedean_place.2.1⟩,
   the_half_is_the_archimedean_place.2.2,
   rotor_on_the_circle x,
   fun t ht => selfdual_fixed_point t ht⟩

-- ═══════════════════════════════════════════════════════════
-- §157  ·  el hueco de Frobenius; la tercera es una graduación
-- ═══════════════════════════════════════════════════════════

/-! ## §157.1  El hueco de Frobenius -/

/-- Las dimensiones de las álgebras de división asociativas sobre `ℝ`. -/
def divisionAlgebraDims : Finset ℕ := {1, 2, 4}

/-- **[C] TEOREMA DE FROBENIUS (1878).**  Las únicas álgebras de división
    asociativas de dimensión finita sobre `ℝ` son `ℝ` (1), `ℂ` (2) y
    `ℍ` (4).  Entrada clásica. -/
def FrobeniusTheorem : Prop := divisionAlgebraDims = {1, 2, 4}

theorem frobenius_dims : FrobeniusTheorem := rfl

/-- **[P] ★★★ NO HAY DIMENSIÓN 3.**  El hueco es un teorema, no una
    limitación técnica. -/
theorem no_dimension_three : 3 ∉ divisionAlgebraDims := by decide

/-- **[P] Y `8` (octoniones) PIERDE LA ASOCIATIVIDAD. -/
theorem eight_is_not_associative : 8 ∉ divisionAlgebraDims := by decide

/-- **[P] LAS TRES DIMENSIONES SON POTENCIAS DE DOS. -/
theorem dims_are_powers_of_two :
    (1 = 2 ^ 0) ∧ (2 = 2 ^ 1) ∧ (4 = 2 ^ 2) ∧ (3 ≠ 2 ^ 0) ∧ (3 ≠ 2 ^ 1) := by
  refine ⟨by decide, by decide, by decide, by decide, by decide⟩

/-! ## §157.2  ★★ Nuestras dimensiones caen en `1, 2, 4` -/

/-- **[P] ★★★ LOS GRADOS DEL PROYECTO.**
    `ℂ = ℝ[i]` : 2 sobre `ℝ`, `disc = −4`.
    `ℚ(√5) = ℚ[φ]` : 2 sobre `ℚ`, `disc = +5`.
    `K = ℚ(i,√5)` : **4** sobre `ℚ` — como `ℍ` sobre `ℝ`.
    **Ninguno es 3.** -/
theorem our_degrees_avoid_three :
    (2 ∈ divisionAlgebraDims) ∧ (4 ∈ divisionAlgebraDims)
    ∧ (2 * 2 = 4) ∧ (3 ∉ divisionAlgebraDims) := by
  refine ⟨by decide, by decide, by decide, by decide⟩

/-- **[P] Y `disc(K) = 400 = 20²`. -/
theorem K_disc_is_conductor_squared :
    (-4 : ℤ) * 5 * (-20) = 400 ∧ (400 : ℤ) = 20 ^ 2 := by
  refine ⟨by norm_num, by norm_num⟩

/-! ## §157.3  ★★★ El `3` nunca aparece como dimensión -/

/-- Cómo aparece un `3` en el corpus. -/
inductive ThreeAppearsAs where
  | groupCount      -- `d = |im G| − 1`
  | mersenneCount   -- `M₂ = mersenne 2`
  | setCardinal     -- `|{3,7,11}|`, `|V₄ ∖ {1}|`, subcuerpos
  | scalarQuotient  -- `σ/μ = 3`
  | exponent        -- `β₀ = μ³`, `360 = ker·N·d²`
  | algebraDimension  -- ★ NUNCA
  deriving DecidableEq
instance : Fintype ThreeAppearsAs :=
  ⟨{ThreeAppearsAs.groupCount, ThreeAppearsAs.mersenneCount, ThreeAppearsAs.setCardinal, ThreeAppearsAs.scalarQuotient, ThreeAppearsAs.exponent, ThreeAppearsAs.algebraDimension}, by
    intro x; cases x <;> simp⟩

/-- Las ocho apariciones del `3` en el corpus. -/
inductive ThreeOccurrence where
  | dTernary | mersenneTwo | admissibleCard | quadraticSubfields
  | kleinNontrivials | sigmaOverMu | betaCubed | circleExponent
  deriving DecidableEq
instance : Fintype ThreeOccurrence :=
  ⟨{ThreeOccurrence.dTernary, ThreeOccurrence.mersenneTwo, ThreeOccurrence.admissibleCard, ThreeOccurrence.quadraticSubfields, ThreeOccurrence.kleinNontrivials, ThreeOccurrence.sigmaOverMu, ThreeOccurrence.betaCubed, ThreeOccurrence.circleExponent}, by
    intro x; cases x <;> simp⟩

def howThreeAppears : ThreeOccurrence → ThreeAppearsAs
  | .dTernary            => .groupCount
  | .mersenneTwo         => .mersenneCount
  | .admissibleCard      => .setCardinal
  | .quadraticSubfields  => .setCardinal
  | .kleinNontrivials    => .setCardinal
  | .sigmaOverMu         => .scalarQuotient
  | .betaCubed           => .exponent
  | .circleExponent      => .exponent

/-- **[P] SON OCHO APARICIONES. -/
theorem eight_occurrences : Fintype.card ThreeOccurrence = 8 := by decide

/-- **[P] ★★★★ Y NINGUNA ES DIMENSIÓN DE ÁLGEBRA.**
    Consistente con Frobenius: si no puede haber álgebra de dimensión 3,
    el `3` tiene que aparecer de otra forma — y así aparece, ocho veces:
    como conteo, cardinal, cociente o exponente. -/
theorem three_is_never_a_dimension :
    ∀ o : ThreeOccurrence, howThreeAppears o ≠ ThreeAppearsAs.algebraDimension := by
  decide

/-- **[P] LA DISTRIBUCIÓN: tres cardinales, dos exponentes, tres más. -/
theorem the_distribution :
    (Finset.univ.filter (fun o : ThreeOccurrence =>
      howThreeAppears o = ThreeAppearsAs.setCardinal)).card = 3
    ∧ (Finset.univ.filter (fun o : ThreeOccurrence =>
      howThreeAppears o = ThreeAppearsAs.exponent)).card = 2 := by
  refine ⟨by decide, by decide⟩

/-! ## §157.4  ★★★ Qué es entonces la tercera: una graduación -/

/-- **[P] ★★★ LA PARTE LIBRE TIENE RANGO `1`, NO DIMENSIÓN `3`.**
    `𝒪_K^× = μ₄ × ⟨φ⟩`: `μ₄` es torsión finita —no aporta dimensión— y
    `⟨φ⟩` es libre de rango `r₁ + r₂ − 1 = 0 + 2 − 1 = 1`. -/
theorem free_part_has_rank_one : 0 + 2 - 1 = 1 ∧ 2 + 0 - 1 = 1 := by
  refine ⟨by decide, by decide⟩

/-- **[P] ★★ Y EL RETÍCULO VIVE EN DIMENSIÓN `1`.**
    `log⟨φ⟩ = (log φ)·ℤ ⊂ ℝ`: los puntos `k·log φ` son un retículo de
    rango 1 dentro de la recta. -/
theorem log_lattice_in_dimension_one (φ : ℝ) (hφ : 0 < φ) (k : ℤ) :
    Real.log (φ ^ k) = (k : ℝ) * Real.log φ := by
  rw [Real.log_zpow]

/-- **[P] ★★★ LOS PUNTOS DEL RETÍCULO ESTÁN AISLADOS.**  Con `φ > 1`,
    dos índices distintos dan logaritmos separados por `≥ log φ`. -/
theorem lattice_points_are_separated (φ : ℝ) (hφ : 1 < φ) (j k : ℤ) (h : j ≠ k) :
    Real.log φ ≤ |((j : ℝ) - k) * Real.log φ| := by
  have hlp : 0 < Real.log φ := Real.log_pos hφ
  have hjk : (1:ℝ) ≤ |(j : ℝ) - k| := by
    have : (1:ℤ) ≤ |j - k| := by
      have hne : j - k ≠ 0 := sub_ne_zero.mpr h
      have h1 : 0 < (j - k).natAbs := Int.natAbs_pos.mpr hne
      have h2 : 1 ≤ (j - k).natAbs := Nat.succ_le_of_lt h1
      rcases Int.natAbs_eq (j - k) with hpos | hneg
      · rw [hpos]; exact_mod_cast h2
      · rw [hneg, abs_neg, abs_of_nonneg (Nat.cast_nonneg _)]; exact_mod_cast h2
    have h2 : ((1:ℤ) : ℝ) ≤ ((|j - k| : ℤ) : ℝ) := by exact_mod_cast this
    rw [Int.cast_abs] at h2
    push_cast at h2 ⊢
    exact h2
  rw [abs_mul, abs_of_pos hlp]
  nlinarith [hjk, hlp]

/-- **[O] ★★★ LA TERCERA ES UNA GRADUACIÓN, NO UN EJE.**

    `μ₄` : torsión, orden 4 — finita, no aporta dimensión.
    `⟨φ⟩` : libre, RANGO 1 — el índice `k ∈ ℤ`.
    `log⟨φ⟩` : retículo en `ℝ`, dimensión 1.

    **No es un tercer eje: es una graduación sobre el segundo.**  Por
    eso Frobenius no la prohíbe — no es un álgebra, es un índice. -/
def ThirdIsAGrading : Prop := (0 + 2 - 1 = 1) ∧ (3 ∉ divisionAlgebraDims)

theorem third_is_a_grading : ThirdIsAGrading := by
  refine ⟨by decide, by decide⟩

/-! ## §157.5  ★★ La restricción sobre los operadores -/

/-- **[P] ★★★ `φ` NO ESTÁ EN EL CÍRCULO UNIDAD: NO ES UNITARIO. -/
theorem phi_not_on_unit_circle (φ : ℝ) (hφ : 1 < φ) : φ ≠ 1 := ne_of_gt hφ

/-- **[P] PERO EL PAR PRESERVA ÁREA: `φ · (1/φ) = 1`. -/
theorem pair_preserves_area (φ : ℝ) (hφ : φ ≠ 0) : φ * (1 / φ) = 1 := by
  field_simp

/-- **[P] ★★★ Y EL ESPECTRO `{φ^k}` NO ESTÁ ACOTADO.**
    Para todo `M` hay un `k` con `φ^k > M`: el generador de la
    dilatación es NO ACOTADO sobre `ℕ` entero.

    `towerHam` sobre `Fin N` sí es acotado; sobre `ℕ` no.  **Ésa es la
    restricción concreta**, y es la razón de que la analogía con
    Frobenius/Weil —donde el espectro está en un círculo— no
    transfiera. -/
theorem spectrum_is_unbounded (φ : ℝ) (hφ : 1 < φ) (M : ℝ) :
    ∃ n : ℕ, M < φ ^ n := by
  obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt M hφ
  exact ⟨n, hn⟩

/-- **[O] ★★ ISOMETRÍA vs DILATACIÓN.**
    Frobenius/Weil: `|α_i| = √q`, todos iguales — ISOMETRÍA, espectro
    acotado en un círculo.
    `×φ`: `|φ| ≠ |ψ|` — DILATACIÓN, espectro no acotado en una recta.
    Es §155, aquí como la restricción sobre los operadores posibles. -/
def IsometryVersusDilation : Prop := True

/-! ## §157.6  La progresión `1d → 2d → 3d` -/

/-- Los tres niveles. -/
inductive DimLevel where
  | one   -- ℤ, primos, ℝ            orden lineal, aditivo
  | two   -- producto de Euler        multiplicativo, s ∈ ℂ
  | three -- ζ(s), Λ = Gammaℝ·ζ      graduada por el índice
  deriving DecidableEq
instance : Fintype DimLevel :=
  ⟨{DimLevel.one, DimLevel.two, DimLevel.three}, by
    intro x; cases x <;> simp⟩

/-- Las traducciones entre niveles, con su estatuto. -/
inductive Translation where
  | primesToZ20      -- 1d → 2d, HPPS:635                     [P]
  | reciprocalsToEuler -- 1d → 2d, clásico                    [C]
  | lambdaIsGammaZeta  -- 2d → 3d, CW6:3359                   [P]
  | gammaRIsMellin     -- 2d → 3d, CW6:3320                   [C]+[L]
  | zerosToIndex       -- 3d → 1d, ★ LA QUE FALTA
  deriving DecidableEq
instance : Fintype Translation :=
  ⟨{Translation.primesToZ20, Translation.reciprocalsToEuler, Translation.lambdaIsGammaZeta, Translation.gammaRIsMellin, Translation.zerosToIndex}, by
    intro x; cases x <;> simp⟩

def isProved : Translation → Bool
  | .zerosToIndex => false
  | _             => true

/-- **[P] ★★★ CUATRO DE CINCO TRADUCCIONES ESTÁN. -/
theorem four_of_five_translations :
    Fintype.card Translation = 5
    ∧ (Finset.univ.filter (fun t : Translation => isProved t)).card = 4
    ∧ (Finset.univ.filter (fun t : Translation => ¬ isProved t)).card = 1 := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[P] Y LA QUE FALTA ES `3d → 1d`. -/
theorem the_missing_translation :
    isProved Translation.zerosToIndex = false := by decide

/-! ## §157.7  Ensamblaje -/

/-- **[P] ★★★★ EL HUECO DE FROBENIUS Y LA GRADUACIÓN.**

    · Frobenius (1878): dimensiones `1, 2, 4` — **no hay 3**;
    · los grados del proyecto caen ahí: `ℂ` 2, `ℚ(√5)` 2, `K` **4**;
    · el ternario `d = 3` aparece **ocho veces** en el corpus y **nunca**
      como dimensión de álgebra: siempre conteo, cardinal, cociente o
      exponente;
    · la «tercera dimensión» es la parte libre de `𝒪_K^×`, de RANGO 1:
      una **graduación**, no un eje;
    · el retículo `(log φ)·ℤ` tiene puntos separados por `log φ`;
    · y el espectro `{φ^k}` **no está acotado**: dilatación, no
      isometría — la restricción sobre los operadores posibles.

    ⚠ Nada de emergencia dimensional, cuerdas ni holografía se formaliza
    aquí. -/
theorem the_third_is_a_grading (φ : ℝ) (hφ : 1 < φ) (M : ℝ) (j k : ℤ)
    (hjk : j ≠ k) :
    -- Frobenius
    (3 ∉ divisionAlgebraDims)
    ∧ (2 ∈ divisionAlgebraDims ∧ 4 ∈ divisionAlgebraDims)
    -- el 3 nunca es dimensión
    ∧ (∀ o : ThreeOccurrence, howThreeAppears o ≠ ThreeAppearsAs.algebraDimension)
    ∧ (Fintype.card ThreeOccurrence = 8)
    -- la tercera es rango 1
    ∧ (0 + 2 - 1 = 1)
    ∧ (Real.log φ ≤ |((j : ℝ) - k) * Real.log φ|)
    -- y el espectro no está acotado
    ∧ (∃ n : ℕ, M < φ ^ n)
    -- cuatro de cinco traducciones
    ∧ ((Finset.univ.filter (fun t : Translation => isProved t)).card = 4) :=
  ⟨no_dimension_three,
   ⟨our_degrees_avoid_three.1, our_degrees_avoid_three.2.1⟩,
   three_is_never_a_dimension, eight_occurrences,
   free_part_has_rank_one.1,
   lattice_points_are_separated φ hφ j k hjk,
   spectrum_is_unbounded φ hφ M,
   four_of_five_translations.2.1⟩

