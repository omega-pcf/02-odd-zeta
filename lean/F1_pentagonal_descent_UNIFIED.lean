/-! ## §121.1  Los tres cosenos: la cara π -/

/-- **[P] LOS TRES COSENOS SON `1, −1/2, −1/2`.**  La cara angular,
    del retículo de Eisenstein. -/
theorem three_cosines₁ :
    Real.cos 0 = 1 ∧
    Real.cos (2 * Real.pi / 3) = -(1 / 2) ∧
    Real.cos (4 * Real.pi / 3) = -(1 / 2) := by
  refine ⟨Real.cos_zero, ?_, ?_⟩
  · rw [show (2 : ℝ) * Real.pi / 3 = Real.pi - Real.pi / 3 by ring,
        Real.cos_pi_sub, Real.cos_pi_div_three]
  · rw [show (4 : ℝ) * Real.pi / 3 = Real.pi + Real.pi / 3 by ring,
        Real.cos_add, Real.cos_pi]
    norm_num

/-- **[P] Y SU SUMA ES CERO: LA TRAZA.**  `1 − 1/2 − 1/2 = 0`. -/
theorem cosines_sum_zero :
    (1 : ℝ) + (-(1 / 2)) + (-(1 / 2)) = 0 := by norm_num

/-! ## §121.2  Cada autovalor es el producto de las dos caras -/

/-- **[C] LA CARA φ.**  `φ^{−λ} = μ₃ = 1/2`, con `λ = log_φ 2`
    ---`phi_neg_lambda_eq_mu3`.  Entrada en la firma. -/
def PhiFaceIsHalf (v : ℝ) : Prop := v = 1 / 2

/-- **[P] EL PRODUCTO DA EL ESPECTRO, EXACTO.**  `(1/2)·(1,−1/2,−1/2)
    = (1/2,−1/4,−1/4)`.

    **Ésta es la conmutación: el operador no aproxima desde fuera, su
    espectro ES el ápice por el ternario.** -/
theorem spectrum_is_the_product₁ (v : ℝ) (hv : PhiFaceIsHalf v) :
    (v * 1 = 1 / 2) ∧
    (v * (-(1 / 2)) = -(1 / 4)) ∧
    (v * 1 + v * (-(1 / 2)) + v * (-(1 / 2)) = 0) := by
  unfold PhiFaceIsHalf at hv
  subst hv
  refine ⟨by norm_num, by norm_num, by norm_num⟩

/-- **[P] Y LA NORMA ES LA PATA 2.**  `‖Ω̂₀‖ = μ₃`: el operador es
    una pata del cocono, no un objeto externo. -/
theorem operator_norm_is_leg_two (v : ℝ) (hv : PhiFaceIsHalf v) :
    v = 1 / 2 := hv

/-! ## §121.3  El espectro tiene las dos lecturas -/

/-- **[P] ADITIVA: TRAZA CERO.**  `1/2 − 1/4 − 1/4 = 0`, porque
    `Σ_k cos(2πk/3) = 0`. -/
theorem trace_is_zero : (1 : ℝ) / 2 + (-(1 / 4)) + (-(1 / 4)) = 0 := by
  norm_num

/-- **[P] MULTIPLICATIVA: `det = 2⁻⁵`.**  `(1/2)(−1/4)(−1/4) = 1/32`,
    y `1/32 = φ^{−5λ}`: BASE `2` ---el grado de `x²=x+1`--- y
    EXPONENTE `5` ---el pentágono. -/
theorem det_is_two_to_minus_five_l818 :
    (1 / 2 : ℝ) * (-(1 / 4)) * (-(1 / 4)) = 1 / 32 ∧
    (1 / 32 : ℝ) = 1 / 2 ^ (5 : ℕ) := by
  refine ⟨by norm_num, by norm_num⟩

/-- **[O] LA MISMA DUALIDAD EN TRES SITIOS.**

    | objeto | aditiva | multiplicativa |
    |---|---|---|
    | `spec Ω̂` | traza `= 0` | `det = φ^{−5λ}` |
    | `log Λ` | `Σ log\|z\| = 0` | `∏\|z\| = 1` |
    | el par `(r,1/r)` | `r + 1/r = 2` ← **E** | `r·(1/r) = 1` |

    En los tres la multiplicativa está probada; la aditiva vale cero
    o es `E`. -/
theorem same_duality_three_places_l818 (r : ℝ) (hr : 0 < r) :
    ((1 : ℝ) / 2 + (-(1 / 4)) + (-(1 / 4)) = 0) ∧
    ((1 / 2 : ℝ) * (-(1 / 4)) * (-(1 / 4)) = 1 / 32) ∧
    (r * (1 / r) = 1) ∧
    ((r + 1 / r = 2) ↔ r = 1) := by
  refine ⟨trace_is_zero, det_is_two_to_minus_five_l818.1, by field_simp, ?_⟩
  constructor
  · intro h
    have hne : r ≠ 0 := ne_of_gt hr
    field_simp at h
    nlinarith [h, sq_nonneg (r - 1)]
  · intro h; rw [h]; norm_num

/-! ## §121.4  Los cuatro requisitos, sobre `Ω̂` -/

/-- Los requisitos, con la evaluación correcta. -/
inductive OmegaRequirement where
  | nonCircular   : OmegaRequirement   -- del fragmento ternario
  | realSpectrum  : OmegaRequirement   -- (1/2, −1/4, −1/4)
  | exactSpectrum : OmegaRequirement   -- tres valores cerrados
  | unconditional : OmegaRequirement   -- ← el paso 8
deriving DecidableEq

instance : Fintype OmegaRequirement :=
  ⟨{OmegaRequirement.nonCircular, OmegaRequirement.realSpectrum, OmegaRequirement.exactSpectrum, OmegaRequirement.unconditional}, by
    intro x; cases x <;> simp⟩

/-- Cuáles cumple `Ω̂`. -/
def omegaMeets : OmegaRequirement → Bool
  | OmegaRequirement.unconditional => false
  | _ => true

/-- **[P] `Ω̂` CUMPLE TRES DE CUATRO.**  No dos, como dije en §120 al
    evaluar `H̃_PCF`.  **Y el que falta es el EMBEDDING.** -/
theorem omega_meets_three :
    (Finset.univ.filter (fun r : OmegaRequirement => omegaMeets r)).card = 3 ∧
    (Finset.univ.filter (fun r : OmegaRequirement => ¬ omegaMeets r)).card = 1 := by
  refine ⟨by decide, by decide⟩

/-- **[O] EL BALANCE DE §121.**

    | | §120 | §121 |
    |---|---|---|
    | operador evaluado | `H̃_PCF` | **`Ω̂`** |
    | requisitos | 2 de 4 | **3 de 4** |
    | lo que falta | exactitud del espectro | **el paso 8, el embedding** |
    | criterio usado | la cifra verificada | **la conmutación con el cocono** |

    **Nada de esto prueba `E`.**  Y coincide con §45 y §79: un solo
    abierto, no dos ---yo había inventado el segundo al mirar la
    cifra en vez de la estructura. -/
theorem the_balance_of_section_121 (v r : ℝ) (hv : PhiFaceIsHalf v)
    (hr : 0 < r) :
    (v * 1 = 1 / 2) ∧
    ((1 : ℝ) / 2 + (-(1 / 4)) + (-(1 / 4)) = 0) ∧
    ((1 / 2 : ℝ) * (-(1 / 4)) * (-(1 / 4)) = 1 / 32) ∧
    ((Finset.univ.filter (fun q : OmegaRequirement => omegaMeets q)).card = 3) :=
  ⟨(spectrum_is_the_product₁ v hv).1, trace_is_zero,
  det_is_two_to_minus_five_l818.1, omega_meets_three.1⟩

