-- §163  ·  un solo enunciado abierto; el aparato está completo
-- ═══════════════════════════════════════════════════════════

/-! ## §163.1  Las tres piezas del aparato -/

/-- Las tres piezas donde entra cada cosa. -/
inductive Piece where
  | lambda      -- Λ: GENERA los ceros por Hadamard;  Λ(0) = 2 log φ
  | fejer       -- fejerEnv: los PESA en la fórmula explícita
  | tower       -- towerHam: da los COCIENTES {φ^k}
  deriving DecidableEq
instance : Fintype Piece :=
  ⟨{Piece.lambda, Piece.fejer, Piece.tower}, by
    intro x; cases x <;> simp⟩

/-- Qué cancela cada una. -/
inductive Cancels where
  | nothing     -- Λ no cancela: ancla
  | height      -- fejerEnv cancela ρ²
  | scale       -- towerHam cancela m₀
  deriving DecidableEq
instance : Fintype Cancels :=
  ⟨{Cancels.nothing, Cancels.height, Cancels.scale}, by
    intro x; cases x <;> simp⟩

def cancelsOf : Piece → Cancels
  | .lambda => .nothing
  | .fejer  => .height
  | .tower  => .scale

/-- **[P] SON TRES, Y CADA UNA CANCELA UNA COSA DISTINTA. -/
theorem three_pieces_three_cancellations :
    Fintype.card Piece = 3
    ∧ cancelsOf Piece.lambda = Cancels.nothing
    ∧ cancelsOf Piece.fejer = Cancels.height
    ∧ cancelsOf Piece.tower = Cancels.scale := by
  refine ⟨by decide, by decide, by decide, by decide⟩

/-- **[C] `Λ` GENERA LOS CEROS.**  §116.3: «`Λ(0) = 2 log φ` determina
    `φ`; **`Λ` determina sus ceros por Hadamard**».  Y
    `phi_from_the_anchor₆ : exp(Λ₀/2) = φ`  `[P]`. -/
def LambdaGenerates (Λ₀ φ : ℝ) : Prop := Λ₀ = 2 * Real.log φ ∧ 0 < φ

/-- **[P] Y `φ` SE RECUPERA DEL ANCLA. -/
theorem phi_from_anchor_G (Λ₀ φ : ℝ) (h : LambdaGenerates Λ₀ φ) :
    Real.exp (Λ₀ / 2) = φ := by
  obtain ⟨h1, h2⟩ := h
  rw [h1]
  field_simp
  exact Real.exp_log h2

/-- La envolvente de Fejér.  §76.2 del corpus. -/
def fejerE (L δ ρsq : ℝ) : ℝ := 2 * (Real.cosh (L * δ)) ^ 2 / (L * ρsq)

/-- **[P] ★★ `fejerEnv` CANCELA LA ALTURA.**  El cociente entre `δ` y
    `0` es `cosh²(Lδ)` y **no contiene `ρ²`**: la sensibilidad a `δ` es
    UNIFORME en la altura.  Es `ratio_is_free_of_height` (§76.2). -/
theorem fejer_cancels_height (L δ ρsq : ℝ) (hL : L ≠ 0) (hρ : ρsq ≠ 0) :
    (L * fejerE L δ ρsq) / (L * fejerE L 0 ρsq) = (Real.cosh (L * δ)) ^ 2 := by
  unfold fejerE
  rw [mul_zero, Real.cosh_zero]
  have hc : (Real.cosh (L * δ)) ≠ 0 := ne_of_gt (Real.cosh_pos _)
  field_simp

/-- El autovalor de la torre. -/
def towerEg (m₀ φ : ℝ) (i : ℕ) : ℝ := m₀ * φ ^ i

/-- **[P] ★★ `towerHam` CANCELA LA ESCALA.**  Es §142
    `spectral_ratio_is_scale_free`. -/
theorem tower_cancels_scale (m₀ m₁ φ : ℝ) (h0 : m₀ ≠ 0) (h1 : m₁ ≠ 0)
    (hφ : φ ≠ 0) (i j : ℕ) :
    towerEg m₀ φ i / towerEg m₀ φ j = towerEg m₁ φ i / towerEg m₁ φ j := by
  unfold towerEg
  have hp : ∀ n : ℕ, φ ^ n ≠ 0 := fun n => pow_ne_zero n hφ
  have := hp i; have := hp j
  field_simp

/-- **[O] ★★★ LAS DOS CANCELACIONES SON LA PAREJA.**
      `towerHam` quita la ESCALA;  `fejerEnv` quita la ALTURA.
    Y `Λ` no quita nada: es el ancla que las ata a `φ`. -/
theorem the_two_cancellations (m₀ m₁ φ L δ ρsq : ℝ)
    (h0 : m₀ ≠ 0) (h1 : m₁ ≠ 0) (hφ : φ ≠ 0) (hL : L ≠ 0) (hρ : ρsq ≠ 0)
    (i j : ℕ) :
    (towerEg m₀ φ i / towerEg m₀ φ j = towerEg m₁ φ i / towerEg m₁ φ j)
    ∧ ((L * fejerE L δ ρsq) / (L * fejerE L 0 ρsq) = (Real.cosh (L * δ)) ^ 2) :=
  ⟨tower_cancels_scale m₀ m₁ φ h0 h1 hφ i j, fejer_cancels_height L δ ρsq hL hρ⟩

/-! ## §163.2  ★★★★ El conjunto de cocientes ES `MonomialHalf` -/

/-- El conjunto de cocientes de la torre. -/
def RatioSetG (φ r : ℝ) : Prop := ∃ k : ℤ, r = φ ^ k

/-- La pertenencia del corpus. -/
def MonomialG (φ r : ℝ) : Prop := ∃ n : ℤ, r = φ ^ n

/-- **[P] ★★★★★ SON EL MISMO CONJUNTO, DEFINICIONALMENTE.**

    En el unificado, `ratio_set_is_the_free_part` y
    `monomial_is_in_image_of_realiseP` son ambos `Iff.rfl`.

    **Luego «que los `σ` de `towerHam` sean los `k` de los ceros» NO es
    un brinco pendiente: es el MISMO enunciado que (A).**  §142 lo hizo. -/
theorem ratio_set_is_monomial (φ r : ℝ) : RatioSetG φ r ↔ MonomialG φ r :=
  Iff.rfl

/-- **[P] Y TODO COCIENTE ESTÁ EN ÉL. -/
theorem every_ratio_is_in (m₀ φ : ℝ) (h0 : m₀ ≠ 0) (hφ : φ ≠ 0) (i j : ℕ) :
    RatioSetG φ (towerEg m₀ φ i / towerEg m₀ φ j) := by
  refine ⟨(i : ℤ) - (j : ℤ), ?_⟩
  unfold towerEg
  have hp : ∀ n : ℕ, φ ^ n ≠ 0 := fun n => pow_ne_zero n hφ
  have := hp i; have := hp j
  rw [zpow_sub₀ hφ, zpow_natCast, zpow_natCast]
  field_simp

/-! ## §163.3  ★ Los cuatro candados están en el operador -/

inductive Lock where
  | arithmetic  -- towerHam diagonal real ⟹ sin torsión; bounded_below
  | functional  -- transposition_inverts_the_ratio; punto fijo la diagonal
  | continuous  -- diagonal_is_the_parabolic_locus
  | metric      -- ratio_trace_ge_two + retículo log φ
  deriving DecidableEq
instance : Fintype Lock :=
  ⟨{Lock.arithmetic, Lock.functional, Lock.continuous, Lock.metric}, by
    intro x; cases x <;> simp⟩

def lockIsInOperator : Lock → Bool := fun _ => true

/-- **[P] ★★★ LOS CUATRO, EN EL OPERADOR.**  §142 los tiene los cuatro;
    §137 tenía tres sobre `k`.  Ninguno falta. -/
theorem four_locks_all_in :
    Fintype.card Lock = 4
    ∧ (Finset.univ.filter (fun l : Lock => lockIsInOperator l)).card = 4 := by
  refine ⟨by decide, by decide⟩

/-- **[P] EL CANDADO CONTINUO, EXPLÍCITO: la diagonal es parabólica. -/
theorem diagonal_is_parabolic (m₀ φ : ℝ) (h0 : m₀ ≠ 0) (hφ : φ ≠ 0) (i : ℕ) :
    towerEg m₀ φ i / towerEg m₀ φ i = 1
    ∧ ((1:ℝ) + 1/1) = 2
    ∧ ((1:ℝ) + 1/1) ^ 2 - 4 = 0 := by
  refine ⟨?_, by norm_num, by norm_num⟩
  unfold towerEg
  have : φ ^ i ≠ 0 := pow_ne_zero i hφ
  field_simp

/-- **[P] EL MÉTRICO: la traza del cociente es `≥ 2`. -/
theorem ratio_trace_floor (r : ℝ) (hr : 0 < r) : 2 ≤ r + 1 / r := by
  have h : r + 1 / r - 2 = (r - 1) ^ 2 / r := by field_simp; ring
  nlinarith [div_nonneg (sq_nonneg (r - 1)) hr.le, h]

/-! ## §163.4  ★★★★ Un solo enunciado abierto -/

/-- **[O] ★★★★★ LO ABIERTO, CONTADO: UNO.**

        `r ∈ {φ^k}`

    que es `RatioSet` = `MonomialHalf` = (A) = `membership_is_equivalent_to_E`
    (§105) = `E`.

    **Y no ha cambiado desde §105 del corpus.**  Lo que la sesión hizo
    fue quitarle disfraces y parámetros, no reducirlo.

    Alrededor está TODO:
      · `Λ` genera los ceros por Hadamard          §116.3
      · `fejerEnv` los pesa, sin degradarse        §76.2
      · `towerHam` da los cocientes, sin escala    §142
      · los cuatro candados, en el operador         §142
      · `𝒪_K ∩ ℝ = ℤ[φ]`                            §160–§161
      · `φ` es la unidad fundamental                §154
      · basta «entero algebraico», no «unidad»      §162 -/
def TheOneOpenStatement (φ r : ℝ) : Prop := ∃ k : ℤ, r = φ ^ k

/-- **[P] Y CON ÉL, LA CADENA CIERRA. -/
theorem the_chain_closes (φ r : ℝ) (hφ : 1 < φ) (hr : 0 < r)
    (hA : TheOneOpenStatement φ r)
    (hgap : ∀ k : ℤ, k ≠ 0 → (3:ℝ) ≤ φ ^ k + 1 / φ ^ k)
    (hb : r + 1 / r < 3) : r = 1 := by
  obtain ⟨k, rfl⟩ := hA
  by_cases hk : k = 0
  · subst hk; norm_num
  · exact absurd hb (not_lt.mpr (hgap k hk))

/-! ## §163.5  Y lo que la sesión cambió, que es de FORMA -/

/-- **[O] ★★★ EL CAMBIO REAL DE §142.**

        antes:  `r` es AUTOVALOR de un operador   ← hay que fijar `m₀`
        ahora:  `r` es un COCIENTE de autovalores ← `m₀` se cancela

    **El enunciado perdió el parámetro de escala.**  Ése fue el avance,
    y es de forma, no de dificultad.  NO lo fue «encontrar el operador»
    ni «hacer que los ceros indexen»: las dos cosas ya estaban. -/
theorem the_real_change (m₀ m₁ φ : ℝ) (h0 : m₀ ≠ 0) (h1 : m₁ ≠ 0)
    (hφ : φ ≠ 0) (i j : ℕ) :
    towerEg m₀ φ i / towerEg m₀ φ j = towerEg m₁ φ i / towerEg m₁ φ j :=
  tower_cancels_scale m₀ m₁ φ h0 h1 hφ i j

/-- **[O] ★★★★ EL BALANCE DE §163, Y DE LA SESIÓN.**

    · tres piezas, tres cancelaciones distintas — ninguna falta;
    · el conjunto de cocientes ES `MonomialHalf`, `Iff.rfl`;
    · los cuatro candados están en el operador;
    · **un solo** enunciado abierto, el de §105;
    · y lo que la sesión aportó es de forma: el enunciado perdió `m₀`,
      perdió cuatro disfraces (§131), fijó el cuerpo (§160–§161), y se
      debilitó a «entero algebraico» (§162).

    ⚠⚠ E‑199: cinco respuestas presentaron piezas probadas como si
    faltaran.  Ninguna añadió nada abierto. -/
theorem one_open_statement (φ r : ℝ) (hφ : 1 < φ) (hr : 0 < r)
    (m₀ m₁ L δ ρsq : ℝ) (h0 : m₀ ≠ 0) (h1 : m₁ ≠ 0) (hφ0 : φ ≠ 0)
    (hL : L ≠ 0) (hρ : ρsq ≠ 0) (i j : ℕ) :
    -- tres piezas
    (Fintype.card Piece = 3)
    -- dos cancelaciones
    ∧ (towerEg m₀ φ i / towerEg m₀ φ j = towerEg m₁ φ i / towerEg m₁ φ j)
    ∧ ((L * fejerE L δ ρsq) / (L * fejerE L 0 ρsq) = (Real.cosh (L * δ)) ^ 2)
    -- el conjunto es el mismo, definicionalmente
    ∧ (RatioSetG φ r ↔ MonomialG φ r)
    -- los cuatro candados
    ∧ (Fintype.card Lock = 4)
    -- y el suelo
    ∧ (2 ≤ r + 1 / r) :=
  ⟨three_pieces_three_cancellations.1,
   tower_cancels_scale m₀ m₁ φ h0 h1 hφ0 i j,
   fejer_cancels_height L δ ρsq hL hρ,
   ratio_set_is_monomial φ r,
   four_locks_all_in.1,
   ratio_trace_floor r hr⟩

