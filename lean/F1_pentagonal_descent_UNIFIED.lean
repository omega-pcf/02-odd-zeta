/-- The complete formalisation collected in a single statement. -/
theorem F1_PCF_complete :
    -- (A) Foundation: φ identities (now all theorems).
    (φ ^ 2 = φ + 1) ∧
    (φ = 1 + 1 / φ) ∧
    (φ = Real.sqrt (1 + φ)) ∧
    -- (B) Convergence (now theorems).
    Filter.Tendsto cf Filter.atTop (nhds φ) ∧
    Filter.Tendsto nr Filter.atTop (nhds φ) ∧
    -- (C) Tripartite norm (now theorem).
    (∀ z : ℂ, ∀ σ : ℝ, ‖Omega z σ‖ = 1/2) ∧
    -- (D) Z₂₀* arithmetic.
    (∀ a b : ZMod 20,
       a ∈ ZtwentyStar → b ∈ ZtwentyStar →
       (a * b ∈ ZtwentyStar) ∧ ((a + b) ∉ ZtwentyStar)) ∧
    -- (E) Monoidal F₁-descent (Borger axioms).
    (∀ p q : ℕ, ∀ n : ℤ, psi p (psi q n) = psi (p * q) n) ∧
    (∀ p : ℕ, ∀ n : ℤ, realise (psi p n) = realise n ^ p) ∧
    -- (F) Analytic core: counting bound.
    (∀ u : ℕ, ∀ a b : ℤ,
       |a| ≤ (u : ℤ) + 1 → |b| ≤ (u : ℤ) + 1 →
       |normForm a b| ≤ 4 * ((u : ℤ) + 1)^2) ∧
    -- (G) Structural: X_PCF is the F₁-monoid object.
    X_PCF.carrier = ℤ ∧
    -- (H) RH squeeze.
    (∀ z : TernaryLZero, z.ρ_re = 1/2) := by
  refine ⟨phi_sq, φ_self_ref, φ_nested_ref,
          phi_continued_fraction, phi_nested_radical,
          modulus_Omega, ?z20, psi_comp, psi_realise_pow,
          counting_quadratic_bound, X_PCF_carrier_eq, rh_squeeze⟩
  intro a b ha hb
  refine ⟨mul_preserved_Z20 a b ha hb, ?_⟩
  exact add_destroyed a ha b hb


