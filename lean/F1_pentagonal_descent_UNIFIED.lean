/-! ## 1.  Un homomorfismo del grupo de cubierta al grupo de niveles -/

/-- «`f` es un homomorfismo `μ₆ → ℤ`», escrito por exponentes: la fibra suma
    mod 6, el nivel suma en `ℤ`. -/
def IsLevelHom (f : Nat → Int) : Prop :=
  ∀ a b : Nat, f ((a + b) % 6) = f a + f b

/-- **[P] MANDA EL NEUTRO AL NEUTRO.** -/
theorem levelHom_at_zero (f : Nat → Int) (h : IsLevelHom f) : f 0 = 0 := by
  have h0 : f 0 = f 0 + f 0 := h 0 0
  omega

/-- **[P] Hom(μ₆, ℤ) = 0.**  Todo homomorfismo del grupo de cubierta al grupo
    de niveles es idénticamente cero.

    La razón es la de siempre y no se puede esquivar: seis pasos de cubierta
    vuelven al origen, luego `6·f(1) = f(0) = 0` en `ℤ`, luego `f(1) = 0`
    porque `ℤ` no tiene torsión, luego todo `f(n) = n·f(1) = 0`. -/
theorem levelHom_trivial (f : Nat → Int) (h : IsLevelHom f) :
    f 0 = 0 ∧ f 1 = 0 ∧ f 2 = 0 ∧ f 3 = 0 ∧ f 4 = 0 ∧ f 5 = 0 := by
  have h0 : f 0 = f 0 + f 0 := h 0 0
  have h2 : f 2 = f 1 + f 1 := h 1 1
  have h3 : f 3 = f 2 + f 1 := h 2 1
  have h4 : f 4 = f 3 + f 1 := h 3 1
  have h5 : f 5 = f 4 + f 1 := h 4 1
  have h6 : f 0 = f 5 + f 1 := h 5 1
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> omega

/-! ## 2.  Luego ninguno es fiel -/

/-- **[P] NINGÚN HOMOMORFISMO AL NIVEL ES INYECTIVO.**  Dos puntos distintos
    de la fibra reciben siempre el mismo valor.  «Absorber `μ₆` en el nivel»
    es exactamente pedir un homomorfismo inyectivo, y no existe. -/
theorem no_faithful_level_hom (f : Nat → Int) (h : IsLevelHom f) :
    ¬ (∀ a b : Nat, a < 6 → b < 6 → f a = f b → a = b) := by
  intro hinj
  have ht := levelHom_trivial f h
  have e : f 1 = f 0 := by
    rcases ht with ⟨e0, e1, _, _, _, _⟩
    omega
  exact absurd (hinj 1 0 (by decide) (by decide) e) (by decide)

/-- **[P] TODO HOMOMORFISMO AL NIVEL SE ANULA EN LA FIBRA ENTERA.** -/
theorem levelHom_vanishes (f : Nat → Int) (h : IsLevelHom f) :
    ∀ a : Nat, a < 6 → f a = 0 := by
  intro a ha
  rcases levelHom_trivial f h with ⟨e0, e1, e2, e3, e4, e5⟩
  match a, ha with
  | 0, _ => exact e0
  | 1, _ => exact e1
  | 2, _ => exact e2
  | 3, _ => exact e3
  | 4, _ => exact e4
  | 5, _ => exact e5
  | (n + 6), hn => exact absurd hn (by omega)

/-- **[P] Y LA DEGENERACIÓN ES TOTAL, NO PARCIAL.**  No es que colapsen dos
    puntos: los seis reciben el mismo valor. -/
theorem level_hom_collapses_the_whole_fibre (f : Nat → Int) (h : IsLevelHom f) :
    ∀ a b : Nat, a < 6 → b < 6 → f a = f b := by
  intro a b ha hb
  rw [levelHom_vanishes f h a ha, levelHom_vanishes f h b hb]

/-! ## 3.  El contraste: lo que el nivel no puede, el dual sí -/

/-- **[P] EL DUAL NO ES UN NIVEL.**  `χ₁` separa la fibra
    (`dual_separates_the_fibre`), luego no es un homomorfismo al nivel: si lo
    fuera, sería trivial por `levelHom_trivial` y no separaría nada.

    Ésta es la diferencia con el caso absorbible: la fibra se puede leer, pero
    no con un carácter del grupo de niveles. -/
theorem the_separating_character_is_not_a_level_hom :
    ¬ ∃ f : Nat → Int, IsLevelHom f ∧
        (∀ a b : Nat, a < 6 → b < 6 → a ≠ b → f a ≠ f b) := by
  intro hex
  rcases hex with ⟨f, hhom, hsep⟩
  exact hsep 0 1 (by decide) (by decide) (by decide)
    (level_hom_collapses_the_whole_fibre f hhom 0 1 (by decide) (by decide))

/-- **[P] EL NIVEL ES CIEGO POR CONSTRUCCIÓN, NO POR ELECCIÓN.**  El paso de
    cubierta preserva el nivel; luego cualquier observable escrito sobre el
    nivel es constante en la órbita, y la órbita es toda la fibra. -/
theorem deck_step_preserves_the_level (i : JointIdx) : (deckStep i).1 = i.1 := rfl

/-! ## 4.  La conjunción -/

/-- **[P⊕] μ₆ NO ES ABSORBIBLE EN EL NIVEL.**

    (a) `Hom(μ₆, ℤ) = 0`: todo homomorfismo del grupo de cubierta al grupo de
        niveles es trivial —`ℤ` no tiene torsión, `μ₆` es toda torsión—;
    (b) luego ninguno es inyectivo, y de hecho colapsa los seis puntos;
    (c) luego no hay carácter del grupo de niveles que separe la fibra;
    (d) pero `μ̂₆` sí la separa.

    La información de la fibra existe y es legible; lo que no se puede es
    codificarla en el nivel.  Ésa es la diferencia precisa con un esquema en
    que el factor finito se absorbe en el espacio interno. -/
theorem mu6_is_not_absorbable_into_the_level :
    (∀ f : Nat → Int, IsLevelHom f →
      f 0 = 0 ∧ f 1 = 0 ∧ f 2 = 0 ∧ f 3 = 0 ∧ f 4 = 0 ∧ f 5 = 0) ∧
    (∀ f : Nat → Int, IsLevelHom f →
      ¬ (∀ a b : Nat, a < 6 → b < 6 → f a = f b → a = b)) ∧
    (¬ ∃ f : Nat → Int, IsLevelHom f ∧
        (∀ a b : Nat, a < 6 → b < 6 → a ≠ b → f a ≠ f b)) ∧
    (∀ a ∈ fib6, ∀ b ∈ fib6, a ≠ b → ∃ k ∈ dual6, chr k a ≠ chr k b) :=
  ⟨levelHom_trivial, no_faithful_level_hom,
   the_separating_character_is_not_a_level_hom, dual_separates_the_fibre⟩



