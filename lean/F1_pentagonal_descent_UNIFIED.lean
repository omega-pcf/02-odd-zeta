/-! ## §95.1  La cota es POR CERO, no agregada -/

/-- **[P] UNA SUMA DE NO NEGATIVOS ACOTADA ACOTA CADA TÉRMINO.**
    Trivial, y es lo que convierte el emparedado en enunciado
    universal sobre los ceros.

    **Ésta es la pieza que yo trataba como agregada y no lo es.** -/
theorem termwise_from_sum {ι : Type*} (S : Finset ι) (f : ι → ℝ) (B : ℝ)
    (hnn : ∀ i ∈ S, 0 ≤ f i) (hsum : S.sum f ≤ B) :
    ∀ i ∈ S, f i ≤ B := by
  intro i hi
  calc f i ≤ S.sum f := Finset.single_le_sum hnn hi
    _ ≤ B := hsum

/-- **[P] Y LA COTA DE CONTEO.**  Si la suma es `≤ B` y cada término
    con `f i ≥ ε` aporta al menos `ε`, el número de tales términos es
    a lo sumo `B/ε`.

    Finito por nivel, no sólo pequeño. -/
theorem counting_from_sum {ι : Type*} (S : Finset ι) (f : ι → ℝ)
    (B ε : ℝ) (hε : 0 < ε)
    (hnn : ∀ i ∈ S, 0 ≤ f i) (hsum : S.sum f ≤ B) :
    ((S.filter (fun i => ε ≤ f i)).card : ℝ) * ε ≤ B := by
  classical
  have h1 : ((S.filter (fun i => ε ≤ f i)).card : ℝ) * ε
      = (S.filter (fun i => ε ≤ f i)).sum (fun _ => ε) := by
    rw [Finset.sum_const, nsmul_eq_mul]
  rw [h1]
  calc (S.filter (fun i => ε ≤ f i)).sum (fun _ => ε)
      ≤ (S.filter (fun i => ε ≤ f i)).sum f := by
        refine Finset.sum_le_sum ?_
        intro i hi
        exact (Finset.mem_filter.mp hi).2
    _ ≤ S.sum f := by
        refine Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _) ?_
        intro i hi _
        exact hnn i hi
    _ ≤ B := hsum

/-! ## §95.2  Los cuatro atributos, como predicados -/

/-- Un asidero es POR CERO si su enunciado cuantifica sobre cada
    cero, no sobre el conjunto. -/
def PerZero (P : ℂ → Prop) : Prop := ∀ ρ : ℂ, P ρ ∨ ¬ P ρ

/-- NO DECAE si su contenido no depende de la altura.  Se modela con
    una cantidad constante en `γ`. -/
def HeightIndependent (v : ℂ → ℝ) : Prop :=
  ∀ ρ σ : ℂ, ρ.re = σ.re → v ρ = v σ

/-- SEPARA si distingue la línea del resto. -/
def Separates (v : ℂ → ℝ) : Prop :=
  (∀ ρ : ℂ, ρ.re = 1 / 2 → v ρ = 0) ∧ (∃ ρ : ℂ, v ρ ≠ 0)

/-- **[P] `|órbita|` NO DECAE.**  Su valor depende sólo de `Re ρ`,
    no de `γ`: es `2` en la línea y `4` fuera, a toda altura. -/
def orbitCardOf (ρ : ℂ) : ℝ := if ρ.re = 1 / 2 then 2 else 4

theorem orbit_card_is_height_independent : HeightIndependent orbitCardOf := by
  intro ρ σ h
  unfold orbitCardOf
  rw [h]

/-- **[P] Y SEPARA.**  Vale `2` exactamente en la línea. -/
theorem orbit_card_separates :
    (∀ ρ : ℂ, ρ.re = 1 / 2 → orbitCardOf ρ = 2) ∧
    (∃ ρ : ℂ, orbitCardOf ρ = 4) := by
  refine ⟨fun ρ h => by unfold orbitCardOf; rw [if_pos h], ⟨⟨1, 0⟩, ?_⟩⟩
  unfold orbitCardOf
  rw [if_neg (by norm_num)]

