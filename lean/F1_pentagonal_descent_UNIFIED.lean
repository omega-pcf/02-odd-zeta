/-! ## §123.1  E138 — lo que el cocono sí identifica -/

/-- **[C] LA PATA 6.**  El locus `{Re s = 1/2}` es el de
    `fix(s ↦ 1−s)`. -/
def LineIsLegSix (m : ℝ) : Prop := m = 1 / 2

/-- **[C] LA PATA 2.**  La posición espectral positiva es `μ₃`. -/
def SpectralPositionIsApex (p : ℝ) : Prop := p = 1 / 2

/-- **[P] LAS DOS PATAS IDENTIFICAN EL MISMO PUNTO.**  No coinciden
    numéricamente: convergen en el ápice, luego el locus de la línea
    Y la posición espectral positiva son el mismo punto.

    **El «dónde» está identificado.** -/
theorem line_and_spectral_position_are_one (m p : ℝ)
    (hm : LineIsLegSix m) (hp : SpectralPositionIsApex p) : m = p := by
  unfold LineIsLegSix at hm; unfold SpectralPositionIsApex at hp
  rw [hm, hp]

/-- **[P] PERO NO FUERZA A UN PUNTO ARBITRARIO.**  `3/4` cumple el
    bicondicional de la pata `6` ---devuelve «no» en los dos lados---
    y no es posición espectral.

    **Ése es el contraejemplo, y refuta sólo eso.** -/
theorem leg_does_not_force_position :
    ¬ ((3 : ℝ) / 4 = 1 - 3 / 4) ∧ ((3 : ℝ) / 4 ≠ 1 / 2) ∧
    ((3 : ℝ) / 4 ≠ -(1 / 4)) := by
  refine ⟨by norm_num, by norm_num, by norm_num⟩

/-! ## §123.2  E139 — dos coordenadas, no una objeción -/

/-- **[C] LA COORDENADA DEL MÓDULO.**  `|z_ρ|`, con familia
    `{φ^k : k ∈ ℤ}`; bajo `E` vale `1 = φ⁰`. -/
def ModulusCoordinate (r : ℝ) : Prop := r = 1

/-- **[C] LA COORDENADA ESPECTRAL.**  `Re ρ`, con índices `Fin 3`;
    bajo `E` vale `1/2`. -/
def SpectralCoordinate (x : ℝ) : Prop := x = 1 / 2

/-- **[P] BAJO `E`, EL MÓDULO ESTÁ EN LA FAMILIA CON EXPONENTE
    ENTERO.**  `1 = φ⁰`.

    **Esto es lo que la nota 7 no comprueba.** -/
theorem modulus_has_integer_exponent : (φ : ℝ) ^ (0 : ℤ) = 1 := by
  simp

/-- **[P] Y LAS DOS COORDENADAS SON DISTINTAS.**  `1 ≠ 1/2`: el
    módulo del cero y la norma del operador no son el mismo número,
    luego el exponente de uno no objeta al del otro. -/
theorem the_two_quantities_differ : (1 : ℝ) ≠ 1 / 2 := by norm_num

/-- **[P] PERO COINCIDEN EN VEREDICTO.**  Las dos condiciones se
    cumplen juntas o fallan juntas ---son la misma condición en dos
    coordenadas, por `liMap_on_unit_circle_iff`. -/
theorem same_verdict (r x : ℝ) (h : ModulusCoordinate r ↔ SpectralCoordinate x) :
    (r = 1 ↔ x = 1 / 2) := h

/-- **[O] NINGUNA ES OBJECIÓN A LA OTRA.**

    | | sobre qué | índices | bajo `E` |
    |---|---|---|---|
    | `\|z_ρ\| ∈ {φ^k}` | el MÓDULO | `ℤ` | `k = 0` |
    | `Re ρ ∈ specPos` | la ABSCISA | `Fin 3` | `k = 0` |

    Índices de mapas distintos.  Decir que uno es «más fino» compara
    coordenadas distintas ---**§117 lo hizo, y se retira esa parte**. -/
theorem neither_objects_to_the_other :
    ((φ : ℝ) ^ (0 : ℤ) = 1) ∧ ((1 : ℝ) ≠ 1 / 2) ∧
    (¬ ((3 : ℝ) / 4 = 1 - 3 / 4)) :=
  ⟨modulus_has_integer_exponent, the_two_quantities_differ,
   leg_does_not_force_position.1⟩

/-! ## §123.3  El balance -/

/-- **[O] EL BALANCE DE §123.**

    | | dije | corregido |
    |---|---|---|
    | E138 | «demostré lo contrario» | **el cocono identifica locus y posición espectral** |
    | E139 | «`0.5 ∉ {φ^k}`, luego la familia falla» | **`0.5` es `‖Ω̂₀‖`; `\|z_ρ\| = 1 = φ⁰`** |
    | §117 | `Fin 3` «más fino» que `{φ^k}` | **coordenadas distintas** |
    | nota 7 de §46 | citada como autoridad | **corregir en el corpus** |

    **Nada de esto prueba `E`.**  Retira dos objeciones cruzadas ---una
    mía de hoy, otra mía de una sesión anterior--- y conserva el
    contraejemplo, que refuta algo más estrecho de lo que yo dije. -/
theorem the_balance_of_section_123 (m p : ℝ)
    (hm : LineIsLegSix m) (hp : SpectralPositionIsApex p) :
    (m = p) ∧
    ((φ : ℝ) ^ (0 : ℤ) = 1) ∧
    ((1 : ℝ) ≠ 1 / 2) ∧
    ((3 : ℝ) / 4 ≠ 1 / 2) :=
