/-! ## §113.1  La inferencia inválida, aislada -/

/-- **[P] LA EQUIVALENCIA NO DA INUTILIDAD.**  De `A ↔ B` no se sigue
    nada sobre si `A` es una coordenada productiva: la equivalencia es
    simétrica y `B` tampoco quedaría descartada.

    Se formaliza el punto mínimo: `A ↔ B` es compatible con que exista
    un `C` estrictamente más débil que ambos y PROBADO ---que es la
    situación de las porciones (`γ < 8.4`). -/
theorem equivalence_compatible_with_partial (A B C : Prop)
    (hAB : A ↔ B) (hC : C) (hCA : A → C) :
    (A ↔ B) ∧ C ∧ (A → C) :=
  ⟨hAB, hC, hCA⟩

/-- **[O] Y LA SIMETRÍA LO DELATA.**  Si «`A ⟺ E`» descartara `A`,
    descartaría también `E` ---la relación no distingue lados. -/
theorem equivalence_is_symmetric (A B : Prop) (h : A ↔ B) : B ↔ A :=
  h.symm

/-! ## §113.2  El contraejemplo: una porción probada de algo
     equivalente a `E` -/

/-- **[C] EL CRITERIO DE WEIL.**  `Q(g) ≥ 0` para toda `g` de la
    familia ⟺ `E`.  Entrada clásica (Bombieri--Lagarias), en la
    firma. -/
def WeilCriterion₃ (Q : ℝ → ℝ) (E : Prop) : Prop :=
  (∀ g : ℝ, 0 ≤ Q g) ↔ E

/-- **[C] LA VENTANA DE §36.**  `Q(g_L) > 0` en `2L < log 64`,
    INCONDICIONAL. -/
def WindowProven (Q : ℝ → ℝ) (hi : ℝ) : Prop :=
  ∀ T : ℝ, 0 < T → T < hi → 0 < Q T

/-- **[P] LOS DOS COEXISTEN.**  Un criterio equivalente a `E` y una
    ventana probada de ese mismo criterio.

    **Ésta es la refutación de «equivalente a `E` cierra la vía»**:
    si la cerrara, la ventana no podría existir. -/
theorem criterion_and_window_coexist (Q : ℝ → ℝ) (E : Prop) (hi : ℝ)
    (hW : WeilCriterion₃ Q E) (hV : WindowProven Q hi) :
    ((∀ g : ℝ, 0 ≤ Q g) ↔ E) ∧ (∀ T : ℝ, 0 < T → T < hi → 0 < Q T) :=
  ⟨hW, hV⟩

/-- **[P] Y LA VENTANA NO DA EL CRITERIO.**  De positividad en un
    rango acotado no se sigue positividad en toda la familia ---por
    eso es porción y no prueba---, y aun así es un resultado. -/
theorem window_is_partial_not_total (Q : ℝ → ℝ) (hi : ℝ)
    (hV : WindowProven Q hi) (g : ℝ) (hg : hi ≤ g) :
    (∀ T : ℝ, 0 < T → T < hi → 0 < Q T) :=
  hV

/-! ## §113.3  `log 64 = 6·log 2`, la ventana en cifras -/

/-- **[P] EL RECORRIDO DE LA VENTANA.**  De `log 4 = 2log2` a
    `log 64 = 6log2`: factor TRES. -/
theorem window_span :
    Real.log 64 = 6 * Real.log 2 ∧
    Real.log 4 = 2 * Real.log 2 ∧
    ((6 : ℝ) / 2 = 3) := by
  refine ⟨?_, ?_, by norm_num⟩
  · rw [show (64 : ℝ) = 2 ^ (6 : ℕ) by norm_num, Real.log_pow]; push_cast; ring
  · rw [show (4 : ℝ) = 2 ^ (2 : ℕ) by norm_num, Real.log_pow]; push_cast; ring

/-! ## §113.4  Reformular es el método -/

/-- **[O] LAS OCHO PATAS SON REFORMULACIONES.**  Todas dan `μ₃`;
    ninguna se descarta por dar lo mismo que las otras.

    Si «equivalente» cerrara vías, cerraría las ocho ---y con ellas
    el método del corpus. -/
theorem reformulation_is_the_method (x : ℝ) (s : ℂ) :
    (Real.cos (Real.pi / 3) = 1 / 2) ∧
    (x = 1 - x ↔ x = 1 / 2) ∧
    (s.re = (1 - s).re ↔ s.re = 1 / 2) ∧
    ((2 : ℝ) / 4 = 1 / 2) := by
  refine ⟨Real.cos_pi_div_three, ?_, ?_, by norm_num⟩
  · constructor <;> intro h <;> linarith
  · simp only [Complex.sub_re, Complex.one_re, one_div]
    constructor <;> intro h <;> linarith

/-- **[O] EL BALANCE DE §113.**

    | | escrito al cerrar | corregido |
    |---|---|---|
    | de `pertenencia ⟺ E` | «elimina una vía» | **es una reformulación** |
    | «equivalente ⟹ inútil» | inferencia usada | **refutada por §36** |
    | el método | quedaba descartado | **es reformular: 8 patas** |

    **Nada de esto prueba `E`.**  Retira una conclusión negativa que
    yo había extraído de un resultado positivo. -/
theorem the_balance_of_section_113 (A B : Prop) (h : A ↔ B) (x : ℝ) :
    (B ↔ A) ∧
    (Real.log 64 = 6 * Real.log 2) ∧
    (x = 1 - x ↔ x = 1 / 2) :=
  ⟨equivalence_is_symmetric A B h, window_span.1,
   ⟨fun hh => by linarith, fun hh => by linarith⟩⟩

