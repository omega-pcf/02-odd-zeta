/-! ## §90.1  El cardinal salta -/

/-- El cardinal de la órbita de Klein, como función del módulo:
    `2` en el punto degenerado, `4` fuera. -/
def orbitCard (r : ℝ) : ℕ := if r = 1 then 2 else 4

/-- **[P] EL CARDINAL SALTA.**  En todo entorno de `1` hay puntos con
    cardinal `4`: la brecha `2` existe y no acota.

    Es §49 `discrete_invariant_has_no_gap`, reescrito para poder
    contrastarlo con `disc`. -/
theorem orbit_card_jumps (ε : ℝ) (hε : 0 < ε) :
    ∃ r : ℝ, r ≠ 1 ∧ |r - 1| < ε ∧ orbitCard r = 4 := by
  refine ⟨1 + ε / 2, by intro h; linarith [h], ?_, ?_⟩
  · rw [show (1 : ℝ) + ε / 2 - 1 = ε / 2 by ring, abs_of_pos (by linarith)]
    linarith
  · unfold orbitCard
    rw [if_neg (by intro h; linarith [h])]

/-! ## §90.2  El discriminante es continuo, y está acotado por la desviación -/

/-- **[P] `disc` ESTÁ CONTROLADO POR LA DESVIACIÓN.**
    `(r − 1/r)² ≤ 36 (r − 1)²` en `r ∈ [1/2, 2]`.

    **Un cardinal que salta no admite una cota así.**  Ésta es la
    diferencia entre los dos objetos, y es la que E99 borraba. -/
theorem disc_controlled_by_deviation (r : ℝ) (h1 : 1 / 2 ≤ r) (h2 : r ≤ 2) :
    (r - 1 / r) ^ 2 ≤ 36 * (r - 1) ^ 2 := by
  have hr : (0 : ℝ) < r := by linarith
  have hne : r ≠ 0 := ne_of_gt hr
  have key : r - 1 / r = (r - 1) * (r + 1) / r := by field_simp; ring
  have hb : (r + 1) ^ 2 ≤ 36 * r ^ 2 := by nlinarith
  have hm := mul_le_mul_of_nonneg_left hb (sq_nonneg (r - 1))
  rw [key, div_pow, div_le_iff₀ (by positivity)]
  nlinarith [hm]

/-- **[P] Y SE ANULA EN EL PUNTO DEGENERADO.**  Contraste directo con
    `orbitCard 1 = 2` mientras `orbitCard` vale `4` alrededor. -/
theorem disc_vanishes_at_one : ((1 : ℝ) - 1 / 1) ^ 2 = 0 := by norm_num

/-- **[P] LA DIFERENCIA, ENUNCIADA.**  El cardinal salta; el
    discriminante está acotado por la desviación y se anula en el
    límite.  Son objetos distintos, y la obstrucción de §49 es sobre
    el primero. -/
theorem jump_and_continuity_differ (ε : ℝ) (hε : 0 < ε) :
    (∃ r : ℝ, r ≠ 1 ∧ |r - 1| < ε ∧ orbitCard r = 4) ∧
    (∀ r : ℝ, 1 / 2 ≤ r → r ≤ 2 → (r - 1 / r) ^ 2 ≤ 36 * (r - 1) ^ 2) :=
  ⟨orbit_card_jumps ε hε, disc_controlled_by_deviation⟩

/-! ## §90.3  La brecha, en sus dos formas, es de la cadena -/

/-- **[P] LA BRECHA DE LA FORMA `disc` ES EL ELEMENTO `k=1`.**
    `(φ − φ⁻¹)² = 1`, y `φ − φ⁻¹ = 1` ES `φ² = φ + 1`. -/
theorem gap_one_is_the_k_one_element :
    ((φ : ℝ) - 1 / φ = 1) ∧ (((φ : ℝ) - 1 / φ) ^ 2 = 1) ∧
    ((φ : ℝ) ^ 2 = φ + 1) := by
  refine ⟨decoration_pair_gap_is_one, ?_, phi_sq⟩
  rw [decoration_pair_gap_is_one]; norm_num

/-- **[P] Y LA DE LA FORMA INVARIANTE ES EL ELEMENTO `k=2`.**
    `(φ² − φ⁻²)² = 5`.  Las dos brechas son elementos consecutivos de
    la misma cadena; ninguna es arbitraria. -/
theorem gap_five_is_the_k_two_element :
    (((φ : ℝ) ^ 2 - (1 / φ) ^ 2) ^ 2 = 5) ∧
    ((φ : ℝ) ^ 2 - (1 / φ) ^ 2 = ((φ : ℝ) - 1 / φ) * ((φ : ℝ) + 1 / φ)) := by
  refine ⟨chain_k_two.2.1, by ring⟩

/-! ## §90.4  El doblado excluye la rama `L²` -/

/-- **[P] EL ÍNDICE DEL INVARIANTE ES PAR.**  El invariante del par
    `{φ^k, φ^{−k}}` es `disc(2k)`, y `2k` es par para todo `k`. -/
theorem invariant_index_is_even (k : ℤ) : ∃ m : ℤ, 2 * k = 2 * m :=
  ⟨k, rfl⟩

/-- **[P] LUEGO SU VALOR ES DIVISIBLE POR `5`.**  Índice par ⟹ rama
    `5F²` ⟹ `5 ∣ valor`. -/
theorem invariant_divisible_by_five (k : ℕ) :
    5 ∣ 5 * (Nat.fib (2 * k)) ^ 2 :=
  ⟨(Nat.fib (2 * k)) ^ 2, rfl⟩

/-- **[P] Y LA RAMA `L²` QUEDA EXCLUIDA.**  Los tres primeros valores
    de la rama impar ---`L₁² = 1`, `L₃² = 16`, `L₅² = 121`--- NO son
    divisibles por `5`, luego no pueden ser valores del invariante.

    **Esto es lo que E99 llamó «reindexado vacío».**  No lo es: es la
    mitad de la cadena, y la mitad que lleva el `5`. -/
theorem odd_branch_is_excluded :
    ¬ (5 ∣ 1) ∧ ¬ (5 ∣ 16) ∧ ¬ (5 ∣ 121) := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[P] EL DOBLADO, COMPLETO.**  El índice es par, el valor es
    divisible por cinco, y la rama impar está excluida. -/
theorem doubling_kills_the_odd_branch (k : ℕ) :
    (∃ m : ℕ, 2 * k = 2 * m) ∧
    (5 ∣ 5 * (Nat.fib (2 * k)) ^ 2) ∧
    (¬ (5 ∣ 1) ∧ ¬ (5 ∣ 16) ∧ ¬ (5 ∣ 121)) :=
  ⟨⟨k, rfl⟩, invariant_divisible_by_five k, odd_branch_is_excluded⟩

/-! ## §90.5  El balance -/

/-- **[O] EL BALANCE DE §90.**

    | retracción | estado |
    |---|---|
    | E96 (Hecke da el entero en `\|órbita\|`) | se sostiene |
    | E98 (`e₁²−disc = 4e₂` es Hecke repetido) | se sostiene |
    | **E99 (la brecha no sirve)** | **RETIRADA** |

    Lo que E99 borraba y aquí vuelve: la brecha es continua sobre
