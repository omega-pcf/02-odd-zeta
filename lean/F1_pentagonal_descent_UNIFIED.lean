theorem window_is_inversion_symmetric (r : ℝ) (hr : 0 < r) :
    ((φ : ℝ)⁻¹ < r ∧ r < (φ : ℝ)) ↔ ((φ : ℝ)⁻¹ < r⁻¹ ∧ r⁻¹ < (φ : ℝ)) := by
  have hφ : (0:ℝ) < φ := φ_pos
  have h1 : (1:ℝ) < φ := one_lt_phi
  constructor
  · rintro ⟨hl, hu⟩
    constructor
    · rw [inv_lt_inv₀ hφ hr]
      exact hu
    · rw [inv_lt_comm₀ hr hφ]
      exact hl
  · rintro ⟨hl, hu⟩
    constructor
    · rw [inv_lt_comm₀ hr hφ] at hu
      exact hu
    · rw [inv_lt_inv₀ hφ hr] at hl
      exact hl

theorem monomial_iff_E (zeros : Set ℝ) (B : ℝ)
    (hB : DiscBound zeros B) (hpos : ∀ r ∈ zeros, 0 < r) :
    (∀ r ∈ zeros, ∃ k : ℤ, r = (φ : ℝ) ^ k) ↔ (∀ r ∈ zeros, r = 1) := by
  constructor
  · intro hm r hr
    obtain ⟨k, hk⟩ := hm r hr
    by_cases h0 : k = 0
    · rw [hk, h0, zpow_zero]
    · exfalso
      have hge : (1:ℝ) ≤ discP r := by
        rw [hk]; exact family_disc_ge_one_of_ne_zero k h0
      have := hB.2 r hr
      have := hB.1
      linarith
  · intro hE r hr
    exact ⟨0, by rw [hE r hr, zpow_zero]⟩

theorem three_faces_no_tension (zeros : Set ℝ) (B : ℝ)
    (hB : DiscBound zeros B) (hpos : ∀ r ∈ zeros, 0 < r) :
    ((∀ r ∈ zeros, ∃ k : ℤ, r = (φ : ℝ) ^ k) ↔ (∀ r ∈ zeros, r = 1)) ∧
    ((∀ r ∈ zeros, ∃ t : ℤ, (t : ℝ) = r + 1 / r) ↔ (∀ r ∈ zeros, r = 1)) :=
  ⟨monomial_iff_E zeros B hB hpos, trace_integral_iff_E zeros B hB hpos⟩

theorem the_decomposition_is_real (r : ℝ) (hr : 0 < r) (t : ℤ)
    (ht : (t : ℝ) = r + 1 / r) (B : ℝ) (hB1 : B < 1) (hBr : discP r ≤ B) :
    (2 : ℤ) ≤ t ∧ t ^ 2 < 5 ∧ t = 2 := by
  have ht2 : (2 : ℤ) ≤ t := by
    have := trace_ge_two r hr
    exact_mod_cast (ht ▸ this : (2:ℝ) ≤ (t:ℝ))
  have hdisc : discP r = (t : ℝ) ^ 2 - 4 := by unfold discP e1P; rw [← ht]
  have ht5 : t ^ 2 < 5 := by
    have : ((t ^ 2 : ℤ) : ℝ) < 5 := by push_cast; nlinarith [hdisc ▸ hBr, hB1]
    exact_mod_cast this
  exact ⟨ht2, ht5, by nlinarith [ht2, ht5]⟩

theorem monomial_iff_in_image (r : ℝ) :
    (∃ k : ℤ, r = (φ : ℝ) ^ k) ↔ r ∈ Set.range (fun n : ℤ => (φ : ℝ) ^ n) := by
