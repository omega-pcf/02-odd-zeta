namespace F1WeilFunctional

open F1Pendientes F1FrobeniusEigen ArithmeticFunction

/-! ## (A) El lado de los primos es la traza del Frobenius -/

/-- El coeficiente aritmético de p^k en la fórmula explícita. -/
noncomputable def primeCoeff (χ : ℕ → ℤ) (n : ℕ) : ℝ :=
  (vonMangoldt n : ℝ) * (χ n : ℝ)

/-- **[P*]** Sobre potencias de primo, Λ(p^k) = log p (k ≥ 1).
    ⚠ Nombres de Mathlib a verificar: `vonMangoldt_apply_pow`,
    `vonMangoldt_apply_prime`. -/
theorem vonMangoldt_prime_pow {p k : ℕ} (hp : p.Prime) (hk : k ≠ 0) :
    (vonMangoldt (p ^ k) : ℝ) = Real.log p := by
  rw [vonMangoldt_apply_pow hk, vonMangoldt_apply_prime hp]

/-- **[P*] ★★★★★ EL COEFICIENTE DE p^k ES log p POR LA TRAZA DEL FROBENIUS.**

    Si χ es completamente multiplicativo y χ(p) es el valor propio de ψ_p
    sobre √5, entonces el coeficiente de p^k es  log p · χ(p)^k, y χ(p)^k es
    el valor propio de ψ_p^k sobre √5 (`frobenius_power_eigenvalue`). -/
theorem prime_side_is_frobenius_trace
    (χ : ℕ → ℤ) (hmul : ∀ a b, χ (a * b) = χ a * χ b)
    {p k : ℕ} (hp : p.Prime) (hk : k ≠ 0) :
    primeCoeff χ (p ^ k) = Real.log p * ((χ p : ℝ) ^ k) := by
  unfold primeCoeff
  rw [vonMangoldt_prime_pow hp hk]
  have hpow : ∀ m : ℕ, χ (p ^ (m + 1)) = χ p ^ (m + 1) := by
    intro m
    induction m with
    | zero => simp
    | succ m ih => rw [pow_succ p (m + 1), hmul, ih, pow_succ (χ p) (m + 1)]
  obtain ⟨m, rfl⟩ : ∃ m, k = m + 1 := ⟨k - 1, by omega⟩
  rw [hpow m]; push_cast; ring

/-- **[P*]** Y ese valor propio vive en ℤ[φ]: para p primo con 5,
    ψ_p^k(√5) = χ₅(p)^k · √5.  (Reexportado para la firma final.) -/
theorem eigen_of_power (p k : ℕ) (hp : ((p : ℕ) : ZMod 5) ≠ 0) :
    (ψ p)^[k] sqrt5 = ((F1PCFUnified.chi5_Z (p : ZMod 5) : ℤ) : Zφ) ^ k * sqrt5 :=
  frobenius_power_eigenvalue p k hp

/-! ## (B) La dirección fácil de Weil, en forma finita -/

/-- **[P*] ★★★★ SI LAS ORDENADAS SON REALES, EL LADO DE LOS CEROS ES ≥ 0.**

    Con h = |F|², la suma sobre un conjunto finito de ordenadas REALES es no
    negativa.  Es la mitad trivial del criterio de Weil: GRH ⟹ positividad.
    La otra mitad (positividad ⟹ GRH) es el teorema de Weil. -/
theorem zero_side_nonneg_of_real_ordinates
    (F : ℝ → ℂ) (Γ : Finset ℝ) :
    0 ≤ ∑ γ ∈ Γ, Complex.normSq (F γ) :=
  Finset.sum_nonneg (fun γ _ => Complex.normSq_nonneg _)

/-! ## (C) La fórmula explícita, como hipótesis con nombre -/

/-- **[C] Fórmula explícita de Weil para L(s,χ₅)** (Weil 1952;
    Iwaniec–Kowalski 2004, Thm 5.12).  Se lleva como `Prop` con los datos
    abstractos: el lado de los ceros `Z g`, el término arquimediano `A g` y el
    lado de los primos `P g` como funcionales en las funciones de prueba. -/
def ExplicitFormulaChi5 (Z A P : (ℝ → ℝ) → ℝ) : Prop :=
  ∀ g : ℝ → ℝ, (∀ u, g (-u) = g u) → Z g = A g - 2 * P g

/-! ## (D) El núcleo, en forma de positividad -/

/-- **[O] El núcleo como positividad de Weil.**  Para toda f de prueba, el
    funcional sobre g = f ∗ f̃ es ≥ 0.  `conv` es la autocorrelación. -/
def WeilPositivityChi5 (Z : (ℝ → ℝ) → ℝ) (conv : (ℝ → ℝ) → (ℝ → ℝ)) : Prop :=
  ∀ f : ℝ → ℝ, 0 ≤ Z (conv f)

/-- **[P*] ★★★★ LA POSITIVIDAD, LEÍDA DESDE LOS PRIMOS.**

    Dada la fórmula explícita, la positividad de los ceros es la
    desigualdad  2·P(f∗f̃) ≤ A(f∗f̃): el lado de los primos —cuyos
    coeficientes son las trazas del Frobenius de ℤ[φ]— acotado por el
    arquimediano.  Ésta es la forma en que el núcleo queda escrito en
    términos de la estructura. -/
theorem positivity_is_a_prime_side_bound
    (Z A P : (ℝ → ℝ) → ℝ) (conv : (ℝ → ℝ) → (ℝ → ℝ))
    (heven : ∀ f u, conv f (-u) = conv f u)
    (hEF : ExplicitFormulaChi5 Z A P) :
    WeilPositivityChi5 Z conv ↔ ∀ f, 2 * P (conv f) ≤ A (conv f) := by
  constructor
  · intro h f
    have := h f
    rw [hEF (conv f) (heven f)] at this
    linarith
  · intro h f
    rw [hEF (conv f) (heven f)]
    linarith [h f]

end F1WeilFunctional

/-
  NOTAS
  ─────
  1. `ExplicitFormulaChi5` y `WeilPositivityChi5` son abstractos en Z, A, P:
     este archivo NO define la suma sobre ceros ni la integral arquimediana.
     Lo que fija es la FORMA del núcleo: una cota del lado de los primos por
     el arquimediano, con coeficientes = trazas de Frobenius (sección A).

  2. Sobre el "2" de |ker G|: L(s,χ₅) completada es entera, así que su
     fórmula explícita NO tiene términos de polos.  Los dos polos (s = 0, 1)
     aparecen en ζ, y por tanto en ζ_{ℚ(√5)} = ζ · L(s,χ₅), pero ese conteo
     (dos) vale para la ζ completada de CUALQUIER cuerpo de números.  En
     cambio |ker G| = |ℤ₂₀*| / |ℤ₂×ℤ₂| = 8/4 = 2 es específico del conductor
     20.  La coincidencia es numérica, no estructural: el "2" de ker G NO
     tiene un lugar preciso como contribución de polos.  Queda registrado.

  3. Nombres de Mathlib a verificar al compilar: `vonMangoldt_apply_pow`,
     `vonMangoldt_apply_prime`, `Complex.normSq_nonneg`.
-/

/-! ## (E) El lado de los primos, partido por el Frobenius -/

namespace F1WeilFunctional

/-- **[P*] ★★★★ P = P_split − P_inert.**

    Para un carácter con valores en {−1, 0, 1}, toda suma ponderada por χ se
    parte en los términos con χ = 1 (Frobenius = id, primos descompuestos) y
    con χ = −1 (Frobenius = σ, primos inertes).  Forma finita. -/
theorem prime_side_splits_by_frobenius (χ : ℕ → ℤ)
    (hχ : ∀ n, χ n = 1 ∨ χ n = -1 ∨ χ n = 0) (w : ℕ → ℝ) (N : ℕ) :
    ∑ n ∈ Finset.range N, (χ n : ℝ) * w n
      = ∑ n ∈ (Finset.range N).filter (fun n => χ n = 1), w n
        - ∑ n ∈ (Finset.range N).filter (fun n => χ n = -1), w n := by
  have key : ∀ n ∈ Finset.range N, (χ n : ℝ) * w n
      = (if χ n = 1 then w n else 0) - (if χ n = -1 then w n else 0) := by
    intro n _
    rcases hχ n with h | h | h <;> simp [h]
  rw [Finset.sum_congr rfl key, Finset.sum_sub_distrib,
      Finset.sum_filter, Finset.sum_filter]

end F1WeilFunctional

end Block07

