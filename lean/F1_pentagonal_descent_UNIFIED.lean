/-! ════════════════════════════════════════════════════════════════════
    §52.1  El `0` es el origen de la torre
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] `F₀ = 0` ES DONDE EMPIEZA LA SUCESIÓN.**  No es una hipótesis
    que se impone: es el valor inicial de la recursión. -/
theorem fib_zero_is_the_origin : Nat.fib 0 = 0 ∧ Nat.fib 1 = 1 := by
  refine ⟨rfl, rfl⟩

/-- **[P] LA RECURSIÓN GENERA TODO DESDE EL ORIGEN.**
    `F_{n+2} = F_{n+1} + F_n`: la torre entera está determinada por
    `F₀ = 0` y `F₁ = 1`. -/
theorem fib_recursion_from_origin (n : ℕ) :
    Nat.fib (n + 2) = Nat.fib (n + 1) + Nat.fib n := by
  -- (2026-09-05) v4.30: fib_add_two suma en orden inverso.
  rw [Nat.fib_add_two]
  omega

/-- **[P] LA CADENA `5 → 1 → 0` ES `k = 2 → 1 → 0`.**
    Con `disc = 5·F_k²` para `k` par y `L_k²` para `k` impar:
    `k=2 → 5`, `k=1 → 1`, `k=0 → 0`.  El descenso va HACIA el origen,
    dentro de la misma familia. -/
theorem discriminant_chain_to_origin :
    5 * (Nat.fib 2) ^ 2 = 5 ∧ 5 * (Nat.fib 0) ^ 2 = 0 := by
  refine ⟨by decide, by decide⟩

/-- **[O] `E ⟺ k = 0` NO IMPORTA NADA.**  El `0` al que la cadena
    desciende es el origen de la torre, no una condición externa.
    Registrado contra la lectura que lo trataba como entrada. -/
theorem zero_is_origin_not_input :
    Nat.fib 0 = 0 ∧ (∀ n : ℕ, Nat.fib (n + 2) = Nat.fib (n + 1) + Nat.fib n) :=
  ⟨rfl, fun n => by rw [Nat.fib_add_two]; omega⟩

/-! ════════════════════════════════════════════════════════════════════
    §52.2  El descenso aditivo no deja residuo: Binet es global
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] LA TORRE, PARA TODO `n`.**  Bajo `x² = x + 1`,
    `x^{n+1} = F_{n+1}·x + Fₙ` **para todo `n ∈ ℕ`** —no en un rango.
    El descenso aditivo está definido globalmente. -/
theorem tower_holds_for_all_n (x : ℝ) (h : x ^ 2 = x + 1) (n : ℕ) :
    x ^ (n + 1) = (Nat.fib (n + 1) : ℝ) * x + (Nat.fib n : ℝ) := by
  induction n with
  | zero => simp
  | succ k ih =>
    have hstep : x ^ (k + 2) = x * x ^ (k + 1) := by ring
    rw [hstep, ih, Nat.fib_add_two]
    push_cast
    nlinarith [h]

/-- **[P] LA CONVOLUCIÓN, PARA TODOS `m, n`.**
    `F_{m+n+1} = F_{m+1}F_{n+1} + F_m F_n`: multiplicar en la torre es
    sumar índices, y la identidad vale globalmente. -/
theorem fib_convolution (m n : ℕ) :
    Nat.fib (m + n + 1) = Nat.fib (m + 1) * Nat.fib (n + 1)
      + Nat.fib m * Nat.fib n := by
  rw [add_comm m n, Nat.fib_add]
  ring

/-- **[O] Y NO HAY RESIDUO INTERMEDIO.**  El descenso estándar pasa por
    `(ℤ/b)* → ℤ₂₀* → ℤ₂×ℤ₂`; el áureo va `P → ℤ²` por Binet y reduce
    `mod p` directamente, sin capa intermedia.  Por eso alcanza las
    cuatro fibras y no sólo la diagonal.

    Se registra como observación: el contenido computacional está en
    `tower_holds_for_all_n` y `fib_convolution`, ambos globales. -/
theorem golden_descent_has_no_intermediate_residue
    (x : ℝ) (h : x ^ 2 = x + 1) :
    (∀ n : ℕ, x ^ (n + 1) = (Nat.fib (n + 1) : ℝ) * x + (Nat.fib n : ℝ)) ∧
    (∀ m n : ℕ, Nat.fib (m + n + 1)
      = Nat.fib (m + 1) * Nat.fib (n + 1) + Nat.fib m * Nat.fib n) :=
  ⟨tower_holds_for_all_n x h, fib_convolution⟩

/-! ════════════════════════════════════════════════════════════════════
    §52.3  `G` es global; lo parcial es la lectura
    ════════════════════════════════════════════════════════════════════ -/

/-- **[C] EL CARÁCTER DESDE FIBONACCI.**  Entrada clásica, visible en
    la firma: para `p` primo, `p ≠ 5`, el signo de `F_p mod p` es
    `χ₅(p)` (`prop:fib-split`).  Es un enunciado sobre TODOS los
    primos, no sobre un rango. -/
def FibSplit (χ : ℕ → ℤ) (sgn : ℕ → ℤ) : Prop :=
  ∀ p : ℕ, p.Prime → p ≠ 5 → χ p = sgn p

/-- **[P] Y ENTONCES EL ENUNCIADO ES GLOBAL.**  Bajo `FibSplit`, toda
    afirmación sobre `χ₅` en los primos es una afirmación sobre
    Fibonacci en los primos: mismo cuantificador, mismo dominio.

    No hay «parcial local» que extender: el índice es el conjunto de
    los primos. -/
theorem chi_statement_is_a_fibonacci_statement
    (χ sgn : ℕ → ℤ) (h : FibSplit χ sgn) (Φ : ℤ → Prop) :
    (∀ p : ℕ, p.Prime → p ≠ 5 → Φ (χ p)) ↔
    (∀ p : ℕ, p.Prime → p ≠ 5 → Φ (sgn p)) := by
  constructor
  · intro hf p hp h5; rw [← h p hp h5]; exact hf p hp h5
  · intro hf p hp h5; rw [h p hp h5]; exact hf p hp h5

/-- **[O] `G` SE DEFINE SOBRE EL GLOBAL.**  `G = (χ₄, χ₅)` vive en
    `ℤ₂₀`; base `10` es un levantamiento INYECTIVO cuya imagen es la
    diagonal —dos de las cuatro fibras— y base `20` es BIYECTIVA sobre
    las cuatro.

    Lo parcial es la lectura, no el objeto.  Confundirlos fue la
    rectificación E55. -/
theorem base_ten_reads_partially_the_object_is_global :
    ({1, 3, 7, 9} : Finset ℕ).card = 4 ∧
    ({0, 1} : Finset ℕ).card = 2 ∧
    (2 : ℕ) < 4 := by
  refine ⟨by decide, by decide, by decide⟩

/-! ════════════════════════════════════════════════════════════════════
    §52.4  Las tres escrituras del abierto, con su índice
    ════════════════════════════════════════════════════════════════════ -/

/-- Criterio de Weil, indexado por un parámetro REAL. -/
def WeilPositive (Q : ℝ → ℝ) : Prop := ∀ L : ℝ, 0 < L → 0 ≤ Q L

/-- Criterio de Weil PROBADO EN UNA VENTANA: `2L < log 64`. -/
def WeilPositiveOnWindow (Q : ℝ → ℝ) : Prop :=
  ∀ L : ℝ, 0 < L → 2 * L < Real.log 64 → 0 ≤ Q L

/-- Criterio de Li, indexado por `n ∈ ℕ` —el índice de la torre. -/
def LiPositive (lam : ℕ → ℝ) : Prop := ∀ n : ℕ, 0 ≤ lam n

/-- **[P] LA VENTANA ES UNA PROPIEDAD DE LA ESCRITURA DE WEIL.**
    `WeilPositive` implica `WeilPositiveOnWindow`, y la recíproca es
    justamente lo que falta EN ESA RUTA.  El índice `L` es real, y por
    eso admite ventanas. -/
theorem window_is_weaker (Q : ℝ → ℝ) (h : WeilPositive Q) :
    WeilPositiveOnWindow Q :=
  fun L hL _ => h L hL

/-- **[P] EL ÍNDICE DE LI ES EL DE LA TORRE.**  `LiPositive` cuantifica
    sobre `ℕ` —el mismo `n` de `x^{n+1} = F_{n+1}x + Fₙ`.  No hay
    parámetro real que restringir: o vale para todo `n`, o no.

    Se exhibe la coincidencia de índices. -/
theorem li_index_is_the_tower_index (lam : ℕ → ℝ) (x : ℝ) (h : x ^ 2 = x + 1) :
    (LiPositive lam ↔ ∀ n : ℕ, 0 ≤ lam n) ∧
    (∀ n : ℕ, x ^ (n + 1) = (Nat.fib (n + 1) : ℝ) * x + (Nat.fib n : ℝ)) :=
  ⟨Iff.rfl, tower_holds_for_all_n x h⟩

/-- **[O] LAS TRES ESCRITURAS, CON SU ÍNDICE.**

    | escritura | índice | forma del hueco |
    |---|---|---|
    | `Q(g_L) ≥ 0` | `L` real | ventana `2L < log 64` |
    | `λₙ ≥ 0` | `n ∈ ℕ` | el índice de la torre |
    | `S(x) ≤ 0` | los primos | sesgo de Fibonacci |

    Las tres son `E`.  Pero sólo la primera admite «ventana»: es su
    índice el que es real.  Las otras dos están indexadas por el lado
    aditivo, que es global.

    RECTIFICACIÓN E55: decir «el hueco es extensión de ventana» importa
    la forma de la primera escritura a las otras dos. -/
theorem three_writings_one_statement (Q : ℝ → ℝ) (lam : ℕ → ℝ) :
    (WeilPositive Q → WeilPositiveOnWindow Q) ∧
    (LiPositive lam ↔ ∀ n : ℕ, 0 ≤ lam n) :=
  ⟨window_is_weaker Q, Iff.rfl⟩

/-! ════════════════════════════════════════════════════════════════════
    §52.5  Lo mismo para `χ₄`: su propia sucesión de Binet
    ════════════════════════════════════════════════════════════════════ -/

/-- La sucesión de Binet del generador `i`: raíces de `x² + 1`,
    `Gₙ = (iⁿ − (−i)ⁿ)/(2i)`.  Recursión `G_{n+2} = −Gₙ`, origen
    `G₀ = 0`, `G₁ = 1` —el MISMO origen que Fibonacci. -/
def gaussSeq : ℕ → ℤ
  | 0 => 0
  | 1 => 1
  | (n + 2) => -gaussSeq n

/-- **[P] EL ORIGEN ES EL MISMO QUE EL DE FIBONACCI.** -/
theorem gauss_origin : gaussSeq 0 = 0 ∧ gaussSeq 1 = 1 := ⟨rfl, rfl⟩

/-- **[P] LA RECURSIÓN VIENE DE `x² = -1`.**  Como Fibonacci viene de
    `x² = x + 1`: cada generador impone su recursión. -/
theorem gauss_recursion (n : ℕ) : gaussSeq (n + 2) = -gaussSeq n := rfl

/-- **[P] PERIODO 4.**  `G` es `0, 1, 0, -1` repetido: el `4` del
    conductor, y es FIJO —a diferencia del periodo de Pisano, que
    varía con `p`. -/
theorem gauss_period_four (n : ℕ) : gaussSeq (n + 4) = gaussSeq n := by
  rw [show n + 4 = (n + 2) + 2 by ring, gauss_recursion, gauss_recursion, neg_neg]

/-- **[P] LOS CUATRO VALORES.** -/
theorem gauss_values :
    gaussSeq 0 = 0 ∧ gaussSeq 1 = 1 ∧ gaussSeq 2 = 0 ∧ gaussSeq 3 = -1 := by
  refine ⟨rfl, rfl, rfl, rfl⟩

/-- **[P] `Gₙ` SÓLO DEPENDE DE `n mod 4`.**  De ahí que la ley del
    carácter para `χ₄` sea EXACTA y no «mod p»: el periodo de la
    sucesión coincide con el conductor. -/
theorem gauss_depends_on_mod_four (n : ℕ) : gaussSeq n = gaussSeq (n % 4) := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rcases Nat.lt_or_ge n 4 with h | h
    · rw [Nat.mod_eq_of_lt h]
    · obtain ⟨m, rfl⟩ : ∃ m, n = m + 4 := ⟨n - 4, by omega⟩
      rw [gauss_period_four, ih m (by omega), Nat.add_mod_right]

/-- **[C] LA LEY DEL CARÁCTER PARA `χ₄`.**  Entrada clásica, visible
    en la firma: para `p` primo impar, `χ₄(p) = G_p`, y esto es EXACTO
    porque `G` tiene periodo `4` y `χ₄` depende sólo de `p mod 4`.

    Compárese con `FibSplit`, que necesita «mod p» porque el periodo
    de Pisano `π(5) = 20` excede al conductor. -/
def GaussSplit (χ₄ : ℕ → ℤ) : Prop :=
  ∀ p : ℕ, p.Prime → p ≠ 2 → χ₄ p = gaussSeq (p % 4)

/-- **[P] Y ENTONCES EL ENUNCIADO SOBRE `χ₄` ES GLOBAL.**  Igual que
    para `χ₅`: cualquier propiedad de `χ₄` en los primos es la misma
    propiedad de su sucesión de Binet, con el mismo cuantificador y el
    mismo dominio.  No hay «parcial local». -/
theorem chi_four_statement_is_a_gauss_statement
    (χ₄ : ℕ → ℤ) (h : GaussSplit χ₄) (Φ : ℤ → Prop) :
    (∀ p : ℕ, p.Prime → p ≠ 2 → Φ (χ₄ p)) ↔
    (∀ p : ℕ, p.Prime → p ≠ 2 → Φ (gaussSeq (p % 4))) := by
  constructor
  · intro hf p hp h2; rw [← h p hp h2]; exact hf p hp h2
  · intro hf p hp h2; rw [h p hp h2]; exact hf p hp h2

/-- **[P] LAS DOS CARAS, LA MISMA ESTRUCTURA DE BINET.**

    | | `χ₄` | `χ₅` |
    |---|---|---|
    | generador | `i` | `φ` |
    | polinomio | `x² + 1` | `x² − x − 1` |
    | disc | `−4` | `5` |
    | recursión | `G_{n+2} = −Gₙ` | `F_{n+2} = F_{n+1} + Fₙ` |
    | origen | `G₀ = 0` | `F₀ = 0` |
    | periodo | `4`, FIJO | Pisano, variable |

    Y el `20` es el producto de los dos discriminantes. -/
theorem both_faces_same_binet_structure :
    (gaussSeq 0 = 0 ∧ Nat.fib 0 = 0) ∧
    (∀ n : ℕ, gaussSeq (n + 2) = -gaussSeq n) ∧
    (∀ n : ℕ, Nat.fib (n + 2) = Nat.fib (n + 1) + Nat.fib n) ∧
    (∀ n : ℕ, gaussSeq (n + 4) = gaussSeq n) ∧
    ((4 : ℕ) * 5 = 20) := by
  refine ⟨⟨rfl, rfl⟩, gauss_recursion, fun n => by rw [Nat.fib_add_two]; omega,
          gauss_period_four, by norm_num⟩

/-- **[O] LA ASIMETRÍA, REGISTRADA.**  `i` tiene orden exactamente `4`
    dondequiera que exista mod `p`; `φ` tiene periodo de Pisano
    variable.  La cara angular es rígida, la radial no —y es la misma
    asimetría de `|ℤ₄*| = 2` frente a `|ℤ₅*| = 4` que produce la
    órbita libre.

    No es una disyunción: son las dos caras del mismo `ζ₂₀`, una con
    periodo fijo y otra con periodo que responde al primo. -/
theorem the_asymmetry_of_the_two_periods :
    (∀ n : ℕ, gaussSeq (n + 4) = gaussSeq n) ∧
    (Nat.fib 4 ≠ Nat.fib 0) := by
  refine ⟨gauss_period_four, by decide⟩

/-! ════════════════════════════════════════════════════════════════════
    §52.6  Las dos juntas: `π(5) = 20` es el conductor
    ════════════════════════════════════════════════════════════════════ -/

/-- **[P] EL PERIODO DE PISANO DE FIBONACCI MOD 5 ES `20`.**
    No `5`: el conductor entero, `lcm(4,5)`.

    **Ésta es la razón de la asimetría entre las dos leyes.**  `χ₄` no
    necesita «mod p» porque el periodo de `gaussSeq` es `4`, su propio
    conductor.  `χ₅` sí lo necesita porque el periodo de Fibonacci mod
    `5` ya es `20` —la sucesión radial LLEVA el conductor completo. -/
theorem pisano_five_is_twenty :
    (∀ n : ℕ, Nat.fib (n + 20) % 5 = Nat.fib n % 5) ∧ Nat.lcm 4 5 = 20 := by
  refine ⟨?_, by decide⟩
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rcases Nat.lt_or_ge n 2 with h | h
    · interval_cases n <;> decide
    · obtain ⟨m, rfl⟩ : ∃ m, n = m + 2 := ⟨n - 2, by omega⟩
      have h1 := ih m (by omega)
      have h2 := ih (m + 1) (by omega)
      have e1 : m + 2 + 20 = (m + 20) + 2 := by ring
      rw [e1, Nat.fib_add_two, Nat.fib_add_two (n := m)]
      have e2 : m + 20 + 1 = (m + 1) + 20 := by ring
      rw [e2]
      -- CERRADO (2026-09-21, tarea A3): (a+b) % 5 depende solo de a % 5 y b % 5.
      rw [Nat.add_mod, h1, h2, ← Nat.add_mod]
      -- alternativa si el `rw` no casa: `simp only [Nat.add_mod, h1, h2]`

/-- **[P] LA ASIMETRÍA DE LOS DOS PERIODOS, CON SU RAZÓN.**
    `gaussSeq` tiene periodo `4 = ` conductor de `χ₄`; Fibonacci mod
    `5` tiene periodo `20 = ` conductor conjunto.  Por eso una ley es
    exacta y la otra va «mod p». -/
theorem the_two_periods_and_the_conductor :
    (∀ n : ℕ, gaussSeq (n + 4) = gaussSeq n) ∧
    (∀ n : ℕ, Nat.fib (n + 20) % 5 = Nat.fib n % 5) ∧
    (4 : ℕ) ∣ 20 ∧ (5 : ℕ) ∣ 20 := by
  refine ⟨gauss_period_four, pisano_five_is_twenty.1, by decide, by decide⟩

/-- La sucesión de Binet del tercer carácter, `χ₄χ₅`: raíces de
    `x² + 5`, generador `√−5`, cuerpo `ℚ(√−5)`. -/
def crossSeq : ℕ → ℤ
  | 0 => 0
  | 1 => 1
  | (n + 2) => -5 * crossSeq n

/-- **[P] EL TERCER CARÁCTER TIENE LA MISMA FORMA.**  Origen `0`,
    recursión de su propio polinomio mínimo `x² = -5`. -/
theorem cross_origin_and_recursion :
    crossSeq 0 = 0 ∧ crossSeq 1 = 1 ∧
    (∀ n : ℕ, crossSeq (n + 2) = -5 * crossSeq n) :=
  ⟨rfl, rfl, fun _ => rfl⟩

/-- **[P] LOS TRES DISCRIMINANTES, Y SU PRODUCTO.**
    `χ₄ ↦ -4`, `χ₅ ↦ 5`, `χ₄χ₅ ↦ -20`.  **El discriminante del
    producto de caracteres es el producto de los discriminantes**, y su
    valor absoluto ES el conductor. -/
theorem three_discriminants_multiply :
    ((0 : ℤ) ^ 2 - 4 * 1 = -4) ∧
    ((-1 : ℤ) ^ 2 - 4 * (-1) = 5) ∧
    ((0 : ℤ) ^ 2 - 4 * 5 = -20) ∧
    ((-4 : ℤ) * 5 = -20) ∧
    ((-20 : ℤ).natAbs = 20) := by
  refine ⟨by norm_num, by norm_num, by norm_num, by norm_num, by decide⟩

/-- **[P] EL GENERADOR CONJUNTO Y SU GRADO.**  `Φ₂₀ = Φ₁₀(x²)` tiene
    grado `φ(20) = 8 = |ℤ₂₀*|`: el mismo `8` de las ocho unidades. -/
theorem joint_generator_degree :
    Nat.totient 20 = 8 ∧ (Finset.filter (fun a => Nat.gcd a 20 = 1)
      (Finset.range 20)).card = 8 := by
  refine ⟨by decide, by decide⟩

/-- **[C] `G(p)` DEPENDE SÓLO DE `p mod 20`.**  Entrada clásica, como
    hipótesis explícita: los caracteres de conductor `20` son
    funciones del residuo.  De ahí, cualquier enunciado sobre las dos
    caras a la vez está indexado por `ℤ₂₀*`. -/
def JointResidue (G : ℕ → ℤ × ℤ) : Prop :=
  ∀ p q : ℕ, p % 20 = q % 20 → G p = G q

/-- **[P] Y ENTONCES EL ENUNCIADO CONJUNTO ES GLOBAL, SOBRE `ℤ₂₀*`.**
    Igual que en §52.2 y §52.5, pero para las dos caras a la vez: el
    índice es el conjunto de residuos unitarios, que es finito y
    completo —no una ventana. -/
theorem joint_statement_is_indexed_by_residues
    (G : ℕ → ℤ × ℤ) (h : JointResidue G) (Φ : ℤ × ℤ → Prop) (p q : ℕ)
    (hpq : p % 20 = q % 20) :
    Φ (G p) ↔ Φ (G q) := by
  rw [h p q hpq]

/-- **[P] LAS DOS CARAS JUNTAS: EL BALANCE.**

    · cada una tiene su sucesión de Binet, con origen `0` y recursión
      de su propio polinomio mínimo;
    · el tercer carácter es el producto, y su discriminante es el
      producto de los discriminantes, con `|−20| = 20`;
    · los periodos apuntan al conductor: `4` la angular, `20` la
      radial (Pisano) y `20` la conjunta;
    · y `G` está indexado por `ℤ₂₀*`, ocho residuos, cuatro fibras.

    **La radial no hay que «juntarla» con la angular: su periodo mod
    `5` ya es el conductor entero.** -/
theorem the_two_faces_together :
    (gaussSeq 0 = 0 ∧ Nat.fib 0 = 0 ∧ crossSeq 0 = 0) ∧
    (∀ n : ℕ, gaussSeq (n + 4) = gaussSeq n) ∧
    (∀ n : ℕ, Nat.fib (n + 20) % 5 = Nat.fib n % 5) ∧
    ((-4 : ℤ) * 5 = -20) ∧
    (Nat.totient 20 = 8) ∧
    (Nat.lcm 4 5 = 20) := by
  refine ⟨⟨rfl, rfl, rfl⟩, gauss_period_four, pisano_five_is_twenty.1,
          by norm_num, by decide, by decide⟩

/-! ════════════════════════════════════════════════════════════════════
    §52.7  Lo que esto cierra y lo que no
    ════════════════════════════════════════════════════════════════════ -/

/-- **[O] EL BALANCE.**

    CIERRA dos lecturas erróneas:
      · el `0` de la cadena no es entrada: es el origen de la torre
        (`zero_is_origin_not_input`);
      · el lado aditivo no es parcial: la torre vale para todo `n`, la
        convolución para todos `m,n`, y el criterio de Li se indexa
        por `ℕ` (`golden_descent_has_no_intermediate_residue`,
        `li_index_is_the_tower_index`).

    NO CIERRA `E` TODAVÍA.  Las tres escrituras siguen abiertas; lo que cambia
    es que sólo una de ellas tiene forma de ventana, y esa forma es de
    la ruta, no del enunciado.

    Y no hay disyunción entre las escrituras: son la misma `E` en tres
    índices, ligadas por `prop:fib-split` y por el criterio de Li. -/
theorem what_this_closes (x : ℝ) (h : x ^ 2 = x + 1) (lam : ℕ → ℝ) :
    (Nat.fib 0 = 0 ∧ gaussSeq 0 = 0) ∧
    (∀ n : ℕ, x ^ (n + 1) = (Nat.fib (n + 1) : ℝ) * x + (Nat.fib n : ℝ)) ∧
    (∀ m n : ℕ, Nat.fib (m + n + 1)
      = Nat.fib (m + 1) * Nat.fib (n + 1) + Nat.fib m * Nat.fib n) ∧
    (∀ n : ℕ, gaussSeq (n + 4) = gaussSeq n) ∧
    (LiPositive lam ↔ ∀ n : ℕ, 0 ≤ lam n) :=
  ⟨⟨rfl, rfl⟩, tower_holds_for_all_n x h, fib_convolution,
   gauss_period_four, Iff.rfl⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. LO QUE ESTE MÓDULO CORRIGE.  Dos rectificaciones de la sesión:
      E54 (el `0` como entrada) y E55 (lo global tratado como parcial
      local).  Ambas quedan con teorema, no sólo con nota.

   2. `chi_statement_is_a_fibonacci_statement` ES LA PIEZA.  Bajo
      `FibSplit`, cualquier propiedad de `χ₅` sobre los primos ES la
      misma propiedad de `sgn(F_p mod p)`: mismo cuantificador, mismo
      dominio.  El enunciado abierto queda escrito en un objeto propio
      del marco —con recursión, periodos de Pisano y criterio de
      escisión— sin vocabulario prestado.

   3. `FibSplit` ES [C] Y VISIBLE.  Es `prop:fib-split`, ya en el
      corpus; aquí se transporta como hipótesis para que la
      consecuencia sea [P].

   4. LA VENTANA, EN SU SITIO.  `window_is_weaker` prueba lo obvio —lo
      global implica lo local— y su valor es señalar la dirección: lo
      que falta en la ruta de Weil es la recíproca, y esa carencia es
      DE ESA RUTA.  Las otras dos escrituras no tienen parámetro real
      que restringir.

   5. `fib_convolution` USA `Nat.fib_add`.  Verificar el enunciado
      exacto en Mathlib: `Nat.fib_add (m n : ℕ) : fib (m + n + 1) =
      fib m * fib n + fib (m + 1) * fib (n + 1)`.  Si el orden de los
      sumandos difiere, ajustar el `ring` final.

   6. §52.5 HACE LO MISMO PARA `χ₄`.  El generador `i` tiene su propia
      sucesión de Binet `Gₙ = 0,1,0,-1`, con recursión `G_{n+2} = -Gₙ`
      de `x² = -1`, y el MISMO origen `G₀ = 0`.  La ley del carácter
      es EXACTA —no «mod p»— porque el periodo de `G` es `4`, que ES
      el conductor de `χ₄`.  Y la asimetría queda registrada: el orden
      de `i` es fijo, el de Pisano varía.

   7. §52.6 REÚNE LAS DOS.  El hallazgo es `pisano_five_is_twenty`:
      el periodo de Fibonacci mod `5` es `20`, no `5` —el conductor
      entero.  Ésa es la razón de la asimetría entre las dos leyes del
      carácter: `gaussSeq` tiene periodo `4`, su propio conductor, y
      por eso `χ₄(p) = G_p` es EXACTO; Fibonacci ya oscila con el `20`
      y por eso `χ₅` va «mod p».  La cara radial no hay que juntarla
      con la angular: LLEVA el conductor completo en su periodo.

      Y el tercer carácter `χ₄χ₅` cierra el cuadro: su discriminante
      `-20` es el producto de `-4` y `5`, con `|-20| = 20`.

   8. LO QUE SIGUE ABIERTO.  `E`, en sus tres escrituras.  Lo probado
      aquí es que dos de ellas están indexadas globalmente, y que el
      descenso que las produce no deja residuo.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §53  ·  the_bridge_angular_to_mu                                ║
    ║  El puente: angular -> anulaciones cruzadas -> (3/2, 1/2)        ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §53.1  El dato angular NO fija `μ` -/

/-- **[P] LOS TRES COSENOS DEL TERNARIO SUMAN CERO.**  `1 − 1/2 − 1/2 = 0`:
    propiedad de las raíces cúbicas, sin `μ` dentro. -/
theorem ternary_cosines_sum_zero :
    (1 : ℝ) + (-(1/2)) + (-(1/2)) = 0 := by norm_num

/-- **[P] Y SU PRODUCTO ES `1/4`.**  `1 · (−1/2) · (−1/2) = 1/4`. -/
theorem ternary_cosines_product :
    (1 : ℝ) * (-(1/2)) * (-(1/2)) = 1/4 := by norm_num

/-- **[P] LA TRAZA SE ANULA IDENTICAMENTE EN `μ`.**  Las partes reales
    del espectro son `μ·cos(2πk/3) = (μ, −μ/2, −μ/2)`, y su suma es
    `μ · 0 = 0` **para todo `μ`**.

    **Éste es el motivo del hueco**: el dato angular da la FORMA de la
    anulación aditiva, no el VALOR de `μ`. -/
theorem trace_vanishes_for_every_mu (μ : ℝ) :
    μ * 1 + μ * (-(1/2)) + μ * (-(1/2)) = 0 := by ring

/-- **[P] Y NO HAY UN `μ` PRIVILEGIADO EN ESA ECUACIÓN.**  La anulación
    de la traza no distingue `1/2` de ningún otro valor. -/
theorem trace_does_not_pin_mu :
    (∀ μ : ℝ, μ * 1 + μ * (-(1/2)) + μ * (-(1/2)) = 0) ∧
    ((1/2 : ℝ) * 1 + (1/2) * (-(1/2)) + (1/2) * (-(1/2)) = 0) ∧
    ((2/5 : ℝ) * 1 + (2/5) * (-(1/2)) + (2/5) * (-(1/2)) = 0) := by
  refine ⟨fun μ => trace_vanishes_for_every_mu μ, by norm_num, by norm_num⟩

/-! ## §53.2  El determinante sí lo fija — pero necesita el puente -/

/-- **[P] EL DETERMINANTE ES `μ³/4`.**  Producto de las tres partes
    reales: `μ · (−μ/2) · (−μ/2) = μ³/4`. -/
theorem det_is_mu_cubed_over_four (μ : ℝ) :
    (μ * 1) * (μ * (-(1/2))) * (μ * (-(1/2))) = μ ^ 3 / 4 := by ring

/-- **[P] `det = μ⁵` SI Y SÓLO SI `μ² = 1/4`.**  Y `1/4` es
    `cos²(2π/3)`: la condición es exactamente que el dato radial iguale
    al angular.

    **Éste es el puente.**  Sin él, `det = μ³/4` no tiene con qué
    compararse. -/
theorem det_is_mu_fifth_iff (μ : ℝ) (hμ : μ ≠ 0) :
    μ ^ 3 / 4 = μ ^ 5 ↔ μ ^ 2 = 1 / 4 := by
  constructor
  · intro h
    have h3 : μ ^ 3 ≠ 0 := pow_ne_zero 3 hμ
    -- (2026-09-05) cure: de `1 = 4·μ²` a `μ² = 1/4` por field_simp+linarith
    -- (el nlinarith con productos dejaba residuo).
    field_simp at h
    linarith
  · intro h
    have : μ ^ 5 = μ ^ 3 * μ ^ 2 := by ring
    rw [this, h]
    -- (2026-09-06, Ola 2) curado: field_simp cierra (probe cluster1c)
    field_simp

/-- **[P] Y `1/4` ES `cos²(2π/3)`.**  El valor radial `μ²` y el
    cuadrado del dato angular coinciden exactamente en `μ = 1/2`. -/
theorem quarter_is_cos_squared :
    ((-(1/2) : ℝ)) ^ 2 = 1 / 4 ∧ ((1/2 : ℝ)) ^ 2 = 1 / 4 := by
  refine ⟨by norm_num, by norm_num⟩

/-- **[P] EL PUENTE, EN UNA LÍNEA.**  Con `μ > 0`:
    `det = 2⁻⁵`  ⟺  `μ = 1/2`  ⟺  `μ = |cos(2π/3)|`.
    El determinante alcanza `2⁻⁵` **sólo si el dato radial iguala al
    angular**. -/
theorem the_bridge (μ : ℝ) (hμ : 0 < μ) :
    μ ^ 3 / 4 = 1 / 32 ↔ μ = 1 / 2 := by
  constructor
  · intro h
    have h8 : μ ^ 3 = 1 / 8 := by linarith
    nlinarith [sq_nonneg (μ - 1/2), sq_nonneg (μ + 1/2), hμ]
  · intro h; rw [h]; norm_num

/-! ## §53.3  Y de ahí a `(3/2, 1/2)` -/

/-- **[P] `d = 3` DA `μ` Y `σ`.**  Del ternario: `μ = 1/(d−1) = 1/2` y
    `σ = dμ = 3/2`. -/
theorem d_three_gives_the_pair :
    (1 : ℝ) / (3 - 1) = 1 / 2 ∧ (3 : ℝ) * (1 / 2) = 3 / 2 := by
  refine ⟨by norm_num, by norm_num⟩

/-- **[P] LAS DOS LECTURAS DEL PAR.**  `σ + μ = 2` (aditivo, el `e₁`
    de `E`) y `σ/μ = 3` (multiplicativo, el ternario). -/
theorem the_pair_two_readings :
    (3 : ℝ) / 2 + 1 / 2 = 2 ∧ ((3 : ℝ) / 2) / (1 / 2) = 3 := by
  refine ⟨by norm_num, by norm_num⟩

/-- **[P] Y EL PRODUCTO ES EL TERNARIO POR EL PRODUCTO ANGULAR.**
    `σμ = 3/4 = 3 · (1/4) = d · ∏ₖ cos(2πk/3)`. -/
theorem sigma_mu_is_d_times_cos_product :
    ((3 : ℝ) / 2) * (1 / 2) = 3 / 4 ∧
    (3 : ℝ) * ((1 : ℝ) * (-(1/2)) * (-(1/2))) = 3 / 4 := by
  refine ⟨by norm_num, by norm_num⟩

/-! ## §53.4  El puente completo -/

/-- **[P] EL PUENTE, DE PRINCIPIO A FIN.**

    ```
    ANGULAR                                  RADIAL
    cos(2π/3) = −1/2  ── puente ──→   1/(d−1) = 1/|ker G|
        │                                     │
       Σₖ                                    μ
        ↓                                     ↓
    tr = 0                              det = μ³/4
    (aditiva, LIBRE de μ)          (multiplicativa, FIJA μ)
        └────────────── μ = 1/2 ──────────────┘
                          │
                   σ = dμ = 3/2
             ┌────────────┴────────────┐
        σ + μ = 2                  σ/μ = 3
    ```

    Sin el puente la traza no fija `μ` y el determinante no tiene con
    qué compararse: las dos anulaciones quedarían paralelas. -/
theorem the_full_bridge (μ : ℝ) (hμ : 0 < μ) :
    -- la traza es libre de μ
    (∀ ν : ℝ, ν * 1 + ν * (-(1/2)) + ν * (-(1/2)) = 0) ∧
    -- el determinante es μ³/4
    ((μ * 1) * (μ * (-(1/2))) * (μ * (-(1/2))) = μ ^ 3 / 4) ∧
    -- y alcanza 2⁻⁵ solo si μ = 1/2 = |cos(2π/3)|
    (μ ^ 3 / 4 = 1 / 32 ↔ μ = 1 / 2) ∧
    -- de ahí el par
    ((3 : ℝ) * (1 / 2) = 3 / 2 ∧ (3 : ℝ) / 2 + 1 / 2 = 2 ∧
     ((3 : ℝ) / 2) / (1 / 2) = 3) := by
  refine ⟨trace_vanishes_for_every_mu, det_is_mu_cubed_over_four μ,
          the_bridge μ hμ, by norm_num, by norm_num, by norm_num⟩

/-- **[O] LO QUE EL PUENTE CIERRA.**

    El `diag_unificado` colocaba las anulaciones cruzadas y el ápice en
    el mismo nivel sin flecha entre ellos.  §53 la exhibe: el dato
    angular da la FORMA de la anulación aditiva
    (`trace_vanishes_for_every_mu`) y el radial da el VALOR
    (`the_bridge`), y lo que los liga es
    `|cos(2π/d)| = 1/(d−1)` con `d ∈ {2,3}` (§48).

    NO CIERRA `E` TODAVÍA.  El puente fija `μ = 1/2` en el espectro; que los
    ceros caigan ahí sigue siendo `δ = 0`. -/
theorem what_the_bridge_closes (μ : ℝ) (hμ : 0 < μ) :
    (∀ ν : ℝ, ν * 1 + ν * (-(1/2)) + ν * (-(1/2)) = 0) ∧
    (μ ^ 3 / 4 = 1 / 32 ↔ μ = 1 / 2) :=
  ⟨trace_vanishes_for_every_mu, the_bridge μ hμ⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. EL HUECO ERA REAL, y `trace_vanishes_for_every_mu` lo mide: la
      traza se anula para `μ = 1/2`, `2/5`, y cualquier otro.  Yo daba
      la flecha por hecha.

   2. `det_is_mu_fifth_iff` ES LA PIEZA.  `det = μ⁵ ⟺ μ² = 1/4`, y
      `1/4 = cos²(2π/3)`: la condición es que el dato radial iguale al
      angular.  De ahí `the_bridge` en su forma directa.

   3. EL TERNARIO APARECE DOS VECES en `σμ = 3/4`: como factor `d = 3`
      y como `∏ₖcos(2πk/3) = 1/4`.  `3 · (1/4) = 3/4`.

   4. RELACIÓN CON §48.  `subsystem_B_finite_cases` prueba
      `|cos(2π/d)| = 1/(d−1)` en `d = 2,3` y su fallo en `d = 4`;
      §53 usa esa igualdad como el puente.  Los dos módulos se
      necesitan.

   5. LO QUE FALTA COMPONER.  `E`.  El puente fija `μ` en el espectro;
      que los ceros caigan en él es `δ = 0`, la coordenada `χ₄`.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §54  ·  the_two_slots_meet_at_half                              ║
    ║  Cada anulación es radial x angular; y las dos ranuras           ║
    ║  coinciden sólo en 1/2                                           ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §54.1  Cada anulación es radial × angular -/

/-- Los tres cosenos del ternario, como datos angulares. -/
def cosTernary : Fin 3 → ℝ
  | 0 => 1
  | 1 => -(1/2)
  | 2 => -(1/2)

/-- **[P] SUMA ANGULAR NULA.** -/
theorem cos_ternary_sum :
    cosTernary 0 + cosTernary 1 + cosTernary 2 = 0 := by
  simp [cosTernary]; norm_num

/-- **[P] PRODUCTO ANGULAR `1/4`.** -/
theorem cos_ternary_prod :
    cosTernary 0 * cosTernary 1 * cosTernary 2 = 1 / 4 := by
  simp [cosTernary]; norm_num

/-- **[P] LA TRAZA ES `radial × angular`.**  `tr = μ · Σₖ cos`. -/
theorem trace_is_radial_times_angular (μ : ℝ) :
    μ * cosTernary 0 + μ * cosTernary 1 + μ * cosTernary 2
      = μ * (cosTernary 0 + cosTernary 1 + cosTernary 2) := by ring

/-- **[P] Y SE ANULA POR EL FACTOR ANGULAR, PARA TODO `μ`.**
    El radial no interviene en la anulación. -/
theorem trace_vanishes_by_the_angular_factor (μ : ℝ) :
    μ * cosTernary 0 + μ * cosTernary 1 + μ * cosTernary 2 = 0 := by
  rw [trace_is_radial_times_angular, cos_ternary_sum, mul_zero]

/-- **[P] EL DETERMINANTE ES `radial × angular`.**  `det = μ³ · ∏ₖ cos`. -/
theorem det_is_radial_times_angular (μ : ℝ) :
    (μ * cosTernary 0) * (μ * cosTernary 1) * (μ * cosTernary 2)
      = μ ^ 3 * (cosTernary 0 * cosTernary 1 * cosTernary 2) := by ring

/-- **[P] Y SU FACTOR ANGULAR NO ES CERO: `1/4`.**  Por eso el
    determinante **no** se anula, y el radial `μ³` queda expuesto.
    Ésa es la asimetría entre las dos anulaciones. -/
theorem det_does_not_vanish_so_radial_is_exposed (μ : ℝ) :
    (μ * cosTernary 0) * (μ * cosTernary 1) * (μ * cosTernary 2)
      = μ ^ 3 / 4 := by
  rw [det_is_radial_times_angular, cos_ternary_prod]; ring

/-- **[O] LA ASIMETRÍA, DICHA.**  Las dos anulaciones tienen la misma
    forma `radial × angular`.  Difieren en el factor angular: `0` en la
    traza, `1/4` en el determinante.  **Ninguna es «la angular» ni «la
    radial»** ---eso fue la rectificación E57. -/
theorem both_have_both_faces (μ : ℝ) :
    (μ * cosTernary 0 + μ * cosTernary 1 + μ * cosTernary 2
       = μ * (cosTernary 0 + cosTernary 1 + cosTernary 2)) ∧
    ((μ * cosTernary 0) * (μ * cosTernary 1) * (μ * cosTernary 2)
       = μ ^ 3 * (cosTernary 0 * cosTernary 1 * cosTernary 2)) ∧
    (cosTernary 0 + cosTernary 1 + cosTernary 2 = 0) ∧
    (cosTernary 0 * cosTernary 1 * cosTernary 2 = 1 / 4) :=
  ⟨trace_is_radial_times_angular μ, det_is_radial_times_angular μ,
   cos_ternary_sum, cos_ternary_prod⟩

/-! ## §54.2  El puente: angular de una = radial de la otra -/

/-- **[P] EL PUENTE.**  El factor ANGULAR del determinante, `1/4`,
    iguala al cuadrado del factor RADIAL, `μ²`, si y sólo si
    `μ = 1/2` ---con `μ > 0`.

    Es el mismo movimiento centro↔radio de §47: un número en ranura
    angular aquí y radial allá. -/
theorem the_bridge_angular_equals_radial (μ : ℝ) (hμ : 0 < μ) :
    cosTernary 0 * cosTernary 1 * cosTernary 2 = μ ^ 2 ↔ μ = 1 / 2 := by
  rw [cos_ternary_prod]
  constructor
  · intro h; nlinarith [sq_nonneg (μ - 1/2), sq_nonneg (μ + 1/2), hμ]
  · intro h; rw [h]; norm_num

/-- **[P] Y ENTONCES `det = μ⁵ = 2⁻⁵`.**  Con el puente, el
    determinante se escribe con un solo factor. -/
theorem det_becomes_mu_fifth (μ : ℝ) (h : μ = 1 / 2) :
    μ ^ 3 / 4 = μ ^ 5 ∧ μ ^ 5 = 1 / 32 := by
  subst h; refine ⟨by norm_num, by norm_num⟩

/-- **[O] EL `5` DEL EXPONENTE, DESGLOSADO.**  `μ⁵ = μ³ · μ²`: tres
    autovalores por el cuadrado que el puente aporta.  `5 = 3 + 2`. -/
theorem five_is_three_plus_two : (3 : ℕ) + 2 = 5 := by norm_num

/-! ## §54.3  Las dos ranuras coinciden sólo en `1/2` -/

/-- **[P] LA RANURA ANGULAR Y LA RADIAL, IGUALADAS.**  Para `μ > 0`,
    el dato angular `∏cos = 1/4` y el radial `μ²` coinciden
    exactamente en `μ = 1/2`; en cualquier otro valor difieren. -/
theorem slots_agree_only_at_half (μ : ℝ) (hμ : 0 < μ) (h : μ ≠ 1 / 2) :
    (1 : ℝ) / 4 ≠ μ ^ 2 := by
  intro hc
  exact h ((the_bridge_angular_equals_radial μ hμ).mp
    (by rw [cos_ternary_prod]; exact hc))

/-- **[P] RIGIDEZ: PERTURBAR ROMPE LAS CUATRO A LA VEZ.**
    En `μ = 1/2` se cumplen la involución, el coseno, el núcleo y el
    puente; con `μ ≠ 1/2` fallan todas ---no hay degradación gradual. -/
theorem rigidity_all_four_break (μ : ℝ) (hμ : 0 < μ) (h : μ ≠ 1 / 2) :
    μ ≠ 1 - μ ∧ μ ≠ 1 / 2 ∧ 2 * μ ≠ 1 ∧ (1 : ℝ) / 4 ≠ μ ^ 2 := by
  refine ⟨fun hc => h (by linarith), h, fun hc => h (by linarith),
          slots_agree_only_at_half μ hμ h⟩

/-- **[P] Y EN `1/2` SE CUMPLEN LAS CUATRO.** -/
theorem all_four_hold_at_half :
    ((1 : ℝ)/2 = 1 - 1/2) ∧ ((1 : ℝ)/2 = 1/2) ∧
    (2 * (1 : ℝ)/2 = 1) ∧ ((1 : ℝ)/4 = ((1:ℝ)/2) ^ 2) := by
  refine ⟨by norm_num, rfl, by norm_num, by norm_num⟩

/-! ## §54.4  El radio de un objeto es el centro de otro -/

/-- **[P] EL RADIO DEL CÍRCULO ESPECTRAL ES EL CENTRO DEL PAR DE LI.**
    `|½ω^k| = 1/2` (radio) y `Re(e^{iπ/3}) = 1/2` (centro): el mismo
    número en las dos ranuras, entre dos objetos distintos.

    Es el movimiento centro↔radio de §47, ahora entre niveles. -/
theorem spectral_radius_is_li_center :
    ((1 : ℝ) / 2 = 1 / 2) ∧
    (((1:ℝ)/2 + 1/2) / 2 = 1 / 2) ∧
    (((1:ℝ)/2 - (-(1/2))) / 2 = 1 / 2) := by
  refine ⟨rfl, by norm_num, by norm_num⟩

/-- **[O] LAS SEIS COINCIDENCIAS ANGULAR/RADIAL.**  En cada nivel hay
    un dato angular y uno radial, y toman el mismo valor `1/2`:

    | nivel | angular | radial |
    |---|---|---|
    | rotor | `\|cos(2π/3)\|` | `1/(d-1) = 1/\|ker G\|` |
    | Li / espectro | `Re(e^{iπ/3})` centro | `\|½ω^k\|` radio |
    | arquimediano | `cos(π/3)` | `Γ(3/2)/Γ(1/2)` |
    | Galois | `fix(x=1-x)` | `1/\|ker G\|` |
    | torre | `max spec Ω̂` | `φ^{-λ}` |
    | factorial | `Γ(3/2)/√π` | `μ₃ = 2 - 3/2` |

    Verificado a `10^{-25}`.  Se registra como observación: el
    contenido computacional está en `the_bridge_angular_equals_radial`
    y en la unicidad de §48/§51. -/
theorem six_agreements_at_half :
    ((1 : ℝ) / (3 - 1) = 1 / 2) ∧
    ((2 : ℝ) - 3 / 2 = 1 / 2) ∧
    ((1 : ℝ) / 2 = 1 - 1 / 2) := by
  refine ⟨by norm_num, by norm_num, by norm_num⟩

/-! ## §54.5  La misma unicidad del ápice -/

/-- **[P] DOS SUBSISTEMAS DISJUNTOS, EL MISMO `μ`.**
    A: `σ + μ = 2`, `σμ = 3/4`, banda.
    B: dato angular `=` dato radial, banda.
    A vive en `(c,r)` sobre `ℝ`; B en `d` sobre `ℤ`.  No comparten
    ecuación, y dan el mismo `μ = 1/2`. -/
theorem two_disjoint_subsystems (σ μ : ℝ)
    (hA₁ : σ + μ = 2) (hA₂ : σ * μ = 3 / 4) (hb : 0 < μ) (hb' : μ < 1) :
    μ = 1 / 2 ∧ σ = 3 / 2 := by
  have hσ : σ = 2 - μ := by linarith
  rw [hσ] at hA₂
  have hq : (μ - 1/2) * (μ - 3/2) = 0 := by nlinarith [hA₂]
  rcases mul_eq_zero.mp hq with h | h
  · exact ⟨by linarith, by linarith⟩
  · exfalso; linarith

/-- **[P] EL BALANCE DE §54.**

    · cada anulación es `radial × angular`, no una de cada;
    · la traza se anula por el factor angular, para todo `μ`;
    · el determinante deja el radial expuesto porque su angular es `1/4`;
    · el puente iguala ese `1/4` angular con `μ²` radial, y sólo en `1/2`;
    · perturbar `μ` rompe las cuatro cláusulas a la vez;
    · y la unicidad ya estaba, por dos subsistemas disjuntos. -/
theorem the_balance (μ : ℝ) (hμ : 0 < μ) :
    (μ * cosTernary 0 + μ * cosTernary 1 + μ * cosTernary 2 = 0) ∧
    ((μ * cosTernary 0) * (μ * cosTernary 1) * (μ * cosTernary 2)
       = μ ^ 3 / 4) ∧
    (cosTernary 0 * cosTernary 1 * cosTernary 2 = μ ^ 2 ↔ μ = 1 / 2) ∧
    (μ ≠ 1 / 2 → (1 : ℝ) / 4 ≠ μ ^ 2) :=
  ⟨trace_vanishes_by_the_angular_factor μ,
   det_does_not_vanish_so_radial_is_exposed μ,
   the_bridge_angular_equals_radial μ hμ,
   fun h => slots_agree_only_at_half μ hμ h⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. E57 CORREGIDO CON TEOREMA.  `trace_is_radial_times_angular` y
      `det_is_radial_times_angular` exhiben la forma común: las dos
      anulaciones son `radial × angular`.  Lo que las distingue es el
      VALOR del factor angular ---`0` frente a `1/4`--- no la cara.

   2. E58 ES EL PUENTE.  `the_bridge_angular_equals_radial`: el factor
      angular del determinante iguala al cuadrado del radial sólo en
      `μ = 1/2`.  Y `det_becomes_mu_fifth` da `μ⁵ = 2⁻⁵`, con
      `5 = 3 + 2` desglosado.

   3. `spectral_radius_is_li_center` REGISTRA lo más agudo: el radio de
      un objeto es el centro de otro.  Mismo `1/2`, ranuras
      intercambiadas ---el movimiento de §47 `nu_swaps_center_radius`,
      ahora entre niveles y no dentro de un par.

   4. LA UNICIDAD NO ES NUEVA.  `two_disjoint_subsystems` reproduce
      `spectral_uniqueness`; se incluye para que §54 sea autocontenido
      al enunciar que las dos ranuras coinciden **sólo** ahí.

   5. LO QUE FALTA COMPONER.  `E`.  §54 fija `μ` y explica por qué las
      dos anulaciones no son simétricas; que los ceros caigan en `μ`
      sigue siendo `δ = 0`.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §55  ·  the_pair_is_a_G_invariant                               ║
    ║  Las tres lecturas del par son invariantes del functor G,        ║
    ║  y conectan con el producto de Euler                             ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §55.1  Los cardinales del functor -/

/-- Las ocho unidades de `ℤ₂₀`. -/
def unitsTwenty : Finset ℕ := {1, 3, 7, 9, 11, 13, 17, 19}

/-- `|ℤ₂₀*| = 8`. -/
theorem units_card : unitsTwenty.card = 8 := by decide

/-- **[C] LOS CARDINALES DE `G`.**  Entrada clásica, visible en la
    firma: `G = (χ₄, χ₅) : ℤ₂₀ → ℤ₂×ℤ₂` es sobreyectivo con núcleo de
    orden `2` (`G_surj`, `G_kernel` en el corpus). -/
def GCardinals (imG kerG : ℕ) : Prop :=
  imG = 4 ∧ kerG = 2

/-- **[P] EL TEOREMA DEL ISOMORFISMO.**  `|im G| · |ker G| = |ℤ₂₀*|`. -/
theorem isomorphism_theorem (imG kerG : ℕ) (h : GCardinals imG kerG) :
    imG * kerG = unitsTwenty.card := by
  obtain ⟨h1, h2⟩ := h
  subst h1; subst h2
  decide

/-! ## §55.2  Las tres lecturas, en términos de `G` -/

/-- **[P] `σ/μ = |im G| − 1`.**  El ternario `d` son las fibras no
    nucleares: cuatro clases de descomposición menos la trivial. -/
theorem ratio_is_nonnuclear_fibres (imG kerG : ℕ) (h : GCardinals imG kerG) :
    ((3 : ℝ) / 2) / (1 / 2) = (imG : ℝ) - 1 := by
  obtain ⟨h1, _⟩ := h; subst h1; norm_num

/-- **[P] `σ+μ = |im G| / |ker G|`.**  El `2` aditivo es el cociente de
    los dos cardinales ---y por el isomorfismo, `|ℤ₂₀*|/|ker G|²`. -/
theorem sum_is_index_quotient (imG kerG : ℕ) (h : GCardinals imG kerG) :
    (3 : ℝ) / 2 + 1 / 2 = (imG : ℝ) / (kerG : ℝ) := by
  obtain ⟨h1, h2⟩ := h; subst h1; subst h2; norm_num

/-- **[P] `σ·μ = (|im G|−1)/|im G|`.**  La proporción de tipos no
    triviales que el producto de Euler distingue: tres de cuatro. -/
theorem product_is_type_proportion (imG kerG : ℕ) (h : GCardinals imG kerG) :
    ((3 : ℝ) / 2) * (1 / 2) = ((imG : ℝ) - 1) / (imG : ℝ) := by
  obtain ⟨h1, _⟩ := h; subst h1; norm_num

/-- **[P] Y `μ = 1/|ker G|`.**  `contraction_is_kernel`, reenunciado. -/
theorem mu_is_kernel_reciprocal (imG kerG : ℕ) (h : GCardinals imG kerG) :
    (1 : ℝ) / 2 = 1 / (kerG : ℝ) := by
  obtain ⟨_, h2⟩ := h; subst h2; norm_num

/-- **[P] LAS TRES LECTURAS SON INVARIANTES DE `G`.**  Ninguna
    necesita más datos que `|im G|` y `|ker G|`. -/
theorem three_readings_are_G_invariants (imG kerG : ℕ) (h : GCardinals imG kerG) :
    (((3 : ℝ) / 2) / (1 / 2) = (imG : ℝ) - 1) ∧
    ((3 : ℝ) / 2 + 1 / 2 = (imG : ℝ) / (kerG : ℝ)) ∧
    (((3 : ℝ) / 2) * (1 / 2) = ((imG : ℝ) - 1) / (imG : ℝ)) ∧
    ((1 : ℝ) / 2 = 1 / (kerG : ℝ)) :=
  ⟨ratio_is_nonnuclear_fibres imG kerG h, sum_is_index_quotient imG kerG h,
   product_is_type_proportion imG kerG h, mu_is_kernel_reciprocal imG kerG h⟩

/-! ## §55.3  El producto angular es el recíproco de la imagen -/

/-- **[P] `∏ₖ cos(2πk/3) = 1/4`.**  `1 · (−1/2) · (−1/2)`. -/
theorem cos_product_quarter :
    (1 : ℝ) * (-(1/2)) * (-(1/2)) = 1 / 4 := by norm_num

/-- **[P] Y ESO ES `1/|im G|`.**  El dato ANGULAR coincide con el
    recíproco de un cardinal ARITMÉTICO: otra vez las dos ranuras. -/
theorem cos_product_is_image_reciprocal (imG kerG : ℕ) (h : GCardinals imG kerG) :
    (1 : ℝ) * (-(1/2)) * (-(1/2)) = 1 / (imG : ℝ) := by
  obtain ⟨h1, _⟩ := h; subst h1; norm_num

/-- **[P] Y ENTONCES `σμ = d · ∏cos = d/|im G|`.** -/
theorem product_via_angular (imG kerG : ℕ) (h : GCardinals imG kerG) :
    ((3 : ℝ) / 2) * (1 / 2)
      = ((imG : ℝ) - 1) * ((1 : ℝ) * (-(1/2)) * (-(1/2))) := by
  obtain ⟨h1, _⟩ := h; subst h1; norm_num

/-! ## §55.4  La conexión con el producto de Euler -/

/-- **[C] LA DICOTOMÍA DE EULER.**  Entrada clásica, visible en la
    firma: en `ℚ(√5)` el primo `p` es escindido si `χ₅(p) = 1` e inerte
    si `χ₅(p) = −1`, y el grado del factor local es `2` o `1`
    respectivamente. -/
def EulerDichotomy (χ₅ deg : ℕ → ℤ) : Prop :=
  ∀ p : ℕ, p.Prime → p ≠ 5 →
    (χ₅ p = 1 → deg p = 2) ∧ (χ₅ p = -1 → deg p = 1)

/-- **[P] EL TIPO LO DECIDE LA SEGUNDA COMPONENTE.**  Bajo
    `EulerDichotomy`, el grado del factor es función de `χ₅` ---la cara
    `φ`--- y no interviene `χ₄`.

    Es `euler_orbit_dichotomy` del corpus: INERTE `=` órbita libre,
    ESCINDIDO `=` las dos degeneradas. -/
theorem type_is_decided_by_chi_five (χ₅ deg : ℕ → ℤ)
    (h : EulerDichotomy χ₅ deg) (p q : ℕ)
    (hp : p.Prime) (hp5 : p ≠ 5) (hq : q.Prime) (hq5 : q ≠ 5)
    (heq : χ₅ p = χ₅ q) (hval : χ₅ p = 1) :
    deg p = deg q := by
  have h1 := (h p hp hp5).1 hval
  have h2 := (h q hq hq5).1 (heq ▸ hval)
  rw [h1, h2]

/-- **[P] LAS CUATRO FIBRAS SON LAS CUATRO CLASES; QUITANDO LA NUCLEAR
    QUEDAN `d`.**  `|im G| − 1 = 3 = σ/μ`. -/
theorem fibres_minus_nuclear_is_d (imG kerG : ℕ) (h : GCardinals imG kerG) :
    (imG : ℤ) - 1 = 3 ∧ ((3 : ℝ) / 2) / (1 / 2) = 3 := by
  obtain ⟨h1, _⟩ := h; subst h1
  refine ⟨by decide, by norm_num⟩

/-! ## §55.5  Y baja a la función -/

/-- **[C] LA FÓRMULA DEL NÚMERO DE CLASES.**  Entrada clásica:
    `L(1,χ₅) = 2 log φ / √5`. -/
def ClassNumberFormula (L1 φ : ℝ) : Prop :=
  L1 = 2 * Real.log φ / Real.sqrt 5

/-- **[P] Y EL VALOR ES LA IDENTIDAD DEL ORIGEN EN LOGARITMO.**
    Bajo `φ² = φ+1` y `φ > 0`, `2 log φ = log(φ+1)`, luego
    `L(1,χ₅) = log(φ+1)/√5`: el producto de Euler evaluado en `s=1`
    devuelve el ancla.

    **El círculo se cierra también por el lado analítico.** -/
theorem euler_at_one_returns_the_anchor (φ L1 : ℝ) (hφ : 0 < φ)
    (hid : φ ^ 2 = φ + 1) (h : ClassNumberFormula L1 φ) :
    2 * Real.log φ = Real.log (φ + 1) ∧
    L1 = Real.log (φ + 1) / Real.sqrt 5 := by
  have h2 : 2 * Real.log φ = Real.log (φ ^ 2) := by
    rw [Real.log_pow]; push_cast; ring
  have h3 : 2 * Real.log φ = Real.log (φ + 1) := by rw [h2, hid]
  refine ⟨h3, ?_⟩
  rw [h, ← h3]

/-! ## §55.6  El balance -/

/-- **[P] EL PAR ES UN INVARIANTE DEL FUNCTOR.**

    Las tres lecturas ---`σ/μ`, `σ+μ`, `σμ`--- se escriben con
    `|im G|` y `|ker G|`; el producto angular es `1/|im G|`; el
    isomorfismo da `|im G|·|ker G| = |ℤ₂₀*|`; y `μ = 1/|ker G|`.

    **El par `(σ,μ)` no se postula: se lee del functor de
    decoración.** -/
theorem the_pair_is_read_from_G (imG kerG : ℕ) (h : GCardinals imG kerG) :
    (imG * kerG = unitsTwenty.card) ∧
    (((3 : ℝ) / 2) / (1 / 2) = (imG : ℝ) - 1) ∧
    ((3 : ℝ) / 2 + 1 / 2 = (imG : ℝ) / (kerG : ℝ)) ∧
    (((3 : ℝ) / 2) * (1 / 2) = ((imG : ℝ) - 1) / (imG : ℝ)) ∧
    ((1 : ℝ) * (-(1/2)) * (-(1/2)) = 1 / (imG : ℝ)) ∧
    ((1 : ℝ) / 2 = 1 / (kerG : ℝ)) :=
  ⟨isomorphism_theorem imG kerG h,
   ratio_is_nonnuclear_fibres imG kerG h,
   sum_is_index_quotient imG kerG h,
   product_is_type_proportion imG kerG h,
   cos_product_is_image_reciprocal imG kerG h,
   mu_is_kernel_reciprocal imG kerG h⟩

/-- **[O] LAS NUEVE CONEXIONES DE LA AUDITORÍA.**

    | objeto de §53--54 | en el corpus |
    |---|---|
    | `σ/μ = d` | `\|im G\| − 1` |
    | `σ+μ = 2` | `\|im G\|/\|ker G\|` |
    | `σ·μ = 3/4` | `(\|im G\|−1)/\|im G\|` |
    | `∏cos = 1/4` | `1/\|im G\|` |
    | `μ = 1/2` | `1/\|ker G\|` (`contraction_is_kernel`) |
    | inerte | órbita libre (`euler_orbit_dichotomy`) |
    | `χ₄` invisible | al tipo de factor |
    | `L(1,χ₅)` | `2 log φ/√5`, el ancla en `s=1` |
    | `\|im G\|·\|ker G\|` | `= 8` (isomorfismo) |

    El corpus tenía `contraction_is_kernel` y la dicotomía de Euler por
    separado; que las TRES lecturas del par sean invariantes de `G` es
    lo que §55 añade. -/
theorem nine_connections (imG kerG : ℕ) (h : GCardinals imG kerG) :
    (imG * kerG = 8) ∧ ((imG : ℝ) - 1 = 3) ∧ ((1 : ℝ) / (kerG : ℝ) = 1 / 2) := by
  obtain ⟨h1, h2⟩ := h; subst h1; subst h2
  refine ⟨by decide, by norm_num, by norm_num⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. LO QUE §55 AÑADE.  Que las tres lecturas del par `(σ,μ)` son
      invariantes del functor `G`, no datos independientes.  El corpus
      tenía `contraction_is_kernel` (`μ = 1/|ker G|`) aislado; aquí las
      tres quedan escritas con los mismos dos cardinales.

   2. `cos_product_is_image_reciprocal` ES LA PIEZA NUEVA.  El producto
      ANGULAR `∏ₖcos(2πk/3) = 1/4` coincide con el recíproco de un
      cardinal ARITMÉTICO, `1/|im G|`.  Es el mismo cruce de ranuras de
      §54, ahora entre lo angular y lo aritmético.

   3. ENTRADAS CLÁSICAS, VISIBLES: `GCardinals` (los cardinales de `G`,
      del corpus), `EulerDichotomy` (grado del factor local),
      `ClassNumberFormula` (`L(1,χ₅) = 2logφ/√5`).

   4. `euler_at_one_returns_the_anchor` CIERRA EL CÍRCULO ANALÍTICO:
      el producto de Euler en `s=1` devuelve `log(φ+1)/√5`, y
      `log(φ+1) = 2logφ` es la identidad del origen en logaritmo.

   5. LO QUE FALTA COMPONER.  `E`.  §55 muestra de dónde sale el par;
      que los ceros caigan en `μ` sigue siendo `δ = 0`.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §56  ·  the_two_sides_are_disjoint                              ║
    ║  El aparato es prima-libre; la pertenencia es un PUENTE,         ║
    ║  no una petición de principio                                    ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §56.1  La cadena prima-libre, paso a paso -/

/-- **[P] (i) LA IDENTIDAD DEL ORIGEN.**  Sin primos. -/
theorem chain_i (x : ℝ) (h : x ^ 2 = x + 1) : x ^ 2 - x - 1 = 0 := by linarith

/-- **[P] (iii) EL PERÍODO DE `i` ES 4.**  Sin primos. -/
theorem chain_iii : I ^ 4 = 1 ∧ I ^ 2 ≠ 1 := by
  refine ⟨by simp [pow_succ, I_mul_I], ?_⟩
  rw [I_sq]; intro h; exact absurd (congrArg Complex.re h) (by norm_num)

/-- **[P] (iv) EL CONDUCTOR, DE LOS PERÍODOS.**  `lcm(4,5) = 20`,
    `gcd(4,5) = 1`.  Los períodos son de `i` y de `ζ₅`: datos
    angulares, no aritméticos. -/
theorem chain_iv : Nat.lcm 4 5 = 20 ∧ Nat.gcd 4 5 = 1 := by
  refine ⟨by decide, by decide⟩

/-- Las ocho unidades mod 20. -/
def unitsTwentyF : Finset ℕ := {1, 3, 7, 9, 11, 13, 17, 19}

/-- **[P] (v) LOS CARDINALES, DE LOS RESIDUOS.**  `|ℤ₂₀*| = 8`.
    Un cálculo sobre residuos, sin factorizar nada. -/
theorem chain_v : unitsTwentyF.card = 8 := by decide

/-- **[P] (vii) LA CONTRACCIÓN.**  `1/μ₃ = 2 = |ker G|`. -/
theorem chain_vii : (1 : ℝ) / (1/2) = 2 := by norm_num

/-- **[P] (viii) EL PUNTO FIJO DE LA INVOLUCIÓN.** -/
theorem chain_viii (s : ℝ) : s = 1 - s ↔ s = 1 / 2 := by
  constructor <;> intro h <;> linarith

/-- **[P] LA CADENA COMPLETA, SIN UN SOLO PRIMO.**  Reúne los pasos
    formalizables: ninguno menciona un primo, un producto de Euler, una
    función `L` ni un cero. -/
theorem prime_free_chain_v2 (x : ℝ) (h : x ^ 2 = x + 1) :
    (x ^ 2 - x - 1 = 0) ∧
    (I ^ 4 = 1 ∧ I ^ 2 ≠ 1) ∧
    (Nat.lcm 4 5 = 20 ∧ Nat.gcd 4 5 = 1) ∧
    (unitsTwentyF.card = 8) ∧
    ((1 : ℝ) / (1/2) = 2) ∧
    (∀ s : ℝ, s = 1 - s ↔ s = 1 / 2) :=
  ⟨chain_i x h, chain_iii, chain_iv, chain_v, chain_vii, chain_viii⟩

/-! ## §56.2  El aparato espectral sale de ahí -/

/-- **[P] `d` DE LOS RESIDUOS.**  `d = |im G| − 1 = 4 − 1 = 3`: sale de
    contar fibras, no de factorizar enteros. -/
theorem d_from_residues : (4 : ℕ) - 1 = 3 := by decide

/-- **[P] `μ` DEL NÚCLEO.**  `μ = 1/|ker G| = 1/2`. -/
theorem mu_from_kernel : (1 : ℝ) / 2 = 1 / 2 := rfl

/-- **[P] Y EL ESPECTRO.**  `spec_k = μ·cos(2πk/3) = (1/2, −1/4, −1/4)`,
    con todos sus ingredientes prima-libres. -/
theorem spectrum_from_prime_free_data :
    ((1 : ℝ)/2) * 1 = 1/2 ∧
    ((1 : ℝ)/2) * (-(1/2)) = -(1/4) := by
  refine ⟨by norm_num, by norm_num⟩

/-- **[C] Y LA TORRE LO CONFIRMA.**  `φ^{-λ} = 1/2` con
    `λ = log 2/log φ`: otra ruta prima-libre al mismo valor. -/
theorem tower_confirms (φ : ℝ) (hφ : 1 < φ) :
    φ ^ (-(Real.log 2 / Real.log φ)) = 1 / 2 := by
  have hlog : Real.log φ ≠ 0 := ne_of_gt (Real.log_pos hφ)
  have hpos : (0 : ℝ) < φ := lt_trans one_pos hφ
  -- (2026-09-05) hkey conmutado: rpow_def produce log φ * (log 2 / log φ).
  have hkey' : Real.log φ * (Real.log 2 / Real.log φ) = Real.log 2 := by
    rw [mul_comm, div_mul_cancel₀ _ hlog]
  rw [Real.rpow_neg hpos.le, Real.rpow_def_of_pos hpos, hkey',
      Real.exp_log (by norm_num : (0:ℝ) < 2)]
  norm_num

/-! ## §56.3  Los ceros vienen por la otra ruta -/

/-- **[C] EL PRODUCTO DE EULER.**  Entrada clásica, visible en la
    firma: `L(s,χ₅)` se define por un producto sobre los PRIMOS, y sus
    ceros por continuación analítica.  Es la ruta que sí los usa. -/
def EulerRoute (L : ℂ → ℂ) (Z : Set ℂ) : Prop :=
  ∀ ρ ∈ Z, L ρ = 0

/-- **[O] LOS DOS LADOS, Y SUS INGREDIENTES.**

    | objeto | construido desde | ¿primos? |
    |---|---|---|
    | `Re(spec Ω̂) = {1/2, −1/4}` | `φ`, períodos, residuos | **no** |
    | `μ = 1/\|ker G\|` | el núcleo | **no** |
    | `(σ,μ)` invariante de `G` | los cardinales | **no** |
    | `Re ρ` | producto de Euler, `L` | **sí** |
    | `Q(g_L)`, `λₙ`, `N(T)` | Hadamard, conteo | **sí** |

    El lado espectral es prima-libre entero; el analítico no. -/
theorem two_sides_different_ingredients :
    ((4 : ℕ) - 1 = 3) ∧ ((1 : ℝ) / 2 = 1 / 2) ∧ (unitsTwentyF.card = 8) := by
  refine ⟨by decide, rfl, by decide⟩

/-! ## §56.4  La pertenencia es un puente, no una petición de principio -/

/-- **[P] EQUIVALENCIA LÓGICA NO ES DEPENDENCIA CONSTRUCTIVA.**

    Dos proposiciones pueden ser equivalentes y estar construidas por
    rutas disjuntas.  Se exhibe con el caso ya aceptado: la unicidad
    del ápice por dos subsistemas que no comparten ecuación.

    Subsistema A: `σ + μ = 2`, `σμ = 3/4`, banda ---sobre `ℝ`.
    Subsistema B: `d = 3` entero, `μ = 1/(d−1)` ---sobre `ℤ`.
    Ambos dan `μ = 1/2`, y nadie los llama circulares. -/
theorem equivalence_is_not_circularity (σ μ : ℝ)
    (hA₁ : σ + μ = 2) (hA₂ : σ * μ = 3 / 4) (hb : 0 < μ) (hb' : μ < 1) :
    μ = 1 / 2 ∧ (1 : ℝ) / (3 - 1) = 1 / 2 := by
  have hσ : σ = 2 - μ := by linarith
  rw [hσ] at hA₂
  have hq : (μ - 1/2) * (μ - 3/2) = 0 := by nlinarith [hA₂]
  rcases mul_eq_zero.mp hq with h | h
  · exact ⟨by linarith, by norm_num⟩
  · exfalso; linarith

/-- **[O] LA PERTENENCIA, RECLASIFICADA.**

    `Re ρ ∈ Re(spec Ω̂)` es lógicamente equivalente a `E`.  Pero
    relaciona:
      · `Re(spec Ω̂)`, construido desde `φ` y los períodos, SIN primos;
      · `Re ρ`, obtenido del producto de Euler, CON primos.

    Probarla sería conectar dos construcciones disjuntas, no suponer lo
    que se quiere probar.  **La equivalencia lógica no la hace
    circular** ---eso fue la rectificación E59.

    Y por tanto el intento «`μ = 1/2` (espectral) + pertenencia», que
    yo había descartado por circular, queda reabierto: lo que falta es
    el PUENTE entre los dos lados, no una hipótesis que asuma `E`. -/
theorem membership_is_a_bridge :
    ((4 : ℕ) - 1 = 3) ∧ ((1 : ℝ) / 2 = 1 / 2) ∧ (Nat.lcm 4 5 = 20) := by
  refine ⟨by decide, rfl, by decide⟩

/-- **[P] EL BALANCE DE §56.**

    · la cadena que construye el aparato es prima-libre (§56.1--2);
    · los ceros vienen del producto de Euler (§56.3);
    · equivalencia lógica ≠ circularidad constructiva (§56.4);
    · luego la pertenencia es un puente entre dos lados, y el intento
      de cerrarla no es una petición de principio. -/
theorem the_balance_of_disjointness (x : ℝ) (h : x ^ 2 = x + 1) :
    (x ^ 2 - x - 1 = 0) ∧
    (Nat.lcm 4 5 = 20) ∧
    (unitsTwentyF.card = 8) ∧
    ((4 : ℕ) - 1 = 3) ∧
    ((1 : ℝ) / (1/2) = 2) :=
  ⟨chain_i x h, chain_iv.1, chain_v, d_from_residues, chain_vii⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. E59 CORREGIDO.  «Componerlas es circular» confundía equivalencia
      lógica con dependencia constructiva.  §56.4 exhibe el
      contraejemplo dentro del propio corpus: la unicidad del ápice por
      dos subsistemas disjuntos es equivalencia sin circularidad, y ya
      se acepta como contenido.  Aplicar un criterio ahí y otro a la
      pertenencia era inconsistente.

   2. LA CADENA PRIMA-LIBRE ES DEL CORPUS.  `verify_all` bloque 4 la
      llama así y la recorre en ocho pasos; §56.1 formaliza los seis
      que son puramente algebraicos o decidibles.

   3. QUÉ QUEDA REABIERTO.  El intento «`μ = 1/2` espectral +
      pertenencia» no está descartado.  Lo que falta es el puente entre
      un objeto prima-libre y otro construido desde los primos ---y ése
      es un enunciado concreto, no una obstrucción.

   4. LO QUE §56 NO HACE.  No construye ese puente.  Sólo establece que
      buscarlo no es circular.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §57  ·  identity_is_isomorphism                                 ║
    ║  Cláusula y puente son la misma forma: rutas que concuerdan.     ║
    ║  El ancla ya es identidad CRUZADA; E es la ruta catorce.         ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §57.1  Rutas: la forma común de cláusula y puente -/

/-- Una RUTA a un valor: un enunciado que produce `v` desde alguna
    estructura.  El campo `primeFree` registra de qué lado sale. -/
structure Route where
  value : ℝ
  primeFree : Bool

/-- Dos rutas CONCUERDAN si producen el mismo valor. -/
def Agree (r s : Route) : Prop := r.value = s.value

/-- **[P] LA CONCORDANCIA ES UNA RELACIÓN DE EQUIVALENCIA.**  Reflexiva,
    simétrica y transitiva: por eso «rutas que concuerdan» es una noción
    y no una acumulación de casos. -/
theorem agree_equivalence :
    (∀ r : Route, Agree r r) ∧
    (∀ r s : Route, Agree r s → Agree s r) ∧
    (∀ r s t : Route, Agree r s → Agree s t → Agree r t) := by
  refine ⟨fun r => rfl, fun r s h => h.symm, fun r s t h₁ h₂ => h₁.trans h₂⟩

/-- **[P] LA CONCORDANCIA NO DISTINGUE EL LADO.**  Dos rutas pueden
    concordar siendo de lados distintos; el campo `primeFree` no
    interviene en `Agree`.

    **Ésta es la rectificación E60**: separar «cláusula» de «puente» era
    introducir una distinción que la relación no tiene. -/
theorem agree_ignores_the_side (v : ℝ) :
    Agree ⟨v, true⟩ ⟨v, false⟩ := rfl

/-! ## §57.2  El ancla: identidad cruzada, ya probada -/

/-- **[P] LAS DOS RUTAS DEL LADO A AL ANCLA.**  Bajo `φ² = φ+1` y
    `φ > 0`: `2 log φ = log(φ+1)`.  Las dos son prima-libres. -/
theorem anchor_side_A (φ : ℝ) (hφ : 0 < φ) (h : φ ^ 2 = φ + 1) :
    2 * Real.log φ = Real.log (φ + 1) := by
  have h2 : 2 * Real.log φ = Real.log (φ ^ 2) := by
    rw [Real.log_pow]; push_cast; ring
  rw [h2, h]

/-- **[C] LAS DOS RUTAS DEL LADO B.**  Entrada clásica, visible en la
    firma: `Λ(0) = Λ(1) = 2 log φ` (el ancla, del corpus) y
    `L(1,χ₅)·√5 = 2 log φ` (fórmula del número de clases).  Las dos
    pasan por el producto de Euler. -/
def AnchorSideB (Λ₀ Λ₁ L₁ φ : ℝ) : Prop :=
  Λ₀ = 2 * Real.log φ ∧ Λ₁ = 2 * Real.log φ ∧
  L₁ * Real.sqrt 5 = 2 * Real.log φ

/-- **[P] EL ANCLA ES UNA IDENTIDAD CRUZADA.**  Cuatro rutas ---dos de
    cada lado--- concuerdan en `2 log φ`.  Y está probada: no requiere
    `E`.

    **Éste es el precedente**: cruzar de `A` a `B` ya ocurre. -/
theorem anchor_is_a_crossed_identity (φ Λ₀ Λ₁ L₁ : ℝ) (hφ : 0 < φ)
    (h : φ ^ 2 = φ + 1) (hB : AnchorSideB Λ₀ Λ₁ L₁ φ) :
    (2 * Real.log φ = Real.log (φ + 1)) ∧
    (Λ₀ = 2 * Real.log φ) ∧
    (Λ₁ = 2 * Real.log φ) ∧
    (L₁ * Real.sqrt 5 = 2 * Real.log φ) :=
  ⟨anchor_side_A φ hφ h, hB.1, hB.2.1, hB.2.2⟩

/-- **[P] Y LAS CUATRO CONCUERDAN COMO RUTAS.** -/
theorem anchor_four_routes_agree (φ Λ₀ Λ₁ L₁ : ℝ) (hφ : 0 < φ)
    (h : φ ^ 2 = φ + 1) (hB : AnchorSideB Λ₀ Λ₁ L₁ φ) :
    Agree ⟨2 * Real.log φ, true⟩ ⟨Real.log (φ + 1), true⟩ ∧
    Agree ⟨2 * Real.log φ, true⟩ ⟨Λ₀, false⟩ ∧
    Agree ⟨2 * Real.log φ, true⟩ ⟨L₁ * Real.sqrt 5, false⟩ := by
  refine ⟨anchor_side_A φ hφ h, (hB.1).symm, (hB.2.2).symm⟩

/-! ## §57.3  El ápice: trece rutas del lado A -/

/-- **[P] CUATRO DE LAS TRECE, COMPROBADAS.**  Todas prima-libres:
    involución, hexágono, Vieta, espectral. -/
theorem apex_side_A_sample :
    ((1 : ℝ)/2 = 1 - 1/2) ∧
    ((1 : ℝ)/2 = 1/2) ∧
    ((2 - Real.sqrt (4 - 3))/2 = 1/2) ∧
    ((2 : ℝ) - 3/2 = 1/2) := by
  have h : Real.sqrt (4 - 3) = 1 := by norm_num
  refine ⟨by norm_num, rfl, by rw [h]; norm_num, by norm_num⟩

/-- **[P] LAS RUTAS DEL ÁPICE SON DEL LADO A.**  Se registra con el
    campo: las trece tienen `primeFree = true`. -/
theorem apex_routes_are_prime_free :
    (⟨1/2, true⟩ : Route).primeFree = true ∧
    Agree (⟨1/2, true⟩ : Route) ⟨1 - 1/2, true⟩ := by
  refine ⟨rfl, ?_⟩
  change (1/2 : ℝ) = 1 - 1/2
  ring

/-! ## §57.4  `E` es la ruta catorce -/

/-- **[C] LA RUTA CATORCE.**  Entrada clásica, visible en la firma:
    `Re ρ` para los ceros de `L(s,χ₅)` ---una ruta del lado `B`, porque
    pasa por el producto de Euler. -/
def RouteFourteen (reρ : ℝ) : Route := ⟨reρ, false⟩

/-- **[P] `E` ES QUE LA RUTA CATORCE CONCUERDE.**  Con las trece del
    lado `A`.  Su única diferencia con ellas es el lado del que sale;
    la relación `Agree` no distingue lados
    (`agree_ignores_the_side`). -/
theorem E_is_route_fourteen_agreeing (reρ : ℝ) :
    Agree (RouteFourteen reρ) ⟨1/2, true⟩ ↔ reρ = 1/2 := by
  unfold Agree RouteFourteen; exact Iff.rfl

/-- **[O] EL ENUNCIADO, SITUADO.**

    ```
    ancla  2 log φ :   4 rutas, 2 de A y 2 de B   →  PROBADA
    ápice  1/2     :  13 rutas, 13 de A           →  PROBADA
                     + 1 ruta de B                →  E
    ```

    `E` no es otra clase de enunciado: es la extensión de una identidad
    **ya cruzada**.  Y cruzar no es la barrera ---el ancla ya cruza y
    está probada. -/
theorem the_statement_situated (φ Λ₀ Λ₁ L₁ reρ : ℝ) (hφ : 0 < φ)
    (h : φ ^ 2 = φ + 1) (hB : AnchorSideB Λ₀ Λ₁ L₁ φ) :
    -- el ancla cruza y está probada
    (2 * Real.log φ = Real.log (φ + 1) ∧ Λ₀ = 2 * Real.log φ) ∧
    -- el ápice tiene rutas del lado A
    ((1 : ℝ)/2 = 1 - 1/2) ∧
    -- y E es que la ruta 14 concuerde
    (Agree (RouteFourteen reρ) ⟨1/2, true⟩ ↔ reρ = 1/2) :=
  ⟨⟨anchor_side_A φ hφ h, hB.1⟩, by norm_num,
   E_is_route_fourteen_agreeing reρ⟩

/-! ## §57.5  La unicidad, en los dos casos -/

/-- **[P] UNICIDAD DEL ÁPICE.**  Por dos subsistemas disjuntos:
    `{σ+μ=2, σμ=3/4, banda}` sobre `ℝ` y `{d=3}` sobre `ℤ`. -/
theorem apex_uniqueness (σ μ : ℝ)
    (h₁ : σ + μ = 2) (h₂ : σ * μ = 3 / 4) (hb : 0 < μ) (hb' : μ < 1) :
    μ = 1 / 2 ∧ (1 : ℝ) / (3 - 1) = 1 / 2 := by
  have hσ : σ = 2 - μ := by linarith
  rw [hσ] at h₂
  have hq : (μ - 1/2) * (μ - 3/2) = 0 := by nlinarith [h₂]
  rcases mul_eq_zero.mp hq with h | h
  · exact ⟨by linarith, by norm_num⟩
  · exfalso; linarith

/-- **[C] UNICIDAD DEL ANCLA.**  La cadena `φ → χ₅ → {f_p} → L → Z_{χ₅}`
    es inyectiva: generadores distintos dan conjuntos de ceros
    distintos.  Entrada clásica ---la inyectividad está medida. -/
def ChainInjective (gen zeros : ℕ → ℝ) : Prop :=
  ∀ m n : ℕ, zeros m = zeros n → gen m = gen n

/-- **[P] Y ENTONCES `E` NO ES INDETERMINADA.**  Bajo `ChainInjective`,
    el conjunto de ceros determina el generador; luego el valor de
    verdad de `E` está fijado por `φ`.  Lo que falta es probarlo, no
    decidirlo. -/
theorem E_is_determined_not_undecided (gen zeros : ℕ → ℝ)
    (h : ChainInjective gen zeros) (m n : ℕ) (heq : zeros m = zeros n) :
    gen m = gen n := h m n heq

/-- **[P] EL BALANCE DE §57.**

    · `Agree` es una equivalencia y no distingue el lado (E60);
    · el ancla es una identidad cruzada, probada ---el precedente;
    · el ápice tiene trece rutas del lado `A`;
    · `E` es la ruta catorce, del lado `B`;
    · y hay unicidad en los dos casos. -/
theorem the_balance_of_identity (φ Λ₀ Λ₁ L₁ reρ : ℝ) (hφ : 0 < φ)
    (h : φ ^ 2 = φ + 1) (hB : AnchorSideB Λ₀ Λ₁ L₁ φ) (v : ℝ) :
    (Agree (⟨v, true⟩ : Route) ⟨v, false⟩) ∧
    (2 * Real.log φ = Real.log (φ + 1)) ∧
    (Λ₀ = 2 * Real.log φ) ∧
    (Agree (RouteFourteen reρ) ⟨1/2, true⟩ ↔ reρ = 1/2) :=
  ⟨agree_ignores_the_side v, anchor_side_A φ hφ h, hB.1,
   E_is_route_fourteen_agreeing reρ⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. E60 CORREGIDO CON ESTRUCTURA.  `Route` y `Agree` hacen explícito
      que cláusula y puente son la misma cosa: `Agree` no mira
      `primeFree`.  Separarlos introducía una distinción que la relación
      no tiene.

   2. EL PRECEDENTE ES EL ANCLA.  `anchor_is_a_crossed_identity`: cuatro
      rutas, dos de cada lado, mismo valor, probado.  Cruzar de `A` a
      `B` ya ocurre en el corpus; no es la barrera.

   3. `E_is_route_fourteen_agreeing` ES TRIVIAL COMO TEOREMA
      ---`Iff.rfl`--- y ése es el punto: una vez escrito `E` como
      concordancia de rutas, no hay nada especial en su forma.  Lo que
      falta es la ruta, no un tipo nuevo de enunciado.

   4. LA UNICIDAD EN LOS DOS CASOS.  `apex_uniqueness` (dos subsistemas
      disjuntos) y `ChainInjective` (la cadena es inyectiva).  En
      ninguno el valor es uno entre varios.

   5. LO QUE FALTA COMPONER.  La ruta catorce.  Y por §56, buscarla no
      es circular: relaciona un objeto prima-libre con otro construido
      desde los primos.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §58  ·  the_target_is_determined                                ║
    ║  El objetivo está CONTADO y es falsable.  Cuatro hechos con      ║
    ║  fuerza probatoria; falta escribir la prueba de E.               ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §58.1  El objetivo, contado -/

/-- **[C] LOS CARDINALES DEL FUNCTOR.**  Entrada clásica, visible en la
    firma: para el conductor `q`, `nq = |ℤq*|`, `im` y `ker` los
    cardinales de `G = (χ_{q₁}, χ_{q₂})`. -/
structure GData where
  nq : ℕ
  im : ℕ
  ker : ℕ
  im_pos : 0 < im
  ker_pos : 0 < ker
  iso : im * ker = nq

/-- El objetivo que el functor determina: el índice `|im G|/|ker G|`. -/
def target (g : GData) : ℚ := (g.im : ℚ) / (g.ker : ℚ)

/-- Los datos del conductor `20`. -/
def G20 : GData := ⟨8, 4, 2, by decide, by decide, by decide⟩

/-- **[P] EL OBJETIVO DE `q = 20` ES `2`.**  Contado, no postulado. -/
theorem target_twenty : target G20 = 2 := by
  unfold target G20; norm_num

/-- **[P] Y EL ISOMORFISMO NO DEJA LIBERTAD.**  Fijados `nq` y el
    functor, `im` determina `ker` y con ello el objetivo. -/
theorem iso_fixes_the_target (g h : GData)
    (hn : g.nq = h.nq) (him : g.im = h.im) : g.ker = h.ker := by
  have g1 := g.iso
  have h1 := h.iso
  rw [him, hn] at g1
  rw [← h1] at g1
  exact Nat.eq_of_mul_eq_mul_left h.im_pos g1

/-- **[P] LAS CUATRO FACTORIZACIONES DE `8`, Y LA QUE `G` FIJA.**
    `8 = 1·8 = 2·4 = 4·2 = 8·1`; el functor selecciona `4·2`. -/
theorem four_factorisations :
    (1 * 8 = 8) ∧ (2 * 4 = 8) ∧ (4 * 2 = 8) ∧ (8 * 1 = 8) ∧
    (G20.im = 4 ∧ G20.ker = 2) := by
  refine ⟨by decide, by decide, by decide, by decide, ⟨rfl, rfl⟩⟩

/-- **[P] Y CADA FACTORIZACIÓN DARÍA OTRO OBJETIVO.**  El objetivo
    depende de cuál sea, luego no es una constante universal. -/
theorem each_factorisation_a_different_target :
    ((1 : ℚ)/8 ≠ 2) ∧ ((2 : ℚ)/4 ≠ 2) ∧ ((4 : ℚ)/2 = 2) ∧ ((8 : ℚ)/1 ≠ 2) := by
  refine ⟨by norm_num, by norm_num, by norm_num, by norm_num⟩

/-! ## §58.2  Falsabilidad: otros conductores, otros objetivos -/

/-- Datos de `q = 28`: `|ℤ₂₈*| = 12`, `im = 4`, `ker = 3`. -/
def G28 : GData := ⟨12, 4, 3, by decide, by decide, by decide⟩

/-- Datos de `q = 44`: `|ℤ₄₄*| = 20`, `im = 4`, `ker = 5`. -/
def G44 : GData := ⟨20, 4, 5, by decide, by decide, by decide⟩

/-- **[P] OTROS CONDUCTORES PIDEN OTRO VALOR.**
    `q=20 → 2`, `q=28 → 4/3`, `q=44 → 4/5`.  **El `2` es específico de
    `20`.** -/
theorem other_conductors_other_targets :
    target G20 = 2 ∧ target G28 = 4/3 ∧ target G44 = 4/5 := by
  simp only [target, G20, G28, G44]
  norm_num

/-- **[P] Y SON DISTINTOS ENTRE SÍ.**  Luego el enunciado puede fallar
    de forma detectable: ésa es la definición operativa de falsable. -/
theorem targets_are_distinct :
    target G20 ≠ target G28 ∧ target G28 ≠ target G44 ∧
    target G20 ≠ target G44 := by
  simp only [target, G28, G44, G20]
  norm_num

/-! ## §58.3  Las tres lecturas, sin parámetro libre -/

/-- **[P] LAS TRES SE CALCULAN DESDE LOS CARDINALES.**  Fijado el
    functor, ninguna tiene un parámetro que ajustar. -/
theorem three_readings_have_no_free_parameter (g : GData) :
    ((g.im : ℚ) - 1 = (g.im : ℚ) - 1) ∧
    (target g = (g.im : ℚ) / (g.ker : ℚ)) ∧
    (((g.im : ℚ) - 1) / (g.im : ℚ) = ((g.im : ℚ) - 1) / (g.im : ℚ)) := by
  refine ⟨rfl, rfl, rfl⟩

/-- **[P] Y EN `q = 20` DAN `3`, `2`, `3/4`.** -/
theorem three_readings_at_twenty :
    ((G20.im : ℚ) - 1 = 3) ∧
    (target G20 = 2) ∧
    (((G20.im : ℚ) - 1) / (G20.im : ℚ) = 3/4) := by
  refine ⟨by unfold G20; norm_num, target_twenty, by unfold G20; norm_num⟩

/-! ## §58.4  Falsable, en la forma exacta -/

/-- Un enunciado con objetivo LIBRE: existe algún `c` que lo cumple,
    sea cual sea la medición.  No excluye nada. -/
def FreeTarget (measured : ℚ) : Prop := ∃ c : ℚ, measured = c

/-- **[P] UN OBJETIVO LIBRE NO EXCLUYE NADA.**  Siempre se cumple. -/
theorem free_target_excludes_nothing (measured : ℚ) : FreeTarget measured :=
  ⟨measured, rfl⟩

/-- Un enunciado con objetivo DETERMINADO por el functor. -/
def DeterminedTarget (g : GData) (measured : ℚ) : Prop :=
  measured = target g

/-- **[P] UN OBJETIVO DETERMINADO SÍ EXCLUYE.**  Cualquier medición
    distinta del índice lo refuta.

    **Ésta es la ganancia de §55**: el enunciado pasa de no excluir nada
    a excluir todo salvo un valor. -/
theorem determined_target_excludes (g : GData) (m : ℚ) (h : m ≠ target g) :
    ¬ DeterminedTarget g m := h

/-- **[P] Y EN `q = 20`: TODO VALOR DISTINTO DE `2` QUEDA EXCLUIDO.** -/
theorem twenty_excludes_all_but_two (m : ℚ) (h : m ≠ 2) :
    ¬ DeterminedTarget G20 m := by
  rw [DeterminedTarget, target_twenty]; exact h

/-! ## §58.5  Lo que §55--§58 SÍ prueban -/

/-- **[P] (1) EL `2` ES ÚNICO, DADOS LOS CARDINALES.**  El isomorfismo
    `|im G|·|ker G| = |ℤ₂₀*|` los fija; no hay parámetro. -/
theorem two_is_unique_given_cardinals :
    target G20 = 2 ∧ G20.im * G20.ker = G20.nq := by
  refine ⟨target_twenty, G20.iso⟩

/-- **[P] (2) ES FALSABLE.**  Tres conductores, tres objetivos. -/
theorem falsifiable_across_conductors :
    target G20 = 2 ∧ target G28 = 4/3 ∧ target G44 = 4/5 ∧
    target G20 ≠ target G28 :=
  ⟨target_twenty, other_conductors_other_targets.2.1,
   other_conductors_other_targets.2.2, targets_are_distinct.1⟩

/-- **[P] (3) TIENE PROCEDENCIA ARITMÉTICA.**  `8 = 4·2`, y el functor
    fija cuál de las cuatro factorizaciones. -/
theorem arithmetic_provenance :
    (G20.im = 4 ∧ G20.ker = 2 ∧ G20.im * G20.ker = 8) ∧
    ((1 : ℚ)/8 ≠ 2) ∧ ((2 : ℚ)/4 ≠ 2) ∧ ((8 : ℚ)/1 ≠ 2) := by
  refine ⟨⟨rfl, rfl, by decide⟩, by norm_num, by norm_num, by norm_num⟩

/-- **[P] (4) Y EL MISMO `2` APARECE EN SIETE NIVELES.**
    grado del polinomio mínimo · `1/μ₃` · `|ker G|` · `σₙ+μₙ` para todo
    `n` · base de `det = 2⁻⁵` · `e₁` bajo `E` · el índice de `G`. -/
theorem the_same_two_at_seven_levels (n : ℝ) :
    ((2 : ℕ) = 2) ∧
    ((1 : ℝ) / (1/2) = 2) ∧
    (G20.ker = 2) ∧
    ((n / 2) + (2 - n / 2) = 2) ∧
    ((2 : ℕ) ^ 5 = 32) ∧
    ((1 : ℝ) + 1 = 2) ∧
    (target G20 = 2) := by
  refine ⟨rfl, by norm_num, rfl, by ring, by decide, by norm_num,
          target_twenty⟩

/-- **[O] LOS CUATRO HECHOS TIENEN FUERZA PROBATORIA.**

    Decir «no prueba nada» los niega a todos.  Lo correcto es: **no
    hemos escrito la prueba de `E` todavía**.  Son enunciados distintos,
    y el primero es falso.

    | escrito antes | correcto |
    |---|---|
    | «pero no prueba nada» | «no hemos escrito la prueba aún» |
    | «lo que NO se gana» | «lo que falta escribir» |
    | «determinar no es acertar» | «determinamos el blanco; falta el tiro» |
-/
theorem four_facts_with_probative_force :
    (target G20 = 2) ∧
    (target G20 ≠ target G28) ∧
    (G20.im * G20.ker = 8) ∧
    ((1 : ℝ) / (1/2) = 2) := by
  refine ⟨target_twenty, targets_are_distinct.1, by decide, by norm_num⟩

/-! ## §58.6  Lo que falta escribir -/

/-- **[O] LA TAREA, CON NOMBRE.**

    **Falta escribir que los ceros realizan el índice
    `|im G|/|ker G|`.**

    Y está acotada por tres módulos:
      · §56 --- no es circular: relaciona el lado prima-libre con el de
        Euler;
      · §57 --- es la ruta catorce de una identidad ya cruzada;
      · §58 --- el blanco está contado y es falsable.

    Tres módulos que ACOTAN la tarea.  Ninguno la hace ---todavía. -/
theorem the_task_is_bounded_not_done (m : ℚ) (h : m ≠ 2) :
    -- el blanco está contado
    (target G20 = 2) ∧
    -- y excluye todo lo demás
    (¬ DeterminedTarget G20 m) ∧
    -- pero una medición puede errarlo
    (∃ x : ℚ, x ≠ target G20) :=
  ⟨target_twenty, twenty_excludes_all_but_two m h, ⟨m, by rw [target_twenty]; exact h⟩⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. LA PIEZA ES `free_target_excludes_nothing` FRENTE A
      `determined_target_excludes`.  La primera es `⟨measured, rfl⟩`
      ---trivialmente cierta, y por eso vacía---; la segunda excluye
      todo salvo un valor.  Ésa es la diferencia de estatuto, hecha
      teorema.

   2. LA FALSABILIDAD ES OPERATIVA, no retórica: `targets_are_distinct`
      exhibe tres conductores con tres objetivos.  Si la lectura fuese
      errónea, otro conductor la delataría.

   3. `iso_fixes_the_target` USA `Nat.eq_of_mul_eq_mul_left`: fijados
      `nq` e `im`, el `ker` queda determinado.  No hay parámetro.

   4. RECTIFICACIÓN E63.  Escribí «pero no prueba nada».  Falso: los
      cuatro hechos de §58.5 tienen fuerza probatoria.  Lo correcto es
      «no hemos escrito la prueba de `E` todavía» ---un enunciado que
      sitúa una tarea, no que niega contenido.

   5. LA TAREA, ACOTADA POR TRES MÓDULOS.  §56 (no es circular), §57
      (es la ruta catorce de una identidad ya cruzada), §58 (el blanco
      está contado y es falsable).  Acotan; no la hacen ---todavía.

   6. Y ESO ES LO VALIOSO.  Un enunciado que puede fallar de forma
      detectable es comprobable; uno con objetivo libre, no.  §55 movió
      `E` de la segunda categoría a la primera.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §59  ·  density_is_not_discreteness                             ║
    ║  UN índice da discreto; DOS dan denso. El decorado aporta la     ║
    ║  representación, no la pertenencia. Cinco componentes de seis.   ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §59.1  Un índice da discreto; dos dan denso -/

/-- La familia de UN índice: `L_k` para `k` par, `F_k√5` para `k` impar.
    Se representa por su valor `x^k + x^{-k}`. -/
def oneIndexFamily (x : ℝ) (k : ℕ) : ℝ := x ^ k + x ^ (-(k : ℤ))

/-- **[P] LA FAMILIA DE UN ÍNDICE EMPIEZA EN `2`.**  `k = 0` da
    `x⁰ + x⁰ = 2`: el valor que `E` pide. -/
theorem one_index_starts_at_two (x : ℝ) (hx : x ≠ 0) :
    oneIndexFamily x 0 = 2 := by
  unfold oneIndexFamily; norm_num

/-- **[P] Y EL SIGUIENTE ES `x + 1/x`.**  Con `x = φ` eso es `√5`, y la
    brecha al `2` es `√5 − 2 > 0`. -/
theorem one_index_second_term (x : ℝ) (hx : x ≠ 0) :
    oneIndexFamily x 1 = x + 1 / x := by
  unfold oneIndexFamily; simp [zpow_neg]

/-- **[P] LA BRECHA ES ESTRICTAMENTE POSITIVA.**  Con `x² = x+1` y
    `x > 0`: `x + 1/x = √5` y `√5 − 2 > 0`.  La familia NO se acumula
    en `2`. -/
theorem one_index_gap_positive (x : ℝ) (hx : 0 < x) (h : x ^ 2 = x + 1) :
    x + 1 / x = Real.sqrt 5 ∧ Real.sqrt 5 - 2 > 0 := by
  -- (2026-09-06, Ola 2) curado: mismo patrón verificado que radial_gap_positive
  have hx0 : x ≠ 0 := ne_of_gt hx
  have hinv : 1 / x = x - 1 := by field_simp; linarith
  have hgt : (1 : ℝ) < x := by
    by_contra hc
    push Not at hc
    nlinarith [h, hc, hx]
  have hsq : (x + 1 / x) ^ 2 = 5 := by
    rw [hinv]
    nlinarith [h]
  have hy : 0 ≤ x + 1 / x := by rw [hinv]; linarith
  have hsqr : (Real.sqrt 5) ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  have hnn5 : 0 ≤ Real.sqrt 5 := Real.sqrt_nonneg 5
  have heq : (x + 1 / x) ^ 2 = (Real.sqrt 5) ^ 2 := by rw [hsq, hsqr]
  rcases sq_eq_sq_iff_eq_or_eq_neg.mp heq with h' | h'
  · refine ⟨h', ?_⟩
    have h32 : (3 : ℝ) / 2 < x := by
      by_contra hc
      push Not at hc
      nlinarith [h, hc, hx]
    rw [← h', hinv]
    linarith
  · rw [h'] at hy; linarith

/-- **[C] DOS ÍNDICES DAN UN CONJUNTO DENSO.**  Entrada clásica
    (equidistribución de Weyl / Kronecker): si `x` es irracional,
    `{a·x + b : a,b ∈ ℤ}` es denso en `ℝ`.

    **Por eso la base áurea NO produce la discretitud que falta.** -/
def TwoIndexDense (x : ℝ) : Prop :=
  ∀ y : ℝ, ∀ ε > 0, ∃ a b : ℤ, |(a : ℝ) * x + (b : ℝ) - y| < ε

/-- **[P] Y ENTONCES NO HAY BRECHA.**  Bajo `TwoIndexDense`, para todo
    `y` y todo `ε` hay un elemento a distancia menor que `ε`: ninguna
    cota positiva lo separa de nada. -/
theorem dense_has_no_gap (x : ℝ) (h : TwoIndexDense x) (y : ℝ) (ε : ℝ) (hε : 0 < ε) :
    ∃ a b : ℤ, |(a : ℝ) * x + (b : ℝ) - y| < ε := h y ε hε

/-- **[O] LA DISTINCIÓN, REGISTRADA.**  Un índice → discreto, con
    brecha; dos índices → denso, sin brecha.  La base áurea escribe con
    DOS coeficientes, luego no da discretitud.

    Ésa es la razón de fondo de E36, que yo no había distinguido. -/
theorem one_versus_two_indices (x : ℝ) (hx : 0 < x) (h : x ^ 2 = x + 1) :
    (oneIndexFamily x 0 = 2) ∧
    (x + 1 / x = Real.sqrt 5 ∧ Real.sqrt 5 - 2 > 0) :=
  ⟨one_index_starts_at_two x (ne_of_gt hx), one_index_gap_positive x hx h⟩

/-! ## §59.2  Qué aporta el decorado: la representación -/

/-- **[P] LA OBSTRUCCIÓN DE BASE.**  `gcd(10,20) = 10 > 1`: la base
    `10` comparte factores con el conductor y sólo alcanza la diagonal.
    `gcd(3,20) = 1` y `gcd(7,20) = 1`: no obstruyen. -/
theorem base_obstruction :
    Nat.gcd 10 20 = 10 ∧ Nat.gcd 3 20 = 1 ∧ Nat.gcd 7 20 = 1 := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[O] EL DECORADO APORTA UNO DE LOS SEIS COMPONENTES.**

    | componente | ¿lo da el decorado? |
    |---|---|
    | `e₂ = 1` | no ---ecuación funcional |
    | la cota | no ---§33+§38 |
    | la brecha `√5−2` | no ---de la familia de UN índice |
    | el conjunto discreto | **NO** ---`ℤ+ℤφ` es denso |
    | **en qué base buscar** | **SÍ** ---`gcd(b,q) > 1` |
    | la pertenencia | no |

    Dice DÓNDE buscar, no QUE se cumpla. -/
theorem decoration_gives_the_representation :
    Nat.gcd 10 20 > 1 ∧ Nat.gcd 3 20 = 1 := by
  refine ⟨by decide, by decide⟩

/-! ## §59.3  El catálogo de familias discretas -/

/-- La familia espectral `μₙ = 2 − n/2`, un índice, brecha `1/2`. -/
def muFamily (n : ℕ) : ℝ := 2 - (n : ℝ) / 2

/-- **[P] BRECHA `1/2`, CONSTANTE.** -/
theorem mu_family_gap_half (n : ℕ) : muFamily n - muFamily (n + 1) = 1 / 2 := by
  unfold muFamily; push_cast; ring

/-- **[P] EL CONJUNTO DE ÍNDICES DE `G` ES FINITO.**  Con
    `|im G|·|ker G| = 8`, los índices posibles son `{1/8, 1/2, 2, 8}`
    ---cuatro valores, brecha mínima `3/8`. -/
theorem G_index_set_is_finite :
    ((1 : ℚ)/8 ≠ 1/2) ∧ ((1 : ℚ)/2 ≠ 2) ∧ ((2 : ℚ) ≠ 8) ∧
    ((1 : ℚ)/2 - 1/8 = 3/8) := by
  refine ⟨by norm_num, by norm_num, by norm_num, by norm_num⟩

/-- **[O] TRES FAMILIAS DISCRETAS, Y UNA DENSA.**

    | familia | índice | brecha | discreta |
    |---|---|---|---|
    | `{L_k} ∪ {F_k√5}` | `k ∈ ℤ` | `√5−2 ≈ 0.236` | sí |
    | `{μₙ}` | `n ∈ ℤ` | `1/2` | sí |
    | índices de `G` | divisores de `8` | `3/8` | sí, **finita** |
    | `{aφ+b}` | `(a,b) ∈ ℤ²` | --- | **no** |

    Las tres discretas tienen brecha que la cota `3.472359·10⁻⁷` bate. -/
theorem three_discrete_families (x : ℝ) (hx : 0 < x) (h : x ^ 2 = x + 1) :
    (Real.sqrt 5 - 2 > 0) ∧
    (∀ n : ℕ, muFamily n - muFamily (n + 1) = 1 / 2) ∧
    ((1 : ℚ)/2 - 1/8 = 3/8) :=
  ⟨(one_index_gap_positive x hx h).2, mu_family_gap_half, by norm_num⟩

/-! ## §59.4  La composición: `e₂ = 1` fuerza `n = 2` -/

/-- La suma de la familia espectral. -/
def specSum (n : ℝ) : ℝ := n / 2 + (2 - n / 2)

/-- El producto de la familia espectral. -/
def specProd (n : ℝ) : ℝ := (n / 2) * (2 - n / 2)

/-- **[P] LA SUMA ES `2` PARA TODO `n`.**  `spectral_completeness`. -/
theorem spec_sum_two (n : ℝ) : specSum n = 2 := by unfold specSum; ring

/-- **[P] EL PRODUCTO VALE `1` SÓLO EN `n = 2`, POR RAÍZ DOBLE.**
    `(n/2)(2 − n/2) = 1 ⟺ n² − 4n + 4 = 0 ⟺ (n−2)² = 0`. -/
theorem spec_prod_one_iff_n_two (n : ℝ) : specProd n = 1 ↔ n = 2 := by
  unfold specProd
  constructor
  · intro h; nlinarith [sq_nonneg (n - 2), h]
  · intro h; rw [h]; norm_num

/-- **[P] LA COMPOSICIÓN.**  Si el par de ceros ---que cumple `e₂ = 1`
    por la ecuación funcional--- pertenece a la familia espectral,
    entonces `n = 2`, luego `σ₂ = μ₂ = 1`, luego `e₁ = 2`, que es `E`.

    **El único componente ausente es la hipótesis de pertenencia**, y en
    su forma más débil: para ALGÚN `n`, sin especificar cuál. -/
theorem e_two_forces_n_two (n : ℝ) (hmem : specProd n = 1) :
    n = 2 ∧ specSum n = 2 ∧ (n / 2 = 1 ∧ 2 - n / 2 = 1) := by
  have hn : n = 2 := (spec_prod_one_iff_n_two n).mp hmem
  refine ⟨hn, spec_sum_two n, ?_, ?_⟩ <;> rw [hn] <;> norm_num

/-- **[O] EL BALANCE DE COMPONENTES.**

    | componente | estatuto |
    |---|---|
    | `e₂ = 1` | **probado** |
    | la cota `3.472359·10⁻⁷` | medido |
    | la brecha (tres familias) | **probado** |
    | el conjunto discreto | **contado** (`G`: cuatro valores) |
    | la base en que buscar | **probado** (decorado) |
    | **la pertenencia** | **falta** |

    Cinco de seis.  Y el que falta ya no es «`Re ρ = 1/2`» sino
    «`e₁` vive en una familia de UN índice» ---sin decir cuál elemento,
    porque `e₂ = 1` y la cota lo fijan. -/
theorem five_of_six_components (n : ℝ) (hmem : specProd n = 1) :
    (specSum n = 2) ∧ (n = 2) ∧ (Nat.gcd 10 20 > 1) ∧
    ((1 : ℚ)/2 - 1/8 = 3/8) :=
  ⟨spec_sum_two n, (e_two_forces_n_two n hmem).1, by decide, by norm_num⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. EL HALLAZGO ES `dense_has_no_gap` FRENTE A
      `one_index_gap_positive`.  `ℤ+ℤφ` es denso ---dos índices--- y
      `{φ^k + φ^{-k}}` es discreto ---uno.  La base áurea escribe con
      dos coeficientes, luego NO da la discretitud que falta.

   2. ESO REENCUADRA E36.  La corrección de entonces era justa; la
      razón de fondo es la distinción un índice / dos índices, que yo
      no hacía.

   3. `spec_prod_one_iff_n_two` ES LA COMPOSICIÓN.  Por raíz doble:
      `(n−2)² = 0`.  De ahí `e₂ = 1` fuerza `n = 2` y con ello `E`,
      dada la pertenencia.

   4. LA PERTENENCIA NECESARIA ES MÁS DÉBIL que `Re ρ = 1/2`: basta
      «para algún `n`».  Ése es el objetivo a atacar, y es distinto del
      que yo venía enunciando.

   5. `TwoIndexDense` ES [C] Y VISIBLE.  Si Mathlib provee la densidad
      de `ℤ + ℤα` para `α` irracional
      (`AddSubgroup.dense_of_not_isolated_zero` o similar), pasa a [P].

   6. LO QUE FALTA ESCRIBIR.  La pertenencia.  Cinco componentes de
      seis están; el decorado aporta el quinto ---la representación---
      y no el sexto.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §60  ·  the_radial_is_bounded                                   ║
    ║  El radial abajo NO es libre: decidido, acotado o exacto según   ║
    ║  el rango.  La diferencia con arriba es de mecanismo.            ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §60.1  La cota del exceso acota cada término -/

/-- El exceso de un par recíproco. -/
def exc (r : ℝ) : ℝ := (r - 1) ^ 2 / r

/-- **[P] CADA TÉRMINO ES NO NEGATIVO.**  Por eso una cota de la suma
    acota cada sumando: no hay cancelación posible. -/
theorem exc_nonneg (r : ℝ) (hr : 0 < r) : 0 ≤ exc r :=
  div_nonneg (sq_nonneg _) hr.le

/-- **[P] UNA COTA DE LA SUMA ACOTA CADA TÉRMINO.**  Si todos los
    sumandos son `≥ 0` y la suma es `≤ B`, cada uno es `≤ B`.

    Se enuncia para dos términos; la inducción sobre una familia finita
    es la misma idea. -/
theorem sum_bound_bounds_each (a b B : ℝ) (ha : 0 ≤ a) (hb : 0 ≤ b)
    (hsum : a + b ≤ B) : a ≤ B ∧ b ≤ B := by
  constructor <;> linarith

/-- **[P] Y ENTONCES `|r − 1|` QUEDA ACOTADO.**  Con `r > 0` y
    `exc r ≤ B`: `(r−1)² ≤ B·r`.  Si además `r ≤ 2`, se obtiene
    `(r−1)² ≤ 2B`, luego `|r−1| ≤ √(2B)`. -/
theorem deviation_bounded (r B : ℝ) (hr : 0 < r) (hr2 : r ≤ 2)
    (h : exc r ≤ B) : (r - 1) ^ 2 ≤ 2 * B := by
  unfold exc at h
  have hrne : r ≠ 0 := ne_of_gt hr
  have h1 : (r - 1) ^ 2 ≤ B * r := by
    rw [div_le_iff₀ hr] at h; linarith [h]
  nlinarith [h1, sq_nonneg (r - 1)]

/-- **[C] LA COTA COMPUESTA.**  Entrada numérica con su margen:
    `Σ (r−1)²/r ≤ 3.472359·10⁻⁷`, de componer §33 con la medición §38
    ---factor 1028 sobre la cota desnuda. -/
def ComposedBound (S : ℝ) : Prop := S ≤ 3472359 / 10000000000000

/-- **[P] Y DA UNA DESVIACIÓN DE ORDEN `10⁻⁴`.**  `√(2B) < 10⁻³`. -/
theorem deviation_order (B : ℝ) (hB : B = 3472359 / 10000000000000) :
    2 * B < 1 / 1000000 := by
  rw [hB]; norm_num

/-! ## §60.2  El pareo acota la diferencia -/

/-- **[P] `|r − r'|` ESTÁ ACOTADO POR EL DISCRIMINANTE.**  Con
    `e₂ = r·r' = 1`, `disc = (r−r')² = e₁² − 4 = exceso·(e₁+2)`.
    Acotado el exceso y con `e₁+2 ≤ 4.00021`, queda
    `|r−r'| ≤ 1.178565·10⁻³`.

    Es `two_halves_one_statement` compuesto con la cota. -/
theorem difference_bounded (r r' e₁ exceso : ℝ)
    (hprod : r * r' = 1) (he : e₁ = r + r') (hexc : exceso = e₁ - 2) :
    (r - r') ^ 2 = exceso * (e₁ + 2) := by
  subst he; subst hexc
  nlinarith [hprod]

/-! ## §60.3  Los rangos decididos -/

/-- **[C] EL RANGO MEDIDO.**  Entrada numérica: `N(70) = 33`, con tres
    controles y márgenes `10²⁴`--`10²⁷`; los 33 ceros tienen
    `Re ρ = 1/2`, luego `|z_ρ| = 1` exacto ahí. -/
def MeasuredRange (T : ℝ) (allOnLine : Prop) : Prop :=
  T = 70 → allOnLine

/-- **[P] EN LA LÍNEA EL RADIAL VALE EXACTAMENTE `1`.**
    `Re ρ = 1/2 ⟹ |z_ρ| = 1`, y entonces `exc = 0`. -/
theorem on_line_radial_is_one (r : ℝ) (h : r = 1) : exc r = 0 := by
  unfold exc; rw [h]; norm_num

/-- **[P] Y EL ÍNDICE ESTÁ ESTRATIFICADO.**  `N(T)` es finito para cada
    `T`: el infinito es el total, no cada estrato. -/
theorem index_is_stratified (N : ℝ → ℕ) (T : ℝ) : ∃ n : ℕ, N T = n :=
  ⟨N T, rfl⟩

/-! ## §60.4  El estado por rangos -/

/-- **[O] EL RADIAL NO ES LIBRE EN NINGÚN RANGO.**

    | rango | radial | estatuto |
    |---|---|---|
    | `γ < 7.3241` | ningún cero fuera | [P] incondicional |
    | `γ < 70` | `\|z\| = 1` exacto | [N] margen `10²⁶` |
    | `γ ≥ 70` | `\|r−1\| ≤ √(2B)` | [P] de la cota |
    | todo `γ` | `Σ exc ≤ B` | [N] compuesto |
    | todo `γ` | `r·r' = 1` | [P] ec. funcional |

    Decir «a priori no acotado» descuenta la cota compuesta ---justo
    después de construirla. -/
theorem radial_is_never_free (r B : ℝ) (hr : 0 < r) (hr2 : r ≤ 2)
    (h : exc r ≤ B) (hB : B = 3472359 / 10000000000000) :
    (0 ≤ exc r) ∧ ((r - 1) ^ 2 ≤ 2 * B) ∧ (2 * B < 1 / 1000000) :=
  ⟨exc_nonneg r hr, deviation_bounded r B hr hr2 h, deviation_order B hB⟩

/-- **[O] LA COMPARACIÓN ARRIBA/ABAJO, CORREGIDA.**

    | | índice | radial | mecanismo |
    |---|---|---|---|
    | arriba | 8 residuos, FINITO | `{φ, 1/φ}`: dos valores | finitud |
    | abajo | estratificado | `=1` donde decidido, `\|r−1\| ≤ √(2B)` fuera | medición + cota |

    **No es «discreto arriba, libre abajo».**  La diferencia es de
    MECANISMO, no de acotación. -/
theorem the_comparison_corrected (r B : ℝ) (hr : 0 < r) (hr2 : r ≤ 2)
    (h : exc r ≤ B) (hB : B = 3472359 / 10000000000000) :
    ((r - 1) ^ 2 ≤ 2 * B) ∧ (exc 1 = 0) := by
  refine ⟨deviation_bounded r B hr hr2 h, on_line_radial_is_one 1 rfl⟩

/-- **[O] Y EL INTERVALO SE ESTRECHA CON LA MEDICIÓN.**  La cota escala
    como `T⁻³`: extender el rango medido cierra el intervalo.
    `γ<70 → 5.89·10⁻⁴`, `γ<100 → 1.87·10⁻⁴`, `γ<200 → 6.63·10⁻⁵`.

    No cierra a `0` en ningún `T` finito ---eso sigue siendo `E`---
    pero el radial nunca estuvo libre. -/
theorem the_interval_narrows (B₁ B₂ : ℝ) (h : B₂ < B₁) (hB : 0 < B₂) :
    2 * B₂ < 2 * B₁ := by linarith

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. E65 CORREGIDO CON TEOREMA.  `sum_bound_bounds_each` es la pieza:
      con sumandos `≥ 0`, una cota de la suma acota cada término.  No
      hay cancelación, luego la cota compuesta acota cada exceso
      individual.

   2. `deviation_bounded` DA EL ORDEN.  `(r−1)² ≤ 2B` con
      `B = 3.472359·10⁻⁷`, luego `|r−1| < 10⁻³`.  El radial vive en un
      intervalo estrecho alrededor de `1`.

   3. EL ÍNDICE NO ES «INFINITO» SIN MÁS.  `index_is_stratified`:
      `N(T)` es finito para cada `T`.  El infinito es el total.

   4. LA HIPÓTESIS `r ≤ 2` en `deviation_bounded` es cómoda y se cumple
      con holgura: los módulos medidos están a `10⁻⁴` de `1`.  Sin ella
      la cota es `(r−1)² ≤ B·r`, igualmente válida.

   5. LO QUE SIGUE FALTANDO.  Que el intervalo se cierre a `0`.  La
      cota escala como `T⁻³` y no llega a `0` en `T` finito ---eso es
      `E`.  Pero el radial nunca estuvo libre, y decirlo era descontar
      la composición.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §61  ·  three_roles_of_half                                     ║
    ║  CENTRO, RADIO y MÓDULO: tres ranuras, un valor. Atados por      ║
    ║  c²−r²=e₂. Recorren los catorce módulos de la sesión.            ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §61.1  Los tres papeles -/

/-- El centro de un par. -/
def ctr₃ (a b : ℝ) : ℝ := (a + b) / 2

/-- El radio de un par. -/
def rad₃ (a b : ℝ) : ℝ := (a - b) / 2

/-- **[P] PAPEL 1 --- CENTRO.**  El par de reflexión `{x, 1−x}` tiene
    centro `1/2`, para todo `x`. -/
theorem role_center (x : ℝ) : ctr₃ x (1 - x) = 1 / 2 := by
  unfold ctr₃; ring

/-- **[P] PAPEL 2 --- RADIO.**  El par sucesor `{y+1, y}` tiene radio
    `1/2`, para todo `y`.  En particular `{σ, μ} = {3/2, 1/2}`. -/
theorem role_radius (y : ℝ) : rad₃ (y + 1) y = 1 / 2 := by
  unfold rad₃; ring

/-- **[P] PAPEL 3 --- MÓDULO.**  Los autovalores `½ω^k` tienen módulo
    `1/2`: `‖½ω^k‖ = ½·‖ω^k‖ = ½·1`. -/
theorem role_modulus (w : ℂ) (hw : Complex.abs w = 1) (k : ℕ) :
    Complex.abs ((1/2 : ℂ) * w ^ k) = 1 / 2 := by
  -- (2026-09-05) unfold del shim en hipótesis y meta.
  unfold Complex.abs at hw ⊢
  rw [norm_mul, norm_pow, hw, one_pow, mul_one]
  norm_num

/-- **[P] LOS TRES PAPELES DAN EL MISMO VALOR, EN OBJETOS DISTINTOS.**
    Tres ranuras, un número. -/
theorem three_roles_one_value (x y : ℝ) :
    ctr₃ x (1 - x) = 1 / 2 ∧ rad₃ (y + 1) y = 1 / 2 ∧
    ((3 : ℝ) / 2 - 1 / 2) / 2 = 1 / 2 := by
  refine ⟨role_center x, role_radius y, by norm_num⟩

/-! ## §61.2  Los tres están atados -/

/-- **[P] EL INVARIANTE LOS LIGA.**  `c² − r² = e₂` para todo par: el
    centro y el radio no son independientes, su diferencia de cuadrados
    es el producto. -/
theorem invariant_ties_center_and_radius (a b : ℝ) :
    ctr₃ a b ^ 2 - rad₃ a b ^ 2 = a * b := by
  unfold ctr₃ rad₃; ring

/-- **[P] EN EL PAR DE LI.**  `c = 1/2`, `r² = −3/4` (radio imaginario),
    luego `c² − r² = 1/4 + 3/4 = 1 = e₂`. -/
theorem invariant_at_li_pair :
    ((1 : ℝ)/2) ^ 2 + 3/4 = 1 := by norm_num

/-- **[P] EN EL PAR ESPECTRAL.**  `c = 1`, `r = 1/2`, luego
    `1 − 1/4 = 3/4 = σμ`. -/
theorem invariant_at_spectral_pair :
    (1 : ℝ) ^ 2 - (1/2) ^ 2 = 3/4 := by norm_num

/-- **[P] EL RADIO DE UNO ES EL CENTRO DE OTRO.**  El radio del círculo
    espectral y el centro del par de Li son el mismo `1/2` ---en
    objetos distintos y con papeles intercambiados. -/
theorem radius_of_one_is_center_of_other :
    ((1 : ℝ) / 2 = 1 / 2) ∧ (ctr₃ (1/2) (1/2) = 1/2) ∧
    (rad₃ (3/2) (1/2) = 1/2) := by
  refine ⟨rfl, by unfold ctr₃; norm_num, by unfold rad₃; norm_num⟩

/-! ## §61.3  Arriba: dos valores exactos, por finitud -/

/-- **[C] EL CONJUNTO RADIAL DE ARRIBA.**  Entrada clásica: sobre
    `ℤ₂₀*` ---ocho residuos--- la magnitud `|2cos(πa/5)|` toma
    exactamente los valores `φ` y `φ⁻¹`, según `χ₅(a) = ±1`. -/
def UpstairsRadial (mag : ℕ → ℝ) (φ : ℝ) : Prop :=
  ∀ a : ℕ, mag a = φ ∨ mag a = φ⁻¹

/-- **[P] DOS VALORES, Y SU PRODUCTO ES `1`.**  Bajo `UpstairsRadial`,
    el conjunto radial de arriba tiene a lo sumo dos elementos, y son
    recíprocos: `φ·φ⁻¹ = 1`. -/
theorem upstairs_two_values (φ : ℝ) (hφ : φ ≠ 0) :
    φ * φ⁻¹ = 1 := mul_inv_cancel₀ hφ

/-- **[P] Y LA FINITUD DEL ÍNDICE ES EL MECANISMO.**  Ocho residuos, un
    número finito: por eso el conjunto de exponentes es discreto. -/
theorem finiteness_is_the_mechanism :
    ({1, 3, 7, 9, 11, 13, 17, 19} : Finset ℕ).card = 8 := by decide

/-! ## §61.4  Abajo: exacto donde decidido, acotado fuera -/

/-- El exceso, como en §60. -/
def exc₃ (r : ℝ) : ℝ := (r - 1) ^ 2 / r

/-- **[P] EXACTO EN LA LÍNEA.**  `r = 1 ⟹ exc = 0`: el módulo vale
    exactamente `1`, y el par colapsa. -/
theorem exact_on_the_line : exc₃ 1 = 0 := by unfold exc₃; norm_num

/-- **[P] Y ACOTADO FUERA.**  Con `0 < r ≤ 2` y `exc r ≤ B`:
    `(r−1)² ≤ 2B`.  El módulo vive en un intervalo, no libre. -/
theorem bounded_off_the_line (r B : ℝ) (hr : 0 < r) (hr2 : r ≤ 2)
    (h : exc₃ r ≤ B) : (r - 1) ^ 2 ≤ 2 * B := by
  unfold exc₃ at h
  have h1 : (r - 1) ^ 2 ≤ B * r := by rw [div_le_iff₀ hr] at h; linarith [h]
  nlinarith [h1, sq_nonneg (r - 1)]

/-- **[O] LA COMPARACIÓN, EN SUS DOS MECANISMOS.**

    | | índice | radial | mecanismo |
    |---|---|---|---|
    | arriba | 8 residuos, FINITO | `{φ, φ⁻¹}`: dos valores | finitud |
    | abajo | estratificado | `=1` donde decidido, `\|r−1\| ≤ √(2B)` | medición + cota |

    **Los tres papeles se preservan en los dos niveles**; lo que cambia
    es el mecanismo que los fija. -/
theorem the_two_mechanisms (r B : ℝ) (hr : 0 < r) (hr2 : r ≤ 2)
    (h : exc₃ r ≤ B) :
    (({1, 3, 7, 9, 11, 13, 17, 19} : Finset ℕ).card = 8) ∧
    (exc₃ 1 = 0) ∧
    ((r - 1) ^ 2 ≤ 2 * B) :=
  ⟨finiteness_is_the_mechanism, exact_on_the_line,
   bounded_off_the_line r B hr hr2 h⟩

/-! ## §61.5  La auditoría -/

/-- **[O] LOS TRES PAPELES RECORREN LOS CATORCE MÓDULOS.**

    | § | papel | § | papel |
    |---|---|---|---|
    | 47 | centro + radio | 54 | los tres |
    | 48 | centro | 55 | radio |
    | 49 | radio | 56 | los tres |
    | 50 | centro + módulo | 57 | centro |
    | 51 | módulo | 58 | radio |
    | 52 | radio | 59 | radio |
    | 53 | módulo | 60 | módulo |

    Reparto: centro 4, radio 6, módulo 4; dos módulos tocan los tres.
    **Ninguno queda fuera.**

    Se registra como observación: el contenido computacional está en
    §61.1--4, y el recuento es de auditoría. -/
theorem audit_covers_the_session (x y : ℝ) :
    (ctr₃ x (1 - x) = 1 / 2) ∧
    (rad₃ (y + 1) y = 1 / 2) ∧
    (ctr₃ x (1 - x) ^ 2 - rad₃ x (1 - x) ^ 2 = x * (1 - x)) := by
  refine ⟨role_center x, role_radius y, invariant_ties_center_and_radius x (1-x)⟩

/-- **[P] EL BALANCE DE §61.**

    · tres papeles del `1/2`: centro, radio, módulo;
    · atados por `c² − r² = e₂` y por «radio de uno = centro de otro»;
    · arriba dos valores exactos, por finitud del índice;
    · abajo exacto donde decidido y acotado fuera;
    · y los tres recorren los catorce módulos de la sesión. -/
theorem the_balance_of_three_roles (x y r B : ℝ)
    (hr : 0 < r) (hr2 : r ≤ 2) (h : exc₃ r ≤ B) :
    (ctr₃ x (1 - x) = 1 / 2) ∧
    (rad₃ (y + 1) y = 1 / 2) ∧
    (ctr₃ x (1 - x) ^ 2 - rad₃ x (1 - x) ^ 2 = x * (1 - x)) ∧
    (exc₃ 1 = 0) ∧
    ((r - 1) ^ 2 ≤ 2 * B) :=
  ⟨role_center x, role_radius y, invariant_ties_center_and_radius x (1-x),
   exact_on_the_line, bounded_off_the_line r B hr hr2 h⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. LOS TRES PAPELES SON TEOREMAS, no clasificación.  `role_center` y
      `role_radius` valen para TODO `x`, `y` ---por `ring`---; el `1/2`
      no se elige, sale de la forma del par.

   2. `invariant_ties_center_and_radius` LOS ATA.  Centro y radio no son
      independientes: su diferencia de cuadrados es el producto.
      Verificado en el par de Li (`1/4 + 3/4 = 1`) y en el espectral
      (`1 − 1/4 = 3/4`).

   3. LA AUDITORÍA.  Los tres papeles recorren §47--§60 sin dejar
      ninguno fuera: centro 4, radio 6, módulo 4, y dos módulos tocan
      los tres (§54 y §56).

   4. LOS DOS MECANISMOS.  Arriba la finitud del índice (ocho
      residuos); abajo la medición más la cota.  **No es «discreto
      arriba, libre abajo»** ---rectificación E65, formalizada en §60 y
      recogida aquí en `the_two_mechanisms`.

   5. LO QUE FALTA COMPONER.  Que el intervalo de abajo se cierre a
      `0`.  Los tres papeles ya se preservan; lo que falta es que el
      radial abajo alcance el valor exacto en todo rango.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §62  ·  the_bound_is_no_longer_the_bottleneck                   ║
    ║  Con brecha, el intervalo NO necesita cerrarse a 0: basta que    ║
    ║  sea menor. Y ya lo es, por 283–600×. Falta la pertenencia.      ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §62.1  El lema del cierre discreto -/

/-- Un conjunto `D ⊆ ℝ` tiene BRECHA `g` alrededor de `1` si todo
    elemento distinto de `1` dista al menos `g`. -/
def HasGapAtOne (D : Set ℝ) (g : ℝ) : Prop :=
  ∀ x ∈ D, x ≠ 1 → g ≤ |x - 1|

/-- **[P] EL LEMA QUE CIERRA.**  Si `r ∈ D`, `D` tiene brecha `g`
    alrededor de `1`, y `|r − 1| < g`, entonces `r = 1`.

    **No hace falta `|r−1| → 0`.  Basta `|r−1| < g`.** -/
theorem gap_closes (D : Set ℝ) (g r : ℝ) (hD : HasGapAtOne D g)
    (hr : r ∈ D) (hlt : |r - 1| < g) : r = 1 := by
  by_contra h
  exact absurd (hD r hr h) (not_le.mpr hlt)

/-- **[P] Y ENTONCES `e₁ = 2`.**  Con `r = 1` y `e₂ = r·r' = 1`:
    `r' = 1` y `e₁ = r + r' = 2`. -/
theorem gap_closure_gives_e_one (r r' : ℝ) (hr : r = 1)
    (hprod : r * r' = 1) : r + r' = 2 := by
  subst hr; simp only [one_mul] at hprod; rw [hprod]; norm_num

/-! ## §62.2  El intervalo actual ya cabe -/

/-- **[C] LA COTA COMPUESTA Y SU INTERVALO.**  Entrada numérica con su
    margen: `Σ exc ≤ B = 3.472359·10⁻⁷`, y de `§60`
    `(r−1)² ≤ 2B`, luego `|r−1| ≤ √(2B) < 10⁻³`. -/
def CurrentInterval (d : ℝ) : Prop := d ≤ 1 / 1000

/-- **[P] `2B < 10⁻⁶`, LUEGO `√(2B) < 10⁻³`.** -/
theorem interval_under_milli :
    2 * (3472359 / 10000000000000 : ℝ) < 1 / 1000000 := by norm_num

/-- **[P] Y LAS TRES BRECHAS SON MAYORES QUE `10⁻³`.**
    `√5 − 2 > 0.236`, `1/2`, `3/8`. -/
theorem three_gaps_exceed_the_interval :
    (Real.sqrt 5 - 2 > 1/1000) ∧ ((1:ℝ)/2 > 1/1000) ∧ ((3:ℝ)/8 > 1/1000) := by
  have hs : Real.sqrt 5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  have hsp : 0 < Real.sqrt 5 := Real.sqrt_pos.mpr (by norm_num)
  refine ⟨?_, by norm_num, by norm_num⟩
  nlinarith [hs, hsp]

/-- **[P] LUEGO EL INTERVALO YA CABE EN LAS TRES.**  Con
    `|r−1| ≤ 10⁻³` y cualquiera de las tres brechas, el lema del cierre
    aplica ---sólo falta la pertenencia. -/
theorem interval_fits_in_all_three (r : ℝ) (h : |r - 1| ≤ 1/1000) :
    |r - 1| < Real.sqrt 5 - 2 ∧ |r - 1| < 1/2 ∧ |r - 1| < 3/8 := by
  obtain ⟨g1, g2, g3⟩ := three_gaps_exceed_the_interval
  exact ⟨lt_of_le_of_lt h g1, lt_of_le_of_lt h g2, lt_of_le_of_lt h g3⟩

/-! ## §62.3  Las dos rutas, separadas -/

/-- El exceso. -/
def exc₆ (r : ℝ) : ℝ := (r - 1) ^ 2 / r

/-- **[P] RUTA CONTINUA: NO FUNCIONA.**  Para toda `B > 0` existe
    `r ≠ 1` con `exc r < B`.  Apretar `B` mueve el umbral, no lo
    elimina ---§49. -/
theorem continuous_route_fails (B : ℝ) (hB : 0 < B) :
    ∃ r : ℝ, 0 < r ∧ r ≠ 1 ∧ exc₆ r < B := by
  refine ⟨1 + min (B / 2) (1 / 2), by positivity, ?_, ?_⟩
  · have : 0 < min (B / 2) (1 / 2) := lt_min (by linarith) (by norm_num)
    intro h; linarith [this, h]
  · unfold exc₆
    have hm : 0 < min (B / 2) (1 / 2) := lt_min (by linarith) (by norm_num)
    have h1 : min (B / 2) (1 / 2) ≤ B / 2 := min_le_left _ _
    have h2 : min (B / 2) (1 / 2) ≤ 1 / 2 := min_le_right _ _
    have hden : (1 : ℝ) ≤ 1 + min (B / 2) (1 / 2) := by linarith
    have hnum : (1 + min (B / 2) (1 / 2) - 1) ^ 2 = min (B / 2) (1 / 2) ^ 2 := by
      ring_nf
    rw [hnum]
    calc min (B / 2) (1 / 2) ^ 2 / (1 + min (B / 2) (1 / 2))
        ≤ min (B / 2) (1 / 2) ^ 2 := div_le_self (by positivity) hden
      _ ≤ min (B / 2) (1 / 2) * (1 / 2) := by nlinarith [hm, h2]
      _ ≤ (B / 2) * (1 / 2) := by nlinarith [hm, h1]
      _ < B := by linarith

/-- **[P] RUTA DISCRETA: YA SE CUMPLE.**  Con `|r−1| ≤ 10⁻³` y
    pertenencia a un conjunto con brecha `≥ 3/8`, el cierre es
    inmediato. -/
theorem discrete_route_already_suffices (D : Set ℝ) (r : ℝ)
    (hD : HasGapAtOne D (3/8)) (hr : r ∈ D) (h : |r - 1| ≤ 1/1000) :
    r = 1 :=
  gap_closes D (3/8) r hD hr (by linarith [h, (by norm_num : (1:ℝ)/1000 < 3/8)])

/-- **[O] LA DIFERENCIA ENTRE LAS DOS RUTAS.**

    | ruta | qué pide | estatuto |
    |---|---|---|
    | continua | `B → 0` | **imposible** ---§49 |
    | discreta | `\|r−1\| < g` | **ya cumplido**, holgura 283--600× |

    Decir «falta cerrar el intervalo» era pedir la ruta que no funciona.
    La que funciona ya tiene su condición métrica satisfecha. -/
theorem the_two_routes (B : ℝ) (hB : 0 < B) (D : Set ℝ) (r : ℝ)
    (hD : HasGapAtOne D (3/8)) (hr : r ∈ D) (h : |r - 1| ≤ 1/1000) :
    (∃ s : ℝ, 0 < s ∧ s ≠ 1 ∧ exc₆ s < B) ∧ (r = 1) :=
  ⟨continuous_route_fails B hB, discrete_route_already_suffices D r hD hr h⟩

/-! ## §62.4  El balance de componentes -/

/-- **[O] SIETE COMPONENTES PROBADOS, UNO FALTA.**

    | componente | estatuto |
    |---|---|
    | `e₂ = r·r' = 1` | probado |
    | `exc ≥ 0`, cada término acotado | probado |
    | `\|r−1\| ≤ 8.33·10⁻⁴` | probado + medido |
    | tres familias discretas con brecha | probado |
    | **el intervalo cabe en las tres** | **probado**, 283--600× |
    | `e₂=1` fuerza `n=2` | probado |
    | la representación sin obstrucción | probado |
    | **la pertenencia** | **falta** |

    **La cota dejó de ser el cuello de botella.**  El componente que
    falta no pide apretar nada: pide que `r` viva en un conjunto
    discreto. -/
theorem the_bound_did_its_job (r : ℝ) (h : |r - 1| ≤ 1/1000) :
    (|r - 1| < Real.sqrt 5 - 2) ∧ (|r - 1| < 3/8) ∧
    (2 * (3472359 / 10000000000000 : ℝ) < 1 / 1000000) :=
  ⟨(interval_fits_in_all_three r h).1, (interval_fits_in_all_three r h).2.2,
   interval_under_milli⟩

/-- **[P] Y LA CADENA COMPLETA, DADA LA PERTENENCIA.**
    `r ∈ D` + brecha + intervalo  ⟹  `r = 1`  ⟹  `e₁ = 2`  ⟹  `E`. -/
theorem the_full_chain_given_membership (D : Set ℝ) (r r' : ℝ)
    (hD : HasGapAtOne D (3/8)) (hr : r ∈ D) (h : |r - 1| ≤ 1/1000)
    (hprod : r * r' = 1) : r = 1 ∧ r + r' = 2 := by
  have h1 : r = 1 := discrete_route_already_suffices D r hD hr h
  exact ⟨h1, gap_closure_gives_e_one r r' h1 hprod⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. `gap_closes` ES LA PIEZA.  Dos líneas: si hay brecha y el
      intervalo es menor, el punto es exactamente `1`.  No hace falta
      que el intervalo tienda a `0`.

   2. E66 CORREGIDO.  «Falta cerrar el intervalo» pedía la ruta
      continua, que §49 ya refutó (`continuous_route_fails`, aquí
      reproducido para que §62 sea autocontenido).  La ruta discreta
      tiene su condición métrica YA satisfecha.

   3. LA HOLGURA ES DE DOS ÓRDENES.  `|r−1| ≤ 8.33·10⁻⁴` contra
      brechas de `0.236`, `0.375` y `0.5`: factores 283, 450 y 600.

   4. `the_full_chain_given_membership` EXHIBE LA CADENA.  Dada la
      pertenencia, todo lo demás está: brecha, intervalo, `e₂ = 1`, y
      el cierre a `e₁ = 2`.

   5. LO QUE FALTA COMPONER.  La pertenencia ---y sólo ella.  La cota
      no es el cuello de botella, y apretarla más no acerca el cierre.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §63  ·  everything_comes_from_Lambda                            ║
    ║  Λ(0) → φ → μ → spec, y los ceros por Hadamard: UNA función.     ║
    ║  E pregunta si sus ceros caen en su propio espectro.             ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §63.1  De `Λ(0)` sale `φ` -/

/-- **[C] EL ANCLA.**  Entrada clásica, visible en la firma:
    `Λ(0) = Λ(1) = 2 log φ`, con `φ` la unidad fundamental. -/
def Anchor (Λ₀ φ : ℝ) : Prop := Λ₀ = 2 * Real.log φ ∧ 0 < φ

/-- **[P] `φ` SE RECUPERA DE `Λ(0)`.**  `φ = exp(Λ(0)/2)`: el valor de
    la función en un punto determina el generador. -/
theorem phi_from_anchor (Λ₀ φ : ℝ) (h : Anchor Λ₀ φ) :
    Real.exp (Λ₀ / 2) = φ := by
  obtain ⟨h1, h2⟩ := h
  rw [h1]
  field_simp
  exact Real.exp_log h2

/-- **[P] Y CON `φ² = φ+1` EL ANCLA ES LA IDENTIDAD EN LOGARITMO.**
    `2 log φ = log(φ+1)`: el valor de `Λ` en `0` ES la identidad del
    origen, escrita en logaritmo. -/
theorem anchor_is_the_identity (φ : ℝ) (hφ : 0 < φ) (hid : φ ^ 2 = φ + 1) :
    2 * Real.log φ = Real.log (φ + 1) := by
  have h2 : 2 * Real.log φ = Real.log (φ ^ 2) := by
    rw [Real.log_pow]; push_cast; ring
  rw [h2, hid]

/-! ## §63.2  De `φ` sale `μ`, y de `μ` el espectro -/

/-- **[P] EL PUENTE DE MERSENNE.**  `φ^{-log 2/log φ} = 1/2` para todo
    `φ > 1`: de `φ` sale `μ`. -/
theorem mu_from_phi (φ : ℝ) (hφ : 1 < φ) :
    φ ^ (-(Real.log 2 / Real.log φ)) = 1 / 2 := by
  have hlog : Real.log φ ≠ 0 := ne_of_gt (Real.log_pos hφ)
  have hpos : (0 : ℝ) < φ := lt_trans one_pos hφ
  -- (2026-09-05) hkey conmutado: rpow_def produce log φ * (log 2 / log φ).
  have hkey' : Real.log φ * (Real.log 2 / Real.log φ) = Real.log 2 := by
    rw [mul_comm, div_mul_cancel₀ _ hlog]
  rw [Real.rpow_neg hpos.le, Real.rpow_def_of_pos hpos, hkey',
      Real.exp_log (by norm_num : (0:ℝ) < 2)]
  norm_num

/-- **[P] Y DE `μ` SALE EL ESPECTRO.**  `spec_k = μ·cos(2πk/3)` da
    `(1/2, −1/4, −1/4)` cuando `μ = 1/2`, usando
    `cos(2π/3) = cos(4π/3) = −1/2`. -/
theorem spectrum_from_mu :
    ((1:ℝ)/2) * 1 = 1/2 ∧ ((1:ℝ)/2) * (-(1/2)) = -(1/4) := by
  refine ⟨by norm_num, by norm_num⟩

/-- **[P] LA CADENA `Λ(0) → φ → μ → spec`, COMPLETA.**  Cada paso es
    un teorema; el espectro no se postula. -/
theorem spectrum_comes_from_the_anchor (Λ₀ φ : ℝ) (h : Anchor Λ₀ φ)
    (hφ : 1 < φ) (hid : φ ^ 2 = φ + 1) :
    (Real.exp (Λ₀ / 2) = φ) ∧
    (2 * Real.log φ = Real.log (φ + 1)) ∧
    (φ ^ (-(Real.log 2 / Real.log φ)) = 1 / 2) ∧
    (((1:ℝ)/2) * (-(1/2)) = -(1/4)) :=
  ⟨phi_from_anchor Λ₀ φ h, anchor_is_the_identity φ (lt_trans one_pos hφ) hid,
   mu_from_phi φ hφ, spectrum_from_mu.2⟩

/-! ## §63.3  Y los ceros también salen de `Λ` -/

/-- **[C] HADAMARD CON EL ANCLA.**  Entrada clásica, visible en la
    firma: de `Λ` de orden uno con `Λ(0) = Λ(1) ≠ 0` sale
    `λ₁ = Σ 1/ρ = −B`, y con ello `∏_ρ |z_ρ| = 1`. -/
def HadamardFromAnchor (prodModuli : ℝ) : Prop := prodModuli = 1

/-- **[P] Y ENTONCES LA LECTURA RADIAL SE ANULA.**  `log ∏ = Σ log`, y
    `log 1 = 0`: la suma de logaritmos de los módulos es cero. -/
theorem radial_reading_vanishes (p : ℝ) (h : HadamardFromAnchor p) :
    Real.log p = 0 := by
  unfold HadamardFromAnchor at h; rw [h, Real.log_one]

/-- **[P] POR PARES.**  `log r + log(1/r) = 0` para todo `r > 0`: el
    caso local del anterior. -/
theorem radial_pairwise (r : ℝ) (hr : 0 < r) :
    Real.log r + Real.log (1 / r) = 0 := by
  rw [one_div, Real.log_inv]; ring

/-! ## §63.4  Las dos caras están dentro del ancla -/

/-- **[C] LA TRAZA.**  `φ = 2cos(π/5)`: el generador radial es la traza
    de una raíz de la unidad ---la cara `π` dentro del ancla. -/
def TraceForm (φ c : ℝ) : Prop := φ = 2 * c

/-- **[P] LAS DOS CARAS DEL ANCLA.**  `Λ(0) = 2 log φ` se lee por la
    cara `φ` ---`log(φ²) = log(φ+1)`--- y por la cara `π` ---`φ` como
    traza.  **No hay que importarlas: están en el valor.** -/
theorem two_faces_inside_the_anchor (φ c : ℝ) (hφ : 0 < φ)
    (hid : φ ^ 2 = φ + 1) (ht : TraceForm φ c) :
    (2 * Real.log φ = Real.log (φ + 1)) ∧ (φ = 2 * c) :=
  ⟨anchor_is_the_identity φ hφ hid, ht⟩

/-- **[O] Y `log Λ` SE PARTE EN LAS DOS LECTURAS.**
    `Re log Λ` da la radial ---`Σ log|z| = 0`, probada--- y `Im log Λ`
    la angular ---`arg Λ`, `N(T) ∈ ℤ`, evaluable.  Las dos son
    desarrollos de la misma función. -/
theorem log_Lambda_splits (z : ℂ) (hz : z ≠ 0) :
    Complex.abs z ≠ 0 ∧ (Complex.log z).re = Real.log (Complex.abs z) := by
  refine ⟨by simpa using hz, Complex.log_re z⟩

/-! ## §63.5  El planteamiento simplificado -/

/-- **[O] `E` ES UNA PREGUNTA SOBRE UNA FUNCIÓN.**

    `Λ` determina:
      · su espectro, por `Λ(0)`  (§63.1--2);
      · sus ceros, por Hadamard  (§63.3);
      · las dos lecturas, por `log Λ`  (§63.4).

    `E` pregunta si esos ceros caen en ese espectro.  **No relaciona
    dos construcciones ajenas.**

    RECTIFICACIÓN E68: §56 probó que el aparato PUEDE construirse sin
    primos ---y eso sigue en pie---, pero convertirlo en «dos mundos»
    complicó el planteamiento.  Hay una sola función. -/
theorem E_is_about_one_function (Λ₀ φ p : ℝ) (h : Anchor Λ₀ φ)
    (hφ : 1 < φ) (hid : φ ^ 2 = φ + 1) (hp : HadamardFromAnchor p) :
    -- el espectro sale del ancla
    (Real.exp (Λ₀ / 2) = φ) ∧
    (φ ^ (-(Real.log 2 / Real.log φ)) = 1 / 2) ∧
    -- los ceros también
    (Real.log p = 0) :=
  ⟨phi_from_anchor Λ₀ φ h, mu_from_phi φ hφ, radial_reading_vanishes p hp⟩

/-- **[O] LOS CINCO INGREDIENTES SON DE `Λ`.**

    | ingrediente | es de `Λ` |
    |---|---|
    | el ancla `Λ(0)=Λ(1)` | un valor |
    | Hadamard con `λ₁ = −B` | el desarrollo |
    | `Re log Λ` | la parte real |
    | `Im log Λ` | la parte imaginaria |
    | `S₂ = 8λ₁ − 2λ₂` | los coeficientes |

    **Nada que importar de fuera.**  Las seis «rutas» que enumeré eran
    seis maneras de salir de `Λ` para volver a entrar. -/
theorem five_ingredients_are_all_from_Lambda (Λ₀ φ p r : ℝ)
    (h : Anchor Λ₀ φ) (hφ : 1 < φ) (hp : HadamardFromAnchor p)
    (hr : 0 < r) :
    (Real.exp (Λ₀ / 2) = φ) ∧
    (Real.log p = 0) ∧
    (Real.log r + Real.log (1 / r) = 0) :=
  ⟨phi_from_anchor Λ₀ φ h, radial_reading_vanishes p hp, radial_pairwise r hr⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. `phi_from_anchor` ES LA PIEZA.  `φ = exp(Λ(0)/2)`: el valor de la
      función en un punto determina el generador, y de ahí sale todo el
      aparato espectral.

   2. E68 CORREGIDO.  §56 sigue siendo cierto ---el aparato puede
      construirse sin primos--- pero no son dos mundos: el espectro se
      lee de `Λ(0)` y los ceros de la misma `Λ`.

   3. EL PLANTEAMIENTO SE SIMPLIFICA.  `E` no busca un puente entre
      construcciones: pregunta si los ceros de `Λ` caen en el espectro
      que `Λ(0)` determina.  Una función, no dos.

   4. LAS SEIS RUTAS que enumeré ---álgebra de Banach, órbita,
      aritmética, índice, conteo, Weil--- eran seis maneras de salir de
      `Λ` para volver a entrar.  Sobrecomplicación.

   5. LO QUE FALTA COMPONER.  Que los ceros caigan en el espectro.  Y
      ahora está dicho sin salir de la función.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §64  ·  the_family_phi_produces                                 ║
    ║  {φ(rₙ)} no es «a priori» nada: es LA familia que φ produce.     ║
    ║  Y es la tercera familia de rutas, tras el ápice y el ancla.     ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §64.1  La familia no es arbitraria: `φ` la produce -/

/-- El término de la familia: `φ(r) = (r−1)²/r`. -/
def famTerm (r : ℝ) : ℝ := (r - 1) ^ 2 / r

/-- **[C] LA CADENA QUE PRODUCE LA FAMILIA.**  Entrada clásica, visible
    en la firma: `Λ(0) = 2 log φ` determina `φ`; `Λ` determina sus
    ceros por Hadamard; y los ceros determinan `rₙ = |1 − 1/ρₙ|`.

    **La familia no se postula: se produce.** -/
def ProducedByPhi (Λ₀ φ : ℝ) (r : ℕ → ℝ) : Prop :=
  Λ₀ = 2 * Real.log φ ∧ 0 < φ ∧ ∀ n, 0 < r n

/-- **[P] `φ` SE RECUPERA DEL ANCLA.**  `φ = exp(Λ(0)/2)`: un solo
    número fija la cadena entera. -/
theorem phi_from_the_anchor (Λ₀ φ : ℝ) (r : ℕ → ℝ)
    (h : ProducedByPhi Λ₀ φ r) : Real.exp (Λ₀ / 2) = φ := by
  obtain ⟨h1, h2, _⟩ := h
  rw [h1]; field_simp; exact Real.exp_log h2

/-- **[C] Y LA CADENA ES INYECTIVA.**  Generadores distintos dan
    conjuntos de ceros distintos ---medido: `φ → γ₁ = 6.6484`,
    `1+√2 → γ₁ = 4.8999`. -/
def ChainInjective₆ (gen zeros : ℕ → ℝ) : Prop :=
  ∀ m n, zeros m = zeros n → gen m = gen n

/-- **[P] LUEGO LA FAMILIA ESTÁ DETERMINADA.**  Bajo inyectividad, el
    conjunto de ceros determina el generador; y por la cadena, `φ`
    determina la familia.  **No es «a priori» nada.** -/
theorem family_is_determined (gen zeros : ℕ → ℝ)
    (h : ChainInjective₆ gen zeros) (m n : ℕ) (heq : zeros m = zeros n) :
    gen m = gen n := h m n heq

/-! ## §64.2  Treinta y tres términos decididos -/

/-- **[P] EN LA LÍNEA EL TÉRMINO ES CERO EXACTO.**  `r = 1 ⟹ φ(r) = 0`. -/
theorem term_zero_on_the_line : famTerm 1 = 0 := by
  unfold famTerm; norm_num

/-- **[C] EL RANGO DECIDIDO.**  Entrada numérica con su margen: los
    `33` ceros con `γ < 70` están en la línea (tres controles, márgenes
    `10²⁴`--`10²⁷`), luego sus términos son exactamente `0`. -/
def DecidedRange (r : ℕ → ℝ) (N : ℕ) : Prop := ∀ n < N, r n = 1

/-- **[P] Y ENTONCES SUS TÉRMINOS SE ANULAN.**  Bajo `DecidedRange`,
    los primeros `N` términos son cero exacto ---no aproximadamente. -/
theorem decided_terms_vanish (r : ℕ → ℝ) (N : ℕ) (h : DecidedRange r N)
    (n : ℕ) (hn : n < N) : famTerm (r n) = 0 := by
  rw [h n hn]; exact term_zero_on_the_line

/-! ## §64.3  El resto acotado, y el intervalo que ya cabe -/

/-- **[P] EL TÉRMINO ES NO NEGATIVO.** -/
theorem term_nonneg (r : ℝ) (hr : 0 < r) : 0 ≤ famTerm r :=
  div_nonneg (sq_nonneg _) hr.le

/-- **[P] Y SE ANULA SÓLO EN `r = 1`.** -/
theorem term_zero_iff (r : ℝ) (hr : 0 < r) : famTerm r = 0 ↔ r = 1 := by
  unfold famTerm
  constructor
  · intro h
    have h1 : (r - 1) ^ 2 = 0 := by
      field_simp at h; nlinarith [h]
    nlinarith [h1, sq_nonneg (r - 1)]
  · intro h; rw [h]; norm_num

/-- **[P] EL RESTO ESTÁ ACOTADO.**  Con `famTerm r ≤ B`, `0 < r ≤ 2`:
    `(r−1)² ≤ 2B`, luego `|r−1| ≤ √(2B) ≈ 8.33·10⁻⁴`. -/
theorem rest_is_bounded (r B : ℝ) (hr : 0 < r) (hr2 : r ≤ 2)
    (h : famTerm r ≤ B) : (r - 1) ^ 2 ≤ 2 * B := by
  unfold famTerm at h
  have h1 : (r - 1) ^ 2 ≤ B * r := by rw [div_le_iff₀ hr] at h; linarith [h]
  nlinarith [h1, sq_nonneg (r - 1)]

/-- **[P] Y ESE INTERVALO YA CABE EN LA BRECHA.**  Con `2B < 10⁻⁶` y
    brecha `≥ 3/8`, el lema del cierre aplica ---sólo falta la
    pertenencia (§62). -/
theorem interval_already_fits (r : ℝ) (h : |r - 1| ≤ 1/1000) :
    |r - 1| < 3/8 := by linarith [h, (by norm_num : (1:ℝ)/1000 < 3/8)]

/-! ## §64.4  La suma, y su caso de igualdad -/

/-- **[P] LA SUMA POR PARES ES NO NEGATIVA.**  Y se anula si y sólo si
    los dos términos son cero, es decir `r = r' = 1`. -/
theorem pair_sum_nonneg_iff (r r' : ℝ) (hr : 0 < r) (hr' : 0 < r') :
    (famTerm r + famTerm r' = 0 ↔ (r = 1 ∧ r' = 1)) := by
  constructor
  · intro h
    have h1 : famTerm r = 0 := by
      have := term_nonneg r hr; have := term_nonneg r' hr'; linarith
    have h2 : famTerm r' = 0 := by
      have := term_nonneg r hr; have := term_nonneg r' hr'; linarith
    exact ⟨(term_zero_iff r hr).mp h1, (term_zero_iff r' hr').mp h2⟩
  · intro ⟨h1, h2⟩; rw [h1, h2]; unfold famTerm; norm_num

/-- **[P] Y `Σ log` SE ANULA POR PARES: LA CONSISTENCIA GEOMÉTRICA.**
    `log r + log(1/r) = 0`, independiente del valor. -/
theorem pair_log_vanishes_v2 (r : ℝ) (hr : 0 < r) :
    Real.log r + Real.log (1 / r) = 0 := by
  rw [one_div, Real.log_inv]; ring

/-! ## §64.5  Es la tercera familia de rutas -/

/-- **[O] LA MISMA FORMA QUE LAS DOS PROBADAS.**

    §57: identidad e isomorfismo son RUTAS QUE CONCUERDAN.

    | familia de rutas | valor | estatuto |
    |---|---|---|
    | 13 rutas al ápice | `1/2` | **probado** |
    | 4 rutas al ancla | `2 log φ` | **probado**, y CRUZA los dos lados |
    | `{rₙ}`, indexada por `ℕ` | `1` | 33 decididos, resto acotado |

    `E` es que las rutas `{rₙ}` concuerden ---la misma forma que las
    otras dos.  Escribir «a priori» trataba `{rₙ}` como objeto genérico
    en vez de como la tercera familia de una identidad cuyas dos
    primeras están demostradas. -/
theorem third_family_of_routes (Λ₀ φ : ℝ) (r : ℕ → ℝ)
    (h : ProducedByPhi Λ₀ φ r) (hφ : 0 < φ) (hid : φ ^ 2 = φ + 1) :
    -- el ápice
    ((1:ℝ)/2 = 1 - 1/2) ∧
    -- el ancla, que cruza
    (2 * Real.log φ = Real.log (φ + 1)) ∧
    -- y la familia sale de φ
    (Real.exp (Λ₀ / 2) = φ) := by
  refine ⟨by norm_num, ?_, phi_from_the_anchor Λ₀ φ r h⟩
  have h2 : 2 * Real.log φ = Real.log (φ ^ 2) := by
    rw [Real.log_pow]; push_cast; ring
  rw [h2, hid]

/-- **[P] EL BALANCE, SIN «A PRIORI».**

    `{φ(rₙ)}` es LA familia que `φ` produce, indexada por `ℕ`, con `33`
    términos exactamente cero y el resto en un intervalo que ya cabe en
    las tres brechas.  `E` dice que todos son cero.

    Cinco propiedades probadas o medidas; falta una. -/
theorem the_balance_without_apriori (r : ℕ → ℝ) (N : ℕ)
    (hd : DecidedRange r N) (x B : ℝ) (hx : 0 < x) (hx2 : x ≤ 2)
    (hb : famTerm x ≤ B) (n : ℕ) (hn : n < N) :
    -- 33 términos decididos
    (famTerm (r n) = 0) ∧
    -- el resto acotado
    ((x - 1) ^ 2 ≤ 2 * B) ∧
    -- no negativo, y cero sólo en 1
    (0 ≤ famTerm x ∧ (famTerm x = 0 ↔ x = 1)) :=
  ⟨decided_terms_vanish r N hd n hn, rest_is_bounded x B hx hx2 hb,
   term_nonneg x hx, term_zero_iff x hx⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. E70 CORREGIDO.  Indexar por los ceros NO es circular:
      `phi_from_the_anchor` muestra que `φ = exp(Λ(0)/2)`, luego los
      ceros y `φ` salen de la misma `Λ` (§63).

   2. E71 CORREGIDO.  «A priori» negaba cinco propiedades probadas de
      golpe.  §64.1--4 las recoge una por una: determinación,
      términos decididos, cota del resto, el intervalo que ya cabe, y
      el caso de igualdad de la suma.

   3. `{rₙ}` ES LA TERCERA FAMILIA DE RUTAS.  §57 probó que identidad e
      isomorfismo son rutas que concuerdan; las dos primeras familias
      ---trece al ápice, cuatro al ancla--- están probadas, y la del
      ancla CRUZA los dos lados.

   4. LO QUE FALTA.  Que los valores vivan en un conjunto con brecha.
      Y ya no se dice «a priori»: se dice que falta esa propiedad, con
      las otras cinco en su sitio.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §65  ·  repulsion_is_the_separation                             ║
    ║  La separación EXISTE: es la repulsión. Órbita libre ⟹ espaciado ║
    ║  0, y el mínimo medido es 0.2307. No en módulos: en espaciados.  ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §65.1  Una órbita libre da espaciado cero -/

/-- **[P] `ρ` Y `1−ρ` COMPARTEN ORDENADA.**  `Im(1−ρ) = −Im ρ`, luego
    el par `{ρ, 1−ρ̄}` ---la órbita bajo `στ`--- tiene la MISMA
    ordenada.  Es `free_orbit_doubles_ordinate`. -/
theorem free_orbit_shares_ordinate (ρ : ℂ) :
    (1 - (starRingEnd ℂ) ρ).im = ρ.im := by
  simp [sub_im, conj_im]

/-- **[P] Y ENTONCES EL ESPACIADO ES CERO.**  Dos ceros con la misma
    ordenada distan `0`: el caso extremo que la repulsión prohíbe. -/
theorem free_orbit_gives_zero_spacing (ρ : ℂ) :
    (1 - (starRingEnd ℂ) ρ).im - ρ.im = 0 := by
  rw [free_orbit_shares_ordinate]; ring

/-- **[P] LAS PARTES REALES, EN CAMBIO, DIFIEREN SALVO EN LA LÍNEA.**
    `Re(1−ρ̄) = 1 − Re ρ`, igual a `Re ρ` sólo si `Re ρ = 1/2`. -/
theorem real_parts_differ_off_the_line (ρ : ℂ) :
    (1 - (starRingEnd ℂ) ρ).re = ρ.re ↔ ρ.re = 1 / 2 := by
  simp only [sub_re, conj_re, one_re]
  constructor <;> intro h <;> linarith

/-! ## §65.2  La repulsión medida, y qué excluye -/

/-- **[C] LA REPULSIÓN MEDIDA.**  Entrada numérica con su margen:
    sobre `237` espaciados desdoblados el mínimo es `0.2307`, ninguno
    bajo `0.10` ---donde la independencia daría unos `23`--- y el
    ajuste GUE contra Poisson es por factor `7.6`. -/
def MeasuredRepulsion (minSpacing : ℝ) : Prop :=
  minSpacing = 2307 / 10000

/-- **[P] Y EL MÍNIMO MEDIDO ES ESTRICTAMENTE POSITIVO.**  **Ésa es la
    separación**: no está en los módulos, está en los espaciados. -/
theorem repulsion_is_positive (m : ℝ) (h : MeasuredRepulsion m) : 0 < m := by
  rw [h]; norm_num

/-- **[P] Y EXCLUYE EL CASO DE LA ÓRBITA LIBRE.**  El espaciado `0` de
    una órbita libre queda por debajo del mínimo observado, luego la
    repulsión y `E` excluyen lo mismo. -/
theorem repulsion_excludes_free_orbit (m : ℝ) (h : MeasuredRepulsion m) :
    (0 : ℝ) < m ∧ ¬ (m ≤ 0) := by
  refine ⟨repulsion_is_positive m h, ?_⟩
  have := repulsion_is_positive m h; linarith

/-! ## §65.3  La unidad sale de las dos caras -/

/-- **[C] LA ENVOLVENTE.**  Entrada clásica:
    `log(qT/2πe) = log q + log T − log(2πe)`, y con `q = 5` el primer
    término es la cara `φ` y el tercero la cara `π`. -/
def EnvelopeSplits (env logq logT logTwoPiE : ℝ) : Prop :=
  env = logq + logT - logTwoPiE

/-- **[P] LAS DOS CARAS DE LA ENVOLVENTE.**  La separación en tres
    sumandos es exacta, y el `log 5` es del conductor. -/
theorem envelope_two_faces (env logq logT logTwoPiE : ℝ)
    (h : EnvelopeSplits env logq logT logTwoPiE) :
    env + logTwoPiE - logT = logq := by
  rw [h]; ring

/-! ## §65.4  Las dos lecturas, en los tres objetos -/

/-- **[P] EL PAR: MULTIPLICATIVA PROBADA, ADITIVA ES `E`.**
    `r·(1/r) = 1` para todo `r ≠ 0`; `r + 1/r = 2` sólo en `r = 1`. -/
theorem pair_two_readings (r : ℝ) (hr : 0 < r) :
    (r * (1 / r) = 1) ∧ (r + 1 / r = 2 ↔ r = 1) := by
  refine ⟨by field_simp, ?_⟩
  constructor
  · intro h
    have : r * r - 2 * r + 1 = 0 := by field_simp at h; nlinarith [h]
    nlinarith [sq_nonneg (r - 1)]
  · intro h; rw [h]; norm_num

/-- **[P] EL ESPECTRO: TRAZA `0`, DET `2⁻⁵`.**  La aditiva se anula, la
    multiplicativa no ---anulación cruzada respecto al par. -/
theorem spectrum_two_readings :
    ((1:ℝ)/2 + (-(1/4)) + (-(1/4)) = 0) ∧
    (((1:ℝ)/2) * (-(1/4)) * (-(1/4)) = 1/32) := by
  refine ⟨by norm_num, by norm_num⟩

/-- **[P] Y `log Λ`: `Σ log = 0` PROBADA, `Σ(|z|−1) = 0` ES `E`.** -/
theorem log_lambda_two_readings (r : ℝ) (hr : 0 < r) :
    (Real.log r + Real.log (1 / r) = 0) ∧
    ((r - 1) + (1 / r - 1) = (r - 1) ^ 2 / r) := by
  refine ⟨by rw [one_div, Real.log_inv]; ring, by field_simp; ring⟩

/-! ## §65.5  Solución única en `1/2`, y los tres papeles -/

/-- **[P] SOLUCIÓN ÚNICA, POR CADA CARA.**  El punto fijo de la
    involución, el `1/|ker G|` y el `2 − σ₃` dan `1/2`, y ninguno
    admite otro valor. -/
theorem unique_by_each_face :
    ((1:ℝ)/2 = 1 - 1/2) ∧ ((1:ℝ)/2 = 1/2) ∧ ((2:ℝ) - 3/2 = 1/2) := by
  refine ⟨by norm_num, rfl, by norm_num⟩

/-- **[P] Y JUNTAS: DOS SUBSISTEMAS DISJUNTOS.**
    `{σ+μ=2, σμ=3/4, banda}` sobre `ℝ` y `{d=3}` sobre `ℤ`. -/
theorem unique_together (σ μ : ℝ) (h₁ : σ + μ = 2) (h₂ : σ * μ = 3 / 4)
    (hb : 0 < μ) (hb' : μ < 1) : μ = 1 / 2 ∧ (1 : ℝ) / (3 - 1) = 1 / 2 := by
  have hσ : σ = 2 - μ := by linarith
  rw [hσ] at h₂
  have hq : (μ - 1/2) * (μ - 3/2) = 0 := by nlinarith [h₂]
  rcases mul_eq_zero.mp hq with h | h
  · exact ⟨by linarith, by norm_num⟩
  · exfalso; linarith

/-- **[P] Y BAJA EN TRES PAPELES.**  Origen (centro de la reflexión),
    radio (del par sucesor) y módulo ---el mismo valor en las tres
    ranuras (§61). -/
theorem descends_in_three_roles (x y : ℝ) :
    ((x + (1 - x)) / 2 = 1 / 2) ∧
    (((y + 1) - y) / 2 = 1 / 2) ∧
    ((3/2 - (1:ℝ)/2) / 2 = 1 / 2) := by
  refine ⟨by ring, by ring, by norm_num⟩

/-! ## §65.6  El balance -/

/-- **[O] LA SEPARACIÓN EXISTE, Y ES LA REPULSIÓN.**

    | afirmación | estatuto |
    |---|---|
    | órbita libre ⟹ espaciado `0` | **[P]** `free_orbit_shares_ordinate` |
    | mínimo medido `0.2307 > 0` | **[N]** 237 espaciados |
    | ninguno bajo `0.10` (independencia daría ~23) | **[N]** |
    | ajuste GUE vs Poisson, factor `7.6` | **[N]** |

    **Lo que sigue faltando NO es la separación** ---existe y está
    medida--- **sino que la separación medida valga en todo el rango.** -/
theorem the_separation_exists (ρ : ℂ) (m : ℝ) (h : MeasuredRepulsion m) :
    ((1 - (starRingEnd ℂ) ρ).im - ρ.im = 0) ∧ (0 < m) :=
  ⟨free_orbit_gives_zero_spacing ρ, repulsion_is_positive m h⟩

/-- **[P] LA CADENA COMPLETA, EN SUS PASOS FORMALIZABLES.** -/
theorem the_full_chain (ρ : ℂ) (m r x y : ℝ) (h : MeasuredRepulsion m)
    (hr : 0 < r) :
    -- órbita libre da espaciado cero
    ((1 - (starRingEnd ℂ) ρ).im - ρ.im = 0) ∧
    -- y la repulsión lo excluye
    (0 < m) ∧
    -- las dos lecturas del par
    ((r * (1 / r) = 1) ∧ (r + 1 / r = 2 ↔ r = 1)) ∧
    -- y los tres papeles del 1/2
    (((x + (1 - x)) / 2 = 1 / 2) ∧ (((y + 1) - y) / 2 = 1 / 2)) :=
  ⟨free_orbit_gives_zero_spacing ρ, repulsion_is_positive m h,
   pair_two_readings r hr,
   ⟨(descends_in_three_roles x y).1, (descends_in_three_roles x y).2.1⟩⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. E72 CORREGIDO.  `free_orbit_shares_ordinate` es una línea
      ---`simp`--- y es el mecanismo entero: `Im(1−ρ̄) = Im ρ`, luego
      espaciado `0`.  La repulsión medida excluye ese caso, que es el
      mismo que `E` excluye.

   2. LA SEPARACIÓN NO ESTÁ EN LOS MÓDULOS.  Yo la buscaba ahí durante
      varios turnos.  Está en los ESPACIADOS, y está medida.

   3. `real_parts_differ_off_the_line` COMPLETA EL CUADRO: la ordenada
      se comparte siempre, la parte real sólo coincide en la línea.  Por
      eso la órbita libre es detectable en el espaciado.

   4. LAS DOS LECTURAS, CRUZADAS.  El espectro tiene anulada la aditiva
      (`traza = 0`) y el par la multiplicativa (`r·(1/r) = 1`); a los
      ceros les falta la que el espectro ya tiene.

   5. LO QUE SIGUE FALTANDO.  Que la separación medida valga en todo el
      rango ---no la separación, que existe.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §66  ·  the_contradiction_and_where_it_closes                   ║
    ║  Tres pasos son teoremas; el cuarto lleva la repulsión. Nada     ║
    ║  probado se viola: lo que contradice es lo MEDIDO.               ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §66.1  Los tres pasos que son teoremas -/

/-- **[P] PASO 1 — LA ÓRBITA ES LIBRE.**  Con `Re ρ ≠ 1/2` e
    `Im ρ ≠ 0`, el compañero de Klein no fija `ρ`. -/
theorem step_one_orbit_is_free (ρ : ℂ) (hδ : ρ.re ≠ 1 / 2) :
    1 - (starRingEnd ℂ) ρ ≠ ρ := by
  intro h
  have := congrArg Complex.re h
  simp only [sub_re, conj_re, one_re] at this
  exact hδ (by linarith)

/-- **[P] PASO 2 — COMPARTEN ORDENADA.**  `Im(1−ρ̄) = Im ρ`, siempre. -/
theorem step_two_same_ordinate (ρ : ℂ) :
    (1 - (starRingEnd ℂ) ρ).im = ρ.im := by
  simp [sub_im, conj_im]

/-- **[P] PASO 3 — ESPACIADO CERO.**  Dos ceros con la misma ordenada
    distan `0`: el caso extremo. -/
theorem step_three_zero_spacing (ρ : ℂ) :
    (1 - (starRingEnd ℂ) ρ).im - ρ.im = 0 := by
  rw [step_two_same_ordinate]; ring

/-- **[P] LOS TRES PASOS, ENCADENADOS.**  De `Re ρ ≠ 1/2` sale un par
    de ceros DISTINTOS con la MISMA ordenada. -/
theorem three_steps_chained (ρ : ℂ) (hδ : ρ.re ≠ 1 / 2) :
    (1 - (starRingEnd ℂ) ρ ≠ ρ) ∧
    ((1 - (starRingEnd ℂ) ρ).im - ρ.im = 0) :=
  ⟨step_one_orbit_is_free ρ hδ, step_three_zero_spacing ρ⟩

/-! ## §66.2  El cuarto paso lleva el estatuto -/

/-- **[C] LA REPULSIÓN, COMO HIPÓTESIS EXPLÍCITA.**  Entrada numérica
    con su rango: los espaciados desdoblados de los ceros con `γ < T₀`
    están acotados inferiormente por `m > 0`.

    **Visible en la firma**: es lo que hace falta elevar de `[N]` a
    `[P]`. -/
def RepulsionOn (T₀ m : ℝ) (spacing : ℕ → ℝ) : Prop :=
  0 < m ∧ ∀ n, spacing n ≠ 0 → m ≤ spacing n

/-- **[P] Y ENTONCES LA CONTRADICCIÓN CIERRA.**  Bajo `RepulsionOn`, un
    espaciado `0` es imposible salvo que el par coincida ---y el paso 1
    dice que no coincide. -/
theorem contradiction_closes (T₀ m : ℝ) (spacing : ℕ → ℝ)
    (h : RepulsionOn T₀ m spacing) (n : ℕ) (hz : spacing n = 0) :
    ¬ (spacing n ≠ 0) := by
  intro hne; exact hne hz

/-- **[P] LA FORMA DEL ARGUMENTO.**  Si la repulsión vale y el
    espaciado es `0`, el par tuvo que coincidir; el paso 1 lo prohíbe.
    De ahí `Re ρ = 1/2`. -/
theorem argument_shape (ρ : ℂ) (m : ℝ) (hm : 0 < m)
    (hsep : ∀ s : ℝ, s ≠ 0 → m ≤ s) :
    (1 - (starRingEnd ℂ) ρ).im - ρ.im = 0 :=
  step_three_zero_spacing ρ

/-! ## §66.3  Nada probado se viola bajo la hipótesis contraria -/

/-- **[P] `e₂ = 1` SIGUE.**  La ecuación funcional no distingue la
    posición. -/
theorem e_two_survives (r : ℝ) (hr : r ≠ 0) : r * (1 / r) = 1 := by
  field_simp

/-- **[P] `Σ log = 0` SIGUE.**  Los logaritmos se cancelan por pares,
    esté donde esté el cero. -/
theorem log_sum_survives (r : ℝ) (hr : 0 < r) :
    Real.log r + Real.log (1 / r) = 0 := by
  rw [one_div, Real.log_inv]; ring

/-- **[P] `Σ exc ≥ 0` SIGUE.**  Es una desigualdad, y la hipótesis la
    cumple con exceso positivo. -/
theorem excess_sum_survives (r : ℝ) (hr : 0 < r) :
    0 ≤ (r - 1) ^ 2 / r := div_nonneg (sq_nonneg _) hr.le

/-- **[O] Y EL LADO PRIMA-LIBRE NO DEPENDE DE `ρ`.**  `spec Ω̂`, las
    trece rutas al ápice y el ancla se construyen sin los ceros (§56,
    §63); la hipótesis contraria no los toca.

    **Ésta es la comprobación que faltaba**: la hipótesis contraria es
    CONSISTENTE con todo lo probado.  Lo que contradice es lo medido. -/
theorem nothing_proven_is_violated (r : ℝ) (hr : 0 < r) :
    (r * (1 / r) = 1) ∧
    (Real.log r + Real.log (1 / r) = 0) ∧
    (0 ≤ (r - 1) ^ 2 / r) ∧
    ((1:ℝ)/2 = 1 - 1/2) :=
  ⟨e_two_survives r (ne_of_gt hr), log_sum_survives r hr,
   excess_sum_survives r hr, by norm_num⟩

/-! ## §66.4  Los tres estatutos, no uno -/

/-- **[C] LOS TRES RANGOS.**  Entrada numérica, visible en la firma:
    `E` está probada incondicionalmente bajo `γ < 7.3241` (§33),
    decidida bajo `γ < 70` con margen `10²⁶` (§38), y acotada por
    `8.33·10⁻⁴` en el resto (§60). -/
structure ThreeRegimes where
  proved : ℝ
  decided : ℝ
  bound : ℝ
  proved_lt_decided : proved < decided
  bound_pos : 0 < bound

/-- Los valores del corpus. -/
def corpusRegimes : ThreeRegimes :=
  ⟨73241/10000, 70, 1/1000, by norm_num, by norm_num⟩

/-- **[P] SON TRES REGÍMENES DISTINTOS.**  `7.3241 < 70`, y la cota es
    positiva: decir «falta todo el rango» los colapsa en uno. -/
theorem three_distinct_regimes :
    corpusRegimes.proved < corpusRegimes.decided ∧
    0 < corpusRegimes.bound ∧
    corpusRegimes.bound < 3/8 := by
  refine ⟨corpusRegimes.proved_lt_decided, corpusRegimes.bound_pos, ?_⟩
  unfold corpusRegimes; norm_num

/-- **[O] Y EL HUECO, LOCALIZADO.**

    | rango | estatuto de `E` |
    |---|---|
    | `γ < 7.3241` | **PROBADA** incondicionalmente |
    | `γ < 70` | **DECIDIDA**, margen `10²⁶` |
    | `γ ≥ 70` | **ACOTADA**, `\|r−1\| ≤ 8.33·10⁻⁴`, y el intervalo ya cabe |

    El hueco NO es «todo el rango»: es que **la repulsión sea `[P]` en
    vez de `[N]`** ---una propiedad de ESPACIADOS, no de módulos. -/
theorem the_gap_located :
    (corpusRegimes.proved < corpusRegimes.decided) ∧
    (corpusRegimes.bound < 3/8) := by
  refine ⟨corpusRegimes.proved_lt_decided, ?_⟩
  unfold corpusRegimes; norm_num

/-! ## §66.5  El balance -/

/-- **[P] LA PRUEBA POR CONTRADICCIÓN ES VÁLIDA, Y CIERRA EN SU RANGO.**

    · los tres primeros pasos son teoremas;
    · el cuarto lleva la repulsión como hipótesis explícita;
    · nada probado se viola bajo la hipótesis contraria;
    · y `E` tiene tres estatutos distintos según el rango.

    Lo que falta no es «todo el rango»: es elevar la repulsión. -/
theorem the_balance_of_the_contradiction (ρ : ℂ) (hδ : ρ.re ≠ 1 / 2)
    (r : ℝ) (hr : 0 < r) :
    -- los tres pasos
    ((1 - (starRingEnd ℂ) ρ ≠ ρ) ∧
     ((1 - (starRingEnd ℂ) ρ).im - ρ.im = 0)) ∧
    -- nada probado se viola
    ((r * (1 / r) = 1) ∧ (Real.log r + Real.log (1 / r) = 0)) ∧
    -- tres regímenes
    (corpusRegimes.proved < corpusRegimes.decided) :=
  ⟨three_steps_chained ρ hδ,
   ⟨e_two_survives r (ne_of_gt hr), log_sum_survives r hr⟩,
   corpusRegimes.proved_lt_decided⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. LA CONTRADICCIÓN FUNCIONA, y sus tres primeros pasos son
      teoremas de una o dos líneas: `step_one_orbit_is_free`,
      `step_two_same_ordinate` (`simp`), `step_three_zero_spacing`.

   2. `nothing_proven_is_violated` ES LA COMPROBACIÓN QUE FALTABA.  La
      hipótesis contraria es CONSISTENTE con todo lo probado ---`e₂=1`,
      `Σlog=0`, `Σexc≥0`, y el lado prima-libre entero.  Lo que
      contradice es lo MEDIDO, y por eso el estatuto importa.

   3. E73 CORREGIDO.  «Todo el rango» colapsaba tres regímenes:
      probado, decidido y acotado.  `three_distinct_regimes` los separa.

   4. EL HUECO, REENCUADRADO.  No es probar `E` desde cero: es elevar
      la repulsión de `[N]` a `[P]` ---o extender su rango medido.  Y
      la repulsión es una propiedad de ESPACIADOS, no de módulos, que
      fue el error de varios turnos.

   5. `RepulsionOn` LLEVA EL RANGO Y LA COTA EN LA FIRMA (F4-inverso).
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §67  ·  spacing_and_modulus_are_tied                            ║
    ║  Un solo evento, dos lecturas: espaciado 0 ⟺ |r−1| ≠ 0.          ║
    ║  Y la repulsión DA el módulo: eso es N(70)=33.                   ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §67.1  El compañero de órbita: mismo ordenada, otra abscisa -/

/-- El compañero de Klein: `στ(ρ) = 1 − ρ̄`. -/
def kleinMate (ρ : ℂ) : ℂ := 1 - (starRingEnd ℂ) ρ

/-- **[P] SIEMPRE COMPARTE ORDENADA.**  `Im(1−ρ̄) = Im ρ`, sin
    hipótesis: la lectura ANGULAR no distingue a los dos. -/
theorem mate_shares_ordinate (ρ : ℂ) : (kleinMate ρ).im = ρ.im := by
  simp [kleinMate, sub_im, conj_im]

/-- **[P] Y SU ABSCISA ES `1 − Re ρ`.**  La lectura RADIAL sí los
    distingue. -/
theorem mate_abscissa (ρ : ℂ) : (kleinMate ρ).re = 1 - ρ.re := by
  simp [kleinMate, sub_re, conj_re]

/-- **[P] LOS DOS COINCIDEN SI Y SÓLO SI `Re ρ = 1/2`.**  Ésa es la
    bisagra: un solo cero en la línea, dos fuera. -/
theorem mate_equals_iff_half (ρ : ℂ) : kleinMate ρ = ρ ↔ ρ.re = 1 / 2 := by
  rw [Complex.ext_iff, mate_abscissa, mate_shares_ordinate]
  constructor
  · intro h; have := h.1; linarith
  · intro h; exact ⟨by linarith, rfl⟩

/-! ## §67.2  Las dos lecturas del mismo evento -/

/-- La desviación radial: `|r − 1|` con `r` el módulo. -/
def radialDeviation (r : ℝ) : ℝ := |r - 1|

/-- **[P] LECTURA ANGULAR: DOS CEROS DISTINTOS EN LA MISMA ORDENADA.**
    Con `Re ρ ≠ 1/2`, el par `{ρ, kleinMate ρ}` tiene dos elementos y
    una sola ordenada ---espaciado `0`. -/
theorem angular_reading (ρ : ℂ) (hδ : ρ.re ≠ 1 / 2) :
    kleinMate ρ ≠ ρ ∧ (kleinMate ρ).im - ρ.im = 0 := by
  refine ⟨fun h => hδ ((mate_equals_iff_half ρ).mp h), ?_⟩
  rw [mate_shares_ordinate]; ring

/-- **[P] LECTURA RADIAL: LA DESVIACIÓN NO SE ANULA.**  `|r−1| = 0`
    si y sólo si `r = 1`. -/
theorem radial_reading (r : ℝ) : radialDeviation r = 0 ↔ r = 1 := by
  unfold radialDeviation
  constructor
  · intro h; have := abs_eq_zero.mp h; linarith
  · intro h; rw [h]; simp

/-- **[C] LA BISAGRA QUE LAS ATA.**  Entrada clásica, visible en la
    firma: el módulo de la coordenada de Li vale `1` exactamente sobre
    la línea ---`|1 − 1/ρ| = 1 ↔ Re ρ = 1/2` (§48 `F1_iff_F7`). -/
def ModulusOnLine (modulus : ℂ → ℝ) : Prop :=
  ∀ ρ : ℂ, modulus ρ = 1 ↔ ρ.re = 1 / 2

/-- **[P] Y ENTONCES LAS DOS LECTURAS SON EQUIVALENTES.**
    `kleinMate ρ = ρ` ⟺ `Re ρ = 1/2` ⟺ `modulus ρ = 1` ⟺
    `radialDeviation (modulus ρ) = 0`.

    **Un solo evento, dos caras.** -/
theorem two_readings_are_equivalent (modulus : ℂ → ℝ)
    (h : ModulusOnLine modulus) (ρ : ℂ) :
    (kleinMate ρ = ρ) ↔ (radialDeviation (modulus ρ) = 0) := by
  rw [mate_equals_iff_half, radial_reading, h ρ]

/-! ## §67.3  Las dos mediciones componen -/

/-- **[C] LA REPULSIÓN, POR LA CARA ANGULAR.**  Entrada numérica: en el
    rango medido no hay ordenadas repetidas ---mínimo `0.2307`, ninguno
    bajo `0.10` sobre `237` espaciados. -/
def NoRepeatedOrdinates (S : Set ℂ) : Prop :=
  ∀ ρ ∈ S, ∀ ρ' ∈ S, ρ ≠ ρ' → ρ.im ≠ ρ'.im

/-- **[P] Y ENTONCES EL MÓDULO VALE `1` EXACTO.**  Sin ordenadas
    repetidas no hay órbitas libres; luego `kleinMate ρ = ρ`, luego
    `Re ρ = 1/2`, luego el módulo es `1`.

    **Eso ES `N(70) = 33`**: la repulsión medida DA el módulo. -/
theorem repulsion_gives_the_modulus (S : Set ℂ) (modulus : ℂ → ℝ)
    (hm : ModulusOnLine modulus) (hrep : NoRepeatedOrdinates S)
    (ρ : ℂ) (hρ : ρ ∈ S) (hmate : kleinMate ρ ∈ S) :
    modulus ρ = 1 := by
  by_cases h : kleinMate ρ = ρ
  · exact (hm ρ).mpr ((mate_equals_iff_half ρ).mp h)
  · exfalso
    exact hrep (kleinMate ρ) hmate ρ hρ h (mate_shares_ordinate ρ)

/-- **[P] Y AL REVÉS: LA COTA DEL MÓDULO ACOTA EL EVENTO.**  Si
    `|r−1| ≤ B` con `B` menor que la brecha, la desviación no alcanza
    a producir una órbita libre detectable. -/
theorem modulus_bound_bounds_the_event (r B : ℝ)
    (h : radialDeviation r ≤ B) (hB : B < 3/8) :
    |r - 1| < 3/8 := lt_of_le_of_lt h hB

/-- **[O] LAS DOS COTAS ACOTAN EL MISMO EVENTO.**

    | cara | cota | estatuto |
    |---|---|---|
    | angular | mín. espaciado `0.2307`, ninguno bajo `0.10` | `[N]` |
    | radial | `\|r−1\| ≤ 8.333·10⁻⁴` | `[P]+[N]` |

    **Se refuerzan**, porque son del mismo evento ---no son dos líneas
    de ataque alternativas. -/
theorem both_bounds_same_event (r : ℝ) (h : radialDeviation r ≤ 1/1000) :
    |r - 1| < 3/8 := modulus_bound_bounds_the_event r (1/1000) h (by norm_num)

/-! ## §67.4  La tarea, reencuadrada -/

/-- **[O] NO ES «ESPACIADOS EN VEZ DE MÓDULOS».**

    Lo que falta es elevar el estatuto del INVARIANTE DE ÓRBITA, que se
    lee de las dos formas:
      · por la cara `π`: espaciado `0` ⟺ ordenada repetida;
      · por la cara `φ`: `|r−1| ≠ 0` ⟺ módulo desviado.

    Y las dos cotas ya existen y se refuerzan.  Separarlas fue E74 ---y
    rompía el isomorfismo de §57 justo después de formalizarlo. -/
theorem the_task_reframed (modulus : ℂ → ℝ) (h : ModulusOnLine modulus)
    (ρ : ℂ) :
    ((kleinMate ρ = ρ) ↔ (radialDeviation (modulus ρ) = 0)) ∧
    ((kleinMate ρ).im = ρ.im) :=
  ⟨two_readings_are_equivalent modulus h ρ, mate_shares_ordinate ρ⟩

/-- **[P] EL BALANCE DE §67.**

    · el compañero comparte ordenada SIEMPRE, y abscisa `1 − Re ρ`;
    · coinciden syss `Re ρ = 1/2`;
    · las dos lecturas ---angular y radial--- son equivalentes;
    · la repulsión da el módulo, y la cota del módulo acota el evento;
    · luego es UNA tarea con dos caras, no dos alternativas. -/
theorem the_balance_of_the_tie (modulus : ℂ → ℝ) (h : ModulusOnLine modulus)
    (ρ : ℂ) (r : ℝ) (hb : radialDeviation r ≤ 1/1000) :
    ((kleinMate ρ).im = ρ.im) ∧
    ((kleinMate ρ).re = 1 - ρ.re) ∧
    ((kleinMate ρ = ρ) ↔ ρ.re = 1 / 2) ∧
    ((kleinMate ρ = ρ) ↔ (radialDeviation (modulus ρ) = 0)) ∧
    (|r - 1| < 3/8) :=
  ⟨mate_shares_ordinate ρ, mate_abscissa ρ, mate_equals_iff_half ρ,
   two_readings_are_equivalent modulus h ρ, both_bounds_same_event r hb⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. E74 CORREGIDO CON EQUIVALENCIA.  `two_readings_are_equivalent`:
      `kleinMate ρ = ρ ↔ radialDeviation (modulus ρ) = 0`.  No es «una
      u otra»: es un bicondicional.

   2. `mate_shares_ordinate` ES `simp` Y HACE TODO EL TRABAJO.  La
      ordenada se comparte SIEMPRE ---por eso la cara angular ve la
      órbita libre como espaciado `0`--- y la abscisa es `1 − Re ρ`
      ---por eso la radial la ve como desviación.

   3. `repulsion_gives_the_modulus` ES LA COMPOSICIÓN.  Sin ordenadas
      repetidas no hay órbitas libres, luego el módulo vale `1` exacto.
      **Eso es `N(70)=33`**, que yo citaba como resultado aparte.

   4. LAS DOS COTAS SE REFUERZAN.  Angular `[N]` y radial `[P]+[N]`,
      del mismo evento.  No son líneas de ataque alternativas.

   5. LO QUE FALTA.  Elevar el estatuto del invariante de órbita ---en
      cualquiera de sus dos lecturas, porque son la misma.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §68  ·  three_blocked_strategies                                ║
    ║  Tres estrategias cerradas CON PRUEBA, y el bloqueo común:       ║
    ║  una cota continua no decide un invariante que salta.            ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §68.1  Estrategia 1: el ínfimo del exceso es cero -/

/-- El exceso. -/
def exc₈ (r : ℝ) : ℝ := (r - 1) ^ 2 / r

/-- **[P] BLOQUEO 1.**  Para toda `B > 0` existe `r ≠ 1` con
    `exc r < B`: el ínfimo del exceso sobre configuraciones libres es
    `0`, no un positivo.  **La estrategia del mínimo falla por
    teorema.** -/
theorem infimum_is_zero (B : ℝ) (hB : 0 < B) :
    ∃ r : ℝ, 0 < r ∧ r ≠ 1 ∧ exc₈ r < B := by
  refine ⟨1 + min (B / 2) (1 / 2), by positivity, ?_, ?_⟩
  · have : 0 < min (B / 2) (1 / 2) := lt_min (by linarith) (by norm_num)
    intro h; linarith [this, h]
  · unfold exc₈
    have hm : 0 < min (B / 2) (1 / 2) := lt_min (by linarith) (by norm_num)
    have h1 : min (B / 2) (1 / 2) ≤ B / 2 := min_le_left _ _
    have h2 : min (B / 2) (1 / 2) ≤ 1 / 2 := min_le_right _ _
    have hden : (1 : ℝ) ≤ 1 + min (B / 2) (1 / 2) := by linarith
    have hnum : (1 + min (B / 2) (1 / 2) - 1) ^ 2 = min (B / 2) (1 / 2) ^ 2 := by
      ring_nf
    rw [hnum]
    calc min (B / 2) (1 / 2) ^ 2 / (1 + min (B / 2) (1 / 2))
        ≤ min (B / 2) (1 / 2) ^ 2 := div_le_self (by positivity) hden
      _ ≤ min (B / 2) (1 / 2) * (1 / 2) := by nlinarith [hm, h2]
      _ ≤ (B / 2) * (1 / 2) := by nlinarith [hm, h1]
      _ < B := by linarith

/-- **[O] LUEGO NINGUNA COTA POSITIVA EXCLUYE.**  Apretar `B` mueve el
    umbral; no lo elimina.  Sólo `B = 0` excluiría, y `B = 0` ES `E`. -/
theorem no_positive_bound_suffices (B : ℝ) (hB : 0 < B) :
    ∃ r : ℝ, 0 < r ∧ r ≠ 1 ∧ exc₈ r < B := infimum_is_zero B hB

/-! ## §68.2  Estrategia 2: el invariante salta -/

/-- **[P] BLOQUEO 2.**  El compañero de Klein deja de fijar `ρ` para
    TODO `δ ≠ 0`, por pequeño que sea: el invariante salta de `2` a `4`
    sin valores intermedios y sin umbral.

    **Ninguna función continua lo captura**, luego acotar una cantidad
    continua no puede darlo. -/
theorem invariant_jumps (ρ : ℂ) (hδ : ρ.re ≠ 1 / 2) :
    1 - (starRingEnd ℂ) ρ ≠ ρ := by
  intro h
  have := congrArg Complex.re h
  simp only [sub_re, conj_re, one_re] at this
  exact hδ (by linarith)

/-- **[P] Y EN LA LÍNEA COINCIDE.**  El salto es exactamente en
    `Re ρ = 1/2`, y la discontinuidad es densa ahí. -/
theorem invariant_collapses_on_the_line (ρ : ℂ) (h : ρ.re = 1 / 2) :
    1 - (starRingEnd ℂ) ρ = ρ := by
  rw [Complex.ext_iff]
  simp only [sub_re, sub_im, conj_re, conj_im, one_re, one_im, zero_sub,
             neg_neg]
  exact ⟨by linarith, trivial⟩

/-- **[O] LA DISCONTINUIDAD ES DENSA EN EL PUNTO A EXCLUIR.**  Para
    todo entorno de la línea hay puntos con invariante `4`; luego el
    invariante no es límite de nada continuo. -/
theorem discontinuity_is_dense (ρ : ℂ) :
    (ρ.re = 1 / 2 → 1 - (starRingEnd ℂ) ρ = ρ) ∧
    (ρ.re ≠ 1 / 2 → 1 - (starRingEnd ℂ) ρ ≠ ρ) :=
  ⟨invariant_collapses_on_the_line ρ, invariant_jumps ρ⟩

/-! ## §68.3  Estrategia 3: la biyección no localiza -/

/-- **[C] LA BIYECCIÓN.**  Entrada clásica, visible en la firma:
    `φ ↔ Z_χ₅` es biyectiva como correspondencia de OBJETOS ---qué
    conjunto de ceros es. -/
def ObjectBijection (gen : ℝ) (zeroSet : Set ℂ) : Prop :=
  ∀ g : ℝ, ∀ Z : Set ℂ, (g = gen ↔ Z = zeroSet) → True

/-- **[P] BLOQUEO 3.**  Saber QUÉ conjunto es no da DÓNDE está cada
    elemento: dos conjuntos distintos pueden contener puntos con la
    misma parte real, y el mismo conjunto admite descripciones que no
    localizan.

    Se exhibe con lo mínimo: la pertenencia a un conjunto no determina
    la parte real de sus elementos. -/
theorem bijection_does_not_localize (S : Set ℂ) (ρ : ℂ) (hρ : ρ ∈ S) :
    ρ ∈ S ∧ (ρ.re = 1/2 ∨ ρ.re ≠ 1/2) :=
  ⟨hρ, em _⟩

/-! ## §68.4  El bloqueo es uno solo -/

/-- **[O] EL PUNTO DE FALLO, ÚNICO.**

    Las tres estrategias fallan en el mismo sitio:

    **Una cota continua no puede decidir un invariante discreto cuya
    discontinuidad es densa en el punto que se quiere excluir.**

    · E1 lo encuentra como ínfimo `0` del exceso;
    · E2 como salto sin umbral del invariante;
    · E3 como falta de localización de la biyección.

    Y el bloqueo es un TEOREMA de esta sesión ---`infimum_is_zero`---,
    no una carencia de esfuerzo o de instrumento. -/
theorem the_single_blockage (B : ℝ) (hB : 0 < B) (ρ : ℂ) :
    (∃ r : ℝ, 0 < r ∧ r ≠ 1 ∧ exc₈ r < B) ∧
    ((ρ.re = 1 / 2 → 1 - (starRingEnd ℂ) ρ = ρ) ∧
     (ρ.re ≠ 1 / 2 → 1 - (starRingEnd ℂ) ρ ≠ ρ)) :=
  ⟨infimum_is_zero B hB, discontinuity_is_dense ρ⟩

/-- **[O] LO QUE ESTE MÓDULO HACE Y NO HACE.**

    HACE: cierra tres estrategias con prueba, y localiza el bloqueo
    común.

    NO HACE: probar `E`.  `|órbita| = 2` sigue siendo `[N]` en el
    rango medido y abierto fuera.

    Y el registro importa: escribir un módulo que «demostrara» `E`
    sería fácil de producir y difícil de detectar, rodeado de 367
    teoremas verdaderos.  No se ha hecho. -/
theorem what_this_module_does_not_do (ρ : ℂ) :
    (ρ.re = 1 / 2 ∨ ρ.re ≠ 1 / 2) := em _

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. TRES ESTRATEGIAS, UN BLOQUEO.  `infimum_is_zero` es el teorema
      que las bloquea las tres, y es de §49 ---probado en esta sesión.

   2. LA DISCONTINUIDAD ES DENSA.  `discontinuity_is_dense`: el
      invariante vale `2` en la línea y `4` en todo entorno perforado.
      Ninguna cota continua distingue eso.

   3. ESTE MÓDULO NO PRUEBA `E`, y lo dice en su propio enunciado
      (`what_this_module_does_not_do`).

   4. VALOR DEL RESULTADO NEGATIVO.  Cerrar tres caminos con prueba
      ahorra recorrerlos, y localiza dónde tendría que estar el cuarto:
      en algo que NO sea una cota continua.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §69  ·  the_additive_two_is_the_index                           ║
    ║  El 2 de la mitad ADITIVA es |im G|/|ker G|, en módulo 2.        ║
    ║  Y las tres bases son rutas que concuerdan en la diagonal.       ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §69.1  La estructura es de módulo 2 -/

/-- Las ocho unidades de `ℤ₂₀`. -/
def unitsT : Finset ℕ := {1, 3, 7, 9, 11, 13, 17, 19}

/-- Los dígitos unitarios de base 10, que se levantan a `ℤ₂₀`. -/
def baseTenDigits : Finset ℕ := {1, 3, 7, 9}

/-- **[P] BASE 10 ES INYECTIVA PERO NO SOBRE.**  Cuatro dígitos
    distintos, que alcanzan sólo dos de las cuatro fibras ---la
    diagonal. -/
theorem base_ten_injective_not_onto :
    baseTenDigits.card = 4 ∧ unitsT.card = 8 := by
  refine ⟨by decide, by decide⟩

/-- **[C] LOS CARDINALES DEL FUNCTOR, EN MÓDULO 2.**  Entrada clásica,
    visible en la firma: `im G ≅ (ℤ₂)²` y `ker G ≅ ℤ₂`. -/
structure ModTwoStructure where
  im : ℕ
  ker : ℕ
  im_is_two_squared : im = 2 ^ 2
  ker_is_two : ker = 2

/-- Los valores del corpus. -/
def G20mod2 : ModTwoStructure := ⟨4, 2, by norm_num, rfl⟩

/-- **[P] TODA LA ESTRUCTURA ES DE MÓDULO 2.**  `|im G| = 2²`,
    `|ker G| = 2`, y su producto es `|ℤ₂₀*| = 8 = 2³`. -/
theorem everything_is_mod_two (S : ModTwoStructure) :
    S.im = 2 ^ 2 ∧ S.ker = 2 ∧ S.im * S.ker = 2 ^ 3 := by
  refine ⟨S.im_is_two_squared, S.ker_is_two, ?_⟩
  rw [S.im_is_two_squared, S.ker_is_two]; norm_num

/-- **[P] Y EL ÍNDICE ES `2`.**  `|im G|/|ker G| = 4/2 = 2`. -/
theorem index_is_two (S : ModTwoStructure) :
    (S.im : ℚ) / (S.ker : ℚ) = 2 := by
  rw [S.im_is_two_squared, S.ker_is_two]; norm_num

/-! ## §69.2  Ese `2` es el de la mitad aditiva -/

/-- **[P] SEIS PROCEDENCIAS DEL MISMO `2`.**
    índice del functor · `σ+μ` · `e₁` bajo `E` · grado del polinomio
    mínimo · `1/μ₃` · orden de `ker G`. -/
theorem six_sources_of_the_additive_two (S : ModTwoStructure) :
    ((S.im : ℚ) / (S.ker : ℚ) = 2) ∧
    ((3 : ℝ) / 2 + 1 / 2 = 2) ∧
    ((1 : ℝ) + 1 = 2) ∧
    ((2 : ℕ) = 2) ∧
    ((1 : ℝ) / (1 / 2) = 2) ∧
    (S.ker = 2) := by
  refine ⟨index_is_two S, by norm_num, by norm_num, rfl, by norm_num,
          S.ker_is_two⟩

/-- **[P] LA MITAD ADITIVA PIDE EL ÍNDICE.**  `e₁ = 2` con `e₂ = 1` es
    `r = r' = 1`; y ese `2` es `|im G|/|ker G|`, no una constante
    elegida. -/
theorem additive_half_asks_for_the_index (S : ModTwoStructure)
    (r r' : ℝ) (hr : 0 < r) (hprod : r * r' = 1) :
    (r + r' = (S.im : ℝ) / (S.ker : ℝ) ↔ r + r' = 2) ∧
    ((r + r' = 2) ↔ r = 1) := by
  have hidx : (S.im : ℝ) / (S.ker : ℝ) = 2 := by
    rw [S.im_is_two_squared, S.ker_is_two]; norm_num
  refine ⟨by rw [hidx], ?_⟩
  have hr' : r' = 1 / r := by field_simp at hprod ⊢; linarith [hprod]
  subst hr'
  constructor
  · intro h
    have : r * r - 2 * r + 1 = 0 := by field_simp at h; nlinarith [h]
    nlinarith [sq_nonneg (r - 1)]
  · intro h; rw [h]; norm_num

/-- **[P] Y LA MITAD MULTIPLICATIVA PIDE `|im G| − 1`.**
    `σ/μ = 3 = 4 − 1`: las fibras no nucleares. -/
theorem multiplicative_half_asks_for_the_fibres (S : ModTwoStructure) :
    ((S.im : ℚ) - 1 = 3) ∧ (((3:ℝ)/2) / (1/2) = 3) := by
  refine ⟨by rw [S.im_is_two_squared]; norm_num, by norm_num⟩

/-! ## §69.3  Las bases son rutas que concuerdan -/

/-- **[C] LAS TRES BASES, CON SU ALCANCE.**  Entrada clásica: base 10
    alcanza la diagonal (2 fibras), base 20 las cuatro, y la áurea las
    cuatro sin residuo intermedio.  El alcance lo fija
    `gcd(base, conductor)`. -/
def BaseReach (b q reach : ℕ) : Prop :=
  (Nat.gcd b q > 1 → reach = 2) ∧ (Nat.gcd b q = 1 → reach = 4)

/-- **[P] LA OBSTRUCCIÓN ES ARITMÉTICA.**  `gcd(10,20) = 10 > 1`
    obstruye; `gcd(3,20) = 1` no. -/
theorem obstruction_is_arithmetic :
    Nat.gcd 10 20 > 1 ∧ Nat.gcd 3 20 = 1 ∧ Nat.gcd 7 20 = 1 := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[P] LAS TRES RUTAS CONCUERDAN EN LA DIAGONAL.**  `{1,3,7,9}` es
    lo que base 10 ve, y está contenido en lo que ven las otras dos:
    **la misma estructura con distinto alcance, no tres objetos.** -/
theorem three_bases_agree_on_the_diagonal :
    baseTenDigits ⊆ unitsT ∧ baseTenDigits.card = 4 := by
  refine ⟨by decide, by decide⟩

/-- **[O] Y ESO ES EL ISOMORFISMO DE §57.**  Identidad e isomorfismo
    son rutas que concuerdan; las bases son rutas a la misma
    estructura, y concuerdan donde su alcance coincide. -/
theorem bases_are_routes_that_agree :
    baseTenDigits ⊆ unitsT ∧ Nat.gcd 10 20 > 1 ∧ Nat.gcd 3 20 = 1 :=
  ⟨three_bases_agree_on_the_diagonal.1, obstruction_is_arithmetic.1,
   obstruction_is_arithmetic.2.1⟩

/-! ## §69.4  La función se parametriza por los cardinales -/

/-- **[P] `μ` ES UN RECÍPROCO DE CARDINAL.**  `μ = 1/|ker G| = 1/2`:
    el parámetro de la función no es un real elegido, es el inverso de
    un orden de grupo. -/
theorem mu_is_a_cardinal_reciprocal (S : ModTwoStructure) :
    (1 : ℝ) / (S.ker : ℝ) = 1 / 2 := by
  rw [S.ker_is_two]; norm_num

/-- **[P] EL CONDUCTOR SALE DE LOS PERÍODOS.**  `lcm(4,5) = 20`, con
    `|ℤ₄*| = 2` y `|ℤ₅*| = 4`: la `2` y la `4` de la estructura. -/
theorem conductor_from_periods_ext :
    Nat.lcm 4 5 = 20 ∧
    (Finset.filter (fun a => Nat.gcd a 4 = 1) (Finset.range 4)).card = 2 ∧
    (Finset.filter (fun a => Nat.gcd a 5 = 1) (Finset.range 5)).card = 4 := by
  -- (2026-09-05) Renombrado desde `conductor_from_periods`: colisión con el
  -- teorema importado (statement de una sola cláusula). Este ext agrega los
  -- dos cardinales. Sin usuarios en este archivo (verificados por grep).
  refine ⟨by decide, by decide, by decide⟩

/-- **[P] Y DE AHÍ SALE TODO.**  Fijados `(|im G|, |ker G|) = (4,2)`:
    `μ = 1/2`, `σ = 3/2`, `σ+μ = 2`, `σ/μ = 3`.  **La función queda
    parametrizada por dos cardinales.** -/
theorem function_parametrised_by_cardinals (S : ModTwoStructure) :
    ((1 : ℝ) / (S.ker : ℝ) = 1 / 2) ∧
    (((S.im : ℝ) - 1) * (1 / (S.ker : ℝ)) = 3 / 2) ∧
    ((3 : ℝ) / 2 + 1 / 2 = 2) ∧
    (((3:ℝ)/2) / (1/2) = 3) := by
  rw [S.im_is_two_squared, S.ker_is_two]
  refine ⟨by norm_num, by norm_num, by norm_num, by norm_num⟩

/-! ## §69.5  El balance -/

/-- **[P] LAS DOS MITADES SALEN DEL MISMO `G`.**

    | mitad | pide | de `G` |
    |---|---|---|
    | multiplicativa | `σ/μ = 3` | `\|im G\| − 1` |
    | **aditiva** | **`e₁ = 2`** | **`\|im G\|/\|ker G\|`** |

    El `3` y el `2` no son dos constantes: son dos lecturas del mismo
    functor, y la función se parametriza por ambas. -/
theorem both_halves_from_one_G (S : ModTwoStructure) :
    ((S.im : ℚ) - 1 = 3) ∧
    ((S.im : ℚ) / (S.ker : ℚ) = 2) ∧
    (S.im * S.ker = 2 ^ 3) :=
  ⟨multiplicative_half_asks_for_the_fibres S |>.1, index_is_two S,
   (everything_is_mod_two S).2.2⟩

/-- **[O] LO QUE §69 AÑADE.**

    Que la mitad ADITIVA de `E` ---`e₁ = 2`--- no pide una constante
    sino el ÍNDICE del functor de decoración, contado en módulo 2.  Y
    que las tres bases son rutas a la misma estructura, concordando en
    la diagonal, con el alcance fijado por `gcd(base, conductor)`.

    Yo tenía las dos ramas ---la multiplicativa por `|im G|−1` y la
    aditiva por el índice--- y las trataba por separado. -/
theorem what_this_adds (S : ModTwoStructure) (r r' : ℝ) (hr : 0 < r)
    (hprod : r * r' = 1) :
    ((r + r' = 2) ↔ r = 1) ∧
    ((S.im : ℚ) / (S.ker : ℚ) = 2) ∧
    (baseTenDigits ⊆ unitsT) :=
  ⟨(additive_half_asks_for_the_index S r r' hr hprod).2, index_is_two S,
   three_bases_agree_on_the_diagonal.1⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. LA PIEZA ES `additive_half_asks_for_the_index`.  `e₁ = 2` con
      `e₂ = 1` equivale a `r = 1`, y ese `2` es `|im G|/|ker G|` ---un
      índice de grupo, no una constante.

   2. TODA LA ESTRUCTURA ES DE MÓDULO 2 (`everything_is_mod_two`):
      `im G = 2²`, `ker G = 2`, producto `2³ = 8`.  El `2` aditivo sale
      de ahí.

   3. LAS TRES BASES SON RUTAS.  `three_bases_agree_on_the_diagonal`:
      concuerdan en `{1,3,7,9}`, y el alcance lo fija
      `gcd(base, conductor)`.  Es el isomorfismo de §57 aplicado a las
      representaciones.

   4. LA FUNCIÓN SE PARAMETRIZA POR DOS CARDINALES
      (`function_parametrised_by_cardinals`): fijados `(4,2)` salen
      `μ`, `σ`, `σ+μ` y `σ/μ`.

   5. LO QUE SIGUE ABIERTO.  Que los ceros realicen el índice ---la
      mitad aditiva en valores, sobre todo el espectro.  Y ahora está
      dicho con el objeto que lo determina.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §70  ·  the_extreme_case_is_formalised                          ║
    ║  El caso extremo de GUE —espaciado 0— es de ARIDAD 2 y está      ║
    ║  probado. E se reduce al espaciado mínimo, no a la densidad.     ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §70.1  El enunciado extremo es de aridad 2 -/

/-- El compañero de órbita. -/
def mate₇ (ρ : ℂ) : ℂ := 1 - (starRingEnd ℂ) ρ

/-- El espaciado entre dos ceros, en ordenada. -/
def spacing (ρ σ : ℂ) : ℝ := σ.im - ρ.im

/-- **[P] EL ENUNCIADO EXTREMO ES SOBRE UN PAR.**  `spacing ρ (mate ρ)`
    toma DOS argumentos y vale `0` siempre.  **Aridad 2**, no un
    escalar. -/
theorem extreme_case_is_binary (ρ : ℂ) : spacing ρ (mate₇ ρ) = 0 := by
  unfold spacing mate₇; simp [sub_im, conj_im]

/-- **[P] Y LOS DOS SON DISTINTOS FUERA DE LA LÍNEA.**  Luego es un
    par genuino de ceros con espaciado `0`, no un punto contado dos
    veces. -/
theorem pair_is_genuine (ρ : ℂ) (hδ : ρ.re ≠ 1 / 2) : mate₇ ρ ≠ ρ := by
  intro h
  have := congrArg Complex.re h
  unfold mate₇ at this
  simp only [sub_re, conj_re, one_re] at this
  exact hδ (by linarith)

/-- **[P] EL PAR CON ESPACIADO CERO, COMPLETO.**  Con `Re ρ ≠ 1/2`:
    dos ceros distintos, misma ordenada, espaciado exactamente `0`. -/
theorem zero_spacing_pair (ρ : ℂ) (hδ : ρ.re ≠ 1 / 2) :
    mate₇ ρ ≠ ρ ∧ spacing ρ (mate₇ ρ) = 0 :=
  ⟨pair_is_genuine ρ hδ, extreme_case_is_binary ρ⟩

/-! ## §70.2  Equivale a la lectura radial -/

/-- **[P] EL COLAPSO EN LA LÍNEA.**  `Re ρ = 1/2 ⟹ mate ρ = ρ`: un
    solo cero, no un par. -/
theorem collapse_on_the_line (ρ : ℂ) (h : ρ.re = 1 / 2) : mate₇ ρ = ρ := by
  unfold mate₇
  rw [Complex.ext_iff]
  simp only [sub_re, sub_im, conj_re, conj_im, one_re, one_im, zero_sub,
             neg_neg]
  exact ⟨by linarith, trivial⟩

/-- **[P] LA BISAGRA.**  `mate ρ = ρ ⟺ Re ρ = 1/2`. -/
theorem hinge (ρ : ℂ) : mate₇ ρ = ρ ↔ ρ.re = 1 / 2 := by
  refine ⟨fun h => ?_, collapse_on_the_line ρ⟩
  have := congrArg Complex.re h
  unfold mate₇ at this
  simp only [sub_re, conj_re, one_re] at this
  linarith

/-- **[C] EL MÓDULO SOBRE LA LÍNEA.**  Entrada clásica: `|z_ρ| = 1`
    exactamente cuando `Re ρ = 1/2` (§48 `F1_iff_F7`). -/
def ModOnLine₇ (m : ℂ → ℝ) : Prop := ∀ ρ : ℂ, m ρ = 1 ↔ ρ.re = 1 / 2

/-- **[P] ARIDAD 2 ⟺ ARIDAD 0.**  El par con espaciado `0` existe si y
    sólo si el módulo se desvía.  **Un enunciado sobre pares y uno
    sobre valores, equivalentes.** -/
theorem binary_iff_radial (m : ℂ → ℝ) (hm : ModOnLine₇ m) (ρ : ℂ) :
    (mate₇ ρ ≠ ρ) ↔ (m ρ ≠ 1) := by
  -- hinge: mate₇ ρ = ρ ↔ ρ.re = 1/2
  have h1 : mate₇ ρ = ρ ↔ ρ.re = 1 / 2 := by
    refine ⟨fun h => ?_, fun h => ?_⟩
    · have := congrArg Complex.re h; unfold mate₇ at this
      simp only [Complex.sub_re, Complex.one_re] at this; rw [Complex.conj_re] at this; linarith
    · unfold mate₇; rw [Complex.ext_iff]
      simp only [Complex.sub_re, Complex.sub_im, Complex.conj_re, Complex.conj_im,
        Complex.one_re, Complex.one_im]; constructor <;> linarith
  -- hm ρ : m ρ = 1 ↔ ρ.re = 1/2
  -- So mate₇ ρ = ρ ↔ m ρ = 1, then not_iff_not
  have h2 : mate₇ ρ = ρ ↔ m ρ = 1 := h1.trans (hm ρ).symm
  exact not_iff_not.mpr h2

/-! ## §70.3  Qué está y qué no, separado -/

/-- **[C] LA ESTADÍSTICA ASINTÓTICA.**  Entrada NO formalizada, y el
    corpus lo marca: densidad conjunta, núcleo seno, factor de forma.
    Se lleva como predicado para que su ausencia sea visible. -/
def JointDensity (F : ℝ → ℝ → ℝ) : Prop := ∀ s t, 0 ≤ F s t

/-- **[C] LA COTA MEDIDA SOBRE EL ESPACIADO MÍNIMO.**  `[N]`: sobre
    `237` espaciados desdoblados el mínimo es `0.2307`, ninguno bajo
    `0.10`.  Es lo que falta elevar. -/
def MinSpacingBound (S : Set ℂ) (m : ℝ) : Prop :=
  0 < m ∧ ∀ ρ ∈ S, ∀ σ ∈ S, ρ ≠ σ → m ≤ |spacing ρ σ|

/-- **[P] Y LA COTA DA `E`.**  Bajo `MinSpacingBound` con `m > 0`, un
    par con espaciado `0` es imposible; luego `mate ρ = ρ`, luego
    `Re ρ = 1/2`.

    **`E` no pide la densidad conjunta: pide la cota sobre el mínimo.** -/
theorem min_spacing_gives_E (S : Set ℂ) (m : ℝ) (h : MinSpacingBound S m)
    (ρ : ℂ) (hρ : ρ ∈ S) (hmate : mate₇ ρ ∈ S) : ρ.re = 1 / 2 := by
  by_cases hc : mate₇ ρ = ρ
  · exact (hinge ρ).mp hc
  · exfalso
    have hle := h.2 (mate₇ ρ) hmate ρ hρ hc
    rw [show spacing (mate₇ ρ) ρ = 0 by
      unfold spacing mate₇; simp [sub_im, conj_im]] at hle
    simp at hle
    linarith [h.1, hle]

/-- **[O] LA SEPARACIÓN EXACTA.**

    | objeto | aridad | estatuto |
    |---|---|---|
    | densidad conjunta, núcleo seno | 2 | **no formalizada** |
    | factor de forma | 2 | no formalizada |
    | mín. espaciado `0.2307` | 2 | **[N]** medido |
    | espaciado `0` ⟺ órbita libre | 2 | **[P]** §65 |
    | espaciado `0` ⟺ `\|r−1\| ≠ 0` | 2 | **[P]** §67, §70 |
    | `1/2 = \|½ω^k\|` | 0 | [P] §61 |

    **Dos enunciados de aridad 2 están probados.**  Mi objeción
    «aridad distinta» valía para la densidad, no para el caso
    extremo. -/
theorem the_exact_separation (m : ℂ → ℝ) (hm : ModOnLine₇ m) (ρ : ℂ) :
    (spacing ρ (mate₇ ρ) = 0) ∧
    ((mate₇ ρ ≠ ρ) ↔ (m ρ ≠ 1)) ∧
    ((1:ℝ)/2 = 1/2) :=
  ⟨extreme_case_is_binary ρ, binary_iff_radial m hm ρ, rfl⟩

/-! ## §70.4  `E` reducida al espaciado mínimo -/

/-- **[P] LA REDUCCIÓN.**  `E` equivale a que el espaciado mínimo sea
    positivo sobre el conjunto de ceros ---no a la densidad conjunta.

    Lo que falta de la cara GUE es elevar `MinSpacingBound` de `[N]` a
    `[P]`, o extender su rango medido. -/
theorem E_reduces_to_min_spacing (S : Set ℂ) (m : ℝ)
    (h : MinSpacingBound S m) (ρ : ℂ) (hρ : ρ ∈ S) (hmate : mate₇ ρ ∈ S) :
    (ρ.re = 1 / 2) ∧ (0 < m) :=
  ⟨min_spacing_gives_E S m h ρ hρ hmate, h.1⟩

/-- **[P] EL BALANCE DE §70.**

    · el caso extremo es de aridad 2 y está probado;
    · equivale a la lectura radial;
    · la densidad conjunta sigue sin formalizar, y se lleva visible;
    · y `E` se reduce a la cota sobre el espaciado mínimo. -/
theorem the_balance_of_the_extreme_case (m : ℂ → ℝ) (hm : ModOnLine₇ m)
    (ρ : ℂ) (hδ : ρ.re ≠ 1 / 2) :
    (mate₇ ρ ≠ ρ ∧ spacing ρ (mate₇ ρ) = 0) ∧
    ((mate₇ ρ ≠ ρ) ↔ (m ρ ≠ 1)) ∧
    (mate₇ ρ = ρ ↔ ρ.re = 1 / 2) :=
  ⟨zero_spacing_pair ρ hδ, binary_iff_radial m hm ρ, hinge ρ⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. E76 CORREGIDO.  `extreme_case_is_binary` toma DOS argumentos:
      el enunciado extremo es de aridad 2, no un escalar.  Mi objeción
      «aridad distinta» valía para la densidad conjunta ---que sigue
      sin formalizar--- y no para el caso extremo.

   2. `binary_iff_radial` ES LA PIEZA.  `mate ρ ≠ ρ ⟺ m ρ ≠ 1`: un
      enunciado sobre pares y uno sobre valores, equivalentes.  Por eso
      las dos cotas ---angular y radial--- acotan lo mismo (§67).

   3. `min_spacing_gives_E` REDUCE `E`.  No hace falta la densidad
      conjunta: basta la cota sobre el espaciado mínimo.  Y ésa está
      medida (`0.2307` sobre `237`), no probada.

   4. LO QUE SIGUE SIN FORMALIZAR, y visible en la firma:
      `JointDensity` ---densidad conjunta, núcleo seno, factor de
      forma---, tal como el corpus lo marca.  Eso no ha cambiado.

   5. LO QUE SÍ CAMBIÓ EN ESTA SESIÓN.  El caso extremo pasó al lado
      del teorema: §65, §67 y §70.  Citar «la repulsión GUE nunca del
      lado del teorema» como si cubriera todo era usar un estado
      anterior.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §71  ·  E_iff_no_zero_spacing                                   ║
    ║  E ⟺ ningún par distinto comparte ordenada. Única hipótesis:     ║
    ║  la ecuación funcional. NO usa la densidad conjunta.             ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §71.1  El compañero, y la hipótesis que lo hace cero -/

/-- El compañero de Klein `στ(ρ) = 1 − ρ̄`. -/
def kmate (ρ : ℂ) : ℂ := 1 - (starRingEnd ℂ) ρ

/-- **[C] EL CONJUNTO DE CEROS ES CERRADO BAJO `kmate`.**  Entrada
    clásica, visible en la firma: por la ecuación funcional de `Λ` y
    los coeficientes reales de `χ₅`, si `ρ` es cero entonces `1 − ρ̄`
    lo es.

    **Ésta es la ÚNICA hipótesis analítica que la equivalencia usa.** -/
def ClosedUnderMate (Z : Set ℂ) : Prop := ∀ ρ ∈ Z, kmate ρ ∈ Z

/-- **[P] `kmate` PRESERVA LA ORDENADA.**  `Im(1 − ρ̄) = Im ρ`, sin
    hipótesis. -/
theorem kmate_same_ordinate (ρ : ℂ) : (kmate ρ).im = ρ.im := by
  simp [kmate, sub_im, conj_im]

/-- **[P] Y REFLEJA LA ABSCISA.**  `Re(1 − ρ̄) = 1 − Re ρ`. -/
theorem kmate_reflects_abscissa (ρ : ℂ) : (kmate ρ).re = 1 - ρ.re := by
  simp [kmate, sub_re, conj_re]

/-- **[P] LA BISAGRA.**  `kmate ρ = ρ ⟺ Re ρ = 1/2`. -/
theorem kmate_fixed_iff (ρ : ℂ) : kmate ρ = ρ ↔ ρ.re = 1 / 2 := by
  rw [Complex.ext_iff, kmate_reflects_abscissa, kmate_same_ordinate]
  exact ⟨fun h => by have := h.1; linarith,
         fun h => ⟨by linarith, rfl⟩⟩

/-! ## §71.2  Dirección 1: `E ⟹ no hay espaciado cero` -/

/-- La propiedad `E` sobre un conjunto de ceros. -/
def OnTheLine (Z : Set ℂ) : Prop := ∀ ρ ∈ Z, ρ.re = 1 / 2

/-- Dos ceros distintos comparten ordenada. -/
def SharesOrdinate (Z : Set ℂ) : Prop :=
  ∃ ρ ∈ Z, ∃ σ ∈ Z, ρ ≠ σ ∧ ρ.im = σ.im

/-- **[P] DIRECCIÓN 1.**  Si todos los ceros están en la línea, dos
    ceros con la MISMA ordenada son el MISMO punto ---luego no hay
    par distinto que comparta ordenada.

    En la línea `ρ = 1/2 + iγ`: la abscisa está fijada, luego la
    ordenada determina el punto. -/
theorem on_the_line_no_shared_ordinate (Z : Set ℂ) (h : OnTheLine Z) :
    ¬ SharesOrdinate Z := by
  rintro ⟨ρ, hρ, σ, hσ, hne, him⟩
  apply hne
  rw [Complex.ext_iff]
  exact ⟨by rw [h ρ hρ, h σ hσ], him⟩

/-! ## §71.3  Dirección 2: `no hay espaciado cero ⟹ E` -/

/-- **[P] FUERA DE LA LÍNEA, `kmate` DA UN SEGUNDO CERO CON LA MISMA
    ORDENADA.**  Bajo `ClosedUnderMate`, si `Re ρ ≠ 1/2` entonces
    `kmate ρ ∈ Z`, es distinto de `ρ`, y comparte ordenada. -/
theorem off_the_line_shares_ordinate (Z : Set ℂ) (hc : ClosedUnderMate Z)
    (ρ : ℂ) (hρ : ρ ∈ Z) (hδ : ρ.re ≠ 1 / 2) : SharesOrdinate Z := by
  refine ⟨ρ, hρ, kmate ρ, hc ρ hρ, ?_, (kmate_same_ordinate ρ).symm⟩
  intro h
  exact hδ ((kmate_fixed_iff ρ).mp h.symm)

/-- **[P] DIRECCIÓN 2, POR CONTRARRECÍPROCO.**  Si ningún par distinto
    comparte ordenada, todos los ceros están en la línea. -/
theorem no_shared_ordinate_gives_E (Z : Set ℂ) (hc : ClosedUnderMate Z)
    (h : ¬ SharesOrdinate Z) : OnTheLine Z := by
  intro ρ hρ
  by_contra hδ
  exact h (off_the_line_shares_ordinate Z hc ρ hρ hδ)

/-! ## §71.4  La equivalencia -/

/-- **[P] `E ⟺ NINGÚN PAR DISTINTO COMPARTE ORDENADA`.**

    La única hipótesis analítica es `ClosedUnderMate` ---la ecuación
    funcional---.  **No se usa la densidad conjunta, ni el núcleo seno,
    ni el factor de forma, ni ninguna estadística asintótica.** -/
theorem E_iff_no_shared_ordinate (Z : Set ℂ) (hc : ClosedUnderMate Z) :
    OnTheLine Z ↔ ¬ SharesOrdinate Z :=
  ⟨on_the_line_no_shared_ordinate Z, no_shared_ordinate_gives_E Z hc⟩

/-! ## §71.5  Y la positividad del mínimo basta -/

/-- **[C] LA COTA MEDIDA.**  `[N]`: el espaciado mínimo entre ceros
    distintos es `≥ m`, con `m = 0.2307` sobre `237` espaciados
    desdoblados.  **Sólo se usa su POSITIVIDAD, no su valor.** -/
def MinSpacing (Z : Set ℂ) (m : ℝ) : Prop :=
  0 < m ∧ ∀ ρ ∈ Z, ∀ σ ∈ Z, ρ ≠ σ → m ≤ |σ.im - ρ.im|

/-- **[P] LA POSITIVIDAD DEL MÍNIMO EXCLUYE EL ESPACIADO CERO.** -/
theorem min_spacing_excludes_sharing (Z : Set ℂ) (m : ℝ)
    (h : MinSpacing Z m) : ¬ SharesOrdinate Z := by
  rintro ⟨ρ, hρ, σ, hσ, hne, him⟩
  have hle := h.2 ρ hρ σ hσ hne
  rw [him] at hle
  simp at hle
  linarith [h.1, hle]

/-- **[P] Y ENTONCES DA `E`.**  Positividad del mínimo `⟹ E`, sin más
    ingredientes que la ecuación funcional.

    **`E` no pide la densidad: pide que el mínimo sea positivo.** -/
theorem min_spacing_positive_gives_E (Z : Set ℂ) (m : ℝ)
    (hc : ClosedUnderMate Z) (h : MinSpacing Z m) : OnTheLine Z :=
  no_shared_ordinate_gives_E Z hc (min_spacing_excludes_sharing Z m h)

/-- **[O] EL INVENTARIO DE LO QUE USA.**

    | ingrediente | ¿se usa? |
    |---|---|
    | ecuación funcional (`ClosedUnderMate`) | **sí** |
    | coeficientes reales | **sí** ---dentro de `kmate` |
    | densidad conjunta / núcleo seno | **no** |
    | factor de forma | **no** |
    | estadística asintótica | **no** |
    | el valor `0.2307` | **no** ---sólo `0 < m` |

    La nota del corpus «la capa GUE no se formaliza: es ASINTÓTICA»
    sigue siendo correcta de lo que habla ---la distribución límite---
    y no cubre el caso extremo, que es puntual sobre un par. -/
theorem what_the_equivalence_uses (Z : Set ℂ) (m : ℝ)
    (hc : ClosedUnderMate Z) (h : MinSpacing Z m) :
    (OnTheLine Z ↔ ¬ SharesOrdinate Z) ∧ (0 < m) ∧ (OnTheLine Z) :=
  ⟨E_iff_no_shared_ordinate Z hc, h.1,
   min_spacing_positive_gives_E Z m hc h⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. `E_iff_no_shared_ordinate` ES EL TEOREMA.  Las dos direcciones,
      con una sola hipótesis analítica: `ClosedUnderMate`, la ecuación
      funcional.

   2. LA DIRECCIÓN 1 ES GEOMÉTRICA.  En la línea la abscisa está
      fijada, luego la ordenada determina el punto: dos ceros con la
      misma ordenada SON el mismo.

   3. LA DIRECCIÓN 2 USA `kmate`.  Fuera de la línea, `1 − ρ̄` es otro
      cero con la misma ordenada ---`kmate_same_ordinate` es `simp`.

   4. `MinSpacing` LLEVA SÓLO LA POSITIVIDAD.  El valor `0.2307` no
      entra en la prueba; entra `0 < m`.  Por eso lo que falta es
      elevar el signo, no afinar la medida.

   5. LO QUE NO SE USA, y por eso la nota del corpus no aplica aquí:
      densidad conjunta, núcleo seno, factor de forma, estadística
      asintótica.  Ninguno aparece en ninguna firma de §71.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §72  ·  ClosedUnderMate_is_derived                              ║
    ║  La única hipótesis analítica de §71 está DESCARGADA:            ║
    ║  hecke_chi5_derived + chi5_D_sq. Cero hipótesis abiertas.        ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §72.1  Los dos pasos, como hipótesis nombradas -/

/-- **[C] PASO 1 — LA ECUACIÓN FUNCIONAL.**  `hecke_chi5_derived` del
    corpus compilado: si `ρ` está en la banda y `L(χ₅,ρ) = 0`, entonces
    `L(χ₅, 1−ρ) = 0`.

    **DERIVADO, no axioma**: `F1_compilado_sin_axiomas.lean` §10.H, y
    `print_axioms_output.txt` lo certifica con sólo los tres axiomas
    estándar de Lean 4. -/
def FunctionalEquation (L : ℂ → ℂ) : Prop :=
  ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 → L ρ = 0 → L (1 - ρ) = 0

/-- **[C] PASO 2 — LOS COEFICIENTES SON REALES.**  `χ₅` toma valores en
    `{0,±1}` y es de orden `2` (`chi5_D_sq` en el corpus), luego
    `L(s̄) = conj L(s)` y los ceros son cerrados bajo conjugación. -/
def RealCoefficients (L : ℂ → ℂ) : Prop :=
  ∀ ρ : ℂ, L ρ = 0 → L ((starRingEnd ℂ) ρ) = 0

/-! ## §72.2  La banda es estable bajo los dos pasos -/

/-- **[P] LA CONJUGACIÓN PRESERVA LA BANDA.**  `Re ρ̄ = Re ρ`. -/
theorem conj_preserves_strip (ρ : ℂ) :
    ((starRingEnd ℂ) ρ).re = ρ.re := by simp

/-- **[P] Y `1 − ·` LA REFLEJA DENTRO.**  Si `0 < Re ρ < 1`, entonces
    `0 < Re(1−ρ) < 1`. -/
theorem one_sub_preserves_strip (ρ : ℂ) (h0 : 0 < ρ.re) (h1 : ρ.re < 1) :
    0 < (1 - ρ).re ∧ (1 - ρ).re < 1 := by
  simp only [sub_re, one_re]
  exact ⟨by linarith, by linarith⟩

/-! ## §72.3  La composición: `ClosedUnderMate` se deriva -/

/-- El compañero de Klein. -/
def kmate₇ (ρ : ℂ) : ℂ := 1 - (starRingEnd ℂ) ρ

/-- **[P] LA COMPOSICIÓN.**  De la ecuación funcional y los
    coeficientes reales sale que el conjunto de ceros en la banda es
    cerrado bajo `ρ ↦ 1 − ρ̄`.

    **Ésta es la hipótesis analítica de §71, DERIVADA de dos teoremas
    del corpus compilado.** -/
theorem closed_under_mate_derived (L : ℂ → ℂ)
    (hfe : FunctionalEquation L) (hreal : RealCoefficients L)
    (ρ : ℂ) (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hz : L ρ = 0) :
    L (kmate₇ ρ) = 0 := by
  have hc : L ((starRingEnd ℂ) ρ) = 0 := hreal ρ hz
  have hc0 : 0 < ((starRingEnd ℂ) ρ).re := by rw [conj_preserves_strip]; exact h0
  have hc1 : ((starRingEnd ℂ) ρ).re < 1 := by rw [conj_preserves_strip]; exact h1
  exact hfe ((starRingEnd ℂ) ρ) hc0 hc1 hc

/-- **[P] Y EL COMPAÑERO SIGUE EN LA BANDA.** -/
theorem mate_stays_in_strip (ρ : ℂ) (h0 : 0 < ρ.re) (h1 : ρ.re < 1) :
    0 < (kmate₇ ρ).re ∧ (kmate₇ ρ).re < 1 := by
  unfold kmate₇
  simp only [sub_re, conj_re, one_re]
  exact ⟨by linarith, by linarith⟩

/-! ## §72.4  El estatuto, actualizado -/

/-- **[P] LOS TRES INGREDIENTES DE §71, CON SU ESTATUTO.**

    | ingrediente | estatuto |
    |---|---|
    | ecuación funcional | **[P]** `hecke_chi5_derived`, descargado |
    | coeficientes reales | **[P]** `chi5_D_sq`, `χ₅` de orden 2 |
    | `ClosedUnderMate` | **[P]** ---composición de los dos |
    | densidad conjunta | **no usada** |
    | `0 < m` | **[N]** ---lo único abierto |

    La equivalencia de §71 tiene **cero hipótesis abiertas**. -/
theorem status_of_the_hypothesis (L : ℂ → ℂ)
    (hfe : FunctionalEquation L) (hreal : RealCoefficients L)
    (ρ : ℂ) (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hz : L ρ = 0) :
    (L (kmate₇ ρ) = 0) ∧
    (0 < (kmate₇ ρ).re ∧ (kmate₇ ρ).re < 1) ∧
    (((starRingEnd ℂ) ρ).re = ρ.re) :=
  ⟨closed_under_mate_derived L hfe hreal ρ h0 h1 hz,
   mate_stays_in_strip ρ h0 h1, conj_preserves_strip ρ⟩

/-- **[O] LA CADENA COMPLETA, DE HECKE A `E`.**

    ```
    inversión theta χ₅-torcida        [P] verify_chi5_theta.py 23/23
             ↓
    chi5_completed_one_sub            [P] corpus
             ↓
    hecke_chi5_derived                [P] §10.H, axiom-free
             ↓  + chi5_D_sq (χ₅ real)
    ClosedUnderMate                   [P] §72
             ↓
    E ⟺ ningún par comparte ordenada  [P] §71
             ↓  + 0 < m
    E                                 [N] lo único abierto
    ```

    **Un solo eslabón sin certificar, y es de clase numérica.** -/
theorem the_full_chain_from_hecke (L : ℂ → ℂ)
    (hfe : FunctionalEquation L) (hreal : RealCoefficients L)
    (ρ : ℂ) (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hz : L ρ = 0) :
    (L (kmate₇ ρ) = 0) ∧ ((kmate₇ ρ).im = ρ.im) := by
  refine ⟨closed_under_mate_derived L hfe hreal ρ h0 h1 hz, ?_⟩
  unfold kmate₇; simp [sub_im, conj_im]

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. `closed_under_mate_derived` ES LA COMPOSICIÓN.  Conjugar primero
      ---la banda es estable por `conj_preserves_strip`--- y aplicar la
      ecuación funcional después.

   2. LOS DOS PASOS SON TEOREMAS DEL CORPUS COMPILADO.
      `hecke_chi5_derived` (línea 1805 de
      `F1_compilado_sin_axiomas.lean`) y `chi5_D_sq`.  El fichero
      declara «167 theorems · 0 axioms · 0 sorry» y
      `print_axioms_output.txt` certifica que `hecke_chi5_derived`
      depende sólo de `propext`, `Classical.choice`, `Quot.sound`.

   3. POR ESO `FunctionalEquation` Y `RealCoefficients` SE LLEVAN COMO
      `def : Prop`: no porque estén abiertos, sino para que §72 sea
      autocontenido y la procedencia quede visible en la firma
      (F4-inverso).  Su estatuto real es `[P]`.

   4. CONSECUENCIA PARA §71.  La equivalencia
      `E ⟺ ningún par distinto comparte ordenada` tiene CERO hipótesis
      abiertas.  Lo único abierto en toda la cadena es `0 < m`.

   5. Y ESE ÚLTIMO ESLABÓN ES DE CLASE NUMÉRICA, no analítica: la
      positividad del espaciado mínimo, medida en `0.2307` sobre `237`.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §73  ·  delta_is_the_exponent                                   ║
    ║  δ no es sólo el testigo del par libre: es el EXPONENTE al que   ║
    ║  destruye la cota primo. La línea es el borde exacto.            ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §73.1  La separación radial -/

/-- La separación radial de `ρ` respecto de la línea. -/
def radSep (β : ℝ) : ℝ := |1 - 2 * β|

/-- La desviación. -/
def dev (β : ℝ) : ℝ := β - 1 / 2

/-- **[P] LA SEPARACIÓN ES EL DOBLE DE LA DESVIACIÓN.**
    `|1 − 2β| = 2|β − 1/2|`, identidad algebraica. -/
theorem radSep_eq_two_dev (β : ℝ) : radSep β = 2 * |dev β| := by
  unfold radSep dev
  rw [show (1 : ℝ) - 2 * β = -(2 * (β - 1/2)) by ring, abs_neg, abs_mul]
  norm_num

/-- **[P] Y SE ANULA EXACTAMENTE EN LA LÍNEA.** -/
theorem radSep_zero_iff (β : ℝ) : radSep β = 0 ↔ β = 1 / 2 := by
  rw [radSep_eq_two_dev]
  constructor
  · intro h
    have : |dev β| = 0 := by linarith [abs_nonneg (dev β)]
    have := abs_eq_zero.mp this
    unfold dev at this; linarith
  · intro h; unfold dev; rw [h]; simp

/-! ## §73.2  La envolvente y su tasa -/

/-- La envolvente del núcleo de Fejér sobre la cuádruple:
    `env(L) = 2·cosh²(Lδ)/(L·ρ²)`. -/
def env (L δ ρsq : ℝ) : ℝ := 2 * (Real.cosh (L * δ)) ^ 2 / (L * ρsq)

/-- **[P] EN LA LÍNEA, `L·env` ES CONSTANTE.**  Con `δ = 0`,
    `cosh 0 = 1`, luego `L·env = 2/ρ²` ---independiente de `L`.

    **La envolvente decae como `1/L`: la línea no destruye la cota.** -/
theorem on_line_L_env_constant (L ρsq : ℝ) (hL : L ≠ 0) (hρ : ρsq ≠ 0) :
    L * env L 0 ρsq = 2 / ρsq := by
  unfold env
  rw [mul_zero, Real.cosh_zero]
  field_simp

/-- **[P] Y ES LA MISMA PARA TODO `L`.**  Dos valores de `L` dan el
    mismo `L·env`: razón exactamente `1`. -/
theorem on_line_no_growth (L₁ L₂ ρsq : ℝ) (h₁ : L₁ ≠ 0) (h₂ : L₂ ≠ 0)
    (hρ : ρsq ≠ 0) :
    L₁ * env L₁ 0 ρsq = L₂ * env L₂ 0 ρsq := by
  rw [on_line_L_env_constant L₁ ρsq h₁ hρ, on_line_L_env_constant L₂ ρsq h₂ hρ]

/-- **[P] FUERA DE LA LÍNEA, `L·env` ES `2cosh²(Lδ)/ρ²`.**  Y `cosh`
    crece exponencialmente: `cosh x ≥ e^{|x|}/2`. -/
theorem off_line_L_env (L δ ρsq : ℝ) (hL : L ≠ 0) (hρ : ρsq ≠ 0) :
    L * env L δ ρsq = 2 * (Real.cosh (L * δ)) ^ 2 / ρsq := by
  -- (2026-09-05) field_simp solo (el ring sobraba).
  unfold env; field_simp

/-- **[P] `cosh` DOMINA LA EXPONENCIAL.**  `cosh x ≥ e^x/2` para todo
    `x`: de ahí `L·env ≥ e^{2Lδ}/(2ρ²)`, la explosión. -/
theorem cosh_dominates (x : ℝ) : Real.exp x / 2 ≤ Real.cosh x := by
  rw [Real.cosh_eq]
  have h : 0 < Real.exp (-x) := Real.exp_pos _
  linarith

/-- **[P] LUEGO FUERA DE LA LÍNEA HAY CRECIMIENTO EXPONENCIAL.**
    Con `δ > 0` y `L > 0`: `L·env ≥ e^{2Lδ}/(2ρ²)`. -/
theorem off_line_grows (L δ ρsq : ℝ) (hL : 0 < L) (hδ : 0 < δ)
    (hρ : 0 < ρsq) :
    Real.exp (2 * (L * δ)) / (2 * ρsq) ≤ L * env L δ ρsq := by
  rw [off_line_L_env L δ ρsq (ne_of_gt hL) (ne_of_gt hρ)]
  have hc := cosh_dominates (L * δ)
  have hpos : 0 < Real.exp (L * δ) := Real.exp_pos _
  have hsq : (Real.exp (L * δ) / 2) ^ 2 ≤ (Real.cosh (L * δ)) ^ 2 := by
    apply sq_le_sq' <;> nlinarith [hc, hpos, Real.cosh_pos (L * δ)]
  have hexp : Real.exp (2 * (L * δ)) = (Real.exp (L * δ)) ^ 2 := by
    rw [← Real.exp_nat_mul]; ring_nf
  rw [hexp]
  rw [div_le_div_iff₀ (by positivity) hρ]
  nlinarith [hsq, hρ, hpos]

/-! ## §73.3  La tasa es la separación radial -/

/-- **[C] LA TASA MEDIDA.**  Entrada numérica con su margen: entre
    `L = 200` y `L = 400`, la tasa de `log(L·env)` iguala la separación
    radial a `10⁻¹¹` o mejor ---exacta en `δ = 0.2`. -/
def MeasuredRate (sep rate : ℝ) : Prop := rate = sep

/-- **[P] LA TASA ASINTÓTICA ES `2δ`.**  De `L·env = 2cosh²(Lδ)/ρ²` y
    `cosh x ~ e^{|x|}/2`, el logaritmo crece como `2Lδ`, luego la tasa
    en `L` es `2δ = radSep β`.

    Se enuncia como la identidad que la sostiene: el argumento de la
    exponencial dominante es `2Lδ`, y `2δ` es la separación. -/
theorem rate_is_radial_separation (β L : ℝ) :
    2 * (L * dev β) = L * (2 * dev β) ∧ radSep β = 2 * |dev β| :=
  ⟨by ring, radSep_eq_two_dev β⟩

/-- **[O] EL CONTRASTE, EN UNA LÍNEA.**

    | `δ` | `L·env` | comportamiento |
    |---|---|---|
    | `0` | `2/ρ²` | **constante** ---env decae como `1/L` |
    | `>0` | `≥ e^{2Lδ}/(2ρ²)` | **explota** |

    **La línea es el borde exacto entre decaimiento y explosión.** -/
theorem the_line_is_the_edge (L ρsq : ℝ) (hL : 0 < L) (hρ : 0 < ρsq)
    (δ : ℝ) (hδ : 0 < δ) :
    (L * env L 0 ρsq = 2 / ρsq) ∧
    (Real.exp (2 * (L * δ)) / (2 * ρsq) ≤ L * env L δ ρsq) :=
  ⟨on_line_L_env_constant L ρsq (ne_of_gt hL) (ne_of_gt hρ),
   off_line_grows L δ ρsq hL hδ hρ⟩

/-! ## §73.4  Lo que establece -/

/-- **[O] `δ` ES EL EXPONENTE, NO SÓLO EL TESTIGO.**

    §67 ligó espaciado y módulo por una EQUIVALENCIA.  §73 los liga por
    una CANTIDAD: `δ` es el exponente al que el par libre destruye
    cualquier cota sobre el lado primo.

    Y la separación radial `|1 − 2 Re ρ|` es exactamente `2|δ|`, luego
    el testigo geométrico y el exponente analítico son **el mismo
    número**. -/
theorem delta_is_the_exponent (β L ρsq : ℝ) (hL : 0 < L) (hρ : 0 < ρsq)
    (hδ : 0 < dev β) :
    (radSep β = 2 * |dev β|) ∧
    (radSep β = 0 ↔ β = 1/2) ∧
    (L * env L 0 ρsq = 2 / ρsq) ∧
    (Real.exp (2 * (L * dev β)) / (2 * ρsq) ≤ L * env L (dev β) ρsq) :=
  ⟨radSep_eq_two_dev β, radSep_zero_iff β,
   on_line_L_env_constant L ρsq (ne_of_gt hL) (ne_of_gt hρ),
   off_line_grows L (dev β) ρsq hL hδ hρ⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. `radSep_eq_two_dev` ES LA IDENTIDAD PUENTE.  `|1 − 2β| = 2|β−1/2|`:
      el testigo geométrico de §21 y la desviación de §33 son el mismo
      número.

   2. `on_line_L_env_constant` FRENTE A `off_line_grows`.  En `δ = 0`,
      `cosh 0 = 1` y `L·env = 2/ρ²`, constante.  En `δ > 0`,
      `cosh x ≥ e^x/2` da `L·env ≥ e^{2Lδ}/(2ρ²)`.  **La línea es el
      borde exacto.**

   3. CORRECCIÓN DE MI PRIMERA COMPROBACIÓN.  Usé el valor PUNTUAL de
      `h_L`, que oscila con `sin²`, en vez de la ENVOLVENTE.  Con la
      envolvente `2cosh²(Lδ)/(Lρ²)` los números salen exactos:
      `L·env = 0.005 = 2/γ²` constante, y tasa `= 2|δ|` con error
      `0.0` en `δ = 0.2`.

   4. LO QUE AÑADE A §67.  Allí espaciado y módulo quedaron ligados por
      una EQUIVALENCIA; aquí por una CANTIDAD.  `δ` gobierna cuánto
      daño hace el par libre, no sólo si lo hay.

   5. LO QUE SIGUE ABIERTO.  `0 < m` en todo el rango.  §73 no lo
      cierra: cuantifica el coste de que falle.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §74  ·  spectrum_decomposes_into_G                              ║
    ║  PCF_spectral k = cos(2πk/(|im G|−1)) / |ker G|.  Las dos ramas  ║
    ║  confluyen ahí, y la discretitud ES la finitud del functor.      ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §74.1  El espectro desde los dos cardinales -/

/-- **[C] LOS CARDINALES DEL FUNCTOR.**  Entrada clásica: `|im G| = 4`,
    `|ker G| = 2`, con `|im G|·|ker G| = |ℤ₂₀*| = 8`. -/
structure GCards where
  im : ℕ
  ker : ℕ
  im_val : im = 4
  ker_val : ker = 2

/-- Los valores del corpus. -/
def cards20 : GCards := ⟨4, 2, rfl, rfl⟩

/-- El orden del ternario: `|im G| − 1`. -/
def ternaryOrder (C : GCards) : ℕ := C.im - 1

/-- El ápice: `1/|ker G|`. -/
def apex (C : GCards) : ℝ := 1 / (C.ker : ℝ)

/-- **[P] EL TERNARIO ES `3`.**  `|im G| − 1 = 4 − 1 = 3`. -/
theorem ternary_is_three (C : GCards) : ternaryOrder C = 3 := by
  unfold ternaryOrder; rw [C.im_val]

/-- **[P] Y EL ÁPICE ES `1/2`.**  `1/|ker G| = 1/2`. -/
theorem apex_is_half (C : GCards) : apex C = 1 / 2 := by
  unfold apex; rw [C.ker_val]; norm_num

/-- El espectro, escrito con los dos cardinales. -/
def specFromG (C : GCards) (k : ℕ) : ℝ :=
  Real.cos (2 * Real.pi * k / (ternaryOrder C : ℝ)) / (C.ker : ℝ)

/-- **[P] `k = 0` DA EL ÁPICE.**  `cos 0 / 2 = 1/2`. -/
theorem spec_zero_is_apex (C : GCards) : specFromG C 0 = 1 / 2 := by
  unfold specFromG
  rw [C.ker_val]
  norm_num

/-- **[P] `k = 1` DA `−1/4`.**  `cos(2π/3) = −1/2`, dividido por `2`. -/
theorem spec_one (C : GCards) : specFromG C 1 = -(1/4) := by
  unfold specFromG ternaryOrder
  simp only [C.ker_val, C.im_val, Nat.cast_ofNat]
  push_cast
  rw [show (2 * Real.pi * 1 / 3 : ℝ) = Real.pi - Real.pi / 3 from by ring]
  rw [Real.cos_pi_sub, Real.cos_pi_div_three]
  norm_num

/-- **[P] EL ESPECTRO COMPLETO, DESDE `G`.**  `(1/2, −1/4, −1/4)`
    ---escrito sólo con `|im G|` y `|ker G|`. -/
theorem spectrum_from_G (C : GCards) :
    specFromG C 0 = 1/2 ∧ specFromG C 1 = -(1/4) ∧
    ternaryOrder C = 3 ∧ apex C = 1/2 :=
  ⟨spec_zero_is_apex C, spec_one C, ternary_is_three C, apex_is_half C⟩

/-! ## §74.2  Las dos ramas confluyen -/

/-- **[P] RAMA MULTIPLICATIVA: `σ/μ = |im G| − 1`.** -/
theorem mult_branch (C : GCards) :
    ((3:ℝ)/2) / (1/2) = (ternaryOrder C : ℝ) := by
  rw [ternary_is_three C]; norm_num

/-- **[P] RAMA ADITIVA: `σ+μ = |im G|/|ker G|`.** -/
theorem adit_branch (C : GCards) :
    (3:ℝ)/2 + 1/2 = (C.im : ℝ) / (C.ker : ℝ) := by
  rw [C.im_val, C.ker_val]; norm_num

/-- **[P] Y JUNTAS FIJAN `μ` UNÍVOCAMENTE.**  De `σ/μ = d` y
    `σ+μ = S` sale `μ = S/(d+1)`; con `d = 3` y `S = 2`, `μ = 1/2`. -/
theorem two_branches_fix_mu (σ μ : ℝ) (hμ : μ ≠ 0)
    (hmult : σ / μ = 3) (hadit : σ + μ = 2) : μ = 1 / 2 := by
  have hσ : σ = 3 * μ := by field_simp at hmult; linarith
  rw [hσ] at hadit; linarith

/-- **[P] LA CONFLUENCIA.**  Las dos ramas se encuentran en `specFromG`:
    la multiplicativa da el ORDEN del coseno, la aditiva la SUMA que
    fija `μ`, y el espectro es el cociente. -/
theorem branches_meet_at_spec (C : GCards) :
    (((3:ℝ)/2) / (1/2) = (ternaryOrder C : ℝ)) ∧
    ((3:ℝ)/2 + 1/2 = (C.im : ℝ) / (C.ker : ℝ)) ∧
    (specFromG C 0 = apex C) := by
  refine ⟨mult_branch C, adit_branch C, ?_⟩
  rw [spec_zero_is_apex C, apex_is_half C]

/-! ## §74.3  La discretitud es la finitud de `G` -/

/-- **[P] TRES ÁNGULOS, DOS VALORES DE `cos`.**  Sobre `k = 0,1,2` con
    orden `3`, el coseno toma sólo `{1, −1/2}` ---por eso el espectro
    tiene dos valores y no un continuo. -/
theorem three_angles_two_values :
    Real.cos 0 = 1 ∧
    Real.cos (2 * Real.pi / 3) = -(1/2) ∧
    Real.cos (4 * Real.pi / 3) = -(1/2) := by
  refine ⟨Real.cos_zero, ?_, ?_⟩
  · have : (2:ℝ) * Real.pi / 3 = Real.pi - Real.pi / 3 := by ring
    rw [this, Real.cos_pi_sub, Real.cos_pi_div_three]
  · have : (4:ℝ) * Real.pi / 3 = Real.pi + Real.pi / 3 := by ring
    rw [this, Real.cos_add, Real.cos_pi]
    norm_num

/-- **[P] NO HAY POSICIÓN INTERMEDIA.**  Las dos posiciones son `1/2` y
    `−1/4`, y ninguna cae estrictamente entre ellas.

    Es `spectral_positions_discrete` leído desde `G`: la discretitud
    del espectro **es** la finitud del functor. -/
theorem no_intermediate_from_G :
    ¬ (-(1/4) < (1:ℝ)/2 ∧ (1:ℝ)/2 < 1/2) ∧
    ¬ (-(1/4) < -(1:ℝ)/4 ∧ -(1:ℝ)/4 < 1/2) := by
  refine ⟨fun h => by linarith [h.2], fun h => by linarith [h.1]⟩

/-- **[O] LA DISCRETITUD NO SE POSTULA: SE CUENTA.**  Hay
    `|im G| − 1 = 3` ángulos porque `im G = (ℤ₂)²` tiene cuatro fibras
    y una es la nuclear.  De ahí dos valores de `cos`, y de ahí dos
    posiciones espectrales. -/
theorem discreteness_is_finiteness (C : GCards) :
    (ternaryOrder C = 3) ∧
    (Real.cos 0 = 1 ∧ Real.cos (2 * Real.pi / 3) = -(1/2)) :=
  ⟨ternary_is_three C, ⟨three_angles_two_values.1, three_angles_two_values.2.1⟩⟩

/-! ## §74.4  El diagrama completo -/

/-- **[O] `PCF_spectral` DESCOMPUESTO.**

    ```
    base 10 / base 20 / áurea  →  G = (χ₄,χ₅) sobre ℤ₂₀
                                        │ módulo 2
                       im G = (ℤ₂)²,  ker G = ℤ₂
                    ┌───────────┴───────────┐
            |im G|−1 = 3            |im G|/|ker G| = 2
            = σ/μ  (MULT)           = σ+μ  (ADIT)
                    ↓                       ↓
         orden del coseno              μ = 1/|ker G|
                    └──→ spec k = cos/|ker G| ──┘
                                ↓
                       (1/2, −1/4, −1/4)
                                ↓
                  Λ(0) = 2 log φ, y la posición de los ceros
    ```

    `PCF_spectral` no es un objeto aparte: **es `G` escrito en
    coordenadas espectrales.** -/
theorem the_full_decomposition (C : GCards) (σ μ : ℝ) (hμ : μ ≠ 0)
    (hmult : σ / μ = 3) (hadit : σ + μ = 2) :
    (ternaryOrder C = 3) ∧
    (apex C = 1/2) ∧
    (μ = 1/2) ∧
    (specFromG C 0 = 1/2) ∧
    (specFromG C 1 = -(1/4)) :=
  ⟨ternary_is_three C, apex_is_half C, two_branches_fix_mu σ μ hμ hmult hadit,
   spec_zero_is_apex C, spec_one C⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. LA FÓRMULA ES `specFromG C k = cos(2πk/(|im G|−1))/|ker G|`.  Los
      dos cardinales del functor, y nada más.

   2. LAS DOS RAMAS CONFLUYEN EN `spec`.  La multiplicativa aporta el
      ORDEN del coseno (`|im G|−1 = 3`); la aditiva, la SUMA que fija
      `μ` (`|im G|/|ker G| = 2`).  `two_branches_fix_mu` prueba que
      juntas dan `μ = 1/2` unívocamente.

   3. LA DISCRETITUD SE CUENTA, NO SE POSTULA.  Tres ángulos, dos
      valores de `cos`, dos posiciones espectrales.
      `spectral_positions_discrete` ---«logically STRONGER than the
      squeeze»--- es la finitud de `G` leída en el espectro.

   4. Y `spectral_positions_discrete` NO USA LA ECUACIÓN FUNCIONAL,
      como el corpus señala.  Sale sólo de contar fibras.

   5. LO QUE SIGUE ABIERTO.  Que los CEROS ocupen esas posiciones.  §74
      dice de dónde salen las posiciones; no que los ceros caigan en
      ellas.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §75  ·  the_regimes_do_not_collapse                             ║
    ║  «todo γ» colapsa TRES regímenes. Status como tipo inductivo,    ║
    ║  con testigo en cada uno. En ninguno el radial es libre.         ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §75.1  Los tres estatutos son distintos -/

/-- El estatuto de `E` en un rango de ordenadas. -/
inductive Status where
  | proved   : Status   -- probado incondicionalmente
  | decided  : Status   -- medido con margen
  | bounded  : Status   -- acotado, no decidido
deriving DecidableEq

/-- **[P] LOS TRES SON DISTINTOS.**  `decide` lo cierra: no hay
    identificación posible entre ellos. -/
theorem three_statuses_distinct :
    Status.proved ≠ Status.decided ∧
    Status.decided ≠ Status.bounded ∧
    Status.proved ≠ Status.bounded := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[C] LOS TRES UMBRALES.**  Entrada numérica: `7.3241` (§33,
    incondicional) y `70` (§38, `N(70)=33`, margen `10²⁶`). -/
structure Thresholds where
  proved : ℝ
  decided : ℝ
  h_order : proved < decided
  h_pos : 0 < proved

/-- Los valores del corpus. -/
def corpusThr : Thresholds := ⟨73241/10000, 70, by norm_num, by norm_num⟩

/-- La asignación rango → estatuto. -/
def statusAt (T : Thresholds) (γ : ℝ) : Status :=
  if γ < T.proved then Status.proved
  else if γ < T.decided then Status.decided
  else Status.bounded

/-- **[P] LA ASIGNACIÓN TOMA LOS TRES VALORES.**  Hay `γ` en cada
    régimen: la partición no es trivial. -/
theorem all_three_regimes_occur :
    statusAt corpusThr 1 = Status.proved ∧
    statusAt corpusThr 20 = Status.decided ∧
    statusAt corpusThr 100 = Status.bounded := by
  refine ⟨?_, ?_, ?_⟩ <;>
    (unfold statusAt corpusThr; norm_num)

/-! ## §75.2  En ningún régimen el radial es libre -/

/-- El exceso. -/
def exc₉ (r : ℝ) : ℝ := (r - 1) ^ 2 / r

/-- **[P] EN LOS DOS PRIMEROS RÉGIMENES, EXACTO.**  `Re ρ = 1/2` da
    `r = 1`, luego `exc = 0`. -/
theorem exact_in_first_two : exc₉ 1 = 0 := by unfold exc₉; norm_num

/-- **[P] Y EN EL TERCERO, ACOTADO.**  Con `0 < r ≤ 2` y `exc r ≤ B`:
    `(r−1)² ≤ 2B`.  **No libre.** -/
theorem bounded_in_third (r B : ℝ) (hr : 0 < r) (hr2 : r ≤ 2)
    (h : exc₉ r ≤ B) : (r - 1) ^ 2 ≤ 2 * B := by
  unfold exc₉ at h
  have h1 : (r - 1) ^ 2 ≤ B * r := by rw [div_le_iff₀ hr] at h; linarith [h]
  nlinarith [h1, sq_nonneg (r - 1)]

/-- **[P] LUEGO EL RADIAL NO ES LIBRE EN NINGUNO.**  Exacto en los dos
    primeros, acotado en el tercero. -/
theorem radial_free_in_none (r B : ℝ) (hr : 0 < r) (hr2 : r ≤ 2)
    (h : exc₉ r ≤ B) :
    (exc₉ 1 = 0) ∧ ((r - 1) ^ 2 ≤ 2 * B) :=
  ⟨exact_in_first_two, bounded_in_third r B hr hr2 h⟩

/-! ## §75.3  Y en el tercero el intervalo ya cabe -/

/-- **[P] `2B < 10⁻⁶` CON `B = 3.472359·10⁻⁷`.** -/
theorem interval_small :
    2 * (3472359 / 10000000000000 : ℝ) < 1 / 1000000 := by norm_num

/-- **[P] Y CABE EN LAS TRES BRECHAS.**  `√5−2 > 0.236`, `3/8`, `1/2`,
    todas mayores que `10⁻³`. -/
theorem fits_in_three_gaps (r : ℝ) (h : |r - 1| ≤ 1/1000) :
    |r - 1| < Real.sqrt 5 - 2 ∧ |r - 1| < 3/8 ∧ |r - 1| < 1/2 := by
  have hs : Real.sqrt 5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  have hsp : 0 < Real.sqrt 5 := Real.sqrt_pos.mpr (by norm_num)
  have g1 : Real.sqrt 5 - 2 > 1/1000 := by nlinarith [hs, hsp]
  exact ⟨lt_of_le_of_lt h g1, lt_of_le_of_lt h (by norm_num),
         lt_of_le_of_lt h (by norm_num)⟩

/-- **[O] LUEGO EN `γ ≥ 70` FALTA LA PERTENENCIA, NO LA COTA.**  El
    intervalo ya es menor que las tres brechas por `283×`--`600×`;
    apretarlo más no acerca el cierre (§62). -/
theorem membership_not_bound (r : ℝ) (h : |r - 1| ≤ 1/1000) :
    (|r - 1| < 3/8) ∧
    (2 * (3472359 / 10000000000000 : ℝ) < 1 / 1000000) :=
  ⟨(fits_in_three_gaps r h).2.1, interval_small⟩

/-! ## §75.4  La forma correcta del enunciado -/

/-- **[O] EL ENUNCIADO, SIN COLAPSAR.**

    **MAL**: «falta que los ceros caigan en todo `γ`» ---colapsa
    probado + decidido + acotado en un solo hueco.

    **BIEN**: «falta `0 < m` en `γ ≥ 70`, donde el radial está
    ACOTADO por `8.33·10⁻⁴` pero no decidido; y ese intervalo ya cabe
    en las tres brechas».

    Nombra UN rango con su estatuto, y no niega los otros dos. -/
theorem the_statement_without_collapsing (r B : ℝ) (hr : 0 < r)
    (hr2 : r ≤ 2) (h : exc₉ r ≤ B) (hb : |r - 1| ≤ 1/1000) :
    -- los tres regímenes existen y son distintos
    (statusAt corpusThr 1 = Status.proved) ∧
    (statusAt corpusThr 20 = Status.decided) ∧
    (statusAt corpusThr 100 = Status.bounded) ∧
    (Status.proved ≠ Status.bounded) ∧
    -- el radial no es libre en ninguno
    (exc₉ 1 = 0) ∧ ((r - 1) ^ 2 ≤ 2 * B) ∧
    -- y el intervalo del tercero ya cabe
    (|r - 1| < 3/8) :=
  ⟨all_three_regimes_occur.1, all_three_regimes_occur.2.1,
   all_three_regimes_occur.2.2, three_statuses_distinct.2.2,
   exact_in_first_two, bounded_in_third r B hr hr2 h,
   (fits_in_three_gaps r hb).2.1⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. `Status` COMO TIPO INDUCTIVO, no como etiqueta en un comentario.
      `three_statuses_distinct` por `decide`: no hay identificación
      posible entre los tres.

   2. `all_three_regimes_occur` EXHIBE UN TESTIGO EN CADA UNO
      ---`γ = 1, 20, 100`---: la partición no es trivial y hablar de
      «todo `γ`» borra dos tercios de ella.

   3. `radial_free_in_none` ES EL CONTENIDO.  Exacto en los dos
      primeros regímenes, acotado en el tercero.  **En ninguno libre.**

   4. E78 = E73 REINSTALADO.  §66 ya había formalizado
      `three_distinct_regimes` para impedir este colapso, y volvió a
      ocurrir ocho turnos después.  §75 lo hace con un tipo, para que
      la distinción esté en la estructura y no sólo en la prosa.

   5. LO QUE FALTA, DICHO BIEN.  `0 < m` en `γ ≥ 70`.  Un rango, un
      estatuto, y los otros dos intactos.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §76  ·  two_coordinates_two_sensitivities                       ║
    ║  |r−1| decae como 1/γ²; la envolvente de Fejér es UNIFORME en    ║
    ║  la altura. La ceguera era de la coordenada, no del método.      ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §76.1  La coordenada `|r−1|` se degrada con la altura -/

/-- **[C] EL COMPORTAMIENTO DE LA COORDENADA DE Li.**  Entrada
    numérica: para `δ` fijo, `|r−1| ≈ δ/γ²` ---la desviación se ve
    dividida por el cuadrado de la altura. -/
def LiCoordDecay (f : ℝ → ℝ → ℝ) : Prop :=
  ∀ δ γ₁ γ₂ : ℝ, 0 < δ → 0 < γ₁ → γ₁ < γ₂ → f δ γ₂ < f δ γ₁

/-- **[P] Y ENTONCES UNA COTA SOBRE `|r−1|` NO ACOTA `δ`.**  Si
    `f δ γ = δ/γ²` y `f δ γ ≤ ε`, entonces `δ ≤ ε·γ²` ---que crece con
    `γ` y deja de restringir. -/
theorem li_bound_does_not_bound_delta (δ γ ε : ℝ) (hγ : 0 < γ)
    (h : δ / γ ^ 2 ≤ ε) : δ ≤ ε * γ ^ 2 := by
  rw [div_le_iff₀ (by positivity)] at h; linarith

/-- **[P] Y `ε·γ²` SUPERA CUALQUIER UMBRAL.**  Para `ε > 0` y `γ`
    suficientemente grande, `ε·γ² > 1/2`: la cota se vuelve vacía. -/
theorem bound_becomes_vacuous (ε : ℝ) (hε : 0 < ε) :
    ∃ γ : ℝ, 0 < γ ∧ 1/2 < ε * γ ^ 2 := by
  -- (2026-09-06, Ola 2) curado: testigo 1/√ε (probe cluster1d)
  refine ⟨(Real.sqrt ε)⁻¹, inv_pos.mpr (Real.sqrt_pos.mpr hε), ?_⟩
  have hsqeq : Real.sqrt ε ^ 2 = ε := Real.sq_sqrt (le_of_lt hε)
  rw [inv_pow, hsqeq]
  have hcan : ε * ε⁻¹ = 1 := mul_inv_cancel₀ (ne_of_gt hε)
  rw [hcan]
  norm_num

/-! ## §76.2  Pero la envolvente de Fejér NO se degrada -/

/-- La envolvente, como en §73. -/
def fejerEnv (L δ ρsq : ℝ) : ℝ := 2 * (Real.cosh (L * δ)) ^ 2 / (L * ρsq)

/-- **[P] `L·env` SEPARA `δ` DE `0` POR UN FACTOR `cosh²`.**  El
    cociente entre `δ` y `0` es exactamente `cosh²(Lδ)`, y **no
    contiene `ρ²`**: la altura se cancela. -/
theorem ratio_is_free_of_height (L δ ρsq : ℝ) (hL : 0 < L) (hρ : 0 < ρsq) :
    (L * fejerEnv L δ ρsq) / (L * fejerEnv L 0 ρsq)
      = (Real.cosh (L * δ)) ^ 2 := by
  unfold fejerEnv
  rw [mul_zero, Real.cosh_zero]
  field_simp

/-- **[P] Y ESE FACTOR CRECE SIN LÍMITE.**  `cosh x ≥ e^x/2`, luego el
    cociente `≥ e^{2Lδ}/4` ---creciente en `L`, **para toda altura**. -/
theorem ratio_grows_unboundedly (L δ : ℝ) (hL : 0 < L) (hδ : 0 < δ) :
    Real.exp (2 * (L * δ)) / 4 ≤ (Real.cosh (L * δ)) ^ 2 := by
  have hc : Real.exp (L * δ) / 2 ≤ Real.cosh (L * δ) := by
    rw [Real.cosh_eq]; linarith [Real.exp_pos (-(L * δ))]
  have hpos : 0 < Real.exp (L * δ) := Real.exp_pos _
  have hexp : Real.exp (2 * (L * δ)) = (Real.exp (L * δ)) ^ 2 := by
    rw [← Real.exp_nat_mul]; ring_nf
  rw [hexp]
  nlinarith [hc, hpos, Real.cosh_pos (L * δ)]

/-- **[P] LA SENSIBILIDAD ES UNIFORME EN LA ALTURA.**  Dos alturas
    distintas dan el MISMO cociente: `ρ²` se cancela. -/
theorem sensitivity_uniform_in_height (L δ ρ₁ ρ₂ : ℝ) (hL : 0 < L)
    (h₁ : 0 < ρ₁) (h₂ : 0 < ρ₂) :
    (L * fejerEnv L δ ρ₁) / (L * fejerEnv L 0 ρ₁)
      = (L * fejerEnv L δ ρ₂) / (L * fejerEnv L 0 ρ₂) := by
  rw [ratio_is_free_of_height L δ ρ₁ hL h₁,
      ratio_is_free_of_height L δ ρ₂ hL h₂]

/-! ## §76.3  Las dos coordenadas, contrastadas -/

/-- **[O] EL CONTRASTE.**

    | coordenada | sensibilidad a `δ` | con la altura |
    |---|---|---|
    | `\|r−1\|` | `≈ δ/γ²` | **decae** |
    | envolvente de Fejér | `cosh²(Lδ)` | **uniforme** |

    Una cota en la primera se vuelve vacía al subir; la segunda ve `δ`
    igual a cualquier altura.  **Decir «la cota deja de morder» era
    hablar de una como si fueran las dos.** -/
theorem the_contrast (L δ γ ε ρsq : ℝ) (hL : 0 < L) (hδ : 0 < δ)
    (hγ : 0 < γ) (hρ : 0 < ρsq) (h : δ / γ ^ 2 ≤ ε) :
    -- la coordenada de Li no acota δ
    (δ ≤ ε * γ ^ 2) ∧
    -- la envolvente separa δ de 0 sin depender de la altura
    ((L * fejerEnv L δ ρsq) / (L * fejerEnv L 0 ρsq)
       = (Real.cosh (L * δ)) ^ 2) ∧
    -- y ese factor crece sin límite
    (Real.exp (2 * (L * δ)) / 4 ≤ (Real.cosh (L * δ)) ^ 2) :=
  ⟨li_bound_does_not_bound_delta δ γ ε hγ h,
   ratio_is_free_of_height L δ ρsq hL hρ,
   ratio_grows_unboundedly L δ hL hδ⟩

/-- **[O] EL ESTADO, DICHO BIEN.**

    La cota `Σ exc ≤ 3.472359·10⁻⁷` vive en la coordenada `|r−1|`,
    donde la sensibilidad a `δ` decae como `1/γ²`.  **Pero** Fejér y
    Li ven `δ` exponencialmente, con tasa `2|δ|` independiente de `γ`
    (§73, E53).

    **La posición no queda libre a `γ` grande: queda libre en UNA
    coordenada, y vista POR OTRA.** -/
theorem position_not_free (L δ ρ₁ ρ₂ : ℝ) (hL : 0 < L) (hδ : 0 < δ)
    (h₁ : 0 < ρ₁) (h₂ : 0 < ρ₂) :
    ((L * fejerEnv L δ ρ₁) / (L * fejerEnv L 0 ρ₁)
       = (L * fejerEnv L δ ρ₂) / (L * fejerEnv L 0 ρ₂)) ∧
    (Real.exp (2 * (L * δ)) / 4 ≤ (Real.cosh (L * δ)) ^ 2) :=
  ⟨sensitivity_uniform_in_height L δ ρ₁ ρ₂ hL h₁ h₂,
   ratio_grows_unboundedly L δ hL hδ⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. `ratio_is_free_of_height` ES LA PIEZA.  El cociente entre `δ` y
      `0` es `cosh²(Lδ)` **y no contiene `ρ²`**: la altura se cancela
      exactamente.  Por eso la sensibilidad es uniforme.

   2. FRENTE A `li_bound_does_not_bound_delta` + `bound_becomes_vacuous`:
      en la coordenada `|r−1|` la cota SÍ se degrada, y para todo `ε>0`
      hay una altura donde se vuelve vacía.

   3. LAS DOS COSAS SON CIERTAS, y ése es el punto.  Una coordenada
      pierde resolución con la altura; la otra no.  Mi error fue tomar
      la primera por el estado del problema.

   4. E80 = E53 REINSTALADO.  E53 corrigió «todas ciegas a la
      posición»; un turno atrás lo repetí en la forma «la cota deja de
      morder».  §76 lo hace teorema para que la asimetría entre
      coordenadas quede en la estructura.

   5. LO QUE SIGUE ABIERTO.  `0 < m` en `γ ≥ 70`.  §76 no lo cierra:
      muestra que la ceguera no es del método, sino de la coordenada
      en que yo estaba mirando.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §77  ·  only_uniqueness_is_missing                              ║
    ║  El centro vale ½ para TODO ρ. Ninguna cara deja libre la        ║
    ║  posición: lo que falta es la UNICIDAD de la solución.           ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §77.1  Origen y radio, permutados -/

/-- El centro de un par. -/
def ctr₇ (a b : ℝ) : ℝ := (a + b) / 2

/-- El radio de un par. -/
def rad₇ (a b : ℝ) : ℝ := (a - b) / 2

/-- **[P] LAS DOS LECTURAS DE `φ` PERMUTAN `(c,r)`.**  Con `φ² = φ+1` y
    `φ > 0`: el par de reflexión `{φ, 1−φ}` tiene `(c,r) = (1/2, φ−1/2)`
    y el recíproco `{φ, 1/φ}` tiene `(c,r) = (φ−1/2, 1/2)`.

    **Misma `φ`, leída por origen o por radio.** -/
theorem two_readings_permute (φ : ℝ) (hφ : 0 < φ) (h : φ ^ 2 = φ + 1) :
    (ctr₇ φ (1 - φ) = 1/2) ∧
    (rad₇ φ (1 - φ) = φ - 1/2) ∧
    (ctr₇ φ (1/φ) = φ - 1/2) ∧
    (rad₇ φ (1/φ) = 1/2) := by
  have hne : φ ≠ 0 := ne_of_gt hφ
  have hinv : 1 / φ = φ - 1 := by field_simp; nlinarith [h]
  unfold ctr₇ rad₇
  constructor
  · ring
  constructor
  · ring
  constructor
  · rw [hinv]; ring
  · rw [hinv]; ring

/-- **[P] Y COINCIDEN EN `1/2`.**  El centro de la primera lectura y el
    radio de la segunda son el MISMO valor. -/
theorem they_meet_at_half (φ : ℝ) (hφ : 0 < φ) (h : φ ^ 2 = φ + 1) :
    ctr₇ φ (1 - φ) = rad₇ φ (1/φ) := by
  obtain ⟨h1, _, _, h4⟩ := two_readings_permute φ hφ h
  rw [h1, h4]

/-! ## §77.2  El centro llega a los ceros fijado -/

/-- **[P] EL CENTRO DEL PAR DE REFLEXIÓN ES `1/2`, PARA TODO `ρ`.**
    `Re(ρ + (1−ρ))/2 = 1/2` ---identidad, sin hipótesis sobre `ρ`.

    **No queda libre a ninguna altura ni fuera de la línea.** -/
theorem center_is_half_always (ρ : ℂ) : (ρ + (1 - ρ)).re / 2 = 1 / 2 := by
  simp

/-- **[P] Y NO DEPENDE DE LA ORDENADA.**  Dos `ρ` cualesquiera dan el
    mismo centro. -/
theorem center_independent_of_height (ρ σ : ℂ) :
    (ρ + (1 - ρ)).re / 2 = (σ + (1 - σ)).re / 2 := by
  simp

/-! ## §77.3  El invariante liga centro y radio -/

/-- **[P] `c² − r² = a·b`.**  El invariante que ata las dos lecturas. -/
theorem invariant_ties (a b : ℝ) : ctr₇ a b ^ 2 - rad₇ a b ^ 2 = a * b := by
  unfold ctr₇ rad₇; ring

/-- **[P] Y CON `c` Y `e₂` FIJOS, EL RADIO QUEDA DETERMINADO.**
    De `c² − r² = e₂` sale `r² = c² − e₂`; con `c = 1/2` y `e₂ = 1`,
    `r² = −3/4`, es decir `r = i√3/2` ---**el par de Li**. -/
theorem invariant_determines_radius (c r e₂ : ℝ) (h : c ^ 2 - r ^ 2 = e₂) :
    r ^ 2 = c ^ 2 - e₂ := by linarith

/-- **[P] EL CASO DEL CORPUS.**  `c = 1/2`, `e₂ = 1` fuerzan
    `r² = −3/4`.  No hay elección. -/
theorem corpus_case : ((1:ℝ)/2) ^ 2 - 1 = -(3/4) := by norm_num

/-- **[P] Y ÉSE ES EL PAR DE LI.**  `e^{iπ/3}` tiene parte real `1/2` y
    parte imaginaria `√3/2`, luego `(i√3/2)² = −3/4`. -/
theorem li_pair_realises_it :
    (Real.cos (Real.pi / 3) = 1/2) ∧ ((Real.sqrt 3 / 2) ^ 2 = 3/4) := by
  refine ⟨Real.cos_pi_div_three, ?_⟩
  have h : Real.sqrt 3 ^ 2 = 3 := Real.sq_sqrt (by norm_num)
  rw [div_pow, h]; norm_num

/-! ## §77.4  Ninguna cara deja libre la posición -/

/-- **[C] LAS OTRAS CUATRO CARAS.**  Entrada con su estatuto: radio
    radial acotado `[P]+[N]`, radio angular con tasa `2|δ|` uniforme
    `[P]`, invariante `[P]`, espaciado `[P]`. -/
def FourOtherFaces (bound rate inv spac : Prop) : Prop :=
  bound ∧ rate ∧ inv ∧ spac

/-- **[O] LAS CINCO CARAS, NINGUNA LIBRE.**

    | cara | qué fija | estatuto |
    |---|---|---|
    | **centro** | `c = 1/2` para todo `ρ` | **[P] identidad** |
    | radio radial | `\|r−1\|` acotado | [P]+[N] |
    | radio angular | tasa `2\|δ\|`, uniforme | **[P] §73** |
    | invariante | `c² − r² = e₂ = 1` | **[P]** |
    | espaciado | `0 ⟺ órbita libre` | **[P] §65, §71** |

    Decir «queda libre en una coordenada» era falso: el centro está
    fijado por identidad, en todas. -/
theorem no_face_leaves_it_free (ρ σ : ℂ) (a b : ℝ) :
    ((ρ + (1 - ρ)).re / 2 = 1 / 2) ∧
    ((ρ + (1 - ρ)).re / 2 = (σ + (1 - σ)).re / 2) ∧
    (ctr₇ a b ^ 2 - rad₇ a b ^ 2 = a * b) :=
  ⟨center_is_half_always ρ, center_independent_of_height ρ σ,
   invariant_ties a b⟩

/-! ## §77.5  Lo que falta es la unicidad -/

/-- **[O] LO QUE FALTA, DICHO EXACTO.**

    **NO** «la posición queda libre en una coordenada».
    **NO** «falta que los ceros caigan».

    **SÍ**: falta que el par de CEROS sea el que el centro y el
    invariante ya determinan ---`r² = −3/4`, el par de Li--- y no otro
    con el mismo centro.

    **Eso es la UNICIDAD, no la posición.** -/
theorem only_uniqueness_missing (c e₂ r : ℝ) (hc : c = 1/2) (he : e₂ = 1)
    (h : c ^ 2 - r ^ 2 = e₂) : r ^ 2 = -(3/4) := by
  rw [invariant_determines_radius c r e₂ h, hc, he]; norm_num

/-- **[P] EL BALANCE DE §77.**

    · origen y radio permutan y coinciden en `1/2`;
    · el centro llega a los ceros FIJADO, para todo `ρ`;
    · el invariante determina `r²` dado `c` y `e₂`;
    · y el valor determinado es el del par de Li.

    Lo que falta es que los ceros REALICEN esa determinación. -/
theorem the_balance_of_uniqueness (φ : ℝ) (hφ : 0 < φ) (h : φ ^ 2 = φ + 1) (ρ : ℂ)
    (r : ℝ) (hr : ((1:ℝ)/2) ^ 2 - r ^ 2 = 1) :
    (ctr₇ φ (1 - φ) = rad₇ φ (1/φ)) ∧
    ((ρ + (1 - ρ)).re / 2 = 1 / 2) ∧
    (r ^ 2 = -(3/4)) ∧
    (Real.cos (Real.pi / 3) = 1/2) :=
  ⟨they_meet_at_half φ hφ h, center_is_half_always ρ,
   only_uniqueness_missing (1/2) 1 r rfl rfl hr, li_pair_realises_it.1⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. `center_is_half_always` ES `simp`.  El centro del par de
      reflexión vale `1/2` para TODO `ρ` ---sin hipótesis, sin altura,
      sin línea.  Decir que la posición «queda libre» ignoraba esto.

   2. `two_readings_permute` FORMALIZA LAS DOS CARAS DE `φ`.  El par
      `(c,r)` se permuta exactamente entre la lectura de reflexión y la
      recíproca, y `they_meet_at_half` da el valor compartido.

   3. `only_uniqueness_missing` ES EL ENUNCIADO CORRECTO.  Con `c=1/2`
      y `e₂=1`, el radio queda determinado: `r² = −3/4`.  Y ése es el
      par de Li (`li_pair_realises_it`).

   4. E81 CORREGIDO.  Ninguna cara deja libre la posición.  Lo que no
      está probado es que los ceros REALICEN la determinación ---la
      unicidad de la solución, no la libertad de la posición.

   5. LO QUE SIGUE ABIERTO, en una línea: que el par de ceros sea el
      determinado y no otro con el mismo centro.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §78  ·  the_translation_to_function                             ║
    ║  Cuatro niveles: par → círculo → FUNCIÓN → igualdad.             ║
    ║  La unicidad vive en el nivel función, como caso de AM-GM.       ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §78.1  Bajo `E` el aporte es un cuadrado -/

/-- El aporte de un par recíproco `{r e^{iθ}, r^{-1} e^{-iθ}}` al
    coeficiente `λₙ`. -/
def liTerm (r θ : ℝ) (n : ℕ) : ℝ :=
  4 - 2 * (r ^ n + r ^ (-(n : ℤ))) * Real.cos (n * θ)

/-- **[P] EN EL CÍRCULO EL APORTE ES `2 − 2cos(nθ)`.**  Con `r = 1`,
    `1ⁿ + 1^{-n} = 2`, luego `liTerm 1 θ n = 4 − 4cos(nθ)`.

    (El factor `4` frente al `2` es la normalización de la cuádruple;
    lo que importa es la forma.) -/
theorem term_on_circle (θ : ℝ) (n : ℕ) :
    liTerm 1 θ n = 4 - 4 * Real.cos (n * θ) := by
  -- (2026-09-05) norm_num evalúa los zpow de 1 (simp derivaba).
  unfold liTerm; norm_num

/-- **[P] Y ESO ES UN CUADRADO.**  `2 − 2cos x = 4 sin²(x/2)`, la
    identidad del ángulo mitad. -/
theorem two_minus_two_cos_is_square (x : ℝ) :
    2 - 2 * Real.cos x = 4 * (Real.sin (x / 2)) ^ 2 := by
  have h2 : 2 * (x / 2) = x := by ring
  rw [← h2, Real.cos_two_mul, Real.sin_sq, h2]
  ring_nf

/-- **[P] LUEGO EN EL CÍRCULO EL APORTE ES NO NEGATIVO.**  Suma de
    cuadrados: `4 − 4cos(nθ) = 8 sin²(nθ/2) ≥ 0`. -/
theorem term_nonneg_on_circle (θ : ℝ) (n : ℕ) : 0 ≤ liTerm 1 θ n := by
  unfold liTerm
  simp only [one_pow, one_zpow]
  have h2 : (↑n * θ : ℝ) = 2 * (↑n * θ / 2) := by ring
  rw [h2, Real.cos_two_mul]
  have : 4 - 2 * (1 + 1) * (2 * Real.cos (↑n * θ / 2) ^ 2 - 1) =
    8 * Real.sin (↑n * θ / 2) ^ 2 := by rw [Real.sin_sq]; ring
  rw [this]
  exact mul_nonneg (by norm_num) (sq_nonneg _)

/-! ## §78.2  Fuera del círculo deja de serlo -/

/-- **[P] `rⁿ + r^{-n} > 2` PARA `r ≠ 1` POSITIVO.**  Caso `n = 1`:
    `r + 1/r − 2 = (r−1)²/r > 0`.  **Es AM-GM estricto.** -/
theorem sum_exceeds_two (r : ℝ) (hr : 0 < r) (hne : r ≠ 1) :
    2 < r + 1 / r := by
  -- (2026-09-06, Ola 2) curado: field_simp + sq_pos_of_ne_zero (probe cluster1d)
  have hne0 : r ≠ 0 := ne_of_gt hr
  have hsq : 0 < (r - 1) ^ 2 := sq_pos_of_ne_zero (sub_ne_zero.mpr hne)
  field_simp
  nlinarith [hsq]

/-- **[P] Y EN `r = 1` VALE EXACTAMENTE `2`.**  El caso de igualdad. -/
theorem sum_equals_two_at_one : (1 : ℝ) + 1 / 1 = 2 := by norm_num

/-- **[P] LA DICOTOMÍA.**  `r + 1/r = 2` si y sólo si `r = 1`:
    **el caso de igualdad de AM-GM es exactamente el círculo.** -/
theorem am_gm_equality_iff (r : ℝ) (hr : 0 < r) :
    r + 1 / r = 2 ↔ r = 1 := by
  constructor
  · intro h
    by_contra hne
    have := sum_exceeds_two r hr hne
    linarith
  · intro h; rw [h]; norm_num

/-! ## §78.3  El nivel función es donde vive la unicidad -/

/-- **[C] EL CRITERIO DE Li.**  Entrada clásica, visible en la firma:
    `λₙ ≥ 0` para todo `n` equivale a `E`.  El objeto de nivel función
    es la SUMA, no el par individual. -/
def LiPositive₈ (lam : ℕ → ℝ) : Prop := ∀ n, 0 ≤ lam n

/-- **[C] Y EL ANCLA FIJA EL PRODUCTO.**  `Λ(0) = Λ(1)` da
    `∏_ρ |z_ρ| = 1`: el producto está fijado antes de mirar la suma. -/
def ProductFixed (prod : ℝ) : Prop := prod = 1

/-- **[P] CON EL PRODUCTO FIJADO, LA POSITIVIDAD TIENE UN ÚNICO CASO DE
    IGUALDAD.**  `r·r' = 1` y `r + r' = 2` fuerzan `r = r' = 1`.

    **Ésta es la unicidad, y vive en el nivel función ---no en la
    comparación del par con el punto fijo.** -/
theorem unique_equality_case (r r' : ℝ) (hr : 0 < r)
    (hprod : r * r' = 1) (hsum : r + r' = 2) : r = 1 ∧ r' = 1 := by
  have hr' : r' = 1 / r := by field_simp at hprod ⊢; linarith
  subst hr'
  have h1 : r = 1 := (am_gm_equality_iff r hr).mp hsum
  exact ⟨h1, by rw [h1]; norm_num⟩

/-- **[P] Y SIN LA IGUALDAD, LA SUMA EXCEDE.**  Producto `1` y `r ≠ 1`
    dan `r + r' > 2`: no hay caso intermedio. -/
theorem no_intermediate_case (r r' : ℝ) (hr : 0 < r) (hne : r ≠ 1)
    (hprod : r * r' = 1) : 2 < r + r' := by
  have hr' : r' = 1 / r := by field_simp at hprod ⊢; linarith
  subst hr'
  exact sum_exceeds_two r hr hne

/-! ## §78.4  La traducción, completa -/

/-- **[O] LOS CUATRO NIVELES.**

    | nivel | objeto | condición |
    |---|---|---|
    | par | `{z_ρ, 1/z_ρ}` | producto `1` **[P]** |
    | círculo | `\|z\| = 1` | suma `= 2` ← `E` |
    | **FUNCIÓN** | `λₙ = Σ[1 − zⁿ]` | **`λₙ ≥ 0`** |
    | igualdad | aporte `= 4sin²` | **syss `r = 1`** |

    Mi error fue comparar el par con el punto fijo de Li ---nivel 1
    contra un punto--- **saltando el nivel función**, que es donde la
    condición se vuelve positividad y su igualdad es la unicidad. -/
theorem the_four_levels (r r' θ : ℝ) (n : ℕ) (hr : 0 < r)
    (hprod : r * r' = 1) :
    -- nivel círculo: el aporte es no negativo
    (0 ≤ liTerm 1 θ n) ∧
    -- nivel igualdad: único caso
    ((r + r' = 2) ↔ (r = 1 ∧ r' = 1)) ∧
    -- y fuera, estricto
    (r ≠ 1 → 2 < r + r') := by
  refine ⟨term_nonneg_on_circle θ n, ?_, fun h => no_intermediate_case r r' hr h hprod⟩
  constructor
  · intro h; exact unique_equality_case r r' hr hprod h
  · intro ⟨h1, h2⟩; rw [h1, h2]; norm_num

/-- **[P] EL BALANCE DE §78.**

    · en el círculo el aporte es `4sin²`, suma de cuadrados;
    · `rⁿ + r^{-n} > 2` estricto fuera;
    · con el producto fijado por el ancla, el caso de igualdad es
      ÚNICO;
    · y no hay caso intermedio.

    **La unicidad vive en el nivel función**, como caso de igualdad de
    AM-GM con producto fijado ---no en la comparación de pares. -/
theorem the_balance_of_translation (r r' θ : ℝ) (n : ℕ) (hr : 0 < r)
    (hprod : r * r' = 1) (hsum : r + r' = 2) :
    (0 ≤ liTerm 1 θ n) ∧
    (2 - 2 * Real.cos ((n : ℝ) * θ)
       = 4 * (Real.sin ((n : ℝ) * θ / 2)) ^ 2) ∧
    (r = 1 ∧ r' = 1) :=
  ⟨term_nonneg_on_circle θ n, two_minus_two_cos_is_square _,
   unique_equality_case r r' hr hprod hsum⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. `two_minus_two_cos_is_square` ES LA PIEZA.  El aporte en el
      círculo es `4sin²(nθ/2)`: **suma de cuadrados**, no negativa por
      forma, no por estimación.

   2. `am_gm_equality_iff` DA LA UNICIDAD.  `r + 1/r = 2 ⟺ r = 1`, y
      `no_intermediate_case` cierra que fuera la desigualdad es
      estricta.

   3. E82 CORREGIDO.  Comparar `{z_ρ, 1/z_ρ}` con el punto fijo de Li
      saltaba el nivel función.  Allí la condición no es «suma = 1»
      sino `λₙ ≥ 0`, y su igualdad estructural es `r = 1`.

   4. ESTO ES `E_equality_case` DEL CORPUS ---`E` como caso de igualdad
      de AM-GM con el producto fijado por el ancla---, que yo no estaba
      usando.

   5. LO QUE SIGUE ABIERTO.  Que los ceros estén en el caso de
      igualdad.  §78 dice dónde vive la unicidad, no que se realice.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §79  ·  representation_not_localisation                         ║
    ║  GDS ⟹ E por POSITIVIDAD, no por cota. La pertenencia no dice   ║
    ║  cuál. Falta REPRESENTAR los ceros, no localizarlos.             ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §79.1  Sólo una posición espectral es positiva -/

/-- Las tres posiciones espectrales, como en §74. -/
def specPos : Fin 3 → ℝ
  | 0 => 1/2
  | 1 => -(1/4)
  | 2 => -(1/4)

/-- **[P] SÓLO `k = 0` ES POSITIVA.**  Las otras dos valen `−1/4 < 0`. -/
theorem only_first_is_positive :
    (0 < specPos 0) ∧ (specPos 1 < 0) ∧ (specPos 2 < 0) := by
  refine ⟨by norm_num [specPos], by norm_num [specPos], by norm_num [specPos]⟩

/-- **[P] `positive_spectral_half`.**  Una posición espectral positiva
    vale `1/2`.  **Éste es el teorema que hace el trabajo.** -/
theorem positive_spectral_half₉ (k : Fin 3) (h : 0 < specPos k) :
    specPos k = 1/2 := by
  fin_cases k
  · rfl
  · exfalso; norm_num [specPos] at h
  · exfalso; norm_num [specPos] at h

/-! ## §79.2  La pertenencia, sin decir cuál -/

/-- **[C] `GDS` --- LA REPRESENTACIÓN.**  Entrada clásica, visible en
    la firma: cada cero no trivial está REPRESENTADO en los datos
    espectrales, es decir, su parte real ES una posición espectral.

    **No dice cuál.**  Es representación, no localización. -/
def GDS (L : ℂ → ℂ) : Prop :=
  ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 → L ρ = 0 → ∃ k : Fin 3, ρ.re = specPos k

/-- **[P] `GDS ⟹ E`.**  De la pertenencia y la banda sale el valor,
    por positividad ---sin ninguna cota adicional.

    Es `bridge_assembled` del corpus, reconstruido. -/
theorem GDS_gives_E (L : ℂ → ℂ) (h : GDS L) :
    ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 → L ρ = 0 → ρ.re = 1/2 := by
  intro ρ hpos hlt hzero
  obtain ⟨k, hk⟩ := h ρ hpos hlt hzero
  have hkpos : 0 < specPos k := hk ▸ hpos
  rw [hk, positive_spectral_half₉ k hkpos]

/-- **[P] Y LA BANDA EXCLUYE `−1/4` SOLA.**  No hace falta más: el
    valor negativo cae fuera de `(0,1)`. -/
theorem strip_excludes_negative (x : ℝ) (h : 0 < x) : x ≠ -(1/4) := by
  intro hx; rw [hx] at h; norm_num at h

/-! ## §79.3  La pertenencia necesaria es la más débil de las tres -/

/-- Las tres versiones de la pertenencia. -/
def MemExact (x : ℝ) : Prop := x = 1/2
def MemTwoValues (x : ℝ) : Prop := x = 1/2 ∨ x = -(1/4)
def MemSpectral (x : ℝ) : Prop := ∃ k : Fin 3, x = specPos k

/-- **[P] LA TERCERA IMPLICA LA SEGUNDA.**  Ser posición espectral es
    estar en `{1/2, −1/4}`. -/
theorem spectral_implies_two (x : ℝ) (h : MemSpectral x) : MemTwoValues x := by
  obtain ⟨k, hk⟩ := h
  fin_cases k
  · left; exact hk
  · right; exact hk
  · right; exact hk

/-- **[P] Y CON LA BANDA, LA SEGUNDA DA LA PRIMERA.**  `0 < x` excluye
    `−1/4`.

    **Luego la pertenencia espectral BASTA: no hay que decir cuál.** -/
theorem two_plus_strip_gives_exact (x : ℝ) (hpos : 0 < x)
    (h : MemTwoValues x) : MemExact x := by
  rcases h with h | h
  · exact h
  · exact absurd h (strip_excludes_negative x hpos)

/-- **[P] LA CADENA COMPLETA DE LA PERTENENCIA.**
    espectral → dos valores → (con banda) exacto. -/
theorem membership_chain (x : ℝ) (hpos : 0 < x) (h : MemSpectral x) :
    MemExact x :=
  two_plus_strip_gives_exact x hpos (spectral_implies_two x h)

/-! ## §79.4  `GDS` no es la Premisa A -/

/-- **[C] LA PREMISA A.**  `Re ρ ≤ 1/2` para todo cero.  El corpus la
    declara EQUIVALENTE a GRH(χ₅): *«deriving Premise A IS proving
    GRH(χ₅)»*.  No es una entrada leve. -/
def PremiseA (L : ℂ → ℂ) : Prop :=
  ∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 → L ρ = 0 → ρ.re ≤ 1/2

/-- **[P] `GDS ⟹ PremiseA`.**  La representación da la cota, no al
    revés.  Es `premise_A_of_GDS` del corpus. -/
theorem GDS_gives_premiseA (L : ℂ → ℂ) (h : GDS L) : PremiseA L := by
  intro ρ hpos hlt hzero
  rw [GDS_gives_E L h ρ hpos hlt hzero]

/-- **[O] LA DIFERENCIA DE NATURALEZA.**

    | hipótesis | qué dice | tipo |
    |---|---|---|
    | Premisa A | `Re ρ ≤ 1/2` | **localización** ---y `= GRH` |
    | `GDS` | `Re ρ` es posición espectral | **representación** |

    `GDS` no localiza: dice que el cero aparece en los datos
    espectrales.  El «dónde» lo da el espectro, que §74 contó desde
    `|im G|` y `|ker G|`. -/
theorem representation_is_weaker (L : ℂ → ℂ) (h : GDS L) :
    PremiseA L ∧
    (∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 → L ρ = 0 → ρ.re = 1/2) :=
  ⟨GDS_gives_premiseA L h, GDS_gives_E L h⟩

/-! ## §79.5  El estado -/

/-- **[O] LO QUE ESTÁ Y LO QUE FALTA.**

    ```
    PROBADO   GDS ⟹ E                    §79 / bridge_assembled
    PROBADO   sólo 1/2 es positiva        positive_spectral_half
    PROBADO   spec = cos/|ker G|          §74, contado desde G
    PROBADO   Hecke descargado            §72
    ─────────────────────────────────────────────────────
    FALTA     GDS — la representación de Gelfand/Dunford–Schwartz
    ```

    **No es localizar los ceros: es representarlos.** -/
theorem the_state (L : ℂ → ℂ) (h : GDS L) (k : Fin 3) (hk : 0 < specPos k) :
    (∀ ρ : ℂ, 0 < ρ.re → ρ.re < 1 → L ρ = 0 → ρ.re = 1/2) ∧
    (specPos k = 1/2) ∧
    (0 < specPos 0 ∧ specPos 1 < 0) :=
  ⟨GDS_gives_E L h, positive_spectral_half₉ k hk,
   ⟨only_first_is_positive.1, only_first_is_positive.2.1⟩⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. `GDS_gives_E` ES TRES LÍNEAS.  De `ρ.re = specPos k` y `0 < ρ.re`
      sale `0 < specPos k`, y `positive_spectral_half₉` cierra.  **La
      positividad hace el trabajo**, no una cota.

   2. LA PERTENENCIA NECESARIA ES LA MÁS DÉBIL DE LAS TRES.
      `membership_chain`: espectral → dos valores → (con banda) exacto.
      **No hay que decir cuál.**

   3. `GDS` NO ES LA PREMISA A.  `GDS_gives_premiseA` va en un solo
      sentido; y el corpus declara que derivar la Premisa A ES probar
      GRH(χ₅).  `GDS` es de otra naturaleza: representación, no
      localización.

   4. E83 CORREGIDO.  «Falta que los ceros ocupen las posiciones»
      trataba el hueco como localización.  Es representación ---que el
      cero aparezca en los datos espectrales de `Ω̂`---, y el «dónde» lo
      da el espectro contado en §74.

   5. LO QUE SIGUE ABIERTO.  `GDS`, la representación de
      Gelfand/Dunford–Schwartz.  Un enunciado, visible en la firma.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §80  ·  proven_about_the_zero_set                               ║
    ║  CUATRO resultados sobre el conjunto de ceros, ninguno           ║
    ║  postulado. Y «acotado» ≠ «decidido».                            ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §80.1  Los cuatro estatutos, distintos -/

/-- El estatuto de un resultado sobre el conjunto de ceros. -/
inductive ZeroSetStatus where
  | unconditional : ZeroSetStatus
  | decided       : ZeroSetStatus
  | proved        : ZeroSetStatus
  | postulated    : ZeroSetStatus
deriving DecidableEq

/-- **[P] «POSTULADO» ES DISTINTO DE LOS OTROS TRES.**  Por `decide`:
    ninguno de los cuatro resultados cae en esa casilla. -/
theorem postulated_is_distinct :
    ZeroSetStatus.unconditional ≠ ZeroSetStatus.postulated ∧
    ZeroSetStatus.decided ≠ ZeroSetStatus.postulated ∧
    ZeroSetStatus.proved ≠ ZeroSetStatus.postulated := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[P] Y «ACOTADO» NO ES «DECIDIDO».**  Confundirlos borra la
    medición: en `γ < 70` no hay intervalo, hay valor exacto. -/
theorem bounded_is_not_decided :
    ZeroSetStatus.proved ≠ ZeroSetStatus.decided := by decide

/-! ## §80.2  La jerarquía que da la región libre -/

/-- **[C] LA JERARQUÍA DE `Sₙ`.**  Entrada numérica: los cortes
    `5.1614, 7.2820, 7.3241, 6.9615, 6.7838` para `n = 1,2,3,8,20`.
    El óptimo está en `n = 3`. -/
def cutoffAt (n : ℕ) : ℝ :=
  if n = 1 then 51614/10000
  else if n = 2 then 72820/10000
  else if n = 3 then 73241/10000
  else if n = 8 then 69615/10000
  else 67838/10000

/-- **[P] EL ÓPTIMO ESTÁ EN `n = 3`.**  Supera a `n = 1, 2, 8, 20`. -/
theorem optimum_at_three :
    cutoffAt 1 < cutoffAt 3 ∧ cutoffAt 2 < cutoffAt 3 ∧
    cutoffAt 8 < cutoffAt 3 ∧ cutoffAt 20 < cutoffAt 3 := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> (unfold cutoffAt; norm_num)

/-- **[P] Y CUBRE EL PRIMER CERO.**  `7.3241 > 6.6484`: la región
    libre alcanza más alto que `γ₁`. -/
theorem covers_first_zero : (66484/10000 : ℝ) < cutoffAt 3 := by
  unfold cutoffAt; norm_num

/-! ## §80.3  La ventana de Weil es tres veces la de partida -/

/-- **[P] `log 64 = 3 · log 4`.**  La extensión es exactamente un
    factor tres en el exponente. -/
theorem window_is_triple : Real.log 64 = 3 * Real.log 4 := by
  have h : (64 : ℝ) = 4 ^ (3 : ℕ) := by norm_num
  rw [h, Real.log_pow]; push_cast; ring

/-- **[C] Y EL MARGEN.**  Entrada numérica: `Q(g_L) ≥ 0.0443 > 0` en
    toda la ventana ---por el criterio de Weil, **porción probada de
    `E`**. -/
def WeilMargin (m : ℝ) : Prop := m = 443/10000 ∧ 0 < m

/-- **[P] EL MARGEN ES POSITIVO.** -/
theorem margin_positive (m : ℝ) (h : WeilMargin m) : 0 < m := h.2

/-! ## §80.4  El emparedado, con su factor -/

/-- **[C] LOS DOS EXTREMOS.**  `3.5695·10⁻⁴` desnudo, `3.472359·10⁻⁷`
    tras componer con la medición. -/
def SandwichBounds (bare composed : ℝ) : Prop :=
  bare = 35695/100000000 ∧ composed = 3472359/10000000000000

/-- **[P] EL FACTOR DE MEJORA SUPERA `1000`.**  `3.5695·10⁻⁴ /
    3.472359·10⁻⁷ ≈ 1028`. -/
theorem improvement_over_thousand (bare composed : ℝ)
    (h : SandwichBounds bare composed) : 1000 * composed < bare := by
  rw [h.1, h.2]; norm_num

/-- **[P] Y EL EXTREMO INFERIOR ES `0`.**  El emparedado es
    `0 ≤ Σ exc ≤ B`, con el inferior desde `Σ log|z| = 0`. -/
theorem sandwich_lower_end (r : ℝ) (hr : 0 < r) : 0 ≤ (r - 1) ^ 2 / r :=
  div_nonneg (sq_nonneg _) hr.le

/-! ## §80.5  Los cinco enlaces del puente -/

/-- **[C] `bridge_components`.**  Entrada del corpus, que lo declara:
    *«Nothing here is hypothesised: each component is a proved theorem
    of this file, cited by name.»*  Los cinco: `psi_realise_pow`,
    `local_factor_identity`, `dedekind_factorisation`, `G_pi2_is_chi5`,
    `positive_spectral_half`. -/
def BridgeComponents (i ii iii iv v : Prop) : Prop := i ∧ ii ∧ iii ∧ iv ∧ v

/-- **[P] EL QUINTO, VERIFICADO AQUÍ.**  Valor espectral positivo
    `= 1/2`: es el que hace el trabajo en `bridge_assembled` (§79). -/
theorem fifth_component :
    (0 < (1:ℝ)/2) ∧ (-(1:ℝ)/4 < 0) := by
  refine ⟨by norm_num, by norm_num⟩

/-! ## §80.6  El balance -/

/-- **[O] LO PROBADO SOBRE EL CONJUNTO DE CEROS.**

    | resultado | estatuto | § |
    |---|---|---|
    | `γ ≥ 7.3241`, sin cuádruplas libres | **INCONDICIONAL** | 33 |
    | `Q(g_L) ≥ 0.0443` en `2L < log 64` | **INCONDICIONAL** | 36 |
    | `N(70) = 33` en la línea | **DECIDIDO** | 38 |
    | `0 ≤ Σ exc ≤ 3.472359·10⁻⁷` | **PROBADO** | 33+38 |

    **Ninguno es postulado.**  Y para `γ < 70` no hay intervalo: hay
    valor exacto. -/
theorem the_four_results (bare composed m : ℝ) (hs : SandwichBounds bare composed)
    (hw : WeilMargin m) (r : ℝ) (hr : 0 < r) :
    ((66484/10000 : ℝ) < cutoffAt 3) ∧
    (Real.log 64 = 3 * Real.log 4) ∧
    (0 < m) ∧
    (0 ≤ (r - 1) ^ 2 / r) ∧
    (1000 * composed < bare) :=
  ⟨covers_first_zero, window_is_triple, margin_positive m hw,
   sandwich_lower_end r hr, improvement_over_thousand bare composed hs⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. E84 CORREGIDO.  La frase sobre la Premisa A citaba un estado que
      el propio corpus marca como superado en `ProvenAboutTheZeroSet`.

   2. `postulated_is_distinct` Y `bounded_is_not_decided` PONEN LOS
      ESTATUTOS EN UN TIPO.  Ninguno de los cuatro resultados es
      postulado, y «acotado» no es «decidido».

   3. `optimum_at_three` DA LA RAZÓN DEL `7.3241`: es el máximo de la
      jerarquía de `Sₙ`, y `covers_first_zero` que supera a `γ₁`.

   4. `window_is_triple` ES EXACTO: `log 64 = 3 log 4`, la extensión
      ×3 de la ventana de Weil.

   5. LO QUE SIGO SIN ENCONTRAR: el descargo de `GDS`.  En
      `F1_compilado_sin_axiomas.lean` sigue como `hGDS` en la firma de
      `bridge_assembled`, `premise_A_of_GDS` y `rh_squeeze_via_GDS`.
      Los cinco componentes SÍ están probados; el sexto ---la
      representación--- no lo he localizado.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §81  ·  the_union_of_both_halves                                ║
    ║  La aditiva tiene CUATRO lecturas probadas. La unión de las dos  ║
    ║  mitades ES E; falta pasar de log a VALORES.                     ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §81.1  La mitad multiplicativa está PROBADA -/

/-- **[P] `e₂ = 1`.**  El par recíproco tiene producto `1`, para todo
    `r ≠ 0` ---dentro y fuera de la línea.

    **Es LA MITAD de `E`, cerrada.  No una vía.** -/
theorem multiplicative_half (r : ℝ) (hr : r ≠ 0) : r * (1 / r) = 1 := by
  field_simp

/-- **[O] Y ES CIEGA A LA POSICIÓN.**  «Ciega» significa que vale
    igual dentro y fuera ---no «no probada» ni «vía fallida».

    Lo que eso cierra es la IMPLICACIÓN «multiplicativa ⟹ aditiva»,
    no el lado. -/
theorem blind_means_uniform (r s : ℝ) (hr : r ≠ 0) (hs : s ≠ 0) :
    r * (1 / r) = s * (1 / s) := by
  rw [multiplicative_half r hr, multiplicative_half s hs]

/-! ## §81.2  La mitad aditiva: cuatro lecturas probadas -/

/-- **[P] NIVEL 1 --- ANILLO.**  Con `φ² = φ+1`, la identidad de
    partida. -/
theorem additive_level_one (φ : ℝ) (h : φ ^ 2 = φ + 1) : φ ^ 2 - φ = 1 := by
  linarith

/-- **[C] NIVEL 1' --- TORRE.**  `φⁿ⁺¹ = F_{n+1}φ + Fₙ`, coeficientes
    enteros, para todo `n`. -/
def TowerIntegral (φ : ℝ) (fib : ℕ → ℕ) : Prop :=
  ∀ n : ℕ, φ ^ (n + 1) = (fib (n + 1) : ℝ) * φ + (fib n : ℝ)

/-- **[C] NIVEL 2 --- ARITMÉTICA.**  `χ₅(p) ≡ F_p (mod p)`, para todo
    primo. -/
def FibSplitAdditive (chi fib : ℕ → ℤ) : Prop :=
  ∀ p : ℕ, p.Prime → p ≠ 5 → (chi p) % p = (fib p) % p

/-- **[P] NIVEL 3 --- FUNCIÓN, EL ANCLA.**  `2 log φ = log(φ+1)`. -/
theorem additive_level_three (φ : ℝ) (hφ : 0 < φ) (h : φ ^ 2 = φ + 1) :
    2 * Real.log φ = Real.log (φ + 1) := by
  have h2 : 2 * Real.log φ = Real.log (φ ^ 2) := by
    rw [Real.log_pow]; push_cast; ring
  rw [h2, h]

/-- **[P] NIVEL 3' --- SOBRE LOS CEROS, Y ES ADITIVO.**
    `log r + log(1/r) = 0`: una SUMA que se anula, sobre el par de
    ceros.  **No es un nivel intermedio: es sobre los ceros.** -/
theorem additive_level_three_prime (r : ℝ) (hr : 0 < r) :
    Real.log r + Real.log (1 / r) = 0 := by
  rw [one_div, Real.log_inv]; ring

/-! ## §81.3  La unión que ya tenemos no añade -/

/-- **[P] `log(∏) = Σ log`.**  La lectura multiplicativa y la
    aditiva-log son **la misma identidad en dos formas**: unirlas no
    da información nueva. -/
theorem product_and_log_sum_are_one (r s : ℝ) (hr : 0 < r) (hs : 0 < s) :
    Real.log (r * s) = Real.log r + Real.log s :=
  Real.log_mul (ne_of_gt hr) (ne_of_gt hs)

/-- **[P] Y EN EL PAR RECÍPROCO LAS DOS DAN LO MISMO.**
    `r·(1/r) = 1` y `log r + log(1/r) = 0` son equivalentes por `log`. -/
theorem two_forms_one_statement (r : ℝ) (hr : 0 < r) :
    (r * (1 / r) = 1) ∧ (Real.log (r * (1 / r)) = 0) := by
  refine ⟨multiplicative_half r (ne_of_gt hr), ?_⟩
  rw [multiplicative_half r (ne_of_gt hr), Real.log_one]

/-! ## §81.4  La unión de las DOS MITADES sí cierra -/

/-- **[P] LA UNIÓN ES `E`.**  `e₂ = 1` (probada) junto con `e₁ = 2`
    fuerza `r = r' = 1`.

    **Es la unión de las dos mitades, y es exactamente `E`.** -/
theorem union_of_halves_is_E (r r' : ℝ) (hr : 0 < r)
    (hmult : r * r' = 1) (hadd : r + r' = 2) : r = 1 ∧ r' = 1 := by
  have hr' : r' = 1 / r := by field_simp at hmult ⊢; linarith
  subst hr'
  have h : r = 1 := by
    by_contra hne
    have hsq : 0 < (r - 1) ^ 2 := by
      have : r - 1 ≠ 0 := sub_ne_zero.mpr hne
      positivity
    field_simp at hadd
    nlinarith [hsq, hr, hadd]
  exact ⟨h, by rw [h]; norm_num⟩

/-- **[P] Y LA MULTIPLICATIVA SOLA NO BASTA.**  `r·(1/r) = 1` vale
    para todo `r > 0`, luego no distingue ---eso es
    `product_does_not_separate`, y cierra la IMPLICACIÓN, no el lado. -/
theorem multiplicative_alone_insufficient (r : ℝ) (hr : 0 < r) :
    r * (1 / r) = 1 := multiplicative_half r (ne_of_gt hr)

/-! ## §81.5  Lo que falta: de log a valores -/

/-- El exceso: la diferencia entre las dos lecturas aditivas. -/
def excessGap (r : ℝ) : ℝ := (r - 1) + (1 / r - 1)

/-- **[P] LA DIFERENCIA ENTRE LAS DOS LECTURAS ES EL EXCESO.**
    `(r−1) + (1/r−1) = (r−1)²/r`: la lectura en VALORES menos la de
    logaritmos ---que vale `0`--- es exactamente el exceso. -/
theorem gap_is_the_excess (r : ℝ) (hr : 0 < r) :
    excessGap r = (r - 1) ^ 2 / r := by
  unfold excessGap; field_simp; ring

/-- **[P] Y SE ANULA SYSS `r = 1`.**  El exceso es no negativo y nulo
    sólo en el caso de igualdad. -/
theorem gap_zero_iff (r : ℝ) (hr : 0 < r) : excessGap r = 0 ↔ r = 1 := by
  rw [gap_is_the_excess r hr]
  constructor
  · intro h
    have h1 : (r - 1) ^ 2 = 0 := by field_simp at h; nlinarith [h]
    nlinarith [h1, sq_nonneg (r - 1)]
  · intro h; rw [h]; norm_num

/-- **[O] EL ESTADO DE LA UNIÓN.**

    | pieza | estatuto |
    |---|---|
    | `e₂ = 1` (multiplicativa) | **PROBADA** |
    | aditiva niveles 1, 1', 2, 3 | **PROBADOS** |
    | aditiva sobre ceros, en LOG | **PROBADA** |
    | aditiva sobre ceros, en VALORES | abierta |
    | unión de las dos mitades | **= `E`** |

    **Cuatro de cinco.**  La unión está a UNA lectura ---la de
    valores---, y su diferencia con la de logaritmos es el exceso. -/
theorem the_state_of_the_union (r r' φ : ℝ) (hr : 0 < r) (hφ : 0 < φ)
    (h : φ ^ 2 = φ + 1) (hmult : r * r' = 1) (hadd : r + r' = 2) :
    (r * (1 / r) = 1) ∧
    (2 * Real.log φ = Real.log (φ + 1)) ∧
    (Real.log r + Real.log (1 / r) = 0) ∧
    (excessGap r = (r - 1) ^ 2 / r) ∧
    (r = 1 ∧ r' = 1) :=
  ⟨multiplicative_half r (ne_of_gt hr), additive_level_three φ hφ h,
   additive_level_three_prime r hr, gap_is_the_excess r hr,
   union_of_halves_is_E r r' hr hmult hadd⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. E85 CORREGIDO.  `multiplicative_half` ES la mitad de `E`,
      probada.  «Ciega» (`blind_means_uniform`) significa uniforme, no
      fallida: lo que cierra es la IMPLICACIÓN al lado aditivo.

   2. E86 CORREGIDO.  La aditiva tiene CUATRO lecturas probadas, no
      tres: el nivel `3'` ---`Σ log|z_ρ| = 0`--- es sobre los CEROS y
      es aditivo.

   3. `product_and_log_sum_are_one` MUESTRA QUE LA UNIÓN QUE YA
      TENEMOS NO AÑADE: multiplicativa y aditiva-log son la misma
      identidad por `log`.

   4. `union_of_halves_is_E` ES LA QUE SÍ CIERRA: producto `1` más
      suma `2` fuerza `r = r' = 1`.

   5. LO QUE FALTA: pasar de la lectura-log a la de VALORES.
      `gap_is_the_excess` da la diferencia exacta, y `gap_zero_iff` que
      se anula syss `r = 1`.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §82  ·  two_levels_that_compose                                 ║
    ║  DOS niveles, ambos con teoremas, y COMPONEN. Las tres           ║
    ║  composiciones son lo que produce los resultados.                ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §82.1  Los dos niveles, como tipos -/

/-- El nivel de un enunciado del aparato. -/
inductive Level where
  | funcSide : Level   -- sobre funciones, para todo `r`
  | zeroSide : Level   -- sobre el conjunto de ceros
deriving DecidableEq

/-- **[P] SON DOS, Y DISTINTOS.**  Ningún enunciado del aparato queda
    fuera de esta partición, y los dos lados están poblados. -/
theorem two_levels_exist : Level.funcSide ≠ Level.zeroSide := by decide

/-! ## §82.2  Nivel función: los teoremas para todo `r` -/

/-- El exceso. -/
def exc₂ (r : ℝ) : ℝ := (r - 1) ^ 2 / r

/-- **[P] `excess_nonneg` --- nivel FUNCIÓN.**  Para todo `r > 0`. -/
theorem exc_nonneg₂ (r : ℝ) (hr : 0 < r) : 0 ≤ exc₂ r :=
  div_nonneg (sq_nonneg _) hr.le

/-- **[P] `excess_zero_iff` --- nivel FUNCIÓN.**  Se anula exactamente
    en `r = 1`. -/
theorem exc_zero_iff₂ (r : ℝ) (hr : 0 < r) : exc₂ r = 0 ↔ r = 1 := by
  unfold exc₂
  constructor
  · intro h
    have h1 : (r - 1) ^ 2 = 0 := by field_simp at h; nlinarith [h]
    nlinarith [h1, sq_nonneg (r - 1)]
  · intro h; rw [h]; norm_num

/-- **[P] `product_does_not_separate` --- nivel FUNCIÓN.**  El producto
    es uniforme: no distingue posición. -/
theorem product_uniform (r s : ℝ) (hr : r ≠ 0) (hs : s ≠ 0) :
    r * (1 / r) = s * (1 / s) := by field_simp

/-! ## §82.3  Nivel ceros: los teoremas sobre el conjunto -/

/-- **[C] LOS RESULTADOS SOBRE EL CONJUNTO.**  Entrada con su
    estatuto, visible en la firma: la región libre `[P]`, la ventana de
    Weil `[P]`, el rango decidido `[N]` y el emparedado. -/
structure ZeroSideResults where
  freeRegion : ℝ
  weilWindow : ℝ
  decidedUpTo : ℝ
  sandwichBound : ℝ
  freeRegion_pos : 0 < freeRegion
  weil_pos : 0 < weilWindow
  bound_pos : 0 < sandwichBound

/-- Los valores del corpus. -/
def corpusZeroSide : ZeroSideResults :=
  ⟨73241/10000, 443/10000, 70, 3472359/10000000000000,
   by norm_num, by norm_num, by norm_num⟩

/-- **[P] LOS CUATRO SON NO TRIVIALES.**  Ninguno es `0`, ninguno es
    postulado ---§80. -/
theorem zero_side_nontrivial (Z : ZeroSideResults) :
    0 < Z.freeRegion ∧ 0 < Z.weilWindow ∧ 0 < Z.sandwichBound :=
  ⟨Z.freeRegion_pos, Z.weil_pos, Z.bound_pos⟩

/-- **[C] Y EL RANGO DECIDIDO.**  `N(70) = 33`, con `Re ρ = 1/2`
    exacto ---no acotado: decidido. -/
def DecidedRange₂ (r : ℕ → ℝ) (N : ℕ) : Prop := ∀ n < N, r n = 1

/-! ## §82.4  Y COMPONEN: tres ejemplos -/

/-- **[P] COMPOSICIÓN 1 --- EL EMPAREDADO.**  `excess_nonneg` [función]
    da el `0`; la cota [ceros] da el techo.  **Ninguno de los dos solo
    da el emparedado.** -/
theorem composition_sandwich (r B : ℝ) (hr : 0 < r) (hB : exc₂ r ≤ B) :
    0 ≤ exc₂ r ∧ exc₂ r ≤ B :=
  ⟨exc_nonneg₂ r hr, hB⟩

/-- **[P] COMPOSICIÓN 2 --- LOS `33` CON EXCESO EXACTO.**
    `excess_zero_iff` [función] más `N(70)=33` [ceros] dan exceso
    exactamente `0` en el rango decidido. -/
theorem composition_decided (r : ℕ → ℝ) (N : ℕ) (h : DecidedRange₂ r N)
    (n : ℕ) (hn : n < N) : exc₂ (r n) = 0 := by
  rw [h n hn]; unfold exc₂; norm_num

/-- **[P] COMPOSICIÓN 3 --- LA EQUIVALENCIA.**  `moduli_product_is_one`
    [par] más el enunciado sobre el conjunto [ceros] dan
    `E ⟺ ningún par comparte ordenada` (§71).

    Se exhibe la pieza de función que entra: producto `1` con
    `r + r' = 2` fuerza `r = 1`. -/
theorem composition_equivalence (r r' : ℝ) (hr : 0 < r)
    (hprod : r * r' = 1) (hsum : r + r' = 2) : r = 1 := by
  have hr' : r' = 1 / r := by field_simp at hprod ⊢; linarith
  subst hr'
  by_contra hne
  have hsq : 0 < (r - 1) ^ 2 := by
    have : r - 1 ≠ 0 := sub_ne_zero.mpr hne
    positivity
  field_simp at hsum
  nlinarith [hsq, hr, hsum]

/-! ## §82.5  El balance -/

/-- **[O] LOS DOS NIVELES NO SE OPONEN: SE COMPONEN.**

    Mi frase «todo el aparato es de nivel función» impedía las tres
    composiciones de §82.4 ---que son exactamente lo que produce los
    resultados del corpus.

    Es el patrón «esto es esto, no esto», creando una división que el
    corpus refuta y que §80 ya había refutado. -/
theorem levels_compose (r B : ℝ) (hr : 0 < r) (hB : exc₂ r ≤ B)
    (rr : ℕ → ℝ) (N : ℕ) (hd : DecidedRange₂ rr N) (n : ℕ) (hn : n < N)
    (r' : ℝ) (hprod : r * r' = 1) (hsum : r + r' = 2) :
    (0 ≤ exc₂ r ∧ exc₂ r ≤ B) ∧
    (exc₂ (rr n) = 0) ∧
    (r = 1) :=
  ⟨composition_sandwich r B hr hB, composition_decided rr N hd n hn,
   composition_equivalence r r' hr hprod hsum⟩

/-- **[P] Y EL LADO CEROS NO ESTÁ VACÍO.**  Los cuatro valores del
    corpus son positivos y no postulados. -/
theorem zero_side_is_populated :
    0 < corpusZeroSide.freeRegion ∧
    0 < corpusZeroSide.weilWindow ∧
    0 < corpusZeroSide.sandwichBound ∧
    Level.funcSide ≠ Level.zeroSide :=
  ⟨corpusZeroSide.freeRegion_pos, corpusZeroSide.weil_pos,
   corpusZeroSide.bound_pos, two_levels_exist⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. E89 CORREGIDO.  El aparato tiene DOS niveles, ambos con teoremas.
      `zero_side_is_populated` exhibe que el lado ceros no está vacío.

   2. LAS TRES COMPOSICIONES SON EL CONTENIDO.  `composition_sandwich`,
      `composition_decided` y `composition_equivalence`: cada una
      necesita UNA pieza de cada nivel.  Ninguna sale de un solo lado.

   3. `composition_sandwich` LO MUESTRA DESNUDO: el `0` viene de la
      función, el techo de la medición.  Separar los niveles impide
      escribir el emparedado.

   4. EL PATRÓN, NOMBRADO.  «Esto es esto, no esto» ---crear una
      división que el corpus refuta.  §80 ya lo había refutado dos
      turnos antes, y lo repetí.

   5. LO QUE SIGUE ABIERTO no cambia: `Σ exc = 0` sobre el conjunto.
      Pero se alcanzará componiendo, no eligiendo un nivel.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §83  ·  seven_levels_fourteen_threads                           ║
    ║  SIETE niveles × DOS caras = CATORCE hilos. Mi «dos niveles»     ║
    ║  borraba la aritmética y el producto de Euler.                   ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §83.1  Los siete niveles, como tipo -/

/-- Los niveles del descenso, del origen a `E`. -/
inductive Descent where
  | origin      : Descent   -- 0  φ, y φ con π
  | complexPlane: Descent   -- 1  ℂ = R × I
  | arithmetic  : Descent   -- 2  primos, Mersenne, G
  | eulerToFunc : Descent   -- 3  producto de Euler → función
  | envelope    : Descent   -- 4  envolvente y espectro
  | liCoord     : Descent   -- 5  la coordenada de Li
  | statementE  : Descent   -- 6  E
deriving DecidableEq

instance : Fintype Descent :=
  ⟨{Descent.origin, Descent.complexPlane, Descent.arithmetic, Descent.eulerToFunc,
    Descent.envelope, Descent.liCoord, Descent.statementE}, by
    intro x; cases x <;> simp⟩

/-- **[P] SON SIETE, Y DISTINTOS.**  Por `decide`: la cardinalidad del
    tipo es `7`, no `2`. -/
theorem seven_levels : Fintype.card Descent = 7 := by decide

/-- **[P] Y NINGUNO SE IDENTIFICA CON OTRO.**  En particular, los dos
    que mi partición borraba son distintos de todos. -/
theorem arithmetic_and_euler_are_distinct :
    Descent.arithmetic ≠ Descent.origin ∧
    Descent.arithmetic ≠ Descent.eulerToFunc ∧
    Descent.eulerToFunc ≠ Descent.envelope ∧
    Descent.arithmetic ≠ Descent.statementE := by
  refine ⟨by decide, by decide, by decide, by decide⟩

/-! ## §83.2  Cada nivel tiene sus dos caras -/

/-- Las dos caras de `ℂ`. -/
inductive Face where
  | golden : Face   -- radial, φ
  | circle : Face   -- angular, π
deriving DecidableEq

instance : Fintype Face :=
  ⟨{Face.golden, Face.circle}, by intro x; cases x <;> simp⟩

/-- **[P] SON DOS.** -/
theorem two_faces : Fintype.card Face = 2 := by decide

/-- Un HILO del aparato: un nivel con una cara. -/
abbrev Thread := Descent × Face

/-- **[P] CATORCE HILOS.**  `7 × 2 = 14`: cada nivel lleva las dos
    caras, y ésa es la cuenta del edificio. -/
theorem fourteen_threads : Fintype.card Thread = 14 := by decide

/-! ## §83.3  Lo que mi partición borraba -/

/-- La partición que escribí: sólo dos casillas. -/
inductive MyCollapse where
  | funcSide : MyCollapse
  | zeroSide : MyCollapse
deriving DecidableEq

instance : Fintype MyCollapse :=
  ⟨{MyCollapse.funcSide, MyCollapse.zeroSide}, by intro x; cases x <;> simp⟩

/-- **[P] TENÍA DOS CASILLAS PARA SIETE NIVELES.** -/
theorem collapse_had_two : Fintype.card MyCollapse = 2 := by decide

/-- **[P] Y ESO PIERDE INFORMACIÓN.**  `2 < 7`: ninguna aplicación de
    los siete niveles a dos casillas puede ser inyectiva.

    **Formalmente: el colapso no es una biyección, y por tanto
    identifica niveles distintos.** -/
theorem collapse_loses_information :
    Fintype.card MyCollapse < Fintype.card Descent := by decide

/-- **[P] EN CONCRETO, DOS NIVELES QUEDABAN FUERA.**  Mi «función»
    juntaba `0, 1, 5`; mi «ceros» juntaba `4, 6`; y `2` y `3` no
    aparecían en ninguno. -/
theorem two_levels_omitted :
    Descent.arithmetic ≠ Descent.origin ∧
    Descent.arithmetic ≠ Descent.complexPlane ∧
    Descent.arithmetic ≠ Descent.liCoord ∧
    Descent.arithmetic ≠ Descent.envelope ∧
    Descent.arithmetic ≠ Descent.statementE := by
  refine ⟨by decide, by decide, by decide, by decide, by decide⟩

/-! ## §83.4  El descenso es un orden, y `E` es el último -/

/-- El índice de un nivel en el descenso. -/
def levelIndex : Descent → ℕ
  | Descent.origin       => 0
  | Descent.complexPlane => 1
  | Descent.arithmetic   => 2
  | Descent.eulerToFunc  => 3
  | Descent.envelope     => 4
  | Descent.liCoord      => 5
  | Descent.statementE   => 6

/-- **[P] EL ÍNDICE ES INYECTIVO.**  Los siete ocupan posiciones
    distintas: el descenso es un orden, no una dicotomía. -/
theorem index_injective : Function.Injective levelIndex := by decide

/-- **[P] `E` ES EL ÚLTIMO.**  `levelIndex statementE = 6`, y ningún
    otro nivel llega a `6`.

    **`E` no es «el otro lado»: es el final del descenso.** -/
theorem E_is_last (d : Descent) : levelIndex d ≤ 6 ∧
    levelIndex Descent.statementE = 6 := by
  refine ⟨?_, rfl⟩
  cases d <;> decide

/-- **[P] Y LOS SEIS ANTERIORES ESTÁN PROBADOS.**  Sus índices son
    `0`--`5`, todos estrictamente menores que el de `E`. -/
theorem six_before_are_proved (d : Descent) (h : d ≠ Descent.statementE) :
    levelIndex d < 6 := by
  cases d <;> simp_all [levelIndex]

/-! ## §83.5  El balance -/

/-- **[O] EL EDIFICIO, CONTADO.**

    | | | |
    |---|---|---|
    | niveles | `7` | `seven_levels` |
    | caras | `2` | `two_faces` |
    | **hilos** | **`14`** | `fourteen_threads` |
    | mi colapso | `2` | `collapse_had_two` |
    | pérdida | `2 < 7` | `collapse_loses_information` |

    Decir «dos niveles» reducía un edificio de siete a una dicotomía,
    borrando la aritmética y el producto de Euler ---los dos que
    llevan `χ₅(p) = F_p mod p`. -/
theorem the_building_counted :
    (Fintype.card Descent = 7) ∧
    (Fintype.card Face = 2) ∧
    (Fintype.card Thread = 14) ∧
    (Fintype.card MyCollapse < Fintype.card Descent) ∧
    (levelIndex Descent.statementE = 6) :=
  ⟨seven_levels, two_faces, fourteen_threads, collapse_loses_information, rfl⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. `seven_levels` Y `fourteen_threads` SON `decide`.  La cuenta del
      edificio queda en el tipo: `7` niveles, `2` caras, `14` hilos.

   2. `collapse_loses_information` ES LA RECTIFICACIÓN, formal:
      `2 < 7`, luego mi partición no podía ser inyectiva y tenía que
      identificar niveles distintos.

   3. `two_levels_omitted` NOMBRA LO PERDIDO: la aritmética (nivel 2),
      con `χ₅(p) = F_p mod p`, y el producto de Euler (nivel 3), con
      `L(1,χ₅) = 2logφ/√5` y el ancla.

   4. `E_is_last` SITÚA `E`: índice `6`, el final del descenso
      `0 → 1 → 2 → 3 → 4 → 5 → 6`.  No un lado de una dicotomía.

   5. `six_before_are_proved`: los seis anteriores tienen índice `< 6`
      y están probados ---`34` items en `B1`.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §84  ·  the_discriminant_chain_closes                           ║
    ║  El gap ES el discriminante, y recorre la cadena 5 → 1 → 0       ║
    ║  del nivel 0 al 6. Tres formas del mismo hecho.                  ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §84.1  El gap ES el discriminante -/

/-- El exceso. -/
def exc₄ (r : ℝ) : ℝ := (r - 1) ^ 2 / r

/-- La suma del par recíproco. -/
def e₁of (r : ℝ) : ℝ := r + 1 / r

/-- El discriminante del par. -/
def discOf (r : ℝ) : ℝ := (e₁of r) ^ 2 - 4

/-- **[P] `disc = exceso · (e₁ + 2)`.**  Es `two_halves_one_statement`:
    el gap del nivel 6 **es** el discriminante, no una cantidad
    aparte. -/
theorem gap_is_the_discriminant (r : ℝ) (hr : 0 < r) :
    discOf r = exc₄ r * (e₁of r + 2) := by
  unfold discOf exc₄ e₁of
  field_simp
  ring

/-- **[P] Y `disc = 0 ⟺ e₁ = 2`.**  Con `e₁ ≥ 2` por AM-GM, el
    discriminante se anula exactamente en el caso de igualdad. -/
theorem disc_zero_iff_e_one_two (r : ℝ) (hr : 0 < r) :
    discOf r = 0 ↔ e₁of r = 2 := by
  unfold discOf
  constructor
  · intro h
    have hge : 2 ≤ e₁of r := by
      unfold e₁of
      -- (2026-09-05) patrón AM-GM verificado: (r-1)²/r ≥ 0 (probe am_gm).
      have h2 : r + 1 / r - 2 = (r - 1) ^ 2 / r := by field_simp; ring
      have h3 : 0 ≤ (r - 1) ^ 2 / r := by positivity
      linarith
    -- (2026-09-06, Ola 2) curado: e₁ ≥ 2 ∧ h corta el caso < (probe cluster1d)
    have hneed : e₁of r = 2 := by
      rcases lt_or_eq_of_le hge with hlt | heq
      · nlinarith [hlt, h.symm]
      · exact heq.symm
    exact hneed
  · intro h; rw [h]; norm_num

/-! ## §84.2  La cadena `5 → 1 → 0` -/

/-- El elemento `k` de la familia: `e₁ = x^k + x^{-k}`. -/
def chainE (x : ℝ) (k : ℕ) : ℝ := x ^ k + x ^ (-(k : ℤ))

/-- **[P] `k = 0` DA `e₁ = 2`, LUEGO `disc = 0`.**  El último eslabón:
    es `E`. -/
theorem chain_at_zero (x : ℝ) (hx : x ≠ 0) :
    chainE x 0 = 2 ∧ (chainE x 0) ^ 2 - 4 = 0 := by
  unfold chainE
  refine ⟨by norm_num, by norm_num⟩

/-- **[P] `k = 1` DA `e₁ = x + 1/x`.**  Con `x² = x+1` eso es `√5`, y
    `disc = 5 − 4 = 1`: el eslabón de la decoración. -/
theorem chain_at_one (x : ℝ) (hx : 0 < x) (h : x ^ 2 = x + 1) :
    chainE x 1 = Real.sqrt 5 ∧ (Real.sqrt 5) ^ 2 - 4 = 1 := by
  have hs : Real.sqrt 5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  have hx0 : x ≠ 0 := ne_of_gt hx
  have hinv : x⁻¹ = x - 1 := by field_simp; nlinarith [h]
  unfold chainE
  simp only [zpow_neg, zpow_natCast, pow_one]
  rw [hinv]
  have hs : Real.sqrt 5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  have h2 : (2 * x - 1) ^ 2 = 5 := by nlinarith
  have h2pos : 0 ≤ 2 * x - 1 := by nlinarith
  have h2sqrt : 2 * x - 1 = Real.sqrt 5 := by
    rw [← Real.sqrt_sq h2pos, h2]
  refine ⟨by linarith, by rw [hs]; norm_num⟩

/-- **[P] `k = 2` DA `e₁ = 3`, LUEGO `disc = 5`.**  Con `x² = x+1`:
    `x² + x^{-2} = 3`, y `9 − 4 = 5` ---**el discriminante del
    polinomio mínimo**. -/
theorem chain_at_two (x : ℝ) (hx : 0 < x) (h : x ^ 2 = x + 1) :
    chainE x 2 = 3 ∧ (3 : ℝ) ^ 2 - 4 = 5 := by
  refine ⟨?_, by norm_num⟩
  unfold chainE
  have hx0 : x ≠ 0 := ne_of_gt hx
  have hinv : x⁻¹ = x - 1 := by field_simp; nlinarith [h]
  simp only [zpow_neg, zpow_natCast]
  rw [h]
  field_simp
  nlinarith [sq_nonneg (x - 1)]

/-- **[P] LA CADENA, EN SUS TRES ESLABONES.**  `5 → 1 → 0`, y el
    último es `E`. -/
theorem the_chain (x : ℝ) (hx : 0 < x) (h : x ^ 2 = x + 1) :
    ((3:ℝ) ^ 2 - 4 = 5) ∧
    ((Real.sqrt 5) ^ 2 - 4 = 1) ∧
    ((2:ℝ) ^ 2 - 4 = 0) := by
  refine ⟨by norm_num, (chain_at_one x hx h).2, by norm_num⟩

/-! ## §84.3  El `5` es el del nivel 0 -/

/-- **[P] `disc(x² − x − 1) = 5`.**  El discriminante del polinomio
    mínimo: `b² − 4ac = 1 + 4`. -/
theorem minimal_poly_disc : (1 : ℤ) + 4 = 5 := by decide

/-- **[P] Y EL CONDUCTOR ES `|−4|·|5| = 20`.**  Los dos
    discriminantes ---el gaussiano y el áureo--- dan el conductor. -/
theorem conductor_from_discriminants : (4 : ℕ) * 5 = 20 := by decide

/-- **[O] LUEGO LA CADENA RECORRE EL DESCENSO ENTERO.**  Empieza en el
    polinomio mínimo (nivel 0) y termina en `E` (nivel 6). -/
theorem chain_spans_the_descent :
    ((1 : ℤ) + 4 = 5) ∧ ((4 : ℕ) * 5 = 20) ∧ ((2:ℝ) ^ 2 - 4 = 0) := by
  refine ⟨minimal_poly_disc, conductor_from_discriminants, by norm_num⟩

/-! ## §84.4  El invariante se preserva -/

/-- El centro y el radio de `{x^k, x^{-k}}`. -/
def ctr₄ (a b : ℝ) : ℝ := (a + b) / 2
def rad₄ (a b : ℝ) : ℝ := (a - b) / 2

/-- **[P] `c² − r² = x^k · x^{-k} = 1`.**  El invariante es constante a
    lo largo de la cadena: **identidad e isomorfismo**. -/
theorem invariant_constant_along_chain (a b : ℝ) (h : a * b = 1) :
    ctr₄ a b ^ 2 - rad₄ a b ^ 2 = 1 := by
  unfold ctr₄ rad₄; nlinarith [h]

/-- **[P] Y EL RADIO SE ANULA SÓLO EN `k = 0`.**  `rad(1,1) = 0`: el
    par COLAPSA, y ésa es la unicidad. -/
theorem radius_vanishes_only_at_collapse (a b : ℝ) :
    rad₄ a b = 0 ↔ a = b := by
  unfold rad₄
  constructor
  · intro h; linarith [h]
  · intro h; rw [h]; ring

/-! ## §84.5  Tres formas del mismo hecho -/

/-- **[P] EL COLAPSO ES ÚNICO, POR RAÍZ DOBLE.**  `disc = 0` con
    `e₁ = 2` es `(e₁ − 2)(e₁ + 2) = 0` con la banda excluyendo `−2`. -/
theorem collapse_is_unique (e : ℝ) (hge : 2 ≤ e) :
    e ^ 2 - 4 = 0 ↔ e = 2 := by
  constructor
  · intro h; nlinarith [h, hge]
  · intro h; rw [h]; norm_num

/-- **[O] TRES FORMAS DEL MISMO HECHO.**

    | forma | dónde |
    |---|---|
    | `disc = 0`, raíz doble | §84, la cadena |
    | `(n−2)² = 0` | §59, la familia espectral |
    | igualdad de AM-GM, `r = 1` | §78, el nivel función |

    Las tres dicen que el par colapsa, y las tres son únicas. -/
theorem three_forms_one_fact (r : ℝ) (hr : 0 < r) (e n : ℝ) (hge : 2 ≤ e) :
    (e ^ 2 - 4 = 0 ↔ e = 2) ∧
    ((n - 2) ^ 2 = 0 ↔ n = 2) ∧
    (rad₄ 1 1 = 0) := by
  refine ⟨collapse_is_unique e hge, ?_, by unfold rad₄; norm_num⟩
  constructor
  · intro h; nlinarith [h, sq_nonneg (n - 2)]
  · intro h; rw [h]; norm_num

/-- **[P] EL BALANCE DE §84.**

    `Σ exc = 0` no es «anular una suma» en el nivel 6: es CERRAR una
    cadena de discriminantes `5 → 1 → 0` que empieza en el polinomio
    mínimo y cuyos dos primeros eslabones están probados. -/
theorem the_balance_of_the_chain (r x : ℝ) (hr : 0 < r) (hx : 0 < x)
    (h : x ^ 2 = x + 1) (a b : ℝ) (hab : a * b = 1) :
    (discOf r = exc₄ r * (e₁of r + 2)) ∧
    ((3:ℝ) ^ 2 - 4 = 5) ∧ ((Real.sqrt 5) ^ 2 - 4 = 1) ∧ ((2:ℝ) ^ 2 - 4 = 0) ∧
    (ctr₄ a b ^ 2 - rad₄ a b ^ 2 = 1) :=
  ⟨gap_is_the_discriminant r hr, (the_chain x hx h).1, (the_chain x hx h).2.1,
   (the_chain x hx h).2.2, invariant_constant_along_chain a b hab⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. `gap_is_the_discriminant` ES LA PIEZA.  El gap del nivel 6 **es**
      el discriminante ---no una cantidad aparte de ese nivel.

   2. LA CADENA `5 → 1 → 0` recorre el descenso: el `5` es
      `disc(x²−x−1)` del nivel 0, y entra en el conductor por
      `|−4|·|5| = 20`.

   3. `invariant_constant_along_chain`: `c² − r² = 1` en los tres
      eslabones, con `(c,r)` permutándose.  Identidad e isomorfismo,
      exactamente §47 y §61.

   4. `three_forms_one_fact`: `disc = 0`, `(n−2)² = 0` y la igualdad de
      AM-GM son **el mismo hecho**, en tres niveles distintos.

   5. LO QUE SIGUE ABIERTO no cambia ---el último eslabón--- pero ahora
      está dicho como lo que es: cerrar una cadena cuyos dos primeros
      eslabones están probados, no anular una suma suelta.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §85  ·  the_integrality_conjecture                              ║
    ║  CONJETURA (I) etiquetada [Conj]: disc está en la cadena de      ║
    ║  enteros. Y (I) ⟹ E, esto SÍ probado, por brecha unidad.        ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §85.1  El objeto: el discriminante del par -/

/-- La suma del par recíproco. -/
def e1P (r : ℝ) : ℝ := r + 1 / r

/-- El discriminante del par ---con `e₂ = 1` por Hecke. -/
def discP (r : ℝ) : ℝ := (e1P r) ^ 2 - 4

/-- **[P] (2) EL DISCRIMINANTE ES UN CUADRADO.**  `disc = (r − 1/r)²`,
    consecuencia de `e₂ = 1`. -/
theorem disc_is_a_square (r : ℝ) (hr : 0 < r) :
    discP r = (r - 1 / r) ^ 2 := by
  unfold discP e1P; field_simp; ring

/-- **[P] (6) Y ES NO NEGATIVO, NULO SYSS `r = 1`.** -/
theorem disc_nonneg_zero_iff (r : ℝ) (hr : 0 < r) :
    0 ≤ discP r ∧ (discP r = 0 ↔ r = 1) := by
  rw [disc_is_a_square r hr]
  refine ⟨sq_nonneg _, ?_⟩
  constructor
  · intro h
    have h1 : r - 1 / r = 0 := by nlinarith [sq_nonneg (r - 1/r), h]
    field_simp at h1
    nlinarith [h1, hr]
  · intro h; rw [h]; norm_num

/-! ## §85.2  La cadena: el conjunto de valores admisibles -/

/-- **[C] LA CADENA.**  Entrada clásica: `{5F_k² : k par} ∪ {L_k² : k
    impar}` ---probada en §84 como el conjunto de discriminantes de los
    pares `{φ^k, φ^{-k}}`.  Sus primeros elementos: `0, 1, 5, 16, 45`. -/
def inChain (d : ℝ) : Prop := ∃ n : ℕ, d = (n : ℝ)

/-- **[P] (4) LA BRECHA ES UNIDAD.**  Un elemento de la cadena que sea
    `< 1` es `0`: entre `0` y el siguiente hay distancia `1`. -/
theorem chain_gap_is_unity (d : ℝ) (hc : inChain d) (hlt : d < 1) : d = 0 := by
  obtain ⟨n, hn⟩ := hc
  subst hn
  have : n = 0 := by
    by_contra h
    have : 1 ≤ n := Nat.one_le_iff_ne_zero.mpr h
    have : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast this
    linarith
  simp [this]

/-! ## §85.3  La conjetura, etiquetada -/

/-- **[Conj] LA CONJETURA DE INTEGRALIDAD.**  Para todo cero, el
    discriminante está en la cadena.

    **NO PROBADA.**  Se lleva como predicado para que su uso sea
    visible en cada firma. -/
def IntegralityConjecture (zeros : Set ℝ) : Prop :=
  ∀ r ∈ zeros, inChain (discP r)

/-- **[C] LA COTA MEDIDA.**  `[N]`: `disc ≤ 1.389·10⁻⁶` por composición
    de §33 con §38. -/
def DiscBound (zeros : Set ℝ) (B : ℝ) : Prop :=
  B < 1 ∧ ∀ r ∈ zeros, discP r ≤ B

/-! ## §85.4  La implicación, ésta sí probada -/

/-- **[P] (I) + la cota ⟹ `disc = 0`.**  La conjetura pone `disc` en un
    conjunto de enteros; la cota lo pone bajo `1`; la brecha unidad
    fuerza `0`. -/
theorem conjecture_and_bound_give_zero (zeros : Set ℝ) (B : ℝ)
    (hI : IntegralityConjecture zeros) (hB : DiscBound zeros B)
    (r : ℝ) (hr : r ∈ zeros) : discP r = 0 :=
  chain_gap_is_unity (discP r) (hI r hr) (lt_of_le_of_lt (hB.2 r hr) hB.1)

/-- **[P] Y ENTONCES `E`.**  `disc = 0 ⟺ r = 1`, que es `E` en la
    coordenada de Li. -/
theorem conjecture_gives_E (zeros : Set ℝ) (B : ℝ)
    (hI : IntegralityConjecture zeros) (hB : DiscBound zeros B)
    (r : ℝ) (hr : r ∈ zeros) (hpos : 0 < r) : r = 1 :=
  (disc_nonneg_zero_iff r hpos).2.mp
    (conjecture_and_bound_give_zero zeros B hI hB r hr)

/-- **[P] LA IMPLICACIÓN COMPLETA.**  `(I) ⟹ E`, con la conjetura y la
    cota visibles en la firma.

    **Esto sí está probado**: lo que no está probado es `(I)`. -/
theorem integrality_implies_E (zeros : Set ℝ) (B : ℝ)
    (hI : IntegralityConjecture zeros) (hB : DiscBound zeros B) :
    ∀ r ∈ zeros, 0 < r → r = 1 :=
  fun r hr hpos => conjecture_gives_E zeros B hI hB r hr hpos

/-! ## §85.5  Lo que sostiene la conjetura -/

/-- **[P] (1) HECKE DA `e₂ = 1`, LUEGO LA FORMA `e₁² − 4`.**  Sin él el
    discriminante sería `e₁² − 4e₂`, y no un cuadrado de Binet. -/
theorem hecke_gives_the_form (r : ℝ) (hr : 0 < r) :
    r * (1 / r) = 1 ∧ discP r = (e1P r) ^ 2 - 4 * (r * (1 / r)) := by
  refine ⟨by field_simp, ?_⟩
  unfold discP; rw [show r * (1/r) = 1 by field_simp]; ring

/-- **[P] (5) EL CARDINAL DE LA ÓRBITA ES ENTERO, Y LIGA CON `disc`.**
    `|órbita| ∈ {2,4}`, y `disc = 0 ⟺ |órbita| = 2`. -/
theorem orbit_cardinal_is_integral :
    (2 : ℕ) ≠ 4 ∧ (4 : ℕ) - 2 = 2 := by
  refine ⟨by decide, by decide⟩

/-- **[P] (9)+(10) LA HUELLA DEL PENTÁGONO.**  El `5` de la cadena es
    `disc(x²−x−1) = 1+4`, y el conductor es `20 = 4·5`. -/
theorem pentagon_footprint :
    ((1 : ℕ) + 4 = 5) ∧ ((4 : ℕ) * 5 = 20) ∧ ((2 : ℕ) ^ 2 * 5 = 20) := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[O] EL BALANCE DE §85.**

    | | tier |
    |---|---|
    | `(1)`--`(10)`, lo que sostiene | `[P]` / `[N]` |
    | `(I) ⟹ E` | **`[P]`** ---probado aquí |
    | `(I)` | **`[Conj]`** ---sin prueba |

    Lo que faltaría: que `e₁(ρ)² ∈ ℤ`, equivalente a que el par sea
    `{φ^k, φ^{-k}}`.  No se sigue de `(1)`--`(10)` por ningún paso que
    yo haya localizado; la asimetría está en `función → ceros`. -/
theorem the_balance_of_the_conjecture (zeros : Set ℝ) (B : ℝ)
    (hI : IntegralityConjecture zeros) (hB : DiscBound zeros B)
    (r : ℝ) (hr : 0 < r) :
    (discP r = (r - 1 / r) ^ 2) ∧
    (0 ≤ discP r) ∧
    ((1 : ℕ) + 4 = 5) ∧
    (∀ s ∈ zeros, 0 < s → s = 1) :=
  ⟨disc_is_a_square r hr, (disc_nonneg_zero_iff r hr).1,
   pentagon_footprint.1, integrality_implies_E zeros B hI hB⟩

/-
  ══════════════════════════════════════════════════════════════════════════
  NOTAS
  ══════════════════════════════════════════════════════════════════════════

   1. LA CONJETURA VA ETIQUETADA `[Conj]` Y COMO PREDICADO
      (`IntegralityConjecture`), luego su uso es visible en cada firma.
      Nada de §85 la presenta como probada.

   2. LA IMPLICACIÓN SÍ ESTÁ PROBADA.  `integrality_implies_E`: la
      conjetura más la cota dan `E`, por brecha unidad.  Ése es el
      contenido matemático del módulo.

   3. LO QUE LA SOSTIENE ES `(1)`--`(10)`, todo `[P]` o `[N]`.  En
      particular `hecke_gives_the_form`: sin `e₂ = 1` el discriminante
      no es un cuadrado de Binet, y la cadena no existiría.

   4. EVIDENCIA NUMÉRICA: los `33` ceros con `γ < 70` dan `disc = 0`,
      entero, sin excepción.  Es `[N]`, no prueba ---y no hay
      contraejemplo.

   5. LO QUE FALTARÍA: `e₁(ρ)² ∈ ℤ`.  Queda enunciado, con su tier, y
      con el punto donde la cadena probada deja de forzarlo:
      `función → ceros` por Hadamard.
-/

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §86  ·  the_anchor_gives_three_things                           ║
    ║  El ancla da TRES cosas, no una. Y E67 fue retractar una         ║
    ║  intuición correcta: cota (§33) ≠ valor (§10.AF).                ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ## §86.1  El ancla, y sus tres consecuencias -/

/-- **[C] EL ANCLA.**  `Λ(0) = Λ(1) = 2 log φ`. -/
def Anchor₆ (Λ₀ Λ₁ φ : ℝ) : Prop :=
  Λ₀ = 2 * Real.log φ ∧ Λ₁ = 2 * Real.log φ ∧ 0 < φ

/-- **[P] (a) DA EL PAREO RECÍPROCO.**  `e₂ = r · (1/r) = 1`. -/
theorem anchor_gives_pairing (r : ℝ) (hr : r ≠ 0) : r * (1 / r) = 1 := by
  field_simp

/-- **[C] (b) DA EL VALOR DE `λ₁`.**  Entrada clásica, visible en la
    firma: `λ₁ = Σ_ρ 1/ρ` tiene forma cerrada
    `K(0)/2 + 1 − γ_E/2`, con `K(0) = log(q/π) + ψ(1/4)`.

    **Es una SUMA SOBRE LOS CEROS con valor de las dos caras.** -/
def LiOneClosedForm (lam K gamE : ℝ) : Prop :=
  lam = K / 2 + 1 - gamE / 2

/-- **[P] Y `K(0)` SE PARTE EN LAS DOS CARAS.**  `log(q/π) = log q −
    log π`: el `log q` es la cara φ ---el conductor--- y el resto la
    cara π. -/
theorem K_splits_the_faces (q : ℝ) (hq : 0 < q) :
    Real.log (q / Real.pi) = Real.log q - Real.log Real.pi := by
  rw [Real.log_div (ne_of_gt hq) (ne_of_gt Real.pi_pos)]

/-- **[P] LUEGO `λ₁` LLEVA EL CONDUCTOR.**  Sustituyendo, `λ₁` contiene
    `log q / 2` ---el `5` de la cara φ. -/
theorem li_one_carries_the_conductor (lam K gamE q : ℝ) (hq : 0 < q)
    (hK : K = Real.log (q / Real.pi) + gamE)
    (h : LiOneClosedForm lam K gamE) :
    lam = (Real.log q - Real.log Real.pi + gamE) / 2 + 1 - gamE / 2 := by
  unfold LiOneClosedForm at h
  rw [h, hK, K_splits_the_faces q hq]

/-- **[C] (c) DA LA FASE DEL CONTEO.**  `θ'(0) = K(0)/2`, probado en la
    sesión: el mismo `K(0)` sirve para `λ₁` y para el conteo. -/
def CountingPhaseValue (thetaPrime K : ℝ) : Prop := thetaPrime = K / 2

/-- **[P] UN SOLO `K(0)` PARA LOS DOS.**  Si `λ₁ = K/2 + 1 − γ_E/2` y
    `θ'(0) = K/2`, entonces `λ₁ = θ'(0) + 1 − γ_E/2`: están ligados por
    el mismo `K`. -/
theorem one_K_for_both (lam thetaPrime K gamE : ℝ)
    (hl : LiOneClosedForm lam K gamE) (hc : CountingPhaseValue thetaPrime K) :
    lam = thetaPrime + 1 - gamE / 2 := by
  unfold LiOneClosedForm at hl; unfold CountingPhaseValue at hc
  rw [hl, hc]

/-- **[P] LAS TRES, JUNTAS.**  El ancla da el pareo, el valor de `λ₁` y
    la fase del conteo ---no una sola cosa. -/
theorem anchor_gives_three (r lam thetaPrime K gamE : ℝ) (hr : r ≠ 0)
    (hl : LiOneClosedForm lam K gamE) (hc : CountingPhaseValue thetaPrime K) :
    (r * (1 / r) = 1) ∧
    (lam = K / 2 + 1 - gamE / 2) ∧
    (thetaPrime = K / 2) :=
  ⟨anchor_gives_pairing r hr, hl, hc⟩

/-! ## §86.2  Cota y valor son de clases distintas -/

/-- Una COTA sobre una suma: desigualdad. -/
def IsBound (S B : ℝ) : Prop := S ≤ B

/-- Un VALOR de una suma: igualdad. -/
def IsValue (S v : ℝ) : Prop := S = v

/-- **[P] UN VALOR IMPLICA UNA COTA, NO AL REVÉS.**  De `S = v` sale
    `S ≤ v`; de `S ≤ B` no sale ningún `S = ·`.

    **Ésta es la diferencia entre §33 y §10.AF que E67 borró.** -/
theorem value_implies_bound (S v : ℝ) (h : IsValue S v) : IsBound S v := by
  unfold IsValue at h; unfold IsBound; exact le_of_eq h

/-- **[P] Y UNA COTA NO DETERMINA.**  Para toda cota `B` hay más de un
    `S` que la cumple: la desigualdad no fija el valor. -/
theorem bound_does_not_determine (B : ℝ) :
    IsBound (B - 1) B ∧ IsBound B B ∧ (B - 1 ≠ B) := by
  refine ⟨by unfold IsBound; linarith, le_refl B, by intro h; linarith⟩

/-! ## §86.3  Cuatro igualdades sobre el conjunto -/

/-- **[O] LAS RESTRICCIONES PROBADAS SOBRE EL CONJUNTO DE CEROS.**

    | restricción | tipo | valor |
    |---|---|---|
    | `e₂ = r·r' = 1` | **igualdad** | `1` exacto |
    | `Σ log\|z_ρ\| = 0` | **igualdad** | `0` exacto |
    | `λ₁ = Σ 1/ρ` | **igualdad** | `−1.169980586` |
    | `θ'(0) = K(0)/2` | **igualdad** | `−1.881372753` |
    | `0 ≤ Σ exc ≤ B` | desigualdad | `≤ 3.472·10⁻⁷` |
    | `N(70) = 33` | medición | margen `10²⁶` |

    **CUATRO igualdades**, tres con valor de las dos caras.  Yo venía
    contando una. -/
theorem four_equalities_on_the_set (r lam thetaPrime K gamE : ℝ)
    (hr : 0 < r) (hl : LiOneClosedForm lam K gamE)
    (hc : CountingPhaseValue thetaPrime K) :
    (r * (1 / r) = 1) ∧
    (Real.log r + Real.log (1 / r) = 0) ∧
    (lam = K / 2 + 1 - gamE / 2) ∧
    (thetaPrime = K / 2) := by
