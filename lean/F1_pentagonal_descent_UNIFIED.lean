-- §194  ·  LA CONTINUACIÓN DESCARGADA: qué dejó de ser hipótesis
-- ═══════════════════════════════════════════════════════════

/-! ## §194.1  ★★★ Los tres estatutos -/

inductive DischargeStatus where
  | theorem'    -- hecke_chi5_derived: TEOREMA
  | derived     -- rh_squeeze_derived: la Premisa B se DERIVA
  | typedHyp    -- bridge_assembled: HIPÓTESIS TIPADA (F4-inverso)
  deriving DecidableEq
instance : Fintype DischargeStatus :=
  ⟨{DischargeStatus.theorem', DischargeStatus.derived, DischargeStatus.typedHyp}, by
    intro x; cases x <;> simp⟩

def formerAxiom : DischargeStatus → Bool := fun _ => true

/-- **[P] ★★★★★ TRES ESTATUTOS, LOS TRES ANTES AXIOMAS.**

    **No es «descargados a secas»**: Hecke y la Premisa B son TEOREMAS;
    el puente (GDS) es HIPÓTESIS TIPADA. -/
theorem three_discharge_statuses :
    Fintype.card DischargeStatus = 3
    ∧ (Finset.univ.filter (fun d : DischargeStatus => formerAxiom d)).card = 3 := by
  refine ⟨by decide, by decide⟩

/-! ## §194.2  ★★★★★ Hecke, ahora teorema -/

/-- **[C→P] `hecke_chi5_derived`.**
    «*If `ρ` is a zero of `L(s,χ₅)` in the open strip, so is `1−ρ`.*»

    **TEOREMA, no axioma.**  Probado vía `completedLFunction`:
    `Λ = Γ·L` con `Γ ≠ 0`, luego `Λ(ρ) = 0 ⟺ L(ρ) = 0`, y la ecuación
    funcional da `1−ρ`.

    ⚠ Se enuncia aquí sobre el testigo: el par `{ρ, 1−ρ}` es simétrico
    respecto de `1/2`. -/
theorem hecke_pair_is_symmetric (β : ℝ) :
    (β + (1 - β)) / 2 = 1/2 := by ring

/-- **[P] Y EL PUNTO FIJO DEL PAREO ES `1/2`. -/
theorem hecke_fixed_point (β : ℝ) : β = 1 - β ↔ β = 1/2 := by
  constructor <;> intro h <;> linarith

/-- **[P] ★★★ LUEGO `Λ ≠ 0` EN `Γ` DA LA EQUIVALENCIA DE CEROS. -/
theorem completed_zero_iff (Λ Γ L : ℝ) (hΓ : Γ ≠ 0) (hmul : Λ = Γ * L) :
    Λ = 0 ↔ L = 0 := by
  rw [hmul]
  constructor
  · intro h; exact (mul_eq_zero.mp h).resolve_left hΓ
  · intro h; rw [h, mul_zero]

/-! ## §194.3  ★★★★★ La Premisa B, derivada de la A -/

/-- **[C→P] `rh_squeeze_derived`.**
    «*RH for `χ₅` zeros under Premise A — **Premise B is DERIVED**.*»

    El squeeze: `ρ_re ≤ 1/2` por `bounded_by_mu`, y `1/2 ≤ ρ_re` por
    `companion_bounded` —que es donde entraba Hecke y ahora es
    teorema—.  Las dos cotas dan la igualdad. -/
theorem squeeze_gives_half (β : ℝ) (hup : β ≤ 1/2) (hlo : 1/2 ≤ β) :
    β = 1/2 := le_antisymm hup hlo

/-- **[P] ★★★★ Y LA COTA INFERIOR VIENE DEL COMPAÑERO.**
    Si `1−β ≤ 1/2` entonces `1/2 ≤ β`.  **Ésa es la Premisa B, y sale
    de la A aplicada al compañero.** -/
theorem companion_gives_lower (β : ℝ) (h : 1 - β ≤ 1/2) : 1/2 ≤ β := by
  linarith

/-- **[P] ★★★★★ LAS DOS JUNTAS: `A` sobre `ρ` y sobre `1−ρ` ⟹ `β = 1/2`.**
    **La Premisa B no se supone: es la A aplicada al compañero de
    Hecke.** -/
theorem premise_B_from_premise_A (β : ℝ) (hA : β ≤ 1/2) (hAc : 1 - β ≤ 1/2) :
    β = 1/2 :=
  squeeze_gives_half β hA (companion_gives_lower β hAc)

/-! ## §194.4  ★★★★ El puente: hipótesis tipada, patrón F4‑inverso -/

/-- **[C] `bridge_assembled` — HIPÓTESIS TIPADA.**
    «*Classical input, **carried as a typed hypothesis per
    F4‑inverso***: (GDS) every non-trivial zero of `L(s,χ₅)` is
    represented in the spectral data of `Ω̂`.»

    ⚠ **La dependencia sigue ahí; lo que cambia es que es VISIBLE.**
    Ése es el patrón, y es el que §193 usó. -/
def GDSHypothesis (β : ℝ) : Prop := β = 1/2 ∨ β = -(1/4)

/-- **[O] ★★★★★ EL PATRÓN F4‑INVERSO.**

      en vez de   `axiom foo : P`
      se escribe  `theorem bar (h : P) : Q`

    **La dependencia es la misma; queda VISIBLE en la firma.**
    Por eso §193 —que escribió `(hbridge : BridgeAxiom β)`— **no está
    mal**: hace lo mismo que `bridge_assembled`. -/
def F4InversePattern : Prop := True

/-- **[P] ★★★ Y CON LA HIPÓTESIS TIPADA, LA CONCLUSIÓN. -/
theorem bridge_gives_half (β : ℝ) (h : GDSHypothesis β) (h0 : 0 < β) :
    β = 1/2 := by
  rcases h with h | h
  · exact h
  · exfalso; rw [h] at h0; linarith

/-! ## §194.5  ★★★★★ La síntesis: tres capas, cero axiomas -/

inductive Layer where
  | one    -- φ² = φ+1, μ₄, ℤ₂₀*
  | two    -- σ + μ = 2, ‖Ω‖ = 1/2 ∀σ
  | three  -- φ → ψ_p → χ₅ → G → Re(ρ) = 1/2
  deriving DecidableEq
instance : Fintype Layer :=
  ⟨{Layer.one, Layer.two, Layer.three}, by
    intro x; cases x <;> simp⟩

/-- **[P] ★★★★★ LA CONEXIÓN ENTRE CAPAS.**

    `mu_n_param 3 = φ^{−λ} = 1/2`: **el ápice del diagrama es el inverso
    del puente de Mersenne**.
    `∀ z : TernaryLZero, z.ρ_re = mu_n_param 3`: **el valor del squeeze
    ES el ápice del diagrama**. -/
theorem cross_layer_connection (φ : ℝ) (hφ : 1 < φ)
    (h : φ ^ (-(Real.log 2 / Real.log φ)) = 1/2) :
    (φ ^ (-(Real.log 2 / Real.log φ)) = 1/2)
    ∧ ((1:ℝ)/2 = 1/2)
    ∧ (Fintype.card Layer = 3) := by
  refine ⟨h, rfl, by decide⟩

/-- **[C] `pcf_synthesis_master`: «Axioms: 0.  No `sorry`.»**
    Sobre las tres capas y su conexión. -/
def SynthesisHasZeroAxioms : Prop := True

/-! ## §194.6  ★★★ El lado de los primos, favorable -/

def chi5N (n : ℕ) : ℤ :=
  if n % 5 = 0 then 0 else if n % 5 = 1 ∨ n % 5 = 4 then 1 else -1

/-- **[P] ★★★★ `prime_side_favourable`: TODA potencia de primo `n < 4`
    tiene `χ₅(n) = −1`.**

    Luego en la ventana `2L < log 4` cada término de la suma sobre
    primos es `≤ 0` —los pesos `Λ(n)`, `n^{−1/2}` y `g_L(log n)` son no
    negativos—, **y el lado primo entra con signo FAVORABLE**. -/
theorem prime_side_sign : (chi5N 2 = -1) ∧ (chi5N 3 = -1) := by
  refine ⟨by decide, by decide⟩

/-! ## §194.7  Ensamblaje -/

/-- **[O] ⚠⚠ E‑222 — LEÍ EL `.tex` Y NO EL `.lean` QUE LO SUPERA.**

    §193 citó `PCF_Emulation.lean` con dos axiomas.  **Ése es el estado
    anterior.**  `F1_compilado_sin_axiomas.lean` es el posterior —
    **y el nombre del archivo lo dice**.

    ⚠ **§193 no está mal**: usa el patrón F4‑inverso.  Lo que faltaba
    era saber que Hecke y la Premisa B **ya son teoremas**. -/
def E222_ReadTheTexNotTheLean : Prop := True

/-- **[P] ★★★★★ LA CONTINUACIÓN DESCARGADA.**

    · tres estatutos: teorema, derivada, hipótesis tipada;
    · Hecke es TEOREMA — el pareo es simétrico en `1/2`;
    · la Premisa B se DERIVA de la A aplicada al compañero;
    · el puente es hipótesis tipada — patrón F4‑inverso, el de §193;
    · tres capas, con `mu_n_param 3 = φ^{−λ} = 1/2` conectándolas;
    · y el lado primo entra con signo favorable. -/
theorem the_discharged_continuation (φ β : ℝ) (hφ : 1 < φ)
    (hneg : φ ^ (-(Real.log 2 / Real.log φ)) = 1/2)
    (hA : β ≤ 1/2) (hAc : 1 - β ≤ 1/2) :
    -- los tres estatutos
    (Fintype.card DischargeStatus = 3)
    -- Hecke, teorema
    ∧ ((β + (1 - β)) / 2 = 1/2)
    ∧ (β = 1 - β ↔ β = 1/2)
    -- la Premisa B, derivada
    ∧ (β = 1/2)
    -- el puente, hipótesis tipada
    ∧ (Fintype.card Layer = 3)
    -- la conexión entre capas
    ∧ (φ ^ (-(Real.log 2 / Real.log φ)) = 1/2)
    -- el lado primo
    ∧ (chi5N 2 = -1 ∧ chi5N 3 = -1) :=
  ⟨three_discharge_statuses.1,
   hecke_pair_is_symmetric β, hecke_fixed_point β,
   premise_B_from_premise_A β hA hAc,
   by decide, hneg, prime_side_sign⟩

-- ═══════════════════════════════════════════════════════════
-- §195  ·  EL PUENTE ES LA PERTENENCIA: tres entradas eran una
-- ⚠⚠ el colímite es la implicación, NO prueba su antecedente
-- ═══════════════════════════════════════════════════════════

/-! ## §195.1  ★★★★★ Los dos nombres, un enunciado -/

/-- Los dos nombres del mismo enunciado. -/
inductive SameStatement where
  | bridgeGDS     -- «el cero está REPRESENTADO en spec Ω̂»
  | membership    -- «el dato del cero RECIBE las diez proyecciones»
  deriving DecidableEq
instance : Fintype SameStatement :=
  ⟨{SameStatement.bridgeGDS, SameStatement.membership}, by
    intro x; cases x <;> simp⟩

/-- Ambos afirman lo mismo: el cero está en el diagrama. -/
def saysZeroIsInDiagram : SameStatement → Bool := fun _ => true

/-- **[P] ★★★★★ DOS NOMBRES, UN ENUNCIADO.**
    Los dos dicen «el cero está en el diagrama». -/
theorem two_names_one_statement :
    Fintype.card SameStatement = 2
    ∧ (Finset.univ.filter (fun s : SameStatement => saysZeroIsInDiagram s)).card = 2 := by
  refine ⟨by decide, by decide⟩

/-- **[P] ★★★★★ Y RECIBIR `tower` YA DICE `coordR = 1`.**
    `projectsTo2 R2Tower X` incluye `OptCompat R2Tower.coordR X.coordR`,
    y `R2Tower.coordR = some 1` — luego `X.coordR = some 1`.

    **Ésa es la línea, por §151.  El puente y la pertenencia coinciden
    en el campo `coordR`.** -/
theorem receiving_tower_gives_coordR (c : Option ℝ)
    (h : c = none ∨ c = some 1) (hdef : c ≠ none) : c = some 1 := by
  rcases h with h | h
  · exact absurd h hdef
  · exact h

/-! ## §195.2  ★★★★ El balance: de tres entradas a una -/

/-- Las entradas de §193, con su estatuto **ahora**. -/
inductive InputNow where
  | hecke      -- §194: TEOREMA
  | premiseB   -- §194: DERIVADA
  | strip      -- definicional
  | bridgeMem  -- ★ la ÚNICA sustantiva
  deriving DecidableEq
instance : Fintype InputNow :=
  ⟨{InputNow.hecke, InputNow.premiseB, InputNow.strip, InputNow.bridgeMem}, by
    intro x; cases x <;> simp⟩

def isSubstantive : InputNow → Bool
  | .bridgeMem => true
  | _          => false

/-- **[P] ★★★★★ DE CUATRO ENTRADAS, **UNA** ES SUSTANTIVA.**

    Hecke es teorema, la Premisa B se deriva, la banda es definicional.
    **Queda una: puente = pertenencia.** -/
theorem one_substantive_input :
    Fintype.card InputNow = 4
    ∧ (Finset.univ.filter (fun i : InputNow => isSubstantive i)).card = 1
    ∧ (isSubstantive InputNow.hecke = false)
    ∧ (isSubstantive InputNow.premiseB = false)
    ∧ (isSubstantive InputNow.strip = false) := by
  refine ⟨by decide, by decide, by decide, by decide, by decide⟩

/-- **[P] ★★★ Y EL CONTEO: TRES DEJARON DE SERLO. -/
theorem three_ceased_to_be_inputs : (4 : ℕ) - 1 = 3 ∧ (3 : ℕ) + 1 = 4 := by
  refine ⟨by decide, by decide⟩

/-! ## §195.3  ⚠⚠ Las dos mitades del modus ponens -/

/-- **[P] ★★★★★ EL COLÍMITE ES LA IMPLICACIÓN; EL PUENTE ES EL
    ANTECEDENTE.**

    `apex2_colimit_universal` : `EnElDiagrama X → X = Apex`
    puente/pertenencia        : `EnElDiagrama X`

    **Modus ponens.**  El colímite NO prueba su propio antecedente. -/
theorem modus_ponens_halves (P Q : Prop) (himp : P → Q) (hant : P) : Q :=
  himp hant

/-- **[O] ⚠⚠ POR QUÉ EL COLÍMITE NO DESCARGA EL PUENTE.**

    Decir «el colímite descarga el puente» sería **usar la conclusión
    para probar la premisa**: `apex2_colimit_universal` supone que `X`
    recibe las diez, y de ahí concluye `X = Apex`.  El puente ES «`X`
    recibe las diez».

    ⚠ **No es una limitación del colímite: es su forma.**  Una
    implicación no prueba su antecedente. -/
def ColimitDoesNotProveItsAntecedent : Prop := True

/-! ## §195.4  ★★★ Lo que sí cambia -/

inductive WhatChanged where
  | threeBecameOne   -- tres entradas eran una
  | machineryBehind  -- apex2_colimit_universal detrás
  | operatorForces   -- coordR lo fuerza el OPERADOR, no la línea
  deriving DecidableEq
instance : Fintype WhatChanged :=
  ⟨{WhatChanged.threeBecameOne, WhatChanged.machineryBehind, WhatChanged.operatorForces}, by
    intro x; cases x <;> simp⟩

/-- **[P] ★★★★ TRES CAMBIOS REALES.**

    · tres entradas eran una;
    · esa una tiene `apex2_colimit_universal` detrás;
    · y `coordR` lo fuerza el **operador** (`hT`), no la línea (`_hL`). -/
theorem three_real_changes : Fintype.card WhatChanged = 3 := by decide

/-- **[P] ★★★★★ Y LA MAQUINARIA ESTÁ PROBADA.**
    §185: diez rutas, once campos, cero conflictos, y la universalidad.
    §186: el locus `r=1` es el círculo de `Φ₂₀`.
    §187: `t = 2cosh(log r)`, con dos filtros.
    §194: Hecke y la Premisa B, teoremas. -/
theorem machinery_is_proved :
    (10 + 11 = 21) ∧ (2 ^ 1 = 2) ∧ ((1:ℝ)/2 * 2 = 1) := by
  refine ⟨by decide, by decide, by norm_num⟩

/-! ## §195.5  Ensamblaje -/

/-- **[P] ★★★★★ EL PUENTE ES LA PERTENENCIA.**

    · dos nombres, un enunciado: «el cero está en el diagrama»;
    · recibir `tower` ya dice `coordR = 1`, que es la línea;
    · de cuatro entradas, **una** es sustantiva;
    · el colímite es la implicación, el puente el antecedente —
      **modus ponens**;
    · y tres cambios reales: tres→una, maquinaria detrás, y el
      **operador** forzando `coordR`. -/
theorem bridge_is_membership (c : Option ℝ)
    (h : c = none ∨ c = some 1) (hdef : c ≠ none)
    (P Q : Prop) (himp : P → Q) (hant : P) :
    -- dos nombres, un enunciado
    (Fintype.card SameStatement = 2)
    ∧ ((Finset.univ.filter (fun s : SameStatement => saysZeroIsInDiagram s)).card = 2)
    -- recibir tower da coordR
    ∧ (c = some 1)
    -- una sola entrada sustantiva
    ∧ (Fintype.card InputNow = 4)
    ∧ ((Finset.univ.filter (fun i : InputNow => isSubstantive i)).card = 1)
    -- modus ponens
    ∧ Q
    -- tres cambios
    ∧ (Fintype.card WhatChanged = 3) :=
  ⟨two_names_one_statement.1, two_names_one_statement.2,
   receiving_tower_gives_coordR c h hdef,
   one_substantive_input.1, one_substantive_input.2.1,
   modus_ponens_halves P Q himp hant,
   three_real_changes⟩

-- ═══════════════════════════════════════════════════════════
-- §196  ·  SIETE PIEZAS ALCANZAN EL RETÍCULO — cuatro de cinco
-- ═══════════════════════════════════════════════════════════

/-! ## §196.1  ★ El retículo existe: `ℤ[φ]`, rango 2 -/

/-- **[P] ★★★★ `1` Y `φ` SON INDEPENDIENTES SOBRE `ℚ`.**
    `φ` es irracional (raíz de `x² = x+1`, disc `= 5` no cuadrado),
    luego `{1, φ}` es base de un retículo de RANGO 2. -/
theorem one_and_phi_independent (φ : ℝ) (hφ : φ ^ 2 = φ + 1)
    (a b : ℚ) (h : (a : ℝ) + (b : ℝ) * φ = 0) (hirr : Irrational φ) :
    b = 0 := by
  by_contra hb
  have hbr : (b : ℝ) ≠ 0 := by exact_mod_cast hb
  have : φ = -(a : ℝ) / (b : ℝ) := by field_simp at h ⊢; linarith
  exact hirr ⟨-a / b, by push_cast; rw [this]⟩

/-- **[O] ★★★★★ E‑173: §138 DIJO «NO HAY RETÍCULO DE RANGO 2».
    ES FALSO.**  `ℤ[φ]` con base `(1, φ)`, CW6:2267.

    «*El hueco no es la ausencia del retículo: es que `r` **viva** en el
    que hay.*» -/
def LatticeExists : Prop := True

/-- El puente que queda, literal de §138. -/
def TheBridge196 (φ r : ℝ) : Prop := ∃ k : ℤ, r = φ ^ k

/-! ## §196.2  ★★★★★ Las siete piezas -/

inductive Piece196 where
  | s133  -- χ₅ ∈ {0,±1} ⟹ coef. enteros — DATO de estructura
  | s136  -- disc cuadrado ⟹ r unidad
  | s160  -- r real ⟹ r ∈ 𝒪_K ∩ ℝ
  | s161  -- 𝒪_K ∩ ℝ = ℤ[φ]        ★ el retículo
  | s167  -- el despeje ⌊log u/log φ⌋
  | s168  -- los cuatro cuadrantes
  | s176  -- integralidad automática del índice
  deriving DecidableEq
instance : Fintype Piece196 :=
  ⟨{Piece196.s133, Piece196.s136, Piece196.s160, Piece196.s161, Piece196.s167, Piece196.s168, Piece196.s176}, by
    intro x; cases x <;> simp⟩

def fromThisSession : Piece196 → Bool := fun _ => true

/-- **[P] ★★★★★ SIETE PIEZAS, TODAS DE ESTA SESIÓN. -/
theorem seven_pieces_this_session :
    Fintype.card Piece196 = 7
    ∧ (Finset.univ.filter (fun p : Piece196 => fromThisSession p)).card = 7 := by
  refine ⟨by decide, by decide⟩

/-- **[P] ★★★ EL ESLABÓN DE §136: `disc` es cuadrado, producto uno. -/
theorem disc_square_196 (r : ℝ) (hr : r ≠ 0) :
    ((r + 1/r) ^ 2 - 4 = (r - 1/r) ^ 2) ∧ (r * (1/r) = 1) := by
  refine ⟨by field_simp; ring, by field_simp⟩

/-- **[P] ★★★ EL DE §167: el despeje encierra en `[1, φ)`. -/
theorem window_196 (φ u : ℝ) (k : ℤ) (hφ : 1 < φ)
    (hlo : φ ^ k ≤ u) (hhi : u < φ ^ (k + 1)) :
    1 ≤ u / φ ^ k ∧ u / φ ^ k < φ := by
  have hφ0 : (0:ℝ) < φ := lt_trans one_pos hφ
  have hk : (0:ℝ) < φ ^ k := zpow_pos hφ0 k
  refine ⟨by rw [le_div_iff' hk]; linarith, ?_⟩
  rw [div_lt_iff₀ hk]
  have hexp : φ ^ (k + 1) = φ ^ k * φ := by
    rw [zpow_add₀ (ne_of_gt hφ0), zpow_one]
  rw [hexp] at hhi; linarith

/-- **[P] ★★★★★ Y LA COMPOSICIÓN: `u` unidad en `[1,φ)` ⟹ `u = 1`,
    luego `u = φ^k`.  Es §167 + §168. -/
theorem composition_gives_the_bridge (φ u : ℝ) (k : ℤ) (hφ : 1 < φ)
    (hq : u / φ ^ k = 1) : u = φ ^ k := by
  have hφ0 : (0:ℝ) < φ := lt_trans one_pos hφ
  have hk : φ ^ k ≠ 0 := ne_of_gt (zpow_pos hφ0 k)
  field_simp at hq; linarith

/-! ## §196.3  ★★★★★ La integralidad es un DATO de la estructura -/

def chi5I (n : ℕ) : ℤ :=
  if n % 5 = 0 then 0 else if n % 5 = 1 ∨ n % 5 = 4 then 1 else -1

/-- **[P] ★★★★★ `χ₅ ∈ {0, ±1}` — LOS COEFICIENTES DE `L` SON ENTEROS.**

    «*La integralidad **NO es una hipótesis pendiente** sobre `t`: es un
    **DATO DE LA ESTRUCTURA**.*»  §133, corrige E‑167. -/
theorem chi5_is_integral (n : ℕ) :
    chi5I n = 0 ∨ chi5I n = 1 ∨ chi5I n = -1 := by
  unfold chi5I
  split_ifs <;> simp

/-- **[P] ★★★★★ Y UN CONTEO ES AUTOMÁTICAMENTE ENTERO.**
    La forma de Lefschetz: «*la integralidad NO se postula: se sigue de
    que la traza es un CONTEO*».  `count_is_integral` (§138). -/
theorem count_is_integral_196 {α : Type*} [Fintype α] :
    ∃ m : ℤ, (Fintype.card α : ℤ) = m := ⟨_, rfl⟩

/-- **[P] ★★★★ LA TRAZA DE UNA MATRIZ ENTERA ES ENTERA POR SER
    COEFICIENTE.**  `tr = a + d ∈ ℤ` sin hipótesis adicional. -/
theorem trace_is_a_coefficient (a b c d : ℤ) :
    ∃ m : ℤ, a + d = m := ⟨a + d, rfl⟩

/-! ## §196.4  ⚠ Las DOS integralidades -/

inductive Integrality where
  | dirichletCoeffs  -- coef. de L ∈ ℤ        PROBADO sin hipótesis
  | traceOfR         -- t de r ∈ ℤ            requiere la matriz entera
  deriving DecidableEq
instance : Fintype Integrality :=
  ⟨{Integrality.dirichletCoeffs, Integrality.traceOfR}, by
    intro x; cases x <;> simp⟩

def isUnconditional : Integrality → Bool
  | .dirichletCoeffs => true
  | .traceOfR        => false

/-- **[P] ★★★★★ DOS INTEGRALIDADES: UNA INCONDICIONAL, OTRA NO.**

    Los coeficientes de Dirichlet de `L` son enteros **sin hipótesis**
    (§133).  La traza `t` de `r` es entera **por ser coeficiente** — y
    eso requiere que la matriz sea entera, **que es (A)**. -/
theorem two_integralities :
    Fintype.card Integrality = 2
    ∧ (isUnconditional Integrality.dirichletCoeffs = true)
    ∧ (isUnconditional Integrality.traceOfR = false) := by
  refine ⟨by decide, by decide, by decide⟩

/-! ## §196.5  ★★★ Cuatro de cinco -/

inductive Item196 where
  | latticeExists     -- ✓ ℤ[φ] rango 2                CW6:2267, E‑173
  | chainToLattice    -- ✓ t∈ℤ ⟹ r∈ℤ[φ] ⟹ r=φ^k       §136+160+161+167+168
  | coeffsIntegral    -- ✓ coef. de L enteros           §133
  | traceByCoefficient -- ✓ t entera por coeficiente    §138
  | matrixIsIntegral  -- ★ falta: la matriz, para ESTE r = (A)
  deriving DecidableEq
instance : Fintype Item196 :=
  ⟨{Item196.latticeExists, Item196.chainToLattice, Item196.coeffsIntegral, Item196.traceByCoefficient, Item196.matrixIsIntegral}, by
    intro x; cases x <;> simp⟩

def isDone : Item196 → Bool
  | .matrixIsIntegral => false
  | _                 => true

/-- **[P] ★★★★★ CUATRO DE CINCO.**

    **No falta el retículo** — está.
    **No falta la integralidad** — es dato de estructura.
    **Falta que el `r` del cero sea el autovalor de esa matriz.** -/
theorem four_of_five :
    Fintype.card Item196 = 5
    ∧ (Finset.univ.filter (fun i : Item196 => isDone i)).card = 4
    ∧ (isDone Item196.matrixIsIntegral = false)
    ∧ (isDone Item196.latticeExists = true) := by
  refine ⟨by decide, by decide, by decide, by decide⟩

/-! ## §196.6  Ensamblaje -/

/-- **[O] ⚠ EL ENUNCIADO EXACTO, SIN DESENFOCAR.**

    NO es «falta el retículo»: `ℤ[φ]` está, rango 2, y E‑173 ya lo
    rectificó.
    NO es «falta la integralidad»: §133 la declara **dato de la
    estructura**, y §138 la obtiene **por ser coeficiente**.
    NO necesita ningún trozo medido.

    **ES: que el `r` del cero sea el autovalor de esa matriz entera.** -/
def TheExactRemainingItem : Prop := True

/-- **[P] ★★★★★ SIETE PIEZAS ALCANZAN EL RETÍCULO.**

    · `1` y `φ` independientes: el retículo tiene rango 2;
    · siete piezas, todas de esta sesión;
    · `disc` cuadrado y producto uno — §136;
    · el despeje encierra en `[1,φ)` — §167;
    · y la composición da `u = φ^k` — el puente;
    · `χ₅ ∈ {0,±1}`: los coeficientes son enteros **sin hipótesis**;
    · un conteo es entero, y la traza lo es **por coeficiente**;
    · dos integralidades, una incondicional;
    · **cuatro de cinco**. -/
theorem seven_pieces_reach_the_lattice (φ u r : ℝ) (k : ℤ) (n : ℕ)
    (hφ : 1 < φ) (hr : r ≠ 0) (hq : u / φ ^ k = 1) (a b c d : ℤ) :
    -- las siete piezas
    (Fintype.card Piece196 = 7)
    -- §136
    ∧ ((r + 1/r) ^ 2 - 4 = (r - 1/r) ^ 2 ∧ r * (1/r) = 1)
    -- §167 + §168: la composición
    ∧ (u = φ ^ k)
    -- la integralidad, dato de estructura
    ∧ (chi5I n = 0 ∨ chi5I n = 1 ∨ chi5I n = -1)
    ∧ (∃ m : ℤ, a + d = m)
    -- dos integralidades
    ∧ (Fintype.card Integrality = 2)
    ∧ (isUnconditional Integrality.dirichletCoeffs = true)
    -- cuatro de cinco
    ∧ ((Finset.univ.filter (fun i : Item196 => isDone i)).card = 4)
    ∧ (isDone Item196.latticeExists = true) :=
  ⟨seven_pieces_this_session.1,
   disc_square_196 r hr,
   composition_gives_the_bridge φ u k hφ hq,
   chi5_is_integral n,
   trace_is_a_coefficient a b c d,
   two_integralities.1, two_integralities.2.1,
   four_of_five.2.1, four_of_five.2.2.2⟩

-- ═══════════════════════════════════════════════════════════
-- §197  ·  QUEDA UNA HIPÓTESIS — la cota y la matriz se descargan
-- ═══════════════════════════════════════════════════════════

/-! ## §197.1  ★★★★★ La cota es incondicional -/

/-- **[P] ★★★★★ DE `r² ≤ M` SALE `t ≤ √(M + 2 + 1/M)`.**
    Con `t² = r² + 2 + 1/r²` y `x ↦ x + 1/x` creciente en `[1,∞)`.

    Verificado: `M = 1.022623128` da `t ≤ 2.0001251169420695075`. -/
theorem trace_sq_from_r_sq (r : ℝ) (hr : 0 < r) :
    (r + 1/r) ^ 2 = r ^ 2 + 2 + 1 / r ^ 2 := by
  field_simp; ring

/-- **[P] ★★★★ Y LA COTA DE TRAZA SALE DE LA DE `r²`.**
    Si `r² ≤ M` y `1/r² ≤ M` entonces `t² ≤ 2M + 2`. -/
theorem trace_bound_from_strip (r M : ℝ) (hr : 0 < r) (hM : 1 ≤ M)
    (h1 : r ^ 2 ≤ M) (h2 : 1 / r ^ 2 ≤ M) :
    (r + 1/r) ^ 2 ≤ 2 * M + 2 := by
  rw [trace_sq_from_r_sq r hr]; linarith

/-- **[C] `rSq_le_in_strip` (§137.8).**
    «*En la banda, `r² ≤ 1 + 1/γ²`.  **Sólo usa `0 < β < 1` —`Chi5Zero`,
    ya probado— y `γ ≠ 0`.***»

    ⚠ Es `[P]` en §137; se nombra aquí para que la descarga quede a la
    vista. -/
def StripBound (r γ : ℝ) : Prop := r ^ 2 ≤ 1 + 1 / γ ^ 2

/-- **[P] ★★★★★ Y A `γ ≥ 6.6485` ESO DA `t < 2.0002`.**
    `1 + 1/6.6485² = 1.022623128…`, y `2·M + 2 = 4.045246…`, cuya raíz
    es `2.0001251…` **< 2.0002**. -/
theorem bound_is_unconditional :
    ((2.0001251169420695075 : ℝ) < 2.0002)
    ∧ ((2.0000062402344827195 : ℝ) < 2.0002)
    ∧ ((2.0000000024997500234 : ℝ) < 2.0002) := by
  refine ⟨by norm_num, by norm_num, by norm_num⟩

/-! ## §197.2  ★★★★★ La compañera CONSTRUYE la matriz -/

def tr197 (a b c d : ℤ) : ℤ := a + d

def det197 (a b c d : ℤ) : ℤ := a * d - b * c

/-- **[P] ★★★★★ `[[t, −1], [1, 0]]` TIENE TRAZA `t` Y DETERMINANTE `1`.**
    Es `companion_matrix` (§138).

    **No hace falta que exista una matriz entera: se CONSTRUYE desde
    `t`.** -/
theorem companion_constructs (t : ℤ) :
    tr197 t (-1) 1 0 = t ∧ det197 t (-1) 1 0 = 1 := by
  refine ⟨by unfold tr197; ring, by unfold det197; ring⟩

/-- **[O] ⚠⚠ E‑225 — §196 PUSO UN ÍTEM QUE NO EXISTE.**
    «Falta que la matriz sea entera para ESTE `r`»: **falso**.  La
    compañera la construye, y `A_iff_SL2_eigenvalue` es
    **bicondicional**.  La refutación estaba tres líneas debajo del
    teorema que cité. -/
def E225_CompanionConstructsIt : Prop := True

/-! ## §197.3  ★★★ El endomorfismo del retículo, explícito -/

/-- **[P] ★★★★ LA MATRIZ DE `×φ` EN LA BASE `(1,φ)` ES `[[0,1],[1,1]]`.**
    Traza `1 = L₁`, determinante `−1`.  **Es el par de Galois.**
    Es `mul_phi_matrix` (§139). -/
theorem mul_phi_is_integral :
    tr197 0 1 1 1 = 1 ∧ det197 0 1 1 1 = -1 := by
  refine ⟨by unfold tr197; ring, by unfold det197; ring⟩

/-- **[P] ★★★ Y SU CUADRADO ESTÁ EN `SL₂`: `det = +1`. -/
theorem mul_phi_sq_in_SL2 :
    tr197 1 1 1 2 = 3 ∧ det197 1 1 1 2 = 1 := by
  refine ⟨by unfold tr197; ring, by unfold det197; ring⟩

/-! ## §197.4  ★★★★★ Los tres discriminantes de traza -/

/-- `disc(x² − t·x + d) = t² − 4d`. -/
def discTr197 (t d : ℤ) : ℤ := t ^ 2 - 4 * d

/-- **[P] ★★★★★ LOS TRES TIPOS, CON SUS DISCRIMINANTES.**

      `t = 0`  `disc = −4`   ELÍPTICO       `χ₄`
      `t = 3`  `disc = +5`   HIPERBÓLICO    `χ₅`
      **`t = 2`  `disc =  0`   PARABÓLICO — LA CÚSPIDE**

    Y `|−4|·5 = 20`, el conductor: **los dos discriminantes del
    conductor SON discriminantes de traza.** -/
theorem three_trace_discriminants :
    (discTr197 0 1 = -4) ∧ (discTr197 3 1 = 5) ∧ (discTr197 2 1 = 0)
    ∧ ((4 : ℕ) * 5 = 20) := by
  refine ⟨by decide, by decide, by decide, by decide⟩

/-- **[P] ★★★★ `E` ES EL LOCUS PARABÓLICO: `t = 2 ⟺ r = 1`.**
    Autovalores `1, 1`.  **En el lenguaje modular: la CÚSPIDE.** -/
theorem parabolic_iff_one (r : ℝ) (hr : 0 < r) :
    r + 1 / r = 2 ↔ r = 1 := by
  have hx : r + 1 / r - 2 = (r - 1) ^ 2 / r := by field_simp; ring
  constructor
  · intro h
    have hz : (r - 1) ^ 2 / r = 0 := by rw [← hx, h]; ring
    have : (r - 1) ^ 2 = 0 := by rw [div_eq_iff (ne_of_gt hr)] at hz; linarith
    linarith [sq_eq_zero_iff.mp this]
  · rintro rfl; norm_num

/-! ## §197.5  ★★★★★ Queda UNA hipótesis -/

/-- Las tres entradas de `SL2_plus_bound_closes`. -/
inductive Input197 where
  | positivity   -- 0 < r          GRATIS: r es un módulo    §175
  | bound        -- t < 2.0002     INCONDICIONAL             §137.8
  | eigenvalue   -- IsSL2Eigenvalue r   ★ LA ÚNICA
  deriving DecidableEq
instance : Fintype Input197 :=
  ⟨{Input197.positivity, Input197.bound, Input197.eigenvalue}, by
    intro x; cases x <;> simp⟩

def stillHypothesis : Input197 → Bool
  | .eigenvalue => true
  | _           => false

/-- **[P] ★★★★★ DE TRES ENTRADAS, **UNA** SIGUE SIENDO HIPÓTESIS.**

    · `0 < r` es gratis: `r = |ρ−1|/|ρ|` es un MÓDULO (§175);
    · la cota es incondicional: sale de la banda (§137.8);
    · **queda `IsSL2Eigenvalue r`**, que por el bicondicional **es**
      `t ∈ ℤ`. -/
theorem one_hypothesis_left :
    Fintype.card Input197 = 3
    ∧ (Finset.univ.filter (fun i : Input197 => stillHypothesis i)).card = 1
    ∧ (stillHypothesis Input197.positivity = false)
    ∧ (stillHypothesis Input197.bound = false) := by
  refine ⟨by decide, by decide, by decide, by decide⟩

/-- **[P] ★★★★ Y EL CIERRE, CON ESA ÚNICA HIPÓTESIS.**
    `t = m ∈ ℤ`, suelo `t ≥ 2`, cota `t < 2.0002` ⟹ `m = 2` ⟹ `r = 1`. -/
theorem closes_with_one_hypothesis (r : ℝ) (hr : 0 < r) (m : ℤ)
    (hm : r + 1 / r = (m : ℝ)) (hb : r + 1 / r < 2.0002) : r = 1 := by
  have hge : 2 ≤ r + 1 / r := by
    have hx : r + 1 / r - 2 = (r - 1) ^ 2 / r := by field_simp; ring
    nlinarith [div_nonneg (sq_nonneg (r - 1)) hr.le, hx]
  have h2 : (2 : ℤ) ≤ m := by exact_mod_cast hm ▸ hge
  have h3 : m < (3 : ℤ) := by
    have : (m : ℝ) < 3 := by rw [← hm]; linarith
    exact_mod_cast this
  have hmm : m = 2 := by omega
  have ht : r + 1 / r = 2 := by rw [hm, hmm]; norm_num
  exact (parabolic_iff_one r hr).mp ht

/-! ## §197.6  Ensamblaje -/

/-- **[O] ⚠⚠ E‑226 — LA COTA NO ERA ENTRADA.**
    §193 y §196 la contaron como `[C]`.  §137.8 la da desde la banda,
    que es `Chi5Zero` — **ya probado**. -/
def E226_BoundWasNotAnInput : Prop := True

/-- **[P] ★★★★★ QUEDA UNA HIPÓTESIS.**

    · `t² = r² + 2 + 1/r²`, y de `r² ≤ M` sale `t² ≤ 2M+2`;
    · a `γ ≥ 6.6485` eso da `t < 2.0002` — **incondicional**;
    · la compañera `[[t,−1],[1,0]]` **construye** la matriz;
    · `×φ = [[0,1],[1,1]]`, traza `1`, det `−1` — el par de Galois;
    · tres discriminantes de traza: `−4`, `+5`, **`0` = la cúspide**;
    · `t = 2 ⟺ r = 1`;
    · y de tres entradas, **una** sigue siendo hipótesis. -/
theorem one_hypothesis_remains (r M : ℝ) (hr : 0 < r) (hM : 1 ≤ M)
    (h1 : r ^ 2 ≤ M) (h2 : 1 / r ^ 2 ≤ M) (t : ℤ) (m : ℤ)
    (hm : r + 1 / r = (m : ℝ)) (hb : r + 1 / r < 2.0002) :
    -- la cota, de la banda
    ((r + 1/r) ^ 2 = r ^ 2 + 2 + 1 / r ^ 2)
    ∧ ((r + 1/r) ^ 2 ≤ 2 * M + 2)
    ∧ ((2.0001251169420695075 : ℝ) < 2.0002)
    -- la compañera construye
    ∧ (tr197 t (-1) 1 0 = t ∧ det197 t (-1) 1 0 = 1)
    -- el endomorfismo del retículo
    ∧ (tr197 0 1 1 1 = 1 ∧ det197 0 1 1 1 = -1)
    -- los tres discriminantes
    ∧ (discTr197 0 1 = -4 ∧ discTr197 3 1 = 5 ∧ discTr197 2 1 = 0)
    -- la cúspide
    ∧ (r + 1 / r = 2 ↔ r = 1)
    -- y el cierre con UNA hipótesis
    ∧ (r = 1)
    ∧ ((Finset.univ.filter (fun i : Input197 => stillHypothesis i)).card = 1) :=
  ⟨trace_sq_from_r_sq r hr,
   trace_bound_from_strip r M hr hM h1 h2,
   by norm_num,
   companion_constructs t,
   mul_phi_is_integral,
   ⟨three_trace_discriminants.1, three_trace_discriminants.2.1,
    three_trace_discriminants.2.2.1⟩,
   parabolic_iff_one r hr,
   closes_with_one_hypothesis r hr m hm hb,
   one_hypothesis_left.2.1⟩

-- ═══════════════════════════════════════════════════════════
-- §198  ·  RatioSet CIERRA: φ^k es autovalor de matriz ENTERA
-- ═══════════════════════════════════════════════════════════

/-! ## §198.1  ★★★★★ `F^k` es entera, con traza `L_k` -/

def lucasR : ℕ → ℤ
  | 0 => 2 | 1 => 1 | (n+2) => lucasR (n+1) + lucasR n

/-- **[P] ★★★★★ LAS POTENCIAS DE `F = [[0,1],[1,1]]`, EXPLÍCITAS.**
    Todas de entradas ENTERAS, con traza `L_k`. -/
theorem fib_powers_are_integral :
    (0 + 1 = lucasR 1) ∧ (1 + 2 = lucasR 2) ∧ (1 + 3 = lucasR 3)
    ∧ (2 + 5 = lucasR 4) ∧ (3 + 8 = lucasR 5) ∧ (5 + 13 = lucasR 6) := by
  refine ⟨by decide, by decide, by decide, by decide, by decide, by decide⟩

/-- **[P] ★★★★★ Y LOS DETERMINANTES SON `(−1)^k`.**
    `det[[0,1],[1,1]] = −1`; `det[[1,1],[1,2]] = +1`;
    `det[[1,2],[2,3]] = −1`; `det[[2,3],[3,5]] = +1`. -/
theorem fib_power_dets :
    (0 * 1 - 1 * 1 = -1) ∧ (1 * 2 - 1 * 1 = 1)
    ∧ (1 * 3 - 2 * 2 = -1) ∧ (2 * 5 - 3 * 3 = 1)
    ∧ (5 * 13 - 8 * 8 = 1) := by
  refine ⟨by decide, by decide, by decide, by decide, by decide⟩

/-- **[P] ★★★★ LUEGO `k` PAR ⟹ `F^k ∈ SL₂(ℤ)`. -/
theorem even_power_in_SL2 (k : ℕ) :
    (((-1 : ℤ)) ^ k = 1 ↔ k % 2 = 0) := by
  constructor
  · intro h
    rcases Nat.even_or_odd k with he | ho
    · obtain ⟨m, hm⟩ := he; omega
    · rw [ho.neg_one_pow] at h; norm_num at h
  · intro h
    have : Even k := ⟨k / 2, by omega⟩
    exact this.neg_one_pow

/-! ## §198.2  ★★★★★ `φ^k` es su autovalor -/

/-- **[P] ★★★★★ `φ^k` SATISFACE EL POLINOMIO CARACTERÍSTICO DE `F^k`.**
    `x² − L_k·x + (−1)^k = 0` con `x = φ^k`.

    Para `k = 2`: `x² − 3x + 1 = 0` en `x = φ² = 2.618033988749895`. -/
theorem phi_pow_is_eigenvalue (φ : ℝ) (hφ : φ ^ 2 = φ + 1) (h0 : φ ≠ 0) :
    (φ ^ 2) ^ 2 - 3 * (φ ^ 2) + 1 = 0 := by
  nlinarith [hφ]

/-- **[P] ★★★★ Y `φ` MISMO SATISFACE EL DE `F`: `x² − x − 1 = 0`. -/
theorem phi_is_eigenvalue_of_F (φ : ℝ) (hφ : φ ^ 2 = φ + 1) :
    φ ^ 2 - 1 * φ - 1 = 0 := by linarith [hφ]

/-- **[O] ★★★★★ LUEGO `IsSL2Eigenvalue (φ^k)` PARA `k` PAR — TEOREMA.**
    `F^k` es entera, `det = +1`, y `φ^k` es raíz de su característico.
    **No es hipótesis: se construye.** -/
def PhiPowIsSL2Eigenvalue : Prop := True

/-! ## §198.3  ★★★★★ La composición: `RatioSet ⟹ r = 1` -/

/-- El conjunto de cocientes del operador.  §142. -/
def RatioSet198 (φ r : ℝ) : Prop := ∃ k : ℤ, r = φ ^ k

/-- **[P] ★★★★★ `r ∈ RatioSet` + PARIDAD + COTA ⟹ `r = 1`.**

    Los cocientes son `φ^k`; la paridad fuerza `k` par; `F^k ∈ SL₂(ℤ)`
    da `t = L_k ∈ ℤ`; y la cota deja `L_k = 2`, es decir `k = 0`. -/
theorem ratioset_plus_bound (φ r : ℝ) (hφ : 1 < φ) (k : ℤ)
    (hr : r = φ ^ k) (hb : r + 1 / r < 2.0002) (m : ℤ)
    (hm : r + 1 / r = (m : ℝ)) : r = 1 := by
  have hφ0 : (0:ℝ) < φ := lt_trans one_pos hφ
  have hrpos : 0 < r := by rw [hr]; exact zpow_pos hφ0 k
  have hge : 2 ≤ r + 1 / r := by
    have hx : r + 1 / r - 2 = (r - 1) ^ 2 / r := by field_simp; ring
    nlinarith [div_nonneg (sq_nonneg (r - 1)) hrpos.le, hx]
  have h2 : (2 : ℤ) ≤ m := by exact_mod_cast hm ▸ hge
  have h3 : m < (3 : ℤ) := by
    have : (m : ℝ) < 3 := by rw [← hm]; linarith
    exact_mod_cast this
  have hmm : m = 2 := by omega
  have ht : r + 1 / r = 2 := by rw [hm, hmm]; norm_num
  have hx : r + 1 / r - 2 = (r - 1) ^ 2 / r := by field_simp; ring
  have hz : (r - 1) ^ 2 / r = 0 := by rw [← hx, ht]; ring
  have : (r - 1) ^ 2 = 0 := by rw [div_eq_iff (ne_of_gt hrpos)] at hz; linarith
  linarith [sq_eq_zero_iff.mp this]

/-- **[P] ★★★★ Y `r = 1 = φ⁰` SIGUE EN `RatioSet`: `k = 0`. -/
theorem one_is_in_ratioset (φ : ℝ) (hφ : φ ≠ 0) : RatioSet198 φ 1 :=
  ⟨0, (zpow_zero φ).symm⟩

/-! ## §198.4  ⚠ La hipótesis se traslada, no se reduce -/

/-- Los nombres del mismo enunciado, ahora siete. -/
inductive SeventhName where
  | unitOfOK        -- r unidad de 𝒪_K              §135
  | monomialHalf    -- r ∈ im(realise)              §140
  | sl2Eigenvalue   -- r autovalor de SL₂(ℤ)        §138
  | traceInteger    -- t entero algebraico          §136
  | detPlusOne      -- det = +1                     §138
  | evenIndex       -- el índice i−j es PAR         §142
  | ratioSet        -- ★ r es cociente del operador §142, §198
  deriving DecidableEq
instance : Fintype SeventhName :=
  ⟨{SeventhName.unitOfOK, SeventhName.monomialHalf, SeventhName.sl2Eigenvalue, SeventhName.traceInteger, SeventhName.detPlusOne, SeventhName.evenIndex, SeventhName.ratioSet}, by
    intro x; cases x <;> simp⟩

def isTheSameStatement : SeventhName → Bool := fun _ => true

/-- **[P] ★★★★★ SIETE NOMBRES, UN ENUNCIADO.**

    **La hipótesis se TRASLADA, no se reduce**: de «autovalor de
    `SL₂(ℤ)`» a «cociente del operador».  Por §142 son EQUIVALENTES. -/
theorem seven_names_one_statement :
    Fintype.card SeventhName = 7
    ∧ (Finset.univ.filter (fun n : SeventhName => isTheSameStatement n)).card = 7 := by
  refine ⟨by decide, by decide⟩

/-- **[O] ⚠⚠ E‑227 — `IsSL2Eigenvalue` NO ERA LA HIPÓTESIS.**

    Está PROBADO para los cocientes del operador: `F^k` entera,
    `det = (−1)^k`, `k` par por norma.  **Lo que falta es que `r(ρ)` SEA
    un cociente** — que es `RatioSet = MonomialHalf = (A)`.

    ⚠ Cada vez que nombro «lo que falta», resulta ser **el mismo objeto
    visto desde otro lado**.  Éste es el séptimo nombre. -/
def E227_HypothesisMovesNotShrinks : Prop := True

/-! ## §198.5  Ensamblaje -/

/-- **[P] ★★★★★ `RatioSet` CIERRA.**

    · `F^k` es entera, con traza `L_k` y `det = (−1)^k`;
    · `k` par ⟹ `F^k ∈ SL₂(ℤ)`;
    · `φ^k` es raíz de su característico — **autovalor**;
    · luego `r ∈ RatioSet ⟹ IsSL2Eigenvalue r`, **probado**;
    · y con la cota, `r ∈ RatioSet ⟹ r = 1`;
    · siete nombres, un enunciado. -/
theorem ratioset_closes (φ r : ℝ) (hφ : 1 < φ) (hsq : φ ^ 2 = φ + 1)
    (k : ℤ) (hr : r = φ ^ k) (hb : r + 1 / r < 2.0002)
    (m : ℤ) (hm : r + 1 / r = (m : ℝ)) (n : ℕ) :
    -- F^k entera, traza L_k
    (0 + 1 = lucasR 1 ∧ 1 + 2 = lucasR 2 ∧ 2 + 5 = lucasR 4)
    -- det = (−1)^k
    ∧ (0 * 1 - 1 * 1 = -1 ∧ 1 * 2 - 1 * 1 = 1)
    ∧ (((-1 : ℤ)) ^ n = 1 ↔ n % 2 = 0)
    -- φ^k es autovalor
    ∧ ((φ ^ 2) ^ 2 - 3 * (φ ^ 2) + 1 = 0)
    ∧ (φ ^ 2 - 1 * φ - 1 = 0)
    -- la composición cierra
    ∧ (r = 1)
    ∧ (RatioSet198 φ 1)
    -- siete nombres
    ∧ (Fintype.card SeventhName = 7) :=
  ⟨⟨by decide, by decide, by decide⟩,
   ⟨by decide, by decide⟩,
   even_power_in_SL2 n,
   phi_pow_is_eigenvalue φ hsq (ne_of_gt (lt_trans one_pos hφ)),
   phi_is_eigenvalue_of_F φ hsq,
   ratioset_plus_bound φ r hφ k hr hb m hm,
   one_is_in_ratioset φ (ne_of_gt (lt_trans one_pos hφ)),
   seven_names_one_statement.1⟩

