/-! ## §114.1  El dos, propagado -/

/-- **[P] EL GRADO ES DOS, Y DE AHÍ EL GRUPO.**  `|V| = 2² = 4`, y el
    ternario `3 = 2² − 1` sale del mismo dos. -/
theorem the_two_propagates :
    (2 : ℕ) ^ 2 = 4 ∧ (3 : ℕ) = 2 ^ 2 - 1 ∧ (2 : ℕ) * 3 = 6 := by
  refine ⟨by norm_num, by norm_num, by norm_num⟩

/-- **[P] Y EL ÁPICE ES `1/|V| · 2`.**  El estabilizador tiene orden
    `2` y `V` orden `4`: la razón `2/4` no admite otro valor sin
    cambiar el grado. -/
theorem apex_from_the_degree :
    ((2 : ℝ) / 4 = 1 / 2) ∧ ((1 : ℝ) / 2 = 1 / 2) := by
  refine ⟨by norm_num, rfl⟩

/-! ## §114.2  Cada forma es de orden dos -/

/-- Un testigo de que una forma desciende del grado dos: la
    estructura de la que es punto fijo o recíproco. -/
inductive OrderTwoSource where
  | mersenneBridge : OrderTwoSource   -- `φ^λ = 2`
  | gammaRecursion : OrderTwoSource   -- `Γ(s+1) = sΓ(s)`
  | involutionR    : OrderTwoSource   -- `x ↦ 1−x`
  | tauC           : OrderTwoSource   -- `s ↦ 1−s`
  | kernelG        : OrderTwoSource   -- `|ker G| = 2`
  | traceZero      : OrderTwoSource   -- `spec Ω̂`
  | sixthRoot      : OrderTwoSource   -- `e^{iπ/3}`, `6 = 2·3`
  | liFixed        : OrderTwoSource   -- ídem
  | reciprocalPair : OrderTwoSource   -- `{φ, 1/φ}`          §101
  | stabiliserTwo  : OrderTwoSource   -- `|V| = 2²`          §108
deriving DecidableEq

instance : Fintype OrderTwoSource :=
  ⟨{OrderTwoSource.mersenneBridge, OrderTwoSource.gammaRecursion, OrderTwoSource.involutionR, OrderTwoSource.tauC, OrderTwoSource.kernelG, OrderTwoSource.traceZero, OrderTwoSource.sixthRoot, OrderTwoSource.liFixed, OrderTwoSource.reciprocalPair, OrderTwoSource.stabiliserTwo}, by
    intro x; cases x <;> simp⟩

/-- **[P] DIEZ FORMAS.**  Las ocho del corpus más las dos de esta
    sesión.  **Formas, no fuentes.** -/
theorem ten_forms : Fintype.card OrderTwoSource = 10 := by decide

/-- **[P] Y LAS DOS NUEVAS SON DE ORDEN DOS.**  El par recíproco
    `{φ, 1/φ}` tiene producto `1`; el estabilizador tiene orden `2` en
    `|V| = 4`. -/
theorem the_two_new_forms (h : (φ : ℝ) ^ 2 = φ + 1) (hne : (φ : ℝ) ≠ 0) :
    ((φ : ℝ) * (1 / φ) = 1) ∧ ((2 : ℕ) ^ 2 = 4) := by
  refine ⟨by field_simp, by norm_num⟩

/-! ## §114.3  Por qué el ápice no admite parámetro -/

/-- **[C] EL ÚNICO DATO.**  El grado de la ecuación.  Predicado: lo
    que habría que cambiar para mover el ápice. -/
def OnlyDatum (deg : ℕ) : Prop := deg = 2

/-- **[P] CON EL GRADO FIJADO, EL ÁPICE ESTÁ FIJADO.**  `deg = 2` da
    `|V| = 4`, estabilizador `2`, razón `1/2`.  **No hay parámetro
    libre porque no hay más dato.** -/
theorem apex_has_no_free_parameter (deg : ℕ) (h : OnlyDatum deg) :
    (deg ^ 2 = 4) ∧ ((deg : ℝ) / (deg ^ 2 : ℕ) = 1 / 2) := by
  unfold OnlyDatum at h
  subst h
  refine ⟨by norm_num, by norm_num⟩

/-- **[O] EL ARGUMENTO CORRECTO, Y POR QUÉ ES MÁS FUERTE.**

    | | forma del argumento |
    |---|---|
    | «ocho independientes coinciden» | **improbabilidad** |
    | «un grado dos, diez formas» | **la misma relación en cada nivel** |

    El segundo no apela a coincidencia, y da la propiedad universal:
    mover el ápice exigiría cambiar el grado. -/
theorem the_correct_argument (deg : ℕ) (h : OnlyDatum deg) :
    (Fintype.card OrderTwoSource = 10) ∧
    (deg ^ 2 = 4) ∧
    ((2 : ℝ) / 4 = 1 / 2) :=
  ⟨ten_forms, (apex_has_no_free_parameter deg h).1, apex_from_the_degree.1⟩

/-- **[O] EL BALANCE DE §114.**

    | | mío | del corpus |
    |---|---|---|
    | criterio de admisión | «¿trae ingrediente nuevo?» | **¿es forma de orden dos?** |
    | las patas | ocho fuentes | **diez formas de una** |
    | fuerza del argumento | improbabilidad | **propagación del grado** |
    | §102, §108 | independencia local generalizada | **corregidos aquí** |

    **Nada de esto prueba `E`.**  Corrige el criterio con que admití
    las patas 7 y 8: encajan, y por otra razón. -/
theorem the_balance_of_section_114 (h : (φ : ℝ) ^ 2 = φ + 1)
    (hne : (φ : ℝ) ≠ 0) :
    (Fintype.card OrderTwoSource = 10) ∧
    ((φ : ℝ) * (1 / φ) = 1) ∧
    ((2 : ℕ) ^ 2 = 4) ∧
    ((3 : ℕ) = 2 ^ 2 - 1) :=
  ⟨ten_forms, (the_two_new_forms h hne).1, the_two_propagates.1,
   the_two_propagates.2.1⟩

