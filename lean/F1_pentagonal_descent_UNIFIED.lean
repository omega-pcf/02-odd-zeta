-- BLOCK S21. LadoAnalitico  (sprint 120): the Euler product as a colimit of
-- coefficient systems; the norm obstruction to a contractive evaluation; the two
-- spectral data.
-- ════════════════════════════════════════════════════════════════════════════

section LadoAnaliticoBlock

namespace LadoAnalitico

/-- The positive integers whose prime factors lie in `S`. -/
def Nset (S : Finset ℕ) : Set ℕ := {n | n ≠ 0 ∧ n.primeFactors ⊆ S}

/-- The order of the category of coefficient systems: `(X, c) ≤ (Y, d)` when `X ⊆ Y`
    and `d` extends `c`. -/
def Le (X : Set ℕ) (c : ℕ → ℂ) (Y : Set ℕ) (d : ℕ → ℂ) : Prop :=
  X ⊆ Y ∧ ∀ n ∈ X, c n = d n

theorem le_refl' (X : Set ℕ) (c : ℕ → ℂ) : Le X c X c := ⟨subset_rfl, fun _ _ => rfl⟩

/-- The inclusions `S ⊆ T` give morphisms `E(S) → E(T)`. -/
theorem mono {S T : Finset ℕ} (h : S ⊆ T) (a : ℕ → ℂ) : Le (Nset S) a (Nset T) a :=
  ⟨fun _ hn => ⟨hn.1, hn.2.trans h⟩, fun _ _ => rfl⟩

/-- Every positive integer lies in `Nset S` for `S` its set of prime factors. -/
theorem cover (n : ℕ) (hn : n ≠ 0) : n ∈ Nset n.primeFactors := ⟨hn, Finset.Subset.refl _⟩

/-- `(ℕ_{>0}, a)` is a cocone over the partial systems. -/
theorem upper (a : ℕ → ℂ) (S : Finset ℕ) : Le (Nset S) a {n | n ≠ 0} a :=
  ⟨fun _ hn => hn.1, fun _ _ => rfl⟩

/-- **The colimit.**  Any cocone `(Y, d)` over the partial systems receives `(ℕ_{>0}, a)`:
    `(ℕ_{>0}, a)` is the least upper bound, the colimit in the poset of coefficient systems. -/
theorem least (a : ℕ → ℂ) (Y : Set ℕ) (d : ℕ → ℂ) (h : ∀ S, Le (Nset S) a Y d) :
    Le {n | n ≠ 0} a Y d :=
  ⟨fun n hn => (h n.primeFactors).1 (cover n hn),
   fun n hn => (h n.primeFactors).2 n (cover n hn)⟩

/-- **The norm obstruction.**  For `t > 0`, the inequality `t ≤ t²` that a contractive
    evaluation `Ω ⊗ Ω → Ω` would require holds exactly when `1 ≤ t`. -/
theorem contractive_iff (t : ℝ) (ht : 0 < t) : t ≤ t ^ 2 ↔ 1 ≤ t := by
  constructor
  · intro h
    by_contra h1
    have h1' : t < 1 := lt_of_not_ge h1
    have : t ^ 2 < t := by nlinarith
    linarith
  · intro h; nlinarith

theorem no_contractive_eval (t : ℝ) (ht : 0 < t) (h1 : t < 1) : ¬ t ≤ t ^ 2 := by
  rw [contractive_iff t ht]; linarith

/-- **The two spectral data.**  `σ + μ = 2` and `σμ = 3/4` have exactly the two solutions
    `(3/2, 1/2)` and `(1/2, 3/2)`; one has `μ < 1`. -/
theorem spectral_data (σ μ : ℝ) :
    (σ + μ = 2 ∧ σ * μ = 3 / 4) ↔ ((σ = 3 / 2 ∧ μ = 1 / 2) ∨ (σ = 1 / 2 ∧ μ = 3 / 2)) := by
  constructor
  · rintro ⟨h1, h2⟩
    have hσ : σ = 2 - μ := by linarith
    subst hσ
    have : (μ - 1 / 2) * (μ - 3 / 2) = 0 := by nlinarith
    rcases mul_eq_zero.mp this with h | h
    · left; constructor <;> linarith
    · right; constructor <;> linarith
  · rintro (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩) <;> norm_num

theorem spectral_datum_below_one (σ μ : ℝ) (h : σ + μ = 2 ∧ σ * μ = 3 / 4) (hμ : μ < 1) :
    σ = 3 / 2 ∧ μ = 1 / 2 := by
  rcases (spectral_data σ μ).mp h with h' | h'
  · exact h'
  · exfalso; linarith [h'.2]

end LadoAnalitico

end LadoAnaliticoBlock

-- ════════════════════════════════════════════════════════════════════════════
-- BLOCK S22. ZetaPentagonal  (sprint 120): ζ(s) at the five points a/5.
-- ════════════════════════════════════════════════════════════════════════════

section ZetaPentagonalBlock

namespace ZetaPentagonal
open Complex HurwitzZeta
open scoped LSeries.notation

/-- **ζ at the pentagonal points.**  For `Re s > 1`,
    `ζ(s) = 5^{-s} (ζ(s,1) + ζ(s,1/5) + ζ(s,2/5) + ζ(s,3/5) + ζ(s,4/5))`, where
    `hurwitzZeta 0 = riemannZeta` is the point `a = 5`, i.e. `1/5·5 ≡ 0` on the circle. -/
theorem riemannZeta_pentagonal_points {s : ℂ} (hs : 1 < s.re) :
    riemannZeta s =
      (5 : ℂ) ^ (-s) *
        (hurwitzZeta (0 : UnitAddCircle) s +
         hurwitzZeta ((1 : ℝ) / (5 : ℝ) : UnitAddCircle) s +
         hurwitzZeta ((2 : ℝ) / (5 : ℝ) : UnitAddCircle) s +
         hurwitzZeta ((3 : ℝ) / (5 : ℝ) : UnitAddCircle) s +
         hurwitzZeta ((4 : ℝ) / (5 : ℝ) : UnitAddCircle) s) := by
  have p1 : ZMod.toAddCircle (1 : ZMod 5)
      = (((1 : ℝ) / (5 : ℝ) : ℝ) : UnitAddCircle) := by
    rw [ZMod.toAddCircle_apply]; congr 1
  have p2 : ZMod.toAddCircle (2 : ZMod 5)
      = (((2 : ℝ) / (5 : ℝ) : ℝ) : UnitAddCircle) := by
    rw [ZMod.toAddCircle_apply]; congr 1
  have p3 : ZMod.toAddCircle (3 : ZMod 5)
      = (((3 : ℝ) / (5 : ℝ) : ℝ) : UnitAddCircle) := by
    rw [ZMod.toAddCircle_apply]; congr 1
  have p4 : ZMod.toAddCircle (4 : ZMod 5)
      = (((4 : ℝ) / (5 : ℝ) : ℝ) : UnitAddCircle) := by
    rw [ZMod.toAddCircle_apply]; congr 1
  have p0 : ZMod.toAddCircle (0 : ZMod 5) = (0 : UnitAddCircle) := map_zero _
  have hL : riemannZeta s = ZMod.LFunction (fun _ : ZMod 5 => (1 : ℂ)) s := by
    rw [ZMod.LFunction_eq_LSeries _ hs, ← LSeries_one_eq_riemannZeta hs]
    rfl
  rw [hL]
  unfold ZMod.LFunction
  rw [show (Finset.univ : Finset (ZMod 5)) = {0, 1, 2, 3, 4} from by decide]
  rw [Finset.sum_insert (by decide), Finset.sum_insert (by decide),
      Finset.sum_insert (by decide), Finset.sum_insert (by decide),
      Finset.sum_singleton]
  rw [p0, p1, p2, p3, p4]
  push_cast
  ring_nf

