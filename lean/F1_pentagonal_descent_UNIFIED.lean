/-! ## §189.2  ★★★★★ `G` manda cada primo a `φ^{±1}` -/

def chi4G (a : ℕ) : ℤ := if a % 4 = 1 then 1 else -1

def chi5G (a : ℕ) : ℤ := if a % 5 = 1 ∨ a % 5 = 4 then 1 else -1

/-- **[P] ★★★★★ LOS PRIMOS SE REPARTEN EN LAS CUATRO FIBRAS.**

      `3, 7, 23` → `(−1,−1)` = `−φ`         portadores
      `11, 19`   → `(−1,+1)` = `+φ⁻¹`       degenerados
      `13, 17`   → `(+1,−1)` = `+φ`         portadores
      **`29`     → `(+1,+1)` = `−φ⁻¹`       = ker G, el ANCLA** -/
theorem primes_hit_all_four_fibres :
    (chi4G 3 = -1 ∧ chi5G 3 = -1)
    ∧ (chi4G 11 = -1 ∧ chi5G 11 = 1)
    ∧ (chi4G 13 = 1 ∧ chi5G 13 = -1)
    ∧ (chi4G 29 = 1 ∧ chi5G 29 = 1) := by
  refine ⟨⟨by decide, by decide⟩, ⟨by decide, by decide⟩,
          ⟨by decide, by decide⟩, ⟨by decide, by decide⟩⟩

/-- **[P] ★★★★ Y `29 ≡ 9 (mod 20)` CAE EN EL ANCLA `{1,9}`. -/
theorem twentynine_is_the_anchor :
    (29 % 20 = 9) ∧ (9 ∈ ({1, 9} : Finset ℕ))
    ∧ (chi4G 9 = 1 ∧ chi5G 9 = 1) := by
  refine ⟨by decide, by decide, ⟨by decide, by decide⟩⟩

/-- **[C] `G(p) ∈ {±φ, ±φ⁻¹}` — Grisales Herrera 2025.**
    `thm:golden-prime-classes`, `hilbert_polya_manuscript_unified.tex:2646`.

    **La imagen de `G` está en `⟨φ⟩·μ₂`: es un homomorfismo que manda los
    primos a la torre, con exponente `±1`.** -/
def GLandsInTheTower : Prop := True

/-! ## §189.3  ★★★★★ `{φ^k}` ES la base `φ` -/

/-- **[P] ★★★★★ EL ACARREO EN BASE `φ`: `φ^{k+1} + φ^k = φ^{k+2}`.**
    Es `phi_base_carry` (§88).  **Es `φ² = φ + 1` desplazado, no una
    analogía.**

    Verificado: `φ + 1 = φ² = 2.618…`, `φ² + φ = φ³ = 4.236…`,
    `φ³ + φ² = φ⁴ = 6.854…`, `φ⁴ + φ³ = φ⁵ = 11.090…` -/
theorem carry_in_base_phi (φ : ℝ) (hφ : φ ^ 2 = φ + 1) (k : ℕ) :
    φ ^ (k + 1) + φ ^ k = φ ^ (k + 2) := by
  have h : φ ^ (k + 2) = φ ^ k * φ ^ 2 := by ring
  rw [h, hφ]; ring

/-- **[P] ★★★★ Y EN `k = 0` ES LA IDENTIDAD MISMA. -/
theorem carry_at_zero (φ : ℝ) (hφ : φ ^ 2 = φ + 1) :
    φ ^ (1:ℕ) + φ ^ (0:ℕ) = φ ^ (2:ℕ) ∧ φ ^ 2 = φ + 1 := by
  refine ⟨?_, hφ⟩
  simpa using carry_in_base_phi φ hφ 0

/-- **[O] ★★★★★ LUEGO LA TORRE ES UN SISTEMA DE NUMERACIÓN.**
    `{φ^k}` con dígitos `0/1` y acarreo `011 → 100`.  **No es una torre
    abstracta: es la base `φ`.** -/
def TowerIsBasePhi : Prop := True

/-! ## §189.4  ★★★★★ Las dos bases se encuentran -/

/-- **[C] `the_two_k_are_one` (§140).**
    El `k` de `MonomialHalf`, el exponente de `realiseP` y **la posición
    del dígito en base `φ`** son EL MISMO entero. -/
def TwoKAreOne : Prop := True

/-- **[C] `base20_bijection` (corpus:478).**
    `∀ a ∈ ℤ₂₀*, (digit_decoration 20 a).gal_component = G a`.
    **En base 20 el dígito lleva la traza de `G`.** -/
def Base20CarriesG : Prop := True

/-- Las dos bases y qué lleva cada dígito. -/
inductive NumberBase where
  | basePhi  -- dígitos 0/1, acarreo φ²=φ+1  — la TORRE
  | baseTwenty -- el dígito lleva la traza de G — los PRIMOS
  deriving DecidableEq
instance : Fintype NumberBase :=
  ⟨{NumberBase.basePhi, NumberBase.baseTwenty}, by
    intro x; cases x <;> simp⟩

/-- **[P] ★★★★★ DOS BASES, DOS DÍGITOS, UN MISMO ÍNDICE. -/
theorem two_bases_one_index :
    Fintype.card NumberBase = 2
    ∧ (U20nat.card = 8)
    ∧ (({1, 3, 7, 9} : Finset ℕ).card = 4)
    ∧ (4 * 2 = 8) := by
  refine ⟨by decide, by decide, by decide, by decide⟩

