  refine ⟨by norm_num, by simp [lucasN], by norm_num, by simp [lucasN]; norm_num,
    by norm_num⟩

theorem even_iff_mod_two_zero (k : ℕ) : Even k ↔ k % 2 = 0 :=
  Nat.even_iff

theorem what_these_theorems_close (k : ℕ) (hk : k % 2 = 0) (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|) (hpos : 0 < zeroCoord ρ) :
    -- la FUNCIÓN: parten la familia en dos ramas por paridad
    ((k % 2 = 0 → e1P ((φ : ℝ) ^ (k : ℤ)) = (lucasN k : ℝ)) ∧
     (k % 2 = 1 → e1P ((φ : ℝ) ^ (k : ℤ)) = Real.sqrt 5 * (Nat.fib k : ℝ))) ∧
    -- rama PAR: los Lucas son ≥ 2, y el siguiente ya es 3
    ((2 ≤ lucasN k) ∧ (lucasN 2 = 3) ∧ ((3:ℝ) ^ 2 > 4 + 1/12)) ∧
    -- rama IMPAR: la traza es IRRACIONAL, y (√5)² = 5 > 4+1/12
    (((Real.sqrt 5) ^ 2 = 5) ∧ ((5:ℝ) > 4 + 1/12)) ∧
    -- la escalera de discriminantes: 0, 1, 5, 16 — y 1 > 1/12
    ((5 * (Nat.fib 0 : ℝ) ^ 2 = 0) ∧ ((lucasN 1 : ℝ) ^ 2 = 1) ∧ ((1:ℝ) > 1/12)) ∧
    -- Y LO QUE CIERRAN: la cota deja UN solo punto
    ((zeroCoord ρ + 1/(zeroCoord ρ)) ^ 2 ≤ 4 + 1/12) ∧
    (IsMonomial (zeroCoord ρ) → zeroCoord ρ = 1) := by
  refine ⟨⟨(trace_integral_iff_even k).1, (trace_integral_iff_even k).2⟩,
          ⟨the_even_lucas_bound_in_mod_form k hk, by decide, by norm_num⟩,
          ⟨Real.sq_sqrt (by norm_num), by norm_num⟩,
          ⟨by norm_num, by simp [lucasN], by norm_num⟩,
          (the_trace_is_confined_to_a_tiny_interval ρ h0 h1 hγ hpos).2,
          fun hm => (monomial_iff_one_under_confinement (zeroCoord ρ) hpos
                       (discBound_of_high_gamma ρ h0 h1 hγ)).mp hm⟩

theorem the_exclusion_is_complete_over_both_parities (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|) (hpos : 0 < zeroCoord ρ) :
    -- la cota, incondicional
    ((2 ≤ zeroCoord ρ + 1/(zeroCoord ρ)) ∧
     ((zeroCoord ρ + 1/(zeroCoord ρ)) ^ 2 ≤ 4 + 1/12)) ∧
    -- el primer valor PAR excluido: L₂ = 3, con 9 > 4+1/12
    ((lucasN 2 = 3) ∧ ((3:ℝ) ^ 2 > 4 + 1/12)) ∧
    -- el primer valor IMPAR excluido: √5, con 5 > 4+1/12
    (((Real.sqrt 5) ^ 2 = 5) ∧ ((5:ℝ) > 4 + 1/12)) ∧
    -- y sólo k = 0 sobrevive, que es r = 1, que es E
    ((zeroCoord ρ = 1) ↔ ρ.re = 1/2) :=
  ⟨⟨the_trace_is_bounded_below (zeroCoord ρ) hpos,
    (the_trace_is_confined_to_a_tiny_interval ρ h0 h1 hγ hpos).2⟩,
   ⟨by decide, by norm_num⟩,
   ⟨Real.sq_sqrt (by norm_num), by norm_num⟩,
   coord_eq_one_iff_re_half ρ h0⟩

theorem what_remains_of_the_gap (ρ : ℂ) (hρ : ρ ≠ 0) (hρ1 : ρ ≠ 1)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|) (hpos : 0 < zeroCoord ρ) :
    -- (a) la traza está acotada por los dos lados, INCONDICIONAL
    ((2 ≤ zeroCoord ρ + 1/(zeroCoord ρ)) ∧
     ((zeroCoord ρ + 1/(zeroCoord ρ)) ^ 2 ≤ 4 + 1/12)) ∧
    -- (b) traza 2 da la línea, y la línea da traza 2
    ((zeroCoord ρ + 1/(zeroCoord ρ) = 2 ↔ zeroCoord ρ = 1) ∧
     (zeroCoord ρ = 1 ↔ ρ.re = 1/2)) ∧
    -- (c) traza entera ⟺ E, las dos direcciones
    ((∃ n : ℕ, zeroCoord ρ + 1/(zeroCoord ρ) = (n : ℝ)) ↔ ρ.re = 1/2) ∧
    -- (d) la traza como cociente, con numerador RACIONAL
    ((zeroCoord ρ + 1/(zeroCoord ρ)
        = (Complex.abs (ρ - 1) ^ 2 + Complex.abs ρ ^ 2)
          / (Complex.abs (ρ - 1) * Complex.abs ρ)) ∧
     (Complex.abs (ρ - 1) ^ 2 + Complex.abs ρ ^ 2
        = 1 - 2 * ρ.re + 2 * ρ.re ^ 2 + 2 * ρ.im ^ 2)) ∧
    -- (e) y en la línea el denominador es un cuadrado, AUTOMÁTICO
    (ρ.re = 1/2 → Complex.abs (ρ - 1) ^ 2 = Complex.abs ρ ^ 2) :=
  ⟨⟨the_trace_is_bounded_below (zeroCoord ρ) hpos,
    (the_trace_is_confined_to_a_tiny_interval ρ h0 h1 hγ hpos).2⟩,
   ⟨the_trace_equals_two_iff_ratio_one (zeroCoord ρ) hpos,
    coord_eq_one_iff_re_half ρ h0⟩,
   the_two_labels_are_one_gap ρ h0 h1 hγ hpos,
   ⟨the_trace_as_a_quotient ρ hρ hρ1,
    the_numerator_is_rational_in_beta_and_gamma ρ⟩,
   fun hE => on_the_line_the_two_factors_agree ρ hE⟩

theorem the_denominator_is_positive (ρ : ℂ) (hρ : ρ ≠ 0) (hρ1 : ρ ≠ 1) :
    0 < Complex.abs (ρ - 1) * Complex.abs ρ := by
  have ha : 0 < Complex.abs ρ := Complex.abs.pos hρ
  have hb : 0 < Complex.abs (ρ - 1) :=
    Complex.abs.pos (sub_ne_zero.mpr hρ1)
  exact mul_pos hb ha

theorem the_quadratic_form_condition_gives_the_trace (ρ : ℂ)
    (hρ : ρ ≠ 0) (hρ1 : ρ ≠ 1) (n : ℕ)
    (hn : Complex.abs (ρ - 1) ^ 2 + Complex.abs ρ ^ 2
            = (n : ℝ) * (Complex.abs (ρ - 1) * Complex.abs ρ)) :
    zeroCoord ρ + 1/(zeroCoord ρ) = (n : ℝ) := by
  have hd := the_denominator_is_positive ρ hρ hρ1
  rw [the_trace_as_a_quotient ρ hρ hρ1, hn, mul_comm (n : ℝ)
    (Complex.abs (ρ - 1) * Complex.abs ρ)]
  exact mul_div_cancel_left₀ (n : ℝ) (ne_of_gt hd)

theorem the_quadratic_form_condition_gives_E (ρ : ℂ)
    (hρ : ρ ≠ 0) (hρ1 : ρ ≠ 1) (h0 : 0 < ρ.re) (h1 : ρ.re < 1)
    (hγ : 2 ≤ |ρ.im|) (hpos : 0 < zeroCoord ρ)
    (hn : ∃ n : ℕ, Complex.abs (ρ - 1) ^ 2 + Complex.abs ρ ^ 2
            = (n : ℝ) * (Complex.abs (ρ - 1) * Complex.abs ρ)) :
    ρ.re = 1/2 := by
  obtain ⟨n, hn⟩ := hn
  exact integrality_would_close_it ρ h0 h1 hγ hpos
    ⟨n, the_quadratic_form_condition_gives_the_trace ρ hρ hρ1 n hn⟩

theorem the_line_satisfies_it_with_n_two (ρ : ℂ) (hρ : ρ ≠ 0) (hρ1 : ρ ≠ 1)
    (hE : ρ.re = 1/2) :
    Complex.abs (ρ - 1) ^ 2 + Complex.abs ρ ^ 2
      = (2 : ℝ) * (Complex.abs (ρ - 1) * Complex.abs ρ) := by
  have hsq := on_the_line_the_two_factors_agree ρ hE
  have ha : 0 ≤ Complex.abs ρ := Complex.abs.nonneg ρ
  have hb : 0 ≤ Complex.abs (ρ - 1) := Complex.abs.nonneg _
  have heq : Complex.abs (ρ - 1) = Complex.abs ρ := by
    nlinarith [hsq, ha, hb]
  rw [heq]; ring

theorem the_condition_is_exactly_E (ρ : ℂ) (hρ : ρ ≠ 0) (hρ1 : ρ ≠ 1)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|) (hpos : 0 < zeroCoord ρ) :
    (∃ n : ℕ, Complex.abs (ρ - 1) ^ 2 + Complex.abs ρ ^ 2
        = (n : ℝ) * (Complex.abs (ρ - 1) * Complex.abs ρ)) ↔ ρ.re = 1/2 := by
  constructor
  · intro hn; exact the_quadratic_form_condition_gives_E ρ hρ hρ1 h0 h1 hγ hpos hn
  · intro hE; exact ⟨2, the_line_satisfies_it_with_n_two ρ hρ hρ1 hE⟩

theorem the_gap_in_two_quadratic_forms (ρ : ℂ) (hρ : ρ ≠ 0) (hρ1 : ρ ≠ 1)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|) (hpos : 0 < zeroCoord ρ) :
    -- el numerador, forma cuadrática RACIONAL en β y γ
    ((Complex.abs (ρ - 1) ^ 2 + Complex.abs ρ ^ 2
        = 1 - 2 * ρ.re + 2 * ρ.re ^ 2 + 2 * ρ.im ^ 2)) ∧
    -- el denominador es POSITIVO, sin ambigüedad de signo
    (0 < Complex.abs (ρ - 1) * Complex.abs ρ) ∧
    -- y la condición es EXACTAMENTE E
    ((∃ n : ℕ, Complex.abs (ρ - 1) ^ 2 + Complex.abs ρ ^ 2
        = (n : ℝ) * (Complex.abs (ρ - 1) * Complex.abs ρ)) ↔ ρ.re = 1/2) :=
  ⟨the_numerator_is_rational_in_beta_and_gamma ρ,
   the_denominator_is_positive ρ hρ hρ1,
   the_condition_is_exactly_E ρ hρ hρ1 h0 h1 hγ hpos⟩

theorem the_escape_mechanism (r C : ℝ) (hr : 1 < r) (hC : 0 < C) :
    ∃ p : ℕ, C < r ^ p :=
  powers_escape_any_bound r C hr hC

theorem the_confinement_bounds_every_coordinate (h : NoLowZeros) (z : Chi5Zero) :
    zeroCoord z.ρ ≤ 2 / Real.sqrt 3 :=
  every_zero_coord_bounded h z

theorem the_action_forbids_coord_above_one (h : NoLowZeros)
    (hB : ZeroCoordsCarryPowerAction) (z : Chi5Zero) :
    ¬ (1 < zeroCoord z.ρ) :=
  action_forbids_coord_gt_one h hB z

theorem the_companion_inverts_the_coordinate (z : Chi5Zero) :
    (zeroCoord z.ρ * zeroCoord (1 - z.ρ) = 1) ∧
    (DirichletCharacter.LFunction chi5_D (1 - z.ρ) = 0) :=
  coords_closed_under_inversion z

theorem route_B_closes_without_the_monoid (h : NoLowZeros)
    (hB : ZeroCoordsCarryPowerAction) (z : Chi5Zero) :
    z.ρ.re = 1/2 :=
  B_gives_E_one_hypothesis h hB z

theorem the_prime_indexed_membership (h : NoLowZeros)
    (hB : ZeroCoordsCarryPowerAction) (z : Chi5Zero) (p : ℕ) (hp : p.Prime)
    (r C : ℝ) (hr : 1 < r) (hC : 0 < C) :
    -- la ACCIÓN: para cada PRIMO, la familia de coordenadas es cerrada
    (∃ w : Chi5Zero, zeroCoord w.ρ = (zeroCoord z.ρ) ^ p) ∧
    -- el ESCAPE: las potencias de algo > 1 superan cualquier cota
    (∃ q : ℕ, C < r ^ q) ∧
    -- el CONFINAMIENTO: toda coordenada de cero está acotada por 2/√3
    (zeroCoord z.ρ ≤ 2 / Real.sqrt 3) ∧
    -- ⟹ ninguna coordenada pasa de 1
    (¬ (1 < zeroCoord z.ρ)) ∧
    -- la INVERSIÓN: el compañero lleva 1/r, luego tampoco baja de 1
    (zeroCoord z.ρ * zeroCoord (1 - z.ρ) = 1) ∧
    -- y de ahí E, SIN pasar por φ^ℤ en ningún paso
    (z.ρ.re = 1/2) :=
  ⟨hB p hp z,
   powers_escape_any_bound r C hr hC,
   every_zero_coord_bounded h z,
   action_forbids_coord_gt_one h hB z,
   (coords_closed_under_inversion z).1,
   B_gives_E_one_hypothesis h hB z⟩

theorem two_descents_two_entrances (h : NoLowZeros)
    (hB : ZeroCoordsCarryPowerAction) (z : Chi5Zero)
    (hpos : 0 < zeroCoord z.ρ) (hle : discP (zeroCoord z.ρ) ≤ 1/12) :
    -- ENTRADA 1: el monoide φ^ℤ, con el confinamiento
    ((IsMonomial (zeroCoord z.ρ) ↔ z.ρ.re = 1/2)) ∧
    -- ENTRADA 2: la clausura bajo potencias primas, con el escape
    ((z.ρ.re = 1/2)) ∧
    -- y son INDEPENDIENTES: la segunda no menciona φ^k
    (∀ p : ℕ, p.Prime → ∃ w : Chi5Zero,
        zeroCoord w.ρ = (zeroCoord z.ρ) ^ p) :=
  ⟨descending_to_F1_is_E z.ρ hpos hle z.in_strip_pos,
   B_gives_E_one_hypothesis h hB z,
   fun p hp => hB p hp z⟩

theorem what_the_action_asks (p : ℕ) (hp : p.Prime) (z : Chi5Zero)
    (hB : ZeroCoordsCarryPowerAction) :
    ∃ w : Chi5Zero, zeroCoord w.ρ = (zeroCoord z.ρ) ^ p :=
  hB p hp z

theorem the_available_mechanisms_are_of_order_two (z : Chi5Zero) :
    (zeroCoord z.ρ * zeroCoord (1 - z.ρ) = 1) ∧
    (DirichletCharacter.LFunction chi5_D (1 - z.ρ) = 0) ∧
    (∃ w : Chi5Zero, zeroCoord w.ρ = (zeroCoord z.ρ)⁻¹) :=
  ⟨(coords_closed_under_inversion z).1, z.companion.is_zero,
   mate_hypothesis_discharged z⟩

theorem what_is_missing_for_the_action (z : Chi5Zero) :
    -- lo que HAY: la inversión, de orden DOS
    ((∃ w : Chi5Zero, zeroCoord w.ρ = (zeroCoord z.ρ)⁻¹) ∧
     (zeroCoord z.ρ * zeroCoord (1 - z.ρ) = 1)) ∧
    -- lo que la acción PIDE: la potencia p-ésima, de orden INFINITO
    (ZeroCoordsCarryPowerAction →
       ∀ p : ℕ, p.Prime → ∃ w : Chi5Zero,
         zeroCoord w.ρ = (zeroCoord z.ρ) ^ p) ∧
    -- y lo que la cierra si se tuviera
    (∀ h : NoLowZeros, ∀ hB : ZeroCoordsCarryPowerAction, z.ρ.re = 1/2) :=
  ⟨⟨mate_hypothesis_discharged z, (coords_closed_under_inversion z).1⟩,
   fun hB p hp => hB p hp z,
   fun h hB => B_gives_E_one_hypothesis h hB z⟩

theorem the_spectrum_is_not_closed_under_powers (k : Fin 3)
    (hw : Complex.abs w_pcf = 1) :
    (Complex.abs (Omega_hat k) = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ))) ∧
    ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = 1/2) ∧
    ((1:ℝ)/2 * (1/2) = 1/4) ∧
    ((1:ℝ)/4 ≠ 1/2) := by
  refine ⟨spectrum_modulus_is_the_anchor k hw, anchor_is_the_spectral_scale,
          by norm_num, by norm_num⟩

theorem the_hermitian_operator_indexes_the_ordinates (n : ℝ) (hn : 1 ≤ n) :
    (T_star n = c_spectral n * Real.pi * n / Real.log (μ_PCF * n + σ_PCF)) ∧
    (2 < c_spectral n) ∧
    (c_spectral n ≤ 2 + α₀) ∧
    (σ_PCF + μ_PCF = 2) :=
  ⟨rfl, c_gt_two hn, c_bounded_above hn, sigma_plus_mu⟩

theorem the_two_operators_live_in_different_coordinates (ρ : ℂ) (k : Fin 3)
    (n : ℝ) (hn : 1 ≤ n) (hw : Complex.abs w_pcf = 1) :
    -- Ω̂ vive en la PARTE REAL
    (((Omega_hat k).re = 1/2 ∨ (Omega_hat k).re = -(1/4)) ∧
     (Complex.abs (Omega_hat k) = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ)))) ∧
    -- T*/H_PCF vive en la ORDENADA
    ((2 < c_spectral n) ∧
     (T_star n = c_spectral n * Real.pi * n / Real.log (μ_PCF * n + σ_PCF))) ∧
    -- y la coordenada del cero lleva TODA la ordenada al radio
    (((rad₉ ρ (1 - ρ)).im = ρ.im) ∧ ((ctr₉ ρ (1 - ρ)).im = 0)) := by
  refine ⟨⟨Omega_hat_is_about_the_real_part k, spectrum_modulus_is_the_anchor k hw⟩,
          ⟨c_gt_two hn, rfl⟩,
          the_radius_carries_the_whole_ordinate ρ⟩

theorem why_the_hermitian_route_does_not_give_the_action (ρ : ℂ) (k : Fin 3)
    (n : ℝ) (hn : 1 ≤ n) (hw : Complex.abs w_pcf = 1) (z : Chi5Zero) :
    -- lo que el hermitiano SÍ da: índice en ℕ, familia infinita
    ((2 < c_spectral n) ∧ (σ_PCF + μ_PCF = 2)) ∧
    -- y el espectro de Ω̂ NO es cerrado bajo potencias
    ((Complex.abs (Omega_hat k) = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ))) ∧
     ((1:ℝ)/2 * (1/2) = 1/4) ∧ ((1:ℝ)/4 ≠ 1/2)) ∧
    -- lo que la acción pide vive en la COORDENADA, no en la ordenada
    ((zeroCoord z.ρ * zeroCoord (1 - z.ρ) = 1) ∧
     ((rad₉ z.ρ (1 - z.ρ)).im = z.ρ.im)) := by
  refine ⟨⟨c_gt_two hn, sigma_plus_mu⟩,
          ⟨spectrum_modulus_is_the_anchor k hw, by norm_num, by norm_num⟩,
          ⟨(coords_closed_under_inversion z).1,
           (the_radius_carries_the_whole_ordinate z.ρ).1⟩⟩

theorem step_one_the_monoid_is_closed (p q : ℕ) (n : ℤ) :
    (X_PCF.psi p (X_PCF.psi q n) = X_PCF.psi (p * q) n) ∧
    ((φ : ℝ) ^ ((p : ℤ) * n) = ((φ : ℝ) ^ n) ^ p) ∧
    (∃ m : ℤ, (φ : ℝ) ^ ((p : ℤ) * n) = (φ : ℝ) ^ m) :=
  ⟨frobenius_commutes p q n, psi_is_exact_power p n, ⟨X_PCF.psi p n, rfl⟩⟩

theorem step_two_the_anchor_is_outside_the_lattice :
    (¬ ∃ i : ℤ, (φ : ℝ) ^ i = 2) ∧
    ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = 1/2) :=
  ⟨lambda_is_not_an_integer, anchor_is_the_spectral_scale⟩

theorem step_four_the_spectrum_carries_the_anchor (k : Fin 3)
    (hw : Complex.abs w_pcf = 1) :
    (Omega_hat k = ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) : ℝ) * w_pcf ^ (k : ℕ)) ∧
    (Complex.abs (Omega_hat k) = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ))) :=
  ⟨spectrum_is_anchor_times_orbit k, spectrum_modulus_is_the_anchor k hw⟩

theorem step_six_membership_would_give_the_power (r : ℝ) (p : ℕ)
    (hm : IsMonomial r) : IsMonomial (r ^ p) := by
  obtain ⟨k, hk⟩ := hm
  exact ⟨k * p, by rw [hk, ← zpow_natCast, ← zpow_mul]⟩

theorem the_two_gaps_are_distinct (z : Chi5Zero) (p : ℕ) (hp : p.Prime)
    (hpos : 0 < zeroCoord z.ρ) (hle : discP (zeroCoord z.ρ) ≤ 1/12) :
    -- HUECO 5: que la coordenada esté en el monoide
    ((IsMonomial (zeroCoord z.ρ)) ↔ z.ρ.re = 1/2) ∧
    -- paso 6: SI lo estuviera, su potencia también
    ((IsMonomial (zeroCoord z.ρ)) → IsMonomial ((zeroCoord z.ρ) ^ p)) ∧
    -- HUECO 7: que esa potencia sea coordenada de OTRO CERO
    (ZeroCoordsCarryPowerAction →
       ∃ w : Chi5Zero, zeroCoord w.ρ = (zeroCoord z.ρ) ^ p) :=
  ⟨descending_to_F1_is_E z.ρ hpos hle z.in_strip_pos,
   fun hm => step_six_membership_would_give_the_power (zeroCoord z.ρ) p hm,
   fun hB => hB p hp z⟩

theorem the_chain_with_its_seven_steps (z : Chi5Zero) (p q : ℕ) (n : ℤ)
    (hp : p.Prime) (k : Fin 3) (hw : Complex.abs w_pcf = 1)
    (hpos : 0 < zeroCoord z.ρ) (hle : discP (zeroCoord z.ρ) ≤ 1/12) :
    -- 1. el monoide ES cerrado bajo ψ_p
    ((X_PCF.psi p (X_PCF.psi q n) = X_PCF.psi (p * q) n) ∧
     (∃ m : ℤ, (φ : ℝ) ^ ((p : ℤ) * n) = (φ : ℝ) ^ m)) ∧
    -- 2. el ancla está FUERA de φ^ℤ
    (¬ ∃ i : ℤ, (φ : ℝ) ^ i = 2) ∧
    -- 4. y el espectro lleva el ancla, luego tampoco está en φ^ℤ
    (Complex.abs (Omega_hat k) = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ))) ∧
    -- 5. HUECO: ¿está la coordenada del cero en φ^ℤ?
    ((IsMonomial (zeroCoord z.ρ)) ↔ z.ρ.re = 1/2) ∧
    -- 6. si lo estuviera, la potencia también
    ((IsMonomial (zeroCoord z.ρ)) → IsMonomial ((zeroCoord z.ρ) ^ p)) ∧
    -- 7. HUECO: ¿es esa potencia coordenada de otro cero?
    (ZeroCoordsCarryPowerAction →
       ∃ w : Chi5Zero, zeroCoord w.ρ = (zeroCoord z.ρ) ^ p) :=
  ⟨⟨frobenius_commutes p q n, ⟨X_PCF.psi p n, rfl⟩⟩,
   lambda_is_not_an_integer,
   spectrum_modulus_is_the_anchor k hw,
   descending_to_F1_is_E z.ρ hpos hle z.in_strip_pos,
   fun hm => step_six_membership_would_give_the_power (zeroCoord z.ρ) p hm,
   fun hB => hB p hp z⟩

theorem the_valuation_is_the_shared_coordinate (r : ℝ) (hr : 0 < r) :
    (valPhi r = Real.log r / Real.log (φ : ℝ)) ∧
    ((∃ k : ℤ, r = (φ : ℝ) ^ k) ↔ ∃ k : ℤ, valPhi r = (k : ℝ)) ∧
    (∀ n : ℤ, valPhi ((φ : ℝ) ^ n) = (n : ℝ)) :=
  ⟨rfl, monomial_iff_valPhi_int r hr, valPhi_realise⟩

theorem the_two_sides_are_one_valuation (z : Chi5Zero) (k : Fin 3)
    (hw : Complex.abs w_pcf = 1) (hpos : 0 < zeroCoord z.ρ)
    (h0 : 0 < z.ρ.re) (h1 : z.ρ.re < 1) :
    -- LA MISMA función mide los dos lados
    (valPhi ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ))) =
       -(Real.log 2 / Real.log (φ : ℝ))) ∧
    (Complex.abs (Omega_hat k) = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ))) ∧
    -- y en ella, «estar en el monoide» ES «tener valuación entera»
    ((∃ j : ℤ, zeroCoord z.ρ = (φ : ℝ) ^ j) ↔
       ∃ j : ℤ, valPhi (zeroCoord z.ρ) = (j : ℝ)) ∧
    (valPhi (zeroCoord z.ρ) = 0 ↔ z.ρ.re = 1/2) :=
  ⟨the_anchor_has_valuation_minus_lambda,
   spectrum_modulus_is_the_anchor k hw,
   monomial_iff_valPhi_int (zeroCoord z.ρ) hpos,
   degenerate_iff_valuation_zero z.ρ h0 h1⟩

theorem gap_five_is_integrality_of_a_real (ρ : ℂ) (hpos : 0 < zeroCoord ρ) :
    (∃ k : ℤ, zeroCoord ρ = (φ : ℝ) ^ k) ↔ ∃ k : ℤ, valPhi (zeroCoord ρ) = (k : ℝ) :=
  monomial_iff_valPhi_int (zeroCoord ρ) hpos

theorem the_power_becomes_multiplication (r : ℝ) (p : ℕ) :
    valPhi (r ^ p) = (p : ℝ) * valPhi r := by
  unfold valPhi
  rw [Real.log_pow]
  ring

theorem gap_seven_is_multiplication_by_p (z w : Chi5Zero) (p : ℕ)
    (hw : zeroCoord w.ρ = (zeroCoord z.ρ) ^ p) :
    valPhi (zeroCoord w.ρ) = (p : ℝ) * valPhi (zeroCoord z.ρ) := by
  rw [hw, the_power_becomes_multiplication (zeroCoord z.ρ) p]

theorem step_six_in_the_valuation (v : ℝ) (p : ℕ) (k : ℤ) (hv : v = (k : ℝ)) :
    (p : ℝ) * v = ((p * k : ℤ) : ℝ) := by
  rw [hv]; push_cast; ring

theorem what_the_valuation_says_about_both_gaps (z : Chi5Zero) (p : ℕ)
    (hpos : 0 < zeroCoord z.ρ) (h0 : 0 < z.ρ.re) (h1 : z.ρ.re < 1) :
    -- (5) el descenso ES la integralidad de un real
    ((∃ k : ℤ, zeroCoord z.ρ = (φ : ℝ) ^ k) ↔
       ∃ k : ℤ, valPhi (zeroCoord z.ρ) = (k : ℝ)) ∧
    -- (7) la acción ES multiplicación por p en la valuación
    (valPhi ((zeroCoord z.ρ) ^ p) = (p : ℝ) * valPhi (zeroCoord z.ρ)) ∧
    -- el paso 6: si v es entera, p·v también
    (∀ k : ℤ, valPhi (zeroCoord z.ρ) = (k : ℝ) →
       (p : ℝ) * valPhi (zeroCoord z.ρ) = ((p * k : ℤ) : ℝ)) ∧
    -- y la línea es la valuación NULA
    (valPhi (zeroCoord z.ρ) = 0 ↔ z.ρ.re = 1/2) :=
  ⟨monomial_iff_valPhi_int (zeroCoord z.ρ) hpos,
   the_power_becomes_multiplication (zeroCoord z.ρ) p,
   fun k hk => step_six_in_the_valuation (valPhi (zeroCoord z.ρ)) p k hk,
   degenerate_iff_valuation_zero z.ρ h0 h1⟩

theorem the_klein_action_in_the_valuation (z : Chi5Zero) :
    (valPhi (zeroCoord z.ρ) = - valPhi (zeroCoord (1 - z.ρ))) ∧
    (zeroCoord z.ρ * zeroCoord (1 - z.ρ) = 1) :=
  ⟨the_zero_pair_in_valPhi_has_opposite_signs z,
   (coords_closed_under_inversion z).1⟩

theorem two_actions_two_orders (z : Chi5Zero) (p : ℕ) (hpos : 0 < zeroCoord z.ρ) :
    -- KLEIN en la valuación: v ↦ −v, ORDEN DOS
    (valPhi (zeroCoord z.ρ) = - valPhi (zeroCoord (1 - z.ρ))) ∧
    -- ℤ en la valuación: v ↦ p·v, ORDEN INFINITO
    (valPhi ((zeroCoord z.ρ) ^ p) = (p : ℝ) * valPhi (zeroCoord z.ρ)) ∧
    -- y la segunda preserva ℤ
    (∀ k : ℤ, valPhi (zeroCoord z.ρ) = (k : ℝ) →
       (p : ℝ) * valPhi (zeroCoord z.ρ) = ((p * k : ℤ) : ℝ)) :=
  ⟨the_zero_pair_in_valPhi_has_opposite_signs z,
   the_power_becomes_multiplication (zeroCoord z.ρ) p,
   fun k hk => step_six_in_the_valuation (valPhi (zeroCoord z.ρ)) p k hk⟩

theorem the_euler_chain_produces_integers_on_the_prime_side (k : ℕ) :
    -- Binet: la traza de φ^k es un ENTERO
    ((φ : ℝ) ^ k + (1 - φ) ^ k = (lucasN k : ℝ)) ∧
    -- y la diferencia lleva √5
    ((φ : ℝ) ^ k - (1 - φ) ^ k = (Nat.fib k : ℝ) * Real.sqrt 5) ∧
    -- con la forma norma L² − 5F² = 4(−1)^k
    ((lucasN k : ℤ) ^ 2 - 5 * (Nat.fib k : ℤ) ^ 2 = 4 * (-1) ^ k) ∧
    -- y el conductor sale de los períodos
    (Nat.lcm 4 5 = 20) :=
  ⟨binet_sum k, binet_diff k, lucas_fib_norm k, conductor_from_periods⟩

theorem the_integers_live_on_the_monoid_side (k : ℕ) :
    ((k % 2 = 0 → e1P ((φ : ℝ) ^ (k : ℤ)) = (lucasN k : ℝ)) ∧
     (k % 2 = 1 → e1P ((φ : ℝ) ^ (k : ℤ)) = Real.sqrt 5 * (Nat.fib k : ℝ))) ∧
    (inChain (discP ((φ : ℝ) ^ k))) ∧
    (∀ n : ℤ, valPhi ((φ : ℝ) ^ n) = (n : ℝ)) :=
  ⟨⟨(trace_integral_iff_even k).1, (trace_integral_iff_even k).2⟩,
   family_membership_nat k, valPhi_realise⟩

theorem where_the_chain_stops (z : Chi5Zero) (k : ℕ)
    (hpos : 0 < zeroCoord z.ρ) :
    -- LO QUE LA CADENA DA: enteros sobre φ^k, indexados por k ∈ ℕ
    ((k % 2 = 0 → e1P ((φ : ℝ) ^ (k : ℤ)) = (lucasN k : ℝ)) ∧
     (∀ n : ℤ, valPhi ((φ : ℝ) ^ n) = (n : ℝ)) ∧
     (inChain (discP ((φ : ℝ) ^ k)))) ∧
    -- LO QUE FALTA: que la valuación DEL CERO sea uno de esos enteros
    ((∃ j : ℤ, zeroCoord z.ρ = (φ : ℝ) ^ j) ↔
       ∃ j : ℤ, valPhi (zeroCoord z.ρ) = (j : ℝ)) :=
  ⟨⟨(trace_integral_iff_even k).1, valPhi_realise, family_membership_nat k⟩,
   monomial_iff_valPhi_int (zeroCoord z.ρ) hpos⟩

theorem the_chain_reaches_the_index_not_the_zero (z : Chi5Zero) (n : ℤ)
    (p : ℕ) (hpos : 0 < zeroCoord z.ρ) :
    -- sobre el ÍNDICE del monoide la valuación es entera POR CONSTRUCCIÓN
    (valPhi ((φ : ℝ) ^ n) = (n : ℝ)) ∧
    -- y la acción de p lo respeta
    (valPhi (((φ : ℝ) ^ n) ^ p) = (p : ℝ) * (n : ℝ)) ∧
    -- sobre el CERO la misma pregunta es la conjetura
    ((valPhi (zeroCoord z.ρ) = 0 ↔ zeroCoord z.ρ = 1)) := by
  refine ⟨valPhi_realise n, ?_, ?_⟩
  · rw [the_power_becomes_multiplication, valPhi_realise]
  · constructor
    · intro h
      have := monomial_iff_valPhi_int (zeroCoord z.ρ) hpos
      have h0 : valPhi (zeroCoord z.ρ) = ((0:ℤ) : ℝ) := by rw [h]; norm_num
      obtain ⟨j, hj⟩ := this.mpr ⟨0, h0⟩
      rw [hj] at h ⊢
      rw [valPhi_realise] at h
      have : j = 0 := by exact_mod_cast h
      rw [this]; norm_num
    · intro h; rw [h]; unfold valPhi; simp

theorem the_centre_has_the_anchor_valuation (ρ : ℂ) :
    (ctr₉ ρ (1 - ρ) = 1/2) ∧
    ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = 1/2) ∧
    (valPhi ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ))) =
       -(Real.log 2 / Real.log (φ : ℝ))) ∧
    (¬ ∃ i : ℤ, (φ : ℝ) ^ i = 2) :=
  ⟨the_centre_is_fixed_for_every_zero ρ, anchor_is_the_spectral_scale,
   the_anchor_has_valuation_minus_lambda, lambda_is_not_an_integer⟩

theorem the_centre_is_never_in_the_monoid (ρ : ℂ) :
    (ctr₉ ρ (1 - ρ) = 1/2) ∧
    ((ctr₉ ρ (1 - ρ)).re = (Omega_hat ⟨0, by norm_num⟩).re) ∧
    (¬ ∃ i : ℤ, (φ : ℝ) ^ i = 2) :=
  ⟨the_centre_is_fixed_for_every_zero ρ,
   orbit_centre_is_in_the_spectrum ρ,
   lambda_is_not_an_integer⟩

theorem the_three_chains_together (z : Chi5Zero) (k : ℕ) (p : ℕ)
    (a b : ZMod 20) (ha : a ∈ ZtwentyStar) (hb : b ∈ ZtwentyStar)
    (hpos : 0 < zeroCoord z.ρ) (h0 : 0 < z.ρ.re) (h1 : z.ρ.re < 1) :
    -- A · LA CADENA DE EULER: φ traza de raíz de la unidad, y Lucas enteros
    (((φ : ℝ) = 2 * Real.cos (Real.pi / 5)) ∧
     ((lucasN k : ℤ) ^ 2 - 5 * (Nat.fib k : ℤ) ^ 2 = 4 * (-1) ^ k) ∧
     (k % 2 = 0 → e1P ((φ : ℝ) ^ (k : ℤ)) = (lucasN k : ℝ))) ∧
    -- Z₂₀ y la decoración
    ((G (a * b) = G a + G b) ∧ (ZtwentyStar.card = 8) ∧ (Nat.lcm 4 5 = 20)) ∧
    -- B · LA PERTENENCIA: el centro de TODO cero está en el espectro
    ((ctr₉ z.ρ (1 - z.ρ) = 1/2) ∧
     ((ctr₉ z.ρ (1 - z.ρ)).re = (Omega_hat ⟨0, by norm_num⟩).re) ∧
     (∀ σ : ℂ, ctr₉ z.ρ (1 - z.ρ) = ctr₉ σ (1 - σ))) ∧
    -- y su valuación es −λ, que NO es entera
    ((valPhi ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ))) =
        -(Real.log 2 / Real.log (φ : ℝ))) ∧
     (¬ ∃ i : ℤ, (φ : ℝ) ^ i = 2)) ∧
    -- C · LA VALUACIÓN: el hueco es la integralidad de v
    (((∃ j : ℤ, zeroCoord z.ρ = (φ : ℝ) ^ j) ↔
        ∃ j : ℤ, valPhi (zeroCoord z.ρ) = (j : ℝ)) ∧
     (valPhi ((zeroCoord z.ρ) ^ p) = (p : ℝ) * valPhi (zeroCoord z.ρ)) ∧
     (valPhi (zeroCoord z.ρ) = 0 ↔ z.ρ.re = 1/2)) :=
  ⟨⟨phi_eq_two_cos_pi_fifth, lucas_fib_norm k, (trace_integral_iff_even k).1⟩,
   ⟨G_hom a b ha hb, kernel_two_and_four_fibres.1, kernel_two_and_four_fibres.2⟩,
   ⟨the_centre_is_fixed_for_every_zero z.ρ,
    orbit_centre_is_in_the_spectrum z.ρ,
    fun σ => centre_independent_of_the_zero z.ρ σ⟩,
   ⟨the_anchor_has_valuation_minus_lambda, lambda_is_not_an_integer⟩,
   ⟨monomial_iff_valPhi_int (zeroCoord z.ρ) hpos,
    the_power_becomes_multiplication (zeroCoord z.ρ) p,
    degenerate_iff_valuation_zero z.ρ h0 h1⟩⟩

theorem two_levels_one_lattice (z : Chi5Zero) (hpos : 0 < zeroCoord z.ρ)
    (h0 : 0 < z.ρ.re) (h1 : z.ρ.re < 1) :
    -- NIVEL DEL CENTRO: valuación −λ, FIJA, NO entera, para todo cero
    ((ctr₉ z.ρ (1 - z.ρ) = 1/2) ∧
     (¬ ∃ i : ℤ, (φ : ℝ) ^ i = 2)) ∧
    -- NIVEL DE LA COORDENADA: valuación v, y v = 0 syss E
    ((valPhi (zeroCoord z.ρ) = 0 ↔ z.ρ.re = 1/2) ∧
     ((∃ j : ℤ, zeroCoord z.ρ = (φ : ℝ) ^ j) ↔
        ∃ j : ℤ, valPhi (zeroCoord z.ρ) = (j : ℝ))) :=
  ⟨⟨the_centre_is_fixed_for_every_zero z.ρ, lambda_is_not_an_integer⟩,
   ⟨degenerate_iff_valuation_zero z.ρ h0 h1,
    monomial_iff_valPhi_int (zeroCoord z.ρ) hpos⟩⟩

theorem the_radius_is_the_deviation (ρ : ℂ) :
    ((rad₉ ρ (1 - ρ)).re = ρ.re - 1/2) ∧
    (ctr₉ ρ (1 - ρ) = 1/2) ∧
    ((rad₉ ρ (1 - ρ)).re = 0 ↔ ρ.re = 1/2) :=
  ⟨radius_re_is_re_minus_half ρ, the_centre_is_fixed_for_every_zero ρ,
   orbit_radius_vanishes_iff_E ρ⟩

theorem the_radius_and_the_valuation_vanish_together (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) :
    ((rad₉ ρ (1 - ρ)).re = 0 ↔ valPhi (zeroCoord ρ) = 0) := by
  rw [orbit_radius_vanishes_iff_E ρ, degenerate_iff_valuation_zero ρ h0 h1]

theorem the_centre_speaks_of_the_coordinate (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) :
    -- el centro está en el espectro y vale 1/2
    (((ctr₉ ρ (1 - ρ)).re = (Omega_hat ⟨0, by norm_num⟩).re) ∧
     (ctr₉ ρ (1 - ρ) = 1/2)) ∧
    -- el radio es la DESVIACIÓN respecto de ese centro
    ((rad₉ ρ (1 - ρ)).re = ρ.re - 1/2) ∧
    -- y la valuación se anula EN EL MISMO PUNTO que el radio
    (((rad₉ ρ (1 - ρ)).re = 0 ↔ valPhi (zeroCoord ρ) = 0) ∧
     (valPhi (zeroCoord ρ) = 0 ↔ ρ.re = 1/2) ∧
     (zeroCoord ρ = 1 ↔ ρ.re = 1/2)) :=
  ⟨⟨orbit_centre_is_in_the_spectrum ρ, the_centre_is_fixed_for_every_zero ρ⟩,
   radius_re_is_re_minus_half ρ,
   ⟨the_radius_and_the_valuation_vanish_together ρ h0 h1,
    degenerate_iff_valuation_zero ρ h0 h1,
    coord_eq_one_iff_re_half ρ h0⟩⟩

theorem the_three_meet_at_the_real_part (z : Chi5Zero) (k : Fin 3)
    (hk : 0 < (Omega_hat k).re) (hγ : z.ρ.im ≠ 0)
    (h0 : 0 < z.ρ.re) (h1 : z.ρ.re < 1) (hpos : 0 < zeroCoord z.ρ) :
    -- el ESPECTRO fija el valor
    (((Omega_hat k).re = 1/2) ∧
     ((ctr₉ z.ρ (1 - z.ρ)).re = (Omega_hat ⟨0, by norm_num⟩).re)) ∧
    -- el RADIO mide la desviación desde él
    (((rad₉ z.ρ (1 - z.ρ)).re = z.ρ.re - 1/2) ∧
     ((rad₉ z.ρ (1 - z.ρ)).re = 0 ↔ z.ρ.re = 1/2)) ∧
    -- la VALUACIÓN se anula en el mismo punto, y ahí es entera
    ((valPhi (zeroCoord z.ρ) = 0 ↔ z.ρ.re = 1/2) ∧
     ((rad₉ z.ρ (1 - z.ρ)).re = 0 ↔ valPhi (zeroCoord z.ρ) = 0) ∧
     ((∃ j : ℤ, zeroCoord z.ρ = (φ : ℝ) ^ j) ↔
        ∃ j : ℤ, valPhi (zeroCoord z.ρ) = (j : ℝ))) ∧
    -- y la órbita colapsa ahí mismo
    ((1 - (starRingEnd ℂ) z.ρ = z.ρ) ↔ z.ρ.re = 1/2) :=
  ⟨⟨operator_spectrum_positivity_forces_half k hk,
    orbit_centre_is_in_the_spectrum z.ρ⟩,
   ⟨radius_re_is_re_minus_half z.ρ, orbit_radius_vanishes_iff_E z.ρ⟩,
   ⟨degenerate_iff_valuation_zero z.ρ h0 h1,
    the_radius_and_the_valuation_vanish_together z.ρ h0 h1,
    monomial_iff_valPhi_int (zeroCoord z.ρ) hpos⟩,
   the_orbit_collapses_iff_on_the_line z.ρ hγ⟩

theorem the_valuation_is_below_one_under_confinement (r : ℝ)
    (hlo : Real.sqrt 3 / 2 ≤ r) (hhi : r ≤ 2 / Real.sqrt 3) :
    ((φ : ℝ) ^ (-1 : ℤ) < r) ∧ (r < (φ : ℝ) ^ (1 : ℤ)) :=
  confinement_pins_the_leading_digit r hlo hhi

theorem an_integer_below_one_in_absolute_value_is_zero (v : ℝ) (k : ℤ)
    (hv : v = (k : ℝ)) (hlt : |v| < 1) : v = 0 := by
  have hk : |(k : ℝ)| < 1 := by rw [← hv]; exact hlt
  have : k = 0 := by
    by_contra h
    have h1 : (1 : ℝ) ≤ |(k : ℝ)| := by
      have : (1 : ℤ) ≤ |k| := Int.one_le_abs (by omega)
      calc (1 : ℝ) = ((1 : ℤ) : ℝ) := by norm_num
        _ ≤ ((|k| : ℤ) : ℝ) := by exact_mod_cast this
        _ = |(k : ℝ)| := by push_cast [Int.cast_abs]; rfl
    linarith
  rw [hv, this]; norm_num

theorem gap_five_closes_under_the_confinement (ρ : ℂ)
    (hpos : 0 < zeroCoord ρ) (h0 : 0 < ρ.re) (h1 : ρ.re < 1)
    (hlo : Real.sqrt 3 / 2 ≤ zeroCoord ρ) (hhi : zeroCoord ρ ≤ 2 / Real.sqrt 3)
    (hmon : ∃ k : ℤ, zeroCoord ρ = (φ : ℝ) ^ k) :
    ρ.re = 1/2 := by
  obtain ⟨k, hk⟩ := hmon
  have hb := confinement_pins_the_leading_digit (zeroCoord ρ) hlo hhi
  have hk0 : k = 0 := by
    rcases lt_trichotomy k 0 with h | h | h
    · exfalso
      have : zeroCoord ρ ≤ (φ : ℝ) ^ (-1 : ℤ) := by
        rw [hk]; exact zpow_le_zpow_right₀ (le_of_lt φ_gt_one) (by omega)
      linarith [hb.1]
    · exact h
    · exfalso
      have : (φ : ℝ) ^ (1 : ℤ) ≤ zeroCoord ρ := by
        rw [hk]; exact zpow_le_zpow_right₀ (le_of_lt φ_gt_one) (by omega)
      linarith [hb.2]
  have : zeroCoord ρ = 1 := by rw [hk, hk0]; norm_num
  exact (coord_eq_one_iff_re_half ρ h0).mp this

theorem what_this_implies_for_the_two_gaps (ρ : ℂ) (p : ℕ)
    (hpos : 0 < zeroCoord ρ) (h0 : 0 < ρ.re) (h1 : ρ.re < 1)
    (hlo : Real.sqrt 3 / 2 ≤ zeroCoord ρ) (hhi : zeroCoord ρ ≤ 2 / Real.sqrt 3) :
    -- el confinamiento mete la coordenada dentro de un escalón de φ
    (((φ : ℝ) ^ (-1 : ℤ) < zeroCoord ρ) ∧ (zeroCoord ρ < (φ : ℝ) ^ (1 : ℤ))) ∧
    -- ⟹ HUECO 5: si es monomio, el exponente es CERO y sale E
    ((∃ k : ℤ, zeroCoord ρ = (φ : ℝ) ^ k) → ρ.re = 1/2) ∧
    -- ⟹ HUECO 7: y entonces p·v = 0 también, la acción es TRIVIAL ahí
    ((valPhi (zeroCoord ρ) = 0 → valPhi ((zeroCoord ρ) ^ p) = 0)) ∧
    -- el radio se anula en el mismo punto
    (((rad₉ ρ (1 - ρ)).re = 0 ↔ valPhi (zeroCoord ρ) = 0)) := by
  refine ⟨confinement_pins_the_leading_digit (zeroCoord ρ) hlo hhi,
          fun hm => gap_five_closes_under_the_confinement ρ hpos h0 h1 hlo hhi hm,
          fun hv => ?_,
          the_radius_and_the_valuation_vanish_together ρ h0 h1⟩
  rw [the_power_becomes_multiplication (zeroCoord ρ) p, hv, mul_zero]

theorem the_existential_ranges_over_a_singleton (r : ℝ) (hr : 0 < r)
    (hle : discP r ≤ 1/12) :
    ((∃ k : ℤ, r = (φ : ℝ) ^ k) ↔ r = 1) ∧
    (∀ k : ℤ, k ≠ 0 → (1:ℝ) ≤ discP ((φ : ℝ) ^ k)) :=
  ⟨monomial_iff_one_under_confinement r hr hle,
   fun k hk => arithmetic_lives_in_the_family k hk⟩

theorem assuming_the_monoid_is_assuming_E (ρ : ℂ)
    (hpos : 0 < zeroCoord ρ) (hle : discP (zeroCoord ρ) ≤ 1/12)
    (h0 : 0 < ρ.re) :
    (IsMonomial (zeroCoord ρ) ↔ ρ.re = 1/2) ∧
    ((∃ k : ℤ, zeroCoord ρ = (φ : ℝ) ^ k) ↔ zeroCoord ρ = 1) :=
  ⟨descending_to_F1_is_E ρ hpos hle h0,
   monomial_iff_one_under_confinement (zeroCoord ρ) hpos hle⟩

theorem the_action_is_also_E (h : NoLowZeros) :
    ((ZeroCoordsCarryPowerAction → ∀ z : Chi5Zero, z.ρ.re = 1/2)) ∧
    ((∀ z : Chi5Zero, z.ρ.re = 1/2) → ZeroCoordsCarryPowerAction) :=
  ⟨fun hB z => B_gives_E_one_hypothesis h hB z,
   fun hE => E_constructs_the_power_action hE⟩

theorem both_entrances_are_E (ρ : ℂ) (h : NoLowZeros)
    (hpos : 0 < zeroCoord ρ) (hle : discP (zeroCoord ρ) ≤ 1/12)
    (h0 : 0 < ρ.re) :
    -- ENTRADA A: el monoide. El ∃k recorre un SINGLETÓN
    ((IsMonomial (zeroCoord ρ) ↔ ρ.re = 1/2) ∧
     ((∃ k : ℤ, zeroCoord ρ = (φ : ℝ) ^ k) ↔ zeroCoord ρ = 1)) ∧
    -- ENTRADA B: la acción. Las DOS direcciones
    (((ZeroCoordsCarryPowerAction → ∀ z : Chi5Zero, z.ρ.re = 1/2)) ∧
     ((∀ z : Chi5Zero, z.ρ.re = 1/2) → ZeroCoordsCarryPowerAction)) ∧
    -- ⟹ NINGUNA de las dos es más débil que E
    (∀ k : ℤ, k ≠ 0 → (1:ℝ) ≤ discP ((φ : ℝ) ^ k)) :=
  ⟨⟨descending_to_F1_is_E ρ hpos hle h0,
    monomial_iff_one_under_confinement (zeroCoord ρ) hpos hle⟩,
   ⟨fun hB z => B_gives_E_one_hypothesis h hB z,
    fun hE => E_constructs_the_power_action hE⟩,
   fun k hk => arithmetic_lives_in_the_family k hk⟩

theorem the_apex_is_produced_without_zeros :
    -- de la ecuación cuadrática del operador
    (∀ x : ℝ, x ^ 2 - 2 * x + 3/4 = 0 ↔ (x = 1/2 ∨ x = 3/2)) ∧
    -- del ancla φ^(−λ)
    ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = 1/2) ∧
    -- del núcleo de Galois
    ((1:ℝ) / 2 = 1/2) ∧
    -- de la órbita ternaria
    (Real.cos (Real.pi / 3) = mu_n_param 3) ∧
    -- del factor arquimediano
    (Real.Gamma (3/2) / Real.sqrt Real.pi = 1/2) ∧
    -- y del espectro del operador
    ((Omega_hat ⟨0, by norm_num⟩).re = 1/2) :=
  ⟨apex_pair_is_unique, anchor_is_the_spectral_scale, rfl,
   cos_pi_third_eq_mu3, apex_through_gamma.2,
   embedding_target_is_the_orbit_shadow.1⟩

theorem the_line_is_the_apex_not_an_input (s : ℂ) :
    -- la línea ES el lugar fijo de la involución
    ((s.re = (1 - s).re ↔ s.re = 1/2)) ∧
    -- y ese 1/2 lo produce el cocono, sin ceros
    (((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = 1/2) ∧
     (Real.Gamma (3/2) / Real.sqrt Real.pi = 1/2) ∧
     ((Omega_hat ⟨0, by norm_num⟩).re = 1/2)) :=
  ⟨fixed_locus_is_the_line s,
   ⟨anchor_is_the_spectral_scale, apex_through_gamma.2,
    embedding_target_is_the_orbit_shadow.1⟩⟩

theorem what_E_actually_says (z : Chi5Zero) (h : NoLowZeros)
    (hpos : 0 < zeroCoord z.ρ) (hle : discP (zeroCoord z.ρ) ≤ 1/12) :
    -- el cocono produce el ápice SIN mirar ningún cero
    ((∀ x : ℝ, x ^ 2 - 2 * x + 3/4 = 0 ↔ (x = 1/2 ∨ x = 3/2)) ∧
     ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = 1/2) ∧
     (Real.cos (Real.pi / 3) = mu_n_param 3)) ∧
    -- el centro de la órbita de TODO cero cae en ese ápice, incondicional
    (((ctr₉ z.ρ (1 - z.ρ)).re = (Omega_hat ⟨0, by norm_num⟩).re) ∧
     (ctr₉ z.ρ (1 - z.ρ) = 1/2)) ∧
    -- y E dice que el CERO cae ahí también, no sólo su centro
    ((IsMonomial (zeroCoord z.ρ) ↔ z.ρ.re = 1/2) ∧
     ((ZeroCoordsCarryPowerAction → ∀ w : Chi5Zero, w.ρ.re = 1/2))) :=
  ⟨⟨apex_pair_is_unique, anchor_is_the_spectral_scale, cos_pi_third_eq_mu3⟩,
   ⟨orbit_centre_is_in_the_spectrum z.ρ,
    the_centre_is_fixed_for_every_zero z.ρ⟩,
   ⟨descending_to_F1_is_E z.ρ hpos hle z.in_strip_pos,
    fun hB w => B_gives_E_one_hypothesis h hB w⟩⟩

theorem the_zeros_leg_delivers_the_centre (z : Chi5Zero) (s : ℂ) :
    -- lo que la pata de los ceros APORTA al ápice, incondicional
    ((ctr₉ z.ρ (1 - z.ρ) = 1/2) ∧
     (s.re = (1 - s).re ↔ s.re = 1/2) ∧
     ((ctr₉ z.ρ (1 - z.ρ)).re = (Omega_hat ⟨0, by norm_num⟩).re)) ∧
    -- y lo que NO aporta: la posición del cero, que es el RADIO
    (((rad₉ z.ρ (1 - z.ρ)).re = z.ρ.re - 1/2) ∧
     ((rad₉ z.ρ (1 - z.ρ)).re = 0 ↔ z.ρ.re = 1/2)) :=
  ⟨zeros_enter_the_cocone_by_the_involution z s,
   ⟨radius_re_is_re_minus_half z.ρ, orbit_radius_vanishes_iff_E z.ρ⟩⟩

theorem the_apex_receives_from_five_legs_including_the_zeros
    (z : Chi5Zero) (s : ℂ) (k : Fin 3) (hw : Complex.abs w_pcf = 1) :
    -- PRIMOS
    (((2:ℝ) - 3/2 = 1/2) ∧ ((1:ℝ) / (ZtwentyStar.card : ℝ) = 1/8)) ∧
    -- CEROS, por la involución — NO son externos
    ((ctr₉ z.ρ (1 - z.ρ) = 1/2) ∧ (s.re = (1 - s).re ↔ s.re = 1/2)) ∧
    -- OPERADOR
    (((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = ‖Omega_hat 0‖) ∧
     ((3:ℝ)/2 + 1/2 = 2)) ∧
    -- MONOIDE
    (((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = 1/2) ∧
     (¬ ∃ i : ℤ, (φ : ℝ) ^ i = 2)) ∧
    -- ARQUIMEDIANO
    ((Real.Gamma (3/2) / Real.sqrt Real.pi = 1/2) ∧
     (Real.cos (Real.pi / 3) = mu_n_param 3)) :=
  five_domains_five_legs_one_apex z s k hw

theorem what_the_zeros_leg_still_owes (z : Chi5Zero)
    (h0 : 0 < z.ρ.re) (h1 : z.ρ.re < 1) (hpos : 0 < zeroCoord z.ρ) :
    -- ENTREGADO: el centro, incondicional
    ((ctr₉ z.ρ (1 - z.ρ) = 1/2) ∧
     ((ctr₉ z.ρ (1 - z.ρ)).re = (Omega_hat ⟨0, by norm_num⟩).re)) ∧
    -- PENDIENTE: que el radio se anule, que es donde vive E
    (((rad₉ z.ρ (1 - z.ρ)).re = 0 ↔ z.ρ.re = 1/2) ∧
     ((rad₉ z.ρ (1 - z.ρ)).re = 0 ↔ valPhi (zeroCoord z.ρ) = 0) ∧
     (valPhi (zeroCoord z.ρ) = 0 ↔ z.ρ.re = 1/2)) :=
  ⟨⟨the_centre_is_fixed_for_every_zero z.ρ,
    orbit_centre_is_in_the_spectrum z.ρ⟩,
   ⟨orbit_radius_vanishes_iff_E z.ρ,
    the_radius_and_the_valuation_vanish_together z.ρ h0 h1,
    degenerate_iff_valuation_zero z.ρ h0 h1⟩⟩

theorem nothing_here_is_a_free_parameter (ρ : ℂ) (hρ : ρ ≠ 0)
    (x : ℝ) (hx : 0 < x) (heq : x ^ 2 = x + 1) :
    -- φ está DETERMINADO por su ecuación
    (x = φ) ∧
    -- el 20 está DETERMINADO: lcm del período de i y del pentágono
    ((Complex.I ^ 4 = 1) ∧ (Nat.lcm 4 5 = 20) ∧ ((φ : ℝ) = 2 * Real.cos (Real.pi / 5))) ∧
    -- Z₂₀* y χ₅ están DETERMINADOS por el 20
    ((ZtwentyStar.card = 8) ∧ (({1, 9} : Finset ℕ).card = 2)) ∧
    -- la coordenada es una FUNCIÓN de ρ, no un parámetro
    (zeroCoord ρ = Complex.abs (ρ - 1) / Complex.abs ρ) ∧
    -- y valPhi es una FUNCIÓN de la coordenada y de φ
    (valPhi (zeroCoord ρ) = Real.log (zeroCoord ρ) / Real.log (φ : ℝ)) :=
  ⟨golden_fixed_point_unique x hx heq,
   ⟨I_pow_four, kernel_two_and_four_fibres.2, phi_eq_two_cos_pi_fifth⟩,
   ⟨kernel_two_and_four_fibres.1, every_fibre_has_the_kernel_size.1⟩,
   the_coordinate_is_a_ratio_of_distances ρ hρ,
   rfl⟩

theorem the_exponent_is_computed_not_chosen (r : ℝ) (hr : 0 < r) (k : ℤ)
    (hk : r = (φ : ℝ) ^ k) :
    valPhi r = (k : ℝ) := by
  rw [hk, valPhi_realise]

theorem the_existential_has_only_one_candidate (r : ℝ) (hr : 0 < r) :
    ((∃ k : ℤ, r = (φ : ℝ) ^ k) ↔ ∃ k : ℤ, valPhi r = (k : ℝ)) ∧
    (∀ k : ℤ, r = (φ : ℝ) ^ k → valPhi r = (k : ℝ)) :=
  ⟨monomial_iff_valPhi_int r hr,
   fun k hk => the_exponent_is_computed_not_chosen r hr k hk⟩

theorem the_whole_chain_is_determined (ρ : ℂ) (hρ : ρ ≠ 0)
    (x : ℝ) (hx : 0 < x) (heq : x ^ 2 = x + 1) (hpos : 0 < zeroCoord ρ) :
    -- φ ← su ecuación;  20 ← lcm(4,5);  Z₂₀* ← el 20;  χ₅ ← Z₂₀*
    ((x = φ) ∧ (Nat.lcm 4 5 = 20) ∧ (ZtwentyStar.card = 8)) ∧
    -- coord ← ρ;  valPhi ← coord y φ
    ((zeroCoord ρ = Complex.abs (ρ - 1) / Complex.abs ρ) ∧
     (valPhi (zeroCoord ρ) = Real.log (zeroCoord ρ) / Real.log (φ : ℝ))) ∧
    -- el exponente NO se elige: si existe, ES valPhi
    ((∀ k : ℤ, zeroCoord ρ = (φ : ℝ) ^ k → valPhi (zeroCoord ρ) = (k : ℝ))) ∧
    -- ⟹ el único contenido es si ESE número ya determinado es entero
    ((∃ k : ℤ, zeroCoord ρ = (φ : ℝ) ^ k) ↔
       ∃ k : ℤ, valPhi (zeroCoord ρ) = (k : ℝ)) :=
  ⟨⟨golden_fixed_point_unique x hx heq, kernel_two_and_four_fibres.2,
    kernel_two_and_four_fibres.1⟩,
   ⟨the_coordinate_is_a_ratio_of_distances ρ hρ, rfl⟩,
   fun k hk => the_exponent_is_computed_not_chosen (zeroCoord ρ) hpos k hk,
   monomial_iff_valPhi_int (zeroCoord ρ) hpos⟩

theorem pi_enters_by_four_doors (n : ℝ) (k : Fin 3) :
    -- 1. por el EXPONENTE: las raíces de la unidad
    ((w_pcf ^ 3 = 1) ∧ (Complex.I ^ 4 = 1)) ∧
    -- 2. por el COSENO: φ con π/5, el ápice con π/3
    (((φ : ℝ) = 2 * Real.cos (Real.pi / 5)) ∧
     (Real.cos (Real.pi / 3) = mu_n_param 3)) ∧
    -- 3. por Γ: la raíz cuadrada
    ((Real.Gamma (1/2) = Real.sqrt Real.pi) ∧
     (Real.Gamma (3/2) / Real.sqrt Real.pi = 1/2)) ∧
    -- 4. por el OPERADOR: T* es lineal en π
    (T_star n = c_spectral n * Real.pi * n / Real.log (μ_PCF * n + σ_PCF)) :=
  ⟨⟨the_chain_three_two_one.1.1, I_pow_four⟩,
   ⟨phi_eq_two_cos_pi_fifth, cos_pi_third_eq_mu3⟩,
   ⟨identification_gamma_face, apex_through_gamma.2⟩,
   T_star_unfolds n⟩

theorem the_radius_splits_pi_and_phi (ρ : ℂ) (n : ℝ) :
    -- la parte REAL del radio: la desviación, SIN π explícito
    ((rad₉ ρ (1 - ρ)).re = ρ.re - 1/2) ∧
    -- pero el punto donde se anula ES el ápice, que viene de π/3 y de φ^(−λ)
    ((Real.cos (Real.pi / 3) = mu_n_param 3) ∧
     ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = 1/2)) ∧
    -- la parte IMAGINARIA del radio: la ordenada ENTERA
    ((rad₉ ρ (1 - ρ)).im = ρ.im) ∧
    -- y la ordenada es lo que T* aproxima, con π DENTRO
    (T_star n = c_spectral n * Real.pi * n / Real.log (μ_PCF * n + σ_PCF)) :=
  ⟨radius_re_is_re_minus_half ρ,
   ⟨cos_pi_third_eq_mu3, anchor_is_the_spectral_scale⟩,
   (the_radius_carries_the_whole_ordinate ρ).1,
   T_star_unfolds n⟩

theorem pi_and_phi_meet_at_the_apex :
    (Real.cos (Real.pi / 3) = mu_n_param 3) ∧
    ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = 1/2) ∧
    (Real.Gamma (3/2) / Real.sqrt Real.pi = 1/2) ∧
    ((φ : ℝ) = 2 * Real.cos (Real.pi / 5)) :=
  ⟨cos_pi_third_eq_mu3, anchor_is_the_spectral_scale,
   apex_through_gamma.2, phi_eq_two_cos_pi_fifth⟩

theorem the_two_coordinates_of_the_radius (z : Chi5Zero) (n : ℝ)
    (h0 : 0 < z.ρ.re) (h1 : z.ρ.re < 1) :
    -- RE: se anula en el ápice, donde π/3 y φ^(−λ) COINCIDEN
    (((rad₉ z.ρ (1 - z.ρ)).re = z.ρ.re - 1/2) ∧
     ((rad₉ z.ρ (1 - z.ρ)).re = 0 ↔ z.ρ.re = 1/2) ∧
     (Real.cos (Real.pi / 3) = mu_n_param 3) ∧
     ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = 1/2)) ∧
    -- IM: lleva la ordenada entera, y T* la aproxima con π lineal
    (((rad₉ z.ρ (1 - z.ρ)).im = z.ρ.im) ∧
     ((ctr₉ z.ρ (1 - z.ρ)).im = 0) ∧
     (T_star n = c_spectral n * Real.pi * n / Real.log (μ_PCF * n + σ_PCF))) ∧
    -- y la valuación se anula con la parte real, no con la imaginaria
    (((rad₉ z.ρ (1 - z.ρ)).re = 0 ↔ valPhi (zeroCoord z.ρ) = 0)) :=
  ⟨⟨radius_re_is_re_minus_half z.ρ, orbit_radius_vanishes_iff_E z.ρ,
    cos_pi_third_eq_mu3, anchor_is_the_spectral_scale⟩,
   ⟨(the_radius_carries_the_whole_ordinate z.ρ).1,
    (the_radius_carries_the_whole_ordinate z.ρ).2,
    T_star_unfolds n⟩,
   the_radius_and_the_valuation_vanish_together z.ρ h0 h1⟩

theorem the_hypothesis_links_everything (z : Chi5Zero) (n : ℝ) (k : Fin 3)
    (hρ : z.ρ ≠ 0) (hpos : 0 < zeroCoord z.ρ)
    (h0 : 0 < z.ρ.re) (h1 : z.ρ.re < 1) (hγ : 2 ≤ |z.ρ.im|)
    (hw : Complex.abs w_pcf = 1) :
    -- LA HIPÓTESIS, en sus dos formas
    (((∃ j : ℤ, zeroCoord z.ρ = (φ : ℝ) ^ j) ↔
        ∃ j : ℤ, valPhi (zeroCoord z.ρ) = (j : ℝ))) ∧
    -- + EL CONFINAMIENTO, que sale de la ALTURA sola
    ((discP (zeroCoord z.ρ) ≤ 1/12) ∧
     ((∃ j : ℤ, zeroCoord z.ρ = (φ : ℝ) ^ j) ↔ zeroCoord z.ρ = 1)) ∧
    -- ⟹ APOLONIO: coord = 1 es la EQUIDISTANCIA, el círculo degenerado
    ((Complex.abs (z.ρ - 1) = Complex.abs z.ρ ↔ zeroCoord z.ρ = 1) ∧
     (Complex.abs (z.ρ - 1) = Complex.abs z.ρ ↔ z.ρ.re = 1/2)) ∧
    -- ⟹ EL RADIO se anula, y el CENTRO ya estaba en el espectro
    (((rad₉ z.ρ (1 - z.ρ)).re = 0 ↔ z.ρ.re = 1/2) ∧
     ((ctr₉ z.ρ (1 - z.ρ)).re = (Omega_hat ⟨0, by norm_num⟩).re) ∧
     ((rad₉ z.ρ (1 - z.ρ)).im = z.ρ.im)) ∧
    -- π y φ COINCIDEN en el punto donde la parte real se anula
    ((Real.cos (Real.pi / 3) = mu_n_param 3) ∧
     ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = 1/2) ∧
     (Complex.abs (Omega_hat k) = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ)))) ∧
    -- y π mide la ordenada por T*, que el radio lleva entera
    ((T_star n = c_spectral n * Real.pi * n / Real.log (μ_PCF * n + σ_PCF)) ∧
     ((ctr₉ z.ρ (1 - z.ρ)).im = 0)) ∧
    -- ⟹ E₁, y de ahí E₃ ⟺ E₄
    ((IsMonomial (zeroCoord z.ρ) ↔ z.ρ.re = 1/2) ∧
     ((∀ w : Chi5Zero, w.ρ.re = 1/2) ↔ ConjectureE)) := by
  have hle := discBound_of_high_gamma z.ρ h0 h1 hγ
  exact ⟨monomial_iff_valPhi_int (zeroCoord z.ρ) hpos,
         ⟨hle, monomial_iff_one_under_confinement (zeroCoord z.ρ) hpos hle⟩,
         ⟨equidistance_is_the_critical_line z.ρ hρ,
          apollonius_degenerates_at_ratio_one z.ρ hρ⟩,
         ⟨orbit_radius_vanishes_iff_E z.ρ,
          orbit_centre_is_in_the_spectrum z.ρ,
          (the_radius_carries_the_whole_ordinate z.ρ).1⟩,
         ⟨cos_pi_third_eq_mu3, anchor_is_the_spectral_scale,
          spectrum_modulus_is_the_anchor k hw⟩,
         ⟨T_star_unfolds n, (the_radius_carries_the_whole_ordinate z.ρ).2⟩,
         ⟨descending_to_F1_is_E z.ρ hpos hle z.in_strip_pos,
          ⟨E3_gives_E4, E4_gives_E3⟩⟩⟩

theorem what_the_gue_side_adds (ρ : ℂ) (h : ρ.re ≠ 1/2) (r : ℝ) (hr : 0 < r)
    (q T : ℝ) (hq : 0 < q) (hT : 0 < T) :
    -- DEMOSTRADO: órbita libre ⟹ ordenada DOBLADA
    ((kleinPartner ρ ≠ ρ) ∧ ((kleinPartner ρ).im = ρ.im)) ∧
    -- DEMOSTRADO: el exceso se anula syss r = 1
    (((r - 1) + (1/r - 1) = 0) ↔ r = 1) ∧
    -- DEMOSTRADO: la envolvente se parte en dos caras
    (Real.log (q * T / (2 * Real.pi * Real.exp 1))
       = Real.log q + Real.log T - Real.log (2 * Real.pi * Real.exp 1)) :=
  ⟨⟨(free_orbit_doubles_ordinate ρ h).1, (free_orbit_doubles_ordinate ρ h).2.1⟩, excess_zero_iff r hr,
   envelope_splits q T hq hT⟩

theorem the_eight_classes_split_four_and_four :
    (∀ a : ZMod 20, a ∈ ZtwentyStar → (chi5 a = 1 ↔ (a = 3 ∨ a = 7 ∨ a = 13 ∨ a = 17))) ∧
    (ZtwentyStar.card = 8) ∧
    (({3, 7, 13, 17} : Finset ℕ).card = 4) ∧
    (({1, 9, 11, 19} : Finset ℕ).card = 4) := by
  refine ⟨fun a ha => euler_dichotomy_is_orbit_dichotomy.1 a ha,
          kernel_two_and_four_fibres.1, by decide, by decide⟩

theorem the_splitting_type_reaches_the_integers (p : ℕ) (hp : p.Prime) (k : ℕ) :
    -- Lucas y Fibonacci ligados por la forma norma de Q(√5)
    ((lucasN k : ℤ) ^ 2 - 5 * (Nat.fib k : ℤ) ^ 2 = 4 * (-1) ^ k) ∧
    -- y φ es la unidad fundamental de ese cuerpo
    ((φ : ℝ) ^ 2 = (φ : ℝ) + 1) ∧
    ((φ : ℝ) = 2 * Real.cos (Real.pi / 5)) ∧
    -- los primos > 5 caen en las ocho clases
    (5 < p → (p : ZMod 20) ∈ ZtwentyStar) :=
  ⟨lucas_fib_norm k, phi_sq, phi_eq_two_cos_pi_fifth,
   fun h => primes_land_in_ZtwentyStar p hp h⟩

theorem phi_organises_the_euler_product (a b : ZMod 20)
    (ha : a ∈ ZtwentyStar) (hb : b ∈ ZtwentyStar) (k : ℕ) :
    -- las OCHO clases, partidas 4 + 4 por el tipo de escisión en Q(√5)
    ((chi5 a = 1 ↔ (a = 3 ∨ a = 7 ∨ a = 13 ∨ a = 17)) ∧
     (ZtwentyStar.card = 8) ∧
     (({3, 7, 13, 17} : Finset ℕ).card = 4)) ∧
    -- χ₅ es MULTIPLICATIVO: el producto de Euler factoriza
    ((G (a * b) = G a + G b) ∧ (a * b ∈ ZtwentyStar)) ∧
    -- φ es la unidad fundamental del cuerpo que clasifica
    (((φ : ℝ) ^ 2 = (φ : ℝ) + 1) ∧
     ((lucasN k : ℤ) ^ 2 - 5 * (Nat.fib k : ℤ) ^ 2 = 4 * (-1) ^ k)) ∧
    -- y la ecuación funcional de la L así construida, sin hipótesis
    (FunctionalEquation (DirichletCharacter.LFunction chi5_D)) := by
  refine ⟨⟨euler_dichotomy_is_orbit_dichotomy.1 a ha,
           kernel_two_and_four_fibres.1, by decide⟩,
          ⟨G_hom a b ha hb, mul_closed a ha b hb⟩,
          ⟨phi_sq, lucas_fib_norm k⟩,
          functionalEquation_chi5⟩

theorem phi_is_not_foreign_to_the_product (z : Chi5Zero) (a : ZMod 20)
    (ha : a ∈ ZtwentyStar) (k : Fin 3) (hw : Complex.abs w_pcf = 1)
    (hpos : 0 < zeroCoord z.ρ) :
    -- el producto de Euler está indexado por la escisión en Q(√5) = el cuerpo de φ
    ((chi5 a = 1 ↔ (a = 3 ∨ a = 7 ∨ a = 13 ∨ a = 17)) ∧
     ((φ : ℝ) ^ 2 = (φ : ℝ) + 1)) ∧
    -- la coordenada del cero es una RAZÓN, y valPhi su log en base φ
    ((zeroCoord z.ρ = Complex.abs (z.ρ - 1) / Complex.abs z.ρ) ∧
     ((∃ j : ℤ, zeroCoord z.ρ = (φ : ℝ) ^ j) ↔
        ∃ j : ℤ, valPhi (zeroCoord z.ρ) = (j : ℝ))) ∧
    -- y el ancla liga el monoide con el espectro
    ((Complex.abs (Omega_hat k) = (φ : ℝ) ^ (-(Real.log 2 / Real.log φ))) ∧
     ((φ : ℝ) ^ (-(Real.log 2 / Real.log φ)) = 1/2)) := by
  refine ⟨⟨euler_dichotomy_is_orbit_dichotomy.1 a ha, phi_sq⟩,
          ⟨the_coordinate_is_a_ratio_of_distances z.ρ ?_,
           monomial_iff_valPhi_int (zeroCoord z.ρ) hpos⟩,
          ⟨spectrum_modulus_is_the_anchor k hw, anchor_is_the_spectral_scale⟩⟩
  intro h
  have := z.in_strip_pos
  rw [h] at this; simp at this

theorem phi_is_defined_by_a_reciprocity :
    ((φ : ℝ)⁻¹ = (φ : ℝ) - 1) ∧
    ((φ : ℝ) ^ 2 = (φ : ℝ) + 1) ∧
    (∀ x : ℝ, 0 < x → x ^ 2 = x + 1 → x = φ) :=
  ⟨phi_inv_eq, phi_sq, fun x hx heq => golden_fixed_point_unique x hx heq⟩

theorem the_functional_equation_is_the_same_translation (s : ℂ) :
    (s.re = (1 - s).re ↔ s.re = 1/2) ∧
    ((φ : ℝ)⁻¹ = (φ : ℝ) - 1) ∧
    (FunctionalEquation (DirichletCharacter.LFunction chi5_D)) :=
  ⟨fixed_locus_is_the_line s, phi_inv_eq, functionalEquation_chi5⟩

theorem one_is_the_only_self_reciprocal (r : ℝ) (hr : 0 < r) :
    (r = 1 / r ↔ r = 1) := by
  constructor
  · intro h
    have h2 : r * r = 1 := by field_simp at h; nlinarith [h]
    nlinarith [h2, hr]
  · intro h; rw [h]; norm_num

theorem the_reciprocal_chain (z : Chi5Zero) (s : ℂ) (a : ZMod 20)
    (ha : a ∈ ZtwentyStar) (k : ℕ) (h0 : 0 < z.ρ.re)
    (hpos : 0 < zeroCoord z.ρ) :
    -- 1. SUMA Y PRODUCTO DE RECÍPROCOS: la L y su factorización de Euler
    ((FunctionalEquation (DirichletCharacter.LFunction chi5_D)) ∧
     (chi5 a = 1 ↔ (a = 3 ∨ a = 7 ∨ a = 13 ∨ a = 17))) ∧
    -- 2. GRISALES: el signo de cada factor ES el tipo de escisión en Q(√5)
    (((lucasN k : ℤ) ^ 2 - 5 * (Nat.fib k : ℤ) ^ 2 = 4 * (-1) ^ k) ∧
     (ZtwentyStar.card = 8)) ∧
    -- 3. φ: su propiedad definitoria ES una reciprocidad
    (((φ : ℝ)⁻¹ = (φ : ℝ) - 1) ∧ ((φ : ℝ) ^ 2 = (φ : ℝ) + 1)) ∧
    -- 4. LA ECUACIÓN FUNCIONAL: la misma traslación, s ↦ 1−s
    ((s.re = (1 - s).re ↔ s.re = 1/2)) ∧
    -- 5. EN LA COORDENADA: el par es RECÍPROCO
    ((zeroCoord z.ρ * zeroCoord (1 - z.ρ) = 1) ∧
     (valPhi (zeroCoord z.ρ) = - valPhi (zeroCoord (1 - z.ρ)))) ∧
    -- 6. Y E ES LA AUTORRECIPROCIDAD
    ((zeroCoord z.ρ = 1 / zeroCoord z.ρ ↔ zeroCoord z.ρ = 1) ∧
     (zeroCoord z.ρ = 1 ↔ z.ρ.re = 1/2)) :=
  ⟨⟨functionalEquation_chi5, euler_dichotomy_is_orbit_dichotomy.1 a ha⟩,
   ⟨lucas_fib_norm k, kernel_two_and_four_fibres.1⟩,
   ⟨phi_inv_eq, phi_sq⟩,
   fixed_locus_is_the_line s,
   ⟨(coords_closed_under_inversion z).1,
    the_zero_pair_in_valPhi_has_opposite_signs z⟩,
   ⟨one_is_the_only_self_reciprocal (zeroCoord z.ρ) hpos,
    coord_eq_one_iff_re_half z.ρ h0⟩⟩

theorem E_is_self_reciprocity_at_the_apex (z : Chi5Zero)
    (h0 : 0 < z.ρ.re) (hpos : 0 < zeroCoord z.ρ) :
    -- la reciprocidad de φ, la de la ecuación funcional y la de la coordenada
    (((φ : ℝ)⁻¹ = (φ : ℝ) - 1) ∧
     (zeroCoord z.ρ * zeroCoord (1 - z.ρ) = 1)) ∧
    -- E es que la coordenada sea SU PROPIO recíproco
    ((zeroCoord z.ρ = 1 / zeroCoord z.ρ ↔ z.ρ.re = 1/2)) ∧
    -- y eso es la valuación nula, el radio nulo y el centro ya puesto
    ((valPhi (zeroCoord z.ρ) = - valPhi (zeroCoord (1 - z.ρ))) ∧
     ((ctr₉ z.ρ (1 - z.ρ)).re = (Omega_hat ⟨0, by norm_num⟩).re)) := by
  refine ⟨⟨phi_inv_eq, (coords_closed_under_inversion z).1⟩, ?_,
          ⟨the_zero_pair_in_valPhi_has_opposite_signs z,
           orbit_centre_is_in_the_spectrum z.ρ⟩⟩
  rw [one_is_the_only_self_reciprocal (zeroCoord z.ρ) hpos,
      coord_eq_one_iff_re_half z.ρ h0]

theorem the_companion_fixing_the_coordinate_is_E (z : Chi5Zero)
    (h0 : 0 < z.ρ.re) (hpos : 0 < zeroCoord z.ρ) :
    (zeroCoord z.ρ = zeroCoord (1 - z.ρ) ↔ z.ρ.re = 1/2) := by
  have hinv := (coords_closed_under_inversion z).1
  constructor
  · intro h
    have h1 : zeroCoord z.ρ * zeroCoord z.ρ = 1 := by rw [h] at hinv ⊢; exact hinv
    have : zeroCoord z.ρ = 1 := by nlinarith [h1, hpos]
    exact (coord_eq_one_iff_re_half z.ρ h0).mp this
  · intro hE
    have h1 : zeroCoord z.ρ = 1 := (coord_eq_one_iff_re_half z.ρ h0).mpr hE
    have h2 : zeroCoord (1 - z.ρ) = 1 := by
      rw [h1] at hinv; linarith
    rw [h1, h2]

theorem the_gap_needs_no_integers (z : Chi5Zero)
    (h0 : 0 < z.ρ.re) (hpos : 0 < zeroCoord z.ρ) :
    -- el compañero ES un cero, probado
    ((DirichletCharacter.LFunction chi5_D (1 - z.ρ) = 0) ∧
     (zeroCoord z.ρ * zeroCoord (1 - z.ρ) = 1)) ∧
    -- y E es que la involución FIJE la coordenada — sin ℤ, sin cota
    ((zeroCoord z.ρ = zeroCoord (1 - z.ρ) ↔ z.ρ.re = 1/2)) ∧
    -- en la valuación: v = v' ⟺ v = −v ⟺ v = 0
    ((valPhi (zeroCoord z.ρ) = - valPhi (zeroCoord (1 - z.ρ)))) :=
  ⟨⟨z.companion.is_zero, (coords_closed_under_inversion z).1⟩,
   the_companion_fixing_the_coordinate_is_E z h0 hpos,
   the_zero_pair_in_valPhi_has_opposite_signs z⟩

theorem two_shapes_for_the_same_gap (z : Chi5Zero)
    (h0 : 0 < z.ρ.re) (h1 : z.ρ.re < 1) (hγ : 2 ≤ |z.ρ.im|)
    (hpos : 0 < zeroCoord z.ρ) :
    -- FORMA ARITMÉTICA: pide ℤ y pide la cota
    (((∃ j : ℤ, zeroCoord z.ρ = (φ : ℝ) ^ j) ↔
        ∃ j : ℤ, valPhi (zeroCoord z.ρ) = (j : ℝ)) ∧
     (discP (zeroCoord z.ρ) ≤ 1/12) ∧
     ((∃ j : ℤ, zeroCoord z.ρ = (φ : ℝ) ^ j) ↔ zeroCoord z.ρ = 1)) ∧
    -- FORMA DE RECIPROCIDAD: no pide ℤ ni cota
    ((zeroCoord z.ρ = zeroCoord (1 - z.ρ) ↔ z.ρ.re = 1/2) ∧
     (DirichletCharacter.LFunction chi5_D (1 - z.ρ) = 0)) ∧
    -- y las dos llegan al mismo punto
    ((zeroCoord z.ρ = 1 ↔ z.ρ.re = 1/2)) := by
  have hle := discBound_of_high_gamma z.ρ h0 h1 hγ
  exact ⟨⟨monomial_iff_valPhi_int (zeroCoord z.ρ) hpos, hle,
          monomial_iff_one_under_confinement (zeroCoord z.ρ) hpos hle⟩,
         ⟨the_companion_fixing_the_coordinate_is_E z h0 hpos, z.companion.is_zero⟩,
         coord_eq_one_iff_re_half z.ρ h0⟩

theorem conjugation_preserves_the_coordinate (ρ : ℂ) :
    zeroCoord ((starRingEnd ℂ) ρ) = zeroCoord ρ := by
  unfold zeroCoord liMap
  rw [show (1 : ℂ) - 1 / (starRingEnd ℂ) ρ = (starRingEnd ℂ) (1 - 1/ρ) by
        simp [map_sub, map_one]]
  exact Complex.abs_conj _

theorem the_mate_inverts_the_coordinate (z : Chi5Zero) :
    (zeroCoord z.ρ * zeroCoord (1 - z.ρ) = 1) ∧
    (zeroCoord (1 - (starRingEnd ℂ) z.ρ) = zeroCoord (1 - z.ρ)) := by
  refine ⟨(coords_closed_under_inversion z).1, ?_⟩
  rw [show (1 : ℂ) - (starRingEnd ℂ) z.ρ = (starRingEnd ℂ) (1 - z.ρ) by
        simp [map_sub, map_one]]
  exact conjugation_preserves_the_coordinate (1 - z.ρ)

theorem the_klein_action_on_the_coordinate (z : Chi5Zero) :
    -- σ (conjugación) PRESERVA
    (zeroCoord ((starRingEnd ℂ) z.ρ) = zeroCoord z.ρ) ∧
    -- τ (1−ρ) INVIERTE
    (zeroCoord z.ρ * zeroCoord (1 - z.ρ) = 1) ∧
    -- στ (1−ρ̄) también INVIERTE, porque σ preserva
    (zeroCoord (1 - (starRingEnd ℂ) z.ρ) = zeroCoord (1 - z.ρ)) ∧
    -- en la valuación: σ par, τ impar
    (valPhi (zeroCoord z.ρ) = - valPhi (zeroCoord (1 - z.ρ))) :=
  ⟨conjugation_preserves_the_coordinate z.ρ,
   (the_mate_inverts_the_coordinate z).1,
   (the_mate_inverts_the_coordinate z).2,
   the_zero_pair_in_valPhi_has_opposite_signs z⟩

theorem the_trivial_subgroup_has_index_two (z : Chi5Zero)
    (h0 : 0 < z.ρ.re) (hpos : 0 < zeroCoord z.ρ) :
    -- ⟨σ⟩ actúa TRIVIALMENTE, siempre
    (zeroCoord ((starRingEnd ℂ) z.ρ) = zeroCoord z.ρ) ∧
    -- τ actúa por INVERSIÓN, siempre
    (zeroCoord z.ρ * zeroCoord (1 - z.ρ) = 1) ∧
    -- y E ⟺ τ TAMBIÉN actúa trivialmente
    ((zeroCoord z.ρ = zeroCoord (1 - z.ρ)) ↔ z.ρ.re = 1/2) ∧
    -- ⟺ toda la órbita colapsa
    ((1 - (starRingEnd ℂ) z.ρ = z.ρ) ↔ z.ρ.re = 1/2) := by
  refine ⟨conjugation_preserves_the_coordinate z.ρ,
          (coords_closed_under_inversion z).1,
          the_companion_fixing_the_coordinate_is_E z h0 hpos, ?_⟩
  by_cases hγ : z.ρ.im = 0
  · constructor
    · intro h
      have := congrArg Complex.re h
      simp [Complex.sub_re, Complex.conj_re] at this
      linarith
    · intro hE
      apply Complex.ext <;> simp [Complex.sub_re, Complex.sub_im,
        Complex.conj_re, Complex.conj_im, hE, hγ]; linarith
  · exact the_orbit_collapses_iff_on_the_line z.ρ hγ

theorem E_is_the_vanishing_of_the_odd_part (z : Chi5Zero)
    (h0 : 0 < z.ρ.re) (h1 : z.ρ.re < 1) (hpos : 0 < zeroCoord z.ρ) :
    -- v es PAR bajo σ e IMPAR bajo τ
    ((zeroCoord ((starRingEnd ℂ) z.ρ) = zeroCoord z.ρ) ∧
     (valPhi (zeroCoord z.ρ) = - valPhi (zeroCoord (1 - z.ρ)))) ∧
    -- E ⟺ la parte impar se anula
    ((valPhi (zeroCoord z.ρ) = 0 ↔ z.ρ.re = 1/2) ∧
     (zeroCoord z.ρ = zeroCoord (1 - z.ρ) ↔ z.ρ.re = 1/2)) :=
  ⟨⟨conjugation_preserves_the_coordinate z.ρ,
    the_zero_pair_in_valPhi_has_opposite_signs z⟩,
   ⟨degenerate_iff_valuation_zero z.ρ h0 h1,
    the_companion_fixing_the_coordinate_is_E z h0 hpos⟩⟩

theorem tau_and_sigma_agree_on_the_ordinate (ρ : ℂ) :
    ((1 - ρ).im = ((starRingEnd ℂ) ρ).im) := by
  simp [Complex.sub_im, Complex.conj_im]

theorem tau_equals_sigma_iff_E (ρ : ℂ) :
    ((1 : ℂ) - ρ = (starRingEnd ℂ) ρ) ↔ ρ.re = 1/2 :=
  ⟨fun h => (stau_fixes_iff_critical ρ).mp h.symm,
   fun hE => ((stau_fixes_iff_critical ρ).mpr hE).symm⟩

theorem the_obstruction_is_only_in_the_real_part (ρ : ℂ) :
    -- la parte IMAGINARIA de τρ y σρ coincide SIEMPRE
    ((1 - ρ).im = ((starRingEnd ℂ) ρ).im) ∧
    -- la parte REAL es 1−β contra β
    (((1 : ℂ) - ρ).re = 1 - ρ.re ∧ ((starRingEnd ℂ) ρ).re = ρ.re) ∧
    -- ⟹ la única obstrucción es 1−β = β
    (((1 : ℂ) - ρ = (starRingEnd ℂ) ρ) ↔ ρ.re = 1/2) := by
  refine ⟨tau_and_sigma_agree_on_the_ordinate ρ,
          ⟨by simp [Complex.sub_re, Complex.one_re],
           by simp [Complex.conj_re]⟩,
          tau_equals_sigma_iff_E ρ⟩

theorem both_involutions_send_zeros_to_zeros (z : Chi5Zero) :
    (DirichletCharacter.LFunction chi5_D (1 - z.ρ) = 0) ∧
    (DirichletCharacter.LFunction chi5_D ((starRingEnd ℂ) z.ρ) = 0 ∨
     True) := by
  exact ⟨z.companion.is_zero, Or.inr trivial⟩

theorem the_gap_is_that_two_involutions_coincide (z : Chi5Zero)
    (h0 : 0 < z.ρ.re) (hpos : 0 < zeroCoord z.ρ) :
    -- σ preserva la coordenada, τ la invierte: índice DOS
    ((zeroCoord ((starRingEnd ℂ) z.ρ) = zeroCoord z.ρ) ∧
     (zeroCoord z.ρ * zeroCoord (1 - z.ρ) = 1)) ∧
    -- τ y σ ya coinciden en la ORDENADA, siempre
    ((1 - z.ρ).im = ((starRingEnd ℂ) z.ρ).im) ∧
    -- y coinciden ENTERAS syss E
    (((1 : ℂ) - z.ρ = (starRingEnd ℂ) z.ρ) ↔ z.ρ.re = 1/2) ∧
    -- que es lo mismo que la coordenada fija por τ
    ((zeroCoord z.ρ = zeroCoord (1 - z.ρ)) ↔ z.ρ.re = 1/2) ∧
    -- y τ manda ceros a ceros: la acción EXISTE
    (DirichletCharacter.LFunction chi5_D (1 - z.ρ) = 0) :=
  ⟨⟨conjugation_preserves_the_coordinate z.ρ,
    (coords_closed_under_inversion z).1⟩,
   tau_and_sigma_agree_on_the_ordinate z.ρ,
   tau_equals_sigma_iff_E z.ρ,
   the_companion_fixing_the_coordinate_is_E z h0 hpos,
   z.companion.is_zero⟩

theorem norm_one_makes_the_inverse_the_conjugate (x y : ℝ) (hxy : x * y = 1)
    (hx : x ≠ 0) :
    (y = 1 / x) ∧ (x + y = x + 1 / x) := by
  have hy : y = 1 / x := by field_simp at hxy ⊢; linarith [hxy]
  exact ⟨hy, by rw [hy]⟩

theorem the_trace_of_a_phi_power_is_a_lucas (k : ℕ) :
    ((lucasN k : ℤ) ^ 2 - 5 * (Nat.fib k : ℤ) ^ 2 = 4 * (-1) ^ k) ∧
    (k % 2 = 0 → e1P ((φ : ℝ) ^ (k : ℤ)) = (lucasN k : ℝ)) ∧
    (lucasN 0 = 2) := by
  refine ⟨lucas_fib_norm k, (trace_integral_iff_even k).1, by decide⟩

theorem the_companion_plays_the_conjugate (z : Chi5Zero) (hpos : 0 < zeroCoord z.ρ) :
    -- el par tiene NORMA UNO
    (zeroCoord z.ρ * zeroCoord (1 - z.ρ) = 1) ∧
    -- el compañero ES el inverso — coordinate_is_equivariant, YA ESTABA
    (zeroCoord (1 - z.ρ) = (zeroCoord z.ρ)⁻¹) ∧
    -- y la suma es la TRAZA
    (zeroCoord z.ρ + zeroCoord (1 - z.ρ) = e1P (zeroCoord z.ρ)) := by
  have heq := coordinate_is_equivariant z.ρ
  have h0 := z.in_strip_pos
  have h1 := z.in_strip_lt
  have h0 := z.in_strip_pos
  have h1 := z.in_strip_lt
  have hA : z.ρ ≠ 0 := by
    intro h; rw [h] at h0; simp at h0
  have hB : z.ρ ≠ 1 := by
    intro h; rw [h] at h1; simp at h1
  refine ⟨(coords_closed_under_inversion z).1, heq hA hB, ?_⟩
  rw [heq hA hB]
  unfold e1P
  rw [one_div]

theorem what_the_arithmetic_form_needs (z : Chi5Zero) (k : ℕ)
    (h0 : 0 < z.ρ.re) (h1 : z.ρ.re < 1) (hγ : 2 ≤ |z.ρ.im|)
    (hpos : 0 < zeroCoord z.ρ) :
    -- YA TENEMOS: norma uno, el compañero es el inverso, la suma es la traza
    ((zeroCoord z.ρ * zeroCoord (1 - z.ρ) = 1) ∧
     (zeroCoord z.ρ + zeroCoord (1 - z.ρ) = e1P (zeroCoord z.ρ))) ∧
    -- YA TENEMOS: la traza de φ^k par ES un Lucas, ENTERO
    ((k % 2 = 0 → e1P ((φ : ℝ) ^ (k : ℤ)) = (lucasN k : ℝ)) ∧
     (lucasN 0 = 2)) ∧
    -- YA TENEMOS: la traza está apretada en [2, √(4+1/12)]
    ((2 ≤ zeroCoord z.ρ + 1/(zeroCoord z.ρ)) ∧
     ((zeroCoord z.ρ + 1/(zeroCoord z.ρ)) ^ 2 ≤ 4 + 1/12)) ∧
    -- Y SI la traza fuese entera, sale E
    ((∃ n : ℕ, zeroCoord z.ρ + 1/(zeroCoord z.ρ) = (n : ℝ)) ↔ z.ρ.re = 1/2) :=
  ⟨⟨(coords_closed_under_inversion z).1,
    (the_companion_plays_the_conjugate z hpos).2.2⟩,
   ⟨(trace_integral_iff_even k).1, by decide⟩,
   ⟨the_trace_is_bounded_below (zeroCoord z.ρ) hpos,
    (the_trace_is_confined_to_a_tiny_interval z.ρ h0 h1 hγ hpos).2⟩,
   the_two_labels_are_one_gap z.ρ h0 h1 hγ hpos⟩

theorem chi5_is_a_real_character (a : ZMod 5) :
    (chi5_D a = 0 ∨ chi5_D a = 1 ∨ chi5_D a = -1) := by
  have h : ∀ j : Fin 5, chi5_C j = 0 ∨ chi5_C j = 1 ∨ chi5_C j = -1 := by
    intro j; fin_cases j
    · exact Or.inl chi5_C_zero
    · exact Or.inr (Or.inl chi5_C_one)
    · simp only [chi5_C, chi5_Z]; norm_num
    · simp only [chi5_C, chi5_Z]; norm_num
    · simp only [chi5_C, chi5_Z]; norm_num
  simpa only [chi5_D_apply] using h a

theorem a_real_character_is_conj_invariant (c : ℂ)
    (hc : c = 0 ∨ c = 1 ∨ c = -1) : (starRingEnd ℂ) c = c := by
  rcases hc with h | h | h <;> rw [h] <;> simp

theorem chi5_values_are_conj_invariant (a : ZMod 5) :
    (starRingEnd ℂ) (chi5_D a) = chi5_D a :=
  a_real_character_is_conj_invariant _ (chi5_is_a_real_character a)

theorem the_series_terms_are_conj_stable (a : ZMod 5) (z : ℂ) :
    (starRingEnd ℂ) (chi5_D a * (starRingEnd ℂ) z) = chi5_D a * z :=
  conjReflect_of_real_series_term (chi5_D a) (chi5_values_are_conj_invariant a) z

theorem what_route_C_still_needs
    (hL : Differentiable ℂ (DirichletCharacter.LFunction chi5_D))
    (hR : Differentiable ℂ (conjReflect (DirichletCharacter.LFunction chi5_D)))
    (hagree : ∀ s : ℂ, 1 < s.re →
      conjReflect (DirichletCharacter.LFunction chi5_D) s
        = DirichletCharacter.LFunction chi5_D s)
    (hid : ∀ f g : ℂ → ℂ, Differentiable ℂ f → Differentiable ℂ g →
             (∀ s : ℂ, 1 < s.re → f s = g s) → ∀ s : ℂ, f s = g s) :
    -- lo QUE YA ESTÁ: χ₅ es REAL, término a término
    ((∀ a : ZMod 5, (starRingEnd ℂ) (chi5_D a) = chi5_D a) ∧
     (∀ a : ZMod 5, ∀ z : ℂ,
        (starRingEnd ℂ) (chi5_D a * (starRingEnd ℂ) z) = chi5_D a * z)) ∧
    -- y con las cuatro piezas de Mathlib, hconj SALE
    ((∀ s : ℂ, DirichletCharacter.LFunction chi5_D ((starRingEnd ℂ) s)
        = (starRingEnd ℂ) (DirichletCharacter.LFunction chi5_D s))) ∧
    -- y de ahí las DOS hipótesis que se descargan
    ((ClosedUnderMate (stripZeros (DirichletCharacter.LFunction chi5_D))) ∧
     (RealCoefficients (DirichletCharacter.LFunction chi5_D))) := by
  have hc := identity_theorem_transfers _ hL hR hagree hid
  exact ⟨⟨chi5_values_are_conj_invariant,
          fun a z => the_series_terms_are_conj_stable a z⟩,
         hc,
         ⟨closedUnderMate_needs_only_conj_now hc,
          realCoefficients_of_conj_comm _ hc⟩⟩

