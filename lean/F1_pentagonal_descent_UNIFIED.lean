  | cardinal    : Leg   -- 8  |órb degen|/|órb libre|
deriving DecidableEq

instance : Fintype Leg :=
  ⟨{Leg.factorial, Leg.operator, Leg.ternary, Leg.tower, Leg.involutionR, Leg.functionalC, Leg.radius, Leg.cardinal}, by
    intro x; cases x <;> simp⟩

/-- **[P] SON OCHO.** -/
theorem eight_legs : Fintype.card Leg = 8 := by decide

/-- Una pata es DISCRETA si su objeto es un cardinal. -/
