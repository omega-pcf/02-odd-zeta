/-! ## §101.1  La séptima ruta -/

/-- **[P] LA SÉPTIMA RUTA: EL RADIO DEL PAR RECÍPROCO ÁUREO.**
    `(φ − 1/φ)/2 = 1/2`, directamente de `φ − 1/φ = 1`
    (`decoration_pair_gap_is_one`, §44).

    No usa `log`, no usa el `2` de `λ`: sólo `φ² = φ + 1`. -/
theorem seventh_route : ((φ : ℝ) - 1 / φ) / 2 = 1 / 2 := by
  rw [decoration_pair_gap_is_one]

/-- **[P] Y NO COMPARTE INGREDIENTE CON LA TORRE.**  La torre pone el
    `1/2` en el exponente, `φ^{−λ}` con `λ = log_φ 2`; el radio lo
    pone en la coordenada `(c,r)` y lo obtiene de la identidad.

    Criterio de `half_on_both_faces`: rutas sin ingrediente común. -/
theorem seventh_route_is_independent :
    (((φ : ℝ) - 1 / φ) / 2 = 1 / 2) ∧
    ((φ : ℝ) - 1 / φ = 1) ∧
    ((φ : ℝ) ^ 2 = φ + 1) :=
  ⟨seventh_route, decoration_pair_gap_is_one, phi_sq⟩

/-! ## §101.2  La cuantización está en el índice -/

/-- El parámetro espectral, indexado por entero. -/
def muIdx (n : ℤ) : ℝ := 2 - (n : ℝ) / 2

/-- **[P] LOS TRES CENTRALES.**  `μ₂ = 1`, `μ₃ = 1/2`, `μ₄ = 0`. -/
theorem mu_two_three_four :
    muIdx 2 = 1 ∧ muIdx 3 = 1 / 2 ∧ muIdx 4 = 0 := by
  refine ⟨?_, ?_, ?_⟩ <;> unfold muIdx <;> norm_num

/-- **[P] BRECHA `1/2` ENTRE VECINOS.**  `μₙ − μ_{n+1} = 1/2`. -/
theorem mu_gap_is_half (n : ℤ) : muIdx n - muIdx (n + 1) = 1 / 2 := by
  unfold muIdx; push_cast; ring

/-- **[P] LOS VECINOS DE `μ₃` SON LOS BORDES DE LA BANDA.**
    `μ₂ = 1` y `μ₄ = 0`: la banda `(0,1)` los excluye por sí sola. -/
theorem neighbours_are_the_band_edges :
    (muIdx 2 = 1) ∧ (muIdx 4 = 0) ∧
    ¬ ((0 : ℝ) < muIdx 2 ∧ muIdx 2 < 1) ∧
    ¬ ((0 : ℝ) < muIdx 4 ∧ muIdx 4 < 1) := by
  obtain ⟨h2, _, h4⟩ := mu_two_three_four
  refine ⟨h2, h4, ?_, ?_⟩
  · rintro ⟨_, hlt⟩; rw [h2] at hlt; linarith
  · rintro ⟨hgt, _⟩; rw [h4] at hgt; linarith

/-- **[P] Y `μ₃` ES EL ÚNICO DE LOS TRES EN LA BANDA.** -/
theorem mu_three_is_the_only_one_inside :
    (0 : ℝ) < muIdx 3 ∧ muIdx 3 < 1 := by
  obtain ⟨_, h3, _⟩ := mu_two_three_four
  rw [h3]; constructor <;> norm_num

/-! ## §101.3  La exclusión no necesita cota -/

/-- **[C] LA PERTENENCIA.**  `Re ρ ∈ {μₙ}`: es el embedding (§45), y
    es lo que sigue abierto.  Predicado, en la firma. -/
def ReInMuFamily (x : ℝ) : Prop := ∃ n : ℤ, x = muIdx n

/-- **[P] PERTENENCIA MÁS BANDA DAN `1/2`, SIN COTA.**  Si
    `Re ρ = μₙ` para algún `n` y `0 < Re ρ < 1`, entonces
    `Re ρ = 1/2`.

    **No interviene el `3.472359·10⁻⁷`.**  La banda excluye los
    vecinos porque son sus bordes. -/
theorem membership_and_band_give_half (x : ℝ)
    (hm : ReInMuFamily x) (h0 : 0 < x) (h1 : x < 1) : x = 1 / 2 := by
  obtain ⟨n, rfl⟩ := hm
  unfold muIdx at h0 h1 ⊢
  have hn3 : (n : ℝ) = 3 := by
    have hlo : (2 : ℝ) < (n : ℝ) := by linarith
    have hhi : (n : ℝ) < 4 := by linarith
    have h2 : (2 : ℤ) < n := by exact_mod_cast hlo
    have h4 : n < 4 := by exact_mod_cast hhi
    have : n = 3 := by omega
    exact_mod_cast congrArg (fun k : ℤ => (k : ℝ)) this
  rw [hn3]; norm_num

/-! ## §101.4  El balance -/

/-- **[O] EL BALANCE DE §101.**

    | | antes | ahora |
    |---|---|---|
    | rutas al ápice | seis | **siete** |
    | de dónde sale la 7ª | --- | `(φ−1/φ)/2`, sin `log` |
    | dónde está la cuantización | «en el exponente» | **en el índice `n`** |
    | qué excluye a los vecinos | la cota `3.47·10⁻⁷` | **la banda `(0,1)`** |
    | lo abierto | pertenencia | **pertenencia, sin cambio** |

    **Nada de esto prueba `E`.**  Lo que se mueve es que la exclusión
    deja de necesitar cota: lo abierto queda limpio como
    `Re ρ ∈ {μₙ}`, que es el embedding de §45. -/
theorem the_balance_of_section_101 (x : ℝ)
    (hm : ReInMuFamily x) (h0 : 0 < x) (h1 : x < 1) :
    (((φ : ℝ) - 1 / φ) / 2 = 1 / 2) ∧
    (muIdx 2 = 1 ∧ muIdx 3 = 1 / 2 ∧ muIdx 4 = 0) ∧
    (∀ n : ℤ, muIdx n - muIdx (n + 1) = 1 / 2) ∧
    (x = 1 / 2) :=
  ⟨seventh_route, mu_two_three_four, mu_gap_is_half,
   membership_and_band_give_half x hm h0 h1⟩

