theorem Complex.abs.nonneg (z : ℂ) : 0 ≤ Complex.abs z := norm_nonneg z

theorem Complex.abs.sub_le' (a b : ℂ) :
    Complex.abs a - Complex.abs b ≤ Complex.abs (a - b) := by
  unfold Complex.abs
  have hn := norm_add_le (a - b) b
  have heq : ‖a - b + b‖ = ‖a‖ := by
