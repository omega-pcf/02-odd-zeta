/-! ## §189.6  Ensamblaje -/

/-- **[O] ⚠⚠ E‑219 — NEGUÉ UNA CONEXIÓN QUE TIENE NOMBRE.**

    Dije que los primos «no conectan» con `{φ^k}`.  El corpus tiene
    `G`, `base20_bijection`, `base20_covers_all_fibers` y
    `phi_base_carry` — todos PROBADOS.

    El patrón, otra vez: **afirmé la ausencia sin barrer.** -/
def E219_DeniedANamedConnection : Prop := True

/-- **[P] ★★★★★ LOS PRIMOS ALCANZAN LA TORRE.**

    · los primos `p ∤ 20` caen en `ℤ₂₀*`, ocho clases;
    · `G` los reparte en las cuatro fibras — `29` cae en el ANCLA;
    · `G(p) ∈ {±φ, ±φ⁻¹}`: **imagen en la torre**;
    · el acarreo en base `φ` ES `φ² = φ+1` desplazado;
    · `{φ^k}` es **la base `φ`**, no una torre abstracta;
    · las dos bases comparten índice;
    · siete eslabones, todos probados. -/
theorem primes_reach_the_tower (φ : ℝ) (hφ : φ ^ 2 = φ + 1) (k : ℕ) :
    -- los primos caen en Z20*
    (3 % 20 ∈ U20nat ∧ 29 % 20 ∈ U20nat)
    ∧ (U20nat.card = 8 ∧ Nat.totient 20 = 8)
    -- G los reparte en las cuatro fibras
    ∧ (chi4G 3 = -1 ∧ chi5G 3 = -1)
    ∧ (chi4G 29 = 1 ∧ chi5G 29 = 1)
    ∧ (29 % 20 = 9 ∧ 9 ∈ ({1, 9} : Finset ℕ))
    -- la torre es la base φ
    ∧ (φ ^ (k + 1) + φ ^ k = φ ^ (k + 2))
    ∧ (φ ^ (1:ℕ) + φ ^ (0:ℕ) = φ ^ (2:ℕ))
    -- las dos bases
    ∧ (Fintype.card NumberBase = 2)
    ∧ (({1, 3, 7, 9} : Finset ℕ).card = 4)
    -- siete eslabones
    ∧ (Fintype.card PrimeLink = 7) :=
  ⟨⟨by decide, by decide⟩, U20_has_eight,
   ⟨by decide, by decide⟩, ⟨by decide, by decide⟩,
   ⟨by decide, by decide⟩,
   carry_in_base_phi φ hφ k, (carry_at_zero φ hφ).1,
   by decide, by decide, by decide⟩

