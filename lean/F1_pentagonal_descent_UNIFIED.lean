          have h1 := Complex.exp_mul_I (θ : ℂ)
          have h2 := Complex.exp_mul_I (-θ : ℂ)
        y luego `simp [Complex.cos_neg, Complex.sin_neg]`.
      - El paso final usa `cos_pi_div_five_eq : cos(π/5) = φ/2`,
