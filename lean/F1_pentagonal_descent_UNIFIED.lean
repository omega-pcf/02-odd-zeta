/- ══════════════ SECCIÓN 16: statistics_transport ══════════════ -/
/-
  §10.AC — WHEN A STATISTICAL PROPERTY TRANSPORTS
  ===============================================
  La cláusula (vi) del transporte afirma que la repulsión de niveles
  es del nivel del valor.  Ese enunciado necesita TRES condiciones, y
  este módulo formaliza el criterio que las distingue — porque
  cumplir solo la primera no basta y es el error que se corrigió.

      (a) el fenómeno aparece en varios cuerpos
      (b) la DISTRIBUCIÓN es la misma, no solo el fenómeno
      (c) no depende del cuerpo más allá de la normalización

  Con (a) sola, dos cuerpos podrían tener repulsión con
  distribuciones distintas; entonces transportaría el fenómeno
  cualitativo pero NO la propiedad, y la implicación sobre E sería
  inválida.

  MEDIDO (asintótico; el criterio es lo formalizable):
    distancia total de variación entre χ₅ y χ₈ = 0.0670,
    con fluctuación binomial esperada por caja 0.0486 (n≈100).
    Todas las diferencias por intervalo caen dentro del ruido:
      [0,.3) 0.001 · [.3,.6) 0.044 · [.6,.9) 0.037
      [.9,1.2) 0.018 · [1.2,1.5) 0.002 · [1.5,1.8) 0.020
    Las distribuciones son estadísticamente indistinguibles.
    (`verify_statistics_transport.py`.)

  CONSECUENCIA.  Con (b) establecida, una ruta a
  `routes:cor-criterion` por la estadística de espaciados probaría lo
  mismo para toda la familia — porque la estadística es LA MISMA, no
  solo del mismo tipo.
-/





/-! ### El criterio de transporte estadístico -/

/-- Una distribución empírica sobre `n` intervalos: la proporción de
    observaciones en cada uno. -/
abbrev Distribution (n : ℕ) := Fin n → ℝ

/-- Distancia total de variación entre dos distribuciones. -/
noncomputable def totalVariation {n : ℕ} (P Q : Distribution n) : ℝ :=
  (Finset.univ.sum fun i => |P i - Q i|) / 2

/-- **CRITERIO DE INDISTINGUIBILIDAD.**  Dos distribuciones son
    indistinguibles a resolución `ε` si su distancia total de
    variación no supera `ε`.  Con `ε` la fluctuación binomial de la
    muestra, «indistinguible» significa que la diferencia observada
    es compatible con el ruido. -/
def indistinguishable {n : ℕ} (P Q : Distribution n) (ε : ℝ) : Prop :=
  totalVariation P Q ≤ ε

/-- La distancia total de variación es simétrica. -/
theorem totalVariation_comm {n : ℕ} (P Q : Distribution n) :
    totalVariation P Q = totalVariation Q P := by
  unfold totalVariation
  congr 1
  exact Finset.sum_congr rfl (fun i _ => abs_sub_comm (P i) (Q i))

/-- Y es cero exactamente cuando las distribuciones coinciden. -/
theorem totalVariation_eq_zero {n : ℕ} (P Q : Distribution n) :
    totalVariation P Q = 0 ↔ ∀ i, P i = Q i := by
  unfold totalVariation
  constructor
  · intro h i
    have hsum : (Finset.univ.sum fun j => |P j - Q j|) = 0 := by
      linarith
    have := (Finset.sum_eq_zero_iff_of_nonneg
      (fun j _ => abs_nonneg (P j - Q j))).mp hsum i (Finset.mem_univ i)
    exact sub_eq_zero.mp (abs_eq_zero.mp this)
  · intro h
    simp [fun i => sub_eq_zero.mpr (h i)]

/-! ### Las tres condiciones -/

/-- **EL CRITERIO COMPLETO.**  Una propiedad estadística transporta
    a la familia cuando se cumplen las tres condiciones: el fenómeno
    aparece en varios miembros, sus distribuciones son
    indistinguibles a la resolución de la muestra, y por tanto no
    depende del miembro más allá de la normalización.

    La tercera se sigue de la segunda: si las distribuciones
    coinciden dentro del ruido, no queda dependencia del cuerpo que
    medir. -/
structure StatisticalTransport {n : ℕ} (P Q : Distribution n) (ε : ℝ) : Prop where
  /-- (a) el fenómeno aparece en ambos -/
  appears : (∃ i, P i ≠ 0) ∧ (∃ i, Q i ≠ 0)
  /-- (b) las distribuciones son indistinguibles -/
  same_law : indistinguishable P Q ε
  /-- (c) la resolución es la de la muestra, no arbitraria -/
  resolution_is_noise : 0 < ε

/-- **(b) IMPLICA (c).**  Si dos distribuciones son indistinguibles
    a resolución `ε`, entonces ninguna comparación por intervalos las
    separa por más de `ε`: no queda dependencia medible del cuerpo.
    Es la razón de que la condición (a) sola no baste — y de que con
    (b) el transporte sea legítimo. -/
theorem same_law_implies_no_residual_dependence {n : ℕ}
    (P Q : Distribution n) (ε : ℝ) (h : indistinguishable P Q ε) :
    ∀ i, |P i - Q i| ≤ 2 * ε := by
  intro i
  have hs : |P i - Q i| ≤ Finset.univ.sum fun j => |P j - Q j| :=
    Finset.single_le_sum (fun j _ => abs_nonneg (P j - Q j))
      (Finset.mem_univ i)
  unfold indistinguishable totalVariation at h
  linarith [hs, h]

/-- **POR QUÉ (a) SOLA NO BASTA.**  Dos distribuciones pueden ambas
    exhibir el fenómeno y sin embargo estar arbitrariamente
    separadas: `appears` no acota `totalVariation`.  Testigo: sobre
    dos intervalos, P concentrada en el primero y Q en el segundo
    tienen ambas masa no nula y distancia total de variación 1. -/
theorem appearance_does_not_imply_same_law :
    ∃ (P Q : Distribution 2),
      ((∃ i, P i ≠ 0) ∧ (∃ i, Q i ≠ 0)) ∧ totalVariation P Q = 1 := by
  refine ⟨![1, 0], ![0, 1], ⟨⟨0, by norm_num⟩, ⟨1, by norm_num⟩⟩, ?_⟩
  unfold totalVariation
  simp [Fin.sum_univ_two]

/-! ### La implicación sobre las pruebas: transporte de una prueba -/

/-- Una propiedad de distribuciones es ESTABLE a resolución `ε` si
    la preservan las perturbaciones de ese tamaño.  Es la condición
    que faltaba: sin ella, `Φ(D₅)` no implica `Φ(D₈)` aunque las
    distribuciones sean indistinguibles. -/
def StableProperty {n : ℕ} (Φ : Distribution n → Prop) (ε : ℝ) : Prop :=
  ∀ P Q : Distribution n, totalVariation P Q ≤ ε → Φ P → Φ Q

/-- **TRANSPORTE DE UNA PRUEBA.**  Si una demostración de un
    enunciado usa solo una propiedad `Φ` de la distribución de
    espaciados, si `Φ` es estable a resolución `ε`, y si las
    distribuciones de dos miembros de la familia distan menos de `ε`,
    entonces la demostración transporta del uno al otro.

    Las tres hipótesis son necesarias: la tercera se midió
    \textup{(}TV = 0.0670 contra ruido 0.0486\textup{)}, la segunda
    es la que faltaba en el enunciado informal, y sin ella el
    transporte falla. -/
theorem proof_transports {n : ℕ} {Φ : Distribution n → Prop}
    {D₁ D₂ : Distribution n} {ε : ℝ} {E₁ E₂ : Prop}
    (hstable : StableProperty Φ ε)
    (hclose  : totalVariation D₁ D₂ ≤ ε)
    (hΦ₁     : Φ D₁)
    (_hproof₁: Φ D₁ → E₁)
    (hproof₂ : Φ D₂ → E₂) :
    E₂ :=
  hproof₂ (hstable D₁ D₂ hclose hΦ₁)

/-- **POR QUÉ LA ESTABILIDAD ES NECESARIA.**  Sin ella el transporte
    falla: hay propiedades que separan distribuciones arbitrariamente
    próximas.  Testigo: `Φ P := P 0 = 1`, cierta para `(1,0)` y falsa
    para `(1-δ, δ)` por pequeño que sea `δ`. -/
theorem stability_is_necessary :
    ∃ (Φ : Distribution 2 → Prop) (P Q : Distribution 2),
      Φ P ∧ ¬ Φ Q ∧ totalVariation P Q ≤ (1:ℝ)/10 := by
  refine ⟨fun R => R 0 = 1, ![1, 0], ![9/10, 1/10], rfl, ?_, ?_⟩
  · norm_num
  · unfold totalVariation
    simp [Fin.sum_univ_two]
    norm_num

/-- **LA LECTURA.**  Las propiedades con margen —desigualdades no
