theorem the_paper_quantifies_over_zeros_only (z : Chi5Zero) :
    (0 < z.ρ.re) ∧ (z.ρ.re < 1) ∧
    (DirichletCharacter.LFunction chi5_D z.ρ = 0) :=
  ⟨z.in_strip_pos, z.in_strip_lt, z.is_zero⟩

def SpectralEmbeddingOnZeros : Prop :=
  ∀ z : Chi5Zero, z.ρ.re = 1/2 ∨ z.ρ.re = -(1/4)

theorem the_zero_restricted_form_gives_E (h : SpectralEmbeddingOnZeros)
    (z : Chi5Zero) : z.ρ.re = 1/2 := by
  rcases h z with h' | h'
  · exact h'
  · exfalso
    have := z.in_strip_pos
    rw [h'] at this
    norm_num at this

theorem the_import_was_too_strong (z : Chi5Zero) :
    -- la forma del Lean con reZero = Re es FALSA
    (¬ SpectralEmbedding (fun ρ : ℂ => ρ.re)) ∧
    -- y con la constante es TRIVIALMENTE cierta
    (SpectralEmbedding (fun _ => (1:ℝ)/2)) ∧
    -- la forma del paper, restringida a ceros, da E sin más
    (SpectralEmbeddingOnZeros → z.ρ.re = 1/2) ∧
    -- porque la banda excluye el negativo
    (0 < z.ρ.re) :=
  ⟨the_embedding_with_Re_is_false,
   the_constant_map_satisfies_the_embedding,
   fun h => the_zero_restricted_form_gives_E h z,
   z.in_strip_pos⟩

