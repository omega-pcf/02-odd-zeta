theorem the_answer (ρ : ℂ) (hδ : ρ.re ≠ 1/2) (r : ℝ) (hr : r ≠ 0)
    (hle : discP r ≤ 1/12) :
    (discP r = (r - 1/r) ^ 2) ∧
