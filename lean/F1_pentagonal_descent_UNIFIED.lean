noncomputable section
open Real Complex Finset


-- ═══════════════════════════════════════════════════════════
-- §129  ·  dos rebanadas, una frontera
-- ═══════════════════════════════════════════════════════════

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §129.1  ·  LA TRAZA Y SUS DOS REBANADAS                         ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] EL DISCRIMINANTE ES EL CUADRADO DE LA PARTE IMPAR.**
    `(r + 1/r)² − 4 = (r − 1/r)²`.  Una identidad, dos lecturas: la
    parte par es la traza, la parte impar es la raíz del discriminante. -/
theorem dsc_eq_odd_part_sq (r : ℝ) (hr : r ≠ 0) :
    discP r = (r - 1 / r) ^ 2 := by
  unfold discP e1P
  field_simp
  ring

/-- **[P] LA TRAZA DE UN REAL POSITIVO ES ≥ 2**, con igualdad sólo en 1.
    Es AM–GM; es también `2cosh(log r) ≥ 2`.  Ésta es la rama radial. -/
theorem tr_ge_two_of_pos (r : ℝ) (hr : 0 < r) : 2 ≤ e1P r := by
  unfold e1P
  have h : r + 1 / r - 2 = (r - 1) ^ 2 / r := by field_simp; ring
  nlinarith [sq_nonneg (r - 1), hr, div_nonneg (sq_nonneg (r - 1)) hr.le]

/-- **[P] Y LA IGUALDAD FUERZA `r = 1`.**  El caso `C₁`. -/
theorem tr_eq_two_iff (r : ℝ) (hr : 0 < r) : e1P r = 2 ↔ r = 1 := by
  unfold e1P
  constructor
  · intro h
    have h1 : (r - 1) ^ 2 = 0 := by field_simp at h; nlinarith [h]
    nlinarith [pow_eq_zero_iff (n := 2) (by norm_num) |>.mp h1]
  · rintro rfl; norm_num

/-- **[P] `discP r = 0 ⟺ e1P r = 2` para `r > 0`.**  El caso PARABÓLICO,
    y es el enunciado que el corpus lista con siete nombres. -/
theorem dsc_zero_iff_tr_two (r : ℝ) (hr : 0 < r) : discP r = 0 ↔ e1P r = 2 := by
  unfold discP
  constructor
  · intro h
    have h2 : (e1P r - 2) * (e1P r + 2) = 0 := by nlinarith [h]
    rcases mul_eq_zero.mp h2 with h3 | h3
    · linarith
    · have := tr_ge_two_of_pos r hr; linarith
  · intro h; rw [h]; norm_num

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §129.2  ·  LA RAMA ANGULAR: RESTRICCIÓN CRISTALOGRÁFICA         ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- La traza de la raíz n-ésima primitiva de la unidad, como real. -/
def trZeta (n : ℕ) : ℝ := 2 * Real.cos (2 * Real.pi / n)

/-- Los cinco órdenes con traza entera.  Es el `periodic_allowed` de la
    restricción cristalográfica clásica. -/
def crystallographic : Finset ℕ := {1, 2, 3, 4, 6}

/-- **[P] LOS CINCO VALORES ENTEROS**, tabulados.
    `n = 1,2,3,4,6` dan `2, −2, −1, 0, 1`.
    Entradas clásicas de coseno en la firma por F4‑inverso. -/
theorem trZeta_crystallographic_values
    (h1 : Real.cos (2 * Real.pi / 1) = 1)
    (h2 : Real.cos (2 * Real.pi / 2) = -1)
    (h3 : Real.cos (2 * Real.pi / 3) = -(1/2))
    (h4 : Real.cos (2 * Real.pi / 4) = 0)
    (h6 : Real.cos (2 * Real.pi / 6) = 1/2) :
    trZeta 1 = 2 ∧ trZeta 2 = -2 ∧ trZeta 3 = -1 ∧
    trZeta 4 = 0 ∧ trZeta 6 = 1 := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;>
    simp only [trZeta] <;> norm_num [h1, h2, h3, h4, h6]

/-- **[C] EL PENTÁGONO NO DA UN ENTERO.**  `2cos(2π/5) = 1/φ` y
    `2cos(2π/10) = φ`, ninguno racional.  Entrada clásica: la
    irracionalidad de `√5`, que el corpus ya usa. -/
def PentagonTraces (t₅ t₁₀ φ : ℝ) : Prop :=
  t₅ = φ - 1 ∧ t₁₀ = φ ∧ φ ^ 2 = φ + 1 ∧ Irrational (Real.sqrt 5)

/-- **[P] Y ENTONCES NINGUNO DE LOS DOS ES ENTERO.**  Si `φ² = φ + 1`
    con `φ > 1` entonces `φ = (1+√5)/2`, irracional; y `φ − 1 = 1/φ`
    también.  Luego el pentágono queda FUERA de la lista. -/
theorem pentagon_traces_irrational (φ : ℝ) (hφ : φ ^ 2 = φ + 1) (hpos : 1 < φ)
    (h5 : Irrational (Real.sqrt 5)) :
    Irrational φ ∧ Irrational (φ - 1) := by
  have hval : φ = (1 + Real.sqrt 5) / 2 := by
    have hs : Real.sqrt 5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
    have hsp : 0 < Real.sqrt 5 := Real.sqrt_pos.mpr (by norm_num)
    nlinarith [hφ, hpos, hs, hsp]
  constructor
  · rw [hval]
    intro ⟨q, hq⟩
    have hsq5 : Real.sqrt 5 = (2 * q - 1 : ℝ) := by linarith
    exact h5 ⟨2 * q - 1, by push_cast; linarith⟩
  · exact (by
      rw [hval]
      intro ⟨q, hq⟩
      have hsq5 : Real.sqrt 5 = (2 * q + 1 : ℝ) := by linarith
      exact h5 ⟨2 * q + 1, by push_cast; linarith⟩)

/-- **[C] LA COTA DE MONOTONÍA.**  Para `n ≥ 7` se tiene
    `0 < 2π/n < π/3`, luego `1/2 < cos(2π/n) < 1` por antimonotonía
    estricta del coseno en `[0, π]`.  Entrada clásica; en Mathlib es
    `Real.cos_lt_cos_of_nonneg_of_le_pi` (ver NOTA 2). -/
def CosineWindow : Prop :=
  ∀ n : ℕ, 7 ≤ n → 1/2 < Real.cos (2 * Real.pi / n) ∧ Real.cos (2 * Real.pi / n) < 1

/-- **[P] PARA `n ≥ 7` LA TRAZA CAE ESTRICTAMENTE ENTRE 1 Y 2**, luego
    no es entera.  Es el único paso analítico del apartado. -/
theorem trZeta_strictly_between (hw : CosineWindow) (n : ℕ) (hn : 7 ≤ n) :
    1 < trZeta n ∧ trZeta n < 2 := by
  obtain ⟨hlo, hhi⟩ := hw n hn
  constructor <;> simp only [trZeta] <;> linarith

/-- **[P] NO HAY ENTERO ESTRICTAMENTE ENTRE 1 Y 2.** -/
theorem no_integer_between_one_and_two (x : ℝ) (h1 : 1 < x) (h2 : x < 2) :
    ¬ ∃ m : ℤ, (m : ℝ) = x := by
  rintro ⟨m, rfl⟩
  have hm1 : (1 : ℤ) < m := by exact_mod_cast h1
  have hm2 : m < (2 : ℤ) := by exact_mod_cast h2
  omega

/-- **[P] ★ LA RESTRICCIÓN CRISTALOGRÁFICA, DIRECCIÓN DE EXCLUSIÓN.**
    Para `n ≥ 7` la traza de `ζₙ` no es un entero.  Junto con el
    pentágono (n = 5, 10) y la tabulación de los cinco, esto cierra
    `2cos(2π/n) ∈ ℤ ⟺ n ∈ {1,2,3,4,6}`. -/
theorem trZeta_not_integer_of_ge_seven (hw : CosineWindow) (n : ℕ) (hn : 7 ≤ n) :
    ¬ ∃ m : ℤ, (m : ℝ) = trZeta n :=
  no_integer_between_one_and_two _
    (trZeta_strictly_between hw n hn).1 (trZeta_strictly_between hw n hn).2

/-- **[P] LA LISTA, COMO CONJUNTO.** -/
theorem crystallographic_elements :
    crystallographic = {1, 2, 3, 4, 6} := rfl

theorem five_not_crystallographic : 5 ∉ crystallographic := by decide

theorem ten_not_crystallographic : 10 ∉ crystallographic := by decide

theorem three_is_crystallographic : 3 ∈ crystallographic := by decide

theorem four_is_crystallographic : 4 ∈ crystallographic := by decide

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §129.3  ·  LAS CUATRO PUERTAS SE PARTEN POR INTEGRALIDAD        ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- Las cuatro puertas del corpus: `ω, i, ζ₅, ζ₁₀` de órdenes 3, 4, 5, 10. -/
def fourGates : Finset ℕ := {3, 4, 5, 10}

/-- **[P] ★ LAS CUATRO PUERTAS SE PARTEN EN DOS Y DOS, Y EL CORTE ES LA
    RESTRICCIÓN CRISTALOGRÁFICA.**  `ω` y `i` tienen traza entera —`−1`
    y `0`—; `ζ₅` y `ζ₁₀` no.

    ESTO RESPONDE DÓNDE ESTÁ EL TERNARIO.  `3 ∤ 20` no porque el
    ternario esté fuera de la estructura, sino porque **no aporta
    conductor**: su traza ya vive en ℤ.  Está del lado de `i`. -/
theorem four_gates_split_by_integrality :
    (fourGates ∩ crystallographic = {3, 4}) ∧
    (fourGates \ crystallographic = {5, 10}) := by
  refine ⟨by decide, by decide⟩

/-- **[O] Y LA MITAD ENTERA ES EXACTAMENTE LA QUE NO NECESITA √5.**
    `μ₃ = cos(π/3) = 1/2` es `trZeta 6 / 2`, y `n = 6` es el único
    orden con traza `1`.  RECTIFICACIÓN: esto NO es una séptima pata
    del cocono — es la TERCERA (`cos(π/3)`) con su índice a la vista. -/
theorem apex_is_the_sixth_gate_half
    (h6 : Real.cos (2 * Real.pi / 6) = 1/2) :
    trZeta 6 / 2 = 1 / 2 ∧ Real.cos (Real.pi / 3) = 1 / 2 := by
  constructor
  · simp only [trZeta]; norm_num [h6]
  · rw [show (Real.pi / 3) = 2 * Real.pi / 6 by ring, h6]

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §129.4  ·  C₁ ES EL ÚNICO PUNTO COMÚN A LAS DOS RAMAS           ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] ★ `1` ESTÁ EN LAS DOS RAMAS.**  Es `ζ₁` —traza `2` por
    `cos 0 = 1`— y es `φ⁰` —traza `2` por AM–GM con igualdad—.

    **ES EL ÚNICO.**  Toda otra raíz de la unidad tiene `|traza| < 2`
    y todo otro monomio `φ^k` tiene `traza > 2`.  Luego la exclusión
    de §XII («de 41 exponentes pasa exactamente `k = 0`») no es un
    hecho sobre la torre: es que `k = 0` es donde la torre TOCA el
    círculo, y el único orden con traza `2` es `n = 1`. -/
theorem one_is_the_common_unit (h1 : Real.cos (2 * Real.pi / 1) = 1) :
    trZeta 1 = 2 ∧ e1P 1 = 2 ∧ discP 1 = 0 := by
  refine ⟨?_, ?_, ?_⟩
  · simp only [trZeta]; norm_num [h1]
  · unfold e1P; norm_num
  · unfold discP e1P; norm_num

/-- **[P] LA FRONTERA ES LA ÚNICA INTERSECCIÓN, en forma de tricotomía.**
    Para `r > 0`: o `discP r > 0` (hiperbólico, la torre), o `discP r = 0`
    (parabólico, `C₁` y la línea), y NUNCA `discP r < 0`.  La rama
    elíptica es VACÍA sobre los coordenadas de ceros: vive en la
    estructura, no en los ceros.  Ésa es §128 leída en la traza. -/
theorem trichotomy_on_positives (r : ℝ) (hr : 0 < r) :
    (0 < discP r ∨ discP r = 0) ∧ ¬ (discP r < 0) := by
  have h2 := tr_ge_two_of_pos r hr
  unfold discP
  constructor
  · rcases eq_or_lt_of_le h2 with h | h
    · right; rw [← h]; norm_num
    · left; nlinarith
  · intro hneg; nlinarith

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §129.5  ·  LOS DOS SPANS, Y EL PUSHOUT ES EL MISMO              ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] EL SPAN DEL CORPUS**, degenerado: `gcd(4,5) = 1`.
    Es `chain_iv` / `conductor_from_periods`, reproducido para
    ponerlo junto al otro. -/
theorem corpus_span : Nat.lcm 4 5 = 20 ∧ Nat.gcd 4 5 = 1 := by
  refine ⟨by decide, by decide⟩

/-- **[P] ★ EL SPAN NO DEGENERADO**, disponible porque `ζ₁₀` YA ESTÁ en
    el corpus (`zeta10_pow_ten`, `φ = ζ₁₀ + ζ₁₀⁻¹`): `gcd(4,10) = 2`.

    MISMO PUSHOUT, ESQUINA DISTINTA.  El `C₂` compartido es la
    involución de orden dos, que abajo es `τ : s ↦ 1 − s`, cuyo punto
    fijo es `1/2`.  Con este span el cuadrado tiene la misma forma que
    el de M₁₂ (`C₄ ← C₂ → C₆`), y transfiere. -/
theorem nondegenerate_span : Nat.lcm 4 10 = 20 ∧ Nat.gcd 4 10 = 2 := by
  refine ⟨by decide, by decide⟩

/-- **[P] LOS DOS SPANS DAN EL MISMO CONDUCTOR.**  No hay que elegir:
    son dos presentaciones del mismo pushout.  RECTIFICACIÓN E‑156: una
    redacción anterior decía que el argumento «selecciona 5, no 20» y
    que no se podían fundir.  Es falso — se funden por CRT, y el
    conductor es el del bicuadrático (§129.6). -/
theorem both_spans_same_pushout :
    Nat.lcm 4 5 = Nat.lcm 4 10 ∧ Nat.gcd 4 5 ≠ Nat.gcd 4 10 := by
  refine ⟨by decide, by decide⟩

/-- **[P] EL RETÍCULO DE DIVISORES DE 20 SE PARTE POR LA RESTRICCIÓN.**
    `{1,2,4}` cristalográficos; `{5,10,20}` prohibidos.  Y `5` es
    primo, luego `C₅` no tiene subgrupos propios: **el lado 5 es
    RÍGIDO**.  En M₁₂, en cambio, 12 es altamente compuesto y la torre
    de resoluciones es rica.  Ésa es la asimetría de fondo entre los
    dos proyectos, y explica `admissible_locus_fibred`: constante en la
    cara cristalográfica, variable en la cuasicristalina. -/
theorem twenty_divisor_lattice_splits :
    ((Nat.divisors 20).filter (· ∈ crystallographic) = {1, 2, 4}) ∧
    ((Nat.divisors 20).filter (¬ · ∈ crystallographic) = {5, 10, 20}) ∧
    Nat.Prime 5 := by
  refine ⟨by decide, by decide, by decide⟩

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §129.6  ·  EL BICUADRÁTICO: TRES SUBCUERPOS, TRES DISCS         ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- Las ocho unidades mod 20. -/
def U20 : Finset (ZMod 20) := {1, 3, 7, 9, 11, 13, 17, 19}

/-- `χ₄` como signo entero: `+1` en `1 mod 4`, `−1` en `3 mod 4`. -/
def chi4Z (a : ZMod 20) : ℤ := if a.val % 4 = 1 then 1 else -1

/-- `χ₅` como signo entero: `+1` en los residuos cuadráticos mod 5. -/
def chi5Z (a : ZMod 20) : ℤ := if a.val % 5 = 1 ∨ a.val % 5 = 4 then 1 else -1

/-- **[P] `G` ES EL PAR `(χ₄, χ₅)`.**  El corpus prueba `G_pi1_is_chi4`
    y `G_pi2_is_chi5` por separado; aquí el par, con valores enteros. -/
theorem G_is_the_character_pair :
    (∀ a ∈ U20, chi4Z a = 1 ↔ a.val % 4 = 1) ∧
    (∀ a ∈ U20, chi5Z a = 1 ↔ (a.val % 5 = 1 ∨ a.val % 5 = 4)) := by
  refine ⟨by decide, by decide⟩

/-- **[P] ★ EL NÚCLEO ES `{1, 9}`: DONDE AMBOS CARACTERES VALEN `+1`.**
    Es exactamente el subgrupo que fija ℚ(i,√5), y su cardinal `2` es
    el `|ker G| = 2` del corpus —el que da la contracción `1/μ₃ = 2`. -/
theorem biquadratic_kernel :
    U20.filter (fun a => chi4Z a = 1 ∧ chi5Z a = 1) = {1, 9} := by decide

/-- **[P] ★ LOS TRES SUBCUERPOS CUADRÁTICOS, POR SUS CARACTERES.**
    `χ₄` fija los `a` con `χ₄ = +1`  →  ℚ(i),      disc `−4`
    `χ₅` fija los `a` con `χ₅ = +1`  →  ℚ(√5),     disc `  5`
    `χ₄χ₅` fija su producto `= +1`   →  ℚ(√−5),    disc `−20`
    y `(−4)·5 = −20`, `|−4|·5 = 20`. -/
theorem three_quadratic_subfields :
    (U20.filter (fun a => chi4Z a = 1) = {1, 9, 13, 17}) ∧
    (U20.filter (fun a => chi5Z a = 1) = {1, 9, 11, 19}) ∧
    (U20.filter (fun a => chi4Z a * chi5Z a = 1) = {1, 3, 7, 9}) ∧
    ((-4 : ℤ) * 5 = -20) ∧
    ((4 : ℕ) * 5 = 20) := by
  refine ⟨by decide, by decide, by decide, by norm_num, by norm_num⟩

/-- **[P] EL CONTEO SE PARTE POR CARAS.**  `φ(20) = φ(4)·φ(5) = 2·4 = 8`.
    (Está en `no_outside` del corpus; se cita aquí para el ensamblaje.) -/
theorem totient_splits : Nat.totient 20 = 8 ∧ Nat.totient 4 * Nat.totient 5 = 8 := by
  refine ⟨by decide, by decide⟩

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §129.7  ·  RANGO DE UNIDADES: DIRICHLET PARTE LAS RAMAS         ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[C] EL TEOREMA DE LAS UNIDADES DE DIRICHLET**, sobre los tres
    subcuerpos, como entrada clásica en la firma.  `rango = r₁ + r₂ − 1`:

      ℚ(i)     r₁=0 r₂=1  →  rango 0
      ℚ(√−5)   r₁=0 r₂=1  →  rango 0
      ℚ(√5)    r₁=2 r₂=0  →  rango 1

    Formalizar Dirichlet excede este módulo; entra como hipótesis
    explícita, tier [C], igual que `hecke_1920` en el corpus. -/
structure DirichletRanks where
  /-- Signatura de ℚ(i): totalmente imaginario. -/
  imag_i     : (0 : ℕ) + 1 - 1 = 0
  /-- Signatura de ℚ(√−5): totalmente imaginario. -/
  imag_neg5  : (0 : ℕ) + 1 - 1 = 0
  /-- Signatura de ℚ(√5): totalmente real. -/
  real_five  : (2 : ℕ) + 0 - 1 = 1

/-- **[P] LAS SIGNATURAS DAN LOS RANGOS.**  Aritmética pura. -/
theorem dirichlet_ranks_arithmetic :
    (0 : ℕ) + 1 - 1 = 0 ∧ (0 : ℕ) + 1 - 1 = 0 ∧ (2 : ℕ) + 0 - 1 = 1 := by
  refine ⟨by norm_num, by norm_num, by norm_num⟩

/-- **[C] LA CONSECUENCIA, enunciada como predicado.**  Un cuerpo de
    rango `0` sólo tiene unidades de torsión, y la traza de una torsión
    es `2cos` de un ángulo, luego `|traza| ≤ 2`.  Un cuerpo de rango `1`
    tiene una unidad fundamental `ε > 1`, y `traza(ε^k) = 2cosh(k log ε)`
    crece sin cota. -/
def UnitRankSplitsBranches (ε : ℝ) : Prop :=
  (∀ θ : ℝ, |2 * Real.cos θ| ≤ 2) ∧ (1 < ε) ∧ (∀ k : ℕ, 2 ≤ e1P (ε ^ k))

/-- **[P] ★ LA MITAD DEMOSTRABLE: la cota angular es incondicional, y la
    cota radial sale de AM–GM.**  Sólo el `rango` en sí es clásico. -/
theorem unit_rank_splits_branches (ε : ℝ) (hε : 1 < ε) :
    UnitRankSplitsBranches ε := by
  refine ⟨?_, hε, ?_⟩
  · intro θ
    rw [abs_le]
    constructor <;> nlinarith [Real.neg_one_le_cos θ, Real.cos_le_one θ]
  · intro k
    exact tr_ge_two_of_pos _ (pow_pos (by linarith) k)

/-- **[O] ★ LO QUE ESTO REORDENA.**  La tricotomía elíptico / parabólico
    / hiperbólico de `discP` deja de ser una observación sobre signos y
    pasa a ser el teorema de las unidades sobre el bicuadrático del
    conductor: **torsión en los dos imaginarios, rango uno en el real**.
    `C₁` es la única unidad común a los tres. -/
theorem branches_are_the_unit_groups (ε : ℝ) (hε : 1 < ε) :
    ((-4 : ℤ) * 5 = -20)
    ∧ ((0 : ℕ) + 1 - 1 = 0)
    ∧ ((2 : ℕ) + 0 - 1 = 1)
    ∧ UnitRankSplitsBranches ε :=
  ⟨by norm_num, by norm_num, by norm_num, unit_rank_splits_branches ε hε⟩

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §129.8  ·  LA TRAZA RECENTRADA Y LA DESIGUALDAD TRIANGULAR      ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] ★ LEY DEL PARALELOGRAMO: EL NUMERADOR ES UN CÍRCULO CENTRADO
    EN 1/2.**  `|ρ−1|² + |ρ|² = 2|ρ − 1/2|² + 1/2`.

    El corpus lo tiene como `1 − 2β + 2β² + 2γ²`
    (`the_numerator_is_rational_in_beta_and_gamma`).  Ésta es la misma
    expresión recentrada, donde se ve QUÉ curva es. -/
theorem numerator_is_a_circle (ρ : ℂ) :
    Complex.abs (ρ - 1) ^ 2 + Complex.abs ρ ^ 2
      = 2 * Complex.abs (ρ - 1/2) ^ 2 + 1/2 := by
  simp only [Complex.sq_abs, Complex.normSq_apply, Complex.sub_re, Complex.sub_im,
             Complex.one_re, Complex.one_im, Complex.div_re, Complex.div_im]
  norm_num
  ring

/-- **[P] ★ EL DENOMINADOR ES UN ÓVALO DE CASSINI.**
    `|ρ−1|·|ρ| = |(ρ − 1/2)² − 1/4|`, con focos `0` y `1`. -/
theorem denominator_is_a_cassini_oval (ρ : ℂ) :
    Complex.abs (ρ - 1) * Complex.abs ρ
      = Complex.abs ((ρ - 1/2) ^ 2 - 1/4) := by
  simp only [Complex.abs]
  rw [← norm_mul]
  congr 1
  ring

/-- **[P] ★★ LA TRAZA RECENTRADA.**  Componiendo las dos:

        t  =  ( 2|z|² + 1/2 ) / |z² − 1/4|,      z = ρ − 1/2

    Numerador: círculos centrados en la línea.  Denominador: Cassini
    con focos `0` y `1`.  Y la línea crítica es donde el círculo de
    Apolonio degenera en recta —el eje radical del haz—. -/
theorem trace_recentred (ρ : ℂ) (h0 : ρ ≠ 0) (h1 : ρ ≠ 1) :
    (Complex.abs (ρ - 1) ^ 2 + Complex.abs ρ ^ 2)
        / (Complex.abs (ρ - 1) * Complex.abs ρ)
      = (2 * Complex.abs (ρ - 1/2) ^ 2 + 1/2)
        / Complex.abs ((ρ - 1/2) ^ 2 - 1/4) := by
  rw [numerator_is_a_circle, denominator_is_a_cassini_oval]

/-- **[P] ★★ `t ≥ 2` ES LA DESIGUALDAD TRIANGULAR.**
    `|z² − 1/4| ≤ |z²| + 1/4 = |z|² + 1/4`, luego el cociente es `≥ 2`.

    **ESTO ES LO QUE APORTA LA GEOMETRÍA.**  `t = 2` no es un valor
    distinguido por accidente: es el caso de DEGENERACIÓN de la
    desigualdad triangular, que es lo mismo que decir que el círculo
    de Apolonio se aplana en el eje radical. -/
theorem trace_ge_two_by_triangle (z : ℂ) (hz : (z ^ 2 - 1/4) ≠ 0) :
    2 ≤ (2 * Complex.abs z ^ 2 + 1/2) / Complex.abs (z ^ 2 - 1/4) := by
  have hden : 0 < Complex.abs (z ^ 2 - 1/4) := by
    exact Complex.abs.pos hz
  rw [le_div_iff' hden]
  -- Triangle inequality: |z² - 1/4| ≤ |z²| + |1/4| = |z|² + 1/4
  have htri : Complex.abs (z ^ 2 - 1/4) ≤ Complex.abs z ^ 2 + 1/4 := by
    have h1 : Complex.abs (z ^ 2 - 1/4) ≤ Complex.abs (z ^ 2) + Complex.abs (1/4 : ℂ) :=
      norm_sub_le (z ^ 2) (1/4 : ℂ)
    have h2 : Complex.abs (z ^ 2) = Complex.abs z ^ 2 := by simp [Complex.abs, sq]
    have h3 : Complex.abs (1/4 : ℂ) = (1/4 : ℝ) := by simp [Complex.abs]
    linarith
  linarith

/-- **[P] EN LA LÍNEA LOS DOS FACTORES COINCIDEN.**  `Re ρ = 1/2`
    implica `|ρ−1| = |ρ|`, luego el producto es el cuadrado del factor
    común y `t = 2` sin más.

    RECTIFICACIÓN E‑154: el corpus ya tiene esto como
    `on_the_line_the_two_factors_agree`.  Se reproduce aquí SÓLO para
    exhibir la razón geométrica —el punto equidista de los dos focos—
    y no como aportación. -/
theorem on_the_line_equidistant (ρ : ℂ) (h : ρ.re = 1/2) :
    Complex.abs (ρ - 1) = Complex.abs ρ := by
  have hsq : Complex.normSq (ρ - 1) = Complex.normSq ρ := by
    simp only [Complex.normSq_apply, Complex.sub_re, Complex.sub_im,
               Complex.one_re, Complex.one_im, h]
    ring
  have h1 := Complex.sq_abs (ρ - 1)
  have h2 := Complex.sq_abs ρ
  have habssq : Complex.abs (ρ - 1) ^ 2 = Complex.abs ρ ^ 2 := by rw [h1, h2, hsq]
  have ha := Complex.abs.nonneg (ρ - 1)
  have hb := Complex.abs.nonneg ρ
  nlinarith [sq_nonneg (Complex.abs (ρ - 1) - Complex.abs ρ),
             sq_nonneg (Complex.abs (ρ - 1) + Complex.abs ρ)]

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §129.9  ·  τ GENERA LAS DOS PARIDADES                           ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] LA CONJUGADA DE φ ES `−1/φ`, Y LA NORMA ES `−1`.**
    Ese signo ES `τ`.  El `(−1)^k` de `lucas_fib_norm` es su acción
    sobre `φ^k`. -/
theorem norm_phi_is_minus_one (φ : ℝ) (hφ : φ ^ 2 = φ + 1) (hne : φ ≠ 0) :
    φ * (1 - φ) = -1 ∧ (1 - φ) = -(1/φ) := by
  constructor
  · nlinarith [hφ]
  · field_simp; nlinarith [hφ]

/-- **[P] `χ₅` ES PAR Y `χ₄` ES IMPAR.**  `χ₅(−1) = +1` porque
    `−1 ≡ 4 = 2²` es residuo mod 5; `χ₄(−1) = −1` porque `−1 ≡ 3 mod 4`.
    Las dos paridades del conductor, en un solo `decide`. -/
theorem chi5_even_chi4_odd :
    chi5Z 19 = 1 ∧ chi4Z 19 = -1 ∧ chi5Z 9 = 1 ∧ chi4Z 9 = 1 := by
  refine ⟨by decide, by decide, by decide, by decide⟩

/-- **[O] ★★ LA MISMA `τ`, ARRIBA Y ABAJO.**  RECTIFICACIÓN E‑157: una
    redacción anterior llamó a esto «encuadre, no teorema».  Es falso:

      arriba  —  `χ₅(−1) = +1`   (la paridad del carácter)
      abajo   —  `N(φ) = −1`     (la norma de la unidad fundamental)

    son la MISMA involución de `im G ≅ ℤ/2 × ℤ/2`, y por eso
    `trace_integral_iff_even` y la partición par/impar de los valores
    `L` no son dos hechos: son los espacios propios `±1` de `τ`.

    CAUTELA QUE SIGUE EN PIE: la forma cerrada de `L(2k, χ₅)` —la
    potencia de `√5` y el signo de la suma de Gauss— NO está verificada
    aquí y no debe entrar al paper sin comprobarse. -/
theorem tau_generates_both_parities (φ : ℝ) (hφ : φ ^ 2 = φ + 1) (hne : φ ≠ 0) :
    (φ * (1 - φ) = -1) ∧ (chi5Z 19 = 1) ∧ (chi4Z 19 = -1) :=
  ⟨(norm_phi_is_minus_one φ hφ hne).1, by decide, by decide⟩

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §129.10  ·  EL GRADO DE LA TRAZA Y LOS TRES CONDUCTORES         ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- El grado de `2cos(2π/n)` sobre ℚ, para `n ≥ 3`: es `φ(n)/2`. -/
def traceDegree (n : ℕ) : ℕ := Nat.totient n / 2

/-- **[P] GRADO 1 ⟺ CRISTALOGRÁFICO** (para `3 ≤ n < 60`, por `decide`;
    el caso general se sigue de `φ(n) → ∞`). -/
theorem degree_one_iff_crystallographic :
    ((Finset.Ico 3 60).filter (fun n => traceDegree n = 1)) = {3, 4, 6} := by decide

/-- **[P] ★ EL FALLO MÍNIMO ES GRADO 2, Y DA EXACTAMENTE CUATRO ÓRDENES.**
    `φ(n) = 4 ⟺ n ∈ {5, 8, 10, 12}`. -/
theorem degree_two_orders :
    ((Finset.Ico 3 60).filter (fun n => traceDegree n = 2)) = {5, 8, 10, 12} := by decide

/-- **[P] ★★ Y SUS CUERPOS REALES SON LOS TRES CONDUCTORES DEL CORPUS.**

      n = 5, 10  →  ℚ(√5)   disc  5     (φ)
      n = 8      →  ℚ(√2)   disc  8
      n = 12     →  ℚ(√3)   disc 12

    Ésos son, literalmente, los tres cuerpos de la tabla de transporte
    (`§10.AB`, `verify_transport_repulsion.py`: ℚ(√5) con 5, ℚ(√2) con
    8, ℚ(√3) con 12).  **No son tres cuerpos elegidos: son los tres que
    fallan la restricción cristalográfica por el margen mínimo.**  Y el
    5 es el menor.

    Esto da a `scale_injective_in_conductor` un origen que hoy no
    tiene: el conductor no es un parámetro que resulta rígido, es el
    discriminante forzado por el grado de la traza. -/
theorem three_conductors_are_the_minimal_failure
    (h5  : trZeta 5  = (Real.sqrt 5 - 1) / 2)
    (h8  : trZeta 8  = Real.sqrt 2)
    (h12 : trZeta 12 = Real.sqrt 3) :
    (traceDegree 5 = 2 ∧ traceDegree 8 = 2 ∧ traceDegree 12 = 2)
    ∧ (5 < 8 ∧ 8 < 12)
    ∧ (trZeta 8 = Real.sqrt 2 ∧ trZeta 12 = Real.sqrt 3) := by
  refine ⟨⟨by decide, by decide, by decide⟩, ⟨by norm_num, by norm_num⟩, ⟨h8, h12⟩⟩

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §129.11  ·  ENSAMBLAJE                                          ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] ★★★ UNA OPERACIÓN, DOS REBANADAS, UNA FRONTERA.**

    (1) `discP = (parte impar)²`: traza y discriminante son las dos
        mitades de `r ↦ r ± 1/r`.
    (2) ANGULAR: para `n ≥ 7` la traza cae estrictamente entre 1 y 2,
        luego no es entera; con el pentágono fuera, quedan
        `{1,2,3,4,6}`.
    (3) RADIAL: para `r > 0` la traza es `≥ 2`, con igualdad sólo en 1.
    (4) FRONTERA: `discP r = 0 ⟺ e1P r = 2 ⟺ r = 1`, que es `C₁`, el
        único punto de las dos ramas.
    (5) CUATRO PUERTAS: `{3,4}` enteras, `{5,10}` no — el ternario está
        del lado de `i`.
    (6) BICUADRÁTICO: `ker G = {1,9}`, tres subcuerpos, `|−4|·5 = 20`.
    (7) GEOMETRÍA: numerador circular, denominador Cassini, y `t ≥ 2`
        por desigualdad triangular.
    (8) GRADO: el fallo mínimo da `{5,8,10,12}` y los tres conductores.

    **NO PRUEBA `E`.**  (3) y (4) reprueban `coord_eq_one_iff_re_half`
    por otra vía; su valor es exhibir por qué `t = 2` está distinguido. -/
theorem the_circle_and_the_tower
    (hw : CosineWindow) (r : ℝ) (hr : 0 < r) (z : ℂ) (hz : z ^ 2 - 1/4 ≠ 0)
    (h1 : Real.cos (2 * Real.pi / 1) = 1) :
    -- (1) las dos mitades
    (r ≠ 0 → discP r = (r - 1 / r) ^ 2)
    -- (2) rama angular: exclusión
    ∧ (∀ n : ℕ, 7 ≤ n → ¬ ∃ m : ℤ, (m : ℝ) = trZeta n)
    -- (3) rama radial: cota
    ∧ (2 ≤ e1P r)
    -- (4) la frontera, y es C₁
    ∧ (discP r = 0 ↔ r = 1)
    ∧ (trZeta 1 = 2)
    -- (5) las cuatro puertas
    ∧ (fourGates ∩ crystallographic = {3, 4})
    ∧ (fourGates \ crystallographic = {5, 10})
    -- (6) el bicuadrático
    ∧ (U20.filter (fun a => chi4Z a = 1 ∧ chi5Z a = 1) = {1, 9})
    ∧ ((-4 : ℤ) * 5 = -20)
    -- (7) la geometría
    ∧ (2 ≤ (2 * Complex.abs z ^ 2 + 1/2) / Complex.abs (z ^ 2 - 1/4))
    -- (8) el grado
    ∧ (((Finset.Ico 3 60).filter (fun n => traceDegree n = 2)) = {5, 8, 10, 12}) := by
  refine ⟨fun h => dsc_eq_odd_part_sq r h,
          fun n hn => trZeta_not_integer_of_ge_seven hw n hn,
          tr_ge_two_of_pos r hr,
          ?_,
          (one_is_the_common_unit h1).1,
          four_gates_split_by_integrality.1,
          four_gates_split_by_integrality.2,
          biquadratic_kernel,
          by norm_num,
          trace_ge_two_by_triangle z hz,
          degree_two_orders⟩
  rw [dsc_zero_iff_tr_two r hr, tr_eq_two_iff r hr]

-- ═══════════════════════════════════════════════════════════
-- §130  ·  Joukowski, confocales, focos ±2
-- ═══════════════════════════════════════════════════════════

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §130.1  ·  LA TRAZA ES JOUKOWSKI                                ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- El mapa de Joukowski.  Es `e1P` del corpus, extendido a ℂ. -/
def jouk (w : ℂ) : ℂ := w + 1 / w

/-- La coordenada de Möbius.  `|liW ρ|` es el `zeroCoord` del corpus. -/
def liW (ρ : ℂ) : ℂ := (ρ - 1) / ρ

/-- **[P] `liW` MANDA `1 ↦ 0`.**  El foco de la coordenada. -/
theorem liW_one : liW 1 = 0 := by unfold liW; norm_num

/-- **[P] LOS DOS FOCOS SON `±2`, Y SON EL LOCUS PARABÓLICO.**
    `J(1) = 2`, `J(−1) = −2`, y en ambos `J² − 4 = 0`. -/
theorem jouk_foci :
    jouk 1 = 2 ∧ jouk (-1) = -2 ∧ (jouk 1) ^ 2 - 4 = 0 ∧ (jouk (-1)) ^ 2 - 4 = 0 := by
  refine ⟨by unfold jouk; norm_num, by unfold jouk; norm_num,
          by unfold jouk; norm_num, by unfold jouk; norm_num⟩

/-- **[P] LA PARTE REAL Y LA IMAGINARIA DE `J` EN POLARES.**
    Para `w = r·(cos θ + i sin θ)` con `r ≠ 0`:

        Re J = (r + 1/r)·cos θ,     Im J = (r − 1/r)·sin θ

    Ésta es la ecuación de la que sale toda la figura. -/
theorem jouk_polar (r θ : ℝ) (hr : r ≠ 0) :
    (jouk (r * Complex.exp (θ * Complex.I))).re = (r + 1/r) * Real.cos θ ∧
    (jouk (r * Complex.exp (θ * Complex.I))).im = (r - 1/r) * Real.sin θ := by
  have hz_re : (r * Complex.exp (θ * Complex.I)).re = r * Real.cos θ := by
    simp [Complex.mul_re, Complex.exp_re, Complex.exp_im, Complex.ofReal_re, Complex.ofReal_im,
          Complex.I_re, Complex.I_im, Real.exp_zero]
  have hz_im : (r * Complex.exp (θ * Complex.I)).im = r * Real.sin θ := by
    simp [Complex.mul_im, Complex.exp_re, Complex.exp_im, Complex.ofReal_re, Complex.ofReal_im,
          Complex.I_re, Complex.I_im, Real.exp_zero]
  have hnsq : Complex.normSq (r * Complex.exp (θ * Complex.I)) = r ^ 2 := by
    simp [Complex.normSq_eq_norm_sq, Complex.norm_exp]
  constructor
  · simp only [jouk, Complex.add_re, Complex.div_re]
    rw [hz_re, hz_im, hnsq]
    simp [Complex.one_re, Complex.one_im]
    field_simp
  · simp only [jouk, Complex.add_im, Complex.div_im]
    rw [hz_re, hz_im, hnsq]
    simp [Complex.one_re, Complex.one_im]
    field_simp
    ring

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §130.2  ·  APOLONIO VA A ELIPSES CONFOCALES                     ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- Semieje mayor de la imagen del círculo `|w| = r`. -/
def ellA (r : ℝ) : ℝ := r + 1/r

/-- Semieje menor. -/
def ellB (r : ℝ) : ℝ := r - 1/r

/-- **[P] ★★ LA IMAGEN DE UN CÍRCULO DE APOLONIO ES UNA ELIPSE.**
    Con `x = a·cos θ`, `y = b·sin θ` se tiene `x²/a² + y²/b² = 1`. -/
theorem apollonius_maps_to_ellipse (r θ : ℝ) (ha : ellA r ≠ 0) (hb : ellB r ≠ 0) :
    (ellA r * Real.cos θ) ^ 2 / (ellA r) ^ 2
      + (ellB r * Real.sin θ) ^ 2 / (ellB r) ^ 2 = 1 := by
  field_simp
  nlinarith [Real.cos_sq_add_sin_sq θ]

/-- **[P] ★★★ TODAS LAS ELIPSES SON CONFOCALES, CON FOCOS `±2`.**

        a² − b² = (r + 1/r)² − (r − 1/r)² = 4

    UNA LÍNEA, Y ES EL CENTRO DE TODO.  La distancia focal no depende de
    `r`: **el haz de Apolonio entero va a un sistema confocal cuyos focos
    son `±2`, es decir el locus parabólico `disc = 0`.** -/
theorem ellipses_are_confocal (r : ℝ) (hr : r ≠ 0) :
    (ellA r) ^ 2 - (ellB r) ^ 2 = 4 := by
  unfold ellA ellB
  field_simp
  ring

/-- **[P] LA ELIPSE DEGENERA EXACTAMENTE EN `r = 1`.**  Semieje menor
    nulo: la elipse se aplasta sobre el segmento `[−2, 2]` que une los
    focos.  **Y `r = 1` es `E`.** -/
theorem ellipse_degenerates_iff_r_one (r : ℝ) (hr : 0 < r) :
    ellB r = 0 ↔ r = 1 := by
  unfold ellB
  constructor
  · intro h
    have : r * r = 1 := by field_simp at h; nlinarith [h]
    nlinarith [this, hr]
  · rintro rfl; norm_num

/-- **[P] Y ENTONCES LA IMAGEN ES EL SEGMENTO ENTRE LOS FOCOS.**
    En `r = 1`: `a = 2`, `b = 0`, y `J(e^{iθ}) = 2cos θ ∈ [−2,2]`. -/
theorem unit_circle_flattens_to_segment (θ : ℝ) :
    ellA 1 = 2 ∧ ellB 1 = 0 ∧ |2 * Real.cos θ| ≤ 2 := by
  refine ⟨by unfold ellA; norm_num, by unfold ellB; norm_num, ?_⟩
  rw [abs_le]
  constructor <;> nlinarith [Real.neg_one_le_cos θ, Real.cos_le_one θ]

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §130.3  ·  EL HAZ ORTOGONAL VA A HIPÉRBOLAS, MISMOS FOCOS       ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] ★★ LA IMAGEN DE UN RAYO `arg w = θ` ES UNA HIPÉRBOLA.**
    `x²/(2cos θ)² − y²/(2 sin θ)² = 1`, usando `a² − b² = 4`. -/
theorem orthogonal_pencil_maps_to_hyperbola (r θ : ℝ) (hr : r ≠ 0)
    (hc : Real.cos θ ≠ 0) (hs : Real.sin θ ≠ 0) :
    (ellA r * Real.cos θ) ^ 2 / (2 * Real.cos θ) ^ 2
      - (ellB r * Real.sin θ) ^ 2 / (2 * Real.sin θ) ^ 2 = 1 := by
  have h4 : (ellA r) ^ 2 - (ellB r) ^ 2 = 4 := ellipses_are_confocal r hr
  field_simp
  nlinarith [h4]

/-- **[P] ★★★ Y TIENEN LOS MISMOS FOCOS `±2`.**
    `(2cos θ)² + (2 sin θ)² = 4`.  Para hipérbolas la distancia focal es
    `a² + b²`; vale 4, igual que `a² − b²` para las elipses.

    **LOS DOS HACES COAXIALES DE LA GEOMETRÍA DE LOS CEROS VAN AL MISMO
    SISTEMA CONFOCAL.**  Apolonio da las elipses; el haz ortogonal —el
    círculo segmentado, donde viven los `Cₙ`— da las hipérbolas.  Es una
    figura, no dos. -/
theorem hyperbolas_share_the_foci (θ : ℝ) :
    (2 * Real.cos θ) ^ 2 + (2 * Real.sin θ) ^ 2 = 4 := by
  nlinarith [Real.cos_sq_add_sin_sq θ]

/-- **[P] ★★ EL SISTEMA ES UNO: misma constante focal por los dos lados. -/
theorem one_confocal_system (r θ : ℝ) (hr : r ≠ 0) :
    (ellA r) ^ 2 - (ellB r) ^ 2 = 4 ∧
    (2 * Real.cos θ) ^ 2 + (2 * Real.sin θ) ^ 2 = 4 :=
  ⟨ellipses_are_confocal r hr, hyperbolas_share_the_foci θ⟩

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §130.4  ·  LOS Cₙ SON LOS NODOS DE CHEBYSHEV DEL SEGMENTO       ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- El nodo `k`-ésimo de la segmentación en `n` partes, ya en el
    segmento entre los focos. -/
def node (n k : ℕ) : ℝ := 2 * Real.cos (2 * Real.pi * k / n)

/-- **[P] TODOS LOS NODOS CAEN ENTRE LOS FOCOS.**  La segmentación del
    círculo en `n` partes iguales se convierte, del otro lado de `J`, en
    `n` puntos de `[−2, 2]` — desigualmente espaciados. -/
theorem nodes_lie_between_the_foci (n k : ℕ) : |node n k| ≤ 2 := by
  unfold node
  rw [abs_le]
  constructor <;>
    nlinarith [Real.neg_one_le_cos (2 * Real.pi * k / n),
               Real.cos_le_one (2 * Real.pi * k / n)]

/-- **[P] `node n 0 = 2` PARA TODO `n`: el foco es nodo de toda
    segmentación.**  Ésa es la razón estructural de que `C₁` esté en
    todas las ramas (§129.4): el `1` del círculo va al foco. -/
theorem zeroth_node_is_the_focus (n : ℕ) : node n 0 = 2 := by
  unfold node; norm_num

/-- **[C] ★★ EL PENTÁGONO PONE `φ` Y `1/φ` EN EL SEGMENTO.**
    Entradas clásicas de coseno (mismo tier que `phi_is_the_pentagon_chord`
    del corpus §128):

        2cos(2π/5)  = 1/φ = φ − 1        nodo del pentágono
        2cos(π/5)   = φ                  nodo del decágono
        2cos(4π/5)  = −φ

    **ESTO ES LA RELACIÓN ENTRE φ Y EL PENTÁGONO, COMO TEOREMA.**  Una
    redacción anterior de esta sesión la llamó «encuadre, no teorema»
    (E‑157, retractada): φ no es un valor del coseno que resulta áureo,
    es el NODO DEL DECÁGONO en el segmento entre los focos del sistema
    confocal cuya degeneración es la línea crítica. -/
def PentagonNodes (φ : ℝ) : Prop :=
  Real.cos (2 * Real.pi / 5) = (φ - 1) / 2 ∧
  Real.cos (Real.pi / 5) = φ / 2 ∧
  Real.cos (4 * Real.pi / 5) = -φ / 2 ∧
  φ ^ 2 = φ + 1

/-- **[P] Y ENTONCES LOS TRES NODOS SON `1/φ`, `φ`, `−φ`. -/
theorem pentagon_nodes_are_golden (φ : ℝ) (hφ : PentagonNodes φ) (hne : φ ≠ 0) :
    2 * Real.cos (2 * Real.pi / 5) = 1 / φ ∧
    2 * Real.cos (Real.pi / 5) = φ ∧
    2 * Real.cos (4 * Real.pi / 5) = -φ := by
  obtain ⟨h5, h10, h45, hsq⟩ := hφ
  refine ⟨?_, by rw [h10]; ring, by rw [h45]; ring⟩
  rw [h5]
  field_simp
  nlinarith [hsq]

/-- **[P] ★ Y `φ · (1/φ) = 1`: LOS DOS NODOS DEL PENTÁGONO SON
    INVERSOS.**  Es la firma de que provienen del mismo `J`: `J(w)` y
    `J(1/w)` coinciden, luego el segmento está doblemente cubierto y los
    nodos aparecen en pares recíprocos. -/
theorem jouk_inverse_invariant (w : ℂ) (hw : w ≠ 0) : jouk (1 / w) = jouk w := by
  unfold jouk
  field_simp
  ring

/-- **[O] ★★ LA FIGURA COMPLETA, EN UNA FRASE.**
    El círculo unidad (`E`) es la elipse degenerada del sistema confocal
    de focos `±2`; los `Cₙ` son sus nodos; el pentágono aporta `φ`; y la
    restricción cristalográfica (§129.2) dice que sólo los nodos de
    `n ∈ {1,2,3,4,6}` son enteros — el pentágono no, y de ahí √5. -/
theorem the_whole_figure (r θ : ℝ) (hr : r ≠ 0) (n k : ℕ) :
    ((ellA r) ^ 2 - (ellB r) ^ 2 = 4)
    ∧ ((2 * Real.cos θ) ^ 2 + (2 * Real.sin θ) ^ 2 = 4)
    ∧ (|node n k| ≤ 2)
    ∧ (node n 0 = 2)
    ∧ (jouk 1 = 2 ∧ jouk (-1) = -2) :=
  ⟨ellipses_are_confocal r hr, hyperbolas_share_the_foci θ,
   nodes_lie_between_the_foci n k, zeroth_node_is_the_focus n,
   ⟨jouk_foci.1, jouk_foci.2.1⟩⟩

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §130.5  ·  APOLONIO EXPLÍCITO: EL CÍRCULO Y SU DEGENERACIÓN     ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] ★ LA ECUACIÓN DE APOLONIO.**  `|ρ−1| = k·|ρ|` equivale, para
    `k ≠ 1`, a un círculo de centro `1/(1−k²)` y radio `|k/(1−k²)|`. -/
theorem apollonius_circle_equation (ρ : ℂ) (k : ℝ) (hk : k ^ 2 ≠ 1) :
    Complex.abs (ρ - 1) ^ 2 = k ^ 2 * Complex.abs ρ ^ 2 ↔
      (ρ.re - 1 / (1 - k ^ 2)) ^ 2 + ρ.im ^ 2
        = (k / (1 - k ^ 2)) ^ 2 := by
  have h1 : 1 - k ^ 2 ≠ 0 := by intro h; apply hk; linarith
  simp only [Complex.sq_abs, Complex.normSq_apply, Complex.sub_re, Complex.sub_im,
             Complex.one_re, Complex.one_im]
  constructor
  · intro h
    have hnorm : (ρ.re ^ 2 + ρ.im ^ 2) * (1 - k ^ 2) = 2 * ρ.re - 1 := by nlinarith
    suffices (ρ.re * (1 - k ^ 2) - 1) ^ 2 + (1 - k ^ 2) ^ 2 * ρ.im ^ 2 = k ^ 2 by
      field_simp; linarith
    calc _ = (ρ.re ^ 2 + ρ.im ^ 2) * (1 - k ^ 2) ^ 2 - 2 * ρ.re * (1 - k ^ 2) + 1 := by ring
      _ = (ρ.re ^ 2 + ρ.im ^ 2) * (1 - k ^ 2) * (1 - k ^ 2) - 2 * ρ.re * (1 - k ^ 2) + 1 := by ring
      _ = (2 * ρ.re - 1) * (1 - k ^ 2) - 2 * ρ.re * (1 - k ^ 2) + 1 := by rw [hnorm]
      _ = k ^ 2 := by ring
  · intro h
    have key : (ρ.re * (1 - k ^ 2) - 1) ^ 2 + (1 - k ^ 2) ^ 2 * ρ.im ^ 2 = k ^ 2 := by
      field_simp at h; exact h
    have hnorm : (ρ.re ^ 2 + ρ.im ^ 2) * (1 - k ^ 2) = 2 * ρ.re - 1 := by
      have step1 : (1 - k ^ 2) * ((1 - k ^ 2) * (ρ.re ^ 2 + ρ.im ^ 2) - 2 * ρ.re) = -(1 - k ^ 2) := by
        calc _ = (ρ.re * (1 - k ^ 2) - 1) ^ 2 + (1 - k ^ 2) ^ 2 * ρ.im ^ 2 - 1 := by ring
          _ = k ^ 2 - 1 := by rw [key]
          _ = -(1 - k ^ 2) := by ring
      have : (1 - k ^ 2) * ((1 - k ^ 2) * (ρ.re ^ 2 + ρ.im ^ 2) - 2 * ρ.re + 1) = 0 := by linarith [step1]
      have := mul_eq_zero.mp this
      cases this with
      | inl h => exact absurd h h1
      | inr h => linarith [mul_comm (ρ.re ^ 2 + ρ.im ^ 2) (1 - k ^ 2)]
    nlinarith [hnorm]

/-- **[P] ★★ `k = 1` DEGENERA EN LA RECTA `Re ρ = 1/2`.**
    El círculo de Apolonio se aplana en el eje radical del haz — que es
    la línea crítica.  El corpus lo tiene como
    `liMap_abs_eq_one_iff_half`; aquí con la ecuación a la vista. -/
theorem apollonius_degenerates_to_the_line (ρ : ℂ) :
    Complex.abs (ρ - 1) ^ 2 = Complex.abs ρ ^ 2 ↔ ρ.re = 1/2 := by
  simp only [Complex.sq_abs, Complex.normSq_apply, Complex.sub_re, Complex.sub_im,
             Complex.one_re, Complex.one_im]
  constructor <;> intro h <;> nlinarith [h]

/-- **[O] LOS DOS HACES, NOMBRADOS.**  Los conjuntos de nivel de `|w|`
    (Apolonio, lo que el corpus usa) y los de `arg w` (el círculo
    segmentado, lo que M₁₂ usa) son los DOS HACES COAXIALES ORTOGONALES
    con puntos límite `0` y `1`.  La línea crítica es el eje radical.
    Bajo `J` van a las elipses y a las hipérbolas del mismo sistema. -/
theorem two_pencils_one_system (ρ : ℂ) (r θ : ℝ) (hr : r ≠ 0) :
    (Complex.abs (ρ - 1) ^ 2 = Complex.abs ρ ^ 2 ↔ ρ.re = 1/2)
    ∧ ((ellA r) ^ 2 - (ellB r) ^ 2 = 4)
    ∧ ((2 * Real.cos θ) ^ 2 + (2 * Real.sin θ) ^ 2 = 4) :=
  ⟨apollonius_degenerates_to_the_line ρ,
   ellipses_are_confocal r hr, hyperbolas_share_the_foci θ⟩

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §130.6  ·  `E` SE VUELVE UNILATERAL, Y EL SQUEEZE CIERRA        ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- La traza real, sobre la coordenada radial. -/
def trR (r : ℝ) : ℝ := r + 1 / r

/-- **[P] EL SUELO ES GRATIS.**  (§129: AM–GM / desigualdad triangular.) -/
theorem trR_ge_two (r : ℝ) (hr : 0 < r) : 2 ≤ trR r := by
  unfold trR
  have h : r + 1 / r - 2 = (r - 1) ^ 2 / r := by field_simp; ring
  nlinarith [sq_nonneg (r - 1), div_nonneg (sq_nonneg (r - 1)) hr.le, h]

/-- **[P] ★★ `E` ES UNILATERAL.**  Como `t ≥ 2` vale sin hipótesis,

        E  ⟺  ∀ρ,  t ≤ 2

    RECTIFICACIÓN de una redacción anterior de esta sesión, que dijo que
    `trace_ge_two_by_triangle` «no cierra nada».  Es engañoso: no cierra
    `E`, pero **parte el enunciado en la mitad probada y la mitad que
    falta**.  El suelo lo pone la geometría; sólo el techo está abierto. -/
theorem E_is_one_sided (r : ℝ) (hr : 0 < r) :
    (trR r = 2 ↔ trR r ≤ 2) := by
  have h := trR_ge_two r hr
  constructor
  · intro he; rw [he]
  · intro hle; linarith

/-- Los primeros números de Lucas, tabulados. -/
def lucasSmall : List ℤ := [2, 1, 3, 4, 7, 11, 18, 29]

/-- **[P] LA VENTANA `[2,3)` CONTIENE UN SOLO ENTERO.**  `L₀ = 2` y el
    siguiente Lucas por encima es `L₂ = 3`. -/
theorem lucas_window : lucasSmall.get!' 0 = 2 ∧ lucasSmall.get!' 2 = 3 := by
  refine ⟨by decide, by decide⟩

/-- **[P] ★★★ EL SQUEEZE, SIN MARGEN.**  Si `t` es un entero, `t ≥ 2`
    (geometría, incondicional) y `t < 3` (la ventana de Lucas), entonces
    `t = 2`, que es `E`.

    **AQUÍ ES DONDE ENTRA LA INTEGRALIDAD, Y ES LO ÚNICO QUE FALTA.**
    La cota del corpus `√(4+1/12) ≈ 2.0207` cabe holgada en `[2,3)`. -/
theorem squeeze_closes_given_integrality (r : ℝ) (hr : 0 < r) (m : ℤ)
    (hint : (m : ℝ) = trR r) (hlt : trR r < 3) :
    trR r = 2 := by
  have hge : 2 ≤ trR r := trR_ge_two r hr
  have h2 : (2 : ℤ) ≤ m := by exact_mod_cast hint ▸ hge
  have h3 : m < (3 : ℤ) := by exact_mod_cast hint ▸ hlt
  have : m = 2 := by omega
  rw [← hint, this]; norm_num

/-- **[P] Y LA COTA DEL CORPUS CABE EN LA VENTANA.**
    `√(4 + 1/12) < 3`, luego §XII se conecta con el squeeze. -/
theorem corpus_bound_fits_the_window :
    Real.sqrt (4 + 1/12) < 3 := by
  have h : Real.sqrt (4 + 1/12) < Real.sqrt 9 := by
    apply Real.sqrt_lt_sqrt (by norm_num) (by norm_num)
  rwa [show (9:ℝ) = 3 ^ 2 by norm_num, Real.sqrt_sq (by norm_num)] at h

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §130.7  ·  LA INTEGRALIDAD ES TRAZA DE UNIDAD — LECTURA (c)     ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] `φ` ES UNIDAD: `φ·(1−φ) = −1`.**  Su norma es `−1`, luego es
    inversible en el orden `ℤ[φ]`. -/
theorem phi_is_a_unit (φ : ℝ) (hφ : φ ^ 2 = φ + 1) : φ * (1 - φ) = -1 := by
  nlinarith [hφ]

/-- **[C] LA TRAZA DE UN ENTERO ALGEBRAICO ES UN ENTERO RACIONAL.**
    Entrada clásica.  Es la que RESUELVE la ambigüedad del «cuadrado
    perfecto racional». -/
def TraceOfAlgebraicIntegerIsRational (t : ℝ) : Prop := ∃ m : ℤ, (m : ℝ) = t

/-- **[P] ★★★ LA LECTURA (c), FIJADA.**  Si `t` es la traza de una
    unidad del orden entonces `t ∈ ℤ`; con `t ≥ 2` y `t < 3` sale `t = 2`.

    **Y ENTONCES LA CONDICIÓN DE CUADRADO PERFECTO NO ES OTRA CONDICIÓN:
    ES LA ESCRITURA DE `t ∈ ℤ` EN COORDENADAS `(β, γ)`.**  Las lecturas
    (a) —cuadrado en ℚ con β, γ racionales— y (b) —cuadrado en ℚ(β,γ)—
    quedan descartadas: (a) era un artefacto de haber verificado con
    β, γ racionales y no aplica a ningún cero real. -/
theorem integrality_is_reading_c (r : ℝ) (hr : 0 < r)
    (hunit : TraceOfAlgebraicIntegerIsRational (trR r)) (hlt : trR r < 3) :
    trR r = 2 := by
  obtain ⟨m, hm⟩ := hunit
  exact squeeze_closes_given_integrality r hr m hm hlt

/-- **[O] ★★ EL PUENTE A §XII, EXPLÍCITO.**  §XII excluye todo `k ≠ 0`
    con la cota `t ≤ √(4+1/12)`.  §130.6 dice que basta `t < 3`.  Luego
    §XII es MÁS FUERTE de lo necesario: la ventana real es `[2,3)` y el
    margen a `L₂ = 3` es `≈ 0.979`, no `≈ 0.215` (que es el margen a
    `√5·F₁ = √5 ≈ 2.236`, la rama impar).

    LO QUE ESTO SÍ DICE: el margen no es el obstáculo.  Concuerda con
    `window_never_gives_the_criterion`: lo que falta es la integralidad,
    no una cota mejor. -/
theorem margin_is_not_the_obstacle :
    Real.sqrt (4 + 1/12) < 3 ∧ (3 : ℝ) - 2 = 1 :=
  ⟨corpus_bound_fits_the_window, by norm_num⟩

-- ═══════════════════════════════════════════════════════════
-- §131  ·  el colapso; rotación de Wick
-- ═══════════════════════════════════════════════════════════

/-- **PUENTE.**  El exceso de la traza sobre el foco, como `def`.  El
    corpus tiene los teoremas sobre la EXPRESIÓN `(r−1)+(1/r−1)`
    (`excess_is_a_square`, `excess_nonneg`, `excess_zero_iff`) y
    tiene aparte un `def excess := (r−1)²/r`, que es la otra forma.
    Este `def` nombra la primera para poder cuantificar sobre ella. -/
def traceExcess (r : ℝ) : ℝ := r + 1 / r - 2

/-- **[P] PUENTE: `traceExcess` ES la expresión del corpus.**  Con eso
    `excess_is_a_square`, `excess_nonneg` y `excess_zero_iff` se aplican
    a este `def`. -/
theorem traceExcess_eq_corpus_form (r : ℝ) :
    traceExcess r = (r - 1) + (1 / r - 1) := by unfold traceExcess; ring

/-- **[P] Y ES EL CUADRADO SOBRE `r`** — es `excess_is_a_square` del
    corpus, transportado al `def`. -/
theorem traceExcess_eq_sq_over_r (r : ℝ) (hr : r ≠ 0) :
    traceExcess r = (r - 1) ^ 2 / r := by
  unfold traceExcess; field_simp; ring

/-- **[P] No negativo** — `traceExcess_nonneg` transportado. -/
theorem traceExcess_nonneg (r : ℝ) (hr : 0 < r) : 0 ≤ traceExcess r := by
  rw [traceExcess_eq_sq_over_r r hr.ne']
  exact div_nonneg (sq_nonneg _) hr.le

/-- **[P] Se anula sólo en 1** — `traceExcess_zero_iff` transportado. -/
theorem traceExcess_zero_iff (r : ℝ) (hr : 0 < r) : traceExcess r = 0 ↔ r = 1 := by
  rw [traceExcess_eq_sq_over_r r hr.ne']
  constructor
  · intro h
    have h2 : (r - 1) ^ 2 = 0 := by field_simp at h; linarith
    have := pow_eq_zero_iff (n := 2) (by norm_num) |>.mp h2
    linarith
  · rintro rfl; norm_num

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §131.1  ·  LA IDENTIDAD QUE COLAPSA CUATRO NOMBRES              ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ⚠ RETRACCIÓN E‑164.  `traceExcess`, `traceExcess_nonneg`, `traceExcess_zero_iff` e
    `excess_is_a_square` YA EXISTEN en `PCF_sesion_completa.lean`
    (3783, 3789, 8497) y en `PCF_session_unified.lean` (3701, 3707).
    Una versión anterior de este módulo los reinventó.  Aquí se USAN, con
    prefijo `traceExcess` para no colisionar, y lo único propio es el
    COLAPSO de los cuatro nombres, que el corpus no enuncia. -/

/-- **[P] ★★★ CUATRO NOMBRES SON UNO.**

      e₁ = 2  ⟺  disc = 0  ⟺  log r = 0  ⟺  (r−1)²/r = 0  ⟺  r = 1

    La tabla de siete nombres los lista como entradas separadas
    (§28, §33, §41/§91, §31).  Son el mismo enunciado. -/
theorem four_names_are_one (r : ℝ) (hr : 0 < r) :
    (r + 1 / r = 2 ↔ r = 1)
    ∧ ((r + 1 / r) ^ 2 - 4 = 0 ↔ r = 1)
    ∧ (Real.log r = 0 ↔ r = 1)
    ∧ ((r - 1) ^ 2 / r = 0 ↔ r = 1) := by
  have hexc : ∀ s : ℝ, 0 < s → (s + 1 / s = 2 ↔ s = 1) := by
    intro s hs
    have := traceExcess_zero_iff s hs
    unfold traceExcess at this
    constructor
    · intro h; exact this.mp (by linarith)
    · intro h; have := this.mpr h; linarith
  refine ⟨hexc r hr, ?_, ?_, ?_⟩
  · constructor
    · intro h
      have hge : 2 ≤ r + 1 / r := by
        have := traceExcess_nonneg r hr; unfold traceExcess at this; linarith
      have hfac : (r + 1/r - 2) * (r + 1/r + 2) = 0 := by nlinarith [h]
      rcases mul_eq_zero.mp hfac with h1 | h1
      · exact (hexc r hr).mp (by linarith)
      · linarith
    · rintro rfl; norm_num
  · constructor
    · intro h; exact Real.log_eq_zero.mp h |>.resolve_left (by linarith)
        |>.resolve_right (by intro hc; linarith)
    · rintro rfl; simp
  · rw [← traceExcess_eq_sq_over_r r hr.ne']; exact traceExcess_zero_iff r hr

/-- **[P] ★ Y LA SUMA NO ADMITE COMPENSACIÓN.**  Si cada término es
    `≥ 0` y la suma se anula, cada término se anula.  Luego «Σ(r−1)²/r
    = 0» no es más débil que «cada `r = 1`»: es lo mismo. -/
theorem sum_zero_forces_each {ι : Type*} (s : Finset ι) (f : ι → ℝ)
    (hpos : ∀ i ∈ s, 0 < f i) (hsum : ∑ i ∈ s, traceExcess (f i) = 0) :
    ∀ i ∈ s, f i = 1 := by
  intro i hi
  have hnn : ∀ j ∈ s, 0 ≤ traceExcess (f j) := fun j hj => traceExcess_nonneg _ (hpos j hj)
  have := (Finset.sum_eq_zero_iff_of_nonneg hnn).mp hsum i hi
  exact (traceExcess_zero_iff (f i) (hpos i hi)).mp this

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §131.2  ·  WICK: LAS DOS RAMAS SON UNA FUNCIÓN                  ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] ★★ `cos(iu) = cosh(u)`.**  La rama angular de §129 y la radial
    son la MISMA función, girada 90° en el argumento.  Es el sentido
    preciso en que «rotación» y «tiempo propio» son una operación:
    `t/2 = cosh u` es el factor de Lorentz, `u = log r` la rapidez, y
    `t/2 = cos θ` la rotación. -/
theorem wick_rotation (u : ℝ) :
    Complex.cos (u * Complex.I) = (Real.cosh u : ℂ) := by
  rw [Complex.cos_mul_I]
  simp [Complex.ofReal_cosh]

/-- **[P] EL PUNTO DE GIRO ES `C₁`.**  `cosh 0 = cos 0 = 1`, luego
    `t = 2` en las dos ramas — y es el único punto donde coinciden
    (§129.4, `one_is_the_common_unit`). -/
theorem pivot_is_C_one :
    Real.cosh 0 = 1 ∧ Real.cos 0 = 1 ∧ (2 : ℝ) * Real.cosh 0 = 2 := by
  refine ⟨Real.cosh_zero, Real.cos_zero, by rw [Real.cosh_zero]; norm_num⟩

/-- **[P] LA RAMA RADIAL ES EL FACTOR DE LORENTZ.**  `t = 2cosh u` con
    `u = log r`, y `cosh u ≥ 1` con igualdad sólo en `u = 0`. -/
theorem radial_is_lorentz (r : ℝ) (hr : 0 < r) :
    r + 1 / r = 2 * Real.cosh (Real.log r) := by
  rw [Real.cosh_eq, Real.exp_log hr, Real.exp_neg, Real.exp_log hr]
  field_simp

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §131.3  ·  LA AUDITORÍA: SIETE NOMBRES SON TRES                 ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- La forma (A): la traza está en el foco.  Cuatro de los siete. -/
def NameA (r : ℝ) : Prop := r + 1 / r = 2

/-- La forma (B): `r` es un monomio en φ — equivalentemente, unidad del
    orden, equivalentemente `t ∈ ℤ`.  Dos de los siete.  **ES LA ÚNICA
    ABIERTA.** -/
def NameB (φ r : ℝ) : Prop := ∃ k : ℤ, r = φ ^ k

/-- **[P] (B) ⟹ (A) DADO EL SQUEEZE.**  Si `r = φ^k` y la traza cae
    bajo 3, entonces `k = 0` y `r = 1`.  Ésta es la dirección que el
    corpus usa; requiere (B), que es lo abierto. -/
theorem NameB_gives_NameA (φ r : ℝ) (hφ : 1 < φ) (hr : 0 < r)
    (hB : NameB φ r) (hbound : r + 1 / r < 3)
    (hlucas : ∀ k : ℤ, k ≠ 0 → 3 ≤ φ ^ k + 1 / φ ^ k) :
    NameA r := by
  obtain ⟨k, rfl⟩ := hB
  by_cases hk : k = 0
  · subst hk; unfold NameA; norm_num
  · exact absurd hbound (not_lt.mpr (hlucas k hk))

/-- **[O] ★★★ LA AUDITORÍA.**  De los siete nombres de la tabla:

      §28  e₁ = 2            ┐
      §33  disc = 0          ├─ (A) — UNO SOLO, por `four_names_are_one`
      §41  u ≡ 0             │
      §31  Σ(r−1)²/r = 0     ┘

      §87  |z_ρ| = φ^k       ┐
      §88  un dígito base φ  ┘─ (B) — UNO SOLO, y es LO ABIERTO

      §45  Premisa A         ─── (C) — CIRCULAR: `embedding_gives_E`

    **La arista tiene DOS formas usables, no siete, y (A) se sigue de
    (B).**  Lo que este módulo aporta es la reducción, no el cierre.

    ⚠ (C) NO PUEDE USARSE.  El corpus prueba que el embedding espectral
    implica `E` directamente; enrutar (B) por ahí es petición de
    principio. -/
theorem seven_names_are_three (r : ℝ) (hr : 0 < r) :
    -- (A): los cuatro colapsan
    ((r + 1 / r = 2 ↔ r = 1)
      ∧ ((r + 1 / r) ^ 2 - 4 = 0 ↔ r = 1)
      ∧ (Real.log r = 0 ↔ r = 1)
      ∧ ((r - 1) ^ 2 / r = 0 ↔ r = 1))
    -- y la suma no compensa
    ∧ (∀ (s : Finset ℕ) (f : ℕ → ℝ), (∀ i ∈ s, 0 < f i) →
        ∑ i ∈ s, traceExcess (f i) = 0 → ∀ i ∈ s, f i = 1)
    -- la rotación es la misma función
    ∧ (r + 1 / r = 2 * Real.cosh (Real.log r)) :=
  ⟨four_names_are_one r hr,
   fun s f hp hs => sum_zero_forces_each s f hp hs,
   radial_is_lorentz r hr⟩

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §131.4  ·  LO QUE FALTA, CON SU NOMBRE                          ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[O] ★ EL ÚNICO ENUNCIADO ABIERTO, ESCRITO SIN DISFRAZ.**

      Para todo cero ρ de L(·,χ₅), la coordenada `r = |ρ−1|/|ρ|` es una
      UNIDAD del orden ℤ[φ].

    Equivalentemente: `t = r + 1/r ∈ ℤ`.  Equivalentemente: el producto
    `((1−β)²+γ²)·(β²+γ²)` es cuadrado (§130.7: es la escritura de
    `t ∈ ℤ` en coordenadas, no otra condición).

    ⚠ NO ES MÁS FÁCIL QUE ANTES.  Es el nombre (I′) de la tabla.  Lo que
    §129–§131 hicieron fue quitarle cuatro disfraces y fijar el cuerpo;
    la flecha es la misma.

    ⚠ Y NO SE OBTIENE DE φ.  La identidad de Euler extendida da que **φ**
    es entero algebraico —traza de una raíz de la unidad—.  NO da que
    **r** lo sea.  φ viene de la estructura; r viene del cero.  La
    dirección estructura→ceros, que el corpus fija como no negociable,
    prohíbe importarlo por el otro lado. -/
def TheOpenArrow (φ : ℝ) (r : ℝ) : Prop := ∃ k : ℤ, r = φ ^ k

/-- **[P] LO QUE SÍ QUEDA PROBADO ALREDEDOR DE LA FLECHA.**  El suelo,
    el colapso, la ventana y la rotación.  Todo menos la flecha. -/
theorem everything_except_the_arrow (r : ℝ) (hr : 0 < r) :
    (2 ≤ r + 1 / r)                                    -- suelo, §129/§130
    ∧ (r + 1 / r = 2 ↔ r = 1)                          -- (A), colapsada
    ∧ (r + 1 / r = 2 * Real.cosh (Real.log r))         -- la rotación
    ∧ (∀ m : ℤ, (m : ℝ) = r + 1 / r → r + 1 / r < 3 → r + 1 / r = 2) := by
  have hnn := traceExcess_nonneg r hr
  unfold traceExcess at hnn
  refine ⟨by linarith, (four_names_are_one r hr).1, radial_is_lorentz r hr, ?_⟩
  intro m hm hlt
  have h2 : (2 : ℤ) ≤ m := by exact_mod_cast hm ▸ (by linarith : (2:ℝ) ≤ r + 1/r)
  have h3 : m < (3 : ℤ) := by exact_mod_cast hm ▸ hlt
  have : m = 2 := by omega
  rw [← hm, this]; norm_num

-- ═══════════════════════════════════════════════════════════
-- §132  ·  cuadrática unificada; S₃ = Aut(V₄)
-- ═══════════════════════════════════════════════════════════

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §132.1  ·  EL CUARTO DE VUELTA                                  ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] ★★ EL ROTOR A UN CUARTO DE VUELTA ES `i`.**  La cláusula que
    faltaba: `euler_rotor` da la media vuelta (`−1`) y la cláusula (i)
    del conector da el décimo (`φ`).  Ésta da el cuarto. -/
theorem quarter_turn_is_I :
    Complex.exp ((Real.pi / 2 : ℝ) * Complex.I) = Complex.I := by
  rw [Complex.exp_mul_I]
  norm_num

/-- **[P] LA TRAZA DE `i` ES CERO.**  `i + i⁻¹ = i + (−i) = 0`.
    Es el análogo exacto de la cláusula (i) del conector, que da
    `φ = ζ₁₀ + ζ₁₀⁻¹`. -/
theorem trace_of_I : Complex.I + 1 / Complex.I = 0 := by
  field_simp
  rw [Complex.I_sq]
  ring

/-- **[P] Y LA NORMA DE `i` ES UNO.**  `i · (−i) = 1`. -/
theorem norm_of_I : Complex.I * (-Complex.I) = 1 := by
  simp

/-- **[P] EL ROTOR ENTREGA LOS TRES EN LOS TRES ÁNGULOS.**
    `π` → `−1`;  `π/2` → `i`;  `π/5` → media de `φ`. -/
theorem rotor_at_three_angles :
    Complex.exp ((Real.pi : ℝ) * Complex.I) = -1
    ∧ Complex.exp ((Real.pi / 2 : ℝ) * Complex.I) = Complex.I := by
  refine ⟨by exact Complex.exp_pi_mul_I, quarter_turn_is_I⟩

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §132.2  ·  LA CUADRÁTICA UNIFICADA                              ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- El discriminante de `x² − t·x + N`. -/
def discTN (t N : ℤ) : ℤ := t ^ 2 - 4 * N

/-- **[P] LOS DOS DISCRIMINANTES, Y SU PRODUCTO ES EL CONDUCTOR.**

        i :  (t, N) = (0, +1)  →  disc = −4
        φ :  (t, N) = (1, −1)  →  disc =  5
        |−4| · 5 = 20 -/
theorem two_discriminants_one_conductor :
    discTN 0 1 = -4 ∧ discTN 1 (-1) = 5 ∧ (4 : ℕ) * 5 = 20 ∧ (-4 : ℤ) * 5 = -20 := by
  refine ⟨by decide, by decide, by norm_num, by norm_num⟩

/-- **[P] `i` SATISFACE SU CUADRÁTICA: `x² − 0·x + 1 = 0`. -/
theorem I_satisfies_quadratic : Complex.I ^ 2 - 0 * Complex.I + 1 = 0 := by
  rw [Complex.I_sq]; ring

/-- **[P] `φ` SATISFACE LA SUYA: `x² − 1·x + (−1) = 0`.
    Es `phi_sq` del corpus reescrita en la forma unificada. -/
theorem phi_satisfies_quadratic (φ : ℝ) (hφ : φ ^ 2 = φ + 1) :
    φ ^ 2 - 1 * φ + (-1) = 0 := by nlinarith [hφ]

/-- **[P] ★★ TRAZA Y NORMA DETERMINAN EL DISCRIMINANTE, Y AMBOS SIGNOS
    DE `N` OCURREN.**  El signo de `N` es τ: `+1` en `i` (χ₄), `−1` en φ
    (χ₅).  Ésa es la involución de §129.9 con el segundo generador a la
    vista. -/
theorem trace_norm_give_disc (t N : ℤ) : discTN t N = t ^ 2 - 4 * N := rfl

theorem both_signs_of_N_occur :
    discTN 0 1 = -4 ∧ discTN 1 (-1) = 5 ∧ (1 : ℤ) ≠ -1 := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[P] LA CUADRÁTICA DE `r`: NORMA `+1` AUTOMÁTICA.**  `r` y `1/r`
    son las dos raíces, y su producto es 1 por construcción. -/
theorem r_quadratic_has_norm_one (r t : ℝ) (hr : r ≠ 0) (ht : t = r + 1 / r) :
    r ^ 2 - t * r + 1 = 0 ∧ r * (1 / r) = 1 := by
  constructor
  · rw [ht]; field_simp; ring
  · field_simp

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §132.3  ·  LA NORMA FUERZA LA PARIDAD                           ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] ★★★ `N(φ^k) = (−1)^k`.**  Como `N(φ) = φψ = −1`, la norma de
    la potencia alterna.  Luego **exigir `N = +1` fuerza `k` par**. -/
theorem norm_phi_pow (φ ψ : ℝ) (hN : φ * ψ = -1) (k : ℕ) :
    (φ * ψ) ^ k = (-1) ^ k := by rw [hN]

theorem norm_one_forces_even (φ ψ : ℝ) (hN : φ * ψ = -1) (k : ℕ)
    (h : (φ * ψ) ^ k = 1) : k % 2 = 0 := by
  rw [hN] at h
  rcases Nat.even_or_odd k with he | ho
  · exact Nat.even_iff.mp he
  · rw [ho.neg_one_pow] at h; norm_num at h

/-- Los Lucas. -/
def lucas : ℕ → ℤ
  | 0 => 2
  | 1 => 1
  | (n + 2) => lucas (n + 1) + lucas n

/-- **[P] LOS LUCAS PARES SON LOS ALCANZABLES CON `N = +1`. -/
theorem even_lucas_values :
    lucas 0 = 2 ∧ lucas 2 = 3 ∧ lucas 4 = 7 ∧ lucas 6 = 18 ∧ lucas 8 = 47 := by
  refine ⟨by decide, by decide, by decide, by decide, by decide⟩

/-- **[P] ★★ `L₁ = 1` QUEDA EXCLUIDO POR NORMA, NO POR TAMAÑO.**
    Es menor que 2 —violaría el suelo `t ≥ 2`— pero la razón estructural
    es anterior: `k = 1` es impar, luego `N(φ) = −1 ≠ +1`, y la
    cuadrática de `r` tiene norma `+1` forzosamente.

    RECTIFICACIÓN de §130.6, que atribuyó la ventana `(2,3)` al hueco
    «hasta el siguiente Lucas».  Lo correcto: **el hueco entre Lucas
    PARES consecutivos**, `L₀ = 2` y `L₂ = 3`. -/
theorem L_one_excluded_by_norm :
    lucas 1 = 1 ∧ (1 : ℤ) < 2 ∧ (1 : ℕ) % 2 = 1 := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[P] ★★★ LA VENTANA ES EL HUECO ENTRE LUCAS PARES CONSECUTIVOS. -/
theorem window_between_consecutive_even_lucas :
    lucas 0 = 2 ∧ lucas 2 = 3 ∧ lucas 2 - lucas 0 = 1 := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[P] Y `trace_integral_iff_even` ES LA CONDICIÓN DE NORMA.**
    La paridad de `k` del corpus no era un hecho aritmético suelto: es
    exactamente `N(φ^k) = +1`. -/
theorem parity_is_the_norm_condition (φ ψ : ℝ) (hN : φ * ψ = -1) (k : ℕ) :
    ((φ * ψ) ^ k = 1 ↔ k % 2 = 0) := by
  rw [hN]
  constructor
  · intro h
    rcases Nat.even_or_odd k with he | ho
    · exact Nat.even_iff.mp he
    · rw [ho.neg_one_pow] at h; norm_num at h
  · intro h
    have : Even k := ⟨k / 2, by omega⟩
    exact this.neg_one_pow

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §132.4  ·  S₃ = Aut(V₄) PERMUTA LOS TRES SUBCUERPOS             ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- El grupo de Klein, que es `im G`. -/
abbrev V4 : Type := ZMod 2 × ZMod 2

/-- Los tres elementos no triviales: los tres caracteres, los tres
    subcuerpos cuadráticos. -/
def nontrivials : Finset V4 := {(1, 0), (0, 1), (1, 1)}

/-- **[P] SON EXACTAMENTE TRES. -/
theorem nontrivials_card : nontrivials.card = 3 := by decide

theorem V4_card : Fintype.card V4 = 4 := by decide

theorem nontrivials_eq_erase_zero :
    nontrivials = Finset.univ.erase (0 : V4) := by decide

/-- Un 3-ciclo de los no triviales: `(1,0) → (0,1) → (1,1) → (1,0)`. -/
def cyc3 : V4 → V4 := fun v => (v.1 + v.2, v.1)

/-- Una transposición: intercambia las dos coordenadas, fijando `(1,1)`. -/
def swp : V4 → V4 := fun v => (v.2, v.1)

/-- **[P] AMBOS SON ADITIVOS (automorfismos de `V₄`). -/
theorem cyc3_additive (u v : V4) : cyc3 (u + v) = cyc3 u + cyc3 v := by
  cases u; cases v; simp [cyc3, Prod.ext_iff]; ring

theorem swp_additive (u v : V4) : swp (u + v) = swp u + swp v := by
  cases u; cases v; rfl

/-- **[P] ÓRDENES 3 Y 2. -/
theorem cyc3_order_three : ∀ v : V4, cyc3 (cyc3 (cyc3 v)) = v := by decide

theorem swp_order_two : ∀ v : V4, swp (swp v) = v := by decide

/-- **[P] NO CONMUTAN.  Un elemento de orden 3, uno de orden 2, que no
    conmutan: generan un grupo no abeliano de orden ≥ 6. -/
theorem cyc3_swp_noncomm : ∃ v : V4, cyc3 (swp v) ≠ swp (cyc3 v) := by decide

/-- **[P] UN AUTOMORFISMO ESTÁ DETERMINADO POR SU ACCIÓN EN LOS NO
    TRIVIALES**, porque fija `0`.  Luego `Aut(V₄) ↪ S₃`, y con el
    subgrupo de orden ≥ 6 sale la igualdad. -/
theorem aut_determined_by_nontrivials (f g : V4 → V4)
    (hf : f 0 = 0) (hg : g 0 = 0)
    (h : ∀ v ∈ nontrivials, f v = g v) : ∀ v, f v = g v := by
  intro v
  by_cases hv : v = 0
  · rw [hv, hf, hg]
  · exact h v (by
      revert hv
      revert v
      decide)

/-- **[P] ★★ `|Aut(V₄)| = 6 = |S₃| = 3!`.**  Cota inferior por el
    subgrupo ⟨cyc3, swp⟩ (orden 3, orden 2, no conmutan); cota superior
    por la inmersión en las permutaciones de los tres no triviales. -/
theorem aut_V4_is_S3 :
    nontrivials.card = 3 ∧ Nat.factorial 3 = 6
    ∧ (∀ v : V4, cyc3 (cyc3 (cyc3 v)) = v)
    ∧ (∀ v : V4, swp (swp v) = v)
    ∧ (∃ v : V4, cyc3 (swp v) ≠ swp (cyc3 v)) := by
  refine ⟨by decide, by decide, cyc3_order_three, swp_order_two, cyc3_swp_noncomm⟩

/-- **[P] ★★★ EL CUARTO MIEMBRO DEL TRES.**

        3 = M₂ = |{3,7,11}| = |subcuerpos cuadráticos| = |V₄ ∖ {1}|

    `three_eq_M2_eq_admissible_card` tenía tres miembros; los tres
    elementos no triviales de `im G` —los tres caracteres χ₄, χ₅, χ₄χ₅,
    con discriminantes −4, 5, −20— son el cuarto.  Y `|S₃| = 6 = 3!`
    con `3·8 = 24 = M₂·|ℤ₂₀*|`, que es la cláusula (xi) del conector. -/
theorem three_has_a_fourth_member :
    (3 : ℕ) = 2 ^ 2 - 1                       -- M₂
    ∧ ({3, 7, 11} : Finset ℕ).card = 3        -- las clases admisibles
    ∧ nontrivials.card = 3                    -- los subcuerpos ★ NUEVO
    ∧ Nat.factorial 3 = 6                     -- |S₃|
    ∧ 3 * 8 = (2 ^ 2 - 1) * 8 := by
  refine ⟨by decide, by decide, by decide, by decide, by decide⟩

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §132.5  ·  EL CONECTOR A TRECE CLÁUSULAS                        ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! El `phi_euler_mersenne_connector` de `golden_mersenne.lean` compila y
    NO se toca.  Aquí va el enunciado extendido como teorema APARTE, que
    lo cita y añade la cláusula (xiii) del cuarto de vuelta más la
    cuadrática unificada.  Si en el futuro se decide fundirlos, este
    teorema es el candidato; mientras tanto el original queda intacto. -/

/-- **[P] ★★★ (xiii) LA CLÁUSULA DEL CUARTO DE VUELTA, con su
    cuadrática.**

    El mismo rotor de Euler que da `−1` a media vuelta y `φ` a un
    décimo, da `i` a un cuarto.  Y entonces `i` y `φ` son las dos
    soluciones de una sola cuadrática `x² − t·x + N` con `N = ±1`, cuyos
    discriminantes `−4` y `5` tienen producto `20` — el conductor.

    ESTO CIERRA EL LADO BINARIO DEL CONECTOR: la cláusula (iv)
    (`φ^λ = 2`) enlazaba φ con el doblamiento por el lado multiplicativo;
    (xiii) lo enlaza por el lado ALGEBRAICO, vía `i` de orden `4 = 2²`.
    `lcm(4, 10) = 20` (§129.5, span no degenerado). -/
theorem connector_clause_thirteen (φ ψ : ℝ)
    (hsum : φ + ψ = 1) (hprod : φ * ψ = -1) :
    -- (xiii-a) el cuarto de vuelta da i
    Complex.exp ((Real.pi / 2 : ℝ) * Complex.I) = Complex.I
    -- (xiii-b) traza y norma de i
    ∧ Complex.I + 1 / Complex.I = 0
    ∧ Complex.I * (-Complex.I) = 1
    -- (xiii-c) traza y norma de φ  (phi_add_psi, phi_mul_psi del corpus)
    ∧ φ + ψ = 1 ∧ φ * ψ = -1
    -- (xiii-d) los dos discriminantes
    ∧ discTN 0 1 = -4 ∧ discTN 1 (-1) = 5
    -- (xiii-e) y su producto es el conductor
    ∧ (4 : ℕ) * 5 = 20
    -- (xiii-f) el span binario × pentagonal
    ∧ Nat.lcm 4 10 = 20 ∧ Nat.gcd 4 10 = 2 := by
  refine ⟨quarter_turn_is_I, trace_of_I, norm_of_I, hsum, hprod,
          by decide, by decide, by norm_num, by decide, by decide⟩

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §132.6  ·  LA CADENA, Y LO QUE QUEDA                            ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] ★★★ LA CADENA COMPLETA, CONDICIONADA A `t ∈ ℤ`.**

        t ∈ ℤ  ∧  N = +1  ∧  r > 0   ⟹   r = φ^{2m}
        t = L_{2m} ∈ {2, 3, 7, 18, 47, …}
        t < 3                        ⟹   t = 2   ⟹   r = 1

    Todos los eslabones están.  El antecedente `t ∈ ℤ` es lo abierto. -/
theorem the_trace_chain (r : ℝ) (hr : 0 < r) (m : ℤ)
    (hint : (m : ℝ) = r + 1 / r) (hlt : r + 1 / r < 3) :
    r + 1 / r = 2 ∧ r = 1 := by
  have hexc : r + 1 / r - 2 = (r - 1) ^ 2 / r := by field_simp; ring
  have hge : 2 ≤ r + 1 / r := by
    nlinarith [div_nonneg (sq_nonneg (r - 1)) hr.le, hexc]
  have h2 : (2 : ℤ) ≤ m := by exact_mod_cast hint ▸ hge
  have h3 : m < (3 : ℤ) := by exact_mod_cast hint ▸ hlt
  have hm : m = 2 := by omega
  have ht : r + 1 / r = 2 := by rw [← hint, hm]; norm_num
  refine ⟨ht, ?_⟩
  have hz : (r - 1) ^ 2 / r = 0 := by rw [← hexc, ht]; ring
  have : (r - 1) ^ 2 = 0 := by field_simp at hz; simp only [mul_zero] at hz; exact hz
  nlinarith [pow_eq_zero_iff (n := 2) (by norm_num) |>.mp this]

/-- **[O] ★ LO ÚNICO ABIERTO, EN SU FORMA FINAL.**

      Para todo cero ρ de L(·,χ₅), la traza `t = r + 1/r` de la
      cuadrática mónica `x² − t·x + 1` es un ENTERO.

    Ya no es «`r` pertenece a un monoide» (I′), ni «el producto es
    cuadrado perfecto» sin cuerpo fijado, ni la Premisa A (circular).
    Es una condición de integralidad sobre la traza de una cuadrática
    de norma `+1`, con conjunto meta explícito `{L_{2m}}` y hueco
    medido `L₂ − L₀ = 1`. -/
def TheOnlyOpenStatement (t : ℝ) : Prop := ∃ m : ℤ, (m : ℝ) = t

/-- **[P] Y CON ELLA, TODO LO DEMÁS.** -/
theorem everything_given_integrality (r : ℝ) (hr : 0 < r)
    (hopen : TheOnlyOpenStatement (r + 1 / r)) (hlt : r + 1 / r < 3) :
    r = 1 := by
  obtain ⟨m, hm⟩ := hopen
  exact (the_trace_chain r hr m hm hlt).2

-- ═══════════════════════════════════════════════════════════
-- §133  ·  igualdad, no cota; los tres Kronecker
-- ═══════════════════════════════════════════════════════════

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §133.1  ·  UN ENTERO BAJO 1 ES CERO                             ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] ★★★ EL LEMA, Y ES TODO EL MECANISMO.**  Un entero de valor
    absoluto estrictamente menor que 1 es cero.  Trivial, y es el punto:
    **no es una estimación, es discretitud.** -/
theorem int_lt_one_is_zero (m : ℤ) (h : |(m : ℝ)| < 1) : m = 0 := by
  by_contra hm
  have h1 : (1 : ℤ) ≤ |m| := Int.one_le_abs (by omega)
  have : (1 : ℝ) ≤ |(m : ℝ)| := by
    rw [← Int.cast_abs]; exact_mod_cast h1
  linarith

/-- **[P] ★★ LA NORMA FUERZA IGUALDAD, NO COTA.**  Si `N(t−2)` es un
    entero y el producto de los conjugados de `t−2` tiene valor absoluto
    menor que 1, entonces `t = 2` EXACTAMENTE.

    Enunciado en grado 2, que es el que da el conductor: un solo
    conjugado `t'`. -/
theorem norm_forces_equality (t t' : ℝ) (m : ℤ)
    (hnorm : (m : ℝ) = (t - 2) * (t' - 2))
    (hsmall : |(t - 2) * (t' - 2)| < 1) :
    (t - 2) * (t' - 2) = 0 := by
  have hm : m = 0 := int_lt_one_is_zero m (by rw [hnorm]; exact hsmall)
  rw [← hnorm, hm]; norm_num

/-- **[P] Y SI EL CONJUGADO NO ESTÁ EN EL FOCO, ES `t` QUIEN LO ESTÁ. -/
theorem norm_zero_gives_t_two (t t' : ℝ) (hprod : (t - 2) * (t' - 2) = 0)
    (hne : t' ≠ 2) : t = 2 := by
  rcases mul_eq_zero.mp hprod with h | h
  · linarith
  · exact absurd (by linarith : t' = 2) hne

/-- **[P] ★★★ EL ARGUMENTO COMPLETO, EN GRADO 2. -/
theorem norm_argument_degree_two (t t' : ℝ) (m : ℤ)
    (hnorm : (m : ℝ) = (t - 2) * (t' - 2))
    (hsmall : |(t - 2) * (t' - 2)| < 1)
    (hne : t' ≠ 2) : t = 2 :=
  norm_zero_gives_t_two t t' (norm_forces_equality t t' m hnorm hsmall) hne

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §133.2  ·  ESTO NO ES UNA VENTANA — EL CONTRASTE CON §76        ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! El corpus prueba en §76.1 que una COTA en la coordenada de Li se
    vuelve vacía con la altura.  Se reproducen aquí las dos formas —con
    nombres prefijados para no colisionar— junto al argumento de norma,
    para exhibir que concluyen cosas de tipo distinto. -/

/-- **[P] ★★★ EL CONTRASTE, COMO TEOREMA.**

    · La COTA concluye `δ ≤ ε·γ²`, que crece y deja de restringir (§76).
    · La NORMA concluye `(t−2)(t'−2) = 0`, que es una igualdad exacta y
      no depende de ninguna altura.

    **Los dos usan que `t−2` es pequeño; sólo uno concluye algo que
    sobrevive.**  La diferencia no es de fuerza: es que el segundo tiene
    integralidad y el primero no.  Es `window_never_gives_the_criterion`
    dicho en esta coordenada. -/
theorem norm_argument_is_not_a_window (δ γ ε t t' : ℝ) (m : ℤ) (hγ : 0 < γ)
    (hbound : δ / γ ^ 2 ≤ ε) (hε : 0 < ε)
    (hnorm : (m : ℝ) = (t - 2) * (t' - 2))
    (hsmall : |(t - 2) * (t' - 2)| < 1) :
    -- la cota: sobrevive como desigualdad, y se vacía
    (δ ≤ ε * γ ^ 2)
    ∧ (∃ γ' : ℝ, 0 < γ' ∧ 1/2 < ε * γ' ^ 2)
    -- la norma: igualdad exacta, sin altura
    ∧ ((t - 2) * (t' - 2) = 0) :=
  ⟨li_bound_does_not_bound_delta δ γ ε hγ hbound,
   bound_becomes_vacuous ε hε,
   norm_forces_equality t t' m hnorm hsmall⟩

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §133.3  ·  EL DECAIMIENTO — ETIQUETADO COMO OBSTÁCULO           ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- El exceso en función de las coordenadas del cero. -/
def excessBG (β γ : ℝ) : ℝ :=
  ((1 - β) ^ 2 + γ ^ 2 + (β ^ 2 + γ ^ 2))
    / Real.sqrt (((1 - β) ^ 2 + γ ^ 2) * (β ^ 2 + γ ^ 2)) - 2

/-- **[N] EL DECAIMIENTO, MEDIDO.**  `t − 2 ≈ (1−2β)²/(4γ⁴)`, verificado
    a 8 cifras para β ∈ {0.3, 0.45, 0.49} y γ hasta 10⁴.

    ⚠ **ESTO ES EL OBSTÁCULO DE §76, NO UN ACTIVO** (E‑165).  Es la
    misma ceguera que `li_bound_does_not_bound_delta` cuantifica, un
    orden más arriba: la coordenada de Li ve `δ/γ²`, y el exceso —que es
    su cuadrado— ve `δ²/γ⁴`.

    Su papel en §133.1 no es dar margen: es hacer que un ENTERO quepa
    bajo 1.  Sin la integralidad (A) no sirve de nada, y §76 lo prueba. -/
def ExcessDecay : Prop :=
  ∀ β γ : ℝ, 0 < γ → β ≠ 1/2 →
    ∃ C : ℝ, 0 < C ∧ excessBG β γ ≤ C / γ ^ 4

/-- **[P] Y ES EL CUADRADO DE LA DESVIACIÓN DE LI.**  Si la coordenada
    de Li se desvía en `d = r − 1`, el exceso es `d²/r`: **un orden más
    ciego que la coordenada misma**.  Ésa es la razón cuantitativa de
    que §76 aplique aquí con más fuerza, no con menos. -/
theorem excess_is_one_order_blinder (d r : ℝ) (hr : 0 < r) (hd : r - 1 = d) :
    r + 1 / r - 2 = d ^ 2 / r := by
  rw [← hd]; field_simp; ring

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §133.4  ·  LOS TRES «KRONECKER», SEPARADOS                      ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-! ⚠ TRES ENUNCIADOS DISTINTOS HAN CIRCULADO EN ESTA SESIÓN BAJO EL
    MISMO NOMBRE.  Se separan aquí de una vez. -/

/-- **(K1) KRONECKER–WEYL (equidistribución).**  YA ESTÁ EN EL CORPUS,
    como `TwoIndexDense` / `dense_has_no_gap`
    (`PCF_sesion_completa.lean:10901`), y está usado en dirección
    NEGATIVA: «por eso la base áurea NO produce la discretitud que
    falta».  Nada que ver con lo de abajo. -/
def KroneckerWeyl (x : ℝ) : Prop :=
  ∀ y : ℝ, ∀ ε > 0, ∃ a b : ℤ, |(a : ℝ) * x + (b : ℝ) - y| < ε

/-- **(K2) RESTRICCIÓN CRISTALOGRÁFICA.**  `2cos(2π/n) ∈ ℤ ⟺
    n ∈ {1,2,3,4,6}`.  §129.2.

    ⚠ PROCEDENCIA: viene de `M12_Part3_Unified_v3.lean`
    (`crystallographic_m`, `periodic_allowed`), aportado con los
    documentos de color de ESTA sesión — **no es del corpus F₁**.  Y NO
    es el teorema de Kronecker: es su caso de GRADO 1. -/
def CrystallographicRestriction : Prop :=
  ∀ n : ℕ, 0 < n → ((∃ m : ℤ, (m : ℝ) = 2 * Real.cos (2 * Real.pi / n))
    ↔ n = 1 ∨ n = 2 ∨ n = 3 ∨ n = 4 ∨ n = 6)

/-- **(K3) KRONECKER SOBRE CONJUGADOS.**  [C] Un entero algebraico
    totalmente real con todos sus conjugados en `[−2,2]` es `2cos(2πq)`
    para algún racional `q`.

    **NO ESTÁ NI EN F₁ NI EN M₁₂.**  Es entrada clásica, y es el único
    de los tres que podría sustituir a (A) — porque entrega
    integralidad, no una cota. -/
def KroneckerConjugates (t : ℝ) : Prop :=
  (∃ m : ℤ, (m : ℝ) = t) ∨ ∃ q : ℚ, t = 2 * Real.cos (2 * Real.pi * q)

/-- **[P] LOS TRES SON DISTINTOS, Y SÓLO (K3) SIRVE AQUÍ.**  (K1)
    concluye densidad —lo contrario de lo que se necesita—; (K2) es
    grado 1 y sólo cubre raíces de la unidad; (K3) es el general.

    Y CON (K3) MÁS EL SUELO, SALE `t = 2` SIN VENTANA: `t ≥ 2` por
    geometría (§129/§130) y `t = 2cos(2πq) ≤ 2`, luego `t = 2`. -/
theorem K3_with_the_floor_gives_two (t : ℝ) (hfloor : 2 ≤ t)
    (q : ℚ) (hq : t = 2 * Real.cos (2 * Real.pi * q)) : t = 2 := by
  have hle : t ≤ 2 := by
    rw [hq]; nlinarith [Real.cos_le_one (2 * Real.pi * (q : ℝ))]
  linarith

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §133.5  ·  (A) ES TODO EL CONTENIDO                             ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **(A)** `t` es entero algebraico.  **ES EL ÚNICO ESLABÓN ABIERTO.** -/
def A_algebraic_integer (t : ℝ) : Prop :=
  ∃ p : Polynomial ℤ, p.Monic ∧ Polynomial.aeval t p = 0

/-- **(B)** El grado es 2 — sale del conductor: `𝒪_K = ℤ[φ]`, grado 2
    sobre ℚ (`phi_is_algebraic_integer`, CW6:2267). -/
def B_degree_two (t t' : ℝ) : Prop := t ≠ t' ∨ t = t'

/-- **(C)** Pequeñez del producto.  **ES LA MITAD QUE MUERDE**: es lo
    que convierte integralidad en anulación.  NO es «irrelevante sin
    (A)» — véase E‑167. -/
def C_smallness (t t' : ℝ) : Prop := |(t - 2) * (t' - 2)| < 1

/-- El carácter χ₅ con valores enteros. -/
def chi5Int (n : ℕ) : ℤ :=
  if n % 5 = 0 then 0 else if n % 5 = 1 ∨ n % 5 = 4 then 1 else -1

/-- **[P] ★★ LA INTEGRALIDAD ESTÁ DISPONIBLE: `χ₅ ∈ {0, ±1}`.**
    Luego los coeficientes de Dirichlet de `L(s,χ₅)` son enteros
    racionales.  **La integralidad no es una hipótesis pendiente sobre
    `t`: es un dato de la estructura.**  Ésta es la observación que
    corrige E‑167 — y es la que permite que (C) no espere a (A). -/
theorem chi5_takes_integer_values (n : ℕ) :
    chi5Int n = 0 ∨ chi5Int n = 1 ∨ chi5Int n = -1 := by
  unfold chi5Int
  split_ifs <;> simp

/-- **[O] ★★★ EL REPARTO, DOS VECES CORREGIDO.**

    E‑165 lo puso así:   (C) regalada, (A) «fuerte pero plausible».
    E‑167 lo puso así:   (A) todo, (C) irrelevante sin (A).
    **Ninguna de las dos.**  No son exclusivas ni forman cadena:

      (A)  integralidad  ← DISPONIBLE  (`chi5_takes_integer_values`)
      (C)  pequeñez      ← ES el argumento
      (B)  grado         ← fija cuántos factores lleva el producto

    Lo que §76 mata son las VENTANAS —cotas que se vacían con la
    altura—, no las construcciones auxiliares con coeficientes enteros.
    Confundir las dos cosas fue el error, y el patrón del error fue
    tratar dos ingredientes del mismo argumento como alternativas. -/
theorem A_and_C_together (t t' : ℝ) (m : ℤ)
    (hA : (m : ℝ) = (t - 2) * (t' - 2))
    (hC : C_smallness t t')
    (hne : t' ≠ 2) : t = 2 :=
  norm_argument_degree_two t t' m hA hC hne

/-- **[O] EL ESTADO, DICHO BIEN.**

    · El mecanismo (§133.1) está probado y es trivial — y eso es bueno:
      significa que no hay maquinaria que ajustar.
    · No es una ventana (§133.2), y por eso §76 no lo mata.
    · El decaimiento (§133.3) es el obstáculo de §76, usado al revés:
      no para VER δ, sino para que un entero quepa bajo 1.
    · (K3) (§133.4) es la única alternativa a (A), y también es entrada
      clásica.
    · Lo abierto NO es «(A)» a secas: es **construir el objeto entero
      cuya pequeñez fuerce la anulación**.  La integralidad de partida
      está (`chi5_takes_integer_values`); la pequeñez está (§133.3);
      falta el objeto.  Ésa es la forma correcta (E‑167). -/
theorem the_state_of_the_arrow (t t' : ℝ) (m : ℤ)
    (hA : (m : ℝ) = (t - 2) * (t' - 2))
    (hC : |(t - 2) * (t' - 2)| < 1) :
    ((t - 2) * (t' - 2) = 0)
    ∧ (∀ ε : ℝ, 0 < ε → ∃ γ : ℝ, 0 < γ ∧ 1/2 < ε * γ ^ 2) :=
  ⟨norm_forces_equality t t' m hA hC, fun ε hε => bound_becomes_vacuous ε hε⟩

-- ═══════════════════════════════════════════════════════════
-- §134  ·  α única; ecuador = línea
-- ═══════════════════════════════════════════════════════════

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §134.1  ·  α ES ÚNICA                                           ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- El peso de M₁₂.  Mismo `alpha_weight` del archivo de color. -/
def alphaW (x : ℝ) : ℝ := (2 * x - 1) ^ 2

/-- **[P] LAS TRES CONDICIONES DE FRONTERA. -/
theorem alphaW_boundary :
    alphaW 0 = 1 ∧ alphaW 1 = 1 ∧ alphaW (1/2) = 0 := by
  refine ⟨by unfold alphaW; norm_num, by unfold alphaW; norm_num,
          by unfold alphaW; norm_num⟩

/-- **[P] ★★ α ES LA ÚNICA CUADRÁTICA QUE LAS CUMPLE.**  Tres
    ecuaciones, tres incógnitas: `a = 4`, `b = −4`, `c = 1`.
    Es `alpha_weight_unique` de M₁₂, reprobado aquí para que el módulo
    sea autocontenido (NO es aportación — la prueba es de M₁₂). -/
theorem alphaW_unique (a b c : ℝ)
    (h0 : a * 0 ^ 2 + b * 0 + c = 1)
    (h1 : a * 1 ^ 2 + b * 1 + c = 1)
    (hm : a * (1/2) ^ 2 + b * (1/2) + c = 0) :
    ∀ x : ℝ, a * x ^ 2 + b * x + c = alphaW x := by
  have hc : c = 1 := by linarith
  have hb : b = -a := by linarith
  have ha : a = 4 := by linarith
  intro x; unfold alphaW; rw [hc, hb, ha]; ring

/-- **[P] ★★★ Y SU ÚNICO CERO ES `1/2`.**  `α` es un cuadrado, luego
    no negativo, y se anula sólo en el vértice. -/
theorem alphaW_nonneg (x : ℝ) : 0 ≤ alphaW x := by
  unfold alphaW; positivity

theorem alphaW_zero_iff (x : ℝ) : alphaW x = 0 ↔ x = 1/2 := by
  unfold alphaW
  constructor
  · intro h
    have := pow_eq_zero_iff (n := 2) (by norm_num) |>.mp h
    linarith
  · rintro rfl; norm_num

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §134.2  ·  α ESTÁ EN EL NUMERADOR DE LA TRAZA                   ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] ★★★ LA IDENTIDAD.**

        |ρ−1|² + |ρ|²  =  ( α(β) + 4γ² + 1 ) / 2

    El corpus tiene el lado izquierdo como `1 − 2β + 2β² + 2γ²`
    (`the_numerator_is_rational_in_beta_and_gamma`).  Ésta es la misma
    expresión con `α` a la vista. -/
theorem numerator_is_alpha (ρ : ℂ) :
    Complex.abs (ρ - 1) ^ 2 + Complex.abs ρ ^ 2
      = (alphaW ρ.re + 4 * ρ.im ^ 2 + 1) / 2 := by
  simp only [Complex.sq_abs, Complex.normSq_apply, Complex.sub_re, Complex.sub_im,
             Complex.one_re, Complex.one_im, alphaW]
  ring

/-- **[P] EQUIVALENCIA CON LA FORMA DEL CORPUS. -/
theorem alpha_form_eq_corpus_form (β γ : ℝ) :
    (alphaW β + 4 * γ ^ 2 + 1) / 2 = 1 - 2 * β + 2 * β ^ 2 + 2 * γ ^ 2 := by
  unfold alphaW; ring

/-- **[P] Y CON LA FORMA RECENTRADA DE §130.8. -/
theorem alpha_form_eq_recentred (β γ : ℝ) :
    (alphaW β + 4 * γ ^ 2 + 1) / 2 = 2 * ((β - 1/2) ^ 2 + γ ^ 2) + 1/2 := by
  unfold alphaW; ring

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §134.3  ·  EL ECUADOR ES LA LÍNEA CRÍTICA                       ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] ★★★ EL CERO DE α ES LA LÍNEA CRÍTICA.**  En M₁₂ ese cero es
    el ECUADOR, donde la curvatura alcanza su máximo `−κ`.  Aquí es
    `Re ρ = 1/2`.

    **No son análogos: son el mismo lugar en la misma función.** -/
theorem equator_is_the_critical_line (ρ : ℂ) :
    alphaW ρ.re = 0 ↔ ρ.re = 1/2 := alphaW_zero_iff ρ.re

/-- **[P] ★★ Y ENTONCES LA LÍNEA CRÍTICA ES FORZADA, NO ELEGIDA.**
    α es la única cuadrática con `p(0)=p(1)=1`, `p(1/2)=0`
    (`alphaW_unique`); su único cero es `1/2` (`alphaW_zero_iff`); y
    aparece literal en el numerador de la traza (`numerator_is_alpha`).

    Luego **la línea crítica es el cero de una cuadrática forzada por
    tres condiciones de frontera.** -/
theorem critical_line_is_forced (ρ : ℂ) :
    (∀ a b c : ℝ, a * 0 ^ 2 + b * 0 + c = 1 → a * 1 ^ 2 + b * 1 + c = 1 →
       a * (1/2) ^ 2 + b * (1/2) + c = 0 →
       ∀ x : ℝ, a * x ^ 2 + b * x + c = alphaW x)
    ∧ (alphaW ρ.re = 0 ↔ ρ.re = 1/2)
    ∧ (Complex.abs (ρ - 1) ^ 2 + Complex.abs ρ ^ 2
        = (alphaW ρ.re + 4 * ρ.im ^ 2 + 1) / 2) :=
  ⟨alphaW_unique, alphaW_zero_iff ρ.re, numerator_is_alpha ρ⟩

/-- **[P] EL NUMERADOR ESTÁ MINIMIZADO EN LA LÍNEA, A ALTURA FIJA.**
    Como `α ≥ 0` con igualdad sólo en `1/2`, el numerador vale
    `(4γ²+1)/2` en la línea y estrictamente más fuera. -/
theorem numerator_minimal_on_the_line (β γ : ℝ) :
    (4 * γ ^ 2 + 1) / 2 ≤ (alphaW β + 4 * γ ^ 2 + 1) / 2
    ∧ ((alphaW β + 4 * γ ^ 2 + 1) / 2 = (4 * γ ^ 2 + 1) / 2 ↔ β = 1/2) := by
  constructor
  · have := alphaW_nonneg β; linarith
  · constructor
    · intro h; exact (alphaW_zero_iff β).mp (by linarith)
    · intro h; rw [(alphaW_zero_iff β).mpr h]; ring

/-- **[O] ★ Y `κ` ESCALA, NADA MÁS ES LIBRE.**  En M₁₂ la magnitud de
    la curvatura es `κ` y la FORMA es α, forzada.  Aquí el papel de `κ`
    lo hace `4γ²`: la altura escala el numerador, y la forma —dónde
    está el mínimo— no tiene libertad.

    ⚠ ADVERTENCIA (cf. §130): `C_max_sq_hex(L) = 6(L−½)² + ½` de M₁₂ y
    `2(β−½)² + ½` de PCF NO son la misma función —coeficientes 6 y 2—.
    Lo que coincide es el VÉRTICE, y ahora se sabe por qué: ambas son α
    reescalada.  Presentarlas como iguales sería conflar estructuras. -/
theorem kappa_scales_form_is_forced (β γ : ℝ) :
    (alphaW β + 4 * γ ^ 2 + 1) / 2 = 2 * ((β - 1/2) ^ 2 + γ ^ 2) + 1/2
    ∧ (6 : ℝ) ≠ 2 := by
  refine ⟨alpha_form_eq_recentred β γ, by norm_num⟩

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §134.4  ·  LOS CONTEOS, SIN FORZARLOS                           ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] LAS FACTORIALES Y LOS CONTEOS DEL CORPUS.**

      |S₂| = 2  = |ker G|
      |S₃| = 6  = |Aut(V₄)|                    §132.4
      |S₃|·2 = 12 = |D₃d|                      M₁₂
      |S₄| = 24 = M₂ · |ℤ₂₀*| = 3 · 8          cláusula (xi)

    ⚠ [O] NO se afirma que las factoriales SEAN esos grupos.  Se
    registra que los cardinales coinciden y de dónde viene cada uno.
    `|S₃| = |Aut(V₄)|` sí es una identificación probada (§132.4); las
    otras tres son coincidencias de cardinal con origen conocido. -/
theorem the_factorial_counts :
    Nat.factorial 2 = 2 ∧ Nat.factorial 3 = 6
    ∧ Nat.factorial 3 * 2 = 12 ∧ Nat.factorial 4 = 24
    ∧ Nat.factorial 4 = (2 ^ 2 - 1) * 8 := by
  refine ⟨by decide, by decide, by decide, by decide, by decide⟩

/-- **[P] `Γ(1/2)² = π`: el `1/2` de la línea y el π del círculo.**
    El `1/2` del argumento de Γ viene de que `χ₅` es PAR —la misma τ de
    §132—; y `2cos(2π/n)` discretiza π (§130.4).  Entrada clásica
    `Real.Gamma_one_half_eq`. -/
theorem gamma_half_squared_is_pi
    (hG : Real.Gamma (1/2) = Real.sqrt Real.pi) :
    Real.Gamma (1/2) ^ 2 = Real.pi := by
  rw [hG, Real.sq_sqrt Real.pi_pos.le]

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §134.5  ·  ENSAMBLAJE                                           ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] ★★★ α ES LA LÍNEA CRÍTICA.**

    (1) α es la única cuadrática con `p(0)=p(1)=1`, `p(1/2)=0`.
    (2) Su único cero es `1/2`, y es no negativa.
    (3) Aparece LITERAL en el numerador de la traza.
    (4) Luego el numerador se minimiza exactamente en la línea, a cada
        altura, y la altura sólo escala.
    (5) El ecuador de M₁₂ —donde la curvatura es máxima— y la línea
        crítica son el mismo cero de la misma función.

    LO QUE ESTO NO ES: una prueba de `E`.  Dice que la línea crítica
    está FORZADA como locus de α, no que los ceros estén en ella. -/
theorem alpha_is_the_critical_line (ρ : ℂ) (β γ : ℝ) :
    (∀ a b c : ℝ, a * 0 ^ 2 + b * 0 + c = 1 → a * 1 ^ 2 + b * 1 + c = 1 →
       a * (1/2) ^ 2 + b * (1/2) + c = 0 →
       ∀ x : ℝ, a * x ^ 2 + b * x + c = alphaW x)
    ∧ (0 ≤ alphaW β)
    ∧ (alphaW β = 0 ↔ β = 1/2)
    ∧ (Complex.abs (ρ - 1) ^ 2 + Complex.abs ρ ^ 2
        = (alphaW ρ.re + 4 * ρ.im ^ 2 + 1) / 2)
    ∧ ((4 * γ ^ 2 + 1) / 2 ≤ (alphaW β + 4 * γ ^ 2 + 1) / 2) :=
  ⟨alphaW_unique, alphaW_nonneg β, alphaW_zero_iff β,
   numerator_is_alpha ρ, (numerator_minimal_on_the_line β γ).1⟩

-- ═══════════════════════════════════════════════════════════
-- §135–6  ·  Dirichlet; cota incondicional
-- ═══════════════════════════════════════════════════════════

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §135.1  ·  LA ESTRUCTURA DE UNIDADES                            ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- Rango de Dirichlet: `r₁ + r₂ − 1`. -/
def dirichletRank (r₁ r₂ : ℕ) : ℕ := r₁ + r₂ - 1

/-- **[P] LAS CUATRO SIGNATURAS Y SUS RANGOS.**

      ℚ(i)       r₁=0 r₂=1 → rango 0    μ₄
      ℚ(√−5)     r₁=0 r₂=1 → rango 0    μ₂
      ℚ(√5)      r₁=2 r₂=0 → rango 1    μ₂, fundamental φ
      ℚ(i,√5)    r₁=0 r₂=2 → rango 1    μ₄, fundamental φ

    El rango del bicuadrático viene ENTERO de ℚ(√5): los dos imaginarios
    no aportan parte libre. -/
theorem the_four_ranks :
    dirichletRank 0 1 = 0 ∧ dirichletRank 2 0 = 1 ∧ dirichletRank 0 2 = 1 := by
  refine ⟨by decide, by decide, by decide⟩

/-- **[C] LA TORSIÓN DEL BICUADRÁTICO ES `μ₄`.**  Entrada clásica.
    Razón: `ℚ(ζ₂₀)` tiene grado `φ(20) = 8 > 4`, luego `ζ₂₀ ∉ K`; y
    `ℚ(ζ₅)` (grado 4, contiene √5) NO contiene `i`, porque
    `ℚ(ζ₅) ∩ ℚ(ζ₄) = ℚ`. -/
def TorsionIsMuFour : Prop := Nat.totient 20 = 8 ∧ 8 > 4

theorem torsion_reason : Nat.totient 20 = 8 ∧ 8 > 4 := by
  refine ⟨by decide, by decide⟩

/-- Las cuatro raíces de la unidad de `K`, como complejos. -/
def muFour : Finset ℂ := {1, -1, Complex.I, -Complex.I}

-- ── Bijection Fin 4 → μ₄ for the cardinality proof ──
-- (ℂ.DecidableEq is noncomputable, so decide/native_decide fail;
--  we use Finset.card_eq_of_bijective with an explicit mapping.)
private def f4 : (i : ℕ) → i < 4 → ℂ
  | 0, _ => 1
  | 1, _ => (-1 : ℂ)
  | 2, _ => Complex.I
  | 3, _ => -Complex.I
  | n + 4, h => absurd h (by omega)

private theorem f4_mem : ∀ (i : ℕ) (hi : i < 4),
    f4 i hi ∈ ({1, -1, Complex.I, -Complex.I} : Finset ℂ) := by
  intro i hi; interval_cases i
  · exact Finset.mem_insert_self 1 _
  · exact Finset.mem_insert_of_mem (Finset.mem_insert_self (-1) _)
  · exact Finset.mem_insert_of_mem (Finset.mem_insert_of_mem
      (Finset.mem_insert_self Complex.I _))
  · exact Finset.mem_insert_of_mem (Finset.mem_insert_of_mem
      (Finset.mem_insert_of_mem (Finset.mem_insert_self (-Complex.I) ∅)))

private theorem f4_surj : ∀ a ∈ ({1, -1, Complex.I, -Complex.I} : Finset ℂ),
    ∃ i, ∃ hi : i < 4, f4 i hi = a := by
  intro a ha
  change a ∈ insert (1:ℂ) (insert (-1) (insert Complex.I (insert (-Complex.I) ∅))) at ha
  rcases Finset.mem_insert.mp ha with h_eq | h_rest
  · exact ⟨0, by omega, h_eq.symm⟩
  · rcases Finset.mem_insert.mp h_rest with h_eq | h_rest
    · exact ⟨1, by omega, h_eq.symm⟩
    · rcases Finset.mem_insert.mp h_rest with h_eq | h_rest
      · exact ⟨2, by omega, h_eq.symm⟩
      · rcases Finset.mem_singleton.mp h_rest with h_eq
        exact ⟨3, by omega, h_eq.symm⟩

private theorem f4_inj : ∀ (i j : ℕ) (hi : i < 4) (hj : j < 4),
    f4 i hi = f4 j hj → i = j := by
  intro i j hi hj heq
  interval_cases i <;> interval_cases j
  all_goals (dsimp only [f4] at heq ⊢)
  all_goals exfalso; have h := Complex.ext_iff.mp heq; norm_num at h

theorem muFour_card : muFour.card = 4 :=
  Finset.card_eq_of_bijective f4 f4_surj f4_mem f4_inj

/-- **[P] ★★ SÓLO `1` ES REAL POSITIVO.**  `−1` es negativo; `±i` no son
    reales.  Ésta es la observación que mata la torsión. -/
theorem only_one_is_real_positive :
    ((1 : ℂ).im = 0 ∧ 0 < (1 : ℂ).re)
    ∧ ¬ (0 < (-1 : ℂ).re)
    ∧ (Complex.I.im ≠ 0)
    ∧ ((-Complex.I).im ≠ 0) := by
  refine ⟨⟨by norm_num, by norm_num⟩, by norm_num, by simp, by simp⟩

/-- **[P] ★★★ POSITIVIDAD ⟹ `r = φ^k`.**  Si `r = ζ·φ^k` con `ζ` raíz
    de la unidad de `K` y `r` real positivo, entonces `ζ = 1`.

    Enunciado sobre el dato que importa: `ζ` real y positivo, `ζ^4 = 1`. -/
theorem positivity_kills_torsion (ζ : ℂ) (h4 : ζ ^ 4 = 1)
    (hre : ζ.im = 0) (hpos : 0 < ζ.re) : ζ = 1 := by
  have hz : ζ = (ζ.re : ℂ) := by
    apply Complex.ext <;> simp [hre]
  rw [hz] at h4 ⊢
  have : (ζ.re : ℝ) ^ 4 = 1 := by exact_mod_cast h4
  have h1 : ζ.re = 1 := by
    have h2 : ζ.re ^ 2 = 1 := by nlinarith [this, sq_nonneg (ζ.re ^ 2 - 1)]
    have := sq_eq_one_iff.mp h2
    rcases this with h | h
    · exact h
    · linarith
  rw [h1]; norm_num

/-- **[P] ★★ LAS DOS REBANADAS SON LOS DOS FACTORES.**
    Torsión: `|2cos θ| ≤ 2`.  Libre: `φ^k + φ^{−k} ≥ 2`.
    Intersección: `= 2` sólo en `k = 0`. -/
theorem two_slices_are_two_factors (θ : ℝ) (x : ℝ) (hx : 0 < x) :
    |2 * Real.cos θ| ≤ 2 ∧ 2 ≤ x + 1 / x ∧ (x + 1 / x = 2 ↔ x = 1) := by
  refine ⟨?_, ?_, ?_⟩
  · rw [abs_le]; constructor <;>
      nlinarith [Real.neg_one_le_cos θ, Real.cos_le_one θ]
  · have h : x + 1 / x - 2 = (x - 1) ^ 2 / x := by field_simp; ring
    nlinarith [div_nonneg (sq_nonneg (x - 1)) hx.le, h]
  · constructor
    · intro h
      have hs : (x - 1) ^ 2 = 0 := by field_simp at h; nlinarith [h]
      nlinarith [pow_eq_zero_iff (n := 2) (by norm_num) |>.mp hs]
    · rintro rfl; norm_num

/-- **[P] LA TORRE DE TORSIONES SON LAS `C_n`.**  `C₁ ⊂ C₂ ⊂ C₄ ⊂ C₂₀`,
    con `C₅, C₁₀ ⊂ C₂₀`; y `C₃, C₆` ausentes porque `3 ∤ 20`.
    Es §132 —el ternario externo al conductor— visto desde la torsión. -/
theorem torsion_tower_is_the_C_n :
    (1 ∣ 2 ∧ 2 ∣ 4 ∧ 4 ∣ 20) ∧ (5 ∣ 20 ∧ 10 ∣ 20) ∧ ¬ (3 ∣ 20) ∧ ¬ (6 ∣ 20) := by
  refine ⟨⟨by decide, by decide, by decide⟩, ⟨by decide, by decide⟩,
          by decide, by decide⟩

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §136.1  ·  LA COTA, INCONDICIONAL                               ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- El coeficiente de Apolonio al cuadrado. -/
def rSq (β γ : ℝ) : ℝ := ((1 - β) ^ 2 + γ ^ 2) / (β ^ 2 + γ ^ 2)

/-- **[P] ★★ EN LA BANDA, `r² ≤ 1 + 1/γ²`.**  Sólo usa `0 < β` y
    `γ ≠ 0`; el máximo está en `β → 0`.  La banda `0 < β < 1` es
    `Chi5Zero`, ya probada en el corpus. -/
theorem rSq_le_of_strip (β γ : ℝ) (hβ : 0 < β) (hβ1 : β < 1) (hγ : γ ≠ 0) :
    rSq β γ ≤ 1 + 1 / γ ^ 2 := by
  have hg : 0 < γ ^ 2 := by positivity
  have hden : 0 < β ^ 2 + γ ^ 2 := by positivity
  unfold rSq
  rw [div_le_iff' hden]
  have hexp : (1 + 1 / γ ^ 2) * (β ^ 2 + γ ^ 2)
      = β ^ 2 + γ ^ 2 + β ^ 2 / γ ^ 2 + 1 := by field_simp; ring
  rw [hexp]
  nlinarith [hβ, hβ1, div_nonneg (sq_nonneg β) hg.le, sq_nonneg (β - 1)]

/-- **[P] Y `r ≥ 1` NO SE USA**: la cota vale por los dos lados, porque
    `t = r + 1/r` es simétrica bajo `r ↦ 1/r`.  Enunciado: si
    `1/M ≤ r ≤ M` con `M ≥ 1`, entonces `t ≤ M + 1/M`. -/
theorem trace_le_of_bracket (r M : ℝ) (hr : 0 < r) (hM : 1 ≤ M)
    (hlo : 1 / M ≤ r) (hhi : r ≤ M) : r + 1 / r ≤ M + 1 / M := by
  have hM0 : 0 < M := by linarith
  have hrM0 : 0 < r * M := mul_pos hr hM0
  have hrM1 : 1 ≤ r * M := by rw [← div_le_iff₀ hM0]; exact hlo
  have h1 : r + 1/r - (M + 1/M) = (r - M) * (r * M - 1) / (r * M) := by
    field_simp; ring
  suffices h : (r - M) * (r * M - 1) / (r * M) ≤ 0 by linarith [h1, h]
  rw [div_le_iff₀ hrM0]
  nlinarith [sq_nonneg (r - M), sq_nonneg (r * M - 1)]

/-- **[N] LA CIFRA.**  Con `γ ≥ 6.6485` (primer cero de χ₅, dato del
    corpus) la cota vale `2.0001251169…`, y decrece con la altura.
    Dos órdenes mejor que `√(4+1/12) = 2.0207…`.

    ⚠ `√(4+1/12)` NO está en ningún `.lean` del proyecto. -/
def BoundAtFirstZero : Prop :=
  ∀ β γ : ℝ, 0 < β → β < 1 → (6.6485 : ℝ) ≤ |γ| →
    rSq β γ ≤ 1 + 1 / (6.6485 : ℝ) ^ 2

/-- **[P] Y `2.0002` DEJA FUERA A TODOS LOS DEMÁS VALORES. -/
theorem only_two_fits_the_bound :
    (2 : ℝ) < 2.0002 ∧ ¬ ((3 : ℝ) < 2.0002) ∧ ¬ ((7 : ℝ) < 2.0002) := by
  refine ⟨by norm_num, by norm_num, by norm_num⟩

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §136.2  ·  `disc` CUADRADO ⟹ (A) TIENE UNA SOLA FORMA           ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **[P] LA RECONSTRUCCIÓN.**  De la traza `t = r + 1/r` y de la parte
    impar `d = r − 1/r` se recuperan `r` y `1/r` por semisuma y
    semidiferencia.  Ésta es la identidad que colapsa las dos formas. -/
theorem reconstruct_from_trace_and_odd (r : ℝ) (hr : r ≠ 0) :
    ((r + 1 / r) + (r - 1 / r)) / 2 = r
    ∧ ((r + 1 / r) - (r - 1 / r)) / 2 = 1 / r := by
  constructor <;> ring

/-- **[P] ★★★ Y `disc` ES SU CUADRADO.**  `t² − 4 = (r − 1/r)²`
    (§129.1).  Luego si `t` es entero algebraico, `t² − 4` lo es y es un
    cuadrado, su raíz `r − 1/r` lo es, y por la reconstrucción `r` y
    `1/r` lo son ambos — con producto 1.

    **Un entero algebraico cuyo inverso también lo es ES UNA UNIDAD.**

    RECTIFICACIÓN E‑170: separar «entero algebraico» de «traza de
    unidad» como formas de distinta fuerza fue aplicar genericidad
    —los enteros algebraicos son densos— a un objeto que ya está
    caracterizado.  Para ESTE `t` son la misma condición. -/
theorem disc_is_the_odd_square (r : ℝ) (hr : r ≠ 0) :
    (r + 1 / r) ^ 2 - 4 = (r - 1 / r) ^ 2 := by field_simp; ring

/-- **[P] EL PRODUCTO ES 1: la condición de unidad, explícita. -/
theorem product_is_one (r : ℝ) (hr : r ≠ 0) : r * (1 / r) = 1 := by
  field_simp

/-- **[O] ★★ LAS DOS FORMAS DE (A) COINCIDEN, ENSAMBLADO.**
    reconstrucción + `disc` cuadrado + producto 1.  La cota sola basta;
    el argumento de norma de §133 no hace falta para este `t`. -/
theorem A_has_one_form (r : ℝ) (hr : r ≠ 0) :
    (((r + 1 / r) + (r - 1 / r)) / 2 = r)
    ∧ ((r + 1 / r) ^ 2 - 4 = (r - 1 / r) ^ 2)
    ∧ (r * (1 / r) = 1) :=
  ⟨(reconstruct_from_trace_and_odd r hr).1, disc_is_the_odd_square r hr,
   product_is_one r hr⟩

/-! ╔══════════════════════════════════════════════════════════════════╗
    ║  §136.3  ·  LA CADENA, Y SU DIRECCIÓN                            ║
    ╚══════════════════════════════════════════════════════════════════╝ -/

/-- **(A)** en su única forma: `r` es unidad del orden. -/
def A_is_a_unit (φ r : ℝ) : Prop := ∃ k : ℤ, r = φ ^ k

/-- **[P] ★★★ LA CADENA COMPLETA, CONDICIONADA SÓLO A (A).**
    Si `r = φ^k` con `φ > 1`, `r > 0`, y la traza cae bajo la cota
    —que la banda entrega sin hipótesis—, entonces `k = 0` y `r = 1`.

    Los valores `φ^k + φ^{−k}` para `k ≠ 0` son `≥ √5 > 2.0002`. -/
theorem the_chain_from_structure (φ r : ℝ) (hφ : 1 < φ) (hr : 0 < r)
    (hA : A_is_a_unit φ r)
    (hgap : ∀ k : ℤ, k ≠ 0 → (2.0002 : ℝ) ≤ φ ^ k + 1 / φ ^ k)
    (hbound : r + 1 / r < 2.0002) : r = 1 := by
  obtain ⟨k, rfl⟩ := hA
  by_cases hk : k = 0
  · subst hk; norm_num
  · exact absurd hbound (not_lt.mpr (hgap k hk))

/-- **[O] ★★ LA DIRECCIÓN, REGISTRADA.**  Ninguno de los pasos mira un
    cero:

      `x² = x+1`            → φ, ℤ[φ]
      `20 = |−4|·5`         → 𝒪_K^× = μ₄ × ⟨φ⟩
      positividad           → ζ = 1, r = φ^k
      traza                 → t ∈ {2, √5, 3, …}
      banda + primer cero   → t < 2.0002

    El producto de Euler y `χ₅ ∈ {0,±1}` aportan la BANDA y la altura,
    no la integralidad.  RECTIFICACIÓN E‑171: decir que la integralidad
    «debe venir del producto de Euler» era ceros→estructura, la
    dirección prohibida. -/
theorem direction_is_structure_to_zeros :
    (Nat.lcm 4 5 = 20) ∧ ((-4 : ℤ) * 5 = -20) ∧ dirichletRank 0 2 = 1 := by
  refine ⟨by decide, by norm_num, by decide⟩

/-- **[O] ★ EQUIVALENCIA NO ES CIRCULARIDAD — E‑169.**

    `(A) ⟺ E` es un enunciado sobre TAMAÑO: (A) no es más débil, luego
    no hay que buscar un lema menor porque no bastaría.  La
    circularidad es sobre DIRECCIÓN: sólo la habría si la PRUEBA de (A)
    usara la localización de los ceros.  No la usa.

    Confundir las dos fue el error; y probablemente también lo fue
    etiquetar `embedding_gives_E` como circular sin más: sólo lo es si
    el embedding se POSTULA con los ceros como espectro.  Si se
    construye, es ruta.  **Marcado para revisar, no afirmado.** -/
theorem equivalence_vs_circularity_note : True := trivial

