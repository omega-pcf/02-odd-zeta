theorem the_next_possible_disc_is_five (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|) :
    -- la cota, incondicional
    (discP (zeroCoord ρ) ≤ 1/12) ∧
    -- los discriminantes enteros posibles: 0, luego 5, luego 12
    (((2:ℤ) ^ 2 - 4 = 0) ∧ ((3:ℤ) ^ 2 - 4 = 5) ∧ ((4:ℤ) ^ 2 - 4 = 12)) ∧
    -- y las trazas menores dan discriminante NEGATIVO
    (((1:ℤ) ^ 2 - 4 = -3) ∧ ((0:ℤ) ^ 2 - 4 = -4)) ∧
    -- luego con la cota sólo sobrevive el cero, que es E
    ((discP (zeroCoord ρ) = 0) ↔ ρ.re = 1/2) :=
  ⟨discBound_of_high_gamma ρ h0 h1 hγ,
   ⟨the_integer_traces_and_their_discriminants.1,
    the_integer_traces_and_their_discriminants.2.1,
    the_integer_traces_and_their_discriminants.2.2.1⟩,
   ⟨the_integer_traces_and_their_discriminants.2.2.2.1,
    the_integer_traces_and_their_discriminants.2.2.2.2⟩,
   disc_zero_iff_half ρ h0 h1⟩

theorem the_discreteness_is_the_quadratic_unit (ρ : ℂ) (r : ℝ) (hr : 0 < r)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|) :
    -- discP ES el discriminante de x² − tx + 1 con raíces r, 1/r
    ((discP r = (r + 1/r) ^ 2 - 4) ∧ (r * (1/r) = 1)) ∧
    -- traza 2 ⟹ r = 1
    ((r + 1/r = 2) → r = 1) ∧
    -- y la coordenada vale 1 syss E
    ((zeroCoord ρ = 1) ↔ ρ.re = 1/2) ∧
    -- con la cota 1/12 y el siguiente disc entero en 5
    ((discP (zeroCoord ρ) ≤ 1/12) ∧ ((3:ℤ) ^ 2 - 4 = 5)) :=
  ⟨⟨discP_is_the_quadratic_discriminant r (ne_of_gt hr), by field_simp⟩,
   fun ht => trace_two_gives_the_line r hr ht,
   coord_eq_one_iff_re_half ρ h0,
   ⟨discBound_of_high_gamma ρ h0 h1 hγ,
    the_integer_traces_and_their_discriminants.2.1⟩⟩

theorem the_trace_is_bounded_below (r : ℝ) (hr : 0 < r) :
    2 ≤ r + 1/r := by
  have h : (r - 1) ^ 2 ≥ 0 := sq_nonneg _
  have expand : (r - 1) ^ 2 = r * r - 2 * r + 1 := by ring
  rw [expand] at h
  have h1 : r * r + 1 ≥ 2 * r := by linarith
  have h2 : 2 ≤ (r * r + 1) / r := by
    rw [le_div_iff₀ hr]; linarith
  have h3 : (r * r + 1) / r = r + 1/r := by
    field_simp
  calc 2 ≤ (r * r + 1) / r := h2
    _ = r + 1/r := h3

theorem the_trace_equals_two_iff_ratio_one (r : ℝ) (hr : 0 < r) :
    r + 1/r = 2 ↔ r = 1 := by
  constructor
  · intro h; exact trace_two_gives_the_line r hr h
  · intro h; rw [h]; norm_num

theorem the_trace_is_pinned_between_two_and_the_bound (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|)
    (hpos : 0 < zeroCoord ρ) :
    (2 ≤ zeroCoord ρ + 1/(zeroCoord ρ)) ∧
    (discP (zeroCoord ρ) ≤ 1/12) ∧
    (discP (zeroCoord ρ) = (zeroCoord ρ + 1/(zeroCoord ρ)) ^ 2 - 4) :=
  ⟨the_trace_is_bounded_below (zeroCoord ρ) hpos,
   discBound_of_high_gamma ρ h0 h1 hγ,
   discP_is_the_quadratic_discriminant (zeroCoord ρ) (ne_of_gt hpos)⟩

theorem the_trace_is_confined_to_a_tiny_interval (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|)
    (hpos : 0 < zeroCoord ρ) :
    (2 ≤ zeroCoord ρ + 1/(zeroCoord ρ)) ∧
    ((zeroCoord ρ + 1/(zeroCoord ρ)) ^ 2 ≤ 4 + 1/12) := by
  refine ⟨the_trace_is_bounded_below (zeroCoord ρ) hpos, ?_⟩
  have hd := discBound_of_high_gamma ρ h0 h1 hγ
  have he := discP_is_the_quadratic_discriminant (zeroCoord ρ) (ne_of_gt hpos)
  linarith [hd, he.symm ▸ hd]

theorem the_only_integer_in_that_interval_is_two :
    ((2:ℝ) ^ 2 = 4) ∧ ((3:ℝ) ^ 2 = 9) ∧ ((4:ℝ) + 1/12 < 9) := by
  refine ⟨by norm_num, by norm_num, by norm_num⟩

theorem integrality_would_close_it (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|)
    (hpos : 0 < zeroCoord ρ)
    (hint : ∃ n : ℕ, zeroCoord ρ + 1/(zeroCoord ρ) = (n : ℝ)) :
    ρ.re = 1/2 := by
  obtain ⟨n, hn⟩ := hint
  have hlo : 2 ≤ (n : ℝ) := hn ▸ the_trace_is_bounded_below (zeroCoord ρ) hpos
  have hhi : ((n : ℝ)) ^ 2 ≤ 4 + 1/12 := by
    rw [← hn]; exact (the_trace_is_confined_to_a_tiny_interval ρ h0 h1 hγ hpos).2
  have hn2 : (n : ℝ) = 2 := by
    rcases lt_trichotomy ((n : ℝ)) 2 with h | h | h
    · linarith
    · exact h
    · exfalso
      have h3 : (3 : ℝ) ≤ (n : ℝ) := by
        have : (2 : ℕ) < n := by exact_mod_cast h
        exact_mod_cast Nat.succ_le_of_lt this
      nlinarith [hhi, h3]
  have : zeroCoord ρ + 1/(zeroCoord ρ) = 2 := by rw [hn, hn2]
  have hr1 : zeroCoord ρ = 1 := trace_two_gives_the_line _ hpos this
  exact (coord_eq_one_iff_re_half ρ h0).mp hr1

theorem liMap_is_the_ratio (ρ : ℂ) (hρ : ρ ≠ 0) :
    liMap ρ = (ρ - 1) / ρ := by
  unfold liMap; field_simp

theorem the_coordinate_is_a_ratio_of_distances (ρ : ℂ) (hρ : ρ ≠ 0) :
    zeroCoord ρ = Complex.abs (ρ - 1) / Complex.abs ρ := by
  unfold zeroCoord
  rw [liMap_is_the_ratio ρ hρ, Complex.abs_div]

theorem apollonius_degenerates_at_ratio_one (ρ : ℂ) (hρ : ρ ≠ 0) :
    (Complex.abs (ρ - 1) = Complex.abs ρ) ↔ ρ.re = 1/2 := by
  have h := liMap_abs_eq_one_iff_half ρ hρ
  rw [liMap_is_the_ratio ρ hρ, Complex.abs_div,
      div_eq_one_iff_eq (by simpa using hρ)] at h
  exact h

theorem the_apollonius_circle_is_the_level_set (ρ : ℂ) (hρ : ρ ≠ 0) (k : ℝ) :
    (zeroCoord ρ = k) ↔ (Complex.abs (ρ - 1) / Complex.abs ρ = k) := by
  rw [the_coordinate_is_a_ratio_of_distances ρ hρ]

theorem equidistance_is_the_critical_line (ρ : ℂ) (hρ : ρ ≠ 0) :
    (Complex.abs (ρ - 1) = Complex.abs ρ) ↔ (zeroCoord ρ = 1) := by
  rw [the_coordinate_is_a_ratio_of_distances ρ hρ,
      div_eq_one_iff_eq (by simpa using hρ)]

theorem apollonius_closes_in_lean (ρ : ℂ) (hρ : ρ ≠ 0) (k : ℝ) :
    -- la coordenada ES la razón de distancias a 1 y a 0
    (zeroCoord ρ = Complex.abs (ρ - 1) / Complex.abs ρ) ∧
    -- «coordenada = k» es «ρ en el círculo de Apolonio de razón k»
    ((zeroCoord ρ = k) ↔ (Complex.abs (ρ - 1) / Complex.abs ρ = k)) ∧
    -- k = 1 es la EQUIDISTANCIA
    ((Complex.abs (ρ - 1) = Complex.abs ρ) ↔ (zeroCoord ρ = 1)) ∧
    -- y la equidistancia ES la línea crítica: el círculo degenera en la mediatriz
    ((Complex.abs (ρ - 1) = Complex.abs ρ) ↔ ρ.re = 1/2) :=
  ⟨the_coordinate_is_a_ratio_of_distances ρ hρ,
   the_apollonius_circle_is_the_level_set ρ hρ k,
   equidistance_is_the_critical_line ρ hρ,
   apollonius_degenerates_at_ratio_one ρ hρ⟩

theorem trace_integral_gives_the_embedding (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|)
    (hpos : 0 < zeroCoord ρ)
    (hint : ∃ n : ℕ, zeroCoord ρ + 1/(zeroCoord ρ) = (n : ℝ)) :
    (ρ.re = 1/2 ∨ ρ.re = -(1/4)) := by
  left
  exact integrality_would_close_it ρ h0 h1 hγ hpos hint

theorem the_embedding_gives_trace_integral (ρ : ℂ) (h0 : 0 < ρ.re)
    (hE : ρ.re = 1/2) :
    ∃ n : ℕ, zeroCoord ρ + 1/(zeroCoord ρ) = (n : ℝ) := by
  have h1 : zeroCoord ρ = 1 := (coord_eq_one_iff_re_half ρ h0).mpr hE
  exact ⟨2, by rw [h1]; norm_num⟩

theorem the_two_labels_are_one_gap (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|)
    (hpos : 0 < zeroCoord ρ) :
    ((∃ n : ℕ, zeroCoord ρ + 1/(zeroCoord ρ) = (n : ℝ)) ↔ ρ.re = 1/2) := by
  constructor
  · intro hint; exact integrality_would_close_it ρ h0 h1 hγ hpos hint
  · intro hE
    obtain ⟨n, hn⟩ := the_embedding_gives_trace_integral ρ h0 hE
    exact ⟨n, hn⟩

theorem one_gap_four_names (ρ : ℂ) (L : ℂ → ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|)
    (hpos : 0 < zeroCoord ρ) (hle : discP (zeroCoord ρ) ≤ 1/12) :
    -- (1) la traza entera
    ((∃ n : ℕ, zeroCoord ρ + 1/(zeroCoord ρ) = (n : ℝ)) ↔ ρ.re = 1/2) ∧
    -- (2) el descenso a F₁
    ((IsMonomial (zeroCoord ρ)) ↔ ρ.re = 1/2) ∧
    -- (3) la pertenencia a la cadena
    ((inChain (discP (zeroCoord ρ))) ↔ ρ.re = 1/2) ∧
    -- (4) y el embedding, vía GDS
    (GDS L ↔ (∀ s : ℂ, 0 < s.re → s.re < 1 → L s = 0 → s.re = 1/2)) :=
  ⟨the_two_labels_are_one_gap ρ h0 h1 hγ hpos,
   descending_to_F1_is_E ρ hpos hle h0,
   membership_is_E_in_disguise ρ h0 h1 hγ,
   GDS_iff_E L⟩

theorem the_eight_families_of_E (ρ : ℂ) (s : ℂ) (x : ℝ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|)
    (hρ : ρ ≠ 0) (hpos : 0 < zeroCoord ρ)
    (hle : discP (zeroCoord ρ) ≤ 1/12) :
    -- (1) SIMETRÍA / KLEIN
    ((1 - (starRingEnd ℂ) s = s ↔ s.re = 1/2) ∧
     (kmate ρ = ρ ↔ ρ.re = 1/2)) ∧
    -- (2) GEOMETRÍA / APOLONIO
    ((Complex.abs (ρ - 1) = Complex.abs ρ ↔ ρ.re = 1/2) ∧
     (s ∈ symmetryLocus ↔ s.re = 1/2)) ∧
    -- (3) PRODUCTO Y PARTE IMAGINARIA
    (((ρ * (1 - ρ)).im = 0 ↔ ρ.re = 1/2)) ∧
    -- (4) COORDENADA Y DISCRIMINANTE
    ((zeroCoord ρ = 1 ↔ ρ.re = 1/2) ∧
     (discP (zeroCoord ρ) = 0 ↔ ρ.re = 1/2) ∧
     (valPhi (zeroCoord ρ) = 0 ↔ ρ.re = 1/2)) ∧
    -- (5) ÓRBITA Y RADIO
    (((rad₉ ρ (1 - ρ)).re = 0 ↔ ρ.re = 1/2)) ∧
    -- (6) ARITMÉTICA / DESCENSO
    ((IsMonomial (zeroCoord ρ) ↔ ρ.re = 1/2) ∧
     (inChain (discP (zeroCoord ρ)) ↔ ρ.re = 1/2) ∧
     ((∃ n : ℕ, zeroCoord ρ + 1/(zeroCoord ρ) = (n : ℝ)) ↔ ρ.re = 1/2)) ∧
    -- (7) POLINOMIOS
    (((x = 1/2 ∨ x = -(1/4)) ↔ spectralPoly x = 0)) ∧
    -- (8) y todo junto vale para el mismo ρ
    (((rad₉ ρ (1 - ρ)).re = 0 ↔ zeroCoord ρ = 1)) := by
  have hγ0 : ρ.im ≠ 0 := by
    intro h; rw [h] at hγ; simp at hγ; linarith
  refine ⟨⟨stau_fixed_iff_critical s, kmate_fixed_iff ρ⟩,
         ⟨apollonius_degenerates_at_ratio_one ρ hρ, mem_symmetryLocus_iff s⟩,
         F5_iff_F1 ρ hγ0,
         ⟨coord_eq_one_iff_re_half ρ h0, disc_zero_iff_half ρ h0 h1,
          degenerate_iff_valuation_zero ρ h0 h1⟩,
         orbit_radius_vanishes_iff_E ρ,
         ⟨descending_to_F1_is_E ρ hpos hle h0,
          membership_is_E_in_disguise ρ h0 h1 hγ,
          the_two_labels_are_one_gap ρ h0 h1 hγ hpos⟩,
         mem_target_iff_spectralPoly_zero x,
         ⟨fun hL => (coord_eq_one_iff_re_half ρ h0).mpr ((orbit_radius_vanishes_iff_E ρ).mp hL),
          fun hR => (orbit_radius_vanishes_iff_E ρ).mpr ((coord_eq_one_iff_re_half ρ h0).mp hR)⟩⟩

theorem the_gap_has_ninety_three_names_not_four (ρ : ℂ) (s : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|)
    (hρ : ρ ≠ 0) (hpos : 0 < zeroCoord ρ) :
    -- las cuatro que dije, TODAS de la familia aritmética
    (((IsMonomial (zeroCoord ρ) → ρ.re = 1/2)) ∧
     ((inChain (discP (zeroCoord ρ))) ↔ ρ.re = 1/2)) ∧
    -- y las que dejé fuera, de familias DISTINTAS
    ((1 - (starRingEnd ℂ) s = s ↔ s.re = 1/2) ∧
     (Complex.abs (ρ - 1) = Complex.abs ρ ↔ ρ.re = 1/2) ∧
     ((ρ * (1 - ρ)).im = 0 ↔ ρ.re = 1/2) ∧
     ((rad₉ ρ (1 - ρ)).re = 0 ↔ ρ.re = 1/2) ∧
     (kmate ρ = ρ ↔ ρ.re = 1/2)) := by
  have hγ0 : ρ.im ≠ 0 := by
    intro h; rw [h] at hγ; simp at hγ; linarith
  refine ⟨⟨fun hm => ?_, membership_is_E_in_disguise ρ h0 h1 hγ⟩,
          stau_fixed_iff_critical s,
          apollonius_degenerates_at_ratio_one ρ hρ,
          F5_iff_F1 ρ hγ0,
          orbit_radius_vanishes_iff_E ρ,
          kmate_fixed_iff ρ⟩
  obtain ⟨k, hk⟩ := hm
  exact monomial_would_close_it ρ h0 h1 hγ ⟨k, hk⟩

theorem a_trivial_reformulation_is_pure_algebra (s : ℂ) :
    (1 - (starRingEnd ℂ) s = s ↔ s.re = 1/2) ∧
    (s ∈ symmetryLocus ↔ s.re = 1/2) ∧
    (kmate s = s ↔ s.re = 1/2) :=
  ⟨stau_fixed_iff_critical s, mem_symmetryLocus_iff s, kmate_fixed_iff s⟩

theorem the_trivial_ones_hold_for_any_complex_number :
    ((1 : ℂ) - (starRingEnd ℂ) ⟨1/2, 7⟩ = ⟨1/2, 7⟩) ∧
    ((⟨1/2, 7⟩ : ℂ).re = 1/2) := by
  refine ⟨?_, rfl⟩
  simp [Complex.ext_iff]
  norm_num

theorem the_substantive_ones_add_discreteness (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|)
    (hpos : 0 < zeroCoord ρ) (hle : discP (zeroCoord ρ) ≤ 1/12) :
    (IsMonomial (zeroCoord ρ) ↔ ρ.re = 1/2) ∧
    (inChain (discP (zeroCoord ρ)) ↔ ρ.re = 1/2) ∧
    ((∃ n : ℕ, zeroCoord ρ + 1/(zeroCoord ρ) = (n : ℝ)) ↔ ρ.re = 1/2) :=
  ⟨descending_to_F1_is_E ρ hpos hle h0,
   membership_is_E_in_disguise ρ h0 h1 hγ,
   the_two_labels_are_one_gap ρ h0 h1 hγ hpos⟩

theorem the_difference_is_the_hypotheses (ρ : ℂ) (s : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|)
    (hpos : 0 < zeroCoord ρ) (hle : discP (zeroCoord ρ) ≤ 1/12) :
    -- TRIVIALES: sin ninguna hipótesis, valen para TODO s ∈ ℂ
    ((1 - (starRingEnd ℂ) s = s ↔ s.re = 1/2) ∧
     (s ∈ symmetryLocus ↔ s.re = 1/2) ∧
     (kmate s = s ↔ s.re = 1/2)) ∧
    -- SUSTANTIVAS: piden la banda, la altura y la cota
    ((IsMonomial (zeroCoord ρ) ↔ ρ.re = 1/2) ∧
     (inChain (discP (zeroCoord ρ)) ↔ ρ.re = 1/2)) :=
  ⟨a_trivial_reformulation_is_pure_algebra s,
   ⟨descending_to_F1_is_E ρ hpos hle h0,
    membership_is_E_in_disguise ρ h0 h1 hγ⟩⟩

theorem none_of_them_is_equivalent_to_the_conjecture (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|) (hpos : 0 < zeroCoord ρ) :
    -- todas son PUNTUALES: hablan de UN ρ
    ((inChain (discP (zeroCoord ρ))) ↔ ρ.re = 1/2) ∧
    -- la CONJETURA es universal sobre Chi5Zero
    ((∀ z : Chi5Zero, z.ρ.re = 1/2) ↔
       (chi5ZeroRealParts ⊆ symmetryLocus)) :=
  ⟨membership_is_E_in_disguise ρ h0 h1 hγ,
   face_containment_iff_GRH.symm⟩

theorem the_ladder_is_complete (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|) (hpos : 0 < zeroCoord ρ)
    (hle : discP (zeroCoord ρ) ≤ 1/12) :
    -- E₁ ⟺ las tres formas con contenido, en un punto
    ((IsMonomial (zeroCoord ρ) ↔ ρ.re = 1/2) ∧
     (inChain (discP (zeroCoord ρ)) ↔ ρ.re = 1/2) ∧
     ((∃ n : ℕ, zeroCoord ρ + 1/(zeroCoord ρ) = (n : ℝ)) ↔ ρ.re = 1/2)) ∧
    -- E₃ ⟺ E₄, probado en las dos direcciones
    ((∀ z : Chi5Zero, z.ρ.re = 1/2) ↔ ConjectureE) ∧
    -- y E₃ ⟺ la contención de caras
    ((chi5ZeroRealParts ⊆ symmetryLocus) ↔ ∀ z : Chi5Zero, z.ρ.re = 1/2) :=
  ⟨⟨descending_to_F1_is_E ρ hpos hle h0,
    membership_is_E_in_disguise ρ h0 h1 hγ,
    the_two_labels_are_one_gap ρ h0 h1 hγ hpos⟩,
   ⟨E3_gives_E4, E4_gives_E3⟩,
   face_containment_iff_GRH⟩

theorem E1_at_every_zero_is_E3
    (h : ∀ z : Chi5Zero, (0 < z.ρ.re ∧ z.ρ.re < 1 ∧ 2 ≤ |z.ρ.im| ∧
         0 < zeroCoord z.ρ ∧ discP (zeroCoord z.ρ) ≤ 1/12) →
         IsMonomial (zeroCoord z.ρ)) :
    (∀ z : Chi5Zero, (0 < z.ρ.re ∧ z.ρ.re < 1 ∧ 2 ≤ |z.ρ.im| ∧
       0 < zeroCoord z.ρ ∧ discP (zeroCoord z.ρ) ≤ 1/12) → z.ρ.re = 1/2) := by
  intro z hz
  obtain ⟨h0, h1, hγ, hpos, hle⟩ := hz
  exact (descending_to_F1_is_E z.ρ hpos hle h0).mp (h z ⟨h0, h1, hγ, hpos, hle⟩)

theorem the_conjecture_is_E4_and_the_ladder_reaches_it
    (h : ∀ z : Chi5Zero, z.ρ.re = 1/2) :
    ConjectureE ∧ (chi5ZeroRealParts ⊆ symmetryLocus) :=
  ⟨E3_gives_E4 h, face_containment_iff_GRH.mpr h⟩

theorem nothing_is_ambiguous (ρ : ℂ)
    (h0 : 0 < ρ.re) (h1 : ρ.re < 1) (hγ : 2 ≤ |ρ.im|) (hpos : 0 < zeroCoord ρ)
    (hle : discP (zeroCoord ρ) ≤ 1/12) :
    -- NIVEL 1: en un punto, y con contenido
    (IsMonomial (zeroCoord ρ) ↔ ρ.re = 1/2) ∧
    -- NIVEL 3 ⟺ NIVEL 4: probado, sin hipótesis
    ((∀ z : Chi5Zero, z.ρ.re = 1/2) ↔ ConjectureE) ∧
    -- y todo Chi5Zero vive en stripZeros: el puente entre los dos dominios
    (∀ z : Chi5Zero, z.ρ ∈ stripZeros (DirichletCharacter.LFunction chi5_D)) :=
  ⟨descending_to_F1_is_E ρ hpos hle h0,
   ⟨E3_gives_E4, E4_gives_E3⟩,
   chi5Zero_mem_stripZeros⟩

theorem the_trace_as_a_quotient (ρ : ℂ) (hρ : ρ ≠ 0) (hρ1 : ρ ≠ 1) :
    zeroCoord ρ + 1/(zeroCoord ρ)
      = (Complex.abs (ρ - 1) ^ 2 + Complex.abs ρ ^ 2)
        / (Complex.abs (ρ - 1) * Complex.abs ρ) := by
  rw [the_coordinate_is_a_ratio_of_distances ρ hρ]
  have h1 : Complex.abs ρ ≠ 0 := by simpa using hρ
  have h2 : Complex.abs (ρ - 1) ≠ 0 := by
    intro h
    have h1' : Complex.normSq (ρ - 1) = 0 := by
      have habs : Complex.abs (ρ - 1) = 0 := h
      have h2sq : ‖ρ - 1‖ ^ 2 = 0 := by rw [show ‖ρ - 1‖ = Complex.abs (ρ - 1) from rfl, habs]; ring
      simpa [Complex.sq_norm] using h2sq
    have hz : ρ - 1 = 0 := Complex.normSq_eq_zero.mp h1'
    exact hρ1 (by
      have hre : ρ.re - 1 = 0 := (Complex.ext_iff.mp hz).1
      have him : ρ.im - 0 = 0 := (Complex.ext_iff.mp hz).2
      have hre2 : ρ.re = 1 := by linarith
      have him2 : ρ.im = 0 := by linarith
      change ρ = 1
      exact Complex.ext hre2 him2)
  field_simp

theorem the_numerator_is_rational_in_beta_and_gamma (ρ : ℂ) :
    Complex.abs (ρ - 1) ^ 2 + Complex.abs ρ ^ 2
      = 1 - 2 * ρ.re + 2 * ρ.re ^ 2 + 2 * ρ.im ^ 2 := by
  rw [Complex.sq_abs, Complex.sq_abs]
  simp only [Complex.normSq_apply, Complex.sub_re, Complex.sub_im,
    Complex.one_re, Complex.one_im]
  ring

theorem on_the_line_the_two_factors_agree (ρ : ℂ) (hE : ρ.re = 1/2) :
    Complex.abs (ρ - 1) ^ 2 = Complex.abs ρ ^ 2 := by
  rw [Complex.sq_abs, Complex.sq_abs]
  simp only [Complex.normSq_apply, Complex.sub_re, Complex.sub_im,
    Complex.one_re, Complex.one_im]
  rw [hE]; ring

theorem the_integrality_is_a_perfect_square_condition (ρ : ℂ)
    (hρ : ρ ≠ 0) (hρ1 : ρ ≠ 1) :
    -- la traza es un cociente: racional / raíz cuadrada
    (zeroCoord ρ + 1/(zeroCoord ρ)
      = (Complex.abs (ρ - 1) ^ 2 + Complex.abs ρ ^ 2)
        / (Complex.abs (ρ - 1) * Complex.abs ρ)) ∧
    -- el numerador es RACIONAL en β y γ
    (Complex.abs (ρ - 1) ^ 2 + Complex.abs ρ ^ 2
      = 1 - 2 * ρ.re + 2 * ρ.re ^ 2 + 2 * ρ.im ^ 2) ∧
    -- y en la línea los dos factores del denominador COINCIDEN
    (ρ.re = 1/2 → Complex.abs (ρ - 1) ^ 2 = Complex.abs ρ ^ 2) :=
  ⟨the_trace_as_a_quotient ρ hρ hρ1,
   the_numerator_is_rational_in_beta_and_gamma ρ,
   fun hE => on_the_line_the_two_factors_agree ρ hE⟩

theorem where_the_discreteness_attempt_stops (ρ : ℂ)
    (hρ : ρ ≠ 0) (hρ1 : ρ ≠ 1) (h0 : 0 < ρ.re) (h1 : ρ.re < 1)
    (hγ : 2 ≤ |ρ.im|) (hpos : 0 < zeroCoord ρ) :
    -- lo que la traza ES
    (zeroCoord ρ + 1/(zeroCoord ρ)
      = (Complex.abs (ρ - 1) ^ 2 + Complex.abs ρ ^ 2)
        / (Complex.abs (ρ - 1) * Complex.abs ρ)) ∧
    -- lo que está probado sobre ella
    ((2 ≤ zeroCoord ρ + 1/(zeroCoord ρ)) ∧
     ((zeroCoord ρ + 1/(zeroCoord ρ)) ^ 2 ≤ 4 + 1/12)) ∧
    -- y lo que cerraría: que sea entera
    (((∃ n : ℕ, zeroCoord ρ + 1/(zeroCoord ρ) = (n : ℝ)) ↔ ρ.re = 1/2)) :=
  ⟨the_trace_as_a_quotient ρ hρ hρ1,
   ⟨the_trace_is_bounded_below (zeroCoord ρ) hpos,
    (the_trace_is_confined_to_a_tiny_interval ρ h0 h1 hγ hpos).2⟩,
   the_two_labels_are_one_gap ρ h0 h1 hγ hpos⟩

theorem euler_gives_rationality (h : EulerEvenValues) (k : ℕ) (hk : 1 ≤ k) :
    ∃ q : ℚ, riemannZeta (2 * k) = (q : ℂ) * (Real.pi : ℂ) ^ (2 * k) :=
  h k hk

open scoped LSeries.notation in
theorem the_euler_chain_reaches_the_conductor (h : EulerEvenValues)
    {s : ℂ} (hs : 1 < s.re) :
    (∃ q : ℚ, riemannZeta 2 = (q : ℂ) * (Real.pi : ℂ) ^ 2) ∧
    (∏' (p : Nat.Primes), (1 - (p : ℂ) ^ (-s))⁻¹ = riemannZeta s) ∧
    (zeta_K s = riemannZeta s * L ↗chi5_D s) := by
  refine ⟨?_, euler_product_identity hs, dedekind_factorisation hs⟩
  have := h 1 (le_refl 1)
  simpa using this

theorem the_rational_part_is_where_integers_live :
    ((Real.pi ^ 2 / 6) / (Real.pi / 3) ^ 2 = 9 / 6) ∧
    (Real.Gamma (1/2) = Real.sqrt Real.pi) ∧
    ((1:ℝ)/6 * 6 = 1) ∧ ((1:ℝ)/90 * 90 = 1) := by
  refine ⟨zeta_two_over_pi_third_sq, identification_gamma_face, by norm_num, by norm_num⟩

theorem euler_and_the_square_condition (ρ : ℂ) (h : EulerEvenValues)
    (hρ : ρ ≠ 0) (hρ1 : ρ ≠ 1) :
    -- EULER: ζ par es RACIONAL por π^2k — la fuente de racionalidad
    ((∀ k : ℕ, 1 ≤ k → ∃ q : ℚ, riemannZeta (2 * k) = (q : ℂ) * (Real.pi : ℂ) ^ (2 * k))) ∧
    -- y ζ(2)/(π/3)² = 9/6, un RACIONAL explícito
    ((Real.pi ^ 2 / 6) / (Real.pi / 3) ^ 2 = 9 / 6) ∧
    -- LA TRAZA: numerador racional en β,γ sobre una raíz cuadrada
    ((zeroCoord ρ + 1/(zeroCoord ρ)
        = (Complex.abs (ρ - 1) ^ 2 + Complex.abs ρ ^ 2)
          / (Complex.abs (ρ - 1) * Complex.abs ρ)) ∧
     (Complex.abs (ρ - 1) ^ 2 + Complex.abs ρ ^ 2
        = 1 - 2 * ρ.re + 2 * ρ.re ^ 2 + 2 * ρ.im ^ 2)) :=
  ⟨h, zeta_two_over_pi_third_sq,
   ⟨the_trace_as_a_quotient ρ hρ hρ1,
    the_numerator_is_rational_in_beta_and_gamma ρ⟩⟩

theorem what_euler_gives_and_what_it_does_not (ρ : ℂ) (h : EulerEvenValues)
    (hρ : ρ ≠ 0) (hρ1 : ρ ≠ 1) {s : ℂ} (hs : 1 < s.re) :
    -- lo que Euler SÍ da: racionalidad en los valores PARES
    ((∀ k : ℕ, 1 ≤ k → ∃ q : ℚ, riemannZeta (2 * k) = (q : ℂ) * (Real.pi : ℂ) ^ (2 * k)) ∧
     (∏' (p : Nat.Primes), (1 - (p : ℂ) ^ (-s))⁻¹ = riemannZeta s)) ∧
    -- y lo que la traza necesita: que un PRODUCTO sea cuadrado perfecto
    ((zeroCoord ρ + 1/(zeroCoord ρ)
        = (Complex.abs (ρ - 1) ^ 2 + Complex.abs ρ ^ 2)
          / (Complex.abs (ρ - 1) * Complex.abs ρ)) ∧
     (ρ.re = 1/2 → Complex.abs (ρ - 1) ^ 2 = Complex.abs ρ ^ 2)) :=
  ⟨⟨h, euler_product_identity hs⟩,
   ⟨the_trace_as_a_quotient ρ hρ hρ1,
    fun hE => on_the_line_the_two_factors_agree ρ hE⟩⟩

theorem phi_is_a_trace_of_a_root_of_unity :
