/-! ## §98.1  Tres estados, no dos -/

/-- **[P] LA MULTIPLICATIVA DEL ESPECTRO ES FALSA, NO ABIERTA.**
    `det = (1/2)(−1/4)(−1/4) = 1/32 ≠ 1`, luego `Σ log|spec| ≠ 0`.

    **Probado falso**, no pendiente. -/
theorem spectrum_multiplicative_is_false :
    (1 / 2 : ℝ) * (-(1 / 4)) * (-(1 / 4)) = 1 / 32 ∧
    (1 / 32 : ℝ) ≠ 1 := by
  refine ⟨by norm_num, by norm_num⟩

/-- **[P] Y LA ADITIVA DEL ESPECTRO ES VERDADERA.**  Traza `= 0`. -/
theorem spectrum_additive_is_true :
    (1 / 2 : ℝ) + (-(1 / 4)) + (-(1 / 4)) = 0 := by norm_num

/-- **[O] EL CRUCE, CON SUS TRES ESTADOS.**

    | | aditiva | multiplicativa |
    |---|---|---|
    | `spec Ω̂` | `0` — **[P] verdadera** | `2⁻⁵ ≠ 1` — **[P] FALSA** |
    | `{z_ρ}` | `= E` — **[Conj] abierta** | `1` — **[P] verdadera** |

    La multiplicativa está decidida en los dos niveles; la aditiva
    sólo arriba. -/
theorem the_crossing_has_three_states (r : ℝ) (hr : 0 < r) :
    ((1 / 2 : ℝ) + (-(1 / 4)) + (-(1 / 4)) = 0) ∧
    ((1 / 32 : ℝ) ≠ 1) ∧
    (r * (1 / r) = 1) ∧
    ((r - 1) + (1 / r - 1) = 0 ↔ r = 1) := by
  refine ⟨spectrum_additive_is_true, by norm_num, by field_simp, ?_⟩
  exact excess_zero_iff r hr

/-! ## §98.2  Cancelación arriba, positividad abajo -/

/-- **[P] ARRIBA HAY SIGNOS: LA ANULACIÓN ES POR CANCELACIÓN.**
    Un sumando positivo y dos negativos. -/
theorem trace_vanishes_by_cancellation :
    (0 : ℝ) < 1 / 2 ∧ (-(1 / 4) : ℝ) < 0 ∧
    (1 / 2 : ℝ) + (-(1 / 4)) + (-(1 / 4)) = 0 := by
  refine ⟨by norm_num, by norm_num, spectrum_additive_is_true⟩

/-- **[P] ABAJO NO HAY SIGNOS: CADA APORTE ES `≥ 0`.**
    `(r−1)+(1/r−1) = (r−1)²/r ≥ 0` ---`excess_is_a_square` y
    `excess_nonneg`, §31.

    **No hay nada con que cancelar.** -/
theorem excess_has_no_sign (r : ℝ) (hr : 0 < r) :
    (r - 1) + (1 / r - 1) = (r - 1) ^ 2 / r ∧
    0 ≤ (r - 1) + (1 / r - 1) :=
  ⟨excess_is_a_square r hr, excess_nonneg r hr⟩

/-- **[P] LUEGO UNA SUMA DE APORTES SE ANULA SÓLO SI CADA UNO SE
    ANULA.**  Es la forma general: suma de no negativos igual a cero
    ⟹ todos cero. -/
theorem sum_of_nonneg_zero_iff_all_zero {ι : Type*} (S : Finset ι)
    (f : ι → ℝ) (hnn : ∀ i ∈ S, 0 ≤ f i) (h : S.sum f = 0) :
    ∀ i ∈ S, f i = 0 := by
  intro i hi
  by_contra hne
  have hpos : 0 < f i := lt_of_le_of_ne (hnn i hi) (Ne.symm hne)
  have : 0 < S.sum f := by
    refine Finset.sum_pos' hnn ⟨i, hi, hpos⟩
  linarith [h, this]

/-- **[O] MISMO VALOR `0`, MECANISMOS DISTINTOS.**

        arriba   `0` = suma con signos      → cancelación
        abajo    `0` = suma de cuadrados    → anular cada término

    Pedirle a los ceros «la traza nula que el espectro ya tiene» les
    pide algo que sólo pueden conseguir de otro modo.  **Por eso `E`
    es más fuerte que «traza nula».** -/
theorem same_zero_two_mechanisms (r : ℝ) (hr : 0 < r) :
    ((0 : ℝ) < 1 / 2 ∧ (-(1 / 4) : ℝ) < 0) ∧
    (0 ≤ (r - 1) + (1 / r - 1)) ∧
    ((r - 1) + (1 / r - 1) = 0 ↔ r = 1) :=
  ⟨⟨by norm_num, by norm_num⟩, (excess_has_no_sign r hr).2,
   excess_zero_iff r hr⟩

/-! ## §98.3  Y por eso la ruta es positividad -/

/-- **[C] EL CRITERIO DE WEIL, COMO PREDICADO.**  Positividad de una
    forma cuadrática en una familia; `WeilCriterion` está en el
    corpus.  Se lleva en la firma (F4-inverso). -/
def PositivityRoute (Q : ℝ → ℝ) (hi : ℝ) : Prop :=
  ∀ T : ℝ, 0 < T → T < hi → 0 < Q T

/-- **[O] LA FORMA DEL PROBLEMA PIDE POSITIVIDAD, NO COTA.**

    El lado aditivo de los ceros es `Σ (r−1)²/r = 0` con términos
    `≥ 0`: eso es una forma cuadrática que debe anularse, es decir
    positividad en el borde.  §36 `extended_window` da la porción
    incondicional `2L < log 64`, y por Weil es porción PROBADA de `E`.

    **En §95 excluí §36 de la taxonomía por no ser «cota sobre
    ceros».  Es justamente lo que la forma del problema pide.** -/
theorem positivity_is_the_matching_route (Q : ℝ → ℝ)
    (hW : PositivityRoute Q (Real.log 64)) (r : ℝ) (hr : 0 < r) :
    (∀ T : ℝ, 0 < T → T < Real.log 64 → 0 < Q T) ∧
