@article{BrownHenneaux,
	abstract = {It is shown that the global charges of a gauge theory may yield a nontrivial central extension of the asymptotic symmetry algebra already at the classical level. This is done by studying three dimensional gravity with a negative cosmological constant. The asymptotic symmetry group in that case is eitherR\texttimes{}SO(2) or the pseudo-conformal group in two dimensions, depending on the boundary conditions adopted at spatial infinity. In the latter situation, a nontrivial central charge appears in the algebra of the canonical generators, which turns out to be just the Virasoro central charge.},
	author = {Brown, J. D. and Henneaux, Marc},
	journaltitle = {Communications in Mathematical Physics},
	doi = {10.1007/BF01211590},
	issn = {1432-0916},
	number = {2},
	date = {1986},
	pages = {207--226},
	title = {Central charges in the canonical realization of asymptotic symmetries: An example from three dimensional gravity},
	url = {https://doi.org/10.1007/BF01211590},
	volume = {104},
}
